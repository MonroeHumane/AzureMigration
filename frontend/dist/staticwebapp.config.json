{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "trailingSlash": "auto",
  "routes": [
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },

    { "route": "/SpecialSponsors",   "redirect": "/specialsponsors",   "statusCode": 301 },
    { "route": "/SpecialSponsors/*", "redirect": "/specialsponsors",   "statusCode": 301 },
    { "route": "/adopt-form",        "redirect": "/adoptions",         "statusCode": 301 },
    { "route": "/memorial",          "redirect": "/memorials",         "statusCode": 301 },
    { "route": "/donate-now",        "redirect": "/donate",            "statusCode": 301 },
    { "route": "/donations",         "redirect": "/donate",            "statusCode": 301 },
    { "route": "/volunteer",         "redirect": "/volunteer-form",    "statusCode": 301 },
    { "route": "/home",              "redirect": "/",                  "statusCode": 301 },

    { "route": "/dog-and-cat-shelter/*", "redirect": "/dog-and-cat-shelter", "statusCode": 301 },
    { "route": "/adoption-center/*", "redirect": "/adoptions", "statusCode": 301 },
    { "route": "/adoption-center",   "redirect": "/adoptions", "statusCode": 301 },
    { "route": "/animal-adoption/*", "redirect": "/adoptions", "statusCode": 301 },
    { "route": "/animal-adoption",   "redirect": "/adoptions", "statusCode": 301 },
    { "route": "/adopt-a-pet/*",     "redirect": "/adoptions", "statusCode": 301 },
    { "route": "/adopt-a-pet",       "redirect": "/adoptions", "statusCode": 301 },
    { "route": "/adopt-now/*",       "redirect": "/adoptions", "statusCode": 301 },
    { "route": "/adopt-now",         "redirect": "/adoptions", "statusCode": 301 },

    { "route": "/animal-shelter/*",  "redirect": "/dog-and-cat-shelter", "statusCode": 301 },
    { "route": "/animal-shelter",    "redirect": "/dog-and-cat-shelter", "statusCode": 301 },
    { "route": "/shelter/*",         "redirect": "/dog-and-cat-shelter", "statusCode": 301 },
    { "route": "/shelter",           "redirect": "/dog-and-cat-shelter", "statusCode": 301 },
    { "route": "/about/*",           "redirect": "/dog-and-cat-shelter", "statusCode": 301 },
    { "route": "/about",             "redirect": "/dog-and-cat-shelter", "statusCode": 301 },
    { "route": "/about-us/*",        "redirect": "/dog-and-cat-shelter", "statusCode": 301 },
    { "route": "/about-us",          "redirect": "/dog-and-cat-shelter", "statusCode": 301 },

    { "route": "/adopt/dogs",         "redirect": "/adopt?type=dog",    "statusCode": 301 },
    { "route": "/adopt/cats",         "redirect": "/adopt?type=cat",    "statusCode": 301 },
    { "route": "/adopt/other",        "redirect": "/adopt?type=other",  "statusCode": 301 },
    { "route": "/adopt/species-dog",  "redirect": "/adopt?type=dog",    "statusCode": 301 },
    { "route": "/adopt/species-cat",  "redirect": "/adopt?type=cat",    "statusCode": 301 },

    { "route": "/events-calendar",    "redirect": "/events",       "statusCode": 301 },
    { "route": "/news/*",             "redirect": "/newsletter",   "statusCode": 301 },
    { "route": "/news",               "redirect": "/newsletter",   "statusCode": 301 },
    { "route": "/blog/*",             "redirect": "/newsletter",   "statusCode": 301 },
    { "route": "/blog",               "redirect": "/newsletter",   "statusCode": 301 },
    { "route": "/give",               "redirect": "/donate",       "statusCode": 301 },
    { "route": "/giving",             "redirect": "/donate",       "statusCode": 301 },
    { "route": "/fundraise",          "redirect": "/donate",       "statusCode": 301 },
    { "route": "/memorials-and-giving","redirect": "/memorials/give","statusCode": 301 },
    { "route": "/store",              "redirect": "/shop",         "statusCode": 301 },
    { "route": "/merch",              "redirect": "/shop",         "statusCode": 301 }
  ],

  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": [
      "/assets/*",
      "/favicon.ico",
      "/robots.txt",
      "/sitemap-*.xml",
      "/*.png",
      "/*.webp",
      "/*.jpg",
      "/*.svg",
      "/*.json"
    ]
  },

  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },

  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "geolocation=(), microphone=(), camera=()",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload",
    "Content-Security-Policy": "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; frame-src 'self' https://docs.google.com https://www.google.com https://www.facebook.com https://www.paypal.com https://www.betterunite.com https://app.betterunite.com https://www.zeffy.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.trustindex.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; connect-src 'self' https:; media-src 'self' https: blob:;"
  },

  "mimeTypes": {
    ".webp": "image/webp",
    ".avif": "image/avif",
    ".json": "application/json",
    ".ico": "image/x-icon"
  }
}
