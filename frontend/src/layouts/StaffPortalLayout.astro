---
import BaseLayout from './BaseLayout.astro';
import StaffPortalNav from '../components/internal/StaffPortalNav.astro';
import MobileBottomNav from '../components/internal/MobileBottomNav.astro';
import MobileMoreSheet from '../components/internal/MobileMoreSheet.astro';

interface Props {
  title: string;
  description?: string;
  activeTab?: 'overview' | 'pets' | 'financials' | 'grants' | 'donors';
}

const {
  title,
  description = 'Humane Society of Monroe County Unified Staff & Board Operations Portal',
  activeTab = 'overview',
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  bodyClass="bg-[#f9f7f2] text-slate-800 antialiased"
>
  <!-- Centralized Synchronous Auth Guard (Runs before first paint to eliminate flicker) -->
  <script is:inline>
    (function() {
      try {
        var raw = sessionStorage.getItem('directus_auth') || localStorage.getItem('directus_auth');
        var hasAuth = false;
        if (raw) {
          try {
            var parsed = JSON.parse(raw);
            if (parsed && (parsed.access_token || parsed.refresh_token)) {
              hasAuth = true;
            }
          } catch (e) {}
        }
        if (!hasAuth) {
          hasAuth = !!(
            localStorage.getItem('mchs_staff_auth') === 'true' ||
            sessionStorage.getItem('mchs_staff_auth') === 'true' ||
            localStorage.getItem('mchs_staff_token') ||
            sessionStorage.getItem('mchs_staff_token')
          );
        }
        if (!hasAuth) {
          window.location.replace('/internal/?redirect=' + encodeURIComponent(window.location.pathname + window.location.search));
        } else {
          document.documentElement.classList.add('staff-authenticated');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Persistent App Header Shell -->
  <StaffPortalNav activeTab={activeTab} />

  <!-- Dynamic Content Workspace with Seamless 0ms View Transition -->
  <div class="min-h-screen pb-24 md:pb-12" transition:animate="fade">
    <slot />
  </div>

  <!-- Persistent Mobile Bottom Thumb-Navigation Dock -->
  <MobileBottomNav activeTab={activeTab} />

  <!-- Mobile Slide-Up More Tools Sheet -->
  <MobileMoreSheet />
</BaseLayout>
