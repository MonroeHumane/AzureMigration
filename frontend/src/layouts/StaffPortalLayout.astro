---
import BaseLayout from './BaseLayout.astro';
import StaffPortalNav from '../components/internal/StaffPortalNav.astro';
import DesktopSidebar from '../components/internal/DesktopSidebar.astro';
import MobileBottomNav from '../components/internal/MobileBottomNav.astro';
import MobileMoreSheet from '../components/internal/MobileMoreSheet.astro';
import CommandPalette from '../components/internal/CommandPalette.astro';
import FloatingActionMenu from '../components/internal/FloatingActionMenu.astro';

interface Props {
  title: string;
  description?: string;
  activeTab?: 'overview' | 'pets' | 'financials' | 'grants' | 'donors' | 'content';
}

const {
  title,
  description = 'Humane Society of Monroe County Unified Staff & Board Operations Portal',
  activeTab = 'overview',
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  bodyClass="antialiased min-h-screen relative overflow-x-hidden"
>
  <!-- Centralized Synchronous Auth Guard (Runs before first paint to eliminate flicker) -->
  <script is:inline>
    (function() {
      try {
        var token = localStorage.getItem('mchs_staff_token') || sessionStorage.getItem('mchs_staff_token') || '';
        var hasAuth = token.indexOf('mchs_') === 0 && token.indexOf('.') !== -1;
        if (!hasAuth) {
          window.location.replace('/internal/?redirect=' + encodeURIComponent(window.location.pathname + window.location.search));
        } else {
          document.documentElement.classList.add('staff-authenticated');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Ambient Glow Effects (Matching the login screen) -->
  <div class="fixed -top-32 -left-32 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="fixed -bottom-32 -right-32 w-96 h-96 bg-teal-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <!-- Persistent App Header Shell (Hidden on Desktop) -->
  <div class="lg:hidden">
    <StaffPortalNav activeTab={activeTab} />
  </div>

  <!-- Persistent Desktop Sidebar (Hidden on Mobile/Tablet) -->
  <DesktopSidebar activeTab={activeTab} />

  <!-- Dynamic Content Workspace with Seamless 0ms View Transition -->
  <div class="min-h-screen pb-24 md:pb-12 relative z-10 lg:pl-64" transition:animate="fade">
    <slot />
  </div>

  <!-- Persistent Mobile Bottom Thumb-Navigation Dock -->
  <MobileBottomNav activeTab={activeTab} />

  <!-- Mobile Slide-Up More Tools Sheet -->
  <MobileMoreSheet />

  <!-- Global Command Palette (Cmd+K) -->
  <CommandPalette />

  <!-- Floating Action Menu (Desktop FAB) -->
  <FloatingActionMenu />
</BaseLayout>
