---
import BaseLayout from './BaseLayout.astro';
import StaffPortalNav from '../components/internal/StaffPortalNav.astro';
import MobileBottomNav from '../components/internal/MobileBottomNav.astro';
import MobileMoreSheet from '../components/internal/MobileMoreSheet.astro';

interface Props {
  title: string;
  description?: string;
  activeTab?: 'overview' | 'pets' | 'financials' | 'grants';
}

const {
  title,
  description = 'Humane Society of Monroe County Unified Staff & Board Operations Portal',
  activeTab = 'overview',
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  bodyClass="bg-[#f9f7f2] text-slate-800 antialiased"
>
  <!-- Unified Staff Top Navigation Header -->
  <StaffPortalNav activeTab={activeTab} />

  <!-- Main View Container (with bottom padding for mobile dock) -->
  <div class="min-h-screen pb-24 md:pb-12">
    <slot />
  </div>

  <!-- Mobile Bottom Thumb-Navigation Dock -->
  <MobileBottomNav activeTab={activeTab} />

  <!-- Mobile Slide-Up More Tools Sheet -->
  <MobileMoreSheet />
</BaseLayout>
