---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import UserSettings from '../components/UserSettings.astro';
import BottomTabBar from '../components/BottomTabBar.astro';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../config/site';
import '../styles/global.css';
import '../styles/global-styles.css';
import '../styles/monroe-wp-compat.css';
import '../styles/monroe-theme.css';
import '../styles/staff-theme.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Extra body classes (e.g. page slug hooks). Inner-page padding applies unless overridden. */
  bodyClass?: string;
  /** Whether to hide public marketing nav and footer (defaults to true on /internal routes). */
  hidePublicNav?: boolean;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = `${SITE.name} | Animal Shelter & Adoptions`,
  description = `${SITE.name} - animal shelter, adoptions, and community resources in Monroe, Michigan.`,
  image = SITE.assets.defaultOgImage,
  bodyClass = 'monroe-inner-page',
  hidePublicNav = Astro.url.pathname.startsWith('/internal'),
  noindex = false,
  jsonLd,
} = Astro.props;

const isNewsletterRoute = Astro.url.pathname.startsWith('/newsletter');
const extraJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const canonicalURL = new URL(Astro.url.pathname, Astro.site || SITE.url);

// The site ships two separate installable PWA identities: the internal staff
// ops portal (manifest.webmanifest) and the public adopt experience
// (manifest-adopt.webmanifest). Branch here so every page keeps calling
// <BaseLayout> unchanged.
const isAdoptRoute = Astro.url.pathname.startsWith('/adopt');
const isInternalRoute = Astro.url.pathname.startsWith('/internal');
const manifestHref = isInternalRoute
  ? '/manifest.webmanifest'
  : '/manifest-adopt.webmanifest';
const appleWebAppTitle = isInternalRoute ? 'HSMC Ops' : (isAdoptRoute ? 'MCHS Adopt' : SITE.shortName);

const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'AnimalShelter',
  'name': SITE.name,
  'alternateName': SITE.shortName,
  'description': description,
  'url': SITE.url,
  'logo': new URL(SITE.assets.logo, SITE.url).href,
  'image': new URL(image, SITE.url).href,
  'telephone': '+1-734-243-3669',
  'email': SITE.contact.email,
  'address': {
    '@type': 'PostalAddress',
    'streetAddress': SITE.contact.address.street,
    'addressLocality': SITE.contact.address.city,
    'addressRegion': SITE.contact.address.state,
    'postalCode': SITE.contact.address.zip,
    'addressCountry': 'US',
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': 41.9164,
    'longitude': -83.4278,
  },
  'openingHoursSpecification': [
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': ['Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      'opens': '11:00',
      'closes': '16:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': ['Saturday'],
      'opens': '11:00',
      'closes': '15:00',
    },
  ],
  'sameAs': [
    SITE.integrations.social.facebook,
    'https://www.instagram.com/adopthsmc/',
  ],
};
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0f766e" />
    <link rel="icon" type="image/png" href="/assets/staff/icons/icon-192.png" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />

    <!-- PWA & Standalone Web App Meta -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={appleWebAppTitle} />
    <link rel="manifest" href={manifestHref} />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/staff/icons/apple-touch-icon.png" />

    <!-- SEO Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL.href} />
    {isNewsletterRoute && (
      <link rel="alternate" type="application/rss+xml" title="Monroe Humane Society Newsletter" href="/newsletter/rss.xml" />
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Humane Society of Monroe County" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Structured Data (Schema.org) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
    {extraJsonLd.map((node) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(node)} />
    ))}

    <!-- Theme fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Bebas+Neue&family=Jost:wght@400;500;600;700&family=Montserrat:wght@400;500;600;700&family=Questrial&display=swap"
      rel="stylesheet"
    />

    <!-- Facebook Pixel (Partytown) - only loaded if configured -->
    {import.meta.env.PUBLIC_FACEBOOK_PIXEL_ID && import.meta.env.PUBLIC_FACEBOOK_PIXEL_ID !== 'YOUR_PIXEL_ID' && !Astro.url.pathname.startsWith('/internal') && (
      <script is:inline type="text/partytown" define:vars={{ pixelId: import.meta.env.PUBLIC_FACEBOOK_PIXEL_ID }}>
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixelId);
        fbq('track', 'PageView');
      </script>
    )}
    <!-- Early zero-flicker authentication check for internal staff portal -->
    <script is:inline>
      (function() {
        function checkValidAuth() {
          try {
            var token = localStorage.getItem('mchs_staff_token') || sessionStorage.getItem('mchs_staff_token') || '';
            if (token.indexOf('mchs_') === 0 && token.indexOf('.') !== -1) {
              try {
                var clean = token.substring(5);
                var b64 = clean.split('.')[0].replace(/-/g, '+').replace(/_/g, '/');
                var p = JSON.parse(atob(b64));
                if (p && typeof p.iat === 'number') {
                  // 30 days = 2592000000 ms
                  return Math.abs(Date.now() - p.iat) <= 2592000000;
                }
              } catch (ex) {
                return true;
              }
              return true;
            }
          } catch (e) {}
          return false;
        }

        function syncAuth() {
          if (checkValidAuth()) {
            document.documentElement.classList.add('staff-authenticated');
          } else {
            document.documentElement.classList.remove('staff-authenticated');
          }
        }
        syncAuth();

        document.addEventListener('astro:before-swap', function(e) {
          try {
            if (checkValidAuth()) {
              e.newDocument.documentElement.classList.add('staff-authenticated');
            } else {
              e.newDocument.documentElement.classList.remove('staff-authenticated');
            }
          } catch (err) {}
        });
      })();
    </script>

    <!-- Early zero-flicker mobile navigation layout preference check -->
    <script is:inline>
      (function() {
        function syncNav() {
          try {
            var saved = localStorage.getItem('monroe-nav-pref') || 'bottom-bar';
            document.documentElement.setAttribute('data-nav-style', saved);
          } catch (e) {}
        }
        syncNav();
        document.addEventListener('astro:before-swap', function(e) {
          try {
            var saved = localStorage.getItem('monroe-nav-pref') || 'bottom-bar';
            e.newDocument.documentElement.setAttribute('data-nav-style', saved);
          } catch (err) {}
        });
      })();
    </script>

    <!-- Early PWA standalone detection (hide install UI without a flash) -->
    <script is:inline>
      (function() {
        function isStandalone(win) {
          try {
            var modes = ['standalone', 'fullscreen', 'minimal-ui', 'window-controls-overlay'];
            for (var i = 0; i < modes.length; i++) {
              if (win.matchMedia('(display-mode: ' + modes[i] + ')').matches) return true;
            }
            if (win.navigator.standalone === true) return true;
            if (new URLSearchParams(win.location.search).get('source') === 'pwa') return true;
          } catch (e) {}
          return false;
        }
        function syncPwa(target, win) {
          target.setAttribute('data-pwa', isStandalone(win) ? 'standalone' : 'browser');
        }
        syncPwa(document.documentElement, window);
        document.addEventListener('astro:before-swap', function(e) {
          syncPwa(e.newDocument.documentElement, window);
        });
      })();
    </script>
    <script is:inline>
      (function() {
        function syncStaffState(targetEl) {
          try {
            var savedTheme = localStorage.getItem('mchs_staff_theme') === 'dark' ? 'dark' : 'light';
            targetEl.setAttribute('data-staff-theme', savedTheme);
            targetEl.classList.toggle('dark', savedTheme === 'dark');
            targetEl.style.colorScheme = savedTheme === 'dark' ? 'dark' : 'light';
            var colorMeta = (targetEl.ownerDocument || document).querySelector('meta[name="theme-color"]');
            if (colorMeta) colorMeta.setAttribute('content', savedTheme === 'dark' ? '#071a17' : '#0f766e');
          } catch (e) {}
        }
        syncStaffState(document.documentElement);
        document.addEventListener('astro:before-swap', function(e) {
          syncStaffState(e.newDocument.documentElement);
        });
      })();
    </script>
    <script>
      import { initErrorReporter } from '../lib/error-reporter';
      initErrorReporter();
      document.addEventListener('astro:page-load', initErrorReporter);
    </script>

    <!-- Progressive Web App Service Worker Registration -->
    <script is:inline>
      if ('serviceWorker' in navigator && window.location.protocol.startsWith('http')) {
        window.addEventListener('load', function() {
          navigator.serviceWorker.register('/sw.js').catch(function() {});
        });
      }
    </script>
  </head>
  <body class:list={['monroe-rebuild-theme', bodyClass, hidePublicNav && 'staff-portal-body']}>
    <a class="monroe-skip-link" href="#monroe-main">Skip to content</a>

    {!hidePublicNav && (
      <>
        <Header currentPath={Astro.url.pathname} />
        <BottomTabBar currentPath={Astro.url.pathname} />
      </>
    )}

    <main id="monroe-main" tabindex="-1">
      <slot />
    </main>

    {!hidePublicNav && (
      <>
        <Footer />
        <UserSettings />
      </>
    )}
  </body>
</html>

<style is:global>
  body.staff-portal-body,
  body.monroe-rebuild-theme.staff-portal-body,
  body.monroe-rebuild-theme.monroe-inner-page.staff-portal-body {
    padding-top: 0 !important;
    margin-top: 0 !important;
    background-color: var(--sp-bg, #f8faf9) !important;
    background-image: none !important;
  }
</style>
