---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerShell from '../../components/InnerShell.astro';
import { SITE } from '../../config/site';

const DONATE_URL = SITE.integrations.betterUnite.generalDonation;
---

<BaseLayout
  title="Donate to HSMC | 734-243-3669"
  description="Your gift today buys medicine, food, and everyday supplies for the animals in our care."
>
  <InnerShell variant="donate-now">
    <header class="monroe-native-hero">
      <p class="monroe-native-eyebrow">Support Our Mission</p>
      <h1>Donate to Monroe Humane</h1>
      <p class="monroe-native-lead">
        Every dollar stays in Monroe County providing nourishing food, compassionate medical treatment, spay/neuter care, and safe shelter for dogs and cats waiting for their forever homes.
      </p>
    </header>

    <div style="display: flex; flex-wrap: wrap; gap: 1.5rem;">
      <div style="flex: 1; min-width: 300px; display: flex; flex-direction: column;">
        <section class="monroe-native-stack" style="flex: 1;">
          <div style="flex: 1;">
            <h2>Online Card Donation</h2>
            <p style="margin-bottom: 1.25rem;">
              Make a one-time or monthly gift via credit card or debit card through our verified BetterUnite portal.
            </p>
          </div>
          <div class="monroe-native-actions">
            <a class="monroe-btn" href={DONATE_URL} target="_blank" rel="noopener noreferrer">Donate with Card &rarr;</a>
          </div>
        </section>

        <!-- PayPal Fund Giving -->
        <section class="monroe-native-stack" style="flex: 1; margin-top: 1.5rem;">
          <div style="flex: 1;">
            <h2>PayPal Giving Fund</h2>
            <p style="margin-bottom: 1.25rem;">
              Donate securely with your PayPal balance or bank account with 100% of your donation going directly to shelter care.
            </p>
          </div>
          <div class="monroe-native-actions">
            <a class="monroe-btn" href="https://www.paypal.com/US/fundraiser/charity/4JPVCLYXAW9BW" target="_blank" rel="noopener noreferrer">General Fund (PayPal)</a>
            <a class="monroe-btn monroe-btn--outline" href="https://www.paypal.com/US/fundraiser/charity/N9S3JQGK3HCTW" target="_blank" rel="noopener noreferrer">Cat Room Expansion</a>
          </div>
        </section>
      </div>
    </div>

    <section class="monroe-native-stack" aria-labelledby="monroe-donations-ways-heading">
      <h2 id="monroe-donations-ways-heading">More Ways to Champion Animals</h2>
      <p style="margin-bottom: 1.5rem;">
        Explore other meaningful ways you can stand with Monroe County shelter animals:
      </p>
      <div class="monroe-native-actions">
        <a class="monroe-btn monroe-btn--outline" href="/membership">Become a Member</a>
        <a class="monroe-btn monroe-btn--outline" href="/memorials/give">Memorials &amp; Planned Giving</a>
        <a class="monroe-btn monroe-btn--outline" href="/events">Attend a Fundraiser</a>
        <a class="monroe-btn monroe-btn--outline" href="/shop">Shop Monroe Humane Swag</a>
      </div>
    </section>
  </InnerShell>
</BaseLayout>
