---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';
import ImpactTrustBadge from '../../components/common/ImpactTrustBadge.astro';

const DONATE_URL = SITE.integrations.betterUnite.generalDonation;

const impactTiers = [
  {
    amount: '$25',
    label: 'Vaccine Series',
    desc: 'Provides core canine (DHPP) or feline (FVRCP) vaccines, rabies shot, and deworming medicine for an incoming rescue.',
  },
  {
    amount: '$50',
    label: 'Monthly Food & Care',
    desc: 'Supplies high-protein nourishing food, daily flea/tick preventative, and comfort bedding for an animal in care.',
  },
  {
    amount: '$150',
    label: 'Spay / Neuter Surgery',
    desc: 'Subsidizes a full surgical spay or neuter, anesthesia, pain management, and medical recovery monitoring.',
  },
  {
    amount: '$450',
    label: 'Full Shelter Sponsorship',
    desc: 'Covers the average comprehensive cost to rescue, vet, rehabilitate, house, and adopt out one shelter animal.',
  },
];
---

<BaseLayout
  title="Donate to Monroe Humane | 734-243-3669"
  description="Your tax-deductible gift directly funds veterinary medicine, nourishing food, and safe shelter for Monroe County animals."
>
  <div class="max-w-5xl mx-auto px-4 py-8 sm:py-12">
    <!-- Header Hero -->
    <header class="bg-teal-900 text-cream p-8 sm:p-12 rounded-3xl mb-8 shadow-lg relative overflow-hidden">
      <div class="relative z-10 max-w-3xl">
        <p class="uppercase tracking-widest font-bold text-sm text-emerald-300 mb-3">Support Our Mission</p>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-serif text-white mb-4 leading-tight">Donate to Monroe Humane</h1>
        <p class="text-lg md:text-xl text-cream-100 opacity-90 leading-relaxed">
          The Humane Society of Monroe County is an independent 501(c)(3) nonprofit receiving zero tax funding. Every dollar stays right here in Monroe County, providing medical surgery, wholesome food, and safe refuge until every pet finds a loving home.
        </p>
      </div>
    </header>

    <!-- Fiduciary Trust & Impact Badge -->
    <div class="mb-10">
      <ImpactTrustBadge />
    </div>

    <!-- Giving Impact Ladder -->
    <section class="mb-12" aria-labelledby="giving-impact-heading">
      <div class="border-b border-gray-200 pb-4 mb-6 text-center sm:text-left">
        <span class="text-xs font-bold uppercase tracking-widest text-teal-700">Every Dollar Counts</span>
        <h2 id="giving-impact-heading" class="text-2xl sm:text-3xl font-serif text-teal-900 mt-1">How Your Donation Saves Lives</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {impactTiers.map((tier) => (
          <div class="bg-white p-5 rounded-2xl border border-teal-900/10 shadow-xs flex flex-col justify-between">
            <div>
              <div class="text-3xl font-serif font-bold text-teal-900 mb-1">{tier.amount}</div>
              <span class="inline-block text-xs font-bold text-emerald-700 uppercase tracking-wider mb-2">{tier.label}</span>
              <p class="text-xs text-gray-600 leading-relaxed">{tier.desc}</p>
            </div>
            <a
              href={DONATE_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 w-full py-2 rounded-xl text-center text-xs font-bold uppercase tracking-wider bg-slate-50 text-teal-900 hover:bg-teal-50 border border-slate-200 transition-colors"
            >
              Give {tier.amount}
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- Ways to Give Online -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mb-12">
      <!-- Direct Card Giving -->
      <section class="bg-white border border-teal-700/10 p-6 sm:p-8 rounded-2xl shadow-sm flex flex-col h-full hover:shadow-md transition-shadow">
        <div class="flex-1">
          <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-800 flex items-center justify-center font-bold mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
          </div>
          <h2 class="text-2xl font-bold text-teal-900 mb-2">Online Card Donation</h2>
          <p class="text-gray-600 text-sm mb-6 leading-relaxed">
            Make an immediate, secure one-time or recurring monthly gift via Visa, MasterCard, Discover, or American Express.
          </p>
        </div>
        <div>
          <a
            class="inline-flex items-center justify-center w-full font-bold uppercase tracking-wider px-6 py-4 rounded-full bg-teal-700 text-white transition-all hover:bg-teal-900 shadow-md text-sm"
            href={DONATE_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Donate with Card &rarr;
          </a>
        </div>
      </section>

      <!-- PayPal Giving Fund -->
      <section class="bg-white border border-teal-700/10 p-6 sm:p-8 rounded-2xl shadow-sm flex flex-col h-full hover:shadow-md transition-shadow">
        <div class="flex-1">
          <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-800 flex items-center justify-center font-bold mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 11V7a5 5 0 0 1 10 0v4"/><rect width="18" height="12" x="3" y="11" rx="2"/></svg>
          </div>
          <h2 class="text-2xl font-bold text-teal-900 mb-2">PayPal Giving Fund</h2>
          <p class="text-gray-600 text-sm mb-6 leading-relaxed">
            Give directly from your PayPal balance or linked bank account. 100% of your donation is delivered to Monroe Humane with zero credit processing fees deducted.
          </p>
        </div>
        <div class="flex flex-col gap-3">
          <a
            class="inline-flex items-center justify-center w-full font-bold uppercase tracking-wider px-6 py-3.5 rounded-full bg-teal-700 text-white transition-all hover:bg-teal-900 shadow-xs text-xs"
            href="https://www.paypal.com/US/fundraiser/charity/4JPVCLYXAW9BW"
            target="_blank"
            rel="noopener noreferrer"
          >
            PayPal General Fund
          </a>
          <a
            class="inline-flex items-center justify-center w-full font-bold uppercase tracking-wider px-6 py-3.5 rounded-full bg-white border-2 border-teal-700 text-teal-700 transition-all hover:bg-teal-50 text-xs"
            href="https://www.paypal.com/US/fundraiser/charity/N9S3JQGK3HCTW"
            target="_blank"
            rel="noopener noreferrer"
          >
            PayPal Cat Room Expansion
          </a>
        </div>
      </section>
    </div>

    <!-- Tax Deductibility & Check Mailing -->
    <section class="bg-slate-50 border border-slate-200 rounded-2xl p-6 sm:p-8 mb-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-gray-700">
        <div>
          <h3 class="font-bold text-slate-900 text-sm mb-2">Tax Deductibility Information</h3>
          <p class="mb-2">
            The Humane Society of Monroe County is recognized as a tax-exempt charitable organization under Section 501(c)(3) of the Internal Revenue Code. Contributions are tax-deductible to the fullest extent permitted by law.
          </p>
          <p class="font-mono text-[11px] text-slate-800 font-bold">
            Federal Tax ID (EIN): 38-1447274
          </p>
        </div>
        <div>
          <h3 class="font-bold text-slate-900 text-sm mb-2">Mail a Check</h3>
          <p class="mb-2">
            Donations by check or money order may be made payable to <strong>Humane Society of Monroe County</strong> and mailed to:
          </p>
          <address class="not-italic font-medium text-slate-900">
            Humane Society of Monroe County<br />
            PO Box 1457<br />
            Monroe, MI 48161
          </address>
        </div>
      </div>
    </section>

    <!-- More Ways to Support -->
    <section class="bg-cream-200 border border-teal-700/5 p-8 sm:p-10 rounded-2xl text-center">
      <h2 class="text-2xl font-bold text-teal-900 mb-3" id="monroe-donations-ways-heading">Other Meaningful Ways to Support</h2>
      <p class="text-gray-700 text-sm mb-6 max-w-2xl mx-auto">
        Join our membership community, memorialize a loved one, attend a fundraiser, or browse official shelter merchandise:
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-5 py-2.5 rounded-full bg-white border border-teal-700 text-teal-700 transition-all hover:bg-teal-50 text-xs shadow-2xs" href="/membership">Become a Member</a>
        <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-5 py-2.5 rounded-full bg-white border border-teal-700 text-teal-700 transition-all hover:bg-teal-50 text-xs shadow-2xs" href="/memorials/give">Memorial Plaques &amp; Tributes</a>
        <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-5 py-2.5 rounded-full bg-white border border-teal-700 text-teal-700 transition-all hover:bg-teal-50 text-xs shadow-2xs" href="/events">Attend an Event</a>
        <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-5 py-2.5 rounded-full bg-white border border-teal-700 text-teal-700 transition-all hover:bg-teal-50 text-xs shadow-2xs" href="/shop">Official Shop</a>
      </div>
    </section>
  </div>
</BaseLayout>
