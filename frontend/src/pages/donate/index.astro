---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';
const DONATE_ZEFFY_URL = SITE.integrations.zeffy.donationForm;
---

<BaseLayout
  title="Donate to Monroe Humane | 734-243-3669"
  description="Your tax-deductible gift directly funds veterinary medicine, nourishing food, and safe shelter for Monroe County animals."
>
  <div class="max-w-5xl mx-auto px-2.5 sm:px-4 py-6 sm:py-8">
    <!-- Header Hero -->
    <header class="relative overflow-hidden bg-gradient-to-br from-[#133c39] via-[#1a4f4b] to-[#0f2e2c] text-cream p-6 sm:p-12 rounded-3xl mb-8 shadow-xl border border-teal-700/60">
      <!-- Ambient radiant glow orbs -->
      <div class="absolute -right-16 -top-16 w-80 h-80 rounded-full bg-emerald-400/15 blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="absolute -left-16 -bottom-16 w-80 h-80 rounded-full bg-amber-400/12 blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="relative z-10 max-w-3xl">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-400/15 text-emerald-300 border border-emerald-400/25 mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse" aria-hidden="true"></span>
          Support Our Mission
        </span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-serif text-white mb-3 leading-tight tracking-tight">Donate to Monroe Humane</h1>
        <p class="text-base sm:text-lg text-cream-100/90 leading-relaxed font-light">
          The Humane Society of Monroe County is an independent 501(c)(3) nonprofit receiving zero tax funding. Every dollar stays right here in Monroe County, providing medical surgery, wholesome food, and safe refuge until every pet finds a loving home.
        </p>
      </div>
    </header>

    <!-- Primary 100% Impact Giving Center: Zeffy Interactive Embed -->
    <section class="zeffy-embed-card px-2.5 py-6 sm:p-8 lg:p-10 mb-8" aria-label="Donate Online">
      <div class="max-w-2xl mx-auto text-center mb-6">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-50 text-emerald-900 border border-emerald-300/80 mb-3 shadow-xs">
          <svg class="w-3.5 h-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          100% to Monroe County Animals &bull; 0% Fees Deducted
        </span>
        <h2 class="text-2xl sm:text-3xl font-serif text-teal-950 mb-2">Donate Online Directly</h2>
        <p class="text-gray-600 text-sm sm:text-base leading-relaxed">
          Through our nonprofit partnership with Zeffy, 100% of your gift goes directly to veterinary medicine, nourishing food, and daily shelter care. Zero platform or credit card processing fees are deducted.
        </p>
      </div>

      <!-- Zeffy Interactive Embed -->
      <div class="zeffy-embed-wrapper max-w-xl mx-auto">
        <div data-zeffy-embed data-form-url="/embed/donation-form/donate-to-change-lives-22422" class="w-full"></div>
        <div data-zeffy-embed-fallback style="display:none;" class="w-full">
          <div style="position:relative;overflow:hidden;height:650px;width:100%;">
            <iframe title='Donation form powered by Zeffy' style='position: absolute; border: 0; top:0;left:0;bottom:0;right:0;width:100%;height:100%' data-zeffy-embed-src='https://www.zeffy.com/embed/donation-form/donate-to-change-lives-22422' allow="payment"></iframe>
          </div>
        </div>
        <script
          is:inline
          src="https://www.zeffy.com/embed/v2/zeffy-embed.js"
          onerror="document.querySelectorAll('[data-zeffy-embed-fallback]').forEach(function(el){el.style.display='block';el.querySelectorAll('iframe[data-zeffy-embed-src]').forEach(function(f){f.src=f.getAttribute('data-zeffy-embed-src');});});"
        ></script>
      </div>

      <!-- Trust Badges Footer inside Card -->
      <div class="mt-6 pt-5 border-t border-teal-950/5 flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs text-gray-500 font-medium">
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          256-Bit Bank-Grade Encryption
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 12 2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
          Cards, Apple Pay, Google Pay &amp; ACH
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          Instant 501(c)(3) Tax Receipt
        </span>
      </div>
    </section>

    <!-- Additional Ways to Give: PayPal & Mail / Tax Info -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6 mb-8">
      <!-- PayPal Giving Fund -->
      <section class="bg-white border border-teal-950/10 p-6 sm:p-8 rounded-3xl shadow-[0_4px_20px_-4px_rgba(19,60,57,0.07)] flex flex-col h-full hover:shadow-[0_20px_35px_-10px_rgba(19,60,57,0.15)] hover:border-teal-700/30 hover:-translate-y-1 transition-all duration-300">
        <div class="flex-1">
          <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-800 flex items-center justify-center font-bold mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 11V7a5 5 0 0 1 10 0v4"/><rect width="18" height="12" x="3" y="11" rx="2"/></svg>
          </div>
          <h3 class="text-2xl font-bold text-teal-900 mb-2">PayPal Giving Fund</h3>
          <p class="text-gray-600 text-sm mb-6 leading-relaxed">
            Prefer to donate from your existing PayPal balance or linked bank account? 100% of your gift is delivered to Monroe Humane with zero fees deducted.
          </p>
        </div>
        <div class="flex flex-col gap-3">
          <a
            class="inline-flex items-center justify-center w-full font-bold uppercase tracking-wider px-6 py-3.5 rounded-full bg-teal-700 text-white transition-all hover:bg-teal-900 shadow-xs text-xs min-h-[44px]"
            href="https://www.paypal.com/US/fundraiser/charity/4JPVCLYXAW9BW"
            target="_blank"
            rel="noopener noreferrer"
          >
            PayPal General Fund &rarr;
          </a>
          <a
            class="inline-flex items-center justify-center w-full font-bold uppercase tracking-wider px-6 py-3.5 rounded-full bg-white border-2 border-teal-700 text-teal-700 transition-all hover:bg-teal-50 text-xs min-h-[44px]"
            href="https://www.paypal.com/US/fundraiser/charity/N9S3JQGK3HCTW"
            target="_blank"
            rel="noopener noreferrer"
          >
            PayPal Cat Room Expansion &rarr;
          </a>
        </div>
      </section>

      <!-- Tax Deductibility & Mail a Check -->
      <section class="bg-white border border-teal-950/10 p-6 sm:p-8 rounded-3xl shadow-[0_4px_20px_-4px_rgba(19,60,57,0.07)] flex flex-col h-full hover:shadow-[0_20px_35px_-10px_rgba(19,60,57,0.15)] hover:border-teal-700/30 hover:-translate-y-1 transition-all duration-300">
        <div class="flex-1">
          <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center font-bold mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <h3 class="text-2xl font-bold text-teal-900 mb-2">Mail a Check or Legacy Portal</h3>
          <p class="text-gray-600 text-sm mb-4 leading-relaxed">
            The Humane Society of Monroe County is recognized as a tax-exempt charitable organization under Section 501(c)(3). Federal Tax ID (EIN): <strong class="font-mono text-slate-800">38-1447274</strong>.
          </p>
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-3.5 text-xs text-slate-800 mb-5">
            <p class="font-semibold text-slate-900 mb-1">Make checks payable to:</p>
            <address class="not-italic">
              Humane Society of Monroe County<br />
              PO Box 1457<br />
              Monroe, MI 48161
            </address>
          </div>
        </div>
        <div>
          <a
            class="inline-flex items-center justify-center w-full font-bold uppercase tracking-wider px-6 py-3 rounded-full bg-slate-100 text-slate-700 border border-slate-300 hover:bg-slate-200 transition-all text-xs min-h-[44px]"
            href={DONATE_ZEFFY_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Standalone Zeffy Giving Form &rarr;
          </a>
        </div>
      </section>
    </div>

    <!-- More Ways to Support -->
    <section class="bg-cream-200 border border-teal-700/5 p-6 sm:p-8 rounded-2xl text-center">
      <h2 class="text-2xl font-bold text-teal-900 mb-3" id="monroe-donations-ways-heading">Other Meaningful Ways to Support</h2>
      <p class="text-gray-700 text-sm mb-6 max-w-2xl mx-auto">
        Join our membership community, memorialize a loved one, attend a fundraiser, or browse official shelter merchandise:
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-5 py-2.5 rounded-full bg-white border border-teal-700 text-teal-700 transition-all hover:bg-teal-50 text-xs shadow-2xs" href="/membership">Become a Member</a>
        <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-5 py-2.5 rounded-full bg-white border border-teal-700 text-teal-700 transition-all hover:bg-teal-50 text-xs shadow-2xs" href="/memorials/give">Memorial Plaques &amp; Tributes</a>
        <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-5 py-2.5 rounded-full bg-white border border-teal-700 text-teal-700 transition-all hover:bg-teal-50 text-xs shadow-2xs" href="/events">Attend an Event</a>
        <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-5 py-2.5 rounded-full bg-white border border-teal-700 text-teal-700 transition-all hover:bg-teal-50 text-xs shadow-2xs" href="/shop">Official Shop</a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // Re-initialize Zeffy embed if visitor navigates via View Transitions
  document.addEventListener('astro:page-load', () => {
    const w = window as any;
    if (w.Zeffy?.embed?.init) {
      try {
        w.Zeffy.embed.init();
      } catch {
        // Fallback already active
      }
    }
  });
</script>
