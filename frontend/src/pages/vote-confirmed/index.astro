---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerShell from '../../components/InnerShell.astro';
import { SITE } from '../../config/site';
---

<BaseLayout
  title="Vote Received — Thank You! | 734-243-3669"
  description="Thank you for voting in the Monroe Humane membership shirt design contest! Your vote has been received."
>
  <InnerShell variant="vote-confirmed">
    <header class="monroe-native-hero">
      <p class="monroe-native-eyebrow">✓ Vote received</p>
      <h1>Thank you for voting!</h1>
      <p class="monroe-native-lead">
        Your vote in the Monroe Humane membership shirt design contest has been received. We'll announce the winning design soon — stay tuned on social media and at the shelter!
      </p>
    </header>

    <section class="monroe-native-stack" aria-labelledby="monroe-vote-next-heading">
      <h2 id="monroe-vote-next-heading">What happens next</h2>
      <p>
        Once voting closes, the design with the most votes becomes the official HSMC membership shirt. Members who voted will be among the first to know the result.
      </p>
      <ul class="monroe-native-list">
        <li>Follow us on <a href={SITE.integrations.social.facebook} target="_blank" rel="noopener noreferrer">Facebook</a> and <a href="https://www.instagram.com/adopthsmc/" target="_blank" rel="noopener noreferrer">Instagram</a> for the announcement.</li>
        <li>Check back at the <a href="/events">Events page</a> for the unveiling event details.</li>
        <li>Become a member to get your shirt: <a href="/membership">Membership plans</a>.</li>
      </ul>
      <div class="monroe-native-actions">
        <a class="monroe-btn" href="/artwork-contest">View all designs</a>
        <a class="monroe-btn monroe-btn--outline" href="/events">Upcoming events</a>
        <a class="monroe-btn monroe-btn--outline" href="/membership">Membership plans</a>
      </div>
    </section>

    <section class="monroe-native-stack" aria-labelledby="monroe-vote-contact-heading">
      <h2 id="monroe-vote-contact-heading">Questions about the contest?</h2>
      <ul class="monroe-native-list">
        <li><a href={SITE.contact.phoneTel}>{SITE.contact.phoneFormatted}</a></li>
        <li><a href={SITE.contact.emailMailto}>{SITE.contact.email}</a></li>
      </ul>
    </section>
  </InnerShell>
</BaseLayout>
