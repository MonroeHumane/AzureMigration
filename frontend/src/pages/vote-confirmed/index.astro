---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';
---

<BaseLayout
  title="Vote Received - Thank You! | 734-243-3669"
  description="Thank you for voting in the Monroe Humane membership shirt design contest! Your vote has been received."
>
  <main class="pt-32 pb-24 px-4 max-w-4xl mx-auto">
    <header class="mb-16 text-center">
      <p class="text-emerald-500 font-bold uppercase tracking-widest text-sm mb-4">✓ Vote received</p>
      <h1 class="text-5xl md:text-6xl font-serif text-teal-900 mb-6">Thank you for voting!</h1>
      <p class="text-xl text-gray-600 leading-relaxed">
        Your vote in the Monroe Humane membership shirt design contest has been received. We'll announce the winning design soon - stay tuned on social media and at the shelter!
      </p>
    </header>

    <div class="space-y-16">
      <section aria-labelledby="monroe-vote-next-heading" class="bg-gray-50 rounded-3xl p-8 border border-gray-200">
        <h2 id="monroe-vote-next-heading" class="text-3xl font-serif text-teal-900 mb-4">What happens next</h2>
        <p class="text-gray-600 mb-6 leading-relaxed">
          Once voting closes, the design with the most votes becomes the official HSMC membership shirt. Members who voted will be among the first to know the result.
        </p>
        <ul class="list-disc list-inside text-gray-600 space-y-2 mb-8 ml-2">
          <li>Follow us on{" "}<a class="text-teal-700 font-semibold hover:underline" href={SITE.integrations.social.facebook} target="_blank" rel="noopener noreferrer">Facebook</a> and{" "}<a class="text-teal-700 font-semibold hover:underline" href="https://www.instagram.com/adopthsmc/" target="_blank" rel="noopener noreferrer">Instagram</a> for the announcement.</li>
          <li>Check back at the{" "}<a class="text-teal-700 font-semibold hover:underline" href="/events">Events page</a> for the unveiling event details.</li>
          <li>Become a member to get your shirt:{" "}<a class="text-teal-700 font-semibold hover:underline" href="/membership">Membership plans</a>.</li>
        </ul>
        <div class="flex flex-wrap gap-4">
          <a class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-teal-700 text-white font-bold uppercase tracking-wider transition-all hover:bg-teal-900 hover:-translate-y-1 shadow-sm" href="/artwork-contest">View all designs</a>
          <a class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-teal-700 text-teal-700 font-bold uppercase tracking-wider transition-all hover:bg-teal-50 hover:-translate-y-1" href="/events">Upcoming events</a>
          <a class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-teal-700 text-teal-700 font-bold uppercase tracking-wider transition-all hover:bg-teal-50 hover:-translate-y-1" href="/membership">Membership plans</a>
        </div>
      </section>

      <section aria-labelledby="monroe-vote-contact-heading" class="text-center">
        <h2 id="monroe-vote-contact-heading" class="text-2xl font-serif text-teal-900 mb-4">Questions about the contest?</h2>
        <div class="flex flex-wrap justify-center gap-6 text-lg">
          <a class="text-teal-700 font-semibold hover:underline" href={SITE.contact.phoneTel}>{SITE.contact.phoneFormatted}</a>
          <a class="text-teal-700 font-semibold hover:underline" href={SITE.contact.emailMailto}>{SITE.contact.email}</a>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>