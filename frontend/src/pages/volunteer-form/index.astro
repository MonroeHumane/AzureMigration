---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';

const VOLUNTEER_FORM_URL = SITE.integrations.googleForms.volunteerApp;

const volunteerRoles = [
  {
    title: 'Canine Care & Dog Walking',
    time: 'Morning & Afternoon Shifts',
    desc: 'Provide essential exercise, outdoor playtime in our play yards, basic leash manners, and loving companionship for shelter dogs awaiting homes.',
  },
  {
    title: 'Feline Socialization & Enrichment',
    time: 'Flexible Hours',
    desc: 'Spend quiet time reading to, brushing, playing with, and comforting shelter cats and kittens in our open Cat Room and intake suites.',
  },
  {
    title: 'Adoption Event Ambassador',
    time: 'Weekend Events',
    desc: 'Help staff off-site mobile adoption fairs, charity car shows, pancake breakfasts, and community education tables throughout Monroe County.',
  },
  {
    title: 'Shelter Operations & Facilities',
    time: 'Daily Shifts',
    desc: 'Assist animal care staff with morning sanitization, daily laundry turnover, dish washing, donation sorting, and facility grounds upkeep.',
  },
];
---

<BaseLayout
  title="Volunteer Application | Humane Society of Monroe County"
  description="Lend your hands and heart to Monroe County animals. Complete our volunteer application for dog walking, cat socialization, event staffing, and shelter support."
>
  <div class="max-w-6xl mx-auto px-4 py-8 sm:py-12">
    <!-- Header Hero -->
    <header class="bg-teal-900 text-cream p-8 sm:p-12 lg:p-16 rounded-3xl mb-12 shadow-lg relative overflow-hidden">
      <div class="relative z-10 max-w-3xl">
        <p class="uppercase tracking-widest font-bold text-sm text-emerald-300 mb-3">Make a Difference</p>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-serif text-white mb-6 leading-tight">Volunteer Application</h1>
        <p class="text-lg md:text-xl text-cream-100 opacity-90 leading-relaxed">
          Volunteers are the heartbeat of our shelter. Whether walking dogs, socializing rescue cats, assisting at community fundraisers, or keeping shelter facilities clean, your time directly saves lives.
        </p>
      </div>
    </header>

    <!-- Volunteer Roles Overview -->
    <section class="mb-16" aria-labelledby="volunteer-roles-heading">
      <div class="border-b border-gray-200 pb-4 mb-8">
        <span class="text-xs font-bold uppercase tracking-widest text-teal-700">Where You Can Help</span>
        <h2 id="volunteer-roles-heading" class="text-3xl font-serif text-teal-900 mt-1">Shelter Volunteer Opportunities</h2>
        <p class="text-gray-600 text-sm mt-1">Find the role that matches your passions and availability.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {volunteerRoles.map((role) => (
          <div class="bg-white rounded-2xl border border-teal-900/10 p-6 shadow-xs flex flex-col justify-between hover:shadow-md transition-shadow">
            <div>
              <span class="inline-block px-2.5 py-1 bg-teal-50 text-teal-800 text-[11px] font-bold rounded-full mb-3">
                {role.time}
              </span>
              <h3 class="font-bold text-teal-900 text-base mb-2">{role.title}</h3>
              <p class="text-xs text-gray-600 leading-relaxed">{role.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Requirements & Policies Banner -->
    <section class="bg-slate-50 border border-slate-200 rounded-2xl p-6 sm:p-8 mb-12">
      <h3 class="text-lg font-bold text-teal-900 mb-3">Volunteer Guidelines</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs text-gray-700">
        <div>
          <strong class="text-slate-900 block mb-1">Age Requirements</strong>
          Volunteers must be at least 16 years of age to handle animals independently. Youth ages 14-15 may volunteer alongside an adult parent or legal guardian.
        </div>
        <div>
          <strong class="text-slate-900 block mb-1">Orientation &amp; Training</strong>
          All accepted volunteers attend a 45-minute orientation covering Fear-Free animal handling, shelter safety protocols, and emergency procedures.
        </div>
        <div>
          <strong class="text-slate-900 block mb-1">Flexible Scheduling</strong>
          We ask for a commitment of at least 4 hours per month. Weekend and weekday morning dog-walking shifts are our greatest ongoing need.
        </div>
      </div>
    </section>

    <!-- Embedded Application Form -->
    <section class="bg-white rounded-3xl shadow-sm border border-gray-200 p-6 sm:p-10 mb-16" aria-labelledby="monroe-volunteer-form-heading">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 pb-6 border-b border-gray-100">
        <div>
          <h2 id="monroe-volunteer-form-heading" class="text-2xl sm:text-3xl font-serif text-teal-900">Online Application</h2>
          <p class="text-xs text-gray-500 mt-1">Please fill out each section completely. Our volunteer coordinator will follow up via email.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-5 py-2.5 rounded-full text-xs transition-all shadow-xs bg-teal-700 text-white hover:bg-teal-900"
            href={VOLUNTEER_FORM_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Open in New Window &rarr;
          </a>
        </div>
      </div>
      
      <div class="w-full relative min-h-[960px] md:min-h-[820px] bg-gray-50 rounded-2xl overflow-hidden shadow-inner border border-gray-200">
        <iframe
          title="Volunteer application form"
          src={`${VOLUNTEER_FORM_URL}?embedded=true`}
          class="absolute inset-0 w-full h-full"
          loading="lazy"
        ></iframe>
      </div>
      
      <p class="text-xs text-gray-500 text-center mt-4">
        Having trouble with the embedded form? <a href={VOLUNTEER_FORM_URL} target="_blank" rel="noopener noreferrer" class="text-teal-700 font-bold underline underline-offset-2">Click here to open the application directly in Google Forms</a>.
      </p>
    </section>
    
    <!-- Contact / Questions -->
    <section class="text-center bg-cream-200 rounded-3xl p-8 border border-teal-900/10" aria-labelledby="monroe-volunteer-questions-heading">
      <h2 id="monroe-volunteer-questions-heading" class="text-2xl font-serif text-teal-900 mb-2">Have Questions About Volunteering?</h2>
      <p class="text-sm text-gray-600 mb-6 max-w-xl mx-auto">
        Contact our volunteer coordinator for group volunteer projects, court-ordered community service verification, or corporate service days.
      </p>
      <div class="flex justify-center gap-6 text-sm font-bold">
        <a class="text-teal-800 hover:text-teal-950 underline underline-offset-4" href="tel:734-243-3669">(734) 243-3669</a>
        <span class="text-teal-900/30">|</span>
        <a class="text-teal-800 hover:text-teal-950 underline underline-offset-4" href="mailto:info@monroe-humane.org">info@monroe-humane.org</a>
      </div>
    </section>
  </div>
</BaseLayout>
