---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';

const VOLUNTEER_FORM_URL = SITE.integrations.googleForms.volunteerApp;
---

<BaseLayout
  title="Volunteer Form | 734-243-3669"
  description="Your time can make a world of difference, walking dogs, socializing cats, helping at events, and more. Complete the volunteer form below to get started."
>
  <div class="pb-24 px-4 max-w-4xl mx-auto">
    <header class="text-center mb-16">
      <p class="text-emerald-500 font-bold uppercase tracking-widest text-sm mb-4">Volunteer</p>
      <h1 class="text-5xl md:text-6xl font-serif text-teal-900 mb-6">Volunteer Form</h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
        Your time can make a world of difference, walking dogs, socializing cats, helping at events, and more. Complete the volunteer form below to get started.
      </p>
    </header>
    
    <section class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 md:p-12 mb-12" aria-labelledby="monroe-volunteer-form-heading">
      <h2 id="monroe-volunteer-form-heading" class="text-3xl font-serif text-teal-900 mb-8 text-center">Volunteer application</h2>
      <div class="flex flex-col sm:flex-row justify-center gap-4 mb-10">
        <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-6 py-4 rounded-full transition-all shadow-md hover:-translate-y-1 bg-emerald-500 text-teal-900 hover:bg-emerald-400" href={VOLUNTEER_FORM_URL} target="_blank" rel="noopener noreferrer">Open form in new tab</a>
        <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-6 py-4 rounded-full transition-all border-2 border-teal-700 text-teal-700 hover:-translate-y-1 hover:bg-teal-50" href="/#Volunteer">Volunteer on the homepage</a>
      </div>
      
      <div class="w-full relative min-h-[960px] md:min-h-[780px] bg-gray-50 rounded-2xl overflow-hidden shadow-inner">
        <iframe
          title="Volunteer application form"
          src={`${VOLUNTEER_FORM_URL}?embedded=true`}
          class="absolute inset-0 w-full h-full"
          loading="lazy"></iframe>
      </div>
      <p class="text-sm text-gray-500 text-center mt-6">
        Google Forms cannot auto-size in iframes. If the form is cut off or has extra space below, use Open form in new tab.
      </p>
    </section>
    
    <section class="text-center" aria-labelledby="monroe-volunteer-form-alt-heading">
      <h2 id="monroe-volunteer-form-alt-heading" class="text-2xl font-serif text-teal-900 mb-4">Questions?</h2>
      <ul class="flex justify-center gap-8 text-lg">
        <li><a class="text-emerald-600 hover:text-emerald-700 font-medium" href="tel:734-243-3669">734-243-3669</a></li>
        <li><a class="text-emerald-600 hover:text-emerald-700 font-medium" href="mailto:info@monroe-humane.org">info@monroe-humane.org</a></li>
      </ul>
    </section>
  </div>
</BaseLayout>
