---
/**
 * Monroe Humane — TV Lobby Display / Kiosk
 *
 * Full-screen kiosk for shelter lobby TVs. Deliberately minimal: the
 * clock, one pet at a time (photo + a few facts), a real QR code that
 * links straight to that pet's live adoption page, and the shelter's
 * mark. Nothing else competes for attention.
 *
 * The QR code is generated natively in the browser (qr-code-styling,
 * bundled — no third-party image API call), targets the actual native
 * per-pet page (/adopt/{id}), and re-renders whenever the spotlight
 * pet changes. Pet data comes from the same live Directus feed the
 * rest of the site uses, with a background refresh so the display
 * tracks the PetSync pipeline without a restart.
 */

import { getPets } from '../../lib/directus';
import { SITE } from '../../config/site';

const allPets = await getPets();
const pets = allPets.filter((p) => p.image && !p.image.includes('placeholder'));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>HSMC TV — Adoptable Pets</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Jost:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <style>
    :root {
      --tv-bg-deep: #061816;
      --tv-bg: #0c2a26;
      --tv-teal: #2dd4bf;
      --tv-teal-deep: #0f766e;
      --tv-gold: #fbbf24;
      --tv-text: #ffffff;
      --tv-text-muted: #a7d9d0;
      --tv-font-display: 'Abril Fatface', Georgia, serif;
      --tv-font-sans: 'Jost', 'Segoe UI', sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      width: 100vw;
      height: 100vh;
      overflow: hidden;
    }

    body {
      background:
        radial-gradient(circle at 14% 12%, rgba(45, 212, 191, 0.16), transparent 42%),
        radial-gradient(circle at 88% 86%, rgba(251, 191, 36, 0.1), transparent 46%),
        linear-gradient(160deg, var(--tv-bg-deep), var(--tv-bg));
      color: var(--tv-text);
      font-family: var(--tv-font-sans);
      display: flex;
      align-items: center;
      justify-content: center;
      user-select: none;
      -webkit-font-smoothing: antialiased;
    }

    /* ---------------- Corner chrome: logo + clock, nothing else ---------------- */
    .tv-brand-corner {
      position: fixed;
      top: clamp(1.25rem, 3vw, 2.25rem);
      left: clamp(1.25rem, 3vw, 2.25rem);
      display: flex;
      align-items: center;
      gap: 0.85rem;
      z-index: 10;
    }

    .tv-brand-corner img {
      height: clamp(2.5rem, 4vw, 3.5rem);
      width: auto;
      object-fit: contain;
      filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.35));
    }

    .tv-brand-corner span {
      font-family: var(--tv-font-display);
      font-size: clamp(1.1rem, 1.8vw, 1.5rem);
      color: var(--tv-text);
      letter-spacing: 0.01em;
    }

    .tv-clock-corner {
      position: fixed;
      top: clamp(1.25rem, 3vw, 2.25rem);
      right: clamp(1.25rem, 3vw, 2.25rem);
      text-align: right;
      z-index: 10;
    }

    .tv-clock-corner__time {
      font-size: clamp(1.5rem, 2.6vw, 2.25rem);
      font-weight: 800;
      letter-spacing: -0.01em;
      color: var(--tv-text);
      line-height: 1;
    }

    .tv-clock-corner__date {
      font-size: clamp(0.8rem, 1.1vw, 0.95rem);
      color: var(--tv-text-muted);
      margin-top: 0.3rem;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      font-weight: 600;
    }

    /* ---------------- The one thing on screen: the pet ---------------- */
    .tv-stage {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: clamp(5.5rem, 9vw, 7.5rem) clamp(2rem, 5vw, 4rem);
    }

    .tv-card {
      width: 100%;
      max-width: 1400px;
      display: grid;
      grid-template-columns: 1.05fr 1fr;
      gap: clamp(2rem, 4vw, 3.5rem);
      align-items: center;
      transition: opacity 0.45s ease;
    }

    .tv-card.is-transitioning { opacity: 0; }

    .tv-card__photo-wrap {
      position: relative;
      border-radius: 32px;
      overflow: hidden;
      aspect-ratio: 4 / 3;
      background: #000;
      border: 2px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 30px 70px rgba(0, 0, 0, 0.45);
    }

    .tv-card__photo {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scale(1);
      transition: transform 9s ease, opacity 0.4s ease;
    }

    .tv-card__photo.zooming { transform: scale(1.08); }

    .tv-card__species-badge {
      position: absolute;
      top: 1.25rem;
      left: 1.25rem;
      width: 3.25rem;
      height: 3.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: rgba(6, 24, 22, 0.85);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(45, 212, 191, 0.4);
      font-size: 1.5rem;
    }

    .tv-card__info {
      display: flex;
      flex-direction: column;
      gap: clamp(1rem, 2vw, 1.5rem);
      min-width: 0;
    }

    .tv-card__name {
      font-family: var(--tv-font-display);
      font-size: clamp(3rem, 6vw, 5rem);
      line-height: 1;
      color: #ffffff;
      text-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
    }

    .tv-card__pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
    }

    .tv-pill {
      padding: 0.5rem 1.15rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.16);
      font-size: clamp(0.9rem, 1.3vw, 1.1rem);
      font-weight: 600;
      color: #ffffff;
    }

    .tv-pill--accent {
      background: rgba(45, 212, 191, 0.16);
      border-color: rgba(45, 212, 191, 0.42);
      color: var(--tv-teal);
    }

    .tv-pill--gold {
      background: rgba(251, 191, 36, 0.16);
      border-color: rgba(251, 191, 36, 0.42);
      color: var(--tv-gold);
    }

    /* ---------------- QR card ---------------- */
    .tv-qr-card {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      background: #ffffff;
      border-radius: 24px;
      padding: 1.1rem 1.5rem;
      color: #0f2d29;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
      margin-top: 0.5rem;
      width: fit-content;
    }

    .tv-qr-card__code {
      flex-shrink: 0;
      width: clamp(6rem, 9vw, 7.5rem);
      height: clamp(6rem, 9vw, 7.5rem);
      display: flex;
    }

    .tv-qr-card__code svg,
    .tv-qr-card__code canvas {
      width: 100%;
      height: 100%;
    }

    .tv-qr-card__text h2 {
      font-family: var(--tv-font-sans);
      font-size: clamp(1.05rem, 1.5vw, 1.3rem);
      font-weight: 800;
      color: #0c2a26;
      line-height: 1.25;
    }

    .tv-qr-card__text p {
      font-size: clamp(0.85rem, 1.1vw, 0.95rem);
      color: #4b6968;
      margin-top: 0.25rem;
      line-height: 1.35;
    }

    @media (max-width: 900px) {
      .tv-card { grid-template-columns: 1fr; }
      .tv-card__photo-wrap { aspect-ratio: 16 / 9; }
    }
  </style>
</head>
<body>
  <!-- Logo -->
  <div class="tv-brand-corner">
    <img src={SITE.assets.logo} alt="Monroe Humane" />
    <span>Monroe Humane</span>
  </div>

  <!-- Time -->
  <div class="tv-clock-corner">
    <div class="tv-clock-corner__time" id="clockTime">12:00 PM</div>
    <div class="tv-clock-corner__date" id="clockDate">Monroe, MI</div>
  </div>

  <!-- Pet + QR -->
  <main class="tv-stage">
    <div class="tv-card" id="petCard">
      <div class="tv-card__photo-wrap">
        <img id="petPhoto" class="tv-card__photo zooming" src="" alt="" />
        <span class="tv-card__species-badge" id="petSpeciesBadge">🐕</span>
      </div>

      <div class="tv-card__info">
        <h1 class="tv-card__name" id="petName">&nbsp;</h1>
        <div class="tv-card__pills">
          <span class="tv-pill tv-pill--gold" id="petAge">Age</span>
          <span class="tv-pill tv-pill--accent" id="petGender">Gender</span>
          <span class="tv-pill" id="petBreed">Breed</span>
        </div>
        <div class="tv-qr-card">
          <div class="tv-qr-card__code" id="petQr"></div>
          <div class="tv-qr-card__text">
            <h2>📱 Scan to meet <span id="petNameInline">me</span></h2>
            <p>Opens their full profile and adoption application on your phone.</p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Data handoff: kept as a tiny inline script (no bundling) so the
       server-rendered pet list reaches the bundled module script below
       without needing a network round trip on load. -->
  <script is:inline define:vars={{ initialPets: pets }}>
    window.__TV_INITIAL_PETS__ = initialPets || [];
  </script>

  <script>
    import QRCodeStyling from 'qr-code-styling';
    import type { Pet } from '../../lib/directus';

    function $<T extends HTMLElement>(id: string): T {
      return document.getElementById(id) as T;
    }

    let pets: Pet[] = (window as unknown as { __TV_INITIAL_PETS__?: Pet[] }).__TV_INITIAL_PETS__ || [];
    let currentIndex = 0;
    let isPlaying = true;
    let rotateInterval: ReturnType<typeof setInterval> | null = null;
    const ROTATE_MS = 10000;

    const petPhoto = $<HTMLImageElement>('petPhoto');
    const petSpeciesBadge = $('petSpeciesBadge');
    const petName = $('petName');
    const petNameInline = $('petNameInline');
    const petAge = $('petAge');
    const petGender = $('petGender');
    const petBreed = $('petBreed');
    const petCard = $('petCard');
    const clockTime = $('clockTime');
    const clockDate = $('clockDate');

    // Real, native QR generation — no third-party image API. Renders as
    // SVG so it stays crisp at any TV resolution, with a simple paw
    // mark embedded in the center (solid single-color, white-backed —
    // a photo logo would just look muddy at QR scale). Inlined as a
    // data URL rather than a /assets file so this page never depends
    // on an external asset's state.
    const PAW_MARK_SVG = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="41" fill="#ffffff" stroke="#0f766e" stroke-width="6"/><g transform="translate(50,50) scale(2.55) translate(-12.2,-11)" fill="#0f766e"><ellipse cx="6.2" cy="7.8" rx="2" ry="2.8" transform="rotate(-25 6.2 7.8)"/><ellipse cx="10.2" cy="5.4" rx="2" ry="2.8" transform="rotate(-8 10.2 5.4)"/><ellipse cx="14.5" cy="5.4" rx="2" ry="2.8" transform="rotate(8 14.5 5.4)"/><ellipse cx="18.2" cy="7.9" rx="2" ry="2.8" transform="rotate(25 18.2 7.9)"/><path d="M12.2 10.1c-3.9 0-6.7 3.3-6.7 6.6 0 2.2 1.5 3.7 3.5 3.7 1.2 0 2.2-.7 3.2-.7s2 .7 3.2.7c2 0 3.5-1.5 3.5-3.7 0-3.3-2.8-6.6-6.7-6.6Z"/></g></svg>`;
    const PAW_MARK_DATA_URL = `data:image/svg+xml;base64,${btoa(PAW_MARK_SVG)}`;

    const qrCode = new QRCodeStyling({
      width: 260,
      height: 260,
      type: 'svg',
      data: window.location.origin,
      margin: 6,
      qrOptions: { errorCorrectionLevel: 'H' },
      dotsOptions: { color: '#0f766e', type: 'rounded' },
      cornersSquareOptions: { color: '#0f766e', type: 'extra-rounded' },
      cornersDotOptions: { color: '#0f766e', type: 'dot' },
      backgroundOptions: { color: '#ffffff' },
      image: PAW_MARK_DATA_URL,
      imageOptions: { margin: 3, imageSize: 0.28 },
    });
    qrCode.append($('petQr'));

    function updateClock() {
      const now = new Date();
      clockTime.textContent = now.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
      clockDate.textContent = now.toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' });
    }
    setInterval(updateClock, 1000);
    updateClock();

    function showPet(index: number) {
      if (!pets.length) return;
      currentIndex = (index + pets.length) % pets.length;
      const pet = pets[currentIndex];

      const applyChanges = () => {
        petPhoto.classList.remove('zooming');
        petPhoto.src = pet.image || '/assets/recovered/images/placeholder.svg';
        petPhoto.alt = pet.name;
        setTimeout(() => petPhoto.classList.add('zooming'), 50);

        petName.textContent = pet.name;
        petNameInline.textContent = pet.name;
        petAge.textContent = pet.age_display || pet.age || 'Unknown age';
        petGender.textContent = (pet.gender || 'Unknown').replace(/^\w/, (c) => c.toUpperCase());
        petBreed.textContent = pet.breed || 'Shelter pet';
        petSpeciesBadge.textContent = pet.type === 'cat' ? '🐈' : pet.type === 'dog' ? '🐕' : '🐾';

        // Real native adoption page — /adopt/{id}, generated by
        // src/pages/adopt/[id].astro directly from the live Directus feed.
        const petUrl = `${window.location.origin}/adopt/${pet.id}`;
        qrCode.update({ data: petUrl });
      };

      if (document.startViewTransition) {
        const transition = document.startViewTransition(applyChanges);
        transition.ready.catch(() => {});
        transition.finished.catch(() => {});
      } else {
        petCard.classList.add('is-transitioning');
        setTimeout(() => {
          applyChanges();
          petCard.classList.remove('is-transitioning');
        }, 220);
      }
    }

    function startRotation() {
      if (rotateInterval) clearInterval(rotateInterval);
      if (!isPlaying) return;
      rotateInterval = setInterval(() => showPet(currentIndex + 1), ROTATE_MS);
    }

    // Staff-only keyboard control — no on-screen buttons to keep the
    // display clean; anyone with a keyboard on the kiosk still has it.
    window.addEventListener('keydown', (e) => {
      if (e.key === ' ' || e.code === 'Space') {
        e.preventDefault();
        isPlaying = !isPlaying;
        startRotation();
      } else if (e.key === 'ArrowRight') {
        showPet(currentIndex + 1);
        startRotation();
      } else if (e.key === 'ArrowLeft') {
        showPet(currentIndex - 1);
        startRotation();
      } else if (e.key.toLowerCase() === 'f') {
        if (!document.fullscreenElement) document.documentElement.requestFullscreen().catch(() => {});
        else document.exitFullscreen().catch(() => {});
      }
    });

    async function requestWakeLock() {
      try {
        if ('wakeLock' in navigator) await navigator.wakeLock.request('screen');
      } catch {}
    }
    requestWakeLock();
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') requestWakeLock();
    });

    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }

    // Background refresh from the live Directus feed — the same one
    // PetSync writes to every 30 minutes — so the kiosk tracks new
    // arrivals/archives without a restart.
    setInterval(async () => {
      try {
        const res = await fetch(
          'https://mchs-directus.livelyfield-d0a70609.eastus.azurecontainerapps.io/items/pets?filter[archived_at][_null]=true&limit=-1'
        );
        if (!res.ok) return;
        const data = await res.json();
        if (data.data && data.data.length > 0) {
          pets = data.data
            .map((p: Pet) => ({ ...p, image: p.image_url || p.image || '/assets/recovered/images/placeholder.svg' }))
            .filter((p: Pet) => p.image && !p.image.includes('placeholder'));
        }
      } catch {}
    }, 15 * 60 * 1000);

    showPet(0);
    startRotation();
  </script>
</body>
</html>
