---
/**
 * Monroe Humane — TV Lobby Display / Kiosk
 *
 * Full-bleed poster layout for shelter lobby TVs: a blurred, scaled
 * copy of the current pet's own photo fills the whole screen as a
 * backdrop (purely decorative — it's the same image, never a
 * different/cropped substitute), so there's no dead space regardless
 * of a photo's aspect ratio, while the real featured photo in front
 * stays completely uncropped (object-fit: contain, sized as large as
 * the screen allows). Name/facts sit in a bottom caption bar, the
 * shelter's mark and the clock sit in the top corners, and one
 * always-on application QR code sits in the bottom-right corner.
 *
 * The QR code is generated natively in the browser (qr-code-styling,
 * bundled — no third-party image API call, no data: URL since the
 * site's CSP connect-src doesn't allow it) and points at the shelter's
 * adoption application form — a single static destination, not tied
 * to whichever pet is currently on screen. Pet data comes from the
 * same live Directus feed the rest of the site uses, with a
 * background refresh so the display tracks the PetSync pipeline
 * without a restart.
 */

import { getPets } from '../../lib/directus';
import { SITE } from '../../config/site';

const allPets = await getPets();
const pets = allPets.filter((p) => p.image && !p.image.includes('placeholder'));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>HSMC TV — Adoptable Pets</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Jost:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <style>
    :root {
      --tv-bg-deep: #061816;
      --tv-bg: #0c2a26;
      --tv-teal: #2dd4bf;
      --tv-teal-deep: #0f766e;
      --tv-gold: #fbbf24;
      --tv-text: #ffffff;
      --tv-text-muted: #a7d9d0;
      --tv-font-display: 'Abril Fatface', Georgia, serif;
      --tv-font-sans: 'Jost', 'Segoe UI', sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      width: 100vw;
      height: 100vh;
      overflow: hidden;
    }

    body {
      background: linear-gradient(160deg, var(--tv-bg-deep), var(--tv-bg));
      color: var(--tv-text);
      font-family: var(--tv-font-sans);
      position: relative;
      user-select: none;
      -webkit-font-smoothing: antialiased;
    }

    /* ---------------- Backdrop: the pet's own photo, blurred and
       scaled to fill every pixel behind it, so there's never dead
       space next to an uncropped photo of any aspect ratio. Purely
       decorative — the real photo up front is never cropped. ---------------- */
    .tv-backdrop-img {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: blur(60px) saturate(1.2) brightness(0.55);
      transform: scale(1.15);
      z-index: 0;
      transition: opacity 0.6s ease;
    }

    .tv-backdrop-scrim {
      position: fixed;
      inset: 0;
      z-index: 1;
      background:
        linear-gradient(to bottom, rgba(4, 16, 14, 0.55) 0%, transparent 20%),
        linear-gradient(to top, rgba(4, 16, 14, 0.92) 0%, rgba(4, 16, 14, 0.6) 24%, transparent 52%);
    }

    /* ---------------- Corner chrome: logo + clock, nothing else ---------------- */
    /* Fixed px, not vw/clamp — same TV-safe-area reasoning as the QR
       corner below: this needs to stay clear of a real screen's edge,
       not just "technically inside the reported viewport". */
    .tv-brand-corner {
      position: fixed;
      top: 56px;
      left: 64px;
      display: flex;
      align-items: center;
      gap: 14px;
      z-index: 3;
    }

    .tv-brand-corner img {
      height: clamp(2.5rem, 4vw, 3.5rem);
      width: auto;
      object-fit: contain;
      filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.35));
    }

    .tv-brand-corner span {
      font-family: var(--tv-font-display);
      font-size: clamp(1.1rem, 1.8vw, 1.5rem);
      color: var(--tv-text);
      letter-spacing: 0.01em;
    }

    .tv-clock-corner {
      position: fixed;
      top: 56px;
      right: 80px;
      text-align: right;
      z-index: 3;
    }

    .tv-clock-corner__time {
      font-size: clamp(1.5rem, 2.6vw, 2.25rem);
      font-weight: 800;
      letter-spacing: -0.01em;
      color: var(--tv-text);
      line-height: 1;
    }

    .tv-clock-corner__date {
      font-size: clamp(0.8rem, 1.1vw, 0.95rem);
      color: var(--tv-text-muted);
      margin-top: 0.3rem;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      font-weight: 600;
    }

    /* ---------------- The one thing on screen: the pet ---------------- */
    .tv-stage {
      position: relative;
      z-index: 2;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: clamp(5.5rem, 7vw, 6.5rem) clamp(1.5rem, 3vw, 3rem) clamp(8rem, 11vw, 9.5rem);
    }

    .tv-card { transition: opacity 0.45s ease; }
    .tv-card.is-transitioning { opacity: 0; }

    /* No fixed aspect-ratio box, no object-fit: cover — the photo is
       never cropped. The blurred backdrop (behind everything) is what
       fills the leftover space, so a narrow/portrait photo still reads
       as an intentional, full composition instead of dead space. */
    /* A definite (not shrink-to-fit) box — object-fit: contain only
       scales an image DOWN to fit a shrink-wrapped box, never up past
       its intrinsic pixel size. Giving the frame a fixed target size
       and letting the <img> fill it with object-fit: contain scales
       the photo up to use the space too, for the (very common) case
       of a lower-resolution shelter photo. Still zero cropping —
       contain always preserves the full image, just letterboxed
       within the frame when the aspect ratio doesn't match; the
       blurred backdrop shows through that letterboxing instead of
       flat dead space. */
    .tv-card__photo-wrap {
      position: relative;
      width: 94vw;
      height: 82vh;
      border-radius: 28px;
      overflow: hidden;
      border: 3px solid rgba(255, 255, 255, 0.14);
      box-shadow: 0 40px 90px rgba(0, 0, 0, 0.55);
    }

    .tv-card__photo {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
      transform: scale(1);
      transition: transform 9s ease, opacity 0.4s ease;
    }

    .tv-card__photo.zooming { transform: scale(1.05); }

    .tv-card__species-badge {
      position: absolute;
      top: 1.25rem;
      left: 1.25rem;
      width: 3.25rem;
      height: 3.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: rgba(6, 24, 22, 0.85);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(45, 212, 191, 0.4);
      font-size: 1.5rem;
    }

    /* ---------------- Bottom caption bar: name + facts, over the scrim ---------------- */
    .tv-caption {
      position: fixed;
      left: 64px;
      bottom: 64px;
      z-index: 3;
      max-width: 62vw;
    }

    .tv-card__name {
      font-family: var(--tv-font-display);
      font-size: clamp(3rem, 6vw, 5.25rem);
      line-height: 1;
      color: #ffffff;
      text-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
    }

    .tv-card__pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-top: 0.85rem;
    }

    .tv-pill {
      padding: 0.5rem 1.15rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
      backdrop-filter: blur(6px);
      font-size: clamp(0.9rem, 1.3vw, 1.1rem);
      font-weight: 600;
      color: #ffffff;
    }

    .tv-pill--accent {
      background: rgba(45, 212, 191, 0.2);
      border-color: rgba(45, 212, 191, 0.45);
      color: var(--tv-teal);
    }

    .tv-pill--gold {
      background: rgba(251, 191, 36, 0.2);
      border-color: rgba(251, 191, 36, 0.45);
      color: var(--tv-gold);
    }

    /* ---------------- The one QR code: always-on, application form ----------------
       Fixed pixel sizes here, not vw/clamp() — this corner is the one
       thing on the page that must stay a reliable physical size and
       scannable at arm's length no matter how a given TV's browser
       reports its viewport (smart-TV browsers are notoriously
       inconsistent about DPI/zoom). Everything else on the page can
       flex with viewport size; this can't. */
    .tv-apply-qr {
      /* Well inside typical TV overscan safe-area guidance (~5% of a
         1080p screen is ~54-96px) -- physical TVs commonly crop the
         outer edge of the picture regardless of what the browser
         reports, so this corner needs real breathing room, not just
         "technically inside the viewport". */
      position: fixed;
      bottom: 64px;
      right: 80px;
      display: flex;
      align-items: center;
      gap: 18px;
      z-index: 3;
    }

    .tv-apply-qr__label {
      text-align: right;
      font-family: var(--tv-font-display);
      font-size: 26px;
      color: #ffffff;
      text-shadow: 0 3px 16px rgba(0, 0, 0, 0.5);
      line-height: 1.15;
    }

    .tv-apply-qr__ring {
      position: relative;
      flex-shrink: 0;
      padding: 16px;
      border-radius: 30px;
      overflow: hidden;
      background: linear-gradient(135deg, var(--tv-teal), var(--tv-gold));
      box-shadow: 0 20px 45px rgba(0, 0, 0, 0.5);
      animation: tv-qr-pulse 3.2s ease-in-out infinite;
    }

    @keyframes tv-qr-pulse {
      0%, 100% { box-shadow: 0 20px 45px rgba(0, 0, 0, 0.5), 0 0 0 0 rgba(45, 212, 191, 0.4); }
      50% { box-shadow: 0 20px 45px rgba(0, 0, 0, 0.5), 0 0 0 14px rgba(45, 212, 191, 0); }
    }

    .tv-apply-qr__code {
      width: 240px;
      height: 240px;
      background: #ffffff;
      border-radius: 18px;
      padding: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      box-sizing: border-box;
    }

    /* The generated SVG is already sized to exactly fill this box's
       216px content area (see the QRCodeStyling call below) — no
       width/height: 100% override needed, which is what silently
       stretched and off-centered it before (a percentage-height-on-
       SVG quirk that resolved width but not height). */
    .tv-apply-qr__code svg { display: block; }

    @media (max-width: 900px) {
      .tv-caption { max-width: 90vw; }
      .tv-apply-qr { flex-direction: column-reverse; align-items: flex-end; gap: 8px; }
      .tv-apply-qr__label { text-align: right; font-size: 18px; }
    }
  </style>
</head>
<body>
  <!-- Backdrop: same photo as the featured pet, blurred + scaled to
       fill the whole screen so there's never dead space next to an
       uncropped photo of any shape. -->
  <img id="petBackdrop" class="tv-backdrop-img" src="" alt="" aria-hidden="true" />
  <div class="tv-backdrop-scrim"></div>

  <!-- Logo -->
  <div class="tv-brand-corner">
    <img src={SITE.assets.logo} alt="Monroe Humane" />
    <span>Monroe Humane</span>
  </div>

  <!-- Time -->
  <div class="tv-clock-corner">
    <div class="tv-clock-corner__time" id="clockTime">12:00 PM</div>
    <div class="tv-clock-corner__date" id="clockDate">Monroe, MI</div>
  </div>

  <!-- Pet spotlight -->
  <div class="tv-stage">
    <div class="tv-card" id="petCard">
      <div class="tv-card__photo-wrap">
        <img id="petPhoto" class="tv-card__photo zooming" src="" alt="" />
        <span class="tv-card__species-badge" id="petSpeciesBadge">🐕</span>
      </div>
    </div>
  </div>

  <!-- Name + facts, overlaid on the darkened bottom of the backdrop -->
  <div class="tv-caption">
    <h1 class="tv-card__name" id="petName">&nbsp;</h1>
    <div class="tv-card__pills">
      <span class="tv-pill tv-pill--gold" id="petAge">Age</span>
      <span class="tv-pill tv-pill--accent" id="petGender">Gender</span>
      <span class="tv-pill" id="petBreed">Breed</span>
    </div>
  </div>

  <!-- The one QR code on the whole page: always-on, always the same
       destination — the shelter's adoption application form. -->
  <div class="tv-apply-qr">
    <span class="tv-apply-qr__label">🐾 Scan me<br />to apply!</span>
    <div class="tv-apply-qr__ring">
      <div class="tv-apply-qr__code" id="applyQr"></div>
    </div>
  </div>

  <!-- Data handoff: kept as a tiny inline script (no bundling) so the
       server-rendered pet list reaches the bundled module script below
       without needing a network round trip on load. -->
  <script is:inline define:vars={{ initialPets: pets }}>
    window.__TV_INITIAL_PETS__ = initialPets || [];
  </script>

  <script>
    import QRCodeStyling from 'qr-code-styling';
    import type { Pet } from '../../lib/directus';

    function $<T extends HTMLElement>(id: string): T {
      return document.getElementById(id) as T;
    }

    let pets: Pet[] = (window as unknown as { __TV_INITIAL_PETS__?: Pet[] }).__TV_INITIAL_PETS__ || [];
    let currentIndex = 0;
    let isPlaying = true;
    let rotateInterval: ReturnType<typeof setInterval> | null = null;
    const ROTATE_MS = 10000;

    const petPhoto = $<HTMLImageElement>('petPhoto');
    const petBackdrop = $<HTMLImageElement>('petBackdrop');
    const petSpeciesBadge = $('petSpeciesBadge');
    const petName = $('petName');
    const petAge = $('petAge');
    const petGender = $('petGender');
    const petBreed = $('petBreed');
    const petCard = $('petCard');
    const clockTime = $('clockTime');
    const clockDate = $('clockDate');

    // The one QR code on the page: static, always the shelter's
    // adoption application form — not tied to whichever pet happens to
    // be on screen, so it's rendered once and never updated. Real,
    // native generation (qr-code-styling, bundled) — no third-party
    // image API. Gradient dots + the shelter's paw mark in the center
    // for a themed, not-generic look; SVG output stays crisp at any TV
    // resolution. The mark is served as a same-origin file
    // (public/assets/tv-qr-mark.svg) rather than a data: URL — the
    // site's CSP connect-src is 'self' https:' with no data:
    // allowance, and qr-code-styling loads its embedded image via
    // fetch(), which is gated by connect-src, not img-src.
    const APPLICATION_FORM_URL =
      'https://docs.google.com/forms/d/e/1FAIpQLSfA70kSNxQZQBbC0Jq9gHfmgHiAs4k5ytci3t4IhOMzfrSjhQ/viewform';

    // Sized to exactly match the container's content box (240px box,
    // 12px padding -> 216px) instead of relying on a CSS width/height:
    // 100% override on the generated <svg>. That override silently
    // failed for height only (a percentage-height-on-SVG quirk — width
    // resolved to the container's 100%, height stayed at the library's
    // own intrinsic attribute), which is what stretched and
    // off-centered the code inside its card. Generating it at the
    // right size in the first place sidesteps the whole class of bug.
    //
    // Styling favors scan reliability over decoration: standard
    // 'rounded' dots (not 'extra-rounded', which thins the modules
    // more than is safe at small on-screen size) in a single solid
    // color (a gradient reduces module contrast, which hurts phone
    // cameras scanning from a few feet away more than it helps
    // aesthetics), max error correction, and a modest embedded-logo
    // footprint so there's real redundancy to spare.
    //
    // Deliberately NOT setting cornersDotOptions (the finder pattern's
    // inner "eye"): verified with jsQR that a colored 'dot'-shaped eye
    // combined with the embedded center logo reliably fails to decode
    // — every other combination of these options decodes fine on its
    // own, only that specific pairing breaks finder-pattern detection.
    // Leaving the eye as the library's plain default fixes it.
    const applyQrCode = new QRCodeStyling({
      width: 216,
      height: 216,
      type: 'svg',
      data: APPLICATION_FORM_URL,
      margin: 8,
      qrOptions: { errorCorrectionLevel: 'H' },
      dotsOptions: { type: 'rounded', color: '#0f766e' },
      cornersSquareOptions: { type: 'extra-rounded', color: '#0f766e' },
      backgroundOptions: { color: '#ffffff' },
      image: '/assets/tv-qr-mark.svg',
      imageOptions: { hideBackgroundDots: true, margin: 6, imageSize: 0.2 },
    });
    applyQrCode.append($('applyQr'));

    // Verify the code actually decodes back to the right URL instead
    // of just assuming the styling options above didn't break it —
    // BarcodeDetector is available in Chromium-based browsers (which
    // is what actual TV/kiosk hardware almost always runs).
    if ('BarcodeDetector' in window) {
      setTimeout(async () => {
        try {
          const svgEl = $('applyQr').querySelector('svg');
          if (!svgEl) return;
          const svgData = new XMLSerializer().serializeToString(svgEl);
          const svgBlob = new Blob([svgData], { type: 'image/svg+xml' });
          const bitmap = await createImageBitmap(svgBlob);
          // eslint-disable-next-line @typescript-eslint/no-explicit-any
          const detector = new (window as any).BarcodeDetector({ formats: ['qr_code'] });
          const results = await detector.detect(bitmap);
          const ok = results.some((r: { rawValue: string }) => r.rawValue === APPLICATION_FORM_URL);
          if (!ok) console.error('[TV QR] Generated code failed self-check — does not decode to the application form URL.', results);
        } catch (err) {
          console.warn('[TV QR] Self-check skipped:', err);
        }
      }, 500);
    }

    function updateClock() {
      const now = new Date();
      clockTime.textContent = now.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
      clockDate.textContent = now.toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' });
    }
    setInterval(updateClock, 1000);
    updateClock();

    function showPet(index: number) {
      if (!pets.length) return;
      currentIndex = (index + pets.length) % pets.length;
      const pet = pets[currentIndex];

      const applyChanges = () => {
        const photoSrc = pet.image || '/assets/recovered/images/placeholder.svg';
        petPhoto.classList.remove('zooming');
        petPhoto.src = photoSrc;
        petPhoto.alt = pet.name;
        petBackdrop.src = photoSrc;
        setTimeout(() => petPhoto.classList.add('zooming'), 50);

        petName.textContent = pet.name;
        petAge.textContent = pet.age_display || pet.age || 'Unknown age';
        petGender.textContent = (pet.gender || 'Unknown').replace(/^\w/, (c) => c.toUpperCase());
        petBreed.textContent = pet.breed || 'Shelter pet';
        petSpeciesBadge.textContent = pet.type === 'cat' ? '🐈' : pet.type === 'dog' ? '🐕' : '🐾';
      };

      if (document.startViewTransition) {
        const transition = document.startViewTransition(applyChanges);
        transition.ready.catch(() => {});
        transition.finished.catch(() => {});
      } else {
        petCard.classList.add('is-transitioning');
        setTimeout(() => {
          applyChanges();
          petCard.classList.remove('is-transitioning');
        }, 220);
      }
    }

    function startRotation() {
      if (rotateInterval) clearInterval(rotateInterval);
      if (!isPlaying) return;
      rotateInterval = setInterval(() => showPet(currentIndex + 1), ROTATE_MS);
    }

    // Staff-only keyboard control — no on-screen buttons to keep the
    // display clean; anyone with a keyboard on the kiosk still has it.
    window.addEventListener('keydown', (e) => {
      if (e.key === ' ' || e.code === 'Space') {
        e.preventDefault();
        isPlaying = !isPlaying;
        startRotation();
      } else if (e.key === 'ArrowRight') {
        showPet(currentIndex + 1);
        startRotation();
      } else if (e.key === 'ArrowLeft') {
        showPet(currentIndex - 1);
        startRotation();
      } else if (e.key.toLowerCase() === 'f') {
        if (!document.fullscreenElement) document.documentElement.requestFullscreen().catch(() => {});
        else document.exitFullscreen().catch(() => {});
      }
    });

    async function requestWakeLock() {
      try {
        if ('wakeLock' in navigator) await navigator.wakeLock.request('screen');
      } catch {}
    }
    requestWakeLock();
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') requestWakeLock();
    });

    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }

    // Background refresh from the live Directus feed — the same one
    // PetSync writes to every 30 minutes — so the kiosk tracks new
    // arrivals/archives without a restart.
    setInterval(async () => {
      try {
        const res = await fetch(
          'https://mchs-directus.livelyfield-d0a70609.eastus.azurecontainerapps.io/items/pets?filter[archived_at][_null]=true&limit=-1'
        );
        if (!res.ok) return;
        const data = await res.json();
        if (data.data && data.data.length > 0) {
          pets = data.data
            .map((p: Pet) => ({ ...p, image: p.image_url || p.image || '/assets/recovered/images/placeholder.svg' }))
            .filter((p: Pet) => p.image && !p.image.includes('placeholder'));
        }
      } catch {}
    }, 15 * 60 * 1000);

    showPet(0);
    startRotation();
  </script>
</body>
</html>
