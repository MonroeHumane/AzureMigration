        grantsContainer.querySelectorAll('.btn-row-edit, .grant-title-btn').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const el = e.currentTarget as HTMLElement;
            const grantId = el.dataset.id;
            if (grantId) openEditGrant(grantId);
          });
        });

        applyFilterAndSearch();
      } catch (error: any) {
        console.error('Error loading grants:', error);
        const sessionMissing = String(error?.message || '') === 'CMS_SESSION_MISSING';
        setGrantSyncState('error', sessionMissing ? 'Sign in again to load the pipeline' : 'Could not reach grant records');

        if (!grantsContainer) return;
        grantsContainer.innerHTML = `
          <div class="empty-state py-14 px-6 text-center text-slate-500 dark:text-slate-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 mx-auto mb-3 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <h3 class="text-base font-bold text-slate-800 dark:text-white mb-1">${sessionMissing ? 'Staff session needs a refresh' : 'Could not load grants pipeline'}</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 max-w-md mx-auto leading-relaxed">${sessionMissing ? 'Your portal login is still open, but the grants service could not authorize this request. Sign in once more, then return here.' : 'The grants tracker talks to Directus through the staff API. Retry in a moment, or open CMS Admin if records still do not appear.'}</p>
            <div class="mt-4 flex items-center justify-center gap-2">
              <button type="button" id="retry-grants-btn" class="btn-success text-xs font-semibold px-3.5 py-2 rounded-lg">Retry</button>
              ${sessionMissing ? `<a href="/internal/?reauth=1&redirect=${encodeURIComponent('/internal/grants/')}" class="btn-outline text-xs font-semibold px-3.5 py-2 rounded-lg inline-flex">Sign in again</a>` : `<a href="${DIRECTUS_URL}/admin/content/grants" target="_blank" rel="noopener noreferrer" class="btn-outline text-xs font-semibold px-3.5 py-2 rounded-lg inline-flex">Open Directus ↗</a>`}
            </div>
          </div>
        `;
        const retryBtn = document.getElementById('retry-grants-btn');
        retryBtn?.addEventListener('click', () => loadGrants());
      }
    }

    loadGrants();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGrantsPortal);
  } else {
    initGrantsPortal();
  }
  document.addEventListener('astro:page-load', initGrantsPortal);
</script>
