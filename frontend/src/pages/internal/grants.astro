<script>
  import { staffClient, DIRECTUS_URL, isStaffAuthenticated, ensureDirectusSession, getStaffToken } from '../../lib/staff-auth';
  import { readItems, createItem, updateItem, deleteItem } from '@directus/sdk';

  // Standardized representations of the user's raw grant records
  interface StandardizedGrantProfile {
    match: (title: string, notes: string) => boolean;
    standardTitle: string;
    funder: string;
    amount: string;
    numericAmount: number;
    source: string;
    status: string;
    notes: string;
  }

  const STANDARDIZED_ENTRIES: Record<string, StandardizedGrantProfile> = {
    lazboy: {
      match: (title: string, notes: string) =>
        /la\s*z\s*boy/i.test(title) || /feline room 25k/i.test(title) || /feline room 25k/i.test(notes),
      standardTitle: 'La-Z-Boy Foundation — Feline Room Renovation',
      funder: 'La-Z-Boy Foundation',
      amount: '$25,000',
      numericAmount: 25000,
      source: 'Corporate Foundation',
      status: 'open',
      notes: 'Capital grant for shelter feline adoption room expansion and modern cat housing suites. Amount: $25,000.'
    },
    azure: {
      match: (title: string, notes: string) =>
        /azure/i.test(title) || /tech credits/i.test(notes),
      standardTitle: 'Microsoft Azure for Nonprofits Cloud Grant',
      funder: 'Microsoft Philanthropies',
      amount: '$2,000 / yr',
      numericAmount: 2000,
      source: 'Technology Grant',
      status: 'awarded',
      notes: 'Annual recurring nonprofit cloud credits supporting Monroe Humane website, Directus CMS, database, and PetSync services. Amount: $2,000/yr.'
    },
    durbano: {
      match: (title: string, notes: string) =>
        /durbano/i.test(title) || (/feline room/i.test(notes) && /15k/i.test(notes)),
      standardTitle: 'Dave Durbano Philanthropic Gift — Feline Care Wing',
      funder: 'Dave Durbano / Private Philanthropy',
      amount: '$15,000',
      numericAmount: 15000,
      source: 'Major Donor',
      status: 'open',
      notes: 'Dedicated major donor sponsorship towards feline isolation & adoption suites renovation. Amount: $15,000.'
    },
    lebel: {
      match: (title: string, _notes: string) =>
        /lebel/i.test(title),
      standardTitle: 'The Harold & Grace LeBel Foundation Grant',
      funder: 'The Harold & Grace LeBel Foundation',
      amount: '$2,000',
      numericAmount: 2000,
      source: 'Private Foundation',
      status: 'open',
      notes: 'Animal welfare operations, intake veterinary medical supplies, and shelter care support. Amount: $2,000.'
    }
  };

  // Extract dollar value from title or notes if not in the standardized dictionary
  function extractGrantAmount(title: string, notes: string): { display: string; numeric: number } {
    const combined = `${title || ''} ${notes || ''}`;
    const matchK = combined.match(/\$?\s*([0-9]+(?:\.[0-9]+)?)\s*k\b/i);
    if (matchK) {
      const val = Math.round(parseFloat(matchK[1]) * 1000);
      const isYearly = /yr|year|annual/i.test(combined);
      return {
        display: isYearly ? `$${val.toLocaleString('en-US')} / yr` : `$${val.toLocaleString('en-US')}`,
        numeric: val
      };
    }
    const matchDollar = combined.match(/\$\s*([0-9]{1,3}(?:,[0-9]{3})+(?:\.[0-9]{2})?|\b[0-9]{3,7}\b)/);
    if (matchDollar) {
      const clean = matchDollar[1].replace(/,/g, '');
      const val = parseFloat(clean);
      const isYearly = /yr|year|annual/i.test(combined);
      return {
        display: isYearly ? `$${val.toLocaleString('en-US')} / yr` : `$${val.toLocaleString('en-US')}`,
        numeric: val
      };
    }
    return { display: '—', numeric: 0 };
  }

  // Parse and normalize grant object for display & edit
  function normalizeGrantData(grant: any) {
    const title = grant.title || '';
    const notes = grant.deadline_notes || '';
    
    // Check known standardized entries
    for (const key of Object.keys(STANDARDIZED_ENTRIES)) {
      const item = STANDARDIZED_ENTRIES[key];
      if (item.match(title, notes)) {
        const isCasualNotes = (
          !notes.trim() ||
          notes === title ||
          notes.toLowerCase() === 'feline room 15k' ||
          notes.toLowerCase().includes('free tech credits') ||
          notes.toLowerCase() === 'the lebel foundation grant' ||
          notes.toLowerCase() === 'la z boy feline room 25k'
        );
        const isRaw = (
          title === 'La z boy Feline room 25k' ||
          title === 'azure grant $2k' ||
          title === 'Dave Durbano' ||
          title === 'The LeBel Foundation Grant 2k' ||
          grant.source === 'Manual' ||
          isCasualNotes
        );
        return {
          id: grant.id,
          rawTitle: title,
          rawSource: grant.source,
          rawStatus: grant.status,
          rawNotes: notes,
          title: item.standardTitle,
          funder: item.funder,
          amount: item.amount,
          numericAmount: item.numericAmount,
          source: grant.source === 'Manual' ? item.source : (grant.source || item.source),
          status: (title.toLowerCase().includes('azure') && grant.status === 'open') ? 'awarded' : (grant.status || item.status),
          notes: isCasualNotes ? item.notes : notes,
          isRaw,
          standardProfile: item
        };
      }
    }

    // Default fallback parsing
    const extracted = extractGrantAmount(title, notes);
    let funder = 'Monroe Community Philanthropy';
    if (title.includes('—')) {
      funder = title.split('—')[0].trim();
    } else if (title.includes('-')) {
      funder = title.split('-')[0].trim();
    }

    return {
      id: grant.id,
      rawTitle: title,
      rawSource: grant.source,
      rawStatus: grant.status,
      rawNotes: notes,
      title: title,
      funder: funder,
      amount: extracted.display,
      numericAmount: extracted.numeric,
      source: grant.source || 'Direct Contact',
      status: grant.status || 'open',
      notes: notes || 'No notes specified.',
      isRaw: false,
      standardProfile: null
    };
  }

  // Determine Source badge class
  function getSourceBadgeClass(source: string): string {
    const s = (source || '').toLowerCase();
    if (s.includes('corporate') || s.includes('foundation') && s.includes('la-z-boy')) return 'corporate';
    if (s.includes('tech') || s.includes('azure') || s.includes('cloud')) return 'technology';
    if (s.includes('foundation') || s.includes('lebel')) return 'foundation';
    if (s.includes('donor') || s.includes('gift') || s.includes('durbano')) return 'donor';
    return 'manual';
  }

  // Determine status dot color
  function getStatusDotClass(status: string): string {
    const s = (status || '').toLowerCase();
    if (s === 'awarded' || s === 'won') return 'bg-emerald-500';
    if (s === 'open') return 'bg-teal-500 animate-pulse';
    if (s === 'applied' || s === 'submitted') return 'bg-blue-500';
    if (s === 'watch') return 'bg-amber-500';
    return 'bg-slate-400';
  }

  // Deadline Urgency Badge Formatter
  function formatDeadlineBadge(notesText: string): string {
    if (!notesText) return '';
    const text = notesText.trim();
    const isoMatch = text.match(/\b(202[5-9]-[0-1][0-9]-[0-3][0-9])\b/);
    const usMatch = text.match(/\b([0-1]?[0-9])\/([0-3]?[0-9])\/(202[5-9])\b/);
    
    let targetDate: Date | null = null;
    if (isoMatch && isoMatch[1]) {
      targetDate = new Date(isoMatch[1] + 'T00:00:00');
    } else if (usMatch && usMatch[1] && usMatch[2] && usMatch[3]) {
      targetDate = new Date(`${usMatch[3]}-${usMatch[1].padStart(2, '0')}-${usMatch[2].padStart(2, '0')}T00:00:00`);
    }

    if (targetDate && !isNaN(targetDate.getTime())) {
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const diffDays = Math.ceil((targetDate.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));
      if (diffDays < 0) {
        return `<span class="inline-block text-[10px] font-semibold px-1.5 py-0.5 rounded bg-slate-100 text-slate-500 border border-slate-200 ml-1.5">Past Due</span>`;
      } else if (diffDays === 0) {
        return `<span class="inline-block text-[10px] font-bold px-1.5 py-0.5 rounded bg-rose-100 text-rose-800 border border-rose-200 ml-1.5 animate-pulse">Due Today</span>`;
      } else if (diffDays <= 7) {
        return `<span class="inline-block text-[10px] font-bold px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 border border-amber-200 ml-1.5">Due in ${diffDays}d</span>`;
      } else if (diffDays <= 30) {
        return `<span class="inline-block text-[10px] font-semibold px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800 border border-emerald-200 ml-1.5">Due in ${diffDays}d</span>`;
      } else {
        return `<span class="inline-block text-[10px] font-medium px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 border border-slate-200 ml-1.5">${diffDays}d left</span>`;
      }
    }
    return '';
  }

  function escapeHtml(value: unknown): string {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  async function staffApi(path: string, options: RequestInit = {}): Promise<Response> {
    const token = await getStaffToken();
    if (!token) throw new Error('No staff session');
    return fetch(path, {
      ...options,
      headers: {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${token}`,
        'X-Staff-Token': token,
        'X-Authorization': `Bearer ${token}`,
        ...(options.headers || {}),
      },
    });
  }

  function setGrantSyncState(state: 'connecting' | 'ok' | 'error', note?: string) {
    const statSync = document.getElementById('grant-stat-sync');
    const statSyncNote = document.getElementById('grant-stat-sync-note');
    if (!statSync) return;
    if (state === 'ok') {
      statSync.className = 'font-bold text-emerald-700 dark:text-emerald-400 text-base block mt-1 flex items-center gap-1.5';
      statSync.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500 dark:bg-emerald-400"></span> Synchronized`;
      if (statSyncNote) statSyncNote.textContent = note || 'Directus records loaded';
      return;
    }
    if (state === 'error') {
      statSync.className = 'font-bold text-amber-600 dark:text-amber-400 text-base block mt-1 flex items-center gap-1.5';
      statSync.innerHTML = `<span class="w-2 h-2 rounded-full bg-amber-500"></span> Unavailable`;
      if (statSyncNote) statSyncNote.textContent = note || 'Could not reach grant records';
      return;
    }
    statSync.className = 'font-bold text-slate-600 dark:text-slate-300 text-base block mt-1 flex items-center gap-1.5';
    statSync.innerHTML = `<span class="w-2 h-2 rounded-full bg-slate-400 animate-pulse"></span> Connecting`;
    if (statSyncNote) statSyncNote.textContent = note || 'Checking grant records…';
  }

  function initGrantsPortal() {
    const dashboardView = document.getElementById('dashboard-view') as HTMLElement | null;
    const grantsContainer = document.getElementById('grants-container') as HTMLElement | null;
    if (!dashboardView || !grantsContainer) return;

    if (!isStaffAuthenticated()) {
      window.location.replace('/internal/?redirect=' + encodeURIComponent(window.location.pathname + window.location.search));
      return;
    }

    // Display dashboard view immediately for authenticated staff
    dashboardView.style.display = 'block';

    // Add Grant Modal elements
    const addModal = document.getElementById('add-grant-modal') as HTMLDialogElement | null;
    const btnOpenAddModal = document.getElementById('add-grant-btn') as HTMLButtonElement | null;
    const btnCloseAddModal = document.getElementById('close-modal-btn') as HTMLButtonElement | null;
    const btnCancelAddModal = document.getElementById('cancel-modal-btn') as HTMLButtonElement | null;
    const formAddGrant = document.getElementById('add-grant-form') as HTMLFormElement | null;

    // Edit Grant Modal elements
    const editModal = document.getElementById('edit-grant-modal') as HTMLDialogElement | null;
    const btnCloseEditModal = document.getElementById('close-edit-modal-btn') as HTMLButtonElement | null;
    const btnCancelEditModal = document.getElementById('cancel-edit-modal-btn') as HTMLButtonElement | null;
    const formEditGrant = document.getElementById('edit-grant-form') as HTMLFormElement | null;
    const btnDeleteGrant = document.getElementById('delete-grant-btn') as HTMLButtonElement | null;

    // Edit form inputs
    const editIdInput = document.getElementById('edit-id') as HTMLInputElement | null;
    const editTitleInput = document.getElementById('edit-title') as HTMLInputElement | null;
    const editAmountInput = document.getElementById('edit-amount') as HTMLInputElement | null;
    const editSourceInput = document.getElementById('edit-source') as HTMLSelectElement | null;
    const editStatusInput = document.getElementById('edit-status') as HTMLSelectElement | null;
    const editDeadlineInput = document.getElementById('edit-deadline') as HTMLInputElement | null;
    const editNotesInput = document.getElementById('edit-notes') as HTMLTextAreaElement | null;

    // Add form inputs
    const newTitleInput = document.getElementById('new-title') as HTMLInputElement | null;
    const newAmountInput = document.getElementById('new-amount') as HTMLInputElement | null;
    const newSourceInput = document.getElementById('new-source') as HTMLSelectElement | null;
    const newStatusInput = document.getElementById('new-status') as HTMLSelectElement | null;
    const newDeadlineInput = document.getElementById('new-deadline') as HTMLInputElement | null;
    const newNotesInput = document.getElementById('new-notes') as HTMLTextAreaElement | null;

    // Toast element
    const toast = document.getElementById('grant-action-toast') as HTMLElement | null;
    const toastText = document.getElementById('grant-action-toast-text') as HTMLElement | null;
    const btnCloseToast = document.getElementById('close-toast-btn') as HTMLButtonElement | null;

    function showToast(message: string) {
      if (toast && toastText) {
        toastText.textContent = message;
        toast.classList.remove('hidden');
        setTimeout(() => {
          toast.classList.add('hidden');
        }, 6000);
      }
    }

    btnCloseToast?.addEventListener('click', () => {
      toast?.classList.add('hidden');
    });

    // Add Modal handlers
    if (btnOpenAddModal && btnOpenAddModal.dataset.bound !== '1') {
      btnOpenAddModal.dataset.bound = '1';
      btnOpenAddModal.addEventListener('click', () => addModal?.showModal());
    }
    if (btnCloseAddModal && btnCloseAddModal.dataset.bound !== '1') {
      btnCloseAddModal.dataset.bound = '1';
      btnCloseAddModal.addEventListener('click', () => addModal?.close());
    }
    if (btnCancelAddModal && btnCancelAddModal.dataset.bound !== '1') {
      btnCancelAddModal.dataset.bound = '1';
      btnCancelAddModal.addEventListener('click', () => addModal?.close());
    }

    // Edit Modal handlers
    if (btnCloseEditModal && btnCloseEditModal.dataset.bound !== '1') {
      btnCloseEditModal.dataset.bound = '1';
      btnCloseEditModal.addEventListener('click', () => editModal?.close());
    }
    if (btnCancelEditModal && btnCancelEditModal.dataset.bound !== '1') {
      btnCancelEditModal.dataset.bound = '1';
      btnCancelEditModal.addEventListener('click', () => editModal?.close());
    }

    // Backdrop click handlers for dialogs
    [addModal, editModal].forEach((dlg) => {
      if (dlg && dlg.dataset.boundBackdrop !== '1') {
        dlg.dataset.boundBackdrop = '1';
        dlg.addEventListener('click', (e) => {
          const rect = dlg.getBoundingClientRect();
          if (
            e.clientX < rect.left ||
            e.clientX > rect.right ||
            e.clientY < rect.top ||
            e.clientY > rect.bottom
          ) {
            dlg.close();
          }
        });
      }
    });

    // Handle Create Grant
    if (formAddGrant && formAddGrant.dataset.bound !== '1') {
      formAddGrant.dataset.bound = '1';
      formAddGrant.addEventListener('submit', async (e) => {
        e.preventDefault();
        const title = newTitleInput?.value.trim();
        const amount = newAmountInput?.value.trim();
        const source = newSourceInput?.value || 'Corporate Foundation';
        const status = newStatusInput?.value || 'open';
        const deadline = newDeadlineInput?.value || '';
        let notes = newNotesInput?.value.trim() || '';

        if (!title) return;

        if (amount && !notes.includes(amount)) {
          notes = notes ? `Amount: ${amount}. ${notes}` : `Amount: ${amount}.`;
        }
        if (deadline && !notes.includes(deadline)) {
          notes = notes ? `Deadline: ${deadline}. ${notes}` : `Deadline: ${deadline}`;
        }

        try {
          const res = await staffApi('/api/grants', {
            method: 'POST',
            body: JSON.stringify({ title, source, status, deadline_notes: notes }),
          });
          if (!res.ok) {
            await staffClient.request(createItem('grants', {
              id: crypto.randomUUID(),
              title,
              source,
              status,
              deadline_notes: notes
            }));
          }

          formAddGrant.reset();
          addModal?.close();
          showToast(`Grant "${title}" successfully recorded to Directus!`);
          loadGrants();
        } catch (error: any) {
          console.error('Error creating grant:', error);
          alert('Failed to save grant. Please verify staff permissions.');
        }
      });
    }

    // Handle Edit Grant Form
    if (formEditGrant && formEditGrant.dataset.bound !== '1') {
      formEditGrant.dataset.bound = '1';
      formEditGrant.addEventListener('submit', async (e) => {
        e.preventDefault();
        const grantId = editIdInput?.value;
        const title = editTitleInput?.value.trim();
        const amount = editAmountInput?.value.trim();
        const source = editSourceInput?.value || 'Corporate Foundation';
        const status = editStatusInput?.value || 'open';
        const deadline = editDeadlineInput?.value || '';
        let notes = editNotesInput?.value.trim() || '';

        if (!grantId || !title) return;

        if (amount && !notes.includes(amount)) {
          notes = notes ? `Amount: ${amount}. ${notes}` : `Amount: ${amount}.`;
        }
        if (deadline && !notes.includes(deadline)) {
          notes = notes ? `Deadline: ${deadline}. ${notes}` : `Deadline: ${deadline}`;
        }

        try {
          const res = await staffApi(`/api/grants/${encodeURIComponent(grantId)}`, {
            method: 'PATCH',
            body: JSON.stringify({ title, source, status, deadline_notes: notes }),
          });
          if (!res.ok) {
            await staffClient.request(updateItem('grants', grantId, {
              title,
              source,
              status,
              deadline_notes: notes
            }));
          }

          editModal?.close();
          showToast(`Grant "${title}" updated successfully!`);
          loadGrants();
        } catch (error: any) {
          console.error('Error updating grant:', error);
          alert('Failed to update grant. Please verify your connection.');
        }
      });
    }

    // Handle Delete Grant
    if (btnDeleteGrant && btnDeleteGrant.dataset.bound !== '1') {
      btnDeleteGrant.dataset.bound = '1';
      btnDeleteGrant.addEventListener('click', async () => {
        const grantId = editIdInput?.value;
        const title = editTitleInput?.value || 'this grant';
        if (!grantId) return;

        if (!confirm(`Are you sure you want to delete "${title}"? This cannot be undone.`)) {
          return;
        }

        try {
          const res = await staffApi(`/api/grants/${encodeURIComponent(grantId)}`, { method: 'DELETE' });
          if (!res.ok) {
            await staffClient.request(deleteItem('grants', grantId));
          }
          editModal?.close();
          showToast(`Grant "${title}" deleted.`);
          loadGrants();
        } catch (error: any) {
          console.error('Error deleting grant:', error);
          alert('Failed to delete grant record.');
        }
      });
    }

    let currentGrants: any[] = [];
    let normalizedGrants: any[] = [];
    let currentFilter: string = 'all';

    // Search and Filter Elements
    const searchInput = document.getElementById('grants-search-input') as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById('clear-search-btn') as HTMLButtonElement | null;
    const filterPillsContainer = document.getElementById('grants-filter-pills') as HTMLElement | null;
    const countPill = document.getElementById('grants-count-pill') as HTMLElement | null;
    const btnStandardize = document.getElementById('standardize-grants-btn') as HTMLButtonElement | null;

    function applyFilterAndSearch() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      if (clearSearchBtn) {
        clearSearchBtn.classList.toggle('hidden', query.length === 0);
      }

      const rows = grantsContainer?.querySelectorAll('[data-status]') || [];
      let visibleCount = 0;
      const countedIds = new Set<string>();

      rows.forEach((tr) => {
        const status = (tr.getAttribute('data-status') || '').toLowerCase();
        const text = tr.textContent?.toLowerCase() || '';
        
        const matchesStatus = currentFilter === 'all'
          || status === currentFilter
          || (currentFilter === 'open' && (status === 'applied' || status === 'submitted' || status === 'pending'))
          || (currentFilter === 'awarded' && (status === 'won' || status === 'awarded'))
          || (currentFilter === 'applied' && (status === 'applied' || status === 'submitted'));
        const matchesQuery = query === '' || text.includes(query);

        if (matchesStatus && matchesQuery) {
          (tr as HTMLElement).style.display = '';
          const rowId = tr.getAttribute('data-id') || String(visibleCount);
          if (!countedIds.has(rowId)) {
            countedIds.add(rowId);
            visibleCount++;
          }
        } else {
          (tr as HTMLElement).style.display = 'none';
        }
      });

      if (countPill) {
        if (currentFilter === 'all') {
          countPill.textContent = `${visibleCount} of ${normalizedGrants.length} Grants`;
        } else {
          countPill.textContent = `${visibleCount} ${currentFilter.toUpperCase()} Grants`;
        }
      }
    }

    if (searchInput && searchInput.dataset.bound !== '1') {
      searchInput.dataset.bound = '1';
      searchInput.addEventListener('input', applyFilterAndSearch);
    }

    if (clearSearchBtn && clearSearchBtn.dataset.bound !== '1') {
      clearSearchBtn.dataset.bound = '1';
      clearSearchBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          applyFilterAndSearch();
          searchInput.focus();
        }
      });
    }

    if (filterPillsContainer && filterPillsContainer.dataset.bound !== '1') {
      filterPillsContainer.dataset.bound = '1';
      filterPillsContainer.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.filter-pill') as HTMLButtonElement | null;
        if (!btn) return;
        const filter = btn.dataset.filter || 'all';
        currentFilter = filter;

        filterPillsContainer.querySelectorAll('.filter-pill').forEach((p) => {
          p.classList.remove('active', 'bg-teal-800', 'text-white');
          p.classList.add('bg-white', 'text-slate-600');
        });
        btn.classList.add('active', 'bg-teal-800', 'text-white');
        btn.classList.remove('bg-white', 'text-slate-600');

        applyFilterAndSearch();
      });
    }

    // CSV Export button listener
    const exportBtn = document.getElementById('export-grants-csv-btn') as HTMLButtonElement | null;
    if (exportBtn && exportBtn.dataset.bound !== '1') {
      exportBtn.dataset.bound = '1';
      exportBtn.addEventListener('click', () => {
        if (!normalizedGrants || !normalizedGrants.length) {
          alert('No grant records to export yet.');
          return;
        }

        const headers = ['Grant Title', 'Funder / Entity', 'Estimated Amount', 'Discovery Source', 'Pipeline Status', 'Notes & Milestones'];
        const rows = normalizedGrants.map((g) => [
          `"${(g.title || '').replace(/"/g, '""')}"`,
          `"${(g.funder || '').replace(/"/g, '""')}"`,
          `"${(g.amount || '').replace(/"/g, '""')}"`,
          `"${(g.source || '').replace(/"/g, '""')}"`,
          `"${(g.status || '').replace(/"/g, '""')}"`,
          `"${(g.notes || '').replace(/"/g, '""')}"`,
        ]);

        const csvString = [headers.join(','), ...rows.map((r) => r.join(','))].join('\r\n');
        const blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.setAttribute('download', `Monroe_Humane_Grants_${new Date().toISOString().slice(0, 10)}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
      });
    }

    // Open Edit Modal for a given grant
    function openEditGrant(grantId: string) {
      const grant = normalizedGrants.find((g) => g.id === grantId);
      if (!grant) return;

      if (editIdInput) editIdInput.value = grant.id;
      if (editTitleInput) editTitleInput.value = grant.title;
      if (editAmountInput) editAmountInput.value = grant.amount !== '—' ? grant.amount : '';
      if (editSourceInput) {
        // Match option or default
        let matched = false;
        for (let i = 0; i < editSourceInput.options.length; i++) {
          if (editSourceInput.options[i].value === grant.source) {
            editSourceInput.selectedIndex = i;
            matched = true;
            break;
          }
        }
        if (!matched) editSourceInput.value = 'Corporate Foundation';
      }
      if (editStatusInput) editStatusInput.value = grant.status || 'open';
      if (editDeadlineInput) {
        const isoMatch = (grant.notes || '').match(/\b(202[5-9]-[0-1][0-9]-[0-3][0-9])\b/);
        editDeadlineInput.value = isoMatch ? isoMatch[1] : '';
      }
      if (editNotesInput) editNotesInput.value = grant.notes;

      editModal?.showModal();
    }

    // Automatic & Manual Standardization Function
    async function standardizeAllRawEntries(silent = false) {
      const rawRecords = normalizedGrants.filter((g) => g.isRaw && g.standardProfile);
      if (!rawRecords.length) return;

      let updatedCount = 0;
      for (const item of rawRecords) {
        try {
          await staffClient.request(updateItem('grants', item.id, {
            title: item.standardProfile.standardTitle,
            source: item.standardProfile.source,
            status: item.standardProfile.status,
            deadline_notes: item.standardProfile.notes
          }));
          item.isRaw = false;
          updatedCount++;
        } catch (err) {
          console.warn(`Could not sync grant ${item.id} to Directus:`, err);
        }
      }

      if (updatedCount > 0) {
        if (!silent) {
          showToast(`✨ ${updatedCount} grant entries standardized & permanently saved to Directus CMS!`);
        }
        btnStandardize?.classList.add('hidden');
        loadGrants();
      }
    }

    if (btnStandardize && btnStandardize.dataset.bound !== '1') {
      btnStandardize.dataset.bound = '1';
      btnStandardize.addEventListener('click', () => {
        btnStandardize.disabled = true;
        btnStandardize.innerHTML = `<span class="animate-spin">⏳</span> Standardizing...`;
        standardizeAllRawEntries(false);
      });
    }

    async function fetchGrantsFromDirectus(): Promise<any[]> {
      try {
        const res = await staffApi('/api/grants');
        if (res.ok) {
          const payload = await res.json();
          if (Array.isArray(payload?.data)) return payload.data;
        }
      } catch (err) {
        console.warn('[Grants] /api/grants unavailable, trying Directus SDK', err);
      }

      const cmsReady = await ensureDirectusSession();
      if (!cmsReady) {
        throw new Error('CMS_SESSION_MISSING');
      }

      const attempts: Array<Record<string, unknown>> = [
        { limit: -1, sort: ['-date_created'] },
        { limit: -1, sort: ['-date_updated'] },
        { limit: -1 },
      ];
      let lastError: unknown = null;
      for (const query of attempts) {
        try {
          const grants = await staffClient.request(readItems('grants', query));
          return Array.isArray(grants) ? grants : [];
        } catch (err) {
          lastError = err;
        }
      }
      throw lastError || new Error('Could not load grants');
    }

    async function loadGrants() {
      setGrantSyncState('connecting');
      if (grantsContainer && !grantsContainer.querySelector('[data-status], table')) {
        grantsContainer.innerHTML = `
          <div class="empty-state py-14 text-center text-slate-500 dark:text-slate-400">
            <div class="grants-spinner mx-auto mb-4"></div>
            <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Loading grants pipeline…</p>
            <p class="text-xs mt-1">Fetching records from Directus CMS</p>
          </div>
        `;
      }

      try {
        currentGrants = await fetchGrantsFromDirectus();
        normalizedGrants = currentGrants.map(normalizeGrantData);

        const statusRank = (status: string) => {
          const s = (status || '').toLowerCase();
          if (s === 'awarded' || s === 'won') return 0;
          if (s === 'open' || s === 'applied' || s === 'submitted' || s === 'pending') return 1;
          if (s === 'watch') return 2;
          return 3;
        };
        normalizedGrants.sort((a, b) => statusRank(a.status) - statusRank(b.status) || (b.numericAmount || 0) - (a.numericAmount || 0));

        // Check if there are any raw entries needing standardization
        const rawCount = normalizedGrants.filter((g) => g.isRaw).length;
        if (btnStandardize) {
          if (rawCount > 0) {
            btnStandardize.classList.remove('hidden');
            btnStandardize.classList.add('inline-flex');
            btnStandardize.disabled = false;
            btnStandardize.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3z"/></svg>
              <span>✨ Standardize ${rawCount} Entries</span>
            `;
            // Trigger automatic non-blocking sync in background
            standardizeAllRawEntries(true);
          } else {
            btnStandardize.classList.add('hidden');
          }
        }

        // Calculate Portfolio Totals
        const totalCount = normalizedGrants.length;
        const awardedGrants = normalizedGrants.filter((g) => (g.status || '').toLowerCase() === 'awarded' || (g.status || '').toLowerCase() === 'won');
        const openGrants = normalizedGrants.filter((g) => {
          const s = (g.status || '').toLowerCase();
          return s === 'open' || s === 'submitted' || s === 'pending' || s === 'applied';
        });

        const totalValue = normalizedGrants.reduce((sum, g) => sum + (g.numericAmount || 0), 0);
        const awardedValue = awardedGrants.reduce((sum, g) => sum + (g.numericAmount || 0), 0);
        const openValue = openGrants.reduce((sum, g) => sum + (g.numericAmount || 0), 0);

        // Update KPI Ribbon
        const statTotal = document.getElementById('grant-stat-total');
        if (statTotal) statTotal.textContent = totalCount.toString();
        const statTotalValue = document.getElementById('grant-stat-total-value');
        if (statTotalValue) statTotalValue.textContent = `$${totalValue.toLocaleString('en-US')} Total Value`;

        const statAwarded = document.getElementById('grant-stat-awarded');
        if (statAwarded) statAwarded.textContent = awardedGrants.length.toString();
        const statAwardedValue = document.getElementById('grant-stat-awarded-value');
        if (statAwardedValue) statAwardedValue.textContent = awardedValue > 0 ? `$${awardedValue.toLocaleString('en-US')} Won` : '$0 Won';

        const statOpen = document.getElementById('grant-stat-open');
        if (statOpen) statOpen.textContent = openGrants.length.toString();
        const statOpenValue = document.getElementById('grant-stat-open-value');
        if (statOpenValue) statOpenValue.textContent = `$${openValue.toLocaleString('en-US')} In Pipeline`;

        setGrantSyncState('ok', `${totalCount} record${totalCount === 1 ? '' : 's'} from Directus`);

        if (!grantsContainer) return;

        if (normalizedGrants.length === 0) {
          grantsContainer.innerHTML = `
            <div class="empty-state py-14 text-center text-slate-500 dark:text-slate-400">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 mx-auto mb-3 text-teal-300 dark:text-teal-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
              <h3 class="text-base font-bold text-slate-800 dark:text-white mb-1">No grants recorded yet</h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 max-w-sm mx-auto">Click “+ Add Grant” to log a foundation opportunity, capital gift, or awarded funding.</p>
            </div>
          `;
          if (countPill) countPill.textContent = '0 Grants';
          return;
        }

        let html = `
          <div class="grants-table-wrap">
          <table>
            <thead>
              <tr>
                <th>Grant Opportunity &amp; Funder</th>
                <th style="min-width: 120px;">Amount</th>
                <th>Source</th>
                <th>Status</th>
                <th style="min-width: 220px;">Notes &amp; Milestones</th>
                <th style="text-align: right; min-width: 90px;">Actions</th>
              </tr>
            </thead>
            <tbody>
        `;

        let cardsHtml = `<div class="grants-cards">`;

        for (const item of normalizedGrants) {
          const sourceClass = getSourceBadgeClass(item.source);
          const dotClass = getStatusDotClass(item.status);
          const deadlineBadge = formatDeadlineBadge(item.notes);
          const directusEditUrl = `${DIRECTUS_URL}/admin/content/grants/${item.id}`;

          cardsHtml += `
            <article class="grant-card" data-id="${escapeHtml(item.id)}" data-status="${escapeHtml(item.status)}">
              <div class="flex items-start justify-between gap-3">
                <button type="button" class="grant-title-btn text-left min-w-0" data-id="${escapeHtml(item.id)}">
                  <h3 class="font-bold text-slate-900 dark:text-white text-sm leading-snug">${escapeHtml(item.title)}</h3>
                  <p class="text-xs text-slate-500 dark:text-teal-200/70 mt-0.5">${escapeHtml(item.funder)}</p>
                </button>
                <span class="amount-chip shrink-0 inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold font-mono bg-emerald-50 text-emerald-800 border border-emerald-200">${escapeHtml(item.amount)}</span>
              </div>
              <div class="flex flex-wrap items-center gap-1.5 mt-3">
                <span class="badge-status ${escapeHtml(item.status)}">
                  <span class="w-1.5 h-1.5 rounded-full ${dotClass}"></span>
                  <span>${escapeHtml(item.status)}</span>
                </span>
                <span class="badge-source ${sourceClass}">${escapeHtml(item.source)}</span>
                ${deadlineBadge}
              </div>
              <p class="text-xs text-slate-600 dark:text-slate-300 mt-2.5 line-clamp-2" title="${escapeHtml(item.notes)}">${escapeHtml(item.notes)}</p>
              <div class="mt-3 flex items-center justify-end gap-1">
                <button type="button" class="btn-row-edit text-xs font-semibold px-2.5 py-1.5 rounded-lg text-teal-800 dark:text-teal-200 hover:bg-teal-50 dark:hover:bg-teal-950/50" data-id="${escapeHtml(item.id)}">Edit</button>
                <a href="${escapeHtml(directusEditUrl)}" target="_blank" rel="noopener noreferrer" class="text-xs font-semibold px-2.5 py-1.5 rounded-lg text-slate-500 hover:bg-slate-100 dark:hover:bg-teal-950/50">CMS ↗</a>
              </div>
            </article>
          `;

          html += `
            <tr data-id="${escapeHtml(item.id)}" data-status="${escapeHtml(item.status)}">
              <!-- Title & Funder -->
              <td>
                <div class="flex items-start justify-between gap-2">
                  <div>
                    <div class="font-bold text-slate-900 dark:text-white hover:text-teal-700 dark:hover:text-emerald-300 transition cursor-pointer text-sm flex items-center gap-1.5 grant-title-btn" data-id="${escapeHtml(item.id)}" title="Click to edit details">
                      <span>${escapeHtml(item.title)}</span>
                    </div>
                    <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 flex items-center gap-1.5 font-medium">
                      <span>${escapeHtml(item.funder)}</span>
                    </div>
                  </div>
                </div>
              </td>

              <!-- Estimated Amount / Value -->
              <td>
                <span class="amount-chip inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold font-mono bg-emerald-50 text-emerald-800 border border-emerald-200 shadow-xs">
                  ${escapeHtml(item.amount)}
                </span>
              </td>

              <!-- Discovery Source Badge -->
              <td>
                <span class="badge-source ${sourceClass}">
                  ${escapeHtml(item.source)}
                </span>
              </td>

              <!-- Status Badge -->
              <td>
                <span class="badge-status ${escapeHtml(item.status)}">
                  <span class="w-1.5 h-1.5 rounded-full ${dotClass}"></span>
                  <span>${escapeHtml(item.status)}</span>
                </span>
              </td>

              <!-- Notes & Deadlines -->
              <td class="text-xs text-slate-600 dark:text-slate-300 max-w-sm">
                <div class="line-clamp-2" title="${escapeHtml(item.notes)}">
                  ${escapeHtml(item.notes)}
