---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StaffPortalNav from '../../components/internal/StaffPortalNav.astro';
import MobileBottomNav from '../../components/internal/MobileBottomNav.astro';
import MobileMoreSheet from '../../components/internal/MobileMoreSheet.astro';
import { getStaffPetSyncData } from '../../lib/directus';

const petSyncData = await getStaffPetSyncData();
const directusAdminUrl = 'https://mchs-directus.livelyfield-d0a70609.eastus.azurecontainerapps.io/admin';
const petSyncLabel = petSyncData.lastSyncTimestamp
  ? new Date(petSyncData.lastSyncTimestamp).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' })
  : 'time unknown';
---

<BaseLayout
  title="Staff Portal | Humane Society of Monroe County"
  description="Humane Society of Monroe County Staff Portal: Animal Census, Board Financials, and Grants Pipeline."
  bodyClass="antialiased min-h-screen relative overflow-x-hidden"
>
  <!-- Zero-Flicker Synchronous Auth Hydration (Runs before paint) -->
  <script is:inline>
    (function() {
      try {
        var token = localStorage.getItem('mchs_staff_token') || sessionStorage.getItem('mchs_staff_token') || '';
        var hasAuth = token.indexOf('mchs_') === 0 && token.indexOf('.') !== -1;
        if (hasAuth) {
          document.documentElement.classList.add('staff-authenticated');
        }
      } catch (e) {}
    })();
  </script>

  <!-- SCREEN 1: UNIFIED STAFF LOGIN GATE (Shown when unauthenticated) -->
  <div id="staff-portal-auth-gate" class="min-h-dvh flex items-center justify-center p-4 sm:p-6 lg:p-8 relative overflow-hidden">
    <!-- Theme Switcher Pill in Top Right -->
    <div class="absolute top-4 right-4 sm:top-6 sm:right-6 z-20">
      <button
        type="button"
        class="staff-theme-toggle-btn"
        title="Toggle Staff Portal Theme (Light / Dark Ops)"
        aria-label="Toggle Staff Portal Theme"
      >
        <svg class="theme-icon-sun w-3.5 h-3.5 hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="theme-icon-moon w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <span class="theme-toggle-label text-xs">Light</span>
      </button>
    </div>

    <!-- Subtle Ambient Glow -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-teal-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Centered Auth Card -->
    <div class="auth-card w-full max-w-md bg-white rounded-3xl border border-slate-200/90 shadow-2xl p-6 sm:p-10 animate-fade-in relative z-10 my-auto transition-colors duration-200">
      
      <!-- Brand Header -->
      <div class="text-center mb-7">
        <div class="auth-brand-icon inline-flex p-3 rounded-2xl bg-[#173a39] text-emerald-300 mb-3.5 shadow-md border border-teal-800 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <h1 class="auth-title text-xl font-bold text-[#173a39] tracking-tight">
          Humane Society of Monroe County
        </h1>
        <div class="auth-pill inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-teal-50 text-teal-800 border border-teal-200/80 mt-2">
          Staff &amp; Board Portal
        </div>
        <p class="auth-subtitle text-xs text-slate-500 mt-2">
          Sign in with your staff account to continue
        </p>
        <!-- Dynamic Redirect Destination Indicator -->
        <div id="login-redirect-notice" class="hidden mt-3 px-3 py-1.5 rounded-xl bg-teal-50 dark:bg-teal-950/60 border border-teal-200 dark:border-teal-800/80 text-[11px] text-teal-800 dark:text-teal-300 items-center justify-center gap-1.5 animate-fade-in">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 shrink-0 text-teal-600 dark:text-teal-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span>Sign in to access: <strong id="login-redirect-dest" class="font-semibold"></strong></span>
        </div>
      </div>

      <!-- Offline Connectivity Banner -->
      <div id="login-offline-alert" class="hidden p-3 rounded-xl bg-amber-50 dark:bg-amber-950/50 border border-amber-200 dark:border-amber-800/80 text-xs text-amber-800 dark:text-amber-300 leading-relaxed mb-4 animate-fade-in" role="status">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-600 dark:text-amber-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="1" y1="1" x2="23" y2="23"></line>
            <path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55"></path>
            <path d="M5 12.55a10.94 10.94 0 0 1 5.17-2.39"></path>
            <path d="M10.71 5.05A16 16 0 0 1 22.58 9"></path>
            <path d="M1.42 9a15.91 15.91 0 0 1 4.7-2.88"></path>
            <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
            <line x1="12" y1="20" x2="12.01" y2="20"></line>
          </svg>
          <span>You are currently offline. Please verify your connection.</span>
        </div>
      </div>

      <!-- Error Alert Container -->
      <div id="login-error-alert" role="alert" aria-live="polite" aria-atomic="true" class="hidden p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-700 leading-relaxed mb-5 animate-shake">
        <div class="flex items-start gap-2.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-rose-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span id="login-error-text">Invalid email or password. Please try again.</span>
        </div>
      </div>

      <!-- Interactive Form -->
      <form id="unified-login-form" class="space-y-4">
        <div>
          <label for="unified-email" class="auth-label block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
            Email Address
          </label>
          <div class="relative">
            <input
              type="email"
              id="unified-email"
              name="email"
              required
              autocomplete="username"
              autocapitalize="none"
              autocorrect="off"
              spellcheck="false"
              inputmode="email"
              placeholder="name@monroe-humane.org"
              aria-required="true"
              aria-invalid="false"
              class="auth-input w-full pl-4 pr-10 py-3 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-700 focus:border-teal-700 transition bg-slate-50/50 focus:bg-white text-slate-900"
            />
            <button
              type="button"
              id="email-clear-btn"
              class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1.5 focus:outline-none cursor-pointer rounded-lg hover:bg-slate-100 transition"
              title="Clear email"
              aria-label="Clear email"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="unified-password" class="auth-label block text-xs font-bold text-slate-700 uppercase tracking-wider">
              Password
            </label>
          </div>
          <div class="relative">
            <input
              type="password"
              id="unified-password"
              name="password"
              required
              autocomplete="current-password"
              autocapitalize="none"
              autocorrect="off"
              spellcheck="false"
              placeholder="••••••••••••"
              aria-required="true"
              aria-invalid="false"
              class="auth-input w-full pl-4 pr-11 py-3 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-700 focus:border-teal-700 transition bg-slate-50/50 focus:bg-white text-slate-900"
            />
            <button
              type="button"
              id="password-reveal-btn"
              class="auth-reveal-btn absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1.5 focus:outline-none cursor-pointer rounded-lg hover:bg-slate-100 transition"
              title="Show password"
              aria-label="Show password"
              aria-controls="unified-password"
              aria-pressed="false"
            >
              <svg id="eye-icon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              <svg id="eye-off-icon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
                <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
                <line x1="2" x2="22" y1="2" y2="22"></line>
              </svg>
            </button>
          </div>
          <!-- Caps Lock Detection Indicator -->
          <div id="caps-lock-warning" class="hidden mt-1.5 text-[11px] text-amber-600 dark:text-amber-400 font-medium flex items-center gap-1.5" role="status">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="3" rx="2"></rect>
              <path d="M12 8v8"></path>
              <path d="m8 12 4-4 4 4"></path>
            </svg>
            <span>Caps Lock is ON</span>
          </div>
        </div>

        <div class="flex items-center justify-between text-xs pt-1">
          <label class="auth-remember-label flex items-center gap-2.5 text-slate-600 cursor-pointer select-none">
            <input
              type="checkbox"
              id="unified-remember-me"
              checked
              class="w-4 h-4 rounded text-teal-800 focus:ring-teal-700 border-slate-300 cursor-pointer"
            />
            <span class="font-medium">Remember this device (30 days)</span>
          </label>
          <span class="text-[11px] text-slate-400 dark:text-slate-500 hidden sm:inline" title="Uncheck on shared clinical or reception workstations to terminate session on exit">Shared PC?</span>
        </div>

        <button
          type="submit"
          id="unified-submit-btn"
          class="auth-submit-btn w-full py-3.5 px-6 rounded-xl bg-[#173a39] hover:bg-teal-900 active:scale-[0.98] text-white font-bold text-sm shadow-lg shadow-teal-950/20 transition-all flex items-center justify-center gap-2 cursor-pointer mt-2"
        >
          <span id="btn-text">Sign In &rarr;</span>
          <svg id="btn-spinner" class="hidden animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>

        <!-- Need Help / Password Assistance Collapsible Drawer -->
        <div class="pt-1 text-center">
          <button
            type="button"
            id="login-help-toggle"
            class="text-xs text-slate-500 hover:text-teal-800 dark:text-slate-400 dark:hover:text-teal-300 font-medium cursor-pointer transition inline-flex items-center gap-1.5 focus:outline-none py-1"
            aria-expanded="false"
            aria-controls="login-help-drawer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-400 dark:text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
            <span>Need sign-in help?</span>
          </button>
          <div id="login-help-drawer" class="hidden mt-2 p-3.5 rounded-xl bg-slate-50 dark:bg-[#061815] border border-slate-200 dark:border-teal-900/80 text-left text-xs text-slate-600 dark:text-slate-300 leading-relaxed animate-fade-in shadow-xs">
            <div class="font-semibold text-slate-800 dark:text-slate-100 mb-1 flex items-center justify-between text-[11px]">
              <span>Staff &amp; Board Access</span>
              <a href="https://mchs-directus.livelyfield-d0a70609.eastus.azurecontainerapps.io/admin/login" target="_blank" rel="noopener noreferrer" class="text-teal-700 dark:text-teal-400 hover:underline font-mono text-[10px]">CMS Admin ↗</a>
            </div>
            <p class="text-[11px] mb-2 text-slate-500 dark:text-slate-400">
              Accounts are provisioned by Monroe County Humane Society administration.
            </p>
            <ul class="text-[11px] space-y-1 list-disc list-inside text-slate-600 dark:text-slate-300">
              <li>To reset your password, email <a href="mailto:info@monroe-humane.org" class="text-teal-700 dark:text-teal-300 underline font-medium">info@monroe-humane.org</a>.</li>
              <li>For urgent shelter terminal issues, call <strong class="text-slate-800 dark:text-slate-200">(734) 243-3669</strong>.</li>
              <li>Always uncheck <em>Remember this device</em> on shared reception and clinic computers.</li>
            </ul>
          </div>
        </div>
      </form>

      <div class="auth-footer pt-5 mt-5 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500 transition-colors">
        <a href="/" class="hover:text-teal-800 transition flex items-center gap-1.5 font-medium">
          &larr; Return to Public Website
        </a>
        <span class="auth-footer-hint text-slate-400 text-[11px] font-mono">Press ↵ to enter</span>
      </div>
    </div>
  </div>

  <!-- SCREEN 2: UNIFIED STAFF PORTAL HUB (Shown when authenticated) -->
  <div id="staff-portal-content" class="min-h-screen pb-20 relative z-10" transition:animate="fade">
    <!-- Ambient Atmospheric Glow (Matching the login screen) -->
    <div class="fixed -top-32 -left-32 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="fixed -bottom-32 -right-32 w-96 h-96 bg-teal-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>

    <!-- Component 1: Unified Staff Header Navigation with Global Sign Out -->
    <StaffPortalNav activeTab="overview" />

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 sm:mt-8 space-y-6">
      <!-- Welcome Hero Header -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-2 border-b border-slate-200 dark:border-teal-800/60">
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
              Staff Operations Hub
            </h1>
            <span class="staff-live-badge px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-50 text-emerald-800 border border-emerald-200 dark:bg-teal-900/60 dark:text-teal-300 dark:border-teal-700/60">
              Live
            </span>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-300 mt-1 flex flex-wrap items-center gap-x-2 gap-y-1">
            <span id="staff-user-email" class="font-medium text-slate-800 dark:text-slate-200"></span>
            <span class="text-slate-400 dark:text-slate-500">·</span>
            <span id="hub-status-financials" class="text-slate-600 dark:text-slate-300">Financials</span>
            <span class="text-slate-400 dark:text-slate-500">·</span>
            <span id="hub-status-petsync" class="text-slate-600 dark:text-slate-300">Census · {petSyncData.activeCount} in care · {petSyncLabel}</span>
          </p>
        </div>

        <div class="flex items-center gap-2 text-xs">
          <a
            href="/internal/board/print/"
            target="_blank"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-teal-950/80 hover:bg-teal-900 text-slate-200 hover:text-white border border-teal-700/80 transition text-xs font-semibold shadow-xs"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect width="12" height="8" x="6" y="14"></rect></svg>
            <span>Print Packet</span>
          </a>
          <a
            href={directusAdminUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-teal-700 hover:bg-teal-600 text-white font-semibold transition text-xs shadow-md"
          >
            <span>CMS Admin ↗</span>
          </a>
        </div>
      </div>

      <div id="hub-data-status" class="hidden rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs text-slate-700 dark:border-teal-800/60 dark:bg-teal-950/40 dark:text-slate-300" role="status"></div>

      <!-- 4 Headline Command Metric Cards (Neutralized, Clean Aesthetic) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Card 1: Checking / Cash -->
        <a href="/internal/board/" class="group block rounded-2xl border border-slate-200 dark:border-teal-800/70 bg-white dark:bg-[#0b2420]/85 backdrop-blur-md p-5 hover:border-teal-500/40 hover:bg-teal-50/60 dark:hover:bg-[#0d2a25] hover:shadow-xl hover:shadow-teal-950/10 dark:hover:shadow-teal-950/25 transition-all">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-teal-800 dark:text-slate-400 uppercase tracking-wider">Checking &amp; Treasury</span>
            <div class="p-1.5 rounded-lg bg-teal-50 text-teal-800 border border-teal-200 dark:bg-teal-950/80 dark:text-teal-300 dark:border-teal-800/80">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
            </div>
          </div>
          <div id="metric-bank-cash" class="mt-2 text-2xl sm:text-3xl font-mono font-bold text-slate-900 dark:text-white transition">--</div>
          <div id="metric-bank-period" class="mt-1 text-xs text-slate-500 dark:text-slate-400"></div>
          <div id="metric-audit-diff" class="mt-1 text-xs text-slate-500 dark:text-slate-400"></div>
          <div id="card-bank-cash" class="hidden"></div>
          <div class="mt-3 pt-2.5 border-t border-slate-100 dark:border-teal-900/80 flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400 group-hover:text-slate-700 dark:group-hover:text-slate-200 transition">
            <span>Operating balance &amp; audit</span>
            <span class="text-teal-700 dark:text-teal-400 group-hover:translate-x-0.5 transition">&rarr;</span>
          </div>
        </a>

        <!-- Card 2: Shelter Animal Census -->
        <a href="/internal/pets/" class="group block rounded-2xl border border-slate-200 dark:border-teal-800/70 bg-white dark:bg-[#0b2420]/85 backdrop-blur-md p-5 hover:border-teal-500/40 hover:bg-teal-50/60 dark:hover:bg-[#0d2a25] hover:shadow-xl hover:shadow-teal-950/10 dark:hover:shadow-teal-950/25 transition-all">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-teal-800 dark:text-slate-400 uppercase tracking-wider">Animal Census</span>
            <div class="p-1.5 rounded-lg bg-teal-50 text-teal-800 border border-teal-200 dark:bg-teal-950/80 dark:text-teal-300 dark:border-teal-800/80">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="m10 15 5-3-5-3v6Z"></path></svg>
            </div>
          </div>
