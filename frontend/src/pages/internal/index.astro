---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StaffPortalNav from '../../components/internal/StaffPortalNav.astro';
import PetSyncPortal from '../../components/internal/PetSyncPortal.astro';
import { getStaffPetSyncData } from '../../lib/directus';
import reportData from '../../data/published_2026_ytd.json';

const petSyncData = await getStaffPetSyncData();

const formatDollar = (val: number) => {
  const isNeg = val < 0;
  const abs = Math.abs(val);
  const formatted = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 }).format(abs);
  return isNeg ? `(${formatted})` : formatted;
};
---

<BaseLayout
  title="Unified Staff Portal | Humane Society of Monroe County"
  description="Humane Society of Monroe County Unified Staff Portal: PetSync Operations, Board Financials, Grants Tracker, and Directus CMS."
  bodyClass="bg-[#f9f7f2] text-slate-800 antialiased"
>
  <!-- SCREEN 1: UNIFIED STAFF LOGIN GATE (Shown when unauthenticated) -->
  <div id="staff-portal-auth-gate" class="min-h-screen flex items-center justify-center p-4 bg-[#f4f1ea]">
    <div class="w-full max-w-md bg-white rounded-2xl border border-slate-200 shadow-xl overflow-hidden animate-fade-in">
      <!-- Brand Header -->
      <div class="bg-[#173a39] p-8 text-center text-white relative">
        <div class="inline-flex p-3 rounded-xl bg-teal-800/80 text-emerald-300 border border-teal-700/80 shadow-inner mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <h1 class="text-xl font-bold tracking-tight text-white">
          Humane Society of Monroe County
        </h1>
        <p class="text-xs text-teal-200/90 mt-1 font-medium">
          Unified Staff & Board Portal
        </p>
        <span class="inline-block mt-3 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
          Authorized Access Only
        </span>
      </div>

      <!-- Login Form Card Body -->
      <div class="p-6 sm:p-8 space-y-5">
        <div class="text-xs text-slate-500 text-center">
          Please sign in with your Directus CMS credentials to access shelter operations, financials, and grants.
        </div>

        <div id="login-error-alert" class="hidden p-3 rounded-lg bg-rose-50 border border-rose-200 text-xs text-rose-700 leading-relaxed">
          <div class="flex items-start gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-rose-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span id="login-error-text">Invalid email or password. Please try again.</span>
          </div>
        </div>

        <form id="unified-login-form" class="space-y-4">
          <div>
            <label for="unified-email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
              Staff Email Address
            </label>
            <div class="relative">
              <input
                type="email"
                id="unified-email"
                required
                autocomplete="username"
                placeholder="name@monroe-humane.org"
                class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-700 focus:border-teal-700 transition"
              />
            </div>
          </div>

          <div>
            <label for="unified-password" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
              Password
            </label>
            <div class="relative">
              <input
                type="password"
                id="unified-password"
                required
                autocomplete="current-password"
                placeholder="••••••••"
                class="w-full pl-3.5 pr-10 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-700 focus:border-teal-700 transition"
              />
              <button
                type="button"
                id="password-reveal-btn"
                class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1 focus:outline-none cursor-pointer"
                title="Toggle password visibility"
                aria-label="Toggle password visibility"
              >
                <svg id="eye-icon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <svg id="eye-off-icon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                  <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
                  <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
                  <line x1="2" x2="22" y1="2" y2="22"></line>
                </svg>
              </button>
            </div>
          </div>

          <div class="flex items-center justify-between text-xs pt-1">
            <label class="flex items-center gap-2 text-slate-600 cursor-pointer select-none">
              <input
                type="checkbox"
                id="unified-remember-me"
                checked
                class="w-4 h-4 rounded text-teal-800 focus:ring-teal-700 border-slate-300 cursor-pointer"
              />
              <span>Remember me on this device</span>
            </label>
          </div>

          <button
            type="submit"
            id="unified-submit-btn"
            class="w-full py-2.5 px-4 rounded-lg bg-[#173a39] hover:bg-teal-900 text-white font-bold text-sm shadow-md transition flex items-center justify-center gap-2 cursor-pointer"
          >
            <span id="btn-text">Secure Sign In</span>
            <svg id="btn-spinner" class="hidden animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </button>
        </form>

        <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
          <a href="/" class="hover:text-teal-800 transition flex items-center gap-1 font-medium">
            &larr; Return to Public Site
          </a>
          <span class="text-slate-400 text-[11px]">Directus Single Sign-On</span>
        </div>
      </div>
    </div>
  </div>

  <!-- SCREEN 2: UNIFIED STAFF PORTAL HUB (Shown when authenticated) -->
  <div id="staff-portal-content" class="min-h-screen pb-16">
    <!-- Component 1: Unified Staff Header Navigation with Global Sign Out -->
    <StaffPortalNav activeTab="overview" />

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 space-y-6">
      <!-- Executive Command & Status Ribbon -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-xs p-6">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-teal-100 text-teal-800 border border-teal-200">
                Staff Operations Hub
              </span>
              <span id="staff-user-chip" class="text-xs text-slate-500 font-medium">
                Signed in as <strong id="staff-user-email" class="text-slate-800">staff@monroe-humane.org</strong>
              </span>
            </div>
            <h1 class="text-2xl font-bold text-[#173a39] tracking-tight">
              Shelter Operations & Executive Command
            </h1>
            <p class="text-xs text-slate-500 mt-0.5">
              Unified operational hub for shelter animal census, board financial governance, and grant pipeline.
            </p>
          </div>

          <!-- Operational Status Pills -->
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="px-2.5 py-1 rounded-md bg-emerald-100 text-emerald-800 font-semibold border border-emerald-200 inline-flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Directus CMS Online
            </span>
            <span class="px-2.5 py-1 rounded-md bg-amber-100 text-amber-900 font-semibold border border-amber-200 inline-flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-amber-500"></span>
              PetSync: 30m Auto-Sync
            </span>
            <span class="px-2.5 py-1 rounded-md bg-slate-100 text-slate-700 font-medium border border-slate-200">
              QBO (Accrual Reconciled)
            </span>
          </div>
        </div>

        <!-- Executive Pulse Metrics Row (4 Key Indicators) -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-6 pt-6 border-t border-slate-100">
          <div class="p-3.5 rounded-lg bg-amber-50/70 border border-amber-200/80">
            <span class="text-[11px] font-bold uppercase tracking-wider text-amber-900 block">Shelter Census</span>
            <div class="text-2xl font-black text-amber-950 mt-1">
              {petSyncData.activeCount} <span class="text-xs font-normal text-amber-800">active pets</span>
            </div>
            <span class="text-[11px] text-amber-700 block mt-0.5">Live PetPoint Feed</span>
          </div>

          <div class="p-3.5 rounded-lg bg-teal-50/70 border border-teal-200/80">
            <span class="text-[11px] font-bold uppercase tracking-wider text-teal-900 block">Bank Operating Cash</span>
            <div class="text-2xl font-black text-teal-950 mt-1 font-mono">
              {formatDollar(reportData.statement_of_position.assets.operating_checking_bank_register)}
            </div>
            <span class="text-[11px] text-teal-700 block mt-0.5">First Merchants (Aug 31)</span>
          </div>

          <div class="p-3.5 rounded-lg bg-emerald-50/70 border border-emerald-200/80">
            <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-900 block">Cash Runway</span>
            <div class="text-2xl font-black text-emerald-950 mt-1 font-mono">
              14.3 <span class="text-xs font-normal text-emerald-800">months</span>
            </div>
            <span class="text-[11px] text-emerald-700 block mt-0.5">~434 Days of Operations</span>
          </div>

          <div class="p-3.5 rounded-lg bg-purple-50/70 border border-purple-200/80">
            <span class="text-[11px] font-bold uppercase tracking-wider text-purple-900 block">Grants Pipeline</span>
            <div class="text-2xl font-black text-purple-950 mt-1">
              Active <span class="text-xs font-normal text-purple-800">sync</span>
            </div>
            <span class="text-[11px] text-purple-700 block mt-0.5">Directus CMS API</span>
          </div>
        </div>

        <!-- In-Page View Switcher Tabs -->
        <div class="flex items-center gap-2 mt-6 pt-5 border-t border-slate-100">
          <button
            type="button"
            id="tab-btn-hub"
            class="px-4 py-2 rounded-lg text-xs font-bold transition flex items-center gap-1.5 bg-[#173a39] text-white shadow-xs cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="7" height="9" x="3" y="3" rx="1"></rect>
              <rect width="7" height="5" x="14" y="3" rx="1"></rect>
              <rect width="7" height="9" x="14" y="12" rx="1"></rect>
              <rect width="7" height="5" x="3" y="16" rx="1"></rect>
            </svg>
            Executive Overview Hub
          </button>
          <button
            type="button"
            id="tab-btn-petsync"
            class="px-4 py-2 rounded-lg text-xs font-bold transition flex items-center gap-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="m10 15 5-3-5-3v6Z"></path>
            </svg>
            🐾 Shelter Animal Census & Roster ({petSyncData.activeCount} Pets)
          </button>
        </div>
      </div>

      <!-- VIEW PANE 1: EXECUTIVE OVERVIEW HUB (Default simplified view) -->
      <div id="pane-hub" class="space-y-6">
        <!-- 3 Primary Portal Pillar Action Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          <!-- Pillar 1: PetSync Operations -->
          <div class="p-6 rounded-xl bg-white border border-amber-200/90 shadow-xs flex flex-col justify-between hover:shadow-md transition">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="p-2.5 rounded-lg bg-amber-100 text-amber-900">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="m10 15 5-3-5-3v6Z"></path>
                  </svg>
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-900 border border-amber-200">
                  Live Census
                </span>
              </div>
              <h3 class="text-lg font-bold text-amber-950">PetSync Operations</h3>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                Real-time shelter animal census, PetPoint links, microchips, intake tracking, and automatic sync diagnostics.
              </p>
              <div class="mt-4 pt-3 border-t border-amber-100 space-y-1.5 text-xs">
                <div class="flex justify-between text-slate-700">
                  <span>Current Active Animals:</span>
                  <strong class="font-mono text-amber-950 font-bold">{petSyncData.activeCount} pets</strong>
                </div>
                <div class="flex justify-between text-slate-500">
                  <span>Sync Schedule:</span>
                  <span class="font-medium">Every 30 mins (Azure Cron)</span>
                </div>
              </div>
            </div>
            <button
              type="button"
              id="hub-inspect-pets-btn"
              class="mt-6 inline-flex items-center justify-center gap-1.5 w-full py-2.5 px-3 rounded-lg text-xs font-bold bg-[#173a39] hover:bg-teal-900 text-white transition shadow-xs cursor-pointer"
            >
              🐾 Inspect Animal Census & Sync Logs &rarr;
            </button>
          </div>

          <!-- Pillar 2: Board Financials & Treasury -->
          <div class="p-6 rounded-xl bg-white border border-teal-200/90 shadow-xs flex flex-col justify-between hover:shadow-md transition">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="p-2.5 rounded-lg bg-teal-100 text-teal-900">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="1" x2="12" y2="23"></line>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                  </svg>
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-teal-100 text-teal-900 border border-teal-200">
                  Certified Books
                </span>
              </div>
              <h3 class="text-lg font-bold text-teal-950">Financials & Treasury</h3>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                Executive KPI dashboard, Cash Runway Simulator, Bank Statement & Dual-PDF Viewer, and AP aging schedule.
              </p>
              <div class="mt-4 pt-3 border-t border-teal-100 space-y-1.5 text-xs">
                <div class="flex justify-between text-slate-700">
                  <span>First Merchants Bank Cash:</span>
                  <strong class="font-mono text-teal-950 font-bold">{formatDollar(reportData.statement_of_position.assets.operating_checking_bank_register)}</strong>
                </div>
                <div class="flex justify-between text-slate-500">
                  <span>Reconciliation Difference:</span>
                  <span class="font-mono font-bold text-emerald-700">$0.00 (Balanced)</span>
                </div>
              </div>
            </div>
            <a
              href="/internal/board"
              class="mt-6 inline-flex items-center justify-center gap-1.5 w-full py-2.5 px-3 rounded-lg text-xs font-bold bg-teal-800 hover:bg-teal-900 text-white transition shadow-xs"
            >
              Open Financials Portal &rarr;
            </a>
          </div>

          <!-- Pillar 3: Grants & Funding Pipeline -->
          <div class="p-6 rounded-xl bg-white border border-purple-200/90 shadow-xs flex flex-col justify-between hover:shadow-md transition">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="p-2.5 rounded-lg bg-purple-100 text-purple-900">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                  </svg>
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-purple-100 text-purple-900 border border-purple-200">
                  Funding
                </span>
              </div>
              <h3 class="text-lg font-bold text-purple-950">Grants Database</h3>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                Internal grant tracking system, application status records, and discovery resources (Zeffy, AAWA, Grantable).
              </p>
              <div class="mt-4 pt-3 border-t border-purple-100 space-y-1.5 text-xs">
                <div class="flex justify-between text-slate-700">
                  <span>Discovery Engines:</span>
                  <strong class="font-medium text-purple-950">Zeffy · Grantable · AAWA</strong>
                </div>
                <div class="flex justify-between text-slate-500">
                  <span>Subpage Access:</span>
                  <span class="font-medium text-emerald-700">Unified (No 2nd Login)</span>
                </div>
              </div>
            </div>
            <a
              href="/internal/grants"
              class="mt-6 inline-flex items-center justify-center gap-1.5 w-full py-2.5 px-3 rounded-lg text-xs font-bold bg-purple-800 hover:bg-purple-900 text-white transition shadow-xs"
            >
              Open Grants Tracker &rarr;
            </a>
          </div>
        </div>

        <!-- Executive Quick Shortcuts Row -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
          <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-xs flex items-center justify-between">
            <div>
              <span class="font-bold text-slate-800 block text-sm">Dual-PDF Bank Statements</span>
              <p class="text-slate-500 mt-0.5 text-xs">
                August 31 scan & reconciliation audit ($0.00 difference).
              </p>
            </div>
            <a
              href="/internal/board#bank-statement-viewer"
              class="px-3 py-1.5 rounded-md font-bold bg-[#173a39] text-white hover:bg-teal-900 transition whitespace-nowrap ml-3"
            >
              View &rarr;
            </a>
          </div>

          <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-xs flex items-center justify-between">
            <div>
              <span class="font-bold text-slate-800 block text-sm">Board Printable Packet</span>
              <p class="text-slate-500 mt-0.5 text-xs">
                Executive print-ready financials packet & AP schedule.
              </p>
            </div>
            <a
              href="/internal/board/print"
              target="_blank"
              class="px-3 py-1.5 rounded-md font-bold bg-teal-800 text-white hover:bg-teal-900 transition whitespace-nowrap ml-3"
            >
              Print &rarr;
            </a>
          </div>

          <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-xs flex items-center justify-between">
            <div>
              <span class="font-bold text-slate-800 block text-sm">Directus CMS Console</span>
              <p class="text-slate-500 mt-0.5 text-xs">
                Manage pets, newsletters, tributes, flyers & users.
              </p>
            </div>
            <a
              href="https://mchs-directus.livelyfield-d0a70609.eastus.azurecontainerapps.io/admin"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-md font-bold bg-slate-800 text-white hover:bg-slate-900 transition whitespace-nowrap ml-3"
            >
              Admin ↗
            </a>
          </div>
        </div>
      </div>

      <!-- VIEW PANE 2: PETSYNC SHELTER OPERATIONS (Toggled on demand) -->
      <div id="pane-petsync" class="hidden space-y-4">
        <div class="flex items-center justify-between bg-white p-4 rounded-xl border border-slate-200 shadow-xs">
          <div class="flex items-center gap-2">
            <span class="font-bold text-slate-800 text-sm">Active Shelter Animal Census</span>
            <span class="px-2 py-0.5 rounded text-xs font-mono font-bold bg-amber-100 text-amber-900 border border-amber-200">
              {petSyncData.activeCount} Animals in Care
            </span>
          </div>
          <button
            type="button"
            id="back-to-hub-btn"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition border border-slate-300 cursor-pointer"
          >
            &larr; Return to Executive Overview
          </button>
        </div>

        <section id="section-petsync">
          <PetSyncPortal syncData={petSyncData} />
        </section>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  #staff-portal-auth-gate {
    display: flex;
  }
  #staff-portal-content {
    display: none;
  }
  html.staff-authenticated #staff-portal-auth-gate {
    display: none !important;
  }
  html.staff-authenticated #staff-portal-content {
    display: block !important;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fadeIn 0.3s ease-out forwards;
  }
</style>

<script>
  import { loginStaff, getStaffUserEmail } from '../../lib/staff-auth';

  function initStaffPortal() {
    const loginForm = document.getElementById('unified-login-form') as HTMLFormElement | null;
    const emailInput = document.getElementById('unified-email') as HTMLInputElement | null;
    const passwordInput = document.getElementById('unified-password') as HTMLInputElement | null;
    const rememberMeInput = document.getElementById('unified-remember-me') as HTMLInputElement | null;
    const passwordRevealBtn = document.getElementById('password-reveal-btn') as HTMLButtonElement | null;
    const eyeIcon = document.getElementById('eye-icon');
    const eyeOffIcon = document.getElementById('eye-off-icon');

    const submitBtn = document.getElementById('unified-submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');
    const errorAlert = document.getElementById('login-error-alert');
    const errorText = document.getElementById('login-error-text');
    const staffUserEmail = document.getElementById('staff-user-email');

    // Tab switcher elements
    const tabBtnHub = document.getElementById('tab-btn-hub') as HTMLButtonElement | null;
    const tabBtnPetSync = document.getElementById('tab-btn-petsync') as HTMLButtonElement | null;
    const paneHub = document.getElementById('pane-hub');
    const panePetSync = document.getElementById('pane-petsync');
    const inspectPetsBtn = document.getElementById('hub-inspect-pets-btn') as HTMLButtonElement | null;
    const backToHubBtn = document.getElementById('back-to-hub-btn') as HTMLButtonElement | null;

    // Password visibility toggle
    if (passwordRevealBtn && passwordInput && passwordRevealBtn.dataset.bound !== '1') {
      passwordRevealBtn.dataset.bound = '1';
      passwordRevealBtn.addEventListener('click', () => {
        const isPassword = passwordInput.type === 'password';
        passwordInput.type = isPassword ? 'text' : 'password';
        if (eyeIcon && eyeOffIcon) {
          eyeIcon.classList.toggle('hidden', isPassword);
          eyeOffIcon.classList.toggle('hidden', !isPassword);
        }
        passwordInput.focus();
      });
    }

    // Tab switching helper
    function switchTab(target: 'hub' | 'petsync') {
      if (target === 'petsync') {
        paneHub?.classList.add('hidden');
        panePetSync?.classList.remove('hidden');
        tabBtnHub?.classList.remove('bg-[#173a39]', 'text-white', 'shadow-xs');
        tabBtnHub?.classList.add('bg-slate-100', 'text-slate-700', 'border', 'border-slate-200');
        tabBtnPetSync?.classList.add('bg-[#173a39]', 'text-white', 'shadow-xs');
        tabBtnPetSync?.classList.remove('bg-slate-100', 'text-slate-700', 'border', 'border-slate-200');
      } else {
        panePetSync?.classList.add('hidden');
        paneHub?.classList.remove('hidden');
        tabBtnPetSync?.classList.remove('bg-[#173a39]', 'text-white', 'shadow-xs');
        tabBtnPetSync?.classList.add('bg-slate-100', 'text-slate-700', 'border', 'border-slate-200');
        tabBtnHub?.classList.add('bg-[#173a39]', 'text-white', 'shadow-xs');
        tabBtnHub?.classList.remove('bg-slate-100', 'text-slate-700', 'border', 'border-slate-200');
      }
    }

    if (tabBtnHub && tabBtnHub.dataset.bound !== '1') {
      tabBtnHub.dataset.bound = '1';
      tabBtnHub.addEventListener('click', () => switchTab('hub'));
    }
    if (tabBtnPetSync && tabBtnPetSync.dataset.bound !== '1') {
      tabBtnPetSync.dataset.bound = '1';
      tabBtnPetSync.addEventListener('click', () => switchTab('petsync'));
    }
    if (inspectPetsBtn && inspectPetsBtn.dataset.bound !== '1') {
      inspectPetsBtn.dataset.bound = '1';
      inspectPetsBtn.addEventListener('click', () => switchTab('petsync'));
    }
    if (backToHubBtn && backToHubBtn.dataset.bound !== '1') {
      backToHubBtn.dataset.bound = '1';
      backToHubBtn.addEventListener('click', () => switchTab('hub'));
    }

    // Check URL parameters for tab selection
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('tab') === 'petsync' || window.location.hash === '#section-petsync') {
      switchTab('petsync');
    }

    // Update user display
    if (staffUserEmail) {
      staffUserEmail.textContent = getStaffUserEmail();
    }

    // Clear error message when user starts typing
    emailInput?.addEventListener('input', () => errorAlert?.classList.add('hidden'));
    passwordInput?.addEventListener('input', () => errorAlert?.classList.add('hidden'));

    // Login submit handler
    if (loginForm && loginForm.dataset.bound !== '1') {
      loginForm.dataset.bound = '1';

      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = emailInput ? emailInput.value.trim() : '';
        const password = passwordInput ? passwordInput.value : '';
        const rememberMe = rememberMeInput ? rememberMeInput.checked : true;

        if (!email || !password) return;

        // Loading state
        if (submitBtn) submitBtn.disabled = true;
        if (btnText) btnText.textContent = 'Authenticating...';
        if (btnSpinner) btnSpinner.classList.remove('hidden');
        if (errorAlert) errorAlert.classList.add('hidden');

        try {
          await loginStaff({ email, password, rememberMe });

          if (staffUserEmail) {
            staffUserEmail.textContent = email;
          }

          // Check if there was a redirect query parameter
          const redirect = urlParams.get('redirect');
          if (redirect && redirect.startsWith('/internal')) {
            window.location.href = redirect;
          }
        } catch (err: any) {
          console.warn('[StaffPortal] Login error:', err);

          const errorCode = err?.errors?.[0]?.extensions?.code;
          if (errorCode === 'INVALID_CREDENTIALS') {
            if (errorText) errorText.textContent = 'Invalid email or password. Please verify your Directus credentials.';
          } else {
            if (errorText) {
              errorText.textContent = err?.message || 'Unable to connect to Directus authentication service. Please try again.';
            }
          }
          if (errorAlert) errorAlert.classList.remove('hidden');
        } finally {
          if (submitBtn) submitBtn.disabled = false;
          if (btnText) btnText.textContent = 'Secure Sign In';
          if (btnSpinner) btnSpinner.classList.add('hidden');
        }
      });
    }
  }

  document.addEventListener('astro:page-load', initStaffPortal);
</script>
</BaseLayout>
