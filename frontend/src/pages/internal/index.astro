<script>
  import { loginStaff, getStaffUserEmail, getRememberedStaffEmail, isStaffAuthenticated, staffClient, DIRECTUS_URL } from '../../lib/staff-auth';
  import { cashRunwayMonths, fetchStaffFinancials, publishedLabel, refreshStaffFinancials, setStaffDataStatus } from '../../lib/staff-financials';
  import { initStaffThemeToggle } from '../../lib/staff-theme';
  import { readItems } from '@directus/sdk';

  function applyDonorUnavailable() {
    const volumeEls = ['metric-donor-volume', 'card-donor-volume'];
    for (const id of volumeEls) {
      const el = document.getElementById(id);
      if (el) el.textContent = 'Unavailable';
    }
    const counts = document.getElementById('metric-donor-counts');
    if (counts) counts.textContent = 'Donor registry unavailable';
    const countEl = document.getElementById('card-donor-count');
    if (countEl) countEl.textContent = '—';
    const addrEl = document.getElementById('card-donor-addresses');
    if (addrEl) addrEl.textContent = '—';
  }

  function applyDonorMeta(meta: any) {
    if (!meta) {
      applyDonorUnavailable();
      return;
    }
    const volume = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(meta.total_lifetime_volume || 0);
    const volEl = document.getElementById('metric-donor-volume');
    if (volEl) volEl.textContent = volume;
    const cardVol = document.getElementById('card-donor-volume');
    if (cardVol) cardVol.textContent = volume;
    const counts = document.getElementById('metric-donor-counts');
    if (counts) {
      counts.textContent = `${(meta.total_donors || 0).toLocaleString()} donors`;
    }
    const countEl = document.getElementById('card-donor-count');
    if (countEl) countEl.textContent = (meta.total_donors || 0).toLocaleString();
    const addrEl = document.getElementById('card-donor-addresses');
    if (addrEl) addrEl.textContent = (meta.total_with_address || 0).toLocaleString();
    const activeEl = document.getElementById('metric-donor-active');
    if (activeEl && meta.active_2026_count != null) {
      activeEl.textContent = `${meta.active_2026_count} in 2026`;
    }
  }

  function applyMetrics(data: any) {
    if (!data) return;
    // GET /api/financials: YTD report + bank_statement + donors / donor_meta / donor_database.
    if (data.statement_of_position) {
      const cash = data.statement_of_position.assets.operating_checking_bank_register;
      const formattedCash = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 }).format(cash);

      const bankCashEl = document.getElementById('metric-bank-cash');
      if (bankCashEl) bankCashEl.textContent = formattedCash;

      const cardCashEl = document.getElementById('card-bank-cash');
      if (cardCashEl) cardCashEl.textContent = formattedCash;
    }

    const periodEl = document.getElementById('metric-bank-period');
    if (periodEl) periodEl.textContent = publishedLabel(data);

    const runway = cashRunwayMonths(data);
    const runwayEl = document.getElementById('metric-cash-runway');
    if (runwayEl) runwayEl.textContent = runway || 'Runway unavailable';

    const auditEl = document.getElementById('metric-audit-diff');
    if (auditEl) {
      const note = data.statement_of_position?.assets?.bank_register_note
        || data.notes?.['Bank Statement Reconciliation']
        || data.meta?.reconciliation_note;
      if (note && typeof note === 'string') {
        const reconMatch = note.match(/reconciled to [^.]+/i);
        auditEl.textContent = reconMatch
          ? (reconMatch[0].charAt(0).toUpperCase() + reconMatch[0].slice(1))
          : (runway ? `Cash runway ${runway} at current operating pace` : 'Balanced & reconciled to QuickBooks Online');
      } else {
        auditEl.textContent = runway ? `Cash runway ${runway} at current pace` : 'Balanced & reconciled to QuickBooks Online';
      }
    }

    const finPill = document.getElementById('hub-status-financials');
    if (finPill) finPill.textContent = publishedLabel(data);

    const donorMeta = data.donor_meta || data.donor_database?.meta || data.donors?.meta;
    if (donorMeta) applyDonorMeta(donorMeta);
    else applyDonorUnavailable();
  }

  async function loadFinancialMetrics() {
    setStaffDataStatus('hub-data-status', 'loading');
    const cached = await fetchStaffFinancials();
    if (cached.ok) applyMetrics(cached.data);

    const fresh = await refreshStaffFinancials();
    if (!fresh.ok) {
      if (fresh.status === 401 || fresh.status === 403) return;
      const finPill = document.getElementById('hub-status-financials');
      if (finPill) finPill.textContent = 'Financials unavailable';
      setStaffDataStatus('hub-data-status', 'error', fresh.error, () => {
        void loadFinancialMetrics();
      });
      return;
    }
    applyMetrics(fresh.data);
    setStaffDataStatus('hub-data-status', 'hidden');
  }

  function formatSyncLabel(iso: string | null | undefined): string {
    if (!iso) return 'time unknown';
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return 'time unknown';
    return d.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
  }

  function applyCensusSnapshot(activeCount: number, lastSeen: string | null) {
    const label = formatSyncLabel(lastSeen);
    const staleMs = lastSeen ? Date.now() - new Date(lastSeen).getTime() : Number.POSITIVE_INFINITY;
    const stale = !lastSeen || Number.isNaN(staleMs) || staleMs > 90 * 60 * 1000;

    const countEl = document.getElementById('hub-census-count');
    if (countEl) countEl.textContent = String(activeCount);
    const syncEl = document.getElementById('hub-census-sync');
    if (syncEl) syncEl.textContent = stale ? `${label} · stale` : label;
    const pill = document.getElementById('hub-status-petsync');
    if (pill) pill.textContent = `Census · ${activeCount} · ${label}`;
  }

  async function loadCensusSnapshot() {
    try {
      const res = await fetch(
        `${DIRECTUS_URL}/items/pets?filter[archived_at][_null]=true&limit=1&sort=-last_seen_at&fields=id,last_seen_at&meta=filter_count`
      );
      if (!res.ok) return;
      const json = await res.json();
      const activeCount = Number(json?.meta?.filter_count ?? json?.data?.length ?? 0);
      const lastSeen = json?.data?.[0]?.last_seen_at || null;
      applyCensusSnapshot(activeCount, lastSeen);
    } catch {
      const pill = document.getElementById('hub-status-petsync');
      if (pill) pill.textContent = 'PetSync: could not refresh census';
    }
  }

  async function loadGrantsSnapshot() {
    const countEl = document.getElementById('hub-grants-count');
    const detailEl = document.getElementById('hub-grants-detail');
    try {
      const grants = (await staffClient.request(readItems('grants', {
        fields: ['id', 'status'],
        limit: -1,
      }))) as Array<{ id: number; status?: string }>;
      const total = grants?.length || 0;
      const open = (grants || []).filter((g) => {
        const s = (g.status || '').toLowerCase();
        return s === 'open' || s === 'submitted' || s === 'pending';
      }).length;
      const awarded = (grants || []).filter((g) => {
        const s = (g.status || '').toLowerCase();
        return s === 'awarded' || s === 'won';
      }).length;
      if (countEl) countEl.textContent = String(total);
      if (detailEl) detailEl.textContent = `${open} open · ${awarded} awarded`;
    } catch {
      if (countEl) countEl.textContent = '—';
      if (detailEl) detailEl.textContent = 'Open Grants Tracker for details';
    }
  }

  function initStaffPortal() {
    initStaffThemeToggle();

    const loginForm = document.getElementById('unified-login-form') as HTMLFormElement | null;
    const emailInput = document.getElementById('unified-email') as HTMLInputElement | null;
    const passwordInput = document.getElementById('unified-password') as HTMLInputElement | null;
    const rememberMeInput = document.getElementById('unified-remember-me') as HTMLInputElement | null;
    const passwordRevealBtn = document.getElementById('password-reveal-btn') as HTMLButtonElement | null;
    const eyeIcon = document.getElementById('eye-icon');
    const eyeOffIcon = document.getElementById('eye-off-icon');

    const submitBtn = document.getElementById('unified-submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');
    const errorAlert = document.getElementById('login-error-alert');
    const errorText = document.getElementById('login-error-text');
    const offlineAlert = document.getElementById('login-offline-alert');
    const staffUserEmail = document.getElementById('staff-user-email');

    const urlParams = new URLSearchParams(window.location.search);

    // Dynamic destination badge if redirected from a protected route
    const redirect = urlParams.get('redirect');
    if (redirect && redirect.startsWith('/internal') && redirect !== '/internal/' && redirect !== '/internal') {
      const destEl = document.getElementById('login-redirect-dest');
      const noticeEl = document.getElementById('login-redirect-notice');
      if (destEl && noticeEl) {
        let name = 'Protected Operations Console';
        if (redirect.includes('/board/print')) name = 'Board Financials Print Packet';
        else if (redirect.includes('/board')) name = 'Board Financials & Treasury';
        else if (redirect.includes('/pets')) name = 'Shelter Animal Census';
        else if (redirect.includes('/donors')) name = 'Donor Registry & Giving';
        else if (redirect.includes('/grants')) name = 'Grants Pipeline';
        else if (redirect.includes('/content')) name = 'Site Content Manager';
        destEl.textContent = name;
        noticeEl.classList.remove('hidden');
        noticeEl.classList.add('flex');
      }
    }

    // Network connectivity detection
    const updateOnlineStatus = () => {
      if (offlineAlert) {
        offlineAlert.classList.toggle('hidden', navigator.onLine);
      }
    };
    window.addEventListener('online', updateOnlineStatus);
    window.addEventListener('offline', updateOnlineStatus);
    updateOnlineStatus();

    // Caps Lock state detection
    const handleCapsLock = (e: KeyboardEvent) => {
      const capsWarning = document.getElementById('caps-lock-warning');
      if (capsWarning && typeof e.getModifierState === 'function') {
        const isCaps = e.getModifierState('CapsLock');
        capsWarning.classList.toggle('hidden', !isCaps);
      }
    };
    passwordInput?.addEventListener('keyup', handleCapsLock);
    passwordInput?.addEventListener('keydown', handleCapsLock);

    // Pre-fill email if previously remembered on this device
    try {
      const rememberedEmail = getRememberedStaffEmail();
      if (emailInput && !emailInput.value && rememberedEmail) {
        emailInput.value = rememberedEmail;
        if (rememberMeInput) rememberMeInput.checked = true;
        // Desktop auto-focus: if email is already remembered, focus password input directly
        if (!isStaffAuthenticated() && passwordInput && window.matchMedia('(min-width: 768px)').matches) {
          passwordInput.focus();
        }
      } else if (!isStaffAuthenticated() && emailInput && !emailInput.value && window.matchMedia('(min-width: 768px)').matches) {
        emailInput.focus();
      }
    } catch (e) {}

    // Email quick-clear button behavior
    const emailClearBtn = document.getElementById('email-clear-btn');
    const syncEmailClear = () => {
      if (emailClearBtn && emailInput) {
        emailClearBtn.classList.toggle('hidden', !emailInput.value);
      }
    };
    emailInput?.addEventListener('input', syncEmailClear);
    syncEmailClear();
    if (emailClearBtn && emailClearBtn.dataset.bound !== '1') {
      emailClearBtn.dataset.bound = '1';
      emailClearBtn.addEventListener('click', () => {
        if (emailInput) {
          emailInput.value = '';
          emailInput.focus();
          syncEmailClear();
          clearError();
        }
      });
    }

    // Need sign-in help drawer toggle
    const helpToggle = document.getElementById('login-help-toggle');
    const helpDrawer = document.getElementById('login-help-drawer');
    if (helpToggle && helpDrawer && helpToggle.dataset.bound !== '1') {
      helpToggle.dataset.bound = '1';
      helpToggle.addEventListener('click', () => {
        const isHidden = helpDrawer.classList.contains('hidden');
        helpDrawer.classList.toggle('hidden', !isHidden);
        helpToggle.setAttribute('aria-expanded', String(isHidden));
      });
    }

    // Load financials if already authenticated
    if (isStaffAuthenticated()) {
      document.documentElement.classList.add('staff-authenticated');
      if (urlParams.has('reauth')) {
        urlParams.delete('reauth');
        const cleanSearch = urlParams.toString();
        const cleanUrl = window.location.pathname + (cleanSearch ? '?' + cleanSearch : '');
        window.history.replaceState({}, '', cleanUrl);
      }
      loadFinancialMetrics();
      void loadCensusSnapshot();
      void loadGrantsSnapshot();
    }

    // Password visibility toggle with 15-second privacy auto-hide
    let revealTimer: any = null;
    if (passwordRevealBtn && passwordInput && passwordRevealBtn.dataset.bound !== '1') {
      passwordRevealBtn.dataset.bound = '1';
      passwordRevealBtn.addEventListener('click', () => {
        const isPassword = passwordInput.type === 'password';
        passwordInput.type = isPassword ? 'text' : 'password';
        if (eyeIcon && eyeOffIcon) {
          eyeIcon.classList.toggle('hidden', isPassword);
          eyeOffIcon.classList.toggle('hidden', !isPassword);
        }
        passwordRevealBtn.setAttribute('aria-pressed', isPassword ? 'true' : 'false');
        passwordRevealBtn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
        passwordRevealBtn.setAttribute('title', isPassword ? 'Hide password' : 'Show password');

        const len = passwordInput.value.length;
        passwordInput.focus();
        passwordInput.setSelectionRange(len, len);

        if (revealTimer) clearTimeout(revealTimer);
        if (isPassword) {
          revealTimer = setTimeout(() => {
            if (passwordInput && passwordInput.type === 'text') {
              passwordInput.type = 'password';
              eyeIcon?.classList.remove('hidden');
              eyeOffIcon?.classList.add('hidden');
              passwordRevealBtn.setAttribute('aria-pressed', 'false');
              passwordRevealBtn.setAttribute('aria-label', 'Show password');
              passwordRevealBtn.setAttribute('title', 'Show password');
            }
          }, 15000);
        }
      });
    }

    // Check URL parameters for backward compatibility with ?tab=petsync
    if (urlParams.get('reauth') === '1' && !isStaffAuthenticated() && errorAlert && errorText) {
      errorText.textContent = 'Your staff session expired. Sign in again to load financials and the donor registry.';
      errorAlert.classList.remove('hidden');
    }
    if (urlParams.get('tab') === 'petsync' || window.location.hash === '#section-petsync') {
      window.location.replace('/internal/pets/');
      return;
    }

    // Update user display
    if (staffUserEmail) {
      staffUserEmail.textContent = getStaffUserEmail();
    }

    // Clear error message and invalid attributes when user starts typing
    const clearError = () => {
      if (errorAlert && !errorAlert.classList.contains('hidden')) {
        errorAlert.classList.add('hidden');
      }
      emailInput?.setAttribute('aria-invalid', 'false');
      passwordInput?.setAttribute('aria-invalid', 'false');
    };
    emailInput?.addEventListener('input', clearError);
    passwordInput?.addEventListener('input', clearError);

    // Login submit handler with double-submission protection
    let isAuthenticating = false;
    if (loginForm && loginForm.dataset.bound !== '1') {
      loginForm.dataset.bound = '1';

      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (isAuthenticating) return;

        // Check network connection first
        if (!navigator.onLine) {
          if (errorText) errorText.textContent = 'You are currently offline. Check your network connection and try again.';
          if (errorAlert) {
            errorAlert.classList.remove('animate-shake');
            void errorAlert.offsetWidth;
            errorAlert.classList.add('animate-shake');
            errorAlert.classList.remove('hidden');
          }
          return;
        }

        const email = emailInput ? emailInput.value.trim() : '';
        const password = passwordInput ? passwordInput.value : '';
        const rememberMe = rememberMeInput ? rememberMeInput.checked : true;

        if (!email || !password) {
          if (!email && emailInput) emailInput.focus();
          else if (!password && passwordInput) passwordInput.focus();
          return;
        }

        // Validate email format prior to sending network request
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(email)) {
          if (errorText) errorText.textContent = 'Please enter a valid email address.';
          if (emailInput) {
            emailInput.setAttribute('aria-invalid', 'true');
            emailInput.focus();
          }
          if (errorAlert) {
            errorAlert.classList.remove('animate-shake');
            void errorAlert.offsetWidth;
            errorAlert.classList.add('animate-shake');
            errorAlert.classList.remove('hidden');
          }
          return;
        }

        isAuthenticating = true;

        // Loading state
        if (submitBtn) submitBtn.disabled = true;
        if (emailInput) emailInput.disabled = true;
        if (passwordInput) passwordInput.disabled = true;
        if (loginForm) loginForm.classList.add('pointer-events-none', 'opacity-80');
        if (btnText) btnText.textContent = 'Authenticating...';
        if (btnSpinner) btnSpinner.classList.remove('hidden');
        if (errorAlert) errorAlert.classList.add('hidden');
        if (emailInput) emailInput.setAttribute('aria-invalid', 'false');
        if (passwordInput) passwordInput.setAttribute('aria-invalid', 'false');

        let isRateLimited = false;
        try {
          await loginStaff({ email, password, rememberMe });
          document.documentElement.classList.add('staff-authenticated');

          if (staffUserEmail) {
            staffUserEmail.textContent = email;
          }

          // Clear reauth error alert and clean address bar
          if (errorAlert) errorAlert.classList.add('hidden');
          if (window.location.search.includes('reauth=')) {
            const cleanUrl = window.location.pathname;
            window.history.replaceState({}, '', cleanUrl);
          }

          // Check if there was a redirect query parameter (only redirect if pointing to another subpage)
          const destRedirect = urlParams.get('redirect');
          if (destRedirect && destRedirect.startsWith('/internal') && destRedirect !== '/internal/' && destRedirect !== '/internal') {
            if (btnText) btnText.textContent = 'Redirecting...';
            window.location.href = destRedirect;
            return;
          }

          // Hydrate metrics immediately upon login
          loadFinancialMetrics();
          void loadCensusSnapshot();
          void loadGrantsSnapshot();
        } catch (err: any) {
          console.warn('[StaffPortal] Login error:', err);

          const errorCode = err?.errors?.[0]?.extensions?.code;
          if (errorCode === 'INVALID_CREDENTIALS') {
            if (errorText) errorText.textContent = 'Invalid email or password. Please verify your credentials.';
          } else if (errorCode === 'REQUESTS_EXCEEDED' || err?.status === 429 || (err?.message && err.message.toLowerCase().includes('too many'))) {
            isRateLimited = true;
            let cooldownSec = 60;
            if (submitBtn) submitBtn.disabled = true;
            if (btnText) btnText.textContent = 'Wait 60s';
            if (errorText) errorText.textContent = 'Too many sign-in attempts. Please wait 60 seconds before trying again.';
            const cooldownTimer = setInterval(() => {
              cooldownSec--;
              if (cooldownSec > 0) {
                if (errorText) errorText.textContent = `Too many sign-in attempts. Please wait ${cooldownSec}s before trying again.`;
                if (btnText) btnText.textContent = `Wait ${cooldownSec}s`;
              } else {
                clearInterval(cooldownTimer);
                if (submitBtn) submitBtn.disabled = false;
                if (btnText) btnText.textContent = 'Sign In →';
                if (errorText) errorText.textContent = 'You may now attempt to sign in again.';
              }
            }, 1000);
          } else {
            if (errorText) {
              errorText.textContent = err?.message || 'Unable to connect to authentication service. Please try again.';
            }
          }
          if (emailInput) emailInput.setAttribute('aria-invalid', 'true');
          if (passwordInput) passwordInput.setAttribute('aria-invalid', 'true');

          if (errorAlert) {
            errorAlert.classList.remove('animate-shake');
            void errorAlert.offsetWidth; // Trigger reflow for repeatable shake animation
            errorAlert.classList.add('animate-shake');
            errorAlert.classList.remove('hidden');
          }
          if (passwordInput && !isRateLimited) {
            passwordInput.focus();
            passwordInput.select();
          }
        } finally {
          isAuthenticating = false;
          if (emailInput) emailInput.disabled = false;
          if (passwordInput) passwordInput.disabled = false;
          if (loginForm) loginForm.classList.remove('pointer-events-none', 'opacity-80');
          if (!isRateLimited) {
            if (submitBtn) submitBtn.disabled = false;
            if (btnText) btnText.textContent = 'Sign In →';
          }
          if (btnSpinner) btnSpinner.classList.add('hidden');
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStaffPortal);
  } else {
    initStaffPortal();
  }
  document.addEventListener('astro:page-load', initStaffPortal);
</script>
</BaseLayout>
