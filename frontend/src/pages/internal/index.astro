<style>
  #staff-portal-auth-gate {
    display: flex;
  }
  #staff-portal-content {
    display: none;
  }
  html.staff-authenticated #staff-portal-auth-gate {
    display: none !important;
  }
  html.staff-authenticated #staff-portal-content {
    display: block !important;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fadeIn 0.3s ease-out forwards;
  }

  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    20%, 60% { transform: translateX(-6px); }
    40%, 80% { transform: translateX(6px); }
  }
  .animate-shake {
    animation: shake 0.4s cubic-bezier(.36,.07,.19,.97) both;
  }
</style>

<script>
  import { loginStaff, getStaffUserEmail, isStaffAuthenticated, getStaffToken } from '../../lib/staff-auth';
  import { getCachedFinancials, setCachedFinancials } from '../../lib/api';

  function applyMetrics(data: any) {
    if (!data || !data.statement_of_position) return;
    const cash = data.statement_of_position.assets.operating_checking_bank_register;
    const formattedCash = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 }).format(cash);

    const bankCashEl = document.getElementById('metric-bank-cash');
    if (bankCashEl) bankCashEl.textContent = formattedCash;

    const cardCashEl = document.getElementById('card-bank-cash');
    if (cardCashEl) cardCashEl.textContent = formattedCash;

    const runwayEl = document.getElementById('metric-cash-runway');
    if (runwayEl) runwayEl.textContent = '14+ months';
  }

  async function loadFinancialMetrics() {
    // 1. Instant cache hydration
    const cached = getCachedFinancials();
    if (cached) applyMetrics(cached);

    const token = await getStaffToken();
    if (!token) return;

    try {
      const res = await fetch('/api/financials', {
        headers: {
          'Authorization': `Bearer ${token}`
        }
      });
      if (!res.ok) return;
      const data = await res.json();
      if (!data || !data.statement_of_position) return;

      setCachedFinancials(data);
      applyMetrics(data);
    } catch (e) {
      console.warn('[StaffPortal] Could not load financial metrics:', e);
    }
  }

  function initStaffPortal() {
    const loginForm = document.getElementById('unified-login-form') as HTMLFormElement | null;
    const emailInput = document.getElementById('unified-email') as HTMLInputElement | null;
    const passwordInput = document.getElementById('unified-password') as HTMLInputElement | null;
    const rememberMeInput = document.getElementById('unified-remember-me') as HTMLInputElement | null;
    const passwordRevealBtn = document.getElementById('password-reveal-btn') as HTMLButtonElement | null;
    const eyeIcon = document.getElementById('eye-icon');
    const eyeOffIcon = document.getElementById('eye-off-icon');

    const submitBtn = document.getElementById('unified-submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');
    const errorAlert = document.getElementById('login-error-alert');
    const errorText = document.getElementById('login-error-text');
    const staffUserEmail = document.getElementById('staff-user-email');


    // Load financials if already authenticated
    if (isStaffAuthenticated()) {
      document.documentElement.classList.add('staff-authenticated');
      loadFinancialMetrics();
    }

    // Password visibility toggle
    if (passwordRevealBtn && passwordInput && passwordRevealBtn.dataset.bound !== '1') {
      passwordRevealBtn.dataset.bound = '1';
      passwordRevealBtn.addEventListener('click', () => {
        const isPassword = passwordInput.type === 'password';
        passwordInput.type = isPassword ? 'text' : 'password';
        if (eyeIcon && eyeOffIcon) {
          eyeIcon.classList.toggle('hidden', isPassword);
          eyeOffIcon.classList.toggle('hidden', !isPassword);
        }
        passwordInput.focus();
      });
    }

    // Check URL parameters for backward compatibility with ?tab=petsync
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('tab') === 'petsync' || window.location.hash === '#section-petsync') {
      window.location.replace('/internal/pets/');
      return;
    }

    // Update user display
    if (staffUserEmail) {
      staffUserEmail.textContent = getStaffUserEmail();
    }

    // Clear error message when user starts typing
    emailInput?.addEventListener('input', () => errorAlert?.classList.add('hidden'));
    passwordInput?.addEventListener('input', () => errorAlert?.classList.add('hidden'));

    // Login submit handler
    if (loginForm && loginForm.dataset.bound !== '1') {
      loginForm.dataset.bound = '1';

      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = emailInput ? emailInput.value.trim() : '';
        const password = passwordInput ? passwordInput.value : '';
        const rememberMe = rememberMeInput ? rememberMeInput.checked : true;

        if (!email || !password) return;

        // Loading state
        if (submitBtn) submitBtn.disabled = true;
        if (btnText) btnText.textContent = 'Authenticating...';
        if (btnSpinner) btnSpinner.classList.remove('hidden');
        if (errorAlert) errorAlert.classList.add('hidden');

        try {
          await loginStaff({ email, password, rememberMe });
          document.documentElement.classList.add('staff-authenticated');

          if (staffUserEmail) {
            staffUserEmail.textContent = email;
          }

          // Hydrate metrics immediately upon login
          loadFinancialMetrics();

          // Check if there was a redirect query parameter
          const redirect = urlParams.get('redirect');
          if (redirect && redirect.startsWith('/internal')) {
            window.location.href = redirect;
          }
        } catch (err: any) {
          console.warn('[StaffPortal] Login error:', err);

          const errorCode = err?.errors?.[0]?.extensions?.code;
          if (errorCode === 'INVALID_CREDENTIALS') {
            if (errorText) errorText.textContent = 'Invalid email or password. Please verify your credentials.';
          } else {
            if (errorText) {
              errorText.textContent = err?.message || 'Unable to connect to authentication service. Please try again.';
            }
          }
          if (errorAlert) {
            errorAlert.classList.remove('animate-shake');
            void errorAlert.offsetWidth; // Trigger reflow for repeatable shake animation
            errorAlert.classList.add('animate-shake');
            errorAlert.classList.remove('hidden');
          }
        } finally {
          if (submitBtn) submitBtn.disabled = false;
          if (btnText) btnText.textContent = 'Secure Sign In';
          if (btnSpinner) btnSpinner.classList.add('hidden');
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStaffPortal);
  } else {
    initStaffPortal();
  }
  document.addEventListener('astro:page-load', initStaffPortal);
</script>
</BaseLayout>
