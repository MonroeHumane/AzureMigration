---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StaffPortalNav from '../../components/internal/StaffPortalNav.astro';
import PetSyncPortal from '../../components/internal/PetSyncPortal.astro';
import { getStaffPetSyncData } from '../../lib/directus';
import reportData from '../../data/published_2026_ytd.json';

const petSyncData = await getStaffPetSyncData();

const formatDollar = (val: number) => {
  const isNeg = val < 0;
  const abs = Math.abs(val);
  const formatted = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 }).format(abs);
  return isNeg ? `(${formatted})` : formatted;
};
---

<BaseLayout
  title="Unified Staff Portal | Humane Society of Monroe County"
  description="Humane Society of Monroe County Unified Staff Portal: PetSync Operations, Board Financials, Grants Tracker, and Directus CMS."
  bodyClass="bg-[#f9f7f2] text-slate-800"
>
  <div class="min-h-screen pb-16">
    <!-- Component 1: Unified Staff Header Navigation -->
    <StaffPortalNav activeTab="overview" />

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 space-y-8">
      <!-- Welcome & System Pulse Ribbon -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-xs p-6">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          <div>
            <h1 class="text-xl font-bold text-[#173a39] tracking-tight">
              Shelter Operations & Executive Dashboard
            </h1>
            <p class="text-xs text-slate-500 mt-1">
              Central command for Humane Society of Monroe County staff, management, and board members.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="px-2.5 py-1 rounded-md bg-emerald-100 text-emerald-800 font-semibold border border-emerald-200">
              ✓ Systems Fully Synchronized
            </span>
            <span class="px-2.5 py-1 rounded-md bg-slate-100 text-slate-700 font-medium border border-slate-200">
              Accounting: QBO (Accrual)
            </span>
          </div>
        </div>

        <!-- 3 Primary Portal Pillar Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">
          <!-- Pillar 1: PetSync Operations -->
          <div class="p-5 rounded-xl bg-amber-50/60 border border-amber-200/80 shadow-xs flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="p-2 rounded-lg bg-amber-100 text-amber-900">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="m10 15 5-3-5-3v6Z"></path>
                  </svg>
                </span>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-200/80 text-amber-900">
                  Live Feed
                </span>
              </div>
              <h3 class="text-base font-bold text-amber-950">PetSync Operations</h3>
              <p class="text-xs text-amber-800/90 mt-1">
                Real-time shelter animal census, PetPoint links, intake tracking, and automatic sync diagnostics.
              </p>
              <div class="mt-4 pt-3 border-t border-amber-200/70 space-y-1 text-xs">
                <div class="flex justify-between text-amber-950">
                  <span>Current Active Animals:</span>
                  <strong class="font-mono">{petSyncData.activeCount} pets</strong>
                </div>
                <div class="flex justify-between text-amber-900">
                  <span>Archived / Past:</span>
                  <span class="font-mono">{petSyncData.archivedCount} pets</span>
                </div>
              </div>
            </div>
            <a
              href="#section-petsync"
              class="mt-5 inline-flex items-center justify-center gap-1.5 w-full py-2 px-3 rounded-lg text-xs font-bold bg-[#173a39] text-white hover:bg-teal-900 transition shadow-xs"
            >
              Open PetSync Console &darr;
            </a>
          </div>

          <!-- Pillar 2: Board Financials & Treasury -->
          <div class="p-5 rounded-xl bg-teal-50/60 border border-teal-200/80 shadow-xs flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="p-2 rounded-lg bg-teal-100 text-teal-900">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="1" x2="12" y2="23"></line>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                  </svg>
                </span>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-teal-200/80 text-teal-900">
                  Certified QBO
                </span>
              </div>
              <h3 class="text-base font-bold text-teal-950">Financials & Treasury</h3>
              <p class="text-xs text-teal-800/90 mt-1">
                Executive KPI dashboard, Cash Runway Simulator, Bank Statement & Dual-PDF Viewer, and AP Schedule.
              </p>
              <div class="mt-4 pt-3 border-t border-teal-200/70 space-y-1 text-xs">
                <div class="flex justify-between text-teal-950">
                  <span>First Merchants Bank Cash:</span>
                  <strong class="font-mono">{formatDollar(reportData.statement_of_position.assets.operating_checking_bank_register)}</strong>
                </div>
                <div class="flex justify-between text-teal-900">
                  <span>General Ledger Book Cash:</span>
                  <span class="font-mono">{formatDollar(reportData.headline_kpis.operating_checking_first_merchants)}</span>
                </div>
              </div>
            </div>
            <a
              href="/internal/board"
              class="mt-5 inline-flex items-center justify-center gap-1.5 w-full py-2 px-3 rounded-lg text-xs font-bold bg-teal-800 text-white hover:bg-teal-900 transition shadow-xs"
            >
              Open Financials Portal &rarr;
            </a>
          </div>

          <!-- Pillar 3: Grants & Funding Pipeline -->
          <div class="p-5 rounded-xl bg-purple-50/60 border border-purple-200/80 shadow-xs flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="p-2 rounded-lg bg-purple-100 text-purple-900">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                  </svg>
                </span>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-purple-200/80 text-purple-900">
                  Pipeline
                </span>
              </div>
              <h3 class="text-base font-bold text-purple-950">Grants Database</h3>
              <p class="text-xs text-purple-800/90 mt-1">
                Internal grant tracking system, application records, discovery resources (Zeffy, AAWA, Grantable).
              </p>
              <div class="mt-4 pt-3 border-t border-purple-200/70 space-y-1 text-xs">
                <div class="flex justify-between text-purple-950">
                  <span>Discovery Engines:</span>
                  <strong class="font-medium">Zeffy · Grantable · AAWA</strong>
                </div>
                <div class="flex justify-between text-purple-900">
                  <span>Sync Backend:</span>
                  <span class="font-medium">Directus CMS Grants API</span>
                </div>
              </div>
            </div>
            <a
              href="/internal/grants"
              class="mt-5 inline-flex items-center justify-center gap-1.5 w-full py-2 px-3 rounded-lg text-xs font-bold bg-purple-800 text-white hover:bg-purple-900 transition shadow-xs"
            >
              Open Grants Tracker &rarr;
            </a>
          </div>
        </div>
      </div>

      <!-- Section: Embedded PetSync Operations Console -->
      <section id="section-petsync" class="scroll-mt-6">
        <PetSyncPortal syncData={petSyncData} />
      </section>

      <!-- Section: Executive Quick Shortcuts -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
        <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-xs flex items-center justify-between">
          <div>
            <span class="font-bold text-slate-800 block text-sm">Board Bank Statement & Dual-PDF Viewer</span>
            <p class="text-slate-500 mt-0.5">
              Review August 31 bank statement scan (6 pages) and locked QBO reconciliation report ($0.00 difference).
            </p>
          </div>
          <a
            href="/internal/board#bank-statement-viewer"
            class="px-3 py-1.5 rounded-md font-bold bg-[#173a39] text-white hover:bg-teal-900 transition whitespace-nowrap ml-3"
          >
            View Statements &rarr;
          </a>
        </div>

        <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-xs flex items-center justify-between">
          <div>
            <span class="font-bold text-slate-800 block text-sm">Directus Headless CMS Admin Console</span>
            <p class="text-slate-500 mt-0.5">
              Direct administrative access to manage pets, newsletters, tributes, flyers, and staff accounts.
            </p>
          </div>
          <a
            href="https://mchs-directus.livelyfield-d0a70609.eastus.azurecontainerapps.io/admin"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 rounded-md font-bold bg-teal-800 text-white hover:bg-teal-900 transition whitespace-nowrap ml-3"
          >
            Launch CMS ↗
          </a>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
