---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StaffPortalNav from '../../components/internal/StaffPortalNav.astro';
import MobileBottomNav from '../../components/internal/MobileBottomNav.astro';
import MobileMoreSheet from '../../components/internal/MobileMoreSheet.astro';
import { getStaffPetSyncData } from '../../lib/directus';

const petSyncData = await getStaffPetSyncData();
const directusAdminUrl = 'https://mchs-directus.livelyfield-d0a70609.eastus.azurecontainerapps.io/admin';
const petSyncLabel = petSyncData.lastSyncTimestamp
  ? new Date(petSyncData.lastSyncTimestamp).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' })
  : 'time unknown';
---

<BaseLayout
  title="Staff Portal | Humane Society of Monroe County"
  description="Humane Society of Monroe County Staff Portal: Animal Census, Board Financials, and Grants Pipeline."
  bodyClass="bg-[#f9f7f2] text-slate-800 antialiased"
>
  <!-- Zero-Flicker Synchronous Auth Hydration (Runs before paint) -->
  <script is:inline>
    (function() {
      try {
        var token = localStorage.getItem('mchs_staff_token') || sessionStorage.getItem('mchs_staff_token') || '';
        var hasAuth = token.indexOf('mchs_') === 0 && token.indexOf('.') !== -1;
        if (hasAuth) {
          document.documentElement.classList.add('staff-authenticated');
        }
      } catch (e) {}
    })();
  </script>

  <!-- SCREEN 1: UNIFIED STAFF LOGIN GATE (Shown when unauthenticated) -->
  <div id="staff-portal-auth-gate" class="min-h-dvh flex items-center justify-center p-4 sm:p-6 lg:p-8 bg-[#071a17] relative overflow-hidden">
    <!-- Subtle Ambient Glow -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-teal-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Centered Auth Card -->
    <div class="w-full max-w-md bg-white rounded-3xl border border-slate-200/90 shadow-2xl p-6 sm:p-10 animate-fade-in relative z-10 my-auto">
      
      <!-- Brand Header -->
      <div class="text-center mb-7">
        <div class="inline-flex p-3 rounded-2xl bg-[#173a39] text-emerald-300 mb-3.5 shadow-md border border-teal-800">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <h1 class="text-xl font-bold text-[#173a39] tracking-tight">
          Humane Society of Monroe County
        </h1>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-teal-50 text-teal-800 border border-teal-200/80 mt-2">
          Staff &amp; Board Portal
        </div>
        <p class="text-xs text-slate-500 mt-2">
          Sign in with your staff account to continue
        </p>
      </div>

      <!-- Error Alert Container -->
      <div id="login-error-alert" class="hidden p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-700 leading-relaxed mb-5 animate-shake">
        <div class="flex items-start gap-2.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-rose-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span id="login-error-text">Invalid email or password. Please try again.</span>
        </div>
      </div>

      <!-- Interactive Form -->
      <form id="unified-login-form" class="space-y-4">
        <div>
          <label for="unified-email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
            Email Address
          </label>
          <div class="relative">
            <input
              type="email"
              id="unified-email"
              required
              autocomplete="username"
              autocapitalize="none"
              placeholder="name@monroe-humane.org"
              class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-700 focus:border-teal-700 transition bg-slate-50/50 focus:bg-white"
            />
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="unified-password" class="block text-xs font-bold text-slate-700 uppercase tracking-wider">
              Password
            </label>
          </div>
          <div class="relative">
            <input
              type="password"
              id="unified-password"
              required
              autocomplete="current-password"
              placeholder="••••••••••••"
              class="w-full pl-4 pr-11 py-3 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-700 focus:border-teal-700 transition bg-slate-50/50 focus:bg-white"
            />
            <button
              type="button"
              id="password-reveal-btn"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1.5 focus:outline-none cursor-pointer rounded-lg hover:bg-slate-100 transition"
              title="Toggle password visibility"
              aria-label="Toggle password visibility"
            >
              <svg id="eye-icon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              <svg id="eye-off-icon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
                <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
                <line x1="2" x2="22" y1="2" y2="22"></line>
              </svg>
            </button>
          </div>
        </div>

        <div class="flex items-center justify-between text-xs pt-1">
          <label class="flex items-center gap-2.5 text-slate-600 cursor-pointer select-none">
            <input
              type="checkbox"
              id="unified-remember-me"
              checked
              class="w-4 h-4 rounded text-teal-800 focus:ring-teal-700 border-slate-300 cursor-pointer"
            />
            <span class="font-medium">Remember this device (30 days)</span>
          </label>
        </div>

        <button
          type="submit"
          id="unified-submit-btn"
          class="w-full py-3.5 px-6 rounded-xl bg-[#173a39] hover:bg-teal-900 active:scale-[0.98] text-white font-bold text-sm shadow-lg shadow-teal-950/20 transition-all flex items-center justify-center gap-2 cursor-pointer mt-2"
        >
          <span id="btn-text">Sign In &rarr;</span>
          <svg id="btn-spinner" class="hidden animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>
      </form>

      <div class="pt-5 mt-5 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
        <a href="/" class="hover:text-teal-800 transition flex items-center gap-1.5 font-medium">
          &larr; Return to Public Website
        </a>
        <span class="text-slate-400 text-[11px] font-mono">Press ↵ to enter</span>
      </div>
    </div>
  </div>

  <!-- SCREEN 2: UNIFIED STAFF PORTAL HUB (Shown when authenticated) -->
  <div id="staff-portal-content" class="min-h-screen pb-16" transition:animate="fade">
    <!-- Component 1: Unified Staff Header Navigation with Global Sign Out -->
    <StaffPortalNav activeTab="overview" />

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 space-y-4">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h1 class="text-xl font-bold text-[#173a39] tracking-tight">Hub</h1>
        <p class="text-xs text-slate-500">
          <span id="staff-user-email"></span>
          <span class="text-slate-300 mx-1.5">·</span>
          <span id="hub-status-financials">Financials</span>
          <span class="text-slate-300 mx-1.5">·</span>
          <span id="hub-status-petsync">Census · {petSyncData.activeCount} · {petSyncLabel}</span>
        </p>
      </div>

      <div id="hub-data-status" class="hidden" role="status"></div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <a href="/internal/board/" class="block rounded-xl border border-slate-200 bg-white p-4 hover:border-teal-600 hover:shadow-sm transition">
          <div class="text-xs text-slate-500">Checking</div>
          <div id="metric-bank-cash" class="mt-1 text-2xl font-mono font-bold text-slate-900">--</div>
          <div id="metric-bank-period" class="mt-1 text-xs text-slate-500"></div>
          <div id="metric-audit-diff" class="mt-1 text-xs text-slate-500"></div>
          <div id="card-bank-cash" class="hidden"></div>
        </a>

        <a href="/internal/pets/" class="block rounded-xl border border-slate-200 bg-white p-4 hover:border-amber-500 hover:shadow-sm transition">
          <div class="text-xs text-slate-500">Census</div>
          <div id="hub-census-count" class="mt-1 text-2xl font-bold text-slate-900">{petSyncData.activeCount}</div>
          <div id="hub-census-sync" class="mt-1 text-xs text-slate-500">{petSyncLabel}</div>
        </a>

        <a href="/internal/donors/" class="block rounded-xl border border-slate-200 bg-white p-4 hover:border-rose-400 hover:shadow-sm transition">
          <div class="text-xs text-slate-500">Giving</div>
          <div id="metric-donor-volume" class="mt-1 text-2xl font-mono font-bold text-slate-900">--</div>
          <div id="metric-donor-counts" class="mt-1 text-xs text-slate-500"></div>
          <div id="metric-donor-active" class="mt-1 text-xs text-slate-500"></div>
          <div id="card-donor-volume" class="hidden"></div>
          <div id="card-donor-count" class="hidden"></div>
          <div id="card-donor-addresses" class="hidden"></div>
        </a>

        <a href="/internal/grants/" class="block rounded-xl border border-slate-200 bg-white p-4 hover:border-purple-400 hover:shadow-sm transition">
          <div class="text-xs text-slate-500">Grants</div>
          <div id="hub-grants-count" class="mt-1 text-2xl font-bold text-slate-900">--</div>
          <div id="hub-grants-detail" class="mt-1 text-xs text-slate-500"></div>
        </a>
      </div>

      <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-600">
        <a href="/internal/content/" class="hover:text-teal-800">Content</a>
        <a href="/internal/board/print/" target="_blank" class="hover:text-teal-800">Print packet</a>
        <a href={directusAdminUrl} target="_blank" rel="noopener noreferrer" class="hover:text-teal-800">CMS</a>
      </div>


    </main>

    <!-- Mobile Bottom Thumb-Navigation Dock -->
    <MobileBottomNav activeTab="overview" />

    <!-- Mobile Slide-Up More Tools Sheet -->
    <MobileMoreSheet />
  </div>
</BaseLayout>

<style>
  #staff-portal-auth-gate {
    display: flex;
  }
  #staff-portal-content {
    display: none;
  }
  html.staff-authenticated #staff-portal-auth-gate {
    display: none !important;
  }
  html.staff-authenticated #staff-portal-content {
    display: block !important;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fadeIn 0.3s ease-out forwards;
  }

  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    20%, 60% { transform: translateX(-6px); }
    40%, 80% { transform: translateX(6px); }
  }
  .animate-shake {
    animation: shake 0.4s cubic-bezier(.36,.07,.19,.97) both;
  }
</style>

<script>
  import { loginStaff, getStaffUserEmail, isStaffAuthenticated, staffClient, DIRECTUS_URL } from '../../lib/staff-auth';
  import { cashRunwayMonths, fetchStaffFinancials, publishedLabel, refreshStaffFinancials, setStaffDataStatus } from '../../lib/staff-financials';
  import { readItems } from '@directus/sdk';

  function applyDonorUnavailable() {
    const volumeEls = ['metric-donor-volume', 'card-donor-volume'];
    for (const id of volumeEls) {
      const el = document.getElementById(id);
      if (el) el.textContent = 'Unavailable';
    }
    const counts = document.getElementById('metric-donor-counts');
    if (counts) counts.textContent = 'Donor registry unavailable';
    const countEl = document.getElementById('card-donor-count');
    if (countEl) countEl.textContent = '—';
    const addrEl = document.getElementById('card-donor-addresses');
    if (addrEl) addrEl.textContent = '—';
  }

  function applyDonorMeta(meta: any) {
    if (!meta) {
      applyDonorUnavailable();
      return;
    }
    const volume = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(meta.total_lifetime_volume || 0);
    const volEl = document.getElementById('metric-donor-volume');
    if (volEl) volEl.textContent = volume;
    const cardVol = document.getElementById('card-donor-volume');
    if (cardVol) cardVol.textContent = volume;
    const counts = document.getElementById('metric-donor-counts');
    if (counts) {
      counts.textContent = `${(meta.total_donors || 0).toLocaleString()} donors`;
    }
    const countEl = document.getElementById('card-donor-count');
    if (countEl) countEl.textContent = (meta.total_donors || 0).toLocaleString();
    const addrEl = document.getElementById('card-donor-addresses');
    if (addrEl) addrEl.textContent = (meta.total_with_address || 0).toLocaleString();
    const activeEl = document.getElementById('metric-donor-active');
    if (activeEl && meta.active_2026_count != null) {
      activeEl.textContent = `${meta.active_2026_count} in 2026`;
    }
  }

  function applyMetrics(data: any) {
    if (!data) return;
    // GET /api/financials: YTD report + bank_statement + donors / donor_meta / donor_database.
    if (data.statement_of_position) {
      const cash = data.statement_of_position.assets.operating_checking_bank_register;
      const formattedCash = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 }).format(cash);

      const bankCashEl = document.getElementById('metric-bank-cash');
      if (bankCashEl) bankCashEl.textContent = formattedCash;

      const cardCashEl = document.getElementById('card-bank-cash');
      if (cardCashEl) cardCashEl.textContent = formattedCash;
    }

    const periodEl = document.getElementById('metric-bank-period');
    if (periodEl) periodEl.textContent = publishedLabel(data);

    const runway = cashRunwayMonths(data);
    const runwayEl = document.getElementById('metric-cash-runway');
    if (runwayEl) runwayEl.textContent = runway || 'Runway unavailable';

    const auditEl = document.getElementById('metric-audit-diff');
    if (auditEl) {
      const note = data.statement_of_position?.assets?.bank_register_note
        || data.notes?.['Bank Statement Reconciliation']
        || data.meta?.reconciliation_note;
      auditEl.textContent = note
        ? String(note).replace(/^First Merchants[^.]*\.\s*/i, '').slice(0, 90)
        : (runway ? `Cash runway ${runway} at current operating pace` : 'See Board Financials for bank recon');
    }

    const finPill = document.getElementById('hub-status-financials');
    if (finPill) finPill.textContent = publishedLabel(data);

    const donorMeta = data.donor_meta || data.donor_database?.meta || data.donors?.meta;
    if (donorMeta) applyDonorMeta(donorMeta);
    else applyDonorUnavailable();
  }

  async function loadFinancialMetrics() {
    setStaffDataStatus('hub-data-status', 'loading');
    const cached = await fetchStaffFinancials();
    if (cached.ok) applyMetrics(cached.data);

    const fresh = await refreshStaffFinancials();
    if (!fresh.ok) {
      if (fresh.status === 401 || fresh.status === 403) return;
      const finPill = document.getElementById('hub-status-financials');
      if (finPill) finPill.textContent = 'Financials unavailable';
      setStaffDataStatus('hub-data-status', 'error', fresh.error, () => {
        void loadFinancialMetrics();
      });
      return;
    }
    applyMetrics(fresh.data);
    setStaffDataStatus('hub-data-status', 'hidden');
  }

  function formatSyncLabel(iso: string | null | undefined): string {
    if (!iso) return 'time unknown';
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return 'time unknown';
    return d.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
  }

  function applyCensusSnapshot(activeCount: number, lastSeen: string | null) {
    const label = formatSyncLabel(lastSeen);
    const staleMs = lastSeen ? Date.now() - new Date(lastSeen).getTime() : Number.POSITIVE_INFINITY;
    const stale = !lastSeen || Number.isNaN(staleMs) || staleMs > 90 * 60 * 1000;

    const countEl = document.getElementById('hub-census-count');
    if (countEl) countEl.textContent = String(activeCount);
    const syncEl = document.getElementById('hub-census-sync');
    if (syncEl) syncEl.textContent = stale ? `${label} · stale` : label;
    const pill = document.getElementById('hub-status-petsync');
    if (pill) pill.textContent = `Census · ${activeCount} · ${label}`;
  }

  async function loadCensusSnapshot() {
    try {
      const res = await fetch(
        `${DIRECTUS_URL}/items/pets?filter[archived_at][_null]=true&limit=1&sort=-last_seen_at&fields=id,last_seen_at&meta=filter_count`
      );
      if (!res.ok) return;
      const json = await res.json();
      const activeCount = Number(json?.meta?.filter_count ?? json?.data?.length ?? 0);
      const lastSeen = json?.data?.[0]?.last_seen_at || null;
      applyCensusSnapshot(activeCount, lastSeen);
    } catch {
      const pill = document.getElementById('hub-status-petsync');
      if (pill) pill.textContent = 'PetSync: could not refresh census';
    }
  }

  async function loadGrantsSnapshot() {
    const countEl = document.getElementById('hub-grants-count');
    const detailEl = document.getElementById('hub-grants-detail');
    try {
      const grants = (await staffClient.request(readItems('grants', {
        fields: ['id', 'status'],
        limit: -1,
      }))) as Array<{ id: number; status?: string }>;
      const total = grants?.length || 0;
      const open = (grants || []).filter((g) => {
        const s = (g.status || '').toLowerCase();
        return s === 'open' || s === 'submitted' || s === 'pending';
      }).length;
      const awarded = (grants || []).filter((g) => {
        const s = (g.status || '').toLowerCase();
        return s === 'awarded' || s === 'won';
      }).length;
      if (countEl) countEl.textContent = String(total);
      if (detailEl) detailEl.textContent = `${open} open · ${awarded} awarded`;
    } catch {
      if (countEl) countEl.textContent = '—';
      if (detailEl) detailEl.textContent = 'Open Grants Tracker for details';
    }
  }

  function initStaffPortal() {
    const loginForm = document.getElementById('unified-login-form') as HTMLFormElement | null;
    const emailInput = document.getElementById('unified-email') as HTMLInputElement | null;
    const passwordInput = document.getElementById('unified-password') as HTMLInputElement | null;
    const rememberMeInput = document.getElementById('unified-remember-me') as HTMLInputElement | null;
    const passwordRevealBtn = document.getElementById('password-reveal-btn') as HTMLButtonElement | null;
    const eyeIcon = document.getElementById('eye-icon');
    const eyeOffIcon = document.getElementById('eye-off-icon');

    const submitBtn = document.getElementById('unified-submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');
    const errorAlert = document.getElementById('login-error-alert');
    const errorText = document.getElementById('login-error-text');
    const staffUserEmail = document.getElementById('staff-user-email');


    // Load financials if already authenticated
    if (isStaffAuthenticated()) {
      document.documentElement.classList.add('staff-authenticated');
      loadFinancialMetrics();
      void loadCensusSnapshot();
      void loadGrantsSnapshot();
    }

    // Password visibility toggle
    if (passwordRevealBtn && passwordInput && passwordRevealBtn.dataset.bound !== '1') {
      passwordRevealBtn.dataset.bound = '1';
      passwordRevealBtn.addEventListener('click', () => {
        const isPassword = passwordInput.type === 'password';
        passwordInput.type = isPassword ? 'text' : 'password';
        if (eyeIcon && eyeOffIcon) {
          eyeIcon.classList.toggle('hidden', isPassword);
          eyeOffIcon.classList.toggle('hidden', !isPassword);
        }
        passwordInput.focus();
      });
    }

    // Check URL parameters for backward compatibility with ?tab=petsync
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('reauth') === '1' && errorAlert && errorText) {
      errorText.textContent = 'Your staff session expired. Sign in again to load financials and the donor registry.';
      errorAlert.classList.remove('hidden');
    }
    if (urlParams.get('tab') === 'petsync' || window.location.hash === '#section-petsync') {
      window.location.replace('/internal/pets/');
      return;
    }

    // Update user display
    if (staffUserEmail) {
      staffUserEmail.textContent = getStaffUserEmail();
    }

    // Clear error message when user starts typing
    emailInput?.addEventListener('input', () => errorAlert?.classList.add('hidden'));
    passwordInput?.addEventListener('input', () => errorAlert?.classList.add('hidden'));

    // Login submit handler
    if (loginForm && loginForm.dataset.bound !== '1') {
      loginForm.dataset.bound = '1';

      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = emailInput ? emailInput.value.trim() : '';
        const password = passwordInput ? passwordInput.value : '';
        const rememberMe = rememberMeInput ? rememberMeInput.checked : true;

        if (!email || !password) return;

        // Loading state
        if (submitBtn) submitBtn.disabled = true;
        if (btnText) btnText.textContent = 'Authenticating...';
        if (btnSpinner) btnSpinner.classList.remove('hidden');
        if (errorAlert) errorAlert.classList.add('hidden');

        try {
          await loginStaff({ email, password, rememberMe });
          document.documentElement.classList.add('staff-authenticated');

          if (staffUserEmail) {
            staffUserEmail.textContent = email;
          }

          // Hydrate metrics immediately upon login
          loadFinancialMetrics();
          void loadCensusSnapshot();
          void loadGrantsSnapshot();

          // Check if there was a redirect query parameter
          const redirect = urlParams.get('redirect');
          if (redirect && redirect.startsWith('/internal')) {
            window.location.href = redirect;
          }
        } catch (err: any) {
          console.warn('[StaffPortal] Login error:', err);

          const errorCode = err?.errors?.[0]?.extensions?.code;
          if (errorCode === 'INVALID_CREDENTIALS') {
            if (errorText) errorText.textContent = 'Invalid email or password. Please verify your credentials.';
          } else {
            if (errorText) {
              errorText.textContent = err?.message || 'Unable to connect to authentication service. Please try again.';
            }
          }
          if (errorAlert) {
            errorAlert.classList.remove('animate-shake');
            void errorAlert.offsetWidth; // Trigger reflow for repeatable shake animation
            errorAlert.classList.add('animate-shake');
            errorAlert.classList.remove('hidden');
          }
        } finally {
          if (submitBtn) submitBtn.disabled = false;
          if (btnText) btnText.textContent = 'Secure Sign In';
          if (btnSpinner) btnSpinner.classList.add('hidden');
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStaffPortal);
  } else {
    initStaffPortal();
  }
  document.addEventListener('astro:page-load', initStaffPortal);
</script>
</BaseLayout>
