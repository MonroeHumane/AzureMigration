---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StaffPortalNav from '../../components/internal/StaffPortalNav.astro';
import MobileBottomNav from '../../components/internal/MobileBottomNav.astro';
import MobileMoreSheet from '../../components/internal/MobileMoreSheet.astro';
import { getStaffPetSyncData } from '../../lib/directus';
import publishedFinancials from '../../data/published_2026_ytd.json';
import donorDatabase from '../../data/donor_database.json';

const petSyncData = await getStaffPetSyncData();
const bankOperatingCash = publishedFinancials?.statement_of_position?.assets?.operating_checking_bank_register ?? 24526.34;
const formattedBankCash = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 }).format(bankOperatingCash);
const { meta: donorMeta } = donorDatabase;
const formattedDonorVolume = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(donorMeta.total_lifetime_volume);
const directusAdminUrl = 'https://mchs-directus.livelyfield-d0a70609.eastus.azurecontainerapps.io/admin';
---

<BaseLayout
  title="Staff Portal | Humane Society of Monroe County"
  description="Humane Society of Monroe County Staff Portal: Animal Census, Board Financials, and Grants Pipeline."
  bodyClass="bg-[#f9f7f2] text-slate-800 antialiased"
>
  <!-- Zero-Flicker Synchronous Auth Hydration (Runs before paint) -->
  <script is:inline>
    (function() {
      try {
        var raw = sessionStorage.getItem('directus_auth') || localStorage.getItem('directus_auth');
        var hasAuth = false;
        if (raw) {
          try {
            var parsed = JSON.parse(raw);
            if (parsed && (parsed.access_token || parsed.refresh_token)) {
              hasAuth = true;
            }
          } catch (e) {}
        }
        if (!hasAuth) {
          hasAuth = !!(
            localStorage.getItem('mchs_staff_auth') === 'true' ||
            sessionStorage.getItem('mchs_staff_auth') === 'true' ||
            localStorage.getItem('mchs_staff_token') ||
            sessionStorage.getItem('mchs_staff_token')
          );
        }
        if (hasAuth) {
          document.documentElement.classList.add('staff-authenticated');
        }
      } catch (e) {}
    })();
  </script>

  <!-- SCREEN 1: UNIFIED STAFF LOGIN GATE (Shown when unauthenticated) -->
  <div id="staff-portal-auth-gate" class="min-h-dvh flex flex-col lg:flex-row w-full bg-[#071a17]">
    
    <!-- LEFT PANEL: Hero & Live Telemetry (Desktop 54% width) -->
    <div class="hidden lg:flex lg:w-[54%] bg-gradient-to-br from-[#071a17] via-[#0b2622] to-[#061715] text-white p-10 xl:p-14 flex-col justify-between relative overflow-hidden border-r border-teal-900/60 shadow-2xl">
      <!-- Ambient Glow Orbs -->
      <div class="absolute -top-32 -left-32 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-teal-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <!-- Top Brand Header -->
      <div class="relative z-10">
        <div class="inline-flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-teal-800/80 text-emerald-300 border border-teal-700/80 flex items-center justify-center shadow-inner">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <div>
            <h2 class="text-base font-bold tracking-tight text-white">Humane Society of Monroe County</h2>
            <p class="text-xs text-teal-300/80 font-medium">Staff & Board Portal</p>
          </div>
        </div>
      </div>

      <!-- Center Value Proposition & Live Telemetry Cards -->
      <div class="relative z-10 my-auto py-12 max-w-xl">
        <span class="inline-block px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 mb-4">
          Staff Portal
        </span>
        <h1 class="text-3xl xl:text-4xl font-serif text-white tracking-tight leading-snug mb-4">
          Shelter operations, animal census, and financials.
        </h1>
        <p class="text-sm xl:text-base text-teal-100/80 leading-relaxed mb-8">
          Manage shelter animal rosters, PetPoint sync, board operating financials, lifetime donor registry, and grant pipelines in one unified workspace.
        </p>

        <!-- Live Operations Metrics Strip -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-xs">
          <div class="p-3.5 rounded-2xl bg-teal-950/60 border border-teal-800/60 backdrop-blur-sm shadow-inner">
            <span class="text-[10px] uppercase font-bold text-teal-300/70 block tracking-wider">Active Census</span>
            <span class="text-xl font-bold font-mono text-emerald-300 block mt-1">{petSyncData.activeCount}</span>
            <span class="text-[10px] text-teal-200/80 mt-0.5 block">Animals in shelter care</span>
          </div>
          <div class="p-3.5 rounded-2xl bg-teal-950/60 border border-teal-800/60 backdrop-blur-sm shadow-inner">
            <span class="text-[10px] uppercase font-bold text-teal-300/70 block tracking-wider">Checking Cash</span>
            <span class="text-xl font-bold font-mono text-teal-100 block mt-1">{formattedBankCash}</span>
            <span class="text-[10px] text-teal-200/80 mt-0.5 block">Aug 31 Certified</span>
          </div>
          <div class="p-3.5 rounded-2xl bg-teal-950/60 border border-teal-800/60 backdrop-blur-sm shadow-inner">
            <span class="text-[10px] uppercase font-bold text-teal-300/70 block tracking-wider">Lifetime Giving</span>
            <span class="text-xl font-bold font-mono text-rose-300 block mt-1">{formattedDonorVolume}</span>
            <span class="text-[10px] text-teal-200/80 mt-0.5 block">{donorMeta.total_donors.toLocaleString()} Donors</span>
          </div>
          <div class="p-3.5 rounded-2xl bg-teal-950/60 border border-teal-800/60 backdrop-blur-sm shadow-inner">
            <span class="text-[10px] uppercase font-bold text-teal-300/70 block tracking-wider">Annual Impact</span>
            <span class="text-xl font-bold font-mono text-amber-300 block mt-1">539</span>
            <span class="text-[10px] text-teal-200/80 mt-0.5 block">2025 Adoptions</span>
          </div>
        </div>
      </div>

      <!-- Bottom Platform Status Ticker -->
      <div class="relative z-10 pt-6 border-t border-teal-900/60 flex items-center justify-between text-xs text-teal-300/80">
        <div class="flex items-center gap-4">
          <span class="inline-flex items-center gap-1.5 font-medium">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            CMS Online
          </span>
          <span class="inline-flex items-center gap-1.5 font-medium">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            PetSync Active
          </span>
        </div>
        <span class="text-[11px] text-teal-400/60">Staff & Board Access</span>
      </div>
    </div>

    <!-- RIGHT PANEL: Mobile Native Sheet / Desktop Interactive Auth Box -->
    <div class="flex-1 flex flex-col justify-center items-center p-4 sm:p-8 lg:p-12 bg-[#f9f7f2] min-h-dvh lg:min-h-0">
      <div class="w-full max-w-md bg-white rounded-3xl border border-slate-200/90 shadow-2xl p-6 sm:p-10 animate-fade-in my-auto">
        <!-- Mobile Header (Visible only on <lg screens) -->
        <div class="lg:hidden text-center mb-6 pb-6 border-b border-slate-100">
          <div class="inline-flex p-3 rounded-2xl bg-[#173a39] text-emerald-300 mb-3 shadow-md">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h2 class="text-lg font-bold text-[#173a39]">Humane Society of Monroe County</h2>
          <p class="text-xs text-slate-500 mt-0.5">Staff & Board Portal</p>
        </div>

        <!-- Auth Card Heading -->
        <div class="mb-6">
          <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-teal-50 text-teal-800 border border-teal-200 mb-2">
            Staff Portal
          </span>
          <h2 class="text-2xl font-serif font-bold text-[#173a39] tracking-tight">
            Sign In
          </h2>
          <p class="text-xs text-slate-500 mt-1">
            Sign in with your staff account to continue.
          </p>
        </div>

        <!-- Error Alert Container -->
        <div id="login-error-alert" class="hidden p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-700 leading-relaxed mb-5 animate-shake">
          <div class="flex items-start gap-2.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-rose-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span id="login-error-text">Invalid email or password. Please try again.</span>
          </div>
        </div>

        <!-- Interactive Form -->
        <form id="unified-login-form" class="space-y-4">
          <div>
            <label for="unified-email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
              Email Address
            </label>
            <div class="relative">
              <input
                type="email"
                id="unified-email"
                required
                autocomplete="username"
                autocapitalize="none"
                placeholder="name@monroe-humane.org"
                class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-700 focus:border-teal-700 transition bg-slate-50/50 focus:bg-white"
              />
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="unified-password" class="block text-xs font-bold text-slate-700 uppercase tracking-wider">
                Password
              </label>
            </div>
            <div class="relative">
              <input
                type="password"
                id="unified-password"
                required
                autocomplete="current-password"
                placeholder="••••••••••••"
                class="w-full pl-4 pr-11 py-3 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-700 focus:border-teal-700 transition bg-slate-50/50 focus:bg-white"
              />
              <button
                type="button"
                id="password-reveal-btn"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1.5 focus:outline-none cursor-pointer rounded-lg hover:bg-slate-100 transition"
                title="Toggle password visibility"
                aria-label="Toggle password visibility"
              >
                <svg id="eye-icon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <svg id="eye-off-icon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                  <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
                  <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
                  <line x1="2" x2="22" y1="2" y2="22"></line>
                </svg>
              </button>
            </div>
          </div>

          <div class="flex items-center justify-between text-xs pt-1">
            <label class="flex items-center gap-2.5 text-slate-600 cursor-pointer select-none">
              <input
                type="checkbox"
                id="unified-remember-me"
                checked
                class="w-4 h-4 rounded text-teal-800 focus:ring-teal-700 border-slate-300 cursor-pointer"
              />
              <span class="font-medium">Remember this device (30 days)</span>
            </label>
          </div>

          <button
            type="submit"
            id="unified-submit-btn"
            class="w-full py-3.5 px-6 rounded-xl bg-[#173a39] hover:bg-teal-900 active:scale-[0.98] text-white font-bold text-sm shadow-lg shadow-teal-950/20 transition-all flex items-center justify-center gap-2 cursor-pointer mt-2"
          >
            <span id="btn-text">Sign In &rarr;</span>
            <svg id="btn-spinner" class="hidden animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </button>
        </form>

        <div class="pt-5 mt-5 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
          <a href="/" class="hover:text-teal-800 transition flex items-center gap-1.5 font-medium">
            &larr; Return to Public Website
          </a>
          <span class="text-slate-400 text-[11px] font-mono">Press ↵ to enter</span>
        </div>
      </div>
    </div>
  </div>

  <!-- SCREEN 2: UNIFIED STAFF PORTAL HUB (Shown when authenticated) -->
  <div id="staff-portal-content" class="min-h-screen pb-16" transition:animate="fade">
    <!-- Component 1: Unified Staff Header Navigation with Global Sign Out -->
    <StaffPortalNav activeTab="overview" />

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 space-y-6">
      <!-- Executive Command & Status Ribbon -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-xs p-6">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-teal-100 text-teal-800 border border-teal-200">
                Staff Operations Hub
              </span>
              <span id="staff-user-chip" class="text-xs text-slate-500 font-medium">
                Signed in as <strong id="staff-user-email" class="text-slate-800">staff@monroe-humane.org</strong>
              </span>
            </div>
            <h1 class="text-2xl font-bold text-[#173a39] tracking-tight">
              Operations Hub
            </h1>
            <p class="text-xs text-slate-500 mt-0.5">
              Shelter animal census, board financials, and operational tools.
            </p>
          </div>

          <!-- Operational Status Pills -->
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="px-2.5 py-1 rounded-md bg-emerald-100 text-emerald-800 font-semibold border border-emerald-200 inline-flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              CMS Online
            </span>
            <span class="px-2.5 py-1 rounded-md bg-amber-100 text-amber-900 font-semibold border border-amber-200 inline-flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-amber-500"></span>
              PetSync Active
            </span>
            <span class="px-2.5 py-1 rounded-md bg-slate-100 text-slate-700 font-medium border border-slate-200">
              QBO Synced
            </span>
          </div>
        </div>

        <!-- Financial Pulse + Census + Donors Strip -->
        <div class="mt-6 pt-6 border-t border-slate-100">

          <!-- Row 1: 4 Executive Snapshot Hero Cards -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

            <!-- Card 1: Bank Balance -->
            <div class="p-4 rounded-xl bg-teal-800 border border-teal-700 text-white shadow-xs flex flex-col justify-between">
              <div>
                <div class="flex items-start justify-between gap-2">
                  <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-teal-200 block">Checking Account Balance</span>
                    <div id="metric-bank-cash" class="text-2xl sm:text-3xl font-black font-mono mt-1 text-white">
                      {formattedBankCash}
                    </div>
                    <span class="text-[11px] text-teal-300 block mt-0.5">First Merchants Bank · Aug 31 Certified</span>
                  </div>
                  <div class="w-8 h-8 rounded-lg bg-teal-700 text-teal-200 flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="12" y1="1" x2="12" y2="23"></line>
                      <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                    </svg>
                  </div>
                </div>
              </div>
              <div class="mt-3 pt-3 border-t border-teal-700/80 flex items-center justify-between text-xs text-teal-200">
                <span>Audit Difference: <strong class="text-emerald-300 font-bold">$0.00 ✓</strong></span>
                <a href="/internal/board/" class="font-semibold text-white hover:text-teal-200 transition">
                  Financials &rarr;
                </a>
              </div>
            </div>

            <!-- Card 2: Shelter Census -->
            <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 shadow-xs flex flex-col justify-between">
              <div>
                <div class="flex items-start justify-between gap-2">
                  <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-amber-900 block">Shelter Animal Census</span>
                    <div class="text-2xl sm:text-3xl font-black text-amber-950 mt-1">
                      {petSyncData.activeCount} <span class="text-sm font-normal text-amber-800">active pets</span>
                    </div>
                    <span class="text-[11px] text-amber-700 block mt-0.5">Live PetPoint · syncs every 30 min</span>
                  </div>
                  <div class="w-8 h-8 rounded-lg bg-amber-100 text-amber-900 flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <path d="m10 15 5-3-5-3v6Z"></path>
                    </svg>
                  </div>
                </div>
              </div>
              <div class="mt-3 pt-3 border-t border-amber-200/80 flex items-center justify-between text-xs text-amber-900">
                <span>Fear Free Certified Team</span>
                <a href="/internal/pets/" class="font-bold text-amber-950 hover:text-amber-800 transition">
                  View Census &rarr;
                </a>
              </div>
            </div>

            <!-- Card 3: Donor Giving Registry -->
            <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 shadow-xs flex flex-col justify-between">
              <div>
                <div class="flex items-start justify-between gap-2">
                  <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-rose-900 block">Lifetime Giving</span>
                    <div class="text-2xl sm:text-3xl font-black font-mono text-rose-950 mt-1">
                      {formattedDonorVolume}
                    </div>
                    <span class="text-[11px] text-rose-700 block mt-0.5">
                      {donorMeta.total_donors.toLocaleString()} Donors · {donorMeta.total_with_address.toLocaleString()} With Address
                    </span>
                  </div>
                  <div class="w-8 h-8 rounded-lg bg-rose-100 text-rose-800 flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
                    </svg>
                  </div>
                </div>
              </div>
              <div class="mt-3 pt-3 border-t border-rose-200/80 flex items-center justify-between text-xs text-rose-900">
                <span>{donorMeta.active_2026_count} Active in 2026</span>
                <a href="/internal/donors/" class="font-bold text-rose-950 hover:text-rose-800 transition">
                  Open Registry &rarr;
                </a>
              </div>
            </div>

            <!-- Card 4: Grants & Funding Pipeline -->
            <div class="p-4 rounded-xl bg-purple-50 border border-purple-200 shadow-xs flex flex-col justify-between">
              <div>
                <div class="flex items-start justify-between gap-2">
                  <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-purple-900 block">Grants &amp; Funding</span>
                    <div class="text-2xl sm:text-3xl font-black text-purple-950 mt-1">
                      Pipeline
                    </div>
                    <span class="text-[11px] text-purple-700 block mt-0.5">
                      AAWA &amp; Zeffy Engines · Proposals Active
                    </span>
                  </div>
                  <div class="w-8 h-8 rounded-lg bg-purple-100 text-purple-800 flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
                      <polyline points="14 2 14 8 20 8"></polyline>
                    </svg>
                  </div>
                </div>
              </div>
              <div class="mt-3 pt-3 border-t border-purple-200/80 flex items-center justify-between text-xs text-purple-900">
                <span>Discovery Engines</span>
                <a href="/internal/grants/" class="font-bold text-purple-950 hover:text-purple-800 transition">
                  Track Grants &rarr;
                </a>
              </div>
            </div>
          </div>

          <!-- Row 2: Unified Quick Links Strip -->
          <div class="flex flex-wrap items-center gap-2 mt-4 pt-4 border-t border-slate-100 text-xs">
            <a href="/internal/board/" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-semibold bg-[#173a39] text-white hover:bg-teal-900 transition shadow-2xs">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="1" x2="12" y2="23"></line>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
              </svg>
              <span>Board Financials</span>
            </a>
