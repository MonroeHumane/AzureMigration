---
import StaffPortalLayout from '../../../layouts/StaffPortalLayout.astro';
import DonorRosterTable from '../../../components/donors/DonorRosterTable.astro';
// Donor JSON is not imported at build time. After auth, GET /api/financials
// returns donors (array), donor_meta, and donor_database ({ meta, donors }).
---

<StaffPortalLayout
  title="Donor Registry | Humane Society of Monroe County"
  description="Donor profiles and lifetime giving records."
  activeTab="donors"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 space-y-6">
    <div class="flex flex-wrap items-baseline justify-between gap-3 pb-3 border-b border-teal-800/60">
      <div>
        <a href="/internal/" class="text-xs text-teal-400 hover:text-emerald-300 transition inline-flex items-center gap-1 font-medium">← Return to Hub</a>
        <h1 class="text-2xl font-bold text-white tracking-tight mt-1">Donor Registry &amp; Giving</h1>
      </div>
      <p class="text-xs text-teal-300/80">
        <span id="donor-banner-volume" class="font-bold text-rose-300">--</span>
        · <span id="donor-banner-count">--</span>
        · <span id="donor-banner-addresses">--</span> addresses
        · <span id="donor-banner-tributes">--</span> tributes
      </p>
    </div>

    <main class="space-y-6">
      <section class="grid grid-cols-2 md:grid-cols-5 gap-3">
        <div class="bg-[#0b2420]/85 backdrop-blur-md rounded-2xl border border-teal-800/80 p-4 shadow-md">
          <div class="text-xs font-semibold text-rose-400 uppercase tracking-wider">Lifetime Volume</div>
          <div id="donor-kpi-volume" class="mt-1.5 font-mono font-bold text-xl text-rose-300">--</div>
        </div>
        <div class="bg-[#0b2420]/85 backdrop-blur-md rounded-2xl border border-teal-800/80 p-4 shadow-md">
          <div class="text-xs font-semibold text-teal-300 uppercase tracking-wider">Total Donors</div>
          <div id="donor-kpi-count" class="mt-1.5 font-mono font-bold text-xl text-teal-200">--</div>
        </div>
        <div class="bg-[#0b2420]/85 backdrop-blur-md rounded-2xl border border-teal-800/80 p-4 shadow-md">
          <div class="text-xs font-semibold text-emerald-400 uppercase tracking-wider">$1,000+ Major</div>
          <div id="donor-kpi-major" class="mt-1.5 font-mono font-bold text-xl text-emerald-300">--</div>
        </div>
        <div class="bg-[#0b2420]/85 backdrop-blur-md rounded-2xl border border-teal-800/80 p-4 shadow-md">
          <div class="text-xs font-semibold text-teal-300 uppercase tracking-wider">Addresses</div>
          <div id="donor-kpi-addresses" class="mt-1.5 font-mono font-bold text-xl text-teal-200">--</div>
        </div>
        <div class="bg-[#0b2420]/85 backdrop-blur-md rounded-2xl border border-teal-800/80 p-4 shadow-md">
          <div class="text-xs font-semibold text-amber-400 uppercase tracking-wider">2026 Active</div>
          <div id="donor-kpi-active" class="mt-1.5 font-mono font-bold text-xl text-amber-300">--</div>
        </div>
      </section>

      <div id="donor-api-status" class="rounded-2xl border border-teal-700/80 bg-[#0b2420]/90 px-4 py-3 text-sm text-teal-200 shadow-md">
        Loading donor registry…
      </div>

      <section id="donor-roster-section" class="hidden">
        <DonorRosterTable donors={[]} />
      </section>
    </main>
  </div>

  <script>
    import { isStaffAuthenticated } from '../../../lib/staff-auth';
    import { fetchStaffFinancials, refreshStaffFinancials, setStaffDataStatus } from '../../../lib/staff-financials';

    function formatCurrency(n: number) {
      return '$' + (n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function setText(id: string, text: string) {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    }

    function applyDonorPayload(data: any) {
      const meta = data?.donor_meta || data?.donor_database?.meta || data?.donors?.meta || data?.meta;
      const donors = Array.isArray(data?.donors)
        ? data.donors
        : (data?.donor_database?.donors || data?.donors?.donors);
      if (meta) {
        setText('donor-banner-volume', formatCurrency(meta.total_lifetime_volume));
        setText('donor-banner-count', (meta.total_donors || 0).toLocaleString());
        setText('donor-banner-addresses', (meta.total_with_address || 0).toLocaleString());
        setText('donor-banner-tributes', (meta.total_tributes_count || 0).toLocaleString());
        setText('donor-kpi-volume', formatCurrency(meta.total_lifetime_volume));
        setText('donor-kpi-count', (meta.total_donors || 0).toLocaleString());
        setText('donor-kpi-major', String(meta.major_donors_count ?? '--'));
        setText('donor-kpi-addresses', (meta.total_with_address || 0).toLocaleString());
        setText('donor-kpi-active', String(meta.active_2026_count ?? '--'));
      }
      if (Array.isArray(donors) && donors.length) {
        (window as any).__HSMC_DONORS__ = donors;
        const roster = document.getElementById('donor-roster-section');
        if (roster) roster.classList.remove('hidden');
        window.dispatchEvent(new CustomEvent('donors-hydrated', { detail: { donors } }));
        return true;
      }
      return false;
    }

    async function loadDonors() {
      if (!isStaffAuthenticated()) return;
      setStaffDataStatus('donor-api-status', 'loading', 'Loading donor registry…');

      const cached = await fetchStaffFinancials();
      if (cached.ok && applyDonorPayload(cached.data)) {
        setStaffDataStatus('donor-api-status', 'loading', 'Refreshing donor registry…');
      }

      const fresh = await refreshStaffFinancials();
      if (!fresh.ok) {
        if (fresh.status === 401 || fresh.status === 403) return;
        if (cached.ok && applyDonorPayload(cached.data)) {
          setStaffDataStatus('donor-api-status', 'error', `${fresh.error}. Showing the last loaded roster.`, () => {
            void loadDonors();
          });
          return;
        }
        setStaffDataStatus('donor-api-status', 'error', fresh.error, () => {
          void loadDonors();
        });
        return;
      }

      if (!applyDonorPayload(fresh.data)) {
        setStaffDataStatus(
          'donor-api-status',
          'error',
          'Donor registry is missing from the certified financials payload.',
          () => { void loadDonors(); }
        );
        return;
      }
      setStaffDataStatus('donor-api-status', 'hidden');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadDonors);
    } else {
      loadDonors();
    }
    document.addEventListener('astro:page-load', loadDonors);
  </script>
</StaffPortalLayout>
