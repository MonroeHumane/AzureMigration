---
import StaffPortalLayout from '../../../layouts/StaffPortalLayout.astro';
import DonorRosterTable from '../../../components/donors/DonorRosterTable.astro';
// Donor JSON is not imported at build time. After auth, GET /api/financials
// returns donors (array), donor_meta, and donor_database ({ meta, donors }).
---

<StaffPortalLayout
  title="Donor Registry | Humane Society of Monroe County"
  description="Donor profiles and lifetime giving records."
  activeTab="donors"
>
  <div class="space-y-6">
    <!-- Executive Banner -->
    <section class="bg-gradient-to-r from-[#173a39] via-teal-900 to-slate-900 text-white rounded-2xl p-6 sm:p-7 shadow-md border border-teal-800/80">
      <div class="max-w-5xl space-y-3">
        <div class="flex flex-wrap items-center gap-2 text-xs">
          <a href="/internal/" class="text-xs text-teal-300 hover:text-white transition font-medium flex items-center gap-1">
            &larr; Executive Hub
          </a>
          <span class="text-teal-700">/</span>
          <span class="text-teal-200 font-medium">
            Donor Registry
          </span>
          <div class="sm:ml-auto flex items-center gap-2 pt-1 sm:pt-0">
            <a
              href="/internal/board/"
              class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-[11px] font-semibold bg-teal-800/90 hover:bg-teal-700 text-teal-100 border border-teal-600 transition"
              title="View Operating Financials and Bank Statements"
            >
              Board Financials &rarr;
            </a>
            <a
              href="/internal/grants/"
              class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-[11px] font-semibold bg-purple-900/60 hover:bg-purple-800 text-purple-200 border border-purple-700/60 transition"
              title="View Grants Pipeline and Funding Opportunities"
            >
              Grants Tracker &rarr;
            </a>
          </div>
        </div>

        <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white">
          Donor Registry &amp; Lifetime Giving
        </h1>

        <!-- Quick Summary Metrics Bar -->
        <div class="pt-2 flex flex-wrap items-center gap-4 text-xs text-teal-200/90 border-t border-teal-800/60 font-medium">
          <div>
            Total Giving: <strong id="donor-banner-volume" class="text-white font-bold font-mono">--</strong>
          </div>
          <span class="text-teal-700">&bull;</span>
          <div>
            Donors: <strong id="donor-banner-count" class="text-white font-bold">--</strong>
          </div>
          <span class="text-teal-700">&bull;</span>
          <div>
            Mailing Addresses: <strong id="donor-banner-addresses" class="text-white font-bold">--</strong>
          </div>
          <span class="text-teal-700">&bull;</span>
          <div>
            Memorial Tributes: <strong id="donor-banner-tributes" class="text-white font-bold">--</strong>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content Area -->
    <main class="max-w-7xl mx-auto space-y-6">
      <!-- Headline KPI Cards Grid -->
      <section class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3.5">
        <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-xs flex flex-col justify-between">
          <div class="flex items-center justify-between text-slate-500 text-[11px] font-semibold uppercase tracking-wider">
            <span>Lifetime Giving</span>
          </div>
          <div id="donor-kpi-volume" class="mt-2 font-black font-mono text-lg sm:text-xl text-slate-900">--</div>
          <div class="mt-1 text-[10px] text-slate-500">All channels</div>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-xs flex flex-col justify-between">
          <div class="flex items-center justify-between text-slate-500 text-[11px] font-semibold uppercase tracking-wider">
            <span>Total Donors</span>
          </div>
          <div id="donor-kpi-count" class="mt-2 font-black font-mono text-lg sm:text-xl text-slate-900">--</div>
          <div class="mt-1 text-[10px] text-slate-500">All donor profiles</div>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-xs flex flex-col justify-between">
          <div class="flex items-center justify-between text-slate-500 text-[11px] font-semibold uppercase tracking-wider">
            <span>Major Donors ($1k+)</span>
          </div>
          <div id="donor-kpi-major" class="mt-2 font-black font-mono text-lg sm:text-xl text-purple-900">--</div>
          <div class="mt-1 text-[10px] text-purple-700 font-medium">Visionary &amp; Benefactor</div>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-xs flex flex-col justify-between">
          <div class="flex items-center justify-between text-slate-500 text-[11px] font-semibold uppercase tracking-wider">
            <span>Mailing Addresses</span>
          </div>
          <div id="donor-kpi-addresses" class="mt-2 font-black font-mono text-lg sm:text-xl text-teal-900">--</div>
          <div class="mt-1 text-[10px] text-teal-700 font-medium">Postal address on file</div>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-xs flex flex-col justify-between col-span-2 sm:col-span-1">
          <div class="flex items-center justify-between text-slate-500 text-[11px] font-semibold uppercase tracking-wider">
            <span>2026 Donors</span>
          </div>
          <div id="donor-kpi-active" class="mt-2 font-black font-mono text-lg sm:text-xl text-amber-900">--</div>
          <div class="mt-1 text-[10px] text-amber-700 font-medium">Gifts in 2026</div>
        </div>
      </section>

      <div id="donor-api-status" class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-950">
        Loading donor registry…
      </div>

      <section id="donor-roster-section" class="space-y-3 hidden">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-base font-bold text-slate-900">Donor Roster</h2>
            <p class="text-xs text-slate-500">Select any donor to view profile details and gift history.</p>
          </div>
        </div>
        <DonorRosterTable donors={[]} />
      </section>
    </main>
  </div>

  <script>
    import { getStaffToken, isStaffAuthenticated } from '../../../lib/staff-auth';

    function formatCurrency(n: number) {
      return '$' + (n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function setText(id: string, text: string) {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    }

    function showUnavailable() {
      const status = document.getElementById('donor-api-status');
      if (status) {
        status.className = 'rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700';
        status.textContent = 'Donor registry is unavailable. Sign in again, or confirm GET /api/financials includes donors / donor_meta.';
      }
    }

    function applyDonorPayload(data: any) {
      const meta = data?.donor_meta || data?.donor_database?.meta || data?.donors?.meta || data?.meta;
      const donors = Array.isArray(data?.donors)
        ? data.donors
        : (data?.donor_database?.donors || data?.donors?.donors);
      if (meta) {
        setText('donor-banner-volume', formatCurrency(meta.total_lifetime_volume));
        setText('donor-banner-count', (meta.total_donors || 0).toLocaleString());
        setText('donor-banner-addresses', (meta.total_with_address || 0).toLocaleString());
        setText('donor-banner-tributes', (meta.total_tributes_count || 0).toLocaleString());
        setText('donor-kpi-volume', formatCurrency(meta.total_lifetime_volume));
        setText('donor-kpi-count', (meta.total_donors || 0).toLocaleString());
        setText('donor-kpi-major', String(meta.major_donors_count ?? '--'));
        setText('donor-kpi-addresses', (meta.total_with_address || 0).toLocaleString());
        setText('donor-kpi-active', String(meta.active_2026_count ?? '--'));
      }
      if (Array.isArray(donors) && donors.length) {
        (window as any).__HSMC_DONORS__ = donors;
        const roster = document.getElementById('donor-roster-section');
        if (roster) roster.classList.remove('hidden');
        const status = document.getElementById('donor-api-status');
        if (status) status.classList.add('hidden');
        window.dispatchEvent(new CustomEvent('donors-hydrated', { detail: { donors } }));
        return true;
      }
      return false;
    }

    async function loadDonors() {
      if (!isStaffAuthenticated()) return;
      const token = await getStaffToken();
      if (!token) {
        showUnavailable();
        return;
      }
      try {
        const res = await fetch('/api/financials', {
          headers: { Authorization: `Bearer ${token}` },
        });
        if (!res.ok) {
          showUnavailable();
          return;
        }
        const data = await res.json();
        if (!applyDonorPayload(data || {})) {
          showUnavailable();
        }
      } catch {
        showUnavailable();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadDonors);
    } else {
      loadDonors();
    }
    document.addEventListener('astro:page-load', loadDonors);
  </script>
</StaffPortalLayout>
