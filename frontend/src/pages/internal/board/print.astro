            <td>Board-Designated Reserve (Fidelity)</td>
            <td id="print-pos-fidelity" class="text-right font-mono" style="font-weight:600; color:#4338ca;">--</td>
          </tr>
          <tr>
            <td>Fixed Capital Assets (Net of Depr.)</td>
            <td id="print-pos-fixed" class="text-right font-mono">--</td>
          </tr>
          <tr style="background:#f1f5f9; font-weight:700;">
            <td>Total Balance Sheet Assets (QBO)</td>
            <td id="print-pos-total-assets" class="text-right font-mono text-emerald" style="font-weight:800;">--</td>
          </tr>
          <tr style="background:#fef2f2; font-weight:700;">
            <td>Current Trade Obligations (AP + CC + LOC)</td>
            <td id="print-pos-obligations" class="text-right font-mono text-rose">--</td>
          </tr>
          <tr>
            <td>Net Assets Without Donor Restrictions</td>
            <td id="print-pos-without-restrictions" class="text-right font-mono">--</td>
          </tr>
          <tr>
            <td>Net Assets With Donor Restrictions</td>
            <td id="print-pos-with-restrictions" class="text-right font-mono">--</td>
          </tr>
          <tr>
            <td>Opening Balance Equity (Conversion)</td>
            <td id="print-pos-opening-equity" class="text-right font-mono text-rose">--</td>
          </tr>
          <tr>
            <td>Retained Earnings</td>
            <td id="print-pos-retained-earnings" class="text-right font-mono">--</td>
          </tr>
          <tr>
            <td>2026 YTD Net Deficit</td>
            <td id="print-pos-current-margin" class="text-right font-mono text-rose">--</td>
          </tr>
          <tr style="background:#ede9fe; font-weight:700;">
            <td>Certified Workbook Equity (Total)</td>
            <td id="print-pos-total-equity" class="text-right font-mono" style="color:#5b21b6; font-weight:800;">--</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="note-box" style="margin-top:6px;">
    <strong>Workbook Equity & Balance Sheet Equilibrium:</strong>
    Net assets without donor restrictions includes the Board-Designated Fidelity Operating Reserve and undesignated operating net assets. Total Liabilities + Total Equity = Total Assets with <strong>$0.00 variance</strong>.
  </div>

  <div class="page-break"></div>

  <h2>4. Itemized Accounts Payable Schedule (QBO Vendor Balance Summary)</h2>
  <table>
    <thead>
      <tr>
        <th>Vendor / Payee</th>
        <th>Expense Category</th>
        <th class="text-right">Balance Due</th>
        <th class="text-center">Classification</th>
      </tr>
    </thead>
    <tbody id="print-ap-tbody">
      <tr>
        <td colspan="4" style="text-align:center; padding:12px; color:#64748b;">Loading itemized accounts payable schedule...</td>
      </tr>
    </tbody>
    <tfoot>
      <tr style="background:#173a39; color:#fff; font-weight:700;">
        <td colspan="2">CERTIFIED ACCOUNTS PAYABLE TOTAL</td>
        <td id="print-ap-foot-total" class="text-right font-mono" style="color:#6ee7b7;">--</td>
        <td class="text-center" style="color:#6ee7b7; font-size:8.5px;">Accounts Reconciled Cent-for-Cent</td>
      </tr>
    </tfoot>
  </table>

  <div class="note-box">
    <strong>Form 990 & Contra-AP Disclosures:</strong>
    (1) Related parties Kelly Karlet and Jackie Monteer represent bona fide caregiver mileage/shelter expense reimbursements. Robert Monteer represents a staff clearing credit balance. Executive Director Jeffery Howard is compensated via regular board-approved W-2 payroll and holds no payables.
    (2) Contra-AP credits represent vendor/clearing credit memos offsetting gross liabilities, not negative operational expenditures.
  </div>

  <div class="footer">
    <span>Humane Society of Monroe County · Certified Board Financial Statement · Closed Period: August 31, 2026</span>
    <span id="print-footer-checksum" class="font-mono">Canonical SHA-256: --</span>
  </div>

  <script>
    import { isStaffAuthenticated, getStaffToken, logoutStaff } from '../../../lib/staff-auth';

    function formatDollar(val: number, maxDigits = 0): string {
      const isNeg = val < 0;
      const abs = Math.abs(Math.round(val));
      const formatted = new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
        maximumFractionDigits: maxDigits,
      }).format(abs);
      return isNeg ? `(${formatted})` : formatted;
    }

    function formatCents(val: number): string {
      const isNeg = val < 0;
      const abs = Math.abs(val);
      const formatted = new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      }).format(abs);
      return isNeg ? `(${formatted})` : formatted;
    }

    async function initPrintView(): Promise<void> {
      if (!isStaffAuthenticated()) {
        window.location.replace('/internal/?redirect=' + encodeURIComponent(window.location.pathname + window.location.search));
        return;
      }

      const token = await getStaffToken();
      if (!token) {
        window.location.replace('/internal/?redirect=' + encodeURIComponent(window.location.pathname + window.location.search));
        return;
      }

      try {
        const res = await fetch('/api/financials', {
          headers: { Authorization: `Bearer ${token}` }
        });

        if (!res.ok) {
          if (res.status === 401 || res.status === 403) {
            await logoutStaff('/internal/?error=session_expired');
          }
          return;
        }

        const data = await res.json();
        if (!data) return;

        const setEl = (id: string, text: string) => {
          const el = document.getElementById(id);
          if (el) el.textContent = text;
        };

        // Header
        if (data.meta) {
          setEl('print-period-title', `${data.meta.period_title} (Jan 1 – Aug 31, 2026)`);
          setEl('print-publisher', `Publisher: ${data.meta.published_by}`);
          setEl('print-checksum', `Canonical SHA-256: ${data.meta.sha256_checksum.slice(0, 16)}...`);
          setEl('print-footer-checksum', `Canonical SHA-256: ${data.meta.sha256_checksum}`);
        }

        // KPIs
        if (data.headline_kpis) {
          const k = data.headline_kpis;
          setEl('print-allin-net', formatDollar(k.all_in_net));
          setEl('print-allin-margin', `${k.all_in_margin_pct.toFixed(1)}% of all-in inflows`);
          setEl('print-qbo-net', formatDollar(k.qbo_operating_net));
          setEl('print-prog-ratio', `${k.program_ratio_pct.toFixed(1)}%`);
          setEl('print-total-liq', formatDollar(k.total_liquidity));
        }

        // Monthly Statements
        if (data.monthly_statements) {
          const tbody = document.getElementById('print-monthly-tbody');
          if (tbody) {
            tbody.innerHTML = '';
            data.monthly_statements.forEach((m: any) => {
              const tr = document.createElement('tr');
              tr.innerHTML = `
                <td style="font-weight:600;">${m.month}</td>
                <td class="text-right font-mono">${formatDollar(m.revenue)}</td>
                <td class="text-right font-mono">${formatDollar(m.cogs)}</td>
                <td class="text-right font-mono">${formatDollar(m.operating_exp)}</td>
                <td class="text-right font-mono">${formatDollar(m.other_exp)}</td>
                <td class="text-right font-mono" style="font-weight:600;">${formatDollar(m.total_exp)}</td>
                <td class="text-right font-mono ${m.net_margin >= 0 ? 'text-emerald' : 'text-rose'}" style="font-weight:700;">${formatDollar(m.net_margin)}</td>
                <td class="text-right ${m.net_margin >= 0 ? 'text-emerald' : 'text-rose'}">${m.margin_pct > 0 ? '+' : ''}${m.margin_pct.toFixed(1)}%</td>
                <td style="font-size:8.5px; color:#475569;">${m.driver}</td>
              `;
              tbody.appendChild(tr);
            });

            const totalRev = data.monthly_statements.reduce((a: number, b: any) => a + b.revenue, 0);
            const totalExp = data.monthly_statements.reduce((a: number, b: any) => a + b.total_exp, 0);
            const totalNet = data.monthly_statements.reduce((a: number, b: any) => a + b.net_margin, 0);
            setEl('print-foot-rev', formatDollar(totalRev));
            setEl('print-foot-cogs', formatDollar(data.headline_kpis.qbo_cogs));
            setEl('print-foot-opexp', formatDollar(data.headline_kpis.qbo_operating_expenditures));
            setEl('print-foot-other', formatDollar(Math.abs(data.bridge_composition.fleet_transit_and_fuel)));
            setEl('print-foot-total-exp', formatDollar(totalExp));
            setEl('print-foot-net', formatDollar(totalNet));
            setEl('print-foot-margin', `${((totalNet / totalRev) * 100).toFixed(1)}%`);
          }
        }

        // Bridge
        if (data.bridge_composition) {
          const b = data.bridge_composition;
          setEl('print-bridge-qbo-net', formatCents(data.headline_kpis.qbo_operating_net));
          setEl('print-bridge-endowment', `+${formatCents(b.endowment_distributions)}`);
          setEl('print-bridge-recycling', `+${formatCents(b.recycling_and_rebates)}`);
          setEl('print-bridge-fleet', `-${formatCents(Math.abs(b.fleet_transit_and_fuel))}`);
          setEl('print-bridge-net-adj', `+${formatCents(b.net_bridge_total)}`);
          setEl('print-bridge-allin', formatCents(data.headline_kpis.all_in_net));
        }

        // Statement of Position
        if (data.statement_of_position) {
          const pos = data.statement_of_position;
          setEl('print-pos-checking-book', formatDollar(pos.assets.operating_checking_first_merchants));
          setEl('print-pos-checking-bank', formatDollar(pos.assets.operating_checking_bank_register));
          setEl('print-pos-undeposited', formatDollar(pos.assets.undeposited_funds));
          setEl('print-pos-petty', formatDollar(pos.assets.petty_cash));
          setEl('print-pos-total-book-cash', formatDollar(pos.assets.total_book_operating_cash));
          setEl('print-pos-tax-escrow', formatDollar(pos.assets.tax_holding_escrow));
          setEl('print-pos-fidelity', formatDollar(pos.assets.fidelity_board_designated_reserve));
          setEl('print-pos-fixed', formatDollar(pos.assets.fixed_assets_net));
          setEl('print-pos-total-assets', formatDollar(pos.assets.total_assets));
          setEl('print-pos-obligations', formatDollar(pos.liabilities.total_operating_obligations_current));
          setEl('print-pos-without-restrictions', formatDollar(pos.net_assets.without_donor_restrictions.total_without_donor_restrictions));
          setEl('print-pos-with-restrictions', formatDollar(pos.net_assets.with_donor_restrictions.total_with_donor_restrictions));
          setEl('print-pos-opening-equity', formatDollar(pos.net_assets.opening_balance_equity));
          setEl('print-pos-retained-earnings', formatDollar(pos.net_assets.retained_earnings_historical));
          setEl('print-pos-current-margin', formatDollar(pos.net_assets.current_year_net_margin));
          setEl('print-pos-total-equity', formatDollar(pos.net_assets.total_equity_qbo));
        }

        // Accounts Payable Schedule
        if (data.accounts_payable_schedule) {
          const ap = data.accounts_payable_schedule;
          const tbody = document.getElementById('print-ap-tbody');
          if (tbody) {
            tbody.innerHTML = '';
            ap.forEach((item: any) => {
              const tr = document.createElement('tr');
              tr.innerHTML = `
                <td><strong>${item.vendor}</strong> ${item.is_related_party ? '<span class="badge badge-related" style="margin-left:4px;">990 Related Party</span>' : ''}</td>
                <td>${item.category}</td>
                <td class="text-right font-mono">${formatCents(item.amount)}</td>
                <td class="text-center">${item.status}</td>
              `;
              tbody.appendChild(tr);
            });
            const apTotal = ap.reduce((a: number, b: any) => a + b.amount, 0);
            setEl('print-ap-foot-total', formatCents(apTotal));
          }
        }

        const printBtn = document.getElementById('print-action-btn') as HTMLButtonElement | null;
        if (printBtn) printBtn.removeAttribute('disabled');
      } catch (e) {
        console.error('Error loading print financials:', e);
      }
    }

    document.addEventListener('astro:page-load', initPrintView);
    if (document.readyState !== 'loading') {
      initPrintView();
    } else {
      document.addEventListener('DOMContentLoaded', initPrintView);
    }
  </script>
</body>
</html>
