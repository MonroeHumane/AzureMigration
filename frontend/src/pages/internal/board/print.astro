    <div>
      <h2>3. Statement of Financial Position (August 31, 2026)</h2>
      <table>
        <tbody>
          <tr>
            <td>Operating Checking (GL Book Cash)</td>
            <td id="print-pos-checking-book" class="text-right font-mono">--</td>
          </tr>
          <tr style="background:#fffbeb;">
            <td>First Merchants Bank Statement Ending (Aug 31)</td>
            <td id="print-pos-checking-bank" class="text-right font-mono" style="color:#92400e; font-weight:600;">--</td>
          </tr>
          <tr>
            <td>Undeposited Funds</td>
            <td id="print-pos-undeposited" class="text-right font-mono">--</td>
          </tr>
          <tr>
            <td>Petty Cash</td>
            <td id="print-pos-petty" class="text-right font-mono">--</td>
          </tr>
          <tr style="background:#f5efe3; font-weight:700;">
            <td>Total Book Operating Cash</td>
            <td id="print-pos-total-book-cash" class="text-right font-mono">--</td>
