---
// Print & PDF Packet Template — Authenticated Client-Side Rendering
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>HSMC Board Financial Packet - 2026 YTD Print</title>
  <script is:inline>
    (function() {
      try {
        var raw = sessionStorage.getItem('directus_auth') || localStorage.getItem('directus_auth');
        var hasAuth = false;
        if (raw) {
          var parsed = JSON.parse(raw);
          if (parsed && (parsed.access_token || parsed.refresh_token)) {
            hasAuth = true;
          }
        }
        if (!hasAuth) {
          hasAuth = !!(sessionStorage.getItem('mchs_staff_auth') || localStorage.getItem('mchs_staff_auth'));
        }
        if (!hasAuth) {
          window.location.replace('/internal/?redirect=' + encodeURIComponent(window.location.pathname + window.location.search));
        }
      } catch (e) {}
    })();
  </script>
  <style>
    @page {
      size: letter portrait;
      margin: 0.4in;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: #173a39;
      background: #ffffff;
      line-height: 1.3;
      font-size: 10.5px;
      margin: 0;
      padding: 0;
    }
    .header {
      border-bottom: 2px solid #173a39;
      padding-bottom: 6px;
      margin-bottom: 10px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }
    .badge {
      display: inline-block;
      padding: 1px 5px;
      font-size: 8.5px;
      font-weight: 700;
      border-radius: 3px;
      background: #f1f5f9;
      border: 1px solid #cbd5e1;
    }
    .badge-confidential {
      background: #ffe4e6;
      color: #9f1239;
      border-color: #f43f5e;
    }
    .badge-related {
      background: #fef3c7;
      color: #92400e;
      border-color: #f59e0b;
      font-size: 8px;
      padding: 1px 4px;
    }
    .badge-credit {
      background: #ffedd5;
      color: #9a3412;
      border-color: #ea580c;
      font-size: 8px;
      padding: 1px 4px;
    }
    h1 {
      font-size: 17px;
      margin: 3px 0 1px 0;
      font-weight: 800;
      color: #173a39;
    }
    h2 {
      font-size: 12px;
      margin: 10px 0 5px 0;
      font-weight: 700;
      border-bottom: 1px solid #e2e8f0;
      padding-bottom: 2px;
      color: #173a39;
    }
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
      margin-bottom: 10px;
    }
    .kpi-card {
      border: 1px solid #cbd5e1;
      border-radius: 4px;
      padding: 5px 7px;
      background: #f8fafc;
    }
    .kpi-title {
      font-size: 8.5px;
      text-transform: uppercase;
      color: #64748b;
      font-weight: 700;
    }
    .kpi-val {
      font-size: 14px;
      font-weight: 800;
      margin-top: 1px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 8px;
      font-size: 9.5px;
    }
    th, td {
      padding: 3px 5px;
      border-bottom: 1px solid #e2e8f0;
    }
    th {
      background: #f1f5f9;
      font-weight: 700;
      text-align: left;
    }
    .text-right { text-align: right; }
    .text-center { text-align: center; }
    .font-mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
    .text-rose { color: #be123c; }
    .text-emerald { color: #047857; }
    .footer {
      margin-top: 10px;
      border-top: 1px solid #cbd5e1;
      padding-top: 5px;
      font-size: 8.5px;
      color: #64748b;
      display: flex;
      justify-content: space-between;
    }
    .note-box {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 4px;
      padding: 6px 8px;
      font-size: 8.5px;
      color: #475569;
      margin-bottom: 8px;
    }
    .no-print {
      background: #173a39;
      color: #ffffff;
      padding: 8px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }
    @media print {
      .no-print { display: none; }
      .page-break { page-break-before: always; }
    }
  </style>
</head>
<body>
  <div class="no-print">
    <span>Humane Society of Monroe County — Official Board Packet (Print Preview)</span>
    <button id="print-action-btn" onclick="window.print()" style="background:#1c746c;color:#fff;border:none;padding:5px 14px;border-radius:4px;cursor:pointer;font-weight:bold;">Print / Save PDF</button>
  </div>

  <div class="header">
    <div>
      <div>
        <span class="badge badge-confidential">BOARD CONFIDENTIAL</span>
        <span class="badge">ACCRUAL BASIS</span>
        <span class="badge">QBO CERTIFIED</span>
      </div>
      <h1>Humane Society of Monroe County</h1>
      <div id="print-period-title" style="font-size:11px; font-weight:600; color:#334155;">Financial Packet (Jan 1 – Aug 31, 2026)</div>
    </div>
    <div style="text-align:right;">
      <div style="font-size:9.5px; color:#64748b;">Cutoff: August 31, 2026</div>
      <div id="print-publisher" style="font-size:9.5px; color:#64748b;">Publisher: Executive Director</div>
      <div id="print-checksum" style="font-size:8.5px; font-family:monospace; color:#047857; margin-top:2px;">Canonical SHA-256: --</div>
    </div>
  </div>

  <div class="kpi-grid">
    <div class="kpi-card">
      <div class="kpi-title">All-In Net Margin</div>
      <div id="print-allin-net" class="kpi-val text-rose">--</div>
      <div id="print-allin-margin" style="font-size:8px; color:#64748b;">--% of all-in inflows</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-title">QBO Operating Net</div>
      <div id="print-qbo-net" class="kpi-val" style="color:#b45309;">--</div>
      <div style="font-size:8px; color:#64748b;">Pre-endowment operations</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-title">Program Efficiency</div>
      <div id="print-prog-ratio" class="kpi-val text-emerald">--%</div>
      <div style="font-size:8px; color:#64748b;">Benchmark ≥75% (Form 990 Part IX)</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-title">Total Cash Stack</div>
      <div id="print-total-liq" class="kpi-val" style="color:#173a39;">--</div>
      <div style="font-size:8px; color:#64748b;">Liquid Operating & Reserves</div>
    </div>
  </div>

  <h2>1. Month-by-Month Operating Statement (Jan 1 – Aug 31, 2026)</h2>
  <table>
    <thead>
      <tr>
        <th>Period</th>
        <th class="text-right">Revenue</th>
        <th class="text-right">Direct Care (COGS)</th>
        <th class="text-right">Operations/Payroll</th>
        <th class="text-right">Fleet/Other</th>
        <th class="text-right">Total Exp</th>
        <th class="text-right">Net Margin</th>
        <th class="text-right">Margin %</th>
        <th>Primary Operational Driver</th>
      </tr>
    </thead>
    <tbody id="print-monthly-tbody">
      <tr>
        <td colspan="9" style="text-align:center; padding:12px; color:#64748b;">Loading certified operating statement...</td>
      </tr>
    </tbody>
    <tfoot>
      <tr style="background:#173a39; color:#fff; font-weight:700;">
        <td>CERTIFIED TOTAL</td>
        <td id="print-foot-rev" class="text-right font-mono" style="color:#6ee7b7;">--</td>
        <td id="print-foot-cogs" class="text-right font-mono" style="color:#cbd5e1;">--</td>
        <td id="print-foot-opexp" class="text-right font-mono" style="color:#cbd5e1;">--</td>
        <td id="print-foot-other" class="text-right font-mono" style="color:#cbd5e1;">--</td>
        <td id="print-foot-total-exp" class="text-right font-mono" style="color:#fde047;">--</td>
        <td id="print-foot-net" class="text-right font-mono" style="color:#fda4af;">--</td>
        <td id="print-foot-margin" class="text-right" style="color:#fda4af;">--%</td>
        <td style="color:#6ee7b7; font-size:8.5px;">Cent-for-cent footed</td>
      </tr>
    </tfoot>
  </table>

  <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px;">
    <div>
      <h2>2. Certified Operating-to-All-In Bridge</h2>
      <table>
        <tbody>
          <tr>
            <td><strong>QBO Certified Operating Net</strong></td>
            <td id="print-bridge-qbo-net" class="text-right font-mono" style="font-weight:700;">--</td>
          </tr>
          <tr>
            <td>(+) Endowment Distributions (MCCF)</td>
            <td id="print-bridge-endowment" class="text-right font-mono text-emerald">--</td>
          </tr>
          <tr>
            <td>(+) Recycling, Rebates & Restitution</td>
            <td id="print-bridge-recycling" class="text-right font-mono text-emerald">--</td>
          </tr>
          <tr>
            <td>(-) Fleet Transit & Gasoline Spend</td>
            <td id="print-bridge-fleet" class="text-right font-mono text-rose">--</td>
          </tr>
          <tr style="background:#f1f5f9; font-weight:700;">
            <td>Net Adjustment Subtotal</td>
            <td id="print-bridge-net-adj" class="text-right font-mono">--</td>
          </tr>
          <tr style="background:#ffe4e6; font-weight:800;">
            <td>All-In Certified Bottom Line</td>
            <td id="print-bridge-allin" class="text-right font-mono text-rose">--</td>
          </tr>
