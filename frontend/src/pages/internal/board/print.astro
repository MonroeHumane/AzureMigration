  <script>
    import { isStaffAuthenticated, getStaffToken, forceStaffRelogin } from '../../../lib/staff-auth';
    import { getCachedFinancials } from '../../../lib/api';

    function formatDollar(val: number, maxDigits = 0): string {
      const isNeg = val < 0;
      const abs = Math.abs(Math.round(val));
      const formatted = new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
        maximumFractionDigits: maxDigits,
      }).format(abs);
      return isNeg ? `(${formatted})` : formatted;
    }

    function formatCents(val: number): string {
      const isNeg = val < 0;
      const abs = Math.abs(val);
      const formatted = new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      }).format(abs);
      return isNeg ? `(${formatted})` : formatted;
    }

    const CATEGORY_DEFS = [
      { key: 'wages', name: 'Wages & Payroll', group: 'Payroll', sourceCategories: ['Staff Payroll', 'Staff Paycheck'] },
      { key: 'taxes', name: 'Payroll Taxes', group: 'Payroll', sourceCategories: ['Payroll Taxes'] },
      { key: 'medical', name: 'Veterinary & Medical', group: 'Operations', sourceCategories: ['Veterinary & Medical Care', 'Veterinary Supply'] },
      { key: 'facilities', name: 'Facilities & Sanitation', group: 'Operations', sourceCategories: ['Facilities & Sanitation'] },
      { key: 'insurance', name: 'Insurance', group: 'Operations', sourceCategories: ['Insurance & Risk'] },
      { key: 'capital', name: 'Capital Projects', group: 'Capital', sourceCategories: ['Capital Improvements'] },
      { key: 'creditcard', name: 'Credit Card Clearing', group: 'Operations', sourceCategories: ['Credit Card Liability'] },
      { key: 'software', name: 'Software & Technology', group: 'Operations', sourceCategories: ['Software & Technology', 'Software & Cloud'] },
      { key: 'bankfees', name: 'Bank & Merchant Fees', group: 'Operations', sourceCategories: ['Bank & Processing Fees'] },
    ];

    function hydrateExpenseTable(withdrawals: any[]) {
      const tbody = document.getElementById('print-expense-tbody');
      if (!tbody) return;
      const cats = CATEGORY_DEFS.map((def) => {
        const txs = (withdrawals || []).filter((w: any) => def.sourceCategories.includes(w.category));
        const vendorMap = new Map<string, number>();
        for (const t of txs) {
          const k = t.payee || 'Unknown';
          vendorMap.set(k, (vendorMap.get(k) || 0) + t.amount);
        }
        const topVendors = Array.from(vendorMap.entries())
          .sort((a, b) => b[1] - a[1])
          .map(([name, amt]) => `${name} (${formatDollar(amt)})`);
        return {
          ...def,
          total: txs.reduce((s: number, t: any) => s + t.amount, 0),
          txCount: txs.length,
          payeeCount: vendorMap.size,
          topVendorsStr: topVendors.slice(0, 3).join(', '),
        };
      }).filter((c) => c.txCount > 0).sort((a, b) => b.total - a.total);

      const totalSpend = cats.reduce((s, c) => s + c.total, 0);
      const totalTxs = cats.reduce((s, c) => s + c.txCount, 0);
      tbody.innerHTML = '';
      cats.forEach((c) => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><strong>${c.name}</strong></td>
          <td><span class="badge">${c.group}</span></td>
          <td class="text-center font-mono">${c.payeeCount}</td>
          <td class="text-center font-mono">${c.txCount}</td>
          <td class="text-right font-mono" style="font-weight:700;">${formatDollar(c.total)}</td>
          <td class="text-right font-mono">${totalSpend > 0 ? ((c.total / totalSpend) * 100).toFixed(1) : '0.0'}%</td>
          <td style="font-size:8px; color:#475569;">${c.topVendorsStr || '—'}</td>
        `;
        tbody.appendChild(tr);
      });

      const setEl = (id: string, text: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = text;
      };
      setEl('print-aug-spend', formatDollar(totalSpend));
      setEl('print-aug-txs', String(totalTxs));
      setEl('print-aug-txs-foot', String(totalTxs));
      setEl('print-aug-spend-foot', formatDollar(totalSpend));
      setEl('print-aug-payees', String(cats.reduce((s, c) => s + c.payeeCount, 0)));
    }

    async function initPrintView(): Promise<void> {
      if (!isStaffAuthenticated()) {
        window.location.replace('/internal/?redirect=' + encodeURIComponent(window.location.pathname + window.location.search));
        return;
      }

      const token = await getStaffToken();
      if (!token) {
        window.location.replace('/internal/?redirect=' + encodeURIComponent(window.location.pathname + window.location.search));
        return;
      }

      try {
        const res = await fetch('/api/financials', {
          headers: { Authorization: `Bearer ${token}` }
        });

        let data = null;
        if (res.status === 401 || res.status === 403) {
          forceStaffRelogin();
          return;
        }
        if (res.ok) {
          data = await res.json();
        } else {
          console.warn('[PrintView] /api/financials returned', res.status, '- attempting cache fallback');
          data = getCachedFinancials();
        }
        if (!data) return;

        const loading = document.getElementById('print-loading-banner');
        if (loading) loading.remove();

        const setEl = (id: string, text: string) => {
          const el = document.getElementById(id);
          if (el) el.textContent = text;
        };

        if (data.meta) {
          setEl('print-period-title', `Official Board Financial Packet — Jan 1 through August 31, 2026`);
          setEl('print-publisher', `Prepared By: ${data.meta.published_by}`);
          setEl('print-checksum', `SHA-256: ${data.meta.sha256_checksum.slice(0, 16)}...`);
          setEl('print-footer-checksum', `Canonical SHA-256: ${data.meta.sha256_checksum}`);
          setEl('print-footer-checksum-p1', `SHA-256: ${data.meta.sha256_checksum.slice(0, 24)}...`);
        }

        if (data.headline_kpis) {
          const k = data.headline_kpis;
          setEl('print-allin-net', formatDollar(k.all_in_net));
          setEl('print-allin-margin', `8 Mo Closed · ${k.all_in_margin_pct.toFixed(1)}% margin`);
          setEl('print-qbo-net', formatDollar(k.qbo_operating_net));
          setEl('print-prog-ratio', `${k.program_ratio_pct.toFixed(1)}%`);

          const bankCash = k.bank_register_cash || k.operating_checking_bank_register || 0;
          const fidCash = k.fidelity_reserve || 0;
          setEl('print-total-liq', formatDollar(bankCash + fidCash));
          const burn = Math.abs((k.qbo_operating_net || 0) / 8) || 1;
          setEl('print-runway-sub', `${((bankCash + fidCash) / burn).toFixed(1)} Mo Runway`);
        }

        if (data.monthly_statements) {
          const tbody = document.getElementById('print-monthly-tbody');
          if (tbody) {
            tbody.innerHTML = '';
            data.monthly_statements.forEach((m: any) => {
              const tr = document.createElement('tr');
              tr.innerHTML = `
                <td style="font-weight:600;">${m.month}</td>
                <td class="text-right font-mono">${formatDollar(m.revenue)}</td>
                <td class="text-right font-mono">${formatDollar(m.cogs)}</td>
                <td class="text-right font-mono">${formatDollar(m.operating_exp)}</td>
                <td class="text-right font-mono">${formatDollar(m.other_exp)}</td>
                <td class="text-right font-mono" style="font-weight:600;">${formatDollar(m.total_exp)}</td>
                <td class="text-right font-mono ${m.net_margin >= 0 ? 'text-emerald' : 'text-rose'}" style="font-weight:700;">${formatDollar(m.net_margin)}</td>
                <td class="text-right ${m.net_margin >= 0 ? 'text-emerald' : 'text-rose'}">${m.margin_pct > 0 ? '+' : ''}${m.margin_pct.toFixed(1)}%</td>
                <td style="font-size:8px; color:#475569;">${m.driver}</td>
              `;
              tbody.appendChild(tr);
            });

            const totalRev = data.monthly_statements.reduce((a: number, b: any) => a + b.revenue, 0);
            const totalExp = data.monthly_statements.reduce((a: number, b: any) => a + b.total_exp, 0);
            const totalNet = data.monthly_statements.reduce((a: number, b: any) => a + b.net_margin, 0);
            setEl('print-foot-rev', formatDollar(totalRev));
            setEl('print-foot-cogs', formatDollar(data.headline_kpis.qbo_cogs));
            setEl('print-foot-opexp', formatDollar(data.headline_kpis.qbo_operating_expenditures));
            setEl('print-foot-other', formatDollar(Math.abs(data.bridge_composition.fleet_transit_and_fuel)));
            setEl('print-foot-total-exp', formatDollar(totalExp));
            setEl('print-foot-net', formatDollar(totalNet));
            setEl('print-foot-margin', `${((totalNet / totalRev) * 100).toFixed(1)}%`);
          }
        }

        if (data.bridge_composition) {
          const b = data.bridge_composition;
          setEl('print-bridge-qbo-net', formatCents(data.headline_kpis.qbo_operating_net));
          setEl('print-bridge-endowment', `+${formatCents(b.endowment_distributions)}`);
          setEl('print-bridge-recycling', `+${formatCents(b.recycling_and_rebates)}`);
          setEl('print-bridge-fleet', `-${formatCents(Math.abs(b.fleet_transit_and_fuel))}`);
          setEl('print-bridge-net-adj', `+${formatCents(b.net_bridge_total)}`);
          setEl('print-bridge-allin', formatCents(data.headline_kpis.all_in_net));
        }

        if (data.statement_of_position) {
          const pos = data.statement_of_position;
          const bankCash = pos.assets.operating_checking_bank_register || 0;
          const fidCash = pos.assets.fidelity_board_designated_reserve || 0;
          setEl('print-pos-checking-bank', formatDollar(bankCash));
          setEl('print-pos-fidelity', formatDollar(fidCash));
          setEl('print-pos-total-liquid-cash', formatDollar(bankCash + fidCash));
          setEl('print-pos-checking-book', formatDollar(pos.assets.operating_checking_first_merchants));
          setEl('print-pos-tax-escrow', formatDollar(pos.assets.tax_holding_escrow));
          setEl('print-pos-fixed', formatDollar(pos.assets.fixed_assets_net));
          setEl('print-pos-total-assets', formatDollar(pos.assets.total_assets));
          setEl('print-pos-obligations', formatDollar(pos.liabilities.total_operating_obligations_current));
          setEl('print-pos-total-equity', formatDollar(pos.net_assets.total_equity_qbo));
        }

        if (data.accounts_payable_schedule) {
          const ap = data.accounts_payable_schedule;
          const tbody = document.getElementById('print-ap-tbody');
          if (tbody) {
            tbody.innerHTML = '';
            ap.forEach((item: any) => {
              const tr = document.createElement('tr');
              tr.innerHTML = `
                <td>
                  <strong>${item.vendor}</strong>
                  ${item.is_related_party ? '<span class="badge badge-related" style="margin-left:3px;">990 Related</span>' : ''}
                  ${item.is_contra_credit ? '<span class="badge" style="margin-left:3px; background:#e2e8f0; font-size:7px;">Credit</span>' : ''}
                </td>
                <td>${item.category}</td>
                <td class="text-right font-mono" style="${item.amount < 0 ? 'color:#047857; font-weight:700;' : 'font-weight:700;'}">${formatCents(item.amount)}</td>
                <td class="text-center">
                  <span class="badge" style="${item.status === 'Active Current' ? 'background:#ecfdf5; color:#065f46; border-color:#a7f3d0;' : ''}">${item.status}</span>
                </td>
              `;
              tbody.appendChild(tr);
            });
            const apTotal = ap.reduce((a: number, b: any) => a + b.amount, 0);
            setEl('print-ap-foot-total', formatCents(apTotal));
          }
        }

        if (data.bank_statement?.withdrawals) {
          hydrateExpenseTable(data.bank_statement.withdrawals);
        }

        const printBtn = document.getElementById('print-action-btn') as HTMLButtonElement | null;
        if (printBtn) printBtn.removeAttribute('disabled');
      } catch (e) {
        console.error('Error loading print financials:', e);
      }
    }

    document.addEventListener('astro:page-load', initPrintView);
    if (document.readyState !== 'loading') {
      initPrintView();
    } else {
      document.addEventListener('DOMContentLoaded', initPrintView);
    }
  </script>
</body>
</html>
