---
import StaffPortalLayout from '../../../layouts/StaffPortalLayout.astro';
import StaffSubNav from '../../../components/internal/StaffSubNav.astro';
import ExecutiveBanner from '../../../components/board/ExecutiveBanner.astro';
import HeadlineKpiGrid from '../../../components/board/HeadlineKpiGrid.astro';
import MonthlyStatementTable from '../../../components/board/MonthlyStatementTable.astro';
import BankStatementViewer from '../../../components/board/BankStatementViewer.astro';
import ExpenseExplorer from '../../../components/board/ExpenseExplorer.astro';
import CheckingBalanceTrend from '../../../components/board/CheckingBalanceTrend.astro';
// Financial JSON is loaded client-side after getStaffToken() via GET /api/financials
// (YTD report + bank_statement + bank_statements + monthly_drilldown + checking_balance_history
// + donors). Do not import published_2026_ytd.json, statement_2026_08.json,
// monthly_drilldown_2026.json, checking_balance_2024_2026.json, or donor_database.json here —
// Astro SSG would bake them into public HTML.

const subNavItems = [
  { id: 'snapshot', label: 'Summary' },
  { id: 'statement',label: 'Months' },
  { id: 'expenses', label: 'Money detail' },
  { id: 'audit',    label: 'Bank' },
  { id: 'trend',    label: 'Trend' },
];
---

<StaffPortalLayout
  title="Executive Board Financial Portal | Humane Society of Monroe County"
  description="Humane Society of Monroe County Executive Board Financial Portal & Operating Statements."
  activeTab="financials"
>
  <div>

    <!-- Executive Banner -->
    <ExecutiveBanner />

    <!-- Modular Financial Sub-Navigation Bar (Sticky) -->
    <StaffSubNav items={subNavItems} ariaLabel="Financial modules subnavigation" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
      <div id="board-data-status" class="rounded-xl border border-teal-200 dark:border-teal-800/80 bg-teal-50 dark:bg-[#0b2420]/85 px-4 py-3 text-sm text-teal-950 dark:text-emerald-300 shadow-xs" role="status">
        Loading…
      </div>
    </div>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 space-y-8" id="financials-main-content">
      <!-- Section 1: Headline KPI Grid + Position/Cash + Operating Bridge -->
      <section id="sec-snapshot" class="financial-module space-y-6 scroll-mt-20" data-tab-content="snapshot">
        <HeadlineKpiGrid />
      </section>

      <!-- Section 2: Month-by-Month Operating Statement with Accordion Drawers -->
      <section id="sec-statement" class="financial-module space-y-6 scroll-mt-20 hidden" data-tab-content="statement">
        <MonthlyStatementTable />
      </section>

      <!-- Section 3: Money detail (books, not bank cash) -->
      <section id="sec-expenses" class="financial-module space-y-6 scroll-mt-20 hidden" data-tab-content="expenses">
        <ExpenseExplorer statementPeriod="Year-To-Date" />
      </section>

      <!-- Section 4: Checking account -->
      <section id="sec-audit" class="financial-module space-y-6 scroll-mt-20 hidden" data-tab-content="audit">
        <BankStatementViewer />
      </section>

      <!-- Section 5: Checking balance trend -->
      <section id="sec-trend" class="financial-module space-y-6 scroll-mt-20 hidden" data-tab-content="trend">
        <CheckingBalanceTrend />
      </section>

      <footer class="mt-8 pt-4 border-t border-slate-200 text-xs text-slate-400">
        Confidential
      </footer>
    </main>
  </div>

  <script>
    import { initBoardDashboard } from '../../../scripts/board-financials-loader';

    function runInit() {
      initBoardDashboard();
      
      const setTab = (section: string) => {
        const params = new URLSearchParams(window.location.search);
        params.set('section', section);
        window.history.replaceState({}, '', '?' + params.toString());
        
        // Update visibility of sections
        document.querySelectorAll('[data-tab-content]').forEach(el => {
          if (el.getAttribute('data-tab-content') === section) {
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        });
        
        // Update subnav styling
        document.querySelectorAll('.subnav-pill').forEach(btn => {
          if (btn.getAttribute('data-tab-id') === section) {
            btn.className = 'subnav-pill inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs whitespace-nowrap transition cursor-pointer shrink-0 border active bg-[#173a39] text-white dark:bg-emerald-500/20 dark:text-emerald-300 border-[#173a39] dark:border-emerald-500/40 shadow-xs font-bold';
            const badge = btn.querySelector('.nav-badge');
            if (badge) badge.className = 'nav-badge ml-1 px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-white/20 dark:bg-emerald-500/30 text-white dark:text-emerald-200';
          } else {
            btn.className = 'subnav-pill inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition cursor-pointer shrink-0 border bg-slate-100/90 dark:bg-teal-950/60 text-slate-700 dark:text-teal-200/90 hover:bg-slate-200 dark:hover:bg-teal-900/80 border-slate-200 dark:border-teal-800/70';
            const badge = btn.querySelector('.nav-badge');
            if (badge) badge.className = 'nav-badge ml-1 px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-slate-200 dark:bg-teal-900 text-slate-600 dark:text-teal-300';
          }
        });
      };
      
      (window as any).__setBoardSection = (section: string, noScroll?: boolean) => {
        setTab(section);
        if (!noScroll) {
          window.scrollTo({top: 0, behavior: 'smooth'});
        }
      };
      
      // Initialize tab based on URL or default
      const initialTab = new URLSearchParams(window.location.search).get('section') || 'snapshot';
      setTab(initialTab);
    }

    document.addEventListener('astro:page-load', runInit);
  </script>
</StaffPortalLayout>
