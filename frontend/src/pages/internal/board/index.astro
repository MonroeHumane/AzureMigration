---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StaffPortalNav from '../../../components/internal/StaffPortalNav.astro';
import ExecutiveBanner from '../../../components/board/ExecutiveBanner.astro';
import HeadlineKpiGrid from '../../../components/board/HeadlineKpiGrid.astro';
import OperatingBridgeCard from '../../../components/board/OperatingBridgeCard.astro';
import MonthlyStatementTable from '../../../components/board/MonthlyStatementTable.astro';
import PositionAndCashCard from '../../../components/board/PositionAndCashCard.astro';
import BankStatementViewer from '../../../components/board/BankStatementViewer.astro';
import MultiYearComparisonCard from '../../../components/board/MultiYearComparisonCard.astro';
import ScenarioSimulatorCard from '../../../components/board/ScenarioSimulatorCard.astro';
import GovernanceCard from '../../../components/board/GovernanceCard.astro';

// Fetch Directus governance items (with resilient bundled fallback)
import { getBoardMeetings, getBoardDocuments } from '../../../lib/directus';
const boardMeetings = await getBoardMeetings();
const boardDocuments = await getBoardDocuments();
---

<BaseLayout
  title="Executive Board Financial Portal | Humane Society of Monroe County"
  description="Humane Society of Monroe County Executive Board Financial Portal & Operating Statements."
  bodyClass="bg-[#f9f7f2] text-slate-800"
>
  <script is:inline data-astro-rerun>
    (function() {
      try {
        var raw = sessionStorage.getItem('directus_auth') || localStorage.getItem('directus_auth');
        var hasAuth = false;
        if (raw) {
          var parsed = JSON.parse(raw);
          if (parsed && (parsed.access_token || parsed.refresh_token)) {
            hasAuth = true;
          }
        }
        if (!hasAuth) {
          hasAuth = !!(sessionStorage.getItem('mchs_staff_auth') || localStorage.getItem('mchs_staff_auth'));
        }
        if (!hasAuth) {
          window.location.replace('/internal/?redirect=' + encodeURIComponent(window.location.pathname + window.location.search));
        }
      } catch (e) {}
    })();
  </script>
  <div class="min-h-screen pb-16">
    <!-- Staff Portal Navigation -->
    <StaffPortalNav activeTab="financials" />

    <!-- Component 1: Official Executive Banner -->
    <ExecutiveBanner />

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 space-y-8">
      <!-- Component 2: Headline KPI Grid -->
      <HeadlineKpiGrid />

      <!-- Component 3: Interactive Cash Runway & Operating Scenario Simulator -->
      <ScenarioSimulatorCard />

      <!-- Component 4: Certified Operating-to-All-In Bridge -->
      <OperatingBridgeCard />

      <!-- Component 5: Month-by-Month Operating Statement with Accordion Drawers -->
      <MonthlyStatementTable />

      <!-- Component 6: Statement of Financial Position & Restricted Watch & AP Schedule -->
      <PositionAndCashCard />

      <!-- Component 7: Bank Statement & QBO Reconciliation Viewer (Tabular & Dual PDF) -->
      <BankStatementViewer />

      <!-- Component 8: 3-Year Trajectory & Dual 2025 Disclosure -->
      <MultiYearComparisonCard />

      <!-- Component 9: Directus Board Governance, Agendas & Executive Reports -->
      <GovernanceCard
        meetings={boardMeetings}
        documents={boardDocuments}
      />

      <!-- Governance & Verification Footer -->
      <footer class="mt-12 pt-6 border-t border-slate-200 text-center text-xs text-slate-500 space-y-2">
        <p>
          Humane Society of Monroe County (HSMC) · 501(c)(3) Non-Profit Organization · Monroe, Michigan
        </p>
        <p id="footer-checksum" class="font-mono text-[11px] text-slate-400">
          Source Data Canonical Checksum: -- · Accounting System: QuickBooks Online (Accrual)
        </p>
        <p class="text-[10px] text-slate-400">
          Strictly Confidential — Protected by Microsoft Entra ID for Authorized Humane Society of Monroe County Board Members & Officers.
        </p>
      </footer>
    </main>
  </div>

  <script>
    import { initBoardDashboard } from '../../../scripts/board-financials-loader';

    document.addEventListener('astro:page-load', initBoardDashboard);
    if (document.readyState !== 'loading') {
      initBoardDashboard();
    } else {
      document.addEventListener('DOMContentLoaded', initBoardDashboard);
    }
  </script>
</BaseLayout>