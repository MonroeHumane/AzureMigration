---
import StaffPortalLayout from '../../../layouts/StaffPortalLayout.astro';
import StaffSubNav from '../../../components/internal/StaffSubNav.astro';
import ExecutiveBanner from '../../../components/board/ExecutiveBanner.astro';
import HeadlineKpiGrid from '../../../components/board/HeadlineKpiGrid.astro';
import MonthlyStatementTable from '../../../components/board/MonthlyStatementTable.astro';
import BankStatementViewer from '../../../components/board/BankStatementViewer.astro';
import ExpenseExplorer from '../../../components/board/ExpenseExplorer.astro';
// Financial JSON is loaded client-side after getStaffToken() via GET /api/financials
// (YTD report + bank_statement + bank_statements + monthly_drilldown + donors). Do not import
// published_2026_ytd.json, statement_2026_08.json, monthly_drilldown_2026.json,
// or donor_database.json here — Astro SSG would bake them into public HTML.

const subNavItems = [
  { id: 'snapshot', label: 'Summary' },
  { id: 'statement',label: 'Months' },
  { id: 'expenses', label: 'Money detail' },
  { id: 'audit',    label: 'Bank' },
];
---

<StaffPortalLayout
  title="Executive Board Financial Portal | Humane Society of Monroe County"
  description="Humane Society of Monroe County Executive Board Financial Portal & Operating Statements."
  activeTab="financials"
>
  <div>

    <!-- Executive Banner -->
    <ExecutiveBanner />

    <!-- Modular Financial Sub-Navigation Bar (Sticky) -->
    <StaffSubNav items={subNavItems} activeId="snapshot" ariaLabel="Financial modules subnavigation" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
      <div id="board-data-status" class="rounded-xl border border-teal-200 bg-teal-50 px-4 py-3 text-sm text-teal-950" role="status">
        Loading…
      </div>
    </div>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 space-y-8" id="financials-main-content">
      <!-- Section 1: Headline KPI Grid -->
      <section id="sec-snapshot" class="financial-module space-y-6 scroll-mt-20">
        <HeadlineKpiGrid />
      </section>

      <!-- Section 2: Month-by-Month Operating Statement with Accordion Drawers -->
      <section id="sec-statement" class="financial-module space-y-6 scroll-mt-20 hidden">
        <MonthlyStatementTable />
      </section>

      <!-- Section 3: Money detail (books, not bank cash) -->
      <section id="sec-expenses" class="financial-module space-y-6 scroll-mt-20 hidden">
        <ExpenseExplorer statementPeriod="All 2026" />
      </section>

      <!-- Section 4: Checking account -->
      <section id="sec-audit" class="financial-module space-y-6 scroll-mt-20 hidden">
        <BankStatementViewer />
      </section>

      <footer class="mt-8 pt-4 border-t border-slate-200 text-xs text-slate-400">
        Confidential
      </footer>
    </main>
  </div>

  <script>
    import { initBoardDashboard } from '../../../scripts/board-financials-loader';

    function initFinancialSubNav() {
      const pills = document.querySelectorAll('[data-subnav-target]');
      const sections = document.querySelectorAll('.financial-module');

      function setActiveModule(targetId: string, scroll = true) {
        const allowed = new Set(['snapshot', 'statement', 'expenses', 'audit']);
        if (targetId === 'all' || !allowed.has(targetId)) targetId = 'snapshot';

        pills.forEach((p) => {
          const isTarget = p.getAttribute('data-subnav-target') === targetId;
          if (isTarget) {
            p.classList.add('active', 'bg-[#173a39]', 'dark:bg-emerald-500/20', 'text-white', 'dark:text-emerald-300', 'border-[#173a39]', 'dark:border-emerald-500/40', 'shadow-xs', 'font-bold');
            p.classList.remove('bg-slate-100/90', 'dark:bg-teal-950/60', 'text-slate-700', 'dark:text-teal-200/90', 'border-slate-200/80', 'dark:border-teal-800/70');
          } else {
            p.classList.remove('active', 'bg-[#173a39]', 'dark:bg-emerald-500/20', 'text-white', 'dark:text-emerald-300', 'border-[#173a39]', 'dark:border-emerald-500/40', 'shadow-xs', 'font-bold');
            p.classList.add('bg-slate-100/90', 'dark:bg-teal-950/60', 'text-slate-700', 'dark:text-teal-200/90', 'border-slate-200/80', 'dark:border-teal-800/70');
          }
        });

        sections.forEach((sec) => {
          if (sec.id === `sec-${targetId}`) {
            sec.classList.remove('hidden');
            if (scroll) {
              sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          } else {
            sec.classList.add('hidden');
          }
        });
      }

      (window as any).__setBoardSection = (id: string, scroll = true) => {
        setActiveModule(id, scroll);
        const url = new URL(window.location.href);
        if (id === 'snapshot') url.searchParams.delete('section');
        else url.searchParams.set('section', id);
        window.history.replaceState({}, '', url.toString());
      };

      pills.forEach((pill) => {
        if ((pill as HTMLElement).dataset.bound === '1') return;
        (pill as HTMLElement).dataset.bound = '1';
        pill.addEventListener('click', () => {
          const target = pill.getAttribute('data-subnav-target');
          if (target) (window as any).__setBoardSection(target, true);
        });
      });

      if (!(document.body as HTMLElement).dataset.boardGotoBound) {
        (document.body as HTMLElement).dataset.boardGotoBound = '1';
        document.addEventListener('click', (event) => {
          const link = (event.target as HTMLElement | null)?.closest('[data-goto-section]');
          if (!link) return;
          const target = link.getAttribute('data-goto-section');
          if (!target) return;
          event.preventDefault();
          (window as any).__setBoardSection(target, true);
        });
      }

      const urlParams = new URLSearchParams(window.location.search);
      const initialSec = urlParams.get('section');
      if (initialSec) {
        setActiveModule(initialSec, false);
      } else if (window.location.hash === '#bank-statement-viewer') {
        setActiveModule('audit', true);
      } else {
        setActiveModule('snapshot', false);
      }
    }

    function runInit() {
      initBoardDashboard();
      initFinancialSubNav();
    }

    document.addEventListener('astro:page-load', runInit);
    if (document.readyState !== 'loading') {
      runInit();
    } else {
      document.addEventListener('DOMContentLoaded', runInit);
    }
  </script>
</StaffPortalLayout>
