---
import StaffPortalLayout from '../../../layouts/StaffPortalLayout.astro';
import StaffSubNav from '../../../components/internal/StaffSubNav.astro';
import ExecutiveBanner from '../../../components/board/ExecutiveBanner.astro';
import HeadlineKpiGrid from '../../../components/board/HeadlineKpiGrid.astro';
import OperatingBridgeCard from '../../../components/board/OperatingBridgeCard.astro';
import MonthlyStatementTable from '../../../components/board/MonthlyStatementTable.astro';
import PositionAndCashCard from '../../../components/board/PositionAndCashCard.astro';
import BankStatementViewer from '../../../components/board/BankStatementViewer.astro';
import MultiYearComparisonCard from '../../../components/board/MultiYearComparisonCard.astro';
import ScenarioSimulatorCard from '../../../components/board/ScenarioSimulatorCard.astro';
import GovernanceCard from '../../../components/board/GovernanceCard.astro';
import ExpenseExplorer from '../../../components/board/ExpenseExplorer.astro';
import financialData from '../../../data/published_2026_ytd.json';
import statementData from '../../../data/statement_2026_08.json';

// Fetch Directus governance items (with resilient bundled fallback)
import { getBoardMeetings, getBoardDocuments } from '../../../lib/directus';
const boardMeetings = await getBoardMeetings();
const boardDocuments = await getBoardDocuments();

const subNavItems = [
  { id: 'all',      label: 'All Financials',    icon: '📑' },
  { id: 'snapshot', label: 'Summary & KPIs',    icon: '📊' },
  { id: 'statement',label: 'Monthly Statement', icon: '📅' },
  { id: 'expenses', label: 'Cash Flow Explorer', icon: '🔄' },
  { id: 'balance',  label: 'Assets & Balance',  icon: '🏦' },
  { id: 'strategy', label: 'Cash Runway',       icon: '📈' },
  { id: 'audit',    label: 'Bank Statement',    icon: '🔍' },
  { id: 'governance',label: 'Governance',       icon: '🏛️' },
];
---

<StaffPortalLayout
  title="Executive Board Financial Portal | Humane Society of Monroe County"
  description="Humane Society of Monroe County Executive Board Financial Portal & Operating Statements."
  activeTab="financials"
>
  <div>

    <!-- Executive Banner -->
    <ExecutiveBanner meta={financialData.meta} />

    <!-- Modular Financial Sub-Navigation Bar (Sticky) -->
    <StaffSubNav items={subNavItems} activeId="all" ariaLabel="Financial modules subnavigation" />

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 space-y-8" id="financials-main-content">
      <!-- Section 1: Headline KPI Grid -->
      <section id="sec-snapshot" class="financial-module space-y-6 scroll-mt-20">
        <HeadlineKpiGrid kpis={financialData.headline_kpis} />
      </section>

      <!-- Section 2: Month-by-Month Operating Statement with Accordion Drawers -->
      <section id="sec-statement" class="financial-module space-y-6 scroll-mt-20">
        <MonthlyStatementTable statements={financialData.monthly_statements} />
      </section>

      <!-- Section 3: Cash Flow Explorer Drilldown (Inflows & Outflows) -->
      <section id="sec-expenses" class="financial-module space-y-6 scroll-mt-20">
        <ExpenseExplorer
          withdrawals={statementData.withdrawals}
          deposits={statementData.deposits}
          apSchedule={financialData.accounts_payable_schedule}
          statementPeriod="August 2026"
        />
      </section>

      <!-- Section 3: Statement of Financial Position & Restricted Watch -->
      <section id="sec-balance" class="financial-module space-y-6 scroll-mt-20">
        <PositionAndCashCard position={financialData.statement_of_position} />
      </section>

      <!-- Section 4: Operating Bridge & Cash Runway Scenario Simulator -->
      <section id="sec-strategy" class="financial-module space-y-6 scroll-mt-20">
        <OperatingBridgeCard
          qboOperatingNet={financialData.headline_kpis.qbo_operating_net}
          allInNet={financialData.headline_kpis.all_in_net}
          bridge={financialData.bridge_composition}
        />
        <ScenarioSimulatorCard
          operatingCash={financialData.headline_kpis.bank_register_cash}
          fidelityReserve={financialData.headline_kpis.fidelity_reserve}
          avgMonthlyRevenue={financialData.headline_kpis.qbo_operating_revenue / 8}
          avgMonthlyExpense={(financialData.headline_kpis.qbo_cogs + financialData.headline_kpis.qbo_operating_expenditures) / 8}
          allInMonthlyRevenue={financialData.headline_kpis.all_in_revenue / 8}
          allInMonthlyExpense={financialData.headline_kpis.all_in_expenditures / 8}
          cutoffDate={financialData.meta.cutoff_date}
        />
        <MultiYearComparisonCard comparison={financialData.multiyear_comparison} />
      </section>

      <!-- Section 5: Bank Statement & QBO Reconciliation Viewer (Tabular & Dual PDF) -->
      <section id="sec-audit" class="financial-module space-y-6 scroll-mt-20">
        <BankStatementViewer />
      </section>

      <!-- Section 6: Directus Board Governance, Agendas & Executive Reports -->
      <section id="sec-governance" class="financial-module space-y-6 scroll-mt-20">
        <GovernanceCard
          meetings={boardMeetings}
          documents={boardDocuments}
        />
      </section>

      <!-- Governance & Verification Footer -->
      <footer class="mt-12 pt-6 border-t border-slate-200 text-center text-xs text-slate-500 space-y-2">
        <p>
          Humane Society of Monroe County (HSMC) · 501(c)(3) Non-Profit Organization · Monroe, Michigan
        </p>
        <p class="text-[11px] text-slate-400">
          QuickBooks Online (Accrual) · Confidential Board Information
        </p>
      </footer>
    </main>
  </div>

  <script>
    import { initBoardDashboard } from '../../../scripts/board-financials-loader';

    function initFinancialSubNav() {
      const pills = document.querySelectorAll('[data-subnav-target]');
      const sections = document.querySelectorAll('.financial-module');

      function setActiveModule(targetId: string, scroll = true) {
        pills.forEach((p) => {
          const isTarget = p.getAttribute('data-subnav-target') === targetId;
          if (isTarget) {
            p.classList.add('bg-[#173a39]', 'text-white', 'shadow-xs', 'font-bold');
            p.classList.remove('bg-slate-100/90', 'text-slate-700', 'border', 'border-slate-200/80');
          } else {
            p.classList.remove('bg-[#173a39]', 'text-white', 'shadow-xs', 'font-bold');
            p.classList.add('bg-slate-100/90', 'text-slate-700', 'border', 'border-slate-200/80');
          }
        });

        if (targetId === 'all') {
          sections.forEach((sec) => sec.classList.remove('hidden'));
          if (scroll) {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        } else {
          sections.forEach((sec) => {
            if (sec.id === `sec-${targetId}`) {
              sec.classList.remove('hidden');
              if (scroll) {
                sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            } else {
              sec.classList.add('hidden');
            }
          });
        }
      }

      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const target = pill.getAttribute('data-subnav-target');
          if (target) {
            setActiveModule(target);
            const url = new URL(window.location.href);
            if (target === 'all') {
              url.searchParams.delete('section');
            } else {
              url.searchParams.set('section', target);
            }
            window.history.replaceState({}, '', url.toString());
          }
        });
      });

      // Handle initial hash or query
      const urlParams = new URLSearchParams(window.location.search);
      const initialSec = urlParams.get('section');
      if (initialSec) {
        setActiveModule(initialSec, false);
      } else if (window.location.hash === '#bank-statement-viewer') {
        setActiveModule('audit', true);
      }
    }

    function runInit() {
      initBoardDashboard();
      initFinancialSubNav();
    }

    document.addEventListener('astro:page-load', runInit);
    if (document.readyState !== 'loading') {
      runInit();
    } else {
      document.addEventListener('DOMContentLoaded', runInit);
    }
  </script>
</StaffPortalLayout>
