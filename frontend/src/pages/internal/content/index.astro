    const previewIssueLink = document.getElementById('link-preview-issue');
    const blocksContainer = document.getElementById('newsletter-blocks-container');

    function updateHeroThumb(url) {
      if (!issueHeroThumb) return;
      if (url && url.trim()) {
        issueHeroThumb.innerHTML = `<img src="${url}" class="w-full h-full object-cover" onerror="this.parentElement.innerHTML='<span class=\\'text-[9px] text-slate-400\\'>err</span>'" />`;
      } else {
        issueHeroThumb.innerHTML = '<span class="text-[9px] text-slate-400">No img</span>';
      }
    }

    issueHeroImageInput?.addEventListener('input', (e) => {
      updateHeroThumb(e.target.value);
    });

    function renderIssuesList(filter = '') {
      if (!issuesContainer) return;
      issuesContainer.innerHTML = '';
      const query = filter.toLowerCase().trim();

      appState.newsletters.forEach((iss, idx) => {
        const title = iss.title || 'Untitled Issue';
        if (query && !title.toLowerCase().includes(query)) return;

        const btn = document.createElement('button');
        btn.type = 'button';
        const isSelected = idx === selectedIssueIdx;
        btn.className = `w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-semibold transition flex items-center justify-between cursor-pointer ${
          isSelected
            ? 'bg-teal-50 border-2 border-teal-800 text-teal-950 font-bold shadow-2xs'
            : 'bg-white hover:bg-slate-50 border border-slate-200 text-slate-700'
        }`;
        
        const badge = iss.featured ? '<span class="px-2 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider bg-teal-900 text-white shrink-0">ON HOMEPAGE</span>' : '';
        btn.innerHTML = `<span class="truncate mr-2">${title}</span>${badge}`;
        btn.addEventListener('click', () => {
          selectedIssueIdx = idx;
          loadIssueForm(idx);
          renderIssuesList(searchIssuesInput?.value || '');
        });
        issuesContainer.appendChild(btn);
      });
    }

    function renderStoryBlocks(blocks = []) {
      if (!blocksContainer) return;
      blocksContainer.innerHTML = '';
      if (!blocks || blocks.length === 0) {
        blocksContainer.innerHTML = '<p class="text-xs text-slate-400 italic">No story blocks added yet.</p>';
        return;
      }

      blocks.forEach((b, bIdx) => {
        const card = document.createElement('div');
        card.className = 'p-3.5 rounded-xl bg-slate-50 border border-slate-200 space-y-2';
        card.innerHTML = `
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-bold text-slate-700 uppercase tracking-wide">Story Block #${bIdx + 1}</span>
            <button type="button" data-remove-block="${bIdx}" class="text-[10px] text-rose-600 hover:text-rose-800 font-semibold cursor-pointer">Remove</button>
          </div>
          <div>
            <input type="text" data-block-idx="${bIdx}" data-block-field="title" value="${b.title || ''}" placeholder="Story Title" class="block-title-input w-full px-2.5 py-1.5 text-xs rounded border border-slate-200 bg-white font-bold outline-none focus:border-teal-700" />
          </div>
          <div>
            <textarea data-block-idx="${bIdx}" data-block-field="body" rows="3" placeholder="Story text paragraphs..." class="block-body-input w-full px-2.5 py-1.5 text-xs rounded border border-slate-200 bg-white outline-none focus:border-teal-700">${b.body || ''}</textarea>
          </div>
        `;
        blocksContainer.appendChild(card);
      });

      blocksContainer.querySelectorAll('[data-remove-block]').forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.getAttribute('data-remove-block') || '0', 10);
          const currentIssue = appState.newsletters[selectedIssueIdx];
          if (currentIssue && currentIssue.blocks) {
            currentIssue.blocks.splice(idx, 1);
            persistState();
            renderStoryBlocks(currentIssue.blocks);
            showToast('Story block removed.');
          }
        });
      });

      // Synchronize input changes back to state
      blocksContainer.querySelectorAll('.block-title-input, .block-body-input').forEach(input => {
        input.addEventListener('input', () => {
          const bIdx = parseInt(input.getAttribute('data-block-idx') || '0', 10);
          const field = input.getAttribute('data-block-field');
          const currentIssue = appState.newsletters[selectedIssueIdx];
          if (currentIssue && currentIssue.blocks && currentIssue.blocks[bIdx]) {
            currentIssue.blocks[bIdx][field] = input.value;
          }
        });
      });
    }

    document.getElementById('btn-add-story-block')?.addEventListener('click', () => {
      const currentIssue = appState.newsletters[selectedIssueIdx];
      if (!currentIssue) return;
      if (!currentIssue.blocks) currentIssue.blocks = [];
      currentIssue.blocks.push({
        id: String(Date.now()),
        title: 'New Story Headline',
        body: 'Enter your article paragraphs here.'
      });
      persistState();
      renderStoryBlocks(currentIssue.blocks);
      showToast('New story block added.');
    });

    function loadIssueForm(idx) {
      const iss = appState.newsletters[idx];
      if (!iss) return;
      if (issueTitleInput) issueTitleInput.value = iss.title || '';
      if (issueDateInput) issueDateInput.value = iss.issue_date || '';
      if (issueToplineInput) issueToplineInput.value = iss.top_line || '';
      if (issueHeadlineInput) issueHeadlineInput.value = iss.main_headline || '';
      if (issueNewsletterTitleInput) issueNewsletterTitleInput.value = iss.newsletter_title || '';
      if (issueBylineInput) issueBylineInput.value = iss.byline || '';
      if (issueHeroImageInput) issueHeroImageInput.value = iss.hero_image || '';
      if (previewIssueLink) previewIssueLink.href = `/newsletter/issue/${iss.slug || '2025-in-review'}`;
      updateHeroThumb(iss.hero_image || '');
      renderStoryBlocks(iss.blocks || []);
    }

    function saveCurrentIssue() {
      if (!appState.newsletters[selectedIssueIdx]) return;
      appState.newsletters[selectedIssueIdx] = {
        ...appState.newsletters[selectedIssueIdx],
        title: issueTitleInput?.value || 'Untitled Issue',
        issue_date: issueDateInput?.value || '',
        top_line: issueToplineInput?.value || '',
        main_headline: issueHeadlineInput?.value || '',
        newsletter_title: issueNewsletterTitleInput?.value || '',
        byline: issueBylineInput?.value || '',
        hero_image: issueHeroImageInput?.value || ''
      };
      persistState();
      renderIssuesList(searchIssuesInput?.value || '');
      showToast('Newsletter issue updated.');
    }

    document.getElementById('btn-add-issue')?.addEventListener('click', () => {
      const newIss = {
        id: 'issue-' + Date.now(),
        title: 'New Shelter Chronicle',
        issue_date: '2026-09-01',
        slug: 'new-chronicle',
        featured: false,
        top_line: 'PO Box 1457 • Monroe, MI',
        main_headline: 'Fall Rescues & Community News',
        newsletter_title: 'Monroe Humane Society Newsletter',
        byline: 'by, Staff Team',
        hero_image: '/assets/recovered/images/monroe-humane.org/wp-content/uploads/2026/05/0dcb5211-4496-4c57-9b4a-73f5f856a667.png',
        blocks: [
          {
            id: "1",
            title: "Community Update",
