---
import StaffPortalLayout from '../../../layouts/StaffPortalLayout.astro';
import initialMemorials from '../../../data/memorial-tributes.json';
import initialFlyers from '../../../data/event-flyers.json';
import homepageData from '../../../data/homepage.json';

const initialOutcomes = homepageData.accomplishments?.years || {
  "2025": [
    { "value": 705, "display": "705", "label": "Adoptions" },
    { "value": 211, "display": "211", "label": "Return to owner", "accent": true },
    { "value": 1064, "display": "1,064", "label": "Intakes" }
  ],
  "2024": [
    { "value": 433, "display": "433", "label": "Adoptions" },
    { "value": 60, "display": "60", "label": "Return to owner", "accent": true },
    { "value": 510, "display": "510", "label": "Intakes" }
  ]
};

const initialNewsletter = [
  {
    id: "2025-in-review",
    title: "2025 in Review",
    issue_date: "2026-01-15",
    slug: "2025-in-review",
    featured: true,
    top_line: "PO Box 1457 • Monroe, MI",
    main_headline: "2025 in Review",
    newsletter_title: "Monroe Humane Society Newsletter",
    byline: "by, Jacqueline Monteer",
    hero_image: "/assets/recovered/images/monroe-humane.org/wp-content/uploads/2026/05/0dcb5211-4496-4c57-9b4a-73f5f856a667.png",
    excerpt: "A new direction, a busy shelter, and a community that showed up all year. Read how 2025 reshaped the shelter — new play yards, climate control, a medical room, and hundreds of animals finding their way home.",
    blocks: [
      {
        id: "1",
        title: "A New Direction",
        body: "After years of donations and plans for building a new shelter it was not to be. In 2023 I became president of HSMC there was debt, the Telegraph location was falling apart, very little progress on a new shelter and then covid. I spent a lot of time working with different agencies, government entities and contractors to see if we could salvage the project within a realistic budget. It was not financially prudent.\n\nThe new board took a different direction, and it has been a blessing. We have partnered with the Sheriff’s dept. We are now a vendor for the county and rent the animal control shelter building. With hard work and support of the community we have improved all aspects of shelter life for dogs and cats.\n\nWe wanted to give back to the community as much as possible with improvements to the shelter putting to work all the donations for a new shelter. These improvements are here to stay no matter what. The dogs and cats of Monroe County will benefit from the Humane Society and the generosity of this community."
      },
      {
        id: "2",
        title: "Things improved",
        body: "1. Two new fenced play yards and reconfigured fencing for safety.\n2. Installed air conditioning in the dog kennel and separate heating and cooling in the cat area.\n3. Installed commercial sink to sterilize dishes.\n4. Commercial size washer and dryer holding 5x load limit.\n5. Created a medical room for evaluations and vaccinations.\n6. Built outdoor covered kennels.\n7. Staff certified in Fear Free handling.\n8. 'Please' calm sit training.\n9. Doggie Day Out community program.\n10. Community mural painted on shelter."
      },
      {
        id: "3",
        title: "Partner Shelters & Our Cats",
        body: "In addition to these changes we trade about 4 dogs a month with partner shelters to help find perfect matches. We also take in cats left behind, owner surrenders, and provide maternity foster care for litters."
      },
      {
        id: "4",
        title: "The Cat Room 2014 Next Project",
        body: "Our next planned project is an 800 sq ft Cat Room addition with climbing community kennels, freeing space for isolation kennels and medical clinic operations."
      }
    ]
  }
];

const bundleData = {
  memorials: initialMemorials,
  flyers: initialFlyers,
  outcomes: initialOutcomes,
  newsletters: initialNewsletter
};
---

<StaffPortalLayout
  title="Website Content Manager | Humane Society of Monroe County"
  description="Directly control and update Memorial Tributes, Event Flyers, Newsletters, and Shelter Outcomes on the Monroe Humane website."
  activeTab="content"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6 space-y-6" id="content-hub-root">
    
    <!-- Top Executive Banner -->
    <section class="bg-gradient-to-r from-[#173a39] via-teal-900 to-slate-900 text-white rounded-2xl p-6 sm:p-7 shadow-md border border-teal-800/80">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
        <div class="space-y-2 max-w-3xl">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <a href="/internal/" class="text-xs text-teal-300 hover:text-white transition font-medium flex items-center gap-1">
              &larr; Executive Hub
            </a>
            <span class="text-teal-700">/</span>
            <span class="px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-500/40">
              Direct Site Management
            </span>
            <span class="text-teal-300/80 font-mono text-[11px]">
              Azure Web App v2.5
            </span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white">
            Website Content Manager
          </h1>
          <p class="text-xs sm:text-sm text-teal-100/90 leading-relaxed">
            Directly update public shelter modules without needing external developer tools. Changes persist locally for instant previewing and can be exported as clean JSON ready for site deployment.
          </p>
        </div>

        <!-- Global Actions: Download / Reset -->
        <div class="flex flex-wrap items-center gap-2.5 shrink-0">
          <input
            type="file"
            id="input-import-content-bundle"
            accept=".json,application/json"
            class="hidden"
          />
          <button
            type="button"
            id="btn-import-content-bundle"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-bold bg-teal-800 hover:bg-teal-700 text-teal-100 border border-teal-600 transition shadow-sm cursor-pointer"
            title="Import content bundle from exported JSON file"
          >
            <svg class="w-4 h-4 text-teal-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
            </svg>
            <span>Import Bundle</span>
          </button>
          <button
            type="button"
            id="btn-export-content-bundle"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-bold bg-amber-600 hover:bg-amber-500 text-white transition shadow-sm cursor-pointer"
            title="Download complete updated content bundle JSON"
          >
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
            <span>Export Content Bundle</span>
          </button>
          <button
            type="button"
            id="btn-reset-defaults"
            class="inline-flex items-center gap-1 px-3 py-2 rounded-lg text-xs font-semibold bg-teal-950/80 hover:bg-teal-900 text-teal-200 border border-teal-700/80 transition cursor-pointer"
            title="Revert to bundled repository defaults"
          >
            <span>Reset Defaults</span>
          </button>
        </div>
      </div>

      <!-- Navigation Tabs: 4 Modules Matching the Reference -->
      <div class="flex items-center gap-2 overflow-x-auto mt-6 pt-4 border-t border-teal-800/80 scrollbar-thin">
        <button
          type="button"
          data-tab-target="memorials"
          class="cms-tab-btn active inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold transition shadow-xs cursor-pointer bg-white text-teal-950"
        >
          <div class="w-5 h-5 rounded-full bg-rose-100 text-rose-700 flex items-center justify-center shrink-0">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
          </div>
          <span>Memorial Tributes</span>
        </button>

        <button
          type="button"
          data-tab-target="flyers"
          class="cms-tab-btn inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold transition shadow-xs cursor-pointer bg-teal-900/60 text-teal-200 hover:bg-teal-800 hover:text-white"
        >
          <div class="w-5 h-5 rounded-full bg-teal-800 text-teal-200 flex items-center justify-center shrink-0">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <span>Event Flyers & Calendar</span>
        </button>

        <button
          type="button"
          data-tab-target="newsletter"
          class="cms-tab-btn inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold transition shadow-xs cursor-pointer bg-teal-900/60 text-teal-200 hover:bg-teal-800 hover:text-white"
        >
          <div class="w-5 h-5 rounded-full bg-teal-800 text-teal-200 flex items-center justify-center shrink-0">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </div>
          <span>Newsletter</span>
        </button>

        <button
          type="button"
          data-tab-target="outcomes"
          class="cms-tab-btn inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold transition shadow-xs cursor-pointer bg-teal-900/60 text-teal-200 hover:bg-teal-800 hover:text-white"
        >
          <div class="w-5 h-5 rounded-full bg-teal-800 text-teal-200 flex items-center justify-center shrink-0">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          </div>
          <span>Shelter Outcomes</span>
        </button>
      </div>
    </section>

    <!-- Toast Notification Banner -->
    <div id="cms-toast" class="hidden fixed bottom-6 right-6 z-50 px-4 py-3 rounded-xl bg-slate-900 text-white text-xs font-bold shadow-2xl border border-slate-700 flex items-center gap-2.5 transition-all transform translate-y-2">
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      <span id="cms-toast-msg">Changes saved successfully.</span>
    </div>

    <!-- ===================================================================== -->
    <!-- PANE 1: MEMORIAL TRIBUTES (Screenshot 1) -->
    <!-- ===================================================================== -->
    <section id="pane-memorials" class="cms-pane space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-teal-50 border border-teal-200 text-teal-800 flex items-center justify-center shrink-0 shadow-2xs">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
            </svg>
          </div>
          <div>
            <h2 class="text-xl font-serif font-black text-slate-900">Memorial tributes</h2>
            <p class="text-xs text-slate-500">Published tributes appear on the Memorials &amp; tributes honor roll.</p>
          </div>
        </div>

        <div class="flex items-center gap-2 text-xs">
          <span id="tribute-counter" class="px-2.5 py-1 rounded-full font-mono text-[11px] font-bold bg-slate-100 text-slate-700 border border-slate-200">
            Loading tributes...
          </span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
        <!-- Left Sidebar: Add + Search + Filter Pills + List -->
        <div class="lg:col-span-4 bg-white rounded-2xl border border-slate-200 p-4 shadow-xs space-y-3">
          <button
            type="button"
            id="btn-add-tribute"
            class="w-full py-2.5 px-4 rounded-xl text-xs font-bold text-white bg-[#c2410c] hover:bg-[#9a3412] transition shadow-xs cursor-pointer flex items-center justify-center gap-1.5"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>Add tribute</span>
          </button>

          <div class="relative">
            <input
              type="text"
              id="input-search-tributes"
              placeholder="Search tributes..."
              class="w-full pl-8 pr-3 py-2 text-xs rounded-lg border border-slate-200 bg-slate-50 focus:bg-white focus:border-teal-700 outline-none text-slate-800 transition"
            />
            <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </div>

          <!-- Filter Pills -->
          <div class="flex flex-wrap gap-1 text-[10px]">
            <button type="button" data-tribute-filter="all" class="tribute-filter-btn px-2 py-0.5 rounded font-bold bg-teal-800 text-white cursor-pointer transition">All</button>
            <button type="button" data-tribute-filter="memory" class="tribute-filter-btn px-2 py-0.5 rounded font-medium bg-slate-100 text-slate-600 hover:bg-slate-200 cursor-pointer transition">In Memory</button>
            <button type="button" data-tribute-filter="honor" class="tribute-filter-btn px-2 py-0.5 rounded font-medium bg-slate-100 text-slate-600 hover:bg-slate-200 cursor-pointer transition">In Honor</button>
            <button type="button" data-tribute-filter="pet" class="tribute-filter-btn px-2 py-0.5 rounded font-medium bg-slate-100 text-slate-600 hover:bg-slate-200 cursor-pointer transition">Pets</button>
          </div>

          <div id="tributes-list-container" class="space-y-1.5 max-h-[520px] overflow-y-auto pr-1 scrollbar-thin">
            <!-- Populated via Client Script -->
          </div>
        </div>

        <!-- Right Form Panel (Screenshot 1 Detail) -->
        <div class="lg:col-span-8 bg-white rounded-2xl border border-slate-200 p-6 sm:p-7 shadow-xs space-y-6">
          <div class="border-b border-slate-100 pb-4">
            <h3 class="text-lg font-serif font-bold text-slate-900">Memorials</h3>
            <p class="text-xs text-slate-500 mt-0.5">Published tributes appear on the Memorials &amp; tributes honor roll.</p>
          </div>

          <div class="space-y-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Person's name</label>
              <input
                type="text"
                id="tribute-person-name"
                class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-teal-700 outline-none text-slate-900 transition"
                placeholder="e.g. Steven M. Murdock"
              />
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Line on plaque</label>
              <select
                id="tribute-plaque-line"
                class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-teal-700 outline-none text-slate-900 transition"
              >
                <option value="In Memory Of">In Memory Of</option>
                <option value="In Honor Of">In Honor Of</option>
                <option value="In Loving Memory Of">In Loving Memory Of</option>
                <option value="Happy Birthday">Happy Birthday</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Card style</label>
              <select
                id="tribute-card-style"
                class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-teal-700 outline-none text-slate-900 transition"
              >
                <option value="Standard (memory)">Standard (memory)</option>
                <option value="In honor">In honor</option>
                <option value="Pet Memorial">Pet Memorial</option>
                <option value="Custom">Custom</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Year (optional)</label>
              <input
                type="text"
                id="tribute-year"
                class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-teal-700 outline-none text-slate-900 transition font-mono"
                placeholder="e.g. 2026"
              />
            </div>
          </div>

          <!-- Bottom Action Buttons -->
          <div class="pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3 text-xs">
            <div class="flex items-center gap-2.5">
              <button
                type="button"
                id="btn-publish-tribute"
                class="px-5 py-2.5 rounded-xl font-bold text-white bg-[#c2410c] hover:bg-[#9a3412] transition shadow-xs cursor-pointer"
              >
                Publish
              </button>
              <button
                type="button"
                id="btn-save-tribute"
                class="px-4 py-2.5 rounded-xl font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 transition cursor-pointer"
              >
                Save
              </button>
              <a
                id="link-preview-memorial"
                href="/memorials"
                target="_blank"
                class="px-3.5 py-2 rounded-xl font-semibold text-teal-800 hover:text-teal-950 underline underline-offset-4 transition"
              >
                Preview page &rarr;
              </a>
            </div>
            <button
              type="button"
              id="btn-delete-tribute"
              class="font-semibold text-rose-700 hover:text-rose-900 transition cursor-pointer"
            >
              Move to trash
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- PANE 2: EVENT FLYERS & CALENDAR (Screenshot 2) -->
    <!-- ===================================================================== -->
    <section id="pane-flyers" class="cms-pane hidden space-y-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-teal-50 border border-teal-200 text-teal-800 flex items-center justify-center shrink-0 shadow-2xs">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
        </div>
        <div>
          <h2 class="text-xl font-serif font-black text-slate-900">Event flyers</h2>
          <p class="text-xs text-slate-500">Published flyers with an event date appear on the homepage calendar and events page.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
        <!-- Left Sidebar: Reorderable List + Add -->
        <div class="lg:col-span-4 bg-white rounded-2xl border border-slate-200 p-4 shadow-xs space-y-3">
          <button
            type="button"
            id="btn-add-flyer"
            class="w-full py-2.5 px-4 rounded-xl text-xs font-bold text-white bg-[#c2410c] hover:bg-[#9a3412] transition shadow-xs cursor-pointer flex items-center justify-center gap-1.5"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>Add flyer</span>
          </button>

          <div class="relative">
            <input
              type="text"
              id="input-search-flyers"
              placeholder="Search flyers..."
              class="w-full pl-8 pr-3 py-2 text-xs rounded-lg border border-slate-200 bg-slate-50 focus:bg-white focus:border-teal-700 outline-none text-slate-800 transition"
            />
            <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </div>

          <div id="flyers-list-container" class="space-y-1.5 max-h-[520px] overflow-y-auto pr-1 scrollbar-thin">
            <!-- Populated via Client Script with ▲/▼ reorder arrows -->
          </div>
        </div>

        <!-- Right: Dual Calendar Preview + Details Form (Screenshot 2 Detail) -->
        <div class="lg:col-span-8 space-y-5">
          
          <!-- Calendar Preview Box -->
          <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-slate-100 pb-3">
              <div>
                <h3 class="text-base font-serif font-bold text-slate-900">Event calendar preview</h3>
                <p class="text-xs text-slate-500">Click a highlighted day to edit that flyer, or any day to set the date on the form below.</p>
              </div>
              <div class="flex items-center gap-3 text-[11px] font-semibold text-slate-600 shrink-0">
                <span class="inline-flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span> Shelter event
                </span>
                <span class="inline-flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> Draft
                </span>
              </div>
            </div>

            <!-- Two-Month Grid + COMING UP Strip -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-start">
              <div class="md:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-3" id="calendar-dual-container">
                <!-- Dual calendars generated via client script -->
              </div>
              <div class="md:col-span-4 bg-slate-50 border border-slate-200/80 rounded-xl p-3.5 space-y-2">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">COMING UP</span>
                <div id="coming-up-list" class="space-y-2 text-xs">
                  <!-- Populated via script -->
                </div>
              </div>
            </div>
          </div>

          <!-- Flyer Details Form -->
          <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs space-y-5">
            <div class="border-b border-slate-100 pb-3">
              <h3 class="text-base font-serif font-bold text-slate-900">Event details</h3>
              <p class="text-xs text-slate-500">Only published flyers with an event date appear on the live site calendars.</p>
            </div>

            <div class="space-y-4 text-xs">
              <div>
