              </div>

              <!-- Flyer Image Picker with Presets -->
              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <label class="block font-semibold text-slate-700 dark:text-slate-300">Flyer image asset</label>
                  <select id="flyer-image-preset" class="text-[11px] px-2 py-1 rounded border border-slate-200 dark:border-teal-800/80 bg-slate-50 dark:bg-[#061815] text-slate-700 dark:text-slate-200 outline-none">
                    <option value="">-- Choose Common Preset --</option>
                    <option value="/assets/recovered/images/monroe-humane.org/wp-content/themes/monroe-rebuild/assets/sponsors/Applebees.png">Applebee's Logo</option>
                    <option value="/assets/recovered/images/monroe-humane.org/wp-content/themes/monroe-rebuild/assets/sponsors/s-removebg-preview.png">Mugsy's Sports Grille</option>
                    <option value="/assets/recovered/images/lirp.cdn-website.com/77cfa591/dms3rep/multi/opt/452546926_883292250498381_6921668243561390358_n-1920w.jpg">Community Event Banner</option>
                  </select>
                </div>
                <div class="flex items-center gap-3">
                  <input
                    type="text"
                    id="flyer-image"
                    class="flex-1 px-3.5 py-2 text-xs rounded-lg border border-slate-200 dark:border-teal-800/80 bg-slate-50 dark:bg-[#061815] focus:bg-white dark:focus:bg-[#08201c] focus:border-teal-700 dark:focus:border-teal-400 outline-none text-slate-900 dark:text-white font-mono transition"
                    placeholder="/assets/... or https://..."
                  />
                  <div id="flyer-thumb-preview" class="w-12 h-10 rounded border border-slate-200 dark:border-teal-800/80 bg-slate-100 dark:bg-[#061815] flex items-center justify-center shrink-0 overflow-hidden">
                    <span class="text-[9px] text-slate-400">No img</span>
                  </div>
                </div>
              </div>

              <div>
                <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Event description</label>
                <textarea
                  id="flyer-desc"
                  rows="3"
                  class="w-full px-3.5 py-2 text-xs rounded-lg border border-slate-200 dark:border-teal-800/80 bg-slate-50 dark:bg-[#061815] focus:bg-white dark:focus:bg-[#08201c] focus:border-teal-700 dark:focus:border-teal-400 outline-none text-slate-900 dark:text-white transition"
                  placeholder="Details for the event..."
                ></textarea>
              </div>
            </div>

            <!-- Action Bar -->
            <div class="pt-4 border-t border-slate-100 dark:border-teal-900/60 flex flex-wrap items-center justify-between gap-3 text-xs">
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  id="btn-publish-flyer"
                  class="px-4 py-2 rounded-lg font-bold text-white bg-[#173a39] hover:bg-[#112c2b] dark:bg-teal-700 dark:hover:bg-teal-600 transition shadow-xs cursor-pointer"
                >
                  Publish
                </button>
                <button
                  type="button"
                  id="btn-save-flyer"
                  class="px-3.5 py-2 rounded-lg font-semibold text-slate-700 dark:text-slate-200 bg-slate-100 hover:bg-slate-200 dark:bg-[#061815] dark:hover:bg-teal-950/80 border border-slate-200 dark:border-teal-800/80 transition cursor-pointer"
                >
                  Save
                </button>
                <a
                  href="/events"
                  target="_blank"
                  class="px-3 py-2 rounded-lg font-semibold text-teal-800 hover:text-teal-950 dark:text-teal-400 dark:hover:text-teal-200 underline underline-offset-4 transition"
                >
                  Preview events calendar &rarr;
                </a>
              </div>
              <button
                type="button"
                id="btn-delete-flyer"
                class="font-semibold text-rose-700 hover:text-rose-900 dark:text-rose-400 dark:hover:text-rose-300 transition cursor-pointer"
              >
                Move to trash
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- PANE 4: SHELTER OUTCOMES WIDGET (Screenshot 4) -->
    <!-- ===================================================================== -->
    <section id="pane-outcomes" class="cms-pane hidden space-y-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-teal-50 border border-teal-200 text-teal-800 dark:bg-teal-950/60 dark:border-teal-800/80 dark:text-teal-300 flex items-center justify-center shrink-0 shadow-2xs">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
          </svg>
        </div>
        <div>
          <h2 class="text-xl font-serif font-black text-slate-900 dark:text-white">Shelter outcomes</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">Counts shown on the homepage shelter outcomes widget.</p>
        </div>
      </div>

      <div class="bg-white dark:bg-[#0b2420]/85 rounded-2xl border border-slate-200 dark:border-teal-800/80 p-6 shadow-xs space-y-6">
        <div>
          <p class="text-xs text-slate-600 dark:text-slate-300">
            Counts shown on the homepage shelter outcomes widget. Add or remove years to update the public annual impact carousel.
          </p>
        </div>

        <!-- Year Cards Grid (Screenshot 4) -->
        <div id="outcomes-years-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          <!-- Populated via client script -->
        </div>

        <!-- Live Homepage Widget Preview -->
        <div class="p-5 rounded-2xl bg-gradient-to-br from-[#173a39] to-slate-900 dark:from-[#061815] dark:to-[#040e0d] text-white border border-teal-800/80 space-y-3">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold uppercase tracking-wider text-teal-300">Live Homepage Preview</span>
            <span id="preview-active-year" class="font-mono font-bold text-amber-300">Year 2025</span>
          </div>
          <div id="outcomes-live-preview" class="grid grid-cols-3 gap-3 text-center">
            <!-- Populated via client script -->
          </div>
        </div>

        <!-- Bottom Actions Bar -->
        <div class="pt-4 border-t border-slate-100 dark:border-teal-900/60 flex flex-wrap items-center gap-3 text-xs">
          <button
            type="button"
            id="btn-add-outcome-year"
            class="px-4 py-2 rounded-lg font-semibold text-slate-700 dark:text-slate-200 bg-slate-100 hover:bg-slate-200 dark:bg-[#061815] dark:hover:bg-teal-950/80 border border-slate-200 dark:border-teal-800/80 transition cursor-pointer"
          >
            Add year
          </button>
          <button
            type="button"
            id="btn-save-outcomes"
            class="px-5 py-2 rounded-lg font-bold text-white bg-[#173a39] hover:bg-[#112c2b] dark:bg-teal-700 dark:hover:bg-teal-600 transition shadow-xs cursor-pointer"
          >
            Save
          </button>
          <a
            href="/#Accomplishments"
            target="_blank"
            class="px-3 py-2 rounded-lg font-semibold text-teal-800 hover:text-teal-950 dark:text-teal-400 dark:hover:text-teal-200 underline underline-offset-4 transition"
          >
            Preview on homepage &rarr;
          </a>
        </div>
      </div>
    </section>

  </div>
</StaffPortalLayout>

<script is:inline define:vars={{ bundleData }}>
  // Direct Content Management Engine
  const STORAGE_KEY = 'mchs_site_content_v2';
  let appState = bundleData;
  let selectedTributeIdx = 0;
  let selectedFlyerIdx = 0;
  let currentTributeFilter = 'all';

  function initContentManager() {
    const hash = (window.location.hash || '').replace('#', '');
    const tab = new URLSearchParams(window.location.search).get('tab');
    if (hash === 'newsletter' || hash === 'pane-newsletter' || tab === 'newsletter') {
      window.location.replace('/internal/newsletter/');
      return;
    }

    const root = document.getElementById('content-hub-root');
    if (!root || root.dataset.cmsReady === '1') return;
    root.dataset.cmsReady = '1';

    // Load persisted state if exists
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored) {
        const parsed = JSON.parse(stored);
        appState = {
          memorials: parsed.memorials || bundleData.memorials,
          flyers: parsed.flyers || bundleData.flyers,
          outcomes: parsed.outcomes || bundleData.outcomes
        };
      }
    } catch (e) {
      console.warn('[ContentHub] Failed loading localStorage:', e);
    }

    // Toast notification
    const toast = document.getElementById('cms-toast');
    const toastMsg = document.getElementById('cms-toast-msg');
    let toastTimeout = null;

    function showToast(msg) {
      if (!toast || !toastMsg) return;
      toastMsg.textContent = msg;
      toast.classList.remove('hidden');
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.add('hidden');
      }, 3000);
    }

    // Save state to localStorage
    function persistState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
      } catch (e) {
        console.error('[ContentHub] Save error:', e);
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // TAB SWITCHING & URL HASH SYNCHRONIZATION
    // ─────────────────────────────────────────────────────────────────────────
    const tabBtns = document.querySelectorAll('.cms-tab-btn');
    const panes = document.querySelectorAll('.cms-pane');
    const validTabs = ['memorials', 'flyers', 'outcomes'];

    function switchTab(target, updateHash = true) {
      if (!validTabs.includes(target)) target = 'memorials';

      tabBtns.forEach(btn => {
        const isTarget = btn.getAttribute('data-tab-target') === target;
        btn.classList.toggle('active', isTarget);
      });

      panes.forEach(pane => {
        if (pane.id === 'pane-' + target) {
          pane.classList.remove('hidden');
        } else {
          pane.classList.add('hidden');
        }
      });

      if (updateHash && window.location.hash !== '#' + target) {
        try {
          history.replaceState(null, '', '#' + target);
        } catch (e) {
          window.location.hash = '#' + target;
        }
      }
    }

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-tab-target');
        if (target) switchTab(target, true);
      });
    });

    // Check hash on load
    const initialHash = (window.location.hash || '').replace('#', '');
    if (validTabs.includes(initialHash)) {
      switchTab(initialHash, false);
    } else {
      switchTab('memorials', false);
    }

    window.addEventListener('hashchange', () => {
      const currentHash = (window.location.hash || '').replace('#', '');
      if (currentHash === 'newsletter' || currentHash === 'pane-newsletter') {
        window.location.replace('/internal/newsletter/');
        return;
      }
      if (validTabs.includes(currentHash)) {
        switchTab(currentHash, false);
      }
    });

    // ─────────────────────────────────────────────────────────────────────────
    // 1. MEMORIAL TRIBUTES
    // ─────────────────────────────────────────────────────────────────────────
    const tributesContainer = document.getElementById('tributes-list-container');
    const tributeNameInput = document.getElementById('tribute-person-name');
    const tributeLineSelect = document.getElementById('tribute-plaque-line');
    const tributeStyleSelect = document.getElementById('tribute-card-style');
    const tributeYearInput = document.getElementById('tribute-year');
    const searchTributesInput = document.getElementById('input-search-tributes');
    const tributeCounter = document.getElementById('tribute-counter');

    function renderTributesList(filter = '') {
      if (!tributesContainer) return;
      tributesContainer.innerHTML = '';

      const query = filter.toLowerCase().trim();
      let matchCount = 0;

      appState.memorials.forEach((t, idx) => {
        const name = t.name || 'Unnamed Tribute';
        const line = (t.line || '').toLowerCase();
        const isPet = t.variant === 'pet' || /dog|cat|pup|kitten|pet/i.test(name);

        if (currentTributeFilter === 'memory' && !line.includes('memory')) return;
        if (currentTributeFilter === 'honor' && !line.includes('honor')) return;
        if (currentTributeFilter === 'pet' && !isPet) return;

        if (query && !name.toLowerCase().includes(query)) return;
        matchCount++;

        const btn = document.createElement('button');
        btn.type = 'button';
        const isSelected = idx === selectedTributeIdx;
        btn.className = `w-full text-left px-3.5 py-2 rounded-xl text-xs font-semibold transition flex items-center justify-between cursor-pointer ${
          isSelected
            ? 'bg-teal-50 border-2 border-teal-800 text-teal-950 font-bold shadow-2xs dark:bg-teal-950/80 dark:border-teal-400 dark:text-teal-100'
            : 'bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 dark:bg-[#061815] dark:hover:bg-teal-950/40 dark:border-teal-900/80 dark:text-slate-300'
        }`;
        
        const petBadge = isPet ? '<span class="text-[9px] px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 dark:bg-amber-950/80 dark:text-amber-300 dark:border dark:border-amber-800/60 font-bold mr-1.5">Pet</span>' : '';
        btn.innerHTML = `<span class="truncate flex items-center">${petBadge}${name}</span><span class="text-[10px] text-slate-400 dark:text-slate-500 font-mono shrink-0">${t.year || ''}</span>`;
        btn.addEventListener('click', () => {
          selectedTributeIdx = idx;
          loadTributeForm(idx);
          renderTributesList(searchTributesInput?.value || '');
        });
        tributesContainer.appendChild(btn);
      });

      if (tributeCounter) {
        tributeCounter.textContent = `${matchCount} tributes`;
      }
    }

    function loadTributeForm(idx) {
      const t = appState.memorials[idx];
      if (!t) return;
      if (tributeNameInput) tributeNameInput.value = t.name || '';
      if (tributeLineSelect) tributeLineSelect.value = t.line || 'In Memory Of';
      if (tributeStyleSelect) {
        if (t.variant === 'pet') tributeStyleSelect.value = 'Pet Memorial';
        else if (t.variant === 'honor') tributeStyleSelect.value = 'In honor';
        else tributeStyleSelect.value = 'Standard (memory)';
      }
      if (tributeYearInput) tributeYearInput.value = t.year || '';
    }

    function saveCurrentTribute() {
      if (!appState.memorials[selectedTributeIdx]) return;
      let variant = 'default';
      if (tributeStyleSelect?.value === 'Pet Memorial') variant = 'pet';
      else if (tributeStyleSelect?.value === 'In honor') variant = 'honor';

      appState.memorials[selectedTributeIdx] = {
        ...appState.memorials[selectedTributeIdx],
        name: tributeNameInput?.value || 'Unnamed Tribute',
        line: tributeLineSelect?.value || 'In Memory Of',
        variant: variant,
        year: tributeYearInput?.value || ''
      };
      persistState();
      renderTributesList(searchTributesInput?.value || '');
      showToast('Memorial tribute updated.');
    }

    document.getElementById('btn-add-tribute')?.addEventListener('click', () => {
      const newTribute = {
        name: 'New Honoree',
        line: 'In Memory Of',
        variant: 'default',
        year: String(new Date().getFullYear()),
        status: 'published'
      };
      appState.memorials.unshift(newTribute);
      selectedTributeIdx = 0;
      persistState();
      renderTributesList();
      loadTributeForm(0);
      tributeNameInput?.focus();
      showToast('New tribute draft created.');
    });

    document.getElementById('btn-save-tribute')?.addEventListener('click', saveCurrentTribute);
    document.getElementById('btn-publish-tribute')?.addEventListener('click', () => {
      saveCurrentTribute();
      showToast('Tribute published to live honor roll.');
    });

    document.getElementById('btn-delete-tribute')?.addEventListener('click', () => {
      if (appState.memorials.length <= 1) {
        alert('Cannot delete the last remaining tribute.');
        return;
      }
      appState.memorials.splice(selectedTributeIdx, 1);
      selectedTributeIdx = Math.max(0, selectedTributeIdx - 1);
      persistState();
      renderTributesList();
      loadTributeForm(selectedTributeIdx);
      showToast('Tribute moved to trash.');
    });

    searchTributesInput?.addEventListener('input', (e) => {
      renderTributesList(e.target.value);
    });

    document.querySelectorAll('.tribute-filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tribute-filter-btn').forEach(b => {
          b.classList.remove('bg-teal-800', 'text-white', 'dark:bg-teal-600');
          b.classList.add('bg-slate-100', 'text-slate-600', 'dark:bg-[#061815]', 'dark:text-slate-300');
        });
        btn.classList.add('bg-teal-800', 'text-white', 'dark:bg-teal-600');
        btn.classList.remove('bg-slate-100', 'text-slate-600', 'dark:bg-[#061815]', 'dark:text-slate-300');
        currentTributeFilter = btn.getAttribute('data-tribute-filter') || 'all';
        renderTributesList(searchTributesInput?.value || '');
      });
    });

    // ─────────────────────────────────────────────────────────────────────────
    // 2. EVENT FLYERS & CALENDAR
    // ─────────────────────────────────────────────────────────────────────────
    const flyersContainer = document.getElementById('flyers-list-container');
    const flyerTitleInput = document.getElementById('flyer-title');
    const flyerDateInput = document.getElementById('flyer-date');
    const flyerLinkInput = document.getElementById('flyer-link');
    const flyerImageInput = document.getElementById('flyer-image');
    const flyerPresetSelect = document.getElementById('flyer-image-preset');
    const flyerThumbPreview = document.getElementById('flyer-thumb-preview');
    const flyerDescInput = document.getElementById('flyer-desc');
    const searchFlyersInput = document.getElementById('input-search-flyers');
    const calendarDualContainer = document.getElementById('calendar-dual-container');
    const comingUpContainer = document.getElementById('coming-up-list');

    function updateFlyerThumb(url) {
      if (!flyerThumbPreview) return;
      if (url && url.trim()) {
        flyerThumbPreview.innerHTML = `<img src="${url}" class="w-full h-full object-cover" onerror="this.parentElement.innerHTML='<span class=\\'text-[9px] text-slate-400\\'>err</span>'" />`;
      } else {
        flyerThumbPreview.innerHTML = '<span class="text-[9px] text-slate-400">No img</span>';
      }
    }

    flyerPresetSelect?.addEventListener('change', () => {
      if (flyerPresetSelect.value && flyerImageInput) {
        flyerImageInput.value = flyerPresetSelect.value;
        updateFlyerThumb(flyerPresetSelect.value);
      }
    });

    flyerImageInput?.addEventListener('input', (e) => {
      updateFlyerThumb(e.target.value);
    });

    function renderFlyersList(filter = '') {
      if (!flyersContainer) return;
      flyersContainer.innerHTML = '';
      const query = filter.toLowerCase().trim();

      appState.flyers.forEach((f, idx) => {
        const title = f.title || 'Untitled Flyer';
        if (query && !title.toLowerCase().includes(query)) return;

        const row = document.createElement('div');
        const isSelected = idx === selectedFlyerIdx;
        row.className = 'flex items-center gap-1 w-full';

        // Up/Down reordering arrows
        const upBtn = document.createElement('button');
        upBtn.type = 'button';
        upBtn.className = 'p-1 rounded bg-slate-100 hover:bg-slate-200 text-slate-600 dark:bg-[#061815] dark:hover:bg-teal-950 dark:text-slate-300 dark:border dark:border-teal-900/80 text-[10px] cursor-pointer shrink-0 disabled:opacity-30';
        upBtn.innerHTML = '<svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/></svg>';
        upBtn.setAttribute('aria-label', 'Move flyer earlier');
        upBtn.disabled = idx === 0;
        upBtn.onclick = (e) => {
          e.stopPropagation();
          const temp = appState.flyers[idx - 1];
          appState.flyers[idx - 1] = appState.flyers[idx];
          appState.flyers[idx - 1] = temp;
          selectedFlyerIdx = idx - 1;
          persistState();
          renderFlyersList(searchFlyersInput?.value || '');
          renderCalendarPreview();
        };

        const downBtn = document.createElement('button');
        downBtn.type = 'button';
        downBtn.className = 'p-1 rounded bg-slate-100 hover:bg-slate-200 text-slate-600 dark:bg-[#061815] dark:hover:bg-teal-950 dark:text-slate-300 dark:border dark:border-teal-900/80 text-[10px] cursor-pointer shrink-0 disabled:opacity-30';
        downBtn.innerHTML = '<svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>';
        downBtn.setAttribute('aria-label', 'Move flyer later');
        downBtn.disabled = idx === appState.flyers.length - 1;
        downBtn.onclick = (e) => {
          e.stopPropagation();
          const temp = appState.flyers[idx + 1];
          appState.flyers[idx + 1] = appState.flyers[idx];
          appState.flyers[idx] = temp;
          selectedFlyerIdx = idx + 1;
          persistState();
          renderFlyersList(searchFlyersInput?.value || '');
          renderCalendarPreview();
        };

        // Title Pill with Operational Countdown Badge
        let countdownBadge = '';
        if (f.event_date) {
          const today = new Date();
          today.setHours(0, 0, 0, 0);
          const evDate = new Date(f.event_date + 'T00:00:00');
          const diffDays = Math.ceil((evDate.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));
          if (diffDays < 0) {
            countdownBadge = `<span class="shrink-0 px-1.5 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-500 border border-slate-200 dark:bg-[#061815] dark:text-slate-400 dark:border-teal-900/80">Past</span>`;
          } else if (diffDays === 0) {
            countdownBadge = `<span class="shrink-0 px-1.5 py-0.5 rounded text-[10px] font-bold bg-rose-100 text-rose-800 border border-rose-200 dark:bg-rose-950/80 dark:text-rose-300 dark:border-rose-800/80 animate-pulse">Today</span>`;
          } else if (diffDays === 1) {
            countdownBadge = `<span class="shrink-0 px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-200 dark:bg-amber-950/80 dark:text-amber-300 dark:border-amber-800/80">Tomorrow</span>`;
          } else if (diffDays <= 7) {
            countdownBadge = `<span class="shrink-0 px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200 dark:bg-emerald-950/80 dark:text-emerald-300 dark:border-emerald-800/80">In ${diffDays}d</span>`;
          } else {
            countdownBadge = `<span class="shrink-0 px-1.5 py-0.5 rounded text-[10px] font-medium bg-slate-100 text-slate-600 border border-slate-200 dark:bg-[#061815] dark:text-slate-400 dark:border-teal-900/80">${diffDays}d</span>`;
          }
        }

        const pill = document.createElement('button');
        pill.type = 'button';
        pill.className = `flex-1 text-left px-3 py-2 rounded-xl text-xs font-semibold transition cursor-pointer flex items-center justify-between gap-1.5 ${
          isSelected
            ? 'bg-teal-50 border-2 border-teal-800 text-teal-950 font-bold shadow-2xs dark:bg-teal-950/80 dark:border-teal-400 dark:text-teal-100'
            : 'bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 dark:bg-[#061815] dark:hover:bg-teal-950/40 dark:border-teal-900/80 dark:text-slate-300'
        }`;
        pill.innerHTML = `<span class="truncate">${title}</span>${countdownBadge}`;
        pill.onclick = () => {
          selectedFlyerIdx = idx;
          loadFlyerForm(idx);
          renderFlyersList(searchFlyersInput?.value || '');
        };

        row.appendChild(upBtn);
        row.appendChild(downBtn);
        row.appendChild(pill);
        flyersContainer.appendChild(row);
      });
    }

    function loadFlyerForm(idx) {
      const f = appState.flyers[idx];
      if (!f) return;
      if (flyerTitleInput) flyerTitleInput.value = f.title || '';
      if (flyerDateInput) flyerDateInput.value = f.event_date || '';
      if (flyerLinkInput) flyerLinkInput.value = f.link_url || '';
      if (flyerImageInput) flyerImageInput.value = f.image || '';
      if (flyerDescInput) flyerDescInput.value = f.description || '';
      updateFlyerThumb(f.image || '');
    }

    function saveCurrentFlyer() {
      if (!appState.flyers[selectedFlyerIdx]) return;
      appState.flyers[selectedFlyerIdx] = {
        ...appState.flyers[selectedFlyerIdx],
        title: flyerTitleInput?.value || 'Untitled Event',
        event_date: flyerDateInput?.value || '',
        link_url: flyerLinkInput?.value || '',
        image: flyerImageInput?.value || '',
        description: flyerDescInput?.value || ''
      };
      persistState();
      renderFlyersList(searchFlyersInput?.value || '');
      renderCalendarPreview();
      showToast('Event flyer saved.');
    }

    document.getElementById('btn-add-flyer')?.addEventListener('click', () => {
      const newFlyer = {
        id: Date.now(),
        title: 'New Community Event',
        event_date: '2026-09-26',
        description: 'Join us for fun, adoptable companions, and shelter benefits.',
        link_url: '/events',
        image: ''
      };
      appState.flyers.unshift(newFlyer);
      selectedFlyerIdx = 0;
      persistState();
      renderFlyersList();
      loadFlyerForm(0);
      renderCalendarPreview();
      flyerTitleInput?.focus();
      showToast('New flyer draft created.');
    });

    document.getElementById('btn-save-flyer')?.addEventListener('click', saveCurrentFlyer);
    document.getElementById('btn-publish-flyer')?.addEventListener('click', () => {
      saveCurrentFlyer();
      showToast('Flyer published to live site calendar!');
    });

    document.getElementById('btn-delete-flyer')?.addEventListener('click', () => {
      if (appState.flyers.length <= 1) {
        alert('Cannot delete the last remaining flyer.');
        return;
      }
      appState.flyers.splice(selectedFlyerIdx, 1);
      selectedFlyerIdx = Math.max(0, selectedFlyerIdx - 1);
      persistState();
      renderFlyersList();
      loadFlyerForm(selectedFlyerIdx);
      renderCalendarPreview();
      showToast('Flyer moved to trash.');
    });

    searchFlyersInput?.addEventListener('input', (e) => {
      renderFlyersList(e.target.value);
    });

    // Render Dual Calendar Preview (September & October 2026)
    function renderCalendarPreview() {
      if (!calendarDualContainer) return;
      calendarDualContainer.innerHTML = '';

      const months = [
        { name: 'September 2026', year: 2026, month: 8, days: 30, startDay: 2 },
        { name: 'October 2026', year: 2026, month: 9, days: 31, startDay: 4 },
      ];

      const eventDaysMap = {};
      appState.flyers.forEach((f, idx) => {
        if (f.event_date) {
          eventDaysMap[f.event_date] = idx;
        }
      });

      months.forEach(m => {
        const calBox = document.createElement('div');
        calBox.className = 'p-3 rounded-xl bg-slate-50 dark:bg-[#061815] border border-slate-200/80 dark:border-teal-900/80 text-center';
        
        let html = `<div class="font-serif font-bold text-xs text-slate-800 dark:text-white mb-2">${m.name}</div>`;
        html += `<div class="grid grid-cols-7 gap-1 text-[9px] font-bold text-slate-400 dark:text-slate-500 mb-1">
          <span>SUN</span><span>MON</span><span>TUE</span><span>WED</span><span>THU</span><span>FRI</span><span>SAT</span>
        </div><div class="grid grid-cols-7 gap-1 text-[11px]">`;

        for (let i = 0; i < m.startDay; i++) {
          html += `<div class="h-6"></div>`;
        }

        for (let d = 1; d <= m.days; d++) {
          const dateStr = `${m.year}-${String(m.month + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
          const hasEvent = eventDaysMap[dateStr] !== undefined;
          
          if (hasEvent) {
            html += `<button type="button" data-date="${dateStr}" class="cal-day-btn h-6 rounded-md bg-emerald-600 text-white font-bold hover:bg-emerald-700 transition flex items-center justify-center cursor-pointer shadow-2xs">${d}</button>`;
          } else {
            html += `<button type="button" data-date="${dateStr}" class="cal-day-btn h-6 rounded-md hover:bg-slate-200 dark:hover:bg-teal-900/60 text-slate-700 dark:text-slate-300 flex items-center justify-center cursor-pointer transition">${d}</button>`;
          }
        }
        html += `</div>`;
        calBox.innerHTML = html;
        calendarDualContainer.appendChild(calBox);
      });

      calendarDualContainer.querySelectorAll('.cal-day-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const dt = btn.getAttribute('data-date');
          if (!dt) return;
          if (eventDaysMap[dt] !== undefined) {
            selectedFlyerIdx = eventDaysMap[dt];
            loadFlyerForm(selectedFlyerIdx);
            renderFlyersList(searchFlyersInput?.value || '');
          } else if (flyerDateInput) {
            flyerDateInput.value = dt;
            showToast(`Event date set to ${dt}`);
          }
        });
      });

      if (comingUpContainer) {
        comingUpContainer.innerHTML = '';
        const upcoming = appState.flyers.filter(f => f.event_date).slice(0, 4);
        if (upcoming.length === 0) {
          comingUpContainer.innerHTML = '<p class="text-slate-400 dark:text-slate-500 text-xs">Publish flyers with an event date to see them here.</p>';
        } else {
          upcoming.forEach(f => {
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            const evDate = new Date(f.event_date + 'T00:00:00');
            const diffDays = Math.ceil((evDate.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));
            let tag = diffDays < 0 ? 'Past' : diffDays === 0 ? 'Today' : diffDays === 1 ? 'Tomorrow' : `In ${diffDays}d`;
            let tagClass = diffDays === 0 ? 'bg-rose-100 text-rose-800 border-rose-200 dark:bg-rose-950/80 dark:text-rose-300 dark:border-rose-800/80 animate-pulse' : diffDays <= 3 ? 'bg-amber-100 text-amber-900 border-amber-300 dark:bg-amber-950/80 dark:text-amber-300 dark:border-amber-800/80' : 'bg-emerald-100 text-emerald-800 border-emerald-200 dark:bg-emerald-950/80 dark:text-emerald-300 dark:border-emerald-800/80';

            const item = document.createElement('div');
            item.className = 'p-2 rounded-lg bg-white dark:bg-[#0b2420] border border-slate-200/80 dark:border-teal-900/80 flex items-start justify-between gap-2';
            item.innerHTML = `
              <div class="flex items-start gap-2 min-w-0">
                <span class="w-2 h-2 rounded-full bg-emerald-500 mt-1 shrink-0"></span>
                <div class="min-w-0">
                  <div class="font-bold text-slate-900 dark:text-white truncate">${f.title}</div>
                  <div class="text-[10px] text-slate-500 dark:text-slate-400 font-mono">${f.event_date}</div>
                </div>
              </div>
              <span class="shrink-0 px-1.5 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider border ${tagClass}">
                ${tag}
              </span>
            `;
            comingUpContainer.appendChild(item);
          });
        }
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 4. SHELTER OUTCOMES WIDGET
    // ─────────────────────────────────────────────────────────────────────────
    const outcomesContainer = document.getElementById('outcomes-years-container');
    const livePreviewContainer = document.getElementById('outcomes-live-preview');
    const livePreviewYear = document.getElementById('preview-active-year');

    function updateLivePreview(year) {
      if (!livePreviewContainer) return;
      const stats = appState.outcomes[year] || [];
      const adoptions = stats.find(s => s.label === 'Adoptions')?.display ?? '0';
      const returnOwner = stats.find(s => s.label === 'Return to owner')?.display ?? '0';
      const intakes = stats.find(s => s.label === 'Intakes')?.display ?? '0';

      if (livePreviewYear) livePreviewYear.textContent = `Year ${year}`;

      livePreviewContainer.innerHTML = `
        <div class="p-3 rounded-xl bg-white/5 border border-white/10">
          <div class="text-2xl font-black text-emerald-400 font-mono">${adoptions}</div>
          <div class="text-[11px] text-teal-200 uppercase tracking-wider mt-1">Adoptions</div>
        </div>
        <div class="p-3 rounded-xl bg-teal-800/40 border border-teal-500/50 shadow-inner">
          <div class="text-2xl font-black text-amber-300 font-mono">${returnOwner}</div>
          <div class="text-[11px] text-teal-200 uppercase tracking-wider mt-1">Return to Owner</div>
        </div>
        <div class="p-3 rounded-xl bg-white/5 border border-white/10">
          <div class="text-2xl font-black text-white font-mono">${intakes}</div>
          <div class="text-[11px] text-teal-200 uppercase tracking-wider mt-1">Intakes</div>
        </div>
      `;
    }

    function renderOutcomesCards() {
      if (!outcomesContainer) return;
      outcomesContainer.innerHTML = '';

      const years = Object.keys(appState.outcomes).sort().reverse();
      if (years[0]) updateLivePreview(years[0]);

      years.forEach(year => {
        const stats = appState.outcomes[year] || [];
        const adoptions = stats.find(s => s.label === 'Adoptions')?.value ?? 0;
        const returnOwner = stats.find(s => s.label === 'Return to owner')?.value ?? 0;
        const intakes = stats.find(s => s.label === 'Intakes')?.value ?? 0;

        const rate = intakes > 0 ? Math.round((adoptions / intakes) * 100) : 0;

        const card = document.createElement('div');
        card.className = 'p-5 rounded-2xl bg-slate-50 dark:bg-[#061815] border border-slate-200 dark:border-teal-900/80 space-y-4';
        card.innerHTML = `
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <h4 class="text-xl font-serif font-black text-slate-900 dark:text-white">${year}</h4>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300 dark:border dark:border-emerald-800/60 font-mono">${rate}% Rate</span>
            </div>
            <button type="button" data-remove-year="${year}" class="btn-remove-year text-xs font-semibold text-rose-600 hover:text-rose-800 dark:text-rose-400 dark:hover:text-rose-300 cursor-pointer transition">
              Remove year
            </button>
          </div>

          <div class="space-y-3 text-xs">
            <div>
              <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Adoptions</label>
              <input type="number" data-year="${year}" data-metric="adoptions" value="${adoptions}" class="outcome-input w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-teal-800/80 bg-white dark:bg-[#0b2420] text-slate-900 dark:text-white font-mono font-bold text-sm outline-none focus:border-teal-700 dark:focus:border-teal-400" />
            </div>

            <div>
              <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Return to owner</label>
              <input type="number" data-year="${year}" data-metric="rto" value="${returnOwner}" class="outcome-input w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-teal-800/80 bg-white dark:bg-[#0b2420] text-slate-900 dark:text-white font-mono font-bold text-sm outline-none focus:border-teal-700 dark:focus:border-teal-400" />
            </div>

            <div>
              <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Intakes</label>
              <input type="number" data-year="${year}" data-metric="intakes" value="${intakes}" class="outcome-input w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-teal-800/80 bg-white dark:bg-[#0b2420] text-slate-900 dark:text-white font-mono font-bold text-sm outline-none focus:border-teal-700 dark:focus:border-teal-400" />
            </div>
          </div>
        `;
        outcomesContainer.appendChild(card);
      });

      outcomesContainer.querySelectorAll('[data-remove-year]').forEach(btn => {
        btn.addEventListener('click', () => {
          const yr = btn.getAttribute('data-remove-year');
          if (yr && confirm(`Remove outcomes for year ${yr}?`)) {
            delete appState.outcomes[yr];
            persistState();
            renderOutcomesCards();
            showToast(`Year ${yr} removed.`);
          }
        });
      });

      // Live updates to preview box on input
      outcomesContainer.querySelectorAll('.outcome-input').forEach(input => {
        input.addEventListener('input', () => {
          const yr = input.getAttribute('data-year');
          const metric = input.getAttribute('data-metric');
          const val = parseInt(input.value || '0', 10);
          if (!yr || !appState.outcomes[yr]) return;

          const statArr = appState.outcomes[yr];
          if (metric === 'adoptions') {
            const item = statArr.find(s => s.label === 'Adoptions');
            if (item) { item.value = val; item.display = val.toLocaleString(); }
          } else if (metric === 'rto') {
            const item = statArr.find(s => s.label === 'Return to owner');
            if (item) { item.value = val; item.display = val.toLocaleString(); }
          } else if (metric === 'intakes') {
            const item = statArr.find(s => s.label === 'Intakes');
            if (item) { item.value = val; item.display = val.toLocaleString(); }
          }
          updateLivePreview(yr);
        });
      });
    }

    document.getElementById('btn-add-outcome-year')?.addEventListener('click', () => {
      const yr = prompt('Enter year to add (e.g. 2026):', String(new Date().getFullYear()));
      if (yr && !appState.outcomes[yr]) {
        appState.outcomes[yr] = [
          { value: 0, display: "0", label: "Adoptions" },
          { value: 0, display: "0", label: "Return to owner", accent: true },
          { value: 0, display: "0", label: "Intakes" }
        ];
        persistState();
        renderOutcomesCards();
        showToast(`Year ${yr} added.`);
      }
    });

    document.getElementById('btn-save-outcomes')?.addEventListener('click', () => {
      outcomesContainer?.querySelectorAll('.outcome-input').forEach(input => {
        const yr = input.getAttribute('data-year');
        const metric = input.getAttribute('data-metric');
        const val = parseInt(input.value || '0', 10);
        if (!yr || !appState.outcomes[yr]) return;

        const statArr = appState.outcomes[yr];
        if (metric === 'adoptions') {
          const item = statArr.find(s => s.label === 'Adoptions');
          if (item) { item.value = val; item.display = val.toLocaleString(); }
        } else if (metric === 'rto') {
          const item = statArr.find(s => s.label === 'Return to owner');
          if (item) { item.value = val; item.display = val.toLocaleString(); }
        } else if (metric === 'intakes') {
          const item = statArr.find(s => s.label === 'Intakes');
          if (item) { item.value = val; item.display = val.toLocaleString(); }
        }
      });
      persistState();
      showToast('Shelter outcomes saved and published to homepage.');
    });

    // ─────────────────────────────────────────────────────────────────────────
    // EXPORT & IMPORT JSON BUNDLE
    // ─────────────────────────────────────────────────────────────────────────
    document.getElementById('btn-export-content-bundle')?.addEventListener('click', () => {
      const dataStr = 'data:text/json;charset=utf-8,' + encodeURIComponent(JSON.stringify(appState, null, 2));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute('href', dataStr);
      downloadAnchor.setAttribute('download', `monroe_content_bundle_${new Date().toISOString().slice(0, 10)}.json`);
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
      showToast('Content bundle JSON exported.');
    });

    const bundleFileInput = document.getElementById('input-import-content-bundle');
    document.getElementById('btn-import-content-bundle')?.addEventListener('click', () => {
      bundleFileInput?.click();
    });

    bundleFileInput?.addEventListener('change', (e) => {
      const file = e.target?.files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (event) => {
        try {
          const content = event.target?.result;
          if (typeof content !== 'string') throw new Error('File content is empty or unreadable.');
          const parsed = JSON.parse(content);

          if (typeof parsed !== 'object' || parsed === null) {
            throw new Error('Root JSON must be an object.');
          }

          const hasValidSection = Array.isArray(parsed.memorials) ||
            Array.isArray(parsed.flyers) ||
            (parsed.outcomes && typeof parsed.outcomes === 'object');

          if (!hasValidSection) {
            throw new Error('Unrecognized bundle: file must contain memorials, flyers, or outcomes. Newsletters are stored in Directus, not this JSON file.');
          }

          appState = {
            memorials: Array.isArray(parsed.memorials) ? parsed.memorials : appState.memorials,
            flyers: Array.isArray(parsed.flyers) ? parsed.flyers : appState.flyers,
            outcomes: (parsed.outcomes && typeof parsed.outcomes === 'object') ? parsed.outcomes : appState.outcomes
          };

          persistState();

          renderTributesList();
          loadTributeForm(0);
          renderFlyersList();
          loadFlyerForm(0);
          renderCalendarPreview();
          renderOutcomesCards();

          showToast('Content bundle imported successfully.');
        } catch (err) {
          alert('Failed to import content bundle: ' + (err?.message || err));
        } finally {
          if (bundleFileInput) bundleFileInput.value = '';
        }
      };
      reader.readAsText(file);
    });

    document.getElementById('btn-reset-defaults')?.addEventListener('click', () => {
      if (confirm('Reset all content to original repository defaults? Local unsaved changes will be cleared.')) {
        localStorage.removeItem(STORAGE_KEY);
        appState = bundleData;
        renderTributesList();
        loadTributeForm(0);
        renderFlyersList();
        loadFlyerForm(0);
        renderCalendarPreview();
        renderOutcomesCards();
        showToast('Reset to default repository data.');
      }
    });

    // Initial render
    renderTributesList();
    loadTributeForm(selectedTributeIdx);
    renderFlyersList();
    loadFlyerForm(selectedFlyerIdx);
    renderCalendarPreview();
    renderOutcomesCards();
  }

  window.initMCHSContentManager = initContentManager;

  if (document.readyState !== 'loading') {
    initContentManager();
  } else {
    document.addEventListener('DOMContentLoaded', initContentManager);
  }
  document.addEventListener('astro:page-load', initContentManager);
</script>
