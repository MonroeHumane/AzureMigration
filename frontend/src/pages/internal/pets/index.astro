---
import StaffPortalLayout from '../../../layouts/StaffPortalLayout.astro';
import PetSyncPortal from '../../../components/internal/PetSyncPortal.astro';
import { getStaffPetSyncData } from '../../../lib/directus';

const petSyncData = await getStaffPetSyncData();
---

<StaffPortalLayout
  title="Shelter Animal Census & PetSync | Humane Society of Monroe County"
  description="Real-time shelter animal census, PetPoint auto-sync diagnostics, kennel card printing, and adoption roster."
  activeTab="pets"
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 space-y-6">
    <div class="flex flex-wrap items-baseline justify-between gap-3 pb-3 border-b border-teal-800/60">
      <div>
        <a href="/internal/" class="text-xs text-teal-400 hover:text-emerald-300 transition inline-flex items-center gap-1 font-medium">← Return to Hub</a>
        <h1 class="text-2xl font-bold text-white tracking-tight mt-1">Shelter Animal Census &amp; PetSync</h1>
      </div>
      <p class="text-xs text-teal-300/80">
        <span class="font-bold text-amber-300 text-sm">{petSyncData.activeCount}</span> animals currently in shelter care
      </p>
    </div>

    <!-- Embedded PetSync Portal Component with search, copy ID, and kennel card printing -->
    <section id="section-petsync-main">
      <PetSyncPortal syncData={petSyncData} />
    </section>
  </main>
</StaffPortalLayout>
