---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';
import membershipData from '../../data/membership.json';

const DONATE_URL = '/donate';
const RESOURCES_URL = '/resources';
const CONTACT_URL = '/contact';
const NEWSLETTER_URL = '/newsletter';
const ZEFFY_MEMBERSHIP_URL = membershipData.zeffyUrl || SITE.integrations.zeffy.donationForm;

const HERO_IMAGE =
  '/assets/recovered/images/lirp.cdn-website.com/77cfa591/dms3rep/multi/opt/455279975_897310779096528_8326220811243597552_n-1920w.jpg';
const SHIRT_CONTEST_IMG_1 = '/assets/contest-2026/01-connie-gotz-first-place.jpg';
const SHIRT_CONTEST_IMG_2 = '/assets/contest-2026/02-rylee-dunn-second-place.jpg';

interface MembershipTier {
  id: string;
  name: string;
  themeMoniker: string;
  annualPrice: number;
  annualDisplay: string;
  monthlyDisplay: string;
  monthlyNote: string;
  highlighted?: boolean;
  lifetime?: boolean;
  annualOnly?: boolean;
  badge?: string;
  iconSvg: string;
  perks: {
    label: string;
    isKeyBenefit?: boolean;
  }[];
  ctaText: string;
}

// Strictly true to HSMC Membership Levels 2026.xlsx
const TIERS: MembershipTier[] = [
  {
    id: 'kitty-circle',
    name: 'Kitty Circle',
    themeMoniker: 'Team Player · Kitty Clique',
    annualPrice: 60,
    annualDisplay: '$60+',
    monthlyDisplay: '$60+',
    monthlyNote: 'Annual Only',
    annualOnly: true,
    iconSvg: '<path d="M12 2a7 7 0 0 0-7 7c0 2.38 1.19 4.47 3 5.74V17a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-2.26c1.81-1.27 3-3.36 3-5.74a7 7 0 0 0-7-7z"/><path d="m9 21 3-3 3 3"/>',
    perks: [
      { label: 'Official 2026 Membership Card' },
      { label: '2026 Member T-Shirt' },
      { label: 'Member Bumper Sticker' },
      { label: 'Official HSMC Keychain' },
    ],
    ctaText: 'Coming Soon',
  },
  {
    id: 'beagle-buddies',
    name: 'Beagle Buddies',
    themeMoniker: 'All-Star Supporter',
    annualPrice: 120,
    annualDisplay: '$120+',
    monthlyDisplay: '$10',
    monthlyNote: '~$10 / month',
    iconSvg: '<circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>',
    perks: [
      { label: 'Official 2026 Membership Card' },
      { label: '2026 Member T-Shirt' },
      { label: 'Member Bumper Sticker' },
      { label: 'Official HSMC Keychain' },
      { label: '25% OFF HSMC Shelter Store', isKeyBenefit: true },
    ],
    ctaText: 'Coming Soon',
  },
  {
    id: 'spaniel-squad',
    name: 'Spaniel Squad',
    themeMoniker: 'Shelter MVP · Boxer Besties',
    annualPrice: 240,
    annualDisplay: '$240+',
    monthlyDisplay: '$20',
    monthlyNote: '~$20 / month',
    iconSvg: '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>',
    perks: [
      { label: 'Official 2026 Membership Card' },
      { label: '2026 Member T-Shirt' },
      { label: 'Member Bumper Sticker' },
      { label: 'Official HSMC Keychain' },
      { label: '50% OFF HSMC Shelter Store', isKeyBenefit: true },
    ],
    ctaText: 'Coming Soon',
  },
  {
    id: 'saint-bernard',
    name: 'The Saint Bernard Society',
    themeMoniker: 'Hall of Fame Champion',
    annualPrice: 480,
    annualDisplay: '$480+',
    monthlyDisplay: '$40',
    monthlyNote: '~$40 / month',
    highlighted: true,
    badge: '⭐ Featured Tier',
    iconSvg: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
    perks: [
      { label: 'Official 2026 Membership Card' },
      { label: '2026 Member T-Shirt' },
      { label: 'Member Bumper Sticker' },
      { label: 'Official HSMC Keychain' },
      { label: '50% OFF HSMC Shelter Store', isKeyBenefit: true },
    ],
    ctaText: 'Coming Soon',
  },
  {
    id: 'lifetime-guardian',
    name: 'Lifetime Guardian',
    themeMoniker: 'Shelter Icon · Permanent Legacy',
    annualPrice: 10000,
    annualDisplay: '$10,000+',
    monthlyDisplay: '$10,000+',
    monthlyNote: 'Overall / One-Time',
    lifetime: true,
    badge: '👑 Permanent Honor',
    iconSvg: '<path d="M6 3h12l4 6-10 13L2 9z"/>',
    perks: [
      { label: 'Name on Lobby Honor Plaque', isKeyBenefit: true },
      { label: 'Special Momento TBD', isKeyBenefit: true },
    ],
    ctaText: 'Inquire Lifetime Gift',
  },
];

const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Humane Society of Monroe County 2026 Membership Levels',
  description: 'Official annual and monthly membership tiers supporting homeless dogs and cats in Monroe County, Michigan.',
  provider: {
    '@type': 'AnimalShelter',
    name: SITE.name,
    telephone: '+1-734-243-3669',
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE.contact.address.street,
      addressLocality: SITE.contact.address.city,
      addressRegion: SITE.contact.address.state,
      postalCode: SITE.contact.address.zip,
    },
  },
  itemListElement: TIERS.map((tier, idx) => ({
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: `${tier.name} Membership`,
    },
    price: tier.annualPrice,
    priceCurrency: 'USD',
    position: idx + 1,
  })),
};
---

<BaseLayout
  title="2026 Membership Levels & Benefits | Humane Society of Monroe County"
  description="Explore the upcoming 2026 Monroe Humane Membership tiers. Official welcome kits, community-designed member shirts, and shelter store discounts."
  image={HERO_IMAGE}
  jsonLd={schemaOrg}
>
  <!-- DUAL STATE WRAPPER 1: ACTIVE MEMBERSHIP HUB -->
  <div data-membership-active class="max-w-7xl mx-auto px-3 sm:px-6 py-4 sm:py-6">

    <!-- 1. HERO HEADER: WARM MONROE SITE THEME (No dark green box / No neon green) -->
    <header class="relative rounded-3xl overflow-hidden mb-8 p-6 sm:p-8 md:p-10 bg-white/90 border border-teal-900/10 shadow-sm text-center max-w-4xl mx-auto backdrop-blur-xs">
      <!-- Ambient subtle warmth -->
      <div class="absolute -right-16 -top-16 w-60 h-60 rounded-full bg-amber-100/40 blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="absolute -left-16 -bottom-16 w-60 h-60 rounded-full bg-teal-50/60 blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="relative z-10">
        <!-- Status Pill: Warm Amber Coming Soon (Not Active Yet) -->
        <div data-membership-status-pill class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300 shadow-2xs mb-3">
          <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse" aria-hidden="true"></span>
          2026 Membership Program &bull; Coming Soon
        </div>

        <!-- Heading: Official Monroe Theme Font & Deep Teal Color -->
        <h1 id="monroe-membership-title" class="text-3xl sm:text-4xl md:text-5xl font-serif text-[#153635] mb-3 leading-tight tracking-tight">
          Join the Monroe Humane Pack
        </h1>

        <!-- Subtitle: Clean Slate/Charcoal Text -->
        <p class="text-sm sm:text-base text-gray-700 leading-relaxed font-normal mb-5 max-w-2xl mx-auto">
          We're preparing our official 2026 membership program to sustain Monroe County's homeless pets. Preview the upcoming membership tiers, exclusive member shirts, and shelter store discounts below.
        </p>

        <!-- Value Highlights: Clean Warm Cards Matching Site Theme -->
        <div class="flex flex-wrap justify-center gap-2 sm:gap-2.5 mb-6 text-xs text-teal-950 font-medium">
          <span class="inline-flex items-center gap-1.5 bg-slate-50 px-3 py-1.5 rounded-xl border border-slate-200 shadow-2xs">
            <svg class="w-3.5 h-3.5 text-teal-700 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            100% Tax-Deductible
          </span>
          <span class="inline-flex items-center gap-1.5 bg-slate-50 px-3 py-1.5 rounded-xl border border-slate-200 shadow-2xs">
            <svg class="w-3.5 h-3.5 text-teal-700 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            0% Fees via Zeffy
          </span>
          <span class="inline-flex items-center gap-1.5 bg-slate-50 px-3 py-1.5 rounded-xl border border-slate-200 shadow-2xs">
            <svg class="w-3.5 h-3.5 text-teal-700 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            2026 Member Shirt
          </span>
          <span class="inline-flex items-center gap-1.5 bg-slate-50 px-3 py-1.5 rounded-xl border border-slate-200 shadow-2xs">
            <svg class="w-3.5 h-3.5 text-teal-700 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            Shelter Store Discounts
          </span>
        </div>

        <!-- Action CTAs: Matching Nav Theme Colors (Deep Forest Teal & Warm Outline) -->
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            id="cta-hero-tiers"
            class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-6 py-3 rounded-full bg-teal-800 text-white hover:bg-teal-900 transition-all text-xs min-h-[44px] shadow-sm cursor-pointer"
            href="#tiers"
          >
            Preview 2026 Membership Levels &darr;
          </a>
          <a
            id="cta-hero-enroll"
            class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-5 py-3 rounded-full bg-white text-teal-800 border-2 border-teal-800/30 hover:bg-teal-50 transition-all text-xs min-h-[44px] cursor-pointer"
            href="#enroll"
          >
            How Enrollment Works
          </a>
          <a
            class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-5 py-3 rounded-full bg-[#ea580c] hover:bg-[#c2410c] text-white transition-all text-xs min-h-[44px] shadow-sm cursor-pointer"
            href={DONATE_URL}
          >
            Support Animals Today &rarr;
          </a>
        </div>
      </div>
    </header>

    <!-- 2. MEMBERSHIP TIERS SECTION -->
    <section id="tiers" class="mb-8 scroll-mt-20" aria-label="Membership Tiers">
      <div class="text-center max-w-2xl mx-auto mb-4">
        <h2 class="text-2xl sm:text-3xl font-serif text-[#153635] mb-1">
          2026 Membership Levels
        </h2>
        <p class="text-gray-600 text-xs sm:text-sm">
          From the foundational <em>Kitty Circle</em> to <em>The Saint Bernard Society</em> and <em>Lifetime Guardian</em>, preview the official 2026 tiers.
        </p>

        <!-- Segmented Billing Switcher -->
        <div class="inline-flex items-center gap-1 p-1 rounded-full bg-slate-100 border border-slate-200 mt-3 shadow-xs">
          <button
            type="button"
            id="btn-toggle-annual"
            class="px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all duration-200 bg-teal-800 text-white shadow-xs cursor-pointer"
            aria-pressed="true"
          >
            Annual Giving
          </button>
          <button
            type="button"
            id="btn-toggle-monthly"
            class="px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all duration-200 text-slate-600 hover:text-slate-900 cursor-pointer"
            aria-pressed="false"
          >
            Monthly Giving ($10 - $40/mo)
          </button>
        </div>
        <p id="monthly-toggle-note" class="hidden text-[11px] text-teal-700 font-medium mt-1.5">
          Showing monthly sustaining tiers. Kitty Circle is an annual-only tier.
        </p>
      </div>

      <!-- Mobile swipe hint -->
      <div class="block sm:hidden text-center text-[11px] text-gray-500 mb-2 font-medium">
        Swipe horizontally to see all tiers &rarr;
      </div>

      <!-- 5 MEMBERSHIP TIER CARDS: Desktop 5-col grid / Mobile snap horizontal scroll -->
      <div class="flex overflow-x-auto snap-x snap-mandatory gap-3 pb-3 px-1 sm:grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 sm:overflow-visible items-stretch">
        {TIERS.map((tier) => (
          <article
            class={`w-[82vw] max-w-[280px] shrink-0 snap-center sm:w-auto sm:max-w-none rounded-2xl p-4 flex flex-col justify-between transition-all duration-200 relative ${
              tier.highlighted
                ? 'bg-[#163433] text-white ring-2 ring-amber-400 shadow-lg lg:scale-[1.02] lg:z-10'
                : tier.lifetime
                ? 'bg-gradient-to-b from-[#fcf9f2] via-[#f7f0e3] to-[#f2e6d2] text-stone-900 border border-amber-300 shadow-sm'
                : 'bg-white text-teal-950 border border-teal-900/10 shadow-xs hover:border-teal-700/40 hover:shadow-md'
            }`}
            id={`tier-card-${tier.id}`}
            data-annual-only={tier.annualOnly ? '' : undefined}
          >
            {tier.badge && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap z-20">
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-gradient-to-r from-amber-400 to-amber-300 text-teal-950 shadow-xs border border-amber-200">
                  {tier.badge}
                </span>
              </div>
            )}

            <div>
              <!-- Moniker & Title -->
              <div class="flex items-start justify-between gap-2 mb-2 pt-0.5">
                <div>
                  <span class={`inline-block text-[10px] font-bold uppercase tracking-wider mb-0.5 ${
                    tier.highlighted ? 'text-amber-300' : tier.lifetime ? 'text-amber-800' : 'text-teal-700'
                  }`}>
                    {tier.themeMoniker}
                  </span>
                  <h3 class={`text-lg font-serif font-bold leading-tight ${tier.highlighted ? 'text-white' : 'text-teal-950'}`}>
                    {tier.name}
                  </h3>
                </div>
                <div class={`w-8 h-8 rounded-lg flex items-center justify-center shrink-0 border ${
                  tier.highlighted
                    ? 'bg-white/10 text-amber-300 border-white/20'
                    : tier.lifetime
                    ? 'bg-amber-200/80 text-amber-900 border-amber-300'
                    : 'bg-teal-50 text-teal-800 border-teal-200/80'
                }`}>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" set:html={tier.iconSvg} />
                </div>
              </div>

              <!-- Price Box -->
              <div class="mb-3 pb-2.5 border-b border-black/10 dark:border-white/10">
                <div class="flex items-baseline gap-1">
                  <span
                    class={`text-2xl sm:text-3xl font-serif font-extrabold tracking-tight tier-price-amount ${
                      tier.highlighted ? 'text-amber-300' : tier.lifetime ? 'text-amber-950' : 'text-teal-900'
                    }`}
                    data-annual={tier.annualDisplay}
                    data-monthly={tier.monthlyDisplay}
                  >
                    {tier.annualDisplay}
                  </span>
                  <span
                    class={`text-[11px] font-semibold tier-price-period ${
                      tier.highlighted ? 'text-teal-200' : 'text-gray-500'
                    }`}
                    data-annual={tier.lifetime ? 'overall' : '/ yr'}
                    data-monthly={tier.lifetime ? 'overall' : '/ mo'}
                  >
                    {tier.lifetime ? 'overall' : '/ yr'}
                  </span>
                </div>
                <div class="mt-1">
                  <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold tier-price-note ${
                    tier.highlighted
                      ? 'bg-amber-400/20 text-amber-200 border border-amber-400/30'
                      : tier.lifetime
                      ? 'bg-amber-200/90 text-amber-950 border border-amber-300'
                      : 'bg-teal-50 text-teal-800 border border-teal-200'
                  }`}
                  data-annual={tier.monthlyNote}
                  data-monthly={tier.lifetime ? 'Cumulative / One-Time' : (tier.annualOnly ? 'Annual Only' : `~$${tier.monthlyDisplay.replace('$', '')} / month`)}
                  >
                    {tier.monthlyNote}
                  </span>
                </div>
              </div>

              <!-- Strictly Official Perks List from Excel -->
              <div class="mb-3">
                <div class={`text-[10px] font-bold uppercase tracking-wider mb-1.5 ${
                  tier.highlighted ? 'text-teal-200' : 'text-gray-500'
                }`}>
                  Official Perks:
                </div>
                <ul class="space-y-1.5 text-xs">
                  {tier.perks.map((perk) => (
                    <li class="flex items-start gap-1.5 leading-snug">
                      <span class={`font-bold text-xs shrink-0 ${
                        tier.highlighted
                          ? 'text-amber-400'
                          : tier.lifetime
                          ? 'text-amber-700'
                          : 'text-teal-700'
                      }`}>✓</span>
                      <span class={perk.isKeyBenefit ? 'font-bold' : `${tier.highlighted ? 'text-cream-100/90' : 'text-gray-700'}`}>
                        {perk.label}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- CTA: Coming Soon state -->
            <div class="pt-2.5 border-t border-black/10 dark:border-white/10 mt-auto">
              <a
                href={tier.lifetime ? '#enroll' : `${ZEFFY_MEMBERSHIP_URL}?tier=${tier.id}`}
                target={tier.lifetime ? '_self' : '_blank'}
                rel={tier.lifetime ? '' : 'noopener noreferrer'}
                data-zeffy-membership-link={tier.lifetime ? undefined : ''}
                data-zeffy-tier={tier.lifetime ? undefined : tier.id}
                class={`w-full inline-flex items-center justify-center font-bold uppercase tracking-wider px-3 py-2.5 rounded-xl text-xs transition-all duration-200 shadow-2xs hover:shadow-sm min-h-[40px] cursor-pointer ${
                  tier.highlighted
                    ? 'bg-amber-400 text-teal-950 hover:bg-amber-300'
                    : tier.lifetime
                    ? 'bg-amber-800 text-white hover:bg-amber-900'
                    : 'bg-teal-800 text-white hover:bg-teal-900'
                }`}
              >
                {tier.ctaText} &rarr;
              </a>
              <div class="text-center mt-1">
                <span class={`text-[9px] font-medium tracking-wide ${tier.highlighted ? 'text-teal-200/80' : 'text-gray-500'}`}>
                  {tier.lifetime ? 'Permanent Lobby Plaque' : '2026 Enrollment Opening Soon'}
                </span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 3. PERKS COMPARISON (COLLAPSIBLE TO SAVE SPACE) -->
    <details class="bg-white border border-teal-900/10 rounded-2xl shadow-xs mb-8 group" id="comparison-details">
      <summary class="px-4 py-3 sm:px-6 cursor-pointer list-none flex items-center justify-between hover:bg-teal-50/40 rounded-2xl transition-colors">
        <span class="flex items-center gap-2">
          <span class="text-xs sm:text-sm font-bold text-[#153635]">Compare All 2026 Membership Perks Side-by-Side</span>
          <span class="text-[10px] font-bold uppercase tracking-wider text-teal-700 bg-teal-50 px-2 py-0.5 rounded-full border border-teal-200/80">Table</span>
        </span>
        <span class="text-xs text-teal-700 font-semibold flex items-center gap-1">
          <span class="group-open:hidden">View Table &darr;</span>
          <span class="hidden group-open:inline">Hide Table &uarr;</span>
        </span>
      </summary>

      <div class="px-4 pb-4 sm:px-6 sm:pb-6 overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[640px] text-xs">
          <thead>
            <tr class="border-b-2 border-teal-900/20 bg-teal-50/70 text-teal-950">
              <th scope="col" class="p-3 font-bold">Official Benefit</th>
              <th scope="col" class="p-3 font-bold text-center">Kitty Circle<br /><span class="font-normal text-[11px] text-gray-500">$60+</span></th>
              <th scope="col" class="p-3 font-bold text-center">Beagle Buddies<br /><span class="font-normal text-[11px] text-gray-500">$120+</span></th>
              <th scope="col" class="p-3 font-bold text-center">Spaniel Squad<br /><span class="font-normal text-[11px] text-gray-500">$240+</span></th>
              <th scope="col" class="p-3 font-bold text-center bg-teal-900 text-white rounded-t-lg">Saint Bernard<br /><span class="font-normal text-[11px] text-amber-300">$480+</span></th>
              <th scope="col" class="p-3 font-bold text-center">Lifetime<br /><span class="font-normal text-[11px] text-gray-500">$10,000+</span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-gray-700">
            <tr class="hover:bg-slate-50/80">
              <th scope="row" class="p-2.5 font-medium text-teal-950">Monthly Equivalent</th>
              <td class="p-2.5 text-center text-gray-400 font-medium">— (Annual only)</td>
              <td class="p-2.5 text-center font-semibold text-teal-800">$10/mo</td>
              <td class="p-2.5 text-center font-semibold text-teal-800">$20/mo</td>
              <td class="p-2.5 text-center font-bold text-teal-950 bg-teal-50/60">$40/mo</td>
              <td class="p-2.5 text-center font-semibold text-amber-800">Overall / One-Time</td>
            </tr>
            <tr class="hover:bg-slate-50/80">
              <th scope="row" class="p-2.5 font-medium text-teal-950">Membership Card</th>
              <td class="p-2.5 text-center text-teal-800 font-bold">✓</td>
              <td class="p-2.5 text-center text-teal-800 font-bold">✓</td>
              <td class="p-2.5 text-center text-teal-800 font-bold">✓</td>
              <td class="p-2.5 text-center text-teal-800 font-bold bg-teal-50/60">✓</td>
              <td class="p-2.5 text-center text-gray-400">—</td>
            </tr>
            <tr class="hover:bg-slate-50/80">
              <th scope="row" class="p-2.5 font-medium text-teal-950">2026 Member Shirt</th>
              <td class="p-2.5 text-center text-teal-800 font-bold">✓</td>
              <td class="p-2.5 text-center text-teal-800 font-bold">✓</td>
              <td class="p-2.5 text-center text-teal-800 font-bold">✓</td>
              <td class="p-2.5 text-center text-teal-800 font-bold bg-teal-50/60">✓</td>
              <td class="p-2.5 text-center text-gray-400">—</td>
            </tr>
            <tr class="hover:bg-slate-50/80">
              <th scope="row" class="p-2.5 font-medium text-teal-950">Member Bumper Sticker</th>
              <td class="p-2.5 text-center text-teal-800 font-bold">✓</td>
              <td class="p-2.5 text-center text-teal-800 font-bold">✓</td>
              <td class="p-2.5 text-center text-teal-800 font-bold">✓</td>
