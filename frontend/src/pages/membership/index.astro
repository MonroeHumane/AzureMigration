  <!-- Client-side Script: Vanilla JS only for View Transitions compatibility -->
  <script is:inline>
    (function () {
      function initMembershipToggle() {
        var btnAnnual = document.getElementById('btn-toggle-annual');
        var btnMonthly = document.getElementById('btn-toggle-monthly');
        var monthlyNote = document.getElementById('monthly-toggle-note');
        if (!btnAnnual || !btnMonthly) return;

        var priceElements = document.querySelectorAll('.tier-price-amount');
        var periodElements = document.querySelectorAll('.tier-price-period');
        var noteElements = document.querySelectorAll('.tier-price-note');
        var annualOnlyCards = document.querySelectorAll('[data-annual-only]');

        function setMode(isMonthly) {
          if (isMonthly) {
            btnMonthly.classList.add('bg-teal-800', 'text-white', 'shadow-xs');
            btnMonthly.classList.remove('text-slate-600');
            btnMonthly.setAttribute('aria-pressed', 'true');

            btnAnnual.classList.remove('bg-teal-800', 'text-white', 'shadow-xs');
            btnAnnual.classList.add('text-slate-600');
            btnAnnual.setAttribute('aria-pressed', 'false');

            if (monthlyNote) monthlyNote.classList.remove('hidden');

            priceElements.forEach(function (el) {
              var val = el.getAttribute('data-monthly');
              if (val) el.textContent = val;
            });
            periodElements.forEach(function (el) {
              var val = el.getAttribute('data-monthly');
              if (val) el.textContent = val;
            });
            noteElements.forEach(function (el) {
              var val = el.getAttribute('data-monthly');
              if (val) el.textContent = val;
            });

            // Hide Kitty Circle from monthly equivalent view
            annualOnlyCards.forEach(function (card) {
              card.classList.add('hidden');
            });
          } else {
            btnAnnual.classList.add('bg-teal-800', 'text-white', 'shadow-xs');
            btnAnnual.classList.remove('text-slate-600');
            btnAnnual.setAttribute('aria-pressed', 'true');

            btnMonthly.classList.remove('bg-teal-800', 'text-white', 'shadow-xs');
            btnMonthly.classList.add('text-slate-600');
            btnMonthly.setAttribute('aria-pressed', 'false');

            if (monthlyNote) monthlyNote.classList.add('hidden');

            priceElements.forEach(function (el) {
              var val = el.getAttribute('data-annual');
              if (val) el.textContent = val;
            });
            periodElements.forEach(function (el) {
              var val = el.getAttribute('data-annual');
              if (val) el.textContent = val;
            });
            noteElements.forEach(function (el) {
              var val = el.getAttribute('data-annual');
              if (val) el.textContent = val;
            });

            // Restore all tiers in annual view
            annualOnlyCards.forEach(function (card) {
              card.classList.remove('hidden');
            });
          }
        }

        btnAnnual.onclick = function () { setMode(false); };
        btnMonthly.onclick = function () { setMode(true); };
      }

      initMembershipToggle();
      document.addEventListener('astro:page-load', initMembershipToggle);
    })();
  </script>
