---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerShell from '../../components/InnerShell.astro';
import tributesData from '../../data/memorial-tributes.json';

interface Tribute {
  variant: 'default' | 'honor' | 'birthday';
  line: string;
  name: string;
  year?: string;
}

const rawTributes = tributesData as Tribute[];
const tributes = rawTributes.filter((tribute, index, self) =>
  index === self.findIndex((t) => (
    t.name === tribute.name && t.variant === tribute.variant
  ))
);

const SECTIONS = [
  {
    key: 'memory',
    variant: 'default',
    title: 'In memory',
    sub: 'Gifts given in remembrance of someone dearly loved.',
    id: 'monroe-tribute-memory-heading',
  },
  {
    key: 'honor',
    variant: 'honor',
    title: 'In honor',
    sub: 'Celebrating people and pets who are still with us.',
    id: 'monroe-tribute-honor-heading',
  },
  {
    key: 'birthday',
    variant: 'birthday',
    title: 'Birthday tributes',
    sub: 'Gifts made to mark a special day.',
    id: 'monroe-tribute-birthday-heading',
  },
] as const;

const sections = SECTIONS.map((s) => ({
  ...s,
  items: tributes.filter((t) => t.variant === s.variant).sort((a, b) => a.name.localeCompare(b.name)),
}));

const BETTERUNITE_MEMORIAL = 'https://app.betterunite.com/adopthsmc-donationsforhumanesocietyofmonroecounty';
---

<BaseLayout
  title="Memorials & Tributes | 734-243-3669"
  description="We are deeply grateful for the generous support of our community. The following gifts were made to honor those special people."
>
  <InnerShell variant="memorials">
    <header class="monroe-native-hero">
      <p class="monroe-native-eyebrow">We remember &amp; thank you</p>
      <h1>Memorials &amp; Tributes</h1>
      <p class="monroe-native-lead">
        We are deeply grateful for the generous support of our community. The following gifts were made to the Humane Society of Monroe County to honor those special people.
      </p>
      <div class="monroe-native-actions">
        <a class="monroe-btn" href={BETTERUNITE_MEMORIAL} target="_blank" rel="noopener noreferrer">Donate online</a>
        <a class="monroe-btn monroe-btn--outline" href="/memorials/give">Memorial &amp; planned giving</a>
      </div>
    </header>

    {sections.filter((s) => s.items.length > 0).map((section) => (
      <section class="monroe-native-stack" aria-labelledby={section.id}>
        <h2 id={section.id}>{section.title}</h2>
        <p>{section.sub}</p>
        <ul style="list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; margin-top: 2rem;">
          {section.items.map((item) => (
            <li style="padding: 1rem; border: 1px solid rgba(15, 118, 110, 0.2); border-radius: 8px; background: rgba(255, 255, 255, 0.5);">
              <strong>{item.name}</strong>
              {item.line !== item.name && <div style="font-size: 0.9em; color: #475569; margin-top: 0.25rem;">{item.line}</div>}
              {item.year && <div style="font-size: 0.85em; color: #64748b; margin-top: 0.25rem;">{item.year}</div>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </InnerShell>
</BaseLayout>
