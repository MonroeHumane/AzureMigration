---
// @ts-nocheck
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allMemorials = await getCollection('memorials');
const DONATE_URL = '/donate';

const tributes = allMemorials
  .filter((m) => m.data.draft !== true)
  .sort((a, b) => {
    const lastNameA = (a.data.lastName || '').toLowerCase();
    const lastNameB = (b.data.lastName || '').toLowerCase();
    if (lastNameA !== lastNameB) return lastNameA.localeCompare(lastNameB);
    const firstNameA = (a.data.firstName || '').toLowerCase();
    const firstNameB = (b.data.firstName || '').toLowerCase();
    return firstNameA.localeCompare(firstNameB);
  });

function getTributeGroup(tribute) {
  const t = tribute.data.tributeType?.trim().toLowerCase();
  if (!t) return 'person';
  if (t === 'person') return 'person';
  if (t === 'pet') return 'pet';
  return 'person';
}

function getInitial(tribute) {
  const lastName = (tribute.data.lastName || '').trim();
  if (lastName.length > 0) return lastName[0].toUpperCase();
  const firstName = (tribute.data.firstName || '').trim();
  if (firstName.length > 0) return firstName[0].toUpperCase();
  return '#';
}

function processTributes(list) {
  let currentLetter = '';
  return list.map((t) => {
    const letter = getInitial(t);
    const showLetter = letter !== currentLetter;
    if (showLetter) currentLetter = letter;
    
    const name = [t.data.firstName, t.data.lastName].filter(Boolean).join(' ');
    let line = 'In memory of ' + name;
    if (t.data.donorName) {
      line += ' â€“ Gift by ' + t.data.donorName;
    }
    
    return {
      tribute: t,
      letter,
      showLetter,
      name,
      line,
    };
  });
}

const peopleTributes = processTributes(tributes.filter(t => getTributeGroup(t) === 'person'));
const petTributes = processTributes(tributes.filter(t => getTributeGroup(t) === 'pet'));

const sections = [
  {
    id: 'people',
    title: 'People',
    sub: 'Honoring friends, family, and community members.',
    color: 'emerald',
    iconClass: 'bg-emerald-50 text-emerald-700 border-emerald-100',
    markIcon: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2|M8 7a4 4 0 1 0 0-8 4 4 0 0 0 0 8z|M20 8v6|M23 11h-6',
    items: peopleTributes,
  },
  {
    id: 'pets',
    title: 'Pets',
    sub: 'Remembering our beloved animal companions.',
    color: 'amber',
    iconClass: 'bg-amber-50 text-amber-700 border-amber-100',
    markIcon: 'M12 5c.67 0 1.35.09 2 .26 1.78-2 5.03-2.84 6.42-2.26 1.4.58-.42 7-.42 7A8.96 8.96 0 0 1 21 16a9 9 0 0 1-9 9 9 9 0 0 1-9-9c0-2.82 1.3-5.35 3.33-7-.27-1.5-.7-5.06.42-6.26C8.27 1.54 10.74 3.75 12 5z',
    items: petTributes,
  }
];

const totalTributes = peopleTributes.length + petTributes.length;
---

<BaseLayout
  title="Memorials | 734-243-3669"
  description="Honor a person or pet by making a memorial or tribute donation to Monroe Humane."
>
  <div class="pb-24 px-4 max-w-7xl mx-auto" data-tribute-root>
    <header class="mb-20 text-center max-w-3xl mx-auto" aria-labelledby="monroe-tribute-title">
      <p class="text-emerald-500 font-bold uppercase tracking-widest text-sm mb-4">Honors &amp; Memorials</p>
      <h1 id="monroe-tribute-title" class="text-5xl md:text-6xl font-serif text-teal-900 mb-6">Tribute Board</h1>
      <p class="text-xl text-gray-600 mb-10 leading-relaxed">
        We gratefully acknowledge the following gifts made to the Humane Society of Monroe County in honor or memory of a special person or pet.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-6 py-3 rounded-full transition-all bg-emerald-500 text-teal-900 hover:bg-emerald-400 hover:-translate-y-1" href={DONATE_URL}>
          Make a tribute gift
        </a>
      </div>
    </header>

    <div class="bg-gray-50 border border-gray-200 rounded-3xl p-6 md:p-8 mb-16 shadow-sm sticky top-24 z-30 backdrop-blur-md bg-opacity-90">
      <div class="flex flex-col md:flex-row gap-6 items-center justify-between mb-8">
        <div class="w-full md:w-96">
          <label for="monroe-tribute-search" class="sr-only">Search tributes</label>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            </span>
            <input 
              type="search" 
              id="monroe-tribute-search" 
              class="w-full pl-11 pr-4 py-3 bg-white border border-gray-300 rounded-xl focus:ring-2 focus:ring-teal-700 focus:border-teal-700 outline-none transition-shadow" 
              placeholder="Search names..." 
              data-tribute-search
            >
          </div>
        </div>
        
        <div class="flex gap-2">
          {sections.filter((s) => s.items.length > 0).map((section) => (
            <a 
              href={`#${section.id}`}
              class="px-5 py-2.5 rounded-full bg-white border border-gray-200 text-teal-800 font-bold text-sm tracking-wide uppercase hover:bg-teal-50 hover:border-teal-200 transition-colors"
            >
              {section.title}
            </a>
          ))}
        </div>
      </div>

      <div class="flex flex-wrap gap-2 justify-center" aria-label="Alphabet navigation">
        {'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').map((letter) => (
          <button 
            type="button"
            class="w-8 h-8 flex items-center justify-center rounded-lg text-sm font-bold text-gray-500 hover:bg-teal-100 hover:text-teal-900 transition-colors disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-gray-500 disabled:cursor-not-allowed"
            data-tribute-letter-btn={letter}
            aria-label={`Jump to ${letter}`}
          >
            {letter}
          </button>
        ))}
      </div>
    </div>

    {sections.filter((s) => s.items.length > 0).map((section) => (
      <section class="mb-20 scroll-mt-48" data-tribute-section aria-labelledby={section.id}>
        <div class="flex items-center gap-4 mb-12">
          <span class={`w-14 h-14 rounded-2xl flex items-center justify-center ${section.iconClass} border`} aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              {section.markIcon.split('|').map((d) => <path d={d}></path>)}
            </svg>
          </span>
          <div>
            <h2 class="text-3xl font-serif text-teal-900 mb-1" id={section.id}>{section.title}</h2>
            <p class="text-gray-600">{section.sub}</p>
          </div>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-6 gap-y-10" role="list">
          {section.items.map((item) => (
            <div class="contents">
              {item.showLetter && (
                <div class="col-span-full flex items-center gap-4 mt-8 mb-4 scroll-mt-52" id={`monroe-tribute-letter-${item.letter}`} data-tribute-letter={item.letter} aria-hidden="true">
                  <span class="text-4xl font-serif text-teal-900/20">{item.letter}</span>
                  <span class="flex-1 h-px bg-gray-200"></span>
                </div>
              )}
              <article
                class="relative overflow-hidden bg-white border border-gray-200 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow flex flex-col group"
                role="listitem"
                data-tribute-plaque
                data-tribute-name={item.name.toLowerCase()}
                aria-label={item.line}
              >
                <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-emerald-400 to-teal-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                <h3 class="text-xl font-serif text-teal-900 mb-1">{item.name}</h3>
                
                {item.tribute.data.donorName && (
                  <p class="text-sm text-gray-500 mb-4 font-medium uppercase tracking-wider">
                    Gift by {item.tribute.data.donorName}
                  </p>
                )}
                
                {item.tribute.body && (
                  <div class="mt-auto pt-4 border-t border-gray-100">
                    <p class="text-gray-600 italic text-sm leading-relaxed relative">
                      <span class="absolute -top-2 -left-2 text-3xl text-teal-100 font-serif leading-none" aria-hidden="true">"</span>
                      <span class="relative z-10">{item.tribute.body}</span>
                    </p>
                  </div>
                )}
              </article>
            </div>
          ))}
        </div>
        
        <div class="hidden text-center py-12 text-gray-500" data-tribute-empty>
          No names found in this section matching your search.
        </div>
      </section>
    ))}

    <div class="hidden text-center py-20 bg-gray-50 rounded-3xl border border-gray-200" data-tribute-global-empty>
      <span class="text-4xl mb-4 block" aria-hidden="true">ðŸ•Šï¸</span>
      <h3 class="text-2xl font-serif text-teal-900 mb-2">No tributes found</h3>
      <p class="text-gray-600">Try adjusting your search term.</p>
      <button type="button" class="mt-6 text-emerald-600 font-bold uppercase tracking-wider text-sm hover:text-emerald-800 underline underline-offset-4" data-tribute-clear-search>Clear search</button>
    </div>

  </div>
</BaseLayout>

<script>
// @ts-nocheck
  function initTributes() {
    const root = document.querySelector('[data-tribute-root]');
    if (!root) return;

    const searchInput = root.querySelector('[data-tribute-search]');
    const clearBtn = root.querySelector('[data-tribute-clear-search]');
    const sections = Array.from(root.querySelectorAll('[data-tribute-section]'));
    const allPlaques = Array.from(root.querySelectorAll('[data-tribute-plaque]'));
    const allLetters = Array.from(root.querySelectorAll('[data-tribute-letter]'));
    const globalEmpty = root.querySelector('[data-tribute-global-empty]');
    const letterBtns = Array.from(root.querySelectorAll('[data-tribute-letter-btn]'));

    // Init letter buttons state
    const availableLetters = new Set(allLetters.map(el => el.getAttribute('data-tribute-letter')));
    letterBtns.forEach(btn => {
      const l = btn.getAttribute('data-tribute-letter-btn');
      if (!availableLetters.has(l)) {
        btn.setAttribute('disabled', 'true');
      } else {
        btn.addEventListener('click', () => {
          const target = document.getElementById(`monroe-tribute-letter-${l}`);
          if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
          }
        });
      }
    });

    function filterTributes(term) {
      const query = term.toLowerCase().trim();
      let totalVisible = 0;

      sections.forEach(section => {
        const plaques = Array.from(section.querySelectorAll('[data-tribute-plaque]'));
        const letters = Array.from(section.querySelectorAll('[data-tribute-letter]'));
        const emptyMsg = section.querySelector('[data-tribute-empty]');
        let sectionVisible = 0;
        
        // Reset letters visibility first
        const letterVisibility = new Map();

        plaques.forEach(plaque => {
          const name = plaque.getAttribute('data-tribute-name') || '';
          const match = !query || name.includes(query);
          
          if (match) {
            plaque.style.display = '';
            sectionVisible++;
            
            // Find preceding letter for this plaque to mark it visible
            let prev = plaque.parentElement.previousElementSibling;
            while(prev) {
               const letterEl = prev.querySelector('[data-tribute-letter]') || prev.closest('[data-tribute-letter]');
               if (letterEl) {
                  letterVisibility.set(letterEl, true);
                  break;
               }
               prev = prev.previousElementSibling;
            }
          } else {
            plaque.style.display = 'none';
          }
        });

        // Hide/show letters based on children
        letters.forEach(letter => {
           if (letterVisibility.get(letter) || !query) {
               letter.parentElement.style.display = '';
           } else {
               letter.parentElement.style.display = 'none';
           }
        });

        if (sectionVisible === 0 && plaques.length > 0) {
          emptyMsg.classList.remove('hidden');
        } else {
          emptyMsg.classList.add('hidden');
        }

        totalVisible += sectionVisible;
      });

      if (totalVisible === 0) {
        sections.forEach(s => s.classList.add('hidden'));
        globalEmpty.classList.remove('hidden');
      } else {
        sections.forEach(s => s.classList.remove('hidden'));
        globalEmpty.classList.add('hidden');
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => filterTributes(e.target.value));
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          filterTributes('');
        }
      });
    }
  }

  document.addEventListener('astro:page-load', initTributes);
  if (!document.startViewTransition) initTributes();
</script>