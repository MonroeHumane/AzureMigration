---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerShell from '../../components/InnerShell.astro';
---

<BaseLayout
  title="Memorials & Planned Giving | 734-243-3669"
  description="Leave a lasting legacy for the animals of Monroe County through memorials, tributes, and planned giving."
>
  <InnerShell variant="memorials">
    <header class="monroe-native-hero">
      <p class="monroe-native-eyebrow">Leave a Legacy</p>
      <h1>Memorials &amp; Planned Giving</h1>
      <p class="monroe-native-lead">
        Your legacy can provide a safe haven for future generations of animals. Learn how to include the Humane Society of Monroe County in your will, or honor a loved one today.
      </p>
      <div class="monroe-native-actions">
        <a class="monroe-btn" href="https://app.betterunite.com/adopthsmc-donationsforhumanesocietyofmonroecounty" target="_blank" rel="noopener noreferrer">Give in memory or honor</a>
        <a class="monroe-btn monroe-btn--outline" href="/memorials">View the honor roll</a>
      </div>
    </header>

    <section class="monroe-native-stack" aria-labelledby="planned-giving-heading">
      <h2 id="planned-giving-heading">Planned Giving</h2>
      <p>
        By including the Humane Society of Monroe County in your estate plans, you ensure that our work continues for years to come. Planned gifts of all sizes are deeply appreciated.
      </p>
      
      <div style="display: grid; gap: 1.5rem; margin-top: 1.5rem;">
        <div style="padding: 1.5rem; background: #fff; border: 1px solid rgba(15, 118, 110, 0.2); border-radius: 8px;">
          <h3 style="margin-top: 0;">Bequests</h3>
          <p style="margin-bottom: 0;">You can designate a specific dollar amount or a percentage of your estate to the Humane Society of Monroe County in your will or living trust.</p>
        </div>
        
        <div style="padding: 1.5rem; background: #fff; border: 1px solid rgba(15, 118, 110, 0.2); border-radius: 8px;">
          <h3 style="margin-top: 0;">Beneficiary Designations</h3>
          <p style="margin-bottom: 0;">Name HSMC as a beneficiary of your retirement plan, life insurance policy, or bank account. This is often as simple as filling out a form with your provider.</p>
        </div>
        
        <div style="padding: 1.5rem; background: #fff; border: 1px solid rgba(15, 118, 110, 0.2); border-radius: 8px;">
          <h3 style="margin-top: 0;">Stock &amp; Donor Advised Funds</h3>
          <p style="margin-bottom: 0;">We accept gifts of appreciated securities and grants from donor-advised funds. Contact us for our routing instructions.</p>
        </div>
      </div>
      
      <div style="margin-top: 2rem; padding: 2rem; background: rgba(15, 118, 110, 0.05); border-radius: 8px; text-align: center;">
        <h3 style="margin-top: 0;">Ready to discuss your legacy?</h3>
        <p>Please contact our team to learn more about planned giving options or to let us know you have included us in your plans.</p>
        <a href="/contact" class="monroe-btn" style="margin-top: 1rem;">Contact us</a>
      </div>
    </section>
  </InnerShell>
</BaseLayout>
