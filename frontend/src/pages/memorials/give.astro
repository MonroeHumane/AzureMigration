---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';
import { getMemorialTributes } from '../../lib/directus';

const LINE_LABELS: Record<string, string> = {
  in_memory_of: 'In Memory Of',
  in_honor_of: 'In Honor Of',
  happy_birthday: 'Happy Birthday',
};
const lineLabel = (key: string) =>
  LINE_LABELS[key] ?? key.replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const recentTributes = (await getMemorialTributes())
  .filter((t) => (t.variant || 'default') === 'default')
  .slice(0, 3)
  .map((t) => ({ name: t.title, line: lineLabel(t.line_key) }));

const MEMORIAL_GIVING_URL = SITE.integrations.betterUnite.memorialGiving;
const MEMORIAL_EMAIL = 'jackie@monroe-humane.org';
---

<BaseLayout
  title="Memorials & Planned Giving | 734-243-3669"
  description="Leave a lasting legacy for the animals of Monroe County through memorials, tributes, and planned giving."
>
  <div class="pb-16 px-4 max-w-5xl mx-auto space-y-12 sm:space-y-16 lg:space-y-20">
    <!-- Hero Section -->
    <section class="flex flex-col lg:flex-row gap-8 lg:gap-12 lg:items-center bg-teal-900 rounded-3xl sm:rounded-[2.5rem] p-6 sm:p-10 lg:p-14 text-cream relative overflow-hidden" aria-labelledby="monroe-memorials-title">
      <div class="flex-1 relative z-10">
        <p class="text-emerald-300 font-bold uppercase tracking-widest text-sm mb-4">A gift that carries love forward</p>
        <h1 id="monroe-memorials-title" class="text-3xl sm:text-4xl lg:text-5xl font-serif text-white mb-4 sm:mb-6">Memorials &amp; planned giving</h1>
        <p class="text-base sm:text-xl text-teal-50 mb-8 sm:mb-10 leading-relaxed max-w-xl">
          Celebrate someone who loved animals with a gift that provides food, medical care, and a safe place for pets waiting for home.
        </p>

        <div class="flex flex-col sm:flex-row flex-wrap gap-3 sm:gap-4 mb-8">
          <a class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-7 py-4 rounded-full bg-emerald-500 text-teal-900 font-bold uppercase tracking-wider transition-all hover:bg-emerald-400 hover:-translate-y-1 shadow-lg min-h-[48px]" href={MEMORIAL_GIVING_URL} target="_blank" rel="noopener noreferrer">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"></path></svg>
            Make a memorial gift
          </a>
          <a class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-7 py-4 rounded-full border-2 border-teal-600 text-white font-bold uppercase tracking-wider transition-all hover:bg-teal-800 hover:-translate-y-1 min-h-[48px]" href="/memorials">
            Visit the honor roll
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"></path></svg>
          </a>
        </div>

        <p class="flex items-center gap-2 text-teal-200 text-sm">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
          We send acknowledgment letters to the family and the donor.
        </p>
      </div>

      <div class="hidden lg:flex w-64 h-64 shrink-0 items-center justify-center text-teal-800 relative z-10" aria-hidden="true">
        <svg class="w-full h-full" viewBox="0 0 280 260" fill="none">
          <path d="M140 226C99 190 39 149 39 88c0-34 25-58 57-58 20 0 36 10 44 25 8-15 24-25 44-25 32 0 57 24 57 58 0 61-60 102-101 138Z" fill="currentColor" opacity=".2"></path>
          <path d="M140 226C99 190 39 149 39 88c0-34 25-58 57-58 20 0 36 10 44 25 8-15 24-25 44-25 32 0 57 24 57 58 0 61-60 102-101 138Z" stroke="currentColor" stroke-width="4"></path>
          <g fill="currentColor">
            <ellipse cx="105" cy="99" rx="13" ry="18" transform="rotate(-25 105 99)"></ellipse>
            <ellipse cx="131" cy="82" rx="13" ry="18" transform="rotate(-8 131 82)"></ellipse>
            <ellipse cx="159" cy="82" rx="13" ry="18" transform="rotate(8 159 82)"></ellipse>
            <ellipse cx="184" cy="100" rx="13" ry="18" transform="rotate(25 184 100)"></ellipse>
            <path d="M145 112c-28 0-47 23-47 47 0 15 10 26 24 26 9 0 16-5 23-5s14 5 23 5c14 0 24-11 24-26 0-24-19-47-47-47Z"></path>
          </g>
        </svg>
      </div>
      <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-white rounded-full mix-blend-overlay opacity-5 -translate-y-1/2 translate-x-1/4 pointer-events-none"></div>
    </section>

    <!-- Pathways -->
    <section aria-labelledby="monroe-memorials-pathways-heading">
      <div class="text-center mb-12">
        <p class="text-emerald-500 font-bold uppercase tracking-widest text-sm mb-3">Give in the way that feels right</p>
        <h2 id="monroe-memorials-pathways-heading" class="text-3xl lg:text-4xl font-serif text-teal-900 mb-4">Make a tribute gift</h2>
        <p class="text-gray-600 text-lg">Every gift honors a meaningful life while helping an animal begin a new one.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <article class="bg-gray-50 border border-gray-200 rounded-3xl p-8 lg:p-10 flex flex-col relative overflow-hidden group hover:shadow-lg transition-shadow">
          <div class="absolute top-0 right-0 bg-teal-100 text-teal-800 text-xs font-bold uppercase tracking-wider px-4 py-2 rounded-bl-xl rounded-tr-3xl">Fastest &amp; easiest</div>
          <span class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center text-teal-600 mb-6 shadow-sm border border-gray-100 group-hover:scale-110 transition-transform" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="M3 10h18M7 15h3"></path></svg>
          </span>
          <h3 class="text-2xl font-serif text-teal-900 mb-3">Give online</h3>
          <p class="text-gray-600 mb-8 leading-relaxed flex-1">Use our secure online tribute form to make a gift with a credit card, debit card, or Apple Pay.</p>
          <a class="inline-flex items-center justify-center gap-2 w-full px-6 py-4 rounded-full bg-teal-700 text-white font-bold uppercase tracking-wider transition-all hover:bg-teal-900" href={MEMORIAL_GIVING_URL} target="_blank" rel="noopener noreferrer">
            Open the memorial gift form
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"></path></svg>
          </a>
        </article>

        <article class="bg-gray-50 border border-gray-200 rounded-3xl p-8 lg:p-10 flex flex-col relative hover:shadow-lg transition-shadow">
          <div class="absolute top-0 right-0 bg-gray-200 text-gray-700 text-xs font-bold uppercase tracking-wider px-4 py-2 rounded-bl-xl rounded-tr-3xl">Mail or coordinate</div>
          <span class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center text-gray-500 mb-6 shadow-sm border border-gray-100" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v14H4z"></path><path d="m4 7 8 6 8-6"></path></svg>
          </span>
          <h3 class="text-2xl font-serif text-teal-900 mb-3">Give by mail</h3>
          <p class="text-gray-600 mb-6 leading-relaxed flex-1">Prefer a check or need help with tribute details? Our team will make sure your gift is recorded with care.</p>
          <address class="not-italic flex flex-col gap-2 pt-6 border-t border-gray-200 text-gray-700">
            <a href={`mailto:${MEMORIAL_EMAIL}`} class="font-semibold text-teal-700 hover:underline">{MEMORIAL_EMAIL}</a>
            <span>HSMC, {SITE.contact.address.poBox}</span>
          </address>
        </article>
      </div>
    </section>

    <!-- Recent Tributes -->
    {recentTributes.length > 0 && (
      <section class="bg-teal-50/50 border border-teal-100 rounded-3xl p-8 lg:p-12" aria-labelledby="monroe-memorials-recent-heading">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-10">
          <div>
            <p class="text-emerald-600 font-bold uppercase tracking-widest text-sm mb-2">Love remembered</p>
            <h2 id="monroe-memorials-recent-heading" class="text-3xl font-serif text-teal-900">Recently remembered</h2>
          </div>
          <a href="/memorials" class="inline-flex items-center gap-1 text-teal-700 font-bold uppercase tracking-wider text-sm hover:text-teal-900 group">
            View the full honor roll
            <svg class="transition-transform group-hover:translate-x-1" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"></path></svg>
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" role="list">
          {recentTributes.map((tribute) => (
            <article class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100" role="listitem">
              <span class="text-emerald-500 block mb-4" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><ellipse cx="6.2" cy="7.8" rx="2" ry="2.8" transform="rotate(-25 6.2 7.8)"></ellipse><ellipse cx="10.2" cy="5.4" rx="2" ry="2.8" transform="rotate(-8 10.2 5.4)"></ellipse><ellipse cx="14.5" cy="5.4" rx="2" ry="2.8" transform="rotate(8 14.5 5.4)"></ellipse><ellipse cx="18.2" cy="7.9" rx="2" ry="2.8" transform="rotate(25 18.2 7.9)"></ellipse><path d="M12.2 10.1c-3.9 0-6.7 3.3-6.7 6.6 0 2.2 1.5 3.7 3.5 3.7 1.2 0 2.2-.7 3.2-.7s2 .7 3.2.7c2 0 3.5-1.5 3.5-3.7 0-3.3-2.8-6.6-6.7-6.6Z"></path></svg>
              </span>
              <p class="text-sm font-bold uppercase tracking-wider text-gray-500 mb-1">{tribute.line}</p>
              <h3 class="text-xl font-serif text-teal-900">{tribute.name}</h3>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Honor Roll Banner -->
    <section class="bg-teal-700 text-cream rounded-[2.5rem] p-10 lg:p-16 flex flex-col lg:flex-row items-center gap-10 text-center lg:text-left relative overflow-hidden" aria-labelledby="monroe-memorials-honor-roll-heading">
      <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-white rounded-full mix-blend-overlay opacity-5 -translate-y-1/2 translate-x-1/3 pointer-events-none"></div>
      <span class="text-emerald-300 hidden lg:block" aria-hidden="true">
        <svg width="100" height="100" viewBox="0 0 24 24" fill="currentColor">
          <ellipse cx="6.2" cy="7.8" rx="2" ry="2.8" transform="rotate(-25 6.2 7.8)"></ellipse>
          <ellipse cx="10.2" cy="5.4" rx="2" ry="2.8" transform="rotate(-8 10.2 5.4)"></ellipse>
          <ellipse cx="14.5" cy="5.4" rx="2" ry="2.8" transform="rotate(8 14.5 5.4)"></ellipse>
          <ellipse cx="18.2" cy="7.9" rx="2" ry="2.8" transform="rotate(25 18.2 7.9)"></ellipse>
          <path d="M12.2 10.1c-3.9 0-6.7 3.3-6.7 6.6 0 2.2 1.5 3.7 3.5 3.7 1.2 0 2.2-.7 3.2-.7s2 .7 3.2.7c2 0 3.5-1.5 3.5-3.7 0-3.3-2.8-6.6-6.7-6.6Z"></path>
        </svg>
      </span>
      <div class="flex-1 relative z-10">
        <p class="text-emerald-300 font-bold uppercase tracking-widest text-sm mb-3">Their memory lives here</p>
        <h2 id="monroe-memorials-honor-roll-heading" class="text-3xl lg:text-4xl font-serif text-white mb-4">Visit our memorial honor roll</h2>
        <p class="text-lg text-teal-100 max-w-xl mx-auto lg:mx-0">Read the names of people and pets remembered through gifts to the animals in our care.</p>
      </div>
      <div class="relative z-10">
        <a class="inline-flex items-center gap-2 px-7 py-4 rounded-full bg-white text-teal-900 font-bold uppercase tracking-wider transition-all hover:bg-gray-100 hover:-translate-y-1 shadow-lg" href="/memorials">
          View names &amp; tributes
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"></path></svg>
        </a>
      </div>
    </section>

    <!-- Planned Giving -->
    <section id="PlannedGiving" class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 scroll-mt-28" aria-labelledby="monroe-memorials-planned-heading">
      <div class="lg:col-span-8">
        <p class="text-emerald-500 font-bold uppercase tracking-widest text-sm mb-3">A legacy of compassion</p>
        <h2 id="monroe-memorials-planned-heading" class="text-3xl lg:text-4xl font-serif text-teal-900 mb-8">Let your love for animals live on</h2>
        <blockquote class="border-l-4 border-emerald-500 pl-6 my-8 py-2">
          <p class="text-2xl font-serif text-teal-900 italic mb-2">"Those who are happiest are those who do the most for others."</p>
          <cite class="text-gray-500 font-bold uppercase tracking-wider text-sm not-italic">Booker T. Washington</cite>
        </blockquote>
        <p class="text-gray-600 text-lg leading-relaxed mb-8">
          By including the Humane Society of Monroe County in your will, trust, or other financial plan, you extend your compassion beyond your lifetime and help homeless animals find forever homes.
        </p>

        <div class="flex gap-4 p-6 bg-teal-50 border border-teal-100 rounded-2xl text-teal-800 mb-8">
          <span class="text-teal-600 shrink-0 mt-1" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 7v5c0 5 3.4 8.2 8 9 4.6-.8 8-4 8-9V7l-8-4Z"></path><path d="m9 12 2 2 4-4"></path></svg>
          </span>
          <p class="leading-relaxed">Your accountant, estate attorney, financial planner, or tax advisor can help structure a gift that fits your goals.</p>
        </div>

        <details class="group border border-gray-200 rounded-2xl">
          <summary class="flex justify-between items-center p-6 cursor-pointer list-none font-bold text-gray-800 hover:bg-gray-50 rounded-2xl transition-colors">
            About charitable remainder trusts
            <span class="text-gray-400 transition-transform group-open:rotate-180">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"></path></svg>
            </span>
          </summary>
          <div class="px-6 pb-6 pt-2 text-gray-600 leading-relaxed border-t border-gray-100 mt-2">
            A charitable remainder trust may work well if you want to donate appreciated assets, receive an income tax deduction, and reserve income for yourself or loved ones. Ask your advisor whether a CRT is appropriate for your situation.
          </div>
        </details>
      </div>

      <aside class="lg:col-span-4 bg-gray-50 border border-gray-200 rounded-3xl p-8 flex flex-col" aria-label="Planned giving contact">
        <span class="w-14 h-14 bg-white rounded-full flex items-center justify-center text-teal-700 shadow-sm mb-6" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6 3-9 8-10-1 6-4 9-8 10Z"></path><path d="M12 21c0-6-3-9-8-10 1 6 4 9 8 10Z"></path><path d="M12 21v-7"></path></svg>
        </span>
        <p class="text-teal-700 font-bold uppercase tracking-widest text-xs mb-2">Start a conversation</p>
        <h3 class="text-2xl font-serif text-teal-900 mb-4">Planning a legacy gift?</h3>
        <p class="text-gray-600 mb-8 flex-1 leading-relaxed">Gary can help you begin a thoughtful conversation with your professional advisor.</p>
        
        <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex flex-col">
          <strong class="text-teal-900 text-lg">Gary Nowitzke</strong>
          <span class="text-gray-500 mb-4">Lotus Financial</span>
          <a class="inline-flex items-center justify-center gap-2 w-full px-5 py-3 rounded-xl bg-teal-50 text-teal-800 font-bold transition-colors hover:bg-teal-100" href="tel:7344573700">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"></path></svg>
            Call 734-457-3700
          </a>
        </div>
      </aside>
    </section>

    <!-- FAQ -->
    <section class="max-w-3xl mx-auto" aria-labelledby="monroe-memorials-faq-heading">
      <div class="text-center mb-10">
        <p class="text-emerald-500 font-bold uppercase tracking-widest text-sm mb-3">Helpful details</p>
        <h2 id="monroe-memorials-faq-heading" class="text-3xl font-serif text-teal-900">Memorial gift questions</h2>
      </div>
      <div class="flex flex-col gap-4">
        <details class="group bg-white border border-gray-200 rounded-2xl shadow-sm">
          <summary class="flex justify-between items-center p-6 cursor-pointer list-none font-bold text-gray-800 hover:bg-gray-50 rounded-2xl transition-colors marker:hidden">
            Will the family know a gift was made?
            <span class="text-gray-400 transition-transform group-open:rotate-180">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"></path></svg>
            </span>
          </summary>
          <div class="px-6 pb-6 pt-0 text-gray-600 leading-relaxed">
            Yes. We send acknowledgment letters to the family and the donor. The gift amount remains private.
          </div>
        </details>
        <details class="group bg-white border border-gray-200 rounded-2xl shadow-sm">
          <summary class="flex justify-between items-center p-6 cursor-pointer list-none font-bold text-gray-800 hover:bg-gray-50 rounded-2xl transition-colors marker:hidden">
            When will a tribute appear on the honor roll?
            <span class="text-gray-400 transition-transform group-open:rotate-180">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"></path></svg>
            </span>
          </summary>
          <div class="px-6 pb-6 pt-0 text-gray-600 leading-relaxed">
            Staff reviews each memorial gift after its details are received and confirmed. If a tribute is time-sensitive or does not appear as expected, please contact us.
          </div>
        </details>
        <details class="group bg-white border border-gray-200 rounded-2xl shadow-sm">
          <summary class="flex justify-between items-center p-6 cursor-pointer list-none font-bold text-gray-800 hover:bg-gray-50 rounded-2xl transition-colors marker:hidden">
            How do I request a correction?
            <span class="text-gray-400 transition-transform group-open:rotate-180">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"></path></svg>
            </span>
          </summary>
          <div class="px-6 pb-6 pt-0 text-gray-600 leading-relaxed">
            Email <a href={`mailto:${MEMORIAL_EMAIL}`} class="text-teal-700 font-semibold hover:underline">{MEMORIAL_EMAIL}</a> with the name as it currently appears and the requested correction.
          </div>
        </details>
        <details class="group bg-white border border-gray-200 rounded-2xl shadow-sm">
          <summary class="flex justify-between items-center p-6 cursor-pointer list-none font-bold text-gray-800 hover:bg-gray-50 rounded-2xl transition-colors marker:hidden">
            Can my gift be anonymous?
            <span class="text-gray-400 transition-transform group-open:rotate-180">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"></path></svg>
            </span>
          </summary>
          <div class="px-6 pb-6 pt-0 text-gray-600 leading-relaxed">
            Yes. Tell us on the memorial gift form&mdash;or contact us directly&mdash;if you do not want your name shared with the family or listed publicly.
          </div>
        </details>
        <details class="group bg-white border border-gray-200 rounded-2xl shadow-sm">
          <summary class="flex justify-between items-center p-6 cursor-pointer list-none font-bold text-gray-800 hover:bg-gray-50 rounded-2xl transition-colors marker:hidden">
            Are donation amounts shown publicly?
            <span class="text-gray-400 transition-transform group-open:rotate-180">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"></path></svg>
            </span>
          </summary>
          <div class="px-6 pb-6 pt-0 text-gray-600 leading-relaxed">
            No. The public honor roll recognizes the person or pet being honored; donation amounts are not displayed.
          </div>
        </details>
      </div>
    </section>

    <nav class="flex flex-wrap justify-center gap-6 pt-12 border-t border-gray-200" aria-label="Related pages">
      <a class="text-gray-500 font-bold uppercase tracking-wider text-sm hover:text-teal-700 transition-colors" href="/memorials">Memorial honor roll</a>
      <a class="text-gray-500 font-bold uppercase tracking-wider text-sm hover:text-teal-700 transition-colors" href="/">Back to home</a>
    </nav>
  </div>
</BaseLayout>

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>