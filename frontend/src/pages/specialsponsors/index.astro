---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerShell from '../../components/InnerShell.astro';
---

<BaseLayout
  title="Special Sponsors | 734-243-3669"
  description="Thank you to the special sponsors who make Humane Society of Monroe County events possible."
>
  <InnerShell variant="specialsponsors">
    <header class="monroe-native-hero">
      <p class="monroe-native-eyebrow">Thank you</p>
      <h1>Special Sponsors</h1>
      <p class="monroe-native-lead">
        Special sponsors make our events possible. We are grateful for every business and donor who champions animals in Monroe County.
      </p>
    </header>
    <section class="monroe-native-stack" aria-labelledby="monroe-special-sponsors-more-heading">
      <h2 id="monroe-special-sponsors-more-heading">Events &amp; fundraisers</h2>
      <p><a href="/events">View upcoming events</a></p>
      <p><a href="/donate" target="_blank" rel="noopener noreferrer"></a></p>
    </section>
  </InnerShell>
</BaseLayout>
