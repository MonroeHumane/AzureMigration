---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Special Sponsors | 734-243-3669"
  description="Thank you to the special sponsors who make Humane Society of Monroe County events possible."
>
  <main class="pt-32 pb-24 px-4 max-w-4xl mx-auto">
    <header class="mb-16 text-center">
      <p class="text-emerald-500 font-bold uppercase tracking-widest text-sm mb-4">Thank you</p>
      <h1 class="text-5xl md:text-6xl font-serif text-teal-900 mb-6">Special Sponsors</h1>
      <p class="text-xl text-gray-600 leading-relaxed">
        Special sponsors make our events possible. We are grateful for every business and donor who champions animals in Monroe County.
      </p>
    </header>
    
    <section aria-labelledby="monroe-special-sponsors-more-heading" class="bg-gray-50 rounded-3xl p-8 border border-gray-200 text-center">
      <h2 id="monroe-special-sponsors-more-heading" class="text-3xl font-serif text-teal-900 mb-6">Events &amp; fundraisers</h2>
      <div class="flex flex-wrap justify-center gap-4">
        <a class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-teal-700 text-white font-bold uppercase tracking-wider transition-all hover:bg-teal-900 hover:-translate-y-1 shadow-sm" href="/events">View upcoming events</a>
      </div>
    </section>
  </main>
</BaseLayout>