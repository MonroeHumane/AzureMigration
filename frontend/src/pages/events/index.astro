---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEventFlyers } from '../../lib/directus';

const eventData = await getEventFlyers();

const now = new Date('2026-08-27T12:00:00Z');
const thirtyDaysAgo = new Date(now.getTime() - (30 * 24 * 60 * 60 * 1000));

const currentEvents = eventData.filter(e => e.event_date && new Date(e.event_date) >= thirtyDaysAgo).sort((a,b) => new Date(a.event_date!).getTime() - new Date(b.event_date!).getTime());
const historicEvents = eventData.filter(e => e.event_date && new Date(e.event_date) < thirtyDaysAgo).sort((a,b) => new Date(b.event_date!).getTime() - new Date(a.event_date!).getTime());
---

<BaseLayout
  title="Events | Monroe County | 734-243-3669"
  description="Join us for fundraisers, adoption promotions, and community nights. Thank you to the businesses and families who sponsor our work."
>
  <div class="pb-24 px-4 max-w-7xl mx-auto">
    <header class="text-center mb-16 max-w-3xl mx-auto">
      <p class="text-emerald-500 font-bold uppercase tracking-widest text-sm mb-4">Events</p>
      <h1 class="text-5xl md:text-6xl font-serif text-teal-900 mb-6">Events | Monroe County</h1>
      <p class="text-xl text-gray-600 leading-relaxed">
          Join us for fundraisers, adoption promotions, and community nights. Thank you to the businesses and families who sponsor our work.
      </p>
    </header>

    <section id="Calendar" class="mb-16 text-center">
      <p class="text-lg text-gray-700 bg-teal-50 border border-teal-100 rounded-2xl p-6 inline-block shadow-sm">
        Want reminders on your own calendar? You can <a class="text-emerald-600 font-bold hover:text-emerald-700 underline underline-offset-4 decoration-2 decoration-emerald-200" href="https://delightful-dune-0d730f70f.7.azurestaticapps.net/events/#Calendar">add our events to your own calendar</a>.
      </p>
    </section>

    <section aria-labelledby="upcoming-events-heading" class="mb-24">
      <div class="text-center mb-12">
        <h2 id="upcoming-events-heading" class="text-3xl font-serif text-teal-900 mb-4">Current &amp; Upcoming Events</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Fundraisers, adoption promotions, and community nights - click any flyer for the full details.
        </p>
      </div>

      {currentEvents.length === 0 ? (
        <div class="bg-gray-50 border border-gray-200 rounded-3xl p-12 text-center">
          <p class="text-xl text-gray-500">No upcoming events posted right now - check back soon.</p>
        </div>
      ) : (
        <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {currentEvents.map(event => (
            <li class="flex">
              <a href={event.link_url} class="group w-full flex flex-col bg-white border border-gray-200 rounded-3xl overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300" target="_blank" rel="noopener noreferrer">
                <div class="aspect-[4/5] bg-gray-100 relative overflow-hidden flex-shrink-0">
                  {event.image ? (
                    <img class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src={event.image} alt={event.title} loading="lazy" decoding="async" />
                  ) : (
                    <div class="absolute inset-0 flex items-center justify-center text-4xl text-gray-300" aria-hidden="true">??</div>
                  )}
                </div>
                <div class="p-6 flex flex-col flex-1">
                  <span class="text-emerald-600 font-bold text-sm uppercase tracking-widest mb-2">
                    {event.event_date && new Date(event.event_date + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                  </span>
                  <strong class="text-xl font-serif text-teal-900 mb-3 group-hover:text-emerald-700 transition-colors">{event.title}</strong>
                  <span class="text-gray-600 line-clamp-3">{event.description}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>

    {historicEvents.length > 0 && (
      <section class="max-w-4xl mx-auto">
        <details class="group bg-gray-50 border border-gray-200 rounded-3xl [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-bold cursor-pointer text-teal-900 text-lg p-6 hover:bg-gray-100 rounded-3xl transition-colors">
            <span>View Past Events ({historicEvents.length})</span>
            <span class="transition group-open:rotate-180">
              <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 p-6 pt-0">
            {historicEvents.map(event => (
              <a href={event.link_url} class="block p-4 bg-white border border-gray-200 rounded-2xl hover:border-emerald-300 hover:shadow-md transition-all">
                <span class="block text-sm font-bold text-gray-500 mb-1 uppercase tracking-wider">
                  {new Date(event.event_date + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </span>
                <strong class="block text-teal-700 leading-snug">{event.title}</strong>
              </a>
            ))}
          </div>
        </details>
      </section>
    )}
  </div>
</BaseLayout>
