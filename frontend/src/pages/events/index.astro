---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerShell from '../../components/InnerShell.astro';
import { getEventFlyers } from '../../lib/directus';
import '../../styles/monroe-events.css';

const eventData = await getEventFlyers();

const now = new Date('2026-08-27T12:00:00Z');
const thirtyDaysAgo = new Date(now.getTime() - (30 * 24 * 60 * 60 * 1000));

const currentEvents = eventData.filter(e => e.event_date && new Date(e.event_date) >= thirtyDaysAgo).sort((a,b) => new Date(a.event_date!).getTime() - new Date(b.event_date!).getTime());
const historicEvents = eventData.filter(e => e.event_date && new Date(e.event_date) < thirtyDaysAgo).sort((a,b) => new Date(b.event_date!).getTime() - new Date(a.event_date!).getTime());
---

<BaseLayout
  title="Events | Monroe County | 734-243-3669"
  description="Join us for fundraisers, adoption promotions, and community nights. Thank you to the businesses and families who sponsor our work."
>
  <InnerShell variant="events">
    <header class="monroe-native-hero">
      <p class="monroe-native-eyebrow">Events</p>
      <h1>Events | Monroe County</h1>
      <p class="monroe-native-lead">
          Join us for fundraisers, adoption promotions, and community nights. Thank you to the businesses and families who sponsor our work.
      </p>
    </header>

    <section id="Calendar" class="monroe-native-stack" style="text-align: center;">
      <p>
        Want reminders on your own calendar? You can{" "}
        <a href="https://delightful-dune-0d730f70f.7.azurestaticapps.net/events/#Calendar">add our events to your own calendar</a>.
      </p>
    </section>

    <section class="monroe-native-stack" aria-labelledby="upcoming-events-heading">
      <h2 id="upcoming-events-heading" style="text-align: center;">Current &amp; Upcoming Events</h2>
      <p class="monroe-event-flyers__lead" style="margin-left: auto; margin-right: auto; text-align: center;">
        Fundraisers, adoption promotions, and community nights — click any flyer for the full details.
      </p>
      {currentEvents.length === 0 ? (
        <p class="monroe-event-flyers__empty">No upcoming events posted right now — check back soon.</p>
      ) : (
        <ul class="monroe-event-flyers__grid">
          {currentEvents.map(event => (
            <li class="monroe-event-flyers__item">
              <a href={event.link_url} class="monroe-event-flyers__card" target="_blank" rel="noopener noreferrer">
                {event.image ? (
                  <img class="monroe-event-flyers__image" src={event.image} alt={event.title} loading="lazy" decoding="async" />
                ) : (
                  <div class="monroe-event-flyers__placeholder" aria-hidden="true">🐾</div>
                )}
                <div class="monroe-event-flyers__body">
                  <span class="monroe-event-flyers__date">
                    {event.event_date && new Date(event.event_date + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                  </span>
                  <span class="monroe-event-flyers__title">{event.title}</span>
                  <span class="monroe-event-flyers__excerpt">{event.description}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>

    {historicEvents.length > 0 && (
      <section class="monroe-native-stack">
        <details style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 1rem;">
          <summary style="font-weight: 700; cursor: pointer; color: #334155; font-size: 1.1rem;">
            View Past Events ({historicEvents.length})
          </summary>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1rem; margin-top: 1rem;">
            {historicEvents.map(event => (
              <a href={event.link_url} style="display: block; padding: 1rem; background: #fff; border: 1px solid #e2e8f0; border-radius: 6px; text-decoration: none; color: inherit;">
                <span style="display: block; font-size: 0.8rem; color: #64748b; margin-bottom: 0.25rem;">
                  {new Date(event.event_date + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </span>
                <strong style="display: block; color: #0f766e; font-size: 0.95rem; line-height: 1.3;">{event.title}</strong>
              </a>
            ))}
          </div>
        </details>
      </section>
    )}
  </InnerShell>
</BaseLayout>
