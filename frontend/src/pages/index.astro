---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPets } from '../lib/directus';
import { SITE } from '../config/site';
import home from '../data/homepage.json';
import sponsors from '../data/sponsors.json';

import '../styles/monroe-home.css';
import '../styles/monroe-home-widgets.css';

const pets = (await getPets()).slice(0, 6);
const petChips = (p: (typeof pets)[number]) => [
  p.species_label || p.type || 'Pet',
  p.gender || 'Unknown',
  p.age_display || 'Age N/A',
  p.location || 'Location',
];
const TEL = SITE.contact.phoneTel;
const indexLabels: Record<string, string> = {
  Top: 'Top',
  Events: 'Events',
  Intro: 'Intro',
  FeaturedPets: 'Adoptable Pets',
  'hs-hero-fence-widget': 'Hero Fence',
  VetPartners: 'Vet partners',
  'furry-friends-auction-sponsors': 'Sponsors',
  sponsorMarqueeWidget: 'Community partners',
  Membership: 'Membership',
  Donations: 'Donations',
  Newsletter: 'Newsletter',
  FAQ: 'FAQ',
  Accomplishments: 'Accomplishments',
  Games: 'Games',
  Contact: 'Contact',
};
---

<BaseLayout
  title="Animal Shelter | Monroe County | 734-243-3669"
  description={home.hero.copy}
  bodyClass="home-editable-has-flyers-rail"
>
  <div class="home-editable-page-index-shell">
    <nav class="home-editable-page-index home-editable-page-index--mobile" aria-label="Jump to section">
      <ul class="home-editable-page-index__list">
        {home.page_index.map((id) => (
          <li class="home-editable-page-index__item">
            <a class="home-editable-page-index__link" href={`#${id}`}>{indexLabels[id] ?? id}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="home-editable-side-rail">
      <nav class="home-editable-page-index home-editable-page-index--desktop" aria-label="On this page">
        <p class="home-editable-page-index__title">On this page</p>
        <ul class="home-editable-page-index__list">
          {home.page_index.map((id) => (
            <li class="home-editable-page-index__item">
              <a class="home-editable-page-index__link" href={`#${id}`}>{indexLabels[id] ?? id}</a>
            </li>
          ))}
        </ul>
      </nav>

      <aside class="home-editable-flyers-rail" aria-label="Flyers">
        <p class="home-editable-flyers-rail__title">{home.flyers_rail.title}</p>
        <div class="home-editable-flyers-rail__items">
          <a class="home-editable-flyers-rail__item" href="/events">
            <img src={home.flyers_rail.flyer_image} alt={home.flyers_rail.flyer_alt} loading="lazy" decoding="async" />
          </a>
        </div>
      </aside>
    </div>
  </div>

  <div class="home-editable-shell">
    <!-- 1. Hero -->
    <div class="wp-block-cover has-custom-content-position is-position-center-center home-editable-hero" id="Top">
      <span aria-hidden="true" class="wp-block-cover__background has-contrast-background-color has-background-dim-40 has-background-dim"></span>
      <video
        class="wp-block-cover__video-background intrinsic-ignore"
        muted
        loop
        playsinline
        autoplay
        preload="none"
        poster={home.hero.video_poster}
        data-src={home.hero.video_src}
        data-monroe-lazy-video></video>
      <div class="wp-block-cover__inner-container is-layout-flow">
        <div class="wp-block-group home-editable-hero-panel is-layout-constrained">
          <p class="home-editable-hero-display wp-block-paragraph">{home.hero.display}</p>
          <h1 class="wp-block-heading home-editable-hero-title">{home.hero.title}</h1>
          <p class="home-editable-hero-copy wp-block-paragraph">{home.hero.copy}</p>

          <div class="wp-block-buttons aligncenter is-layout-flex">
            <div class="wp-block-button">
              <a class="wp-block-button__link has-base-color has-vivid-cyan-blue-background-color has-text-color has-background wp-element-button" href="/adopt">{home.hero.buttons[0].label}</a>
            </div>
            <div class="wp-block-button home-editable-hero-btn--orange">
              <a class="wp-block-button__link wp-element-button" href="/adoptions">{home.hero.buttons[1].label}</a>
            </div>
            <div class="wp-block-button is-style-outline">
              <a class="wp-block-button__link wp-element-button" href={home.hero.buttons[2].href} target="_blank" rel="noreferrer noopener">{home.hero.buttons[2].label}</a>
            </div>
          </div>

          <div class="home-editable-hero-stats" aria-label="Shelter highlights">
            <div class="home-editable-stat-grid home-editable-stat-grid--hero">
              {home.hero.stats.map((s) => (
                <div class:list={['home-editable-stat', { 'is-accent': s.accent }]}>
                  <strong>{s.kicker}</strong>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Events band -->
    <div id="Events" class="wp-block-group alignwide home-editable-section home-editable-events-band is-layout-constrained">
      <section class="hs-feature-widget home-editable-events-artwork" aria-labelledby="hs-events-feature-title">
        <div class="hs-wrap">
          <div class="hs-copy">
            <p class="hs-kicker">{home.events_feature.kicker}</p>
            <p class="hs-deadline">{home.events_feature.deadline}</p>
            <h2 id="hs-events-feature-title">{home.events_feature.title}</h2>
            {home.events_feature.body.map((p) => <p class="hs-body">{p}</p>)}
            <p class="hs-note">{home.events_feature.note}</p>
            <div class="monroe-vote-ways" role="note">
              <p class="monroe-vote-ways__title">{home.events_feature.ways_title}</p>
              <div class="monroe-vote-ways__grid">
                {home.events_feature.ways.map((w) => (
                  <div class="monroe-vote-ways__item">
                    <span class="monroe-vote-ways__icon" aria-hidden="true">{w.icon}</span>
                    <p><strong>{w.text.split(':')[0]}:</strong>{w.text.slice(w.text.indexOf(':') + 1)}</p>
                  </div>
                ))}
              </div>
            </div>
            <div class="hs-actions">
              <a class="hs-btn hs-btn--vote" href={home.events_feature.cta.href} target="_blank" rel="noopener noreferrer">{home.events_feature.cta.label}</a>
            </div>
          </div>
          <a class="hs-voting-flyer" href={home.events_feature.flyer_image} target="_blank" rel="noopener noreferrer">
            <img src={home.events_feature.flyer_image} alt={home.events_feature.flyer_alt} loading="lazy" decoding="async" />
          </a>
          <div class="hs-voting-schedule" aria-label="Event schedule">
            <h3>{home.events_feature.schedule_title}</h3>
            <ul>
              {home.events_feature.schedule.map((row) => (
                <li><strong>{row.date}</strong><span>{row.location}</span></li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <div class="home-editable-upcoming-event-section">
        <div class="home-editable-upcoming-event-hero home-editable-feature-card">
          <div class="home-editable-upcoming-event-hero__grid">
            <div class="home-editable-upcoming-event-hero__media-col">
              <div class="home-editable-upcoming-event-hero__media home-editable-upcoming-event-hero__media--placeholder" aria-hidden="true"></div>
            </div>
            <div class="home-editable-upcoming-event-hero__copy">
              <p class="home-editable-pill home-editable-upcoming-event-hero__kicker">{home.next_event.kicker}</p>
              <p class="home-editable-pill home-editable-upcoming-event-hero__date">{home.next_event.date}</p>
              <h2 class="wp-block-heading">{home.next_event.title}</h2>
              <p>{home.next_event.time}</p>
              <div class="wp-block-buttons">
                <div class="wp-block-button">
                  <a class="wp-block-button__link has-base-color has-vivid-cyan-blue-background-color has-text-color has-background wp-element-button" href="/events">{home.next_event.buttons[0].label}</a>
                </div>
                <div class="wp-block-button is-style-outline">
                  <a class="wp-block-button__link wp-element-button" href="/events">{home.next_event.buttons[1].label}</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Intro -->
    <div class="wp-block-group alignwide home-editable-section is-layout-constrained">
      <div class="wp-block-group home-editable-intro-card is-layout-constrained" id="Intro">
        <div class="wp-block-columns are-vertically-aligned-center is-layout-flex">
          <div class="wp-block-column is-vertically-aligned-center is-layout-flow" style="flex-basis:65%">
            <p class="home-editable-pill wp-block-paragraph">{home.intro.pill}</p>
            <h2 class="wp-block-heading">{home.intro.title}</h2>
            <p class="wp-block-paragraph">{home.intro.copy}</p>
            <div class="wp-block-buttons is-layout-flex">
              <div class="wp-block-button">
                <a class="wp-block-button__link has-base-color has-contrast-background-color has-text-color has-background wp-element-button" href={TEL}>{home.intro.call_button}</a>
              </div>
            </div>
          </div>
          <div class="wp-block-column is-layout-flow" style="flex-basis:35%">
            <div class="home-editable-stat-grid">
              {home.intro.stats.map((s) => (
                <div class:list={['home-editable-stat', { 'is-accent': s.accent }]}>
                  <strong>{s.kicker}</strong>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 4. Featured pets -->
    <div class="wp-block-group alignwide home-editable-section is-layout-constrained" id="FeaturedPets">
      <h2 class="wp-block-heading">{home.featured_pets.title}</h2>
      <p class="wp-block-paragraph">{home.featured_pets.copy}</p>

      <div id="featuredPetsWidget" data-monroe-static>
        <div class="fpw-toolbar">
          <button id="fpwExpandBtn" type="button" aria-controls="featuredPetsFsDialog">Expand view</button>
        </div>
        <dialog id="featuredPetsFsDialog" class="fpw-fs-dialog">
          <div class="fpw-fs-dialog__head">
            <h2>Adoptable Pets</h2>
            <button type="button" class="fpw-fs-dialog__close" aria-label="Close">Close</button>
          </div>
          <div class="widget-section">
            <div class="title-row">
              <h3>Longest residents</h3>
              <a class="adopt-all-btn" href="/adopt">Search All Adoptable Pets</a>
            </div>
            <div id="fpw-fs-longest" class="widget-grid"></div>
          </div>
        </dialog>
        <div class="widget-section">
          <div class="title-row">
            <h3>Longest residents</h3>
            <a class="adopt-all-btn" href="/adopt">Search All Adoptable Pets</a>
          </div>
          <div class="widget-grid" id="longestRow">
            <div class="scroll-viewport">
              <div class="scroll-track">
                <div class="scroll-strip scroll-strip--primary">
                  {pets.map((pet) => (
                    <div class="pet-card-widget">
                      <div class="photo-shell">
                        <div class="photo-frame">
                          <img class="pet-photo-widget" src={pet.image} alt={pet.name} loading="lazy" decoding="async" />
                        </div>
                      </div>
                      <div class="pet-details-widget">
                        <div class="pet-name-widget">{pet.name}</div>
                        <div class="pet-breed">{pet.breed}</div>
                        <div class="chip-row">
                          {petChips(pet).map((chip) => <span class="chip">{chip}</span>)}
                        </div>
                        <div class="view-profile-widget">
                          <a href={pet.url} target="_blank" rel="noopener noreferrer">View Profile</a>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
                <div class="scroll-strip scroll-strip--clone" aria-hidden="true">
                  {pets.map((pet) => (
                    <div class="pet-card-widget">
                      <div class="photo-shell">
                        <div class="photo-frame">
                          <img class="pet-photo-widget" src={pet.image} alt={pet.name} loading="lazy" decoding="async" />
                        </div>
                      </div>
                      <div class="pet-details-widget">
                        <div class="pet-name-widget">{pet.name}</div>
                        <div class="pet-breed">{pet.breed}</div>
                        <div class="chip-row">
                          {petChips(pet).map((chip) => <span class="chip">{chip}</span>)}
                        </div>
                        <div class="view-profile-widget">
                          <a href={pet.url} target="_blank" rel="noopener noreferrer">View Profile</a>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 5. Hero Fence -->
    <div class="wp-block-group alignwide home-editable-section is-layout-constrained">
      <section id="hs-hero-fence-widget" class="hs-feature-widget" aria-labelledby="hs-hero-fence-title">
        <div class="hs-wrap">
          <div class="hs-copy">
            <p class="hs-kicker">{home.hero_fence.kicker}</p>
            <h2 id="hs-hero-fence-title">{home.hero_fence.title}</h2>
            {home.hero_fence.body.map((p) => <p class="hs-body">{p}</p>)}
            <div class="hs-note">{home.hero_fence.note}</div>
            <div class="hs-actions">
              <a class="hs-btn" href={home.hero_fence.cta.href}>{home.hero_fence.cta.label}</a>
            </div>
          </div>
          <div class="hs-media" aria-hidden="true">
            <img decoding="async" src={home.hero_fence.image} alt={home.hero_fence.image_alt} loading="lazy" />
          </div>
        </div>
      </section>
    </div>

    <!-- 6. Feature card -->
    <div class="wp-block-group alignwide home-editable-section is-layout-constrained">
      <div class="wp-block-group home-editable-feature-card is-layout-constrained">
        <div class="wp-block-columns are-vertically-aligned-stretch is-layout-flex">
          <div class="wp-block-column is-vertically-aligned-stretch home-editable-feature-media is-layout-flow" style="flex-basis:45%">
            <figure class="wp-block-image size-full">
              <img loading="lazy" decoding="async" src={home.feature_card.image} alt={home.feature_card.image_alt} />
            </figure>
          </div>
          <div class="wp-block-column is-vertically-aligned-center home-editable-feature-copy is-layout-flow" style="flex-basis:55%">
            <p class="home-editable-section-label wp-block-paragraph">{home.feature_card.label}</p>
            <h2 class="wp-block-heading">{home.feature_card.title}</h2>
            <p class="wp-block-paragraph">{home.feature_card.copy}</p>
            <div class="wp-block-buttons is-layout-flex">
              <div class="wp-block-button">
                <a class="wp-block-button__link has-base-color has-vivid-cyan-blue-background-color has-text-color has-background wp-element-button" href="/adoptions">{home.feature_card.buttons[0].label}</a>
              </div>
              <div class="wp-block-button is-style-outline">
                <a class="wp-block-button__link wp-element-button" href="/dog-and-cat-shelter">{home.feature_card.buttons[1].label}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 7. Vet partners -->
    <div class="wp-block-group alignwide home-editable-section is-layout-constrained">
      <div class="home-editable-news-card home-editable-runtime-card">
        <p class="home-editable-section-label wp-block-paragraph">{home.vet_partners.label}</p>
        <h2 class="wp-block-heading">{home.vet_partners.title}</h2>
        <p class="wp-block-paragraph">{home.vet_partners.intro}</p>
        <div class="sponsor-widget-shell">
          <section class="sponsor-widget" id="VetPartners" aria-labelledby="sponsor-widget-title">
            <div class="sponsor-widget__header">
              <h3 id="sponsor-widget-title" class="sponsor-widget__title">{home.vet_partners.title}</h3>
              <p class="sponsor-widget__subtitle">{home.vet_partners.subtitle}</p>
            </div>
            <div class="sponsor-grid">
              {sponsors.vet_partners.map((v) => (
                <div class="sponsor-card">
                  <figure>
                    <img src={v.image} alt={v.alt} loading="lazy" decoding="async" />
                    <figcaption>{v.name}</figcaption>
                  </figure>
                  <a class="sponsor-card__cta" href={v.link} target="_blank" rel="noopener noreferrer">Visit website</a>
                </div>
              ))}
            </div>
          </section>
        </div>
      </div>
    </div>

    <!-- 8. Auction sponsors -->
    <div class="wp-block-group alignwide home-editable-section is-layout-constrained">
      <div class="home-editable-auction-sponsors">
        <div id="furry-friends-auction-sponsors" class="sponsor-widget-shell sponsor-widget-shell--auction-five">
          <section class="sponsor-widget" aria-labelledby="furry-friends-auction-sponsors-title">
            <div class="sponsor-widget__header">
              <h3 id="furry-friends-auction-sponsors-title" class="sponsor-widget__title">Furry Friends Auction Sponsors</h3>
              <p class="sponsor-widget__subtitle">{home.auction_sponsors.subtitle}</p>
            </div>
            <div class="sponsor-grid">
              {sponsors.auction_sponsors.map((s) => (
                <div class="sponsor-card">
                  <figure>
                    <img src={s.image} alt={s.alt} loading="lazy" decoding="async" />
                    <figcaption>{s.name}</figcaption>
                  </figure>
                  <a class="sponsor-card__cta" href={s.link} target="_blank" rel="noopener noreferrer">Visit website</a>
                </div>
              ))}
            </div>
          </section>
        </div>
      </div>
    </div>

    <!-- 9. Community partners marquee -->
    <div class="wp-block-group alignfull home-editable-sponsors">
      <h5>{home.community_partners.title}</h5>
      <p>{home.community_partners.intro}</p>
      <section id="sponsorMarqueeWidget" class="sponsor-marquee" aria-label="Community partners">
        <div class="logo-slider">
          <div class="logo-track">
            {[false, true].map((clone) => (
              <div class="logo-set" aria-hidden={clone ? 'true' : undefined}>
                {sponsors.community_partners.map((p) => (
                  <img src={p.image} alt={p.name} loading="lazy" decoding="async" />
                ))}
              </div>
            ))}
          </div>
        </div>
      </section>
    </div>

    <!-- 10. Membership -->
    <div class="home-editable-donate-card">
      <div id="Membership" class="monroe-membership-plans-shared monroe-membership-plans-shared--under-construction">
        <div class="home-editable-membership-intro">
          <p class="home-editable-section-label">{home.membership_home.label}</p>
          <h2 class="wp-block-heading">{home.membership_home.title}</h2>
        </div>
        <div class="monroe-membership-under-construction" role="status">
          <p>{home.membership_home.under_construction}</p>
        </div>
      </div>
    </div>

    <!-- 11. Testimonials -->
    <div class="wp-block-group alignwide home-editable-section is-layout-constrained">
      <div class="wp-block-group home-editable-events-card home-editable-runtime-card is-layout-constrained">
        <p class="home-editable-section-label wp-block-paragraph">{home.testimonials.label}</p>
        <h2 class="wp-block-heading">{home.testimonials.title}</h2>
        <p class="wp-block-paragraph">{home.testimonials.intro}</p>
        <div class="monroe-testimonials monroe-testimonials--plugin">
          <div data-src="https://cdn.trustindex.io/loader.js?wp-widget" data-template-id="trustindex-google-widget-html" data-css-url="/assets/trustindex-google-widget.css"></div>
        </div>
      </div>
    </div>

    <!-- 12. Donations -->
    <div class="wp-block-group alignwide home-editable-section is-layout-constrained">
      <div class="wp-block-group home-editable-donate-card home-editable-runtime-card is-layout-constrained" id="Donations">
        <p class="home-editable-section-label wp-block-paragraph">{home.donations.label}</p>
        <h2 class="wp-block-heading">{home.donations.title}</h2>
        <p class="wp-block-paragraph">{home.donations.intro}</p>

        <div class="home-editable-paypal-giving home-editable-paypal-giving--split">
          <div class="home-editable-paypal-giving-split">
            <div class="home-editable-paypal-giving-split__col">
              <div class="pp-giving-wrapper">
                <div class="pp-giving-widget">
                  <div class="pp-widget-header">
                    <h3><span class="pp-icon-heart" aria-hidden="true"></span> {home.donations.cat_room.title}</h3>
                    <p>{home.donations.cat_room.powered_by}</p>
                  </div>
                  <div class="pp-content pp-content--cta">
                    <p class="pp-cta-text">{home.donations.cat_room.cta_text}</p>
                    <a class="pp-cta-btn" href={home.donations.cat_room.href} target="_blank" rel="noopener noreferrer">{home.donations.cat_room.button}</a>
                    <p class="pp-cta-note">Opens PayPal Giving Fund in a new tab</p>
                  </div>
                </div>
              </div>
            </div>
            <div class="home-editable-paypal-giving-split__col">
              <div class="pp-giving-wrapper">
                <div class="pp-giving-widget">
                  <div class="pp-widget-header">
                    <h3><span class="pp-icon-heart" aria-hidden="true"></span> {home.donations.general.title}</h3>
                    <p>{home.donations.general.powered_by}</p>
                  </div>
                  <div class="pp-content pp-content--cta">
                    <p class="pp-cta-text">{home.donations.general.cta_text}</p>
                    <a class="pp-cta-btn" href={home.donations.general.href} target="_blank" rel="noopener noreferrer">{home.donations.general.button}</a>
                    <p class="pp-cta-note">Opens PayPal Giving Fund in a new tab</p>
                  </div>
                </div>
                <div class="offline-donations">
                  <div class="offline-donations-header">
                    <h4>{home.donations.offline.title}</h4>
                    <p>{home.donations.offline.label}</p>
                  </div>
                  <div class="offline-donations-body">
                    <div class="offline-donations-amount">{home.donations.offline.amount}</div>
                    <div class="offline-donations-label">{home.donations.offline.caption}</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="wp-block-columns home-editable-give-grid is-layout-flex">
          {home.donations.tiles.map((tile) => (
            <div class="wp-block-column is-layout-flow">
              <div class="wp-block-group home-editable-give-tile is-layout-constrained" id={tile.title === 'Volunteer' ? 'Volunteer' : undefined}>
                <h3 class="wp-block-heading">{tile.title}</h3>
                <p class="wp-block-paragraph">{tile.copy}</p>
                <div class:list={['wp-block-button', { 'is-style-outline': tile.variant === 'outline' }]}>
                  <a
                    class:list={['wp-block-button__link wp-element-button', { 'has-base-color has-contrast-background-color has-text-color has-background': tile.variant !== 'outline' }]}
                    href={tile.href}
                    {...(tile.external ? { target: '_blank', rel: 'noreferrer noopener' } : {})}
                  >
                    {tile.button}
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- 13. Facebook feed (click-to-load facade) -->
    <div class="wp-block-group alignwide home-editable-section home-editable-social-section home-editable-social-section--feed-only is-layout-constrained" id="Social">
      <div class="wp-block-group home-editable-social-card home-editable-social-card--feed-only home-editable-runtime-card is-layout-constrained">
        <div class="home-editable-social-embed" data-fb-embed>
          <div class="home-editable-social-embed__frame">
            <div class="home-editable-social-embed__chrome">
              <div class="home-editable-social-embed__viewport">
                <div class="home-editable-social-embed__loader" aria-hidden="true">
                  <div class="home-editable-social-embed__loader-shimmer"></div>
                  <span class="home-editable-social-embed__loader-text">Loading Facebook feed…</span>
                </div>
                <iframe
                  title="HSMC Facebook timeline"
                  class="home-editable-social-embed__iframe"
                  data-fb-href="https://www.facebook.com/adopthsmc"
