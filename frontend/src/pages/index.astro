---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeFAQ from '../components/home/HomeFAQ.astro';
import HomeAccomplishments from '../components/home/HomeAccomplishments.astro';
import HomeGames from '../components/home/HomeGames.astro';
import HomeSponsors from '../components/home/HomeSponsors.astro';
import HomePartners from '../components/home/HomePartners.astro';
import HomeTestimonials from '../components/home/HomeTestimonials.astro';
import HomeContact from '../components/home/HomeContact.astro';
import HomeEvents from '../components/home/HomeEvents.astro';
import HomeDonations from '../components/home/HomeDonations.astro';
import HomeNewsletter from '../components/home/HomeNewsletter.astro';
import HomeFeaturedPets from '../components/home/HomeFeaturedPets.astro';
import { getPets } from '../lib/directus';
import { SITE } from '../config/site';
import home from '../data/homepage.json';
import sponsors from '../data/sponsors.json';
import reviewsData from '../data/reviews.json';

import { getSiteSettings, getEventFlyers, getNewsletterIssues } from '../lib/directus';
const pets = (await getPets()).slice(0, 6);
const settings = await getSiteSettings();
const events = await getEventFlyers();
const newsletters = await getNewsletterIssues();
const now = new Date();

const latestEvent = events
  .filter((e) => e.event_date && new Date(e.event_date) >= now)
  .sort((a, b) => new Date(a.event_date!).getTime() - new Date(b.event_date!).getTime())[0];
const latestNewsletter = newsletters[0];

const currentYear = now.getFullYear();
const scheduleWithDates = home.events_feature.schedule.map((row) => {
  const parsed = new Date(`${row.date}, ${currentYear} 12:00:00`);
  const [venue, ...timeParts] = row.location.split(',');
  return { ...row, parsedDate: parsed, venue: venue.trim(), time: timeParts.join(',').trim() };
});
const upcomingStops = scheduleWithDates
  .filter((row) => !Number.isNaN(row.parsedDate.getTime()) && row.parsedDate >= now)
  .sort((a, b) => a.parsedDate.getTime() - b.parsedDate.getTime());
const pastStops = scheduleWithDates
  .filter((row) => !Number.isNaN(row.parsedDate.getTime()) && row.parsedDate < now)
  .sort((a, b) => b.parsedDate.getTime() - a.parsedDate.getTime());
const nextStop = upcomingStops[0] ?? pastStops[0];

const nextEvent = nextStop
  ? {
      kicker: home.next_event.kicker,
      date: nextStop.parsedDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }),
      title: nextStop.venue,
      time: nextStop.time,
      buttons: home.next_event.buttons,
    }
  : home.next_event;

interface Review { author?: string; rating?: number; time?: number; text?: string }
const reviews = (reviewsData as Review[]).filter((r): r is Required<Review> => Boolean(r.author));

if (home.accomplishments.years['2025']) {
  home.accomplishments.years['2025'][0].value = settings.adoptions_count;
  home.accomplishments.years['2025'][0].display = settings.adoptions_count.toLocaleString();
  home.accomplishments.years['2025'][1].value = settings.return_to_owner_count;
  home.accomplishments.years['2025'][1].display = settings.return_to_owner_count.toLocaleString();
  home.accomplishments.years['2025'][2].value = settings.intakes_count;
  home.accomplishments.years['2025'][2].display = settings.intakes_count.toLocaleString();
}

const TEL = SITE.contact.phoneTel;
---

<BaseLayout
  title="Animal Shelter | Monroe County | 734-243-3669"
  description={home.hero.copy}
>
  <div class="flex flex-col gap-16">
    <HomeHero home={home} />
    <HomeEvents home={home} latestEvent={latestEvent} nextEvent={nextEvent} pets={pets} />

    <div class="max-w-7xl mx-auto px-4 py-8">
      <div class="bg-teal-50/50 rounded-3xl p-8 sm:p-12 shadow-sm border border-teal-900/5" id="Intro">
        <div class="flex flex-col lg:flex-row items-center gap-12">
          <div class="flex-1" style="flex-basis:65%">
            <p class="text-emerald-500 font-bold uppercase tracking-widest text-sm mb-3">{home.intro.pill}</p>
            <h2 class="text-4xl font-serif text-teal-900 mb-6 leading-tight">{home.intro.title}</h2>
            <p class="text-lg text-gray-700 leading-relaxed mb-8">{home.intro.copy}</p>
            <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-8 py-4 rounded-full transition-all shadow-md hover:-translate-y-1 bg-teal-900 text-white hover:bg-teal-700" href={TEL}>{home.intro.call_button}</a>
          </div>
          <div class="flex-1 w-full" style="flex-basis:35%">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {home.intro.stats.map((s) => (
                <div class:list={["bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex flex-col items-start", { "border-l-4 border-l-emerald-500": s.accent }]}>
                  <strong class="text-xs uppercase tracking-widest text-gray-400 mb-2">{s.kicker}</strong>
                  <h3 class="text-3xl font-serif text-teal-900 mb-2">{s.title}</h3>
                  <p class="text-sm text-gray-600 leading-relaxed">{s.body}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <HomeFeaturedPets home={home} pets={pets} />

    <div class="max-w-7xl mx-auto px-4 py-8">
      <section id="hs-hero-fence-widget" class="bg-teal-900 rounded-3xl overflow-hidden shadow-lg flex flex-col lg:flex-row text-white" aria-labelledby="hs-hero-fence-title">
        <div class="flex flex-col lg:flex-row w-full">
          <div class="p-8 sm:p-12 lg:p-16 w-full lg:w-1/2 flex flex-col justify-center">
            <p class="text-emerald-300 font-bold uppercase tracking-widest text-sm mb-4">{home.hero_fence.kicker}</p>
            <h2 id="hs-hero-fence-title" class="text-4xl sm:text-5xl font-serif mb-6">{home.hero_fence.title}</h2>
            {home.hero_fence.body.map((p) => <p class="text-teal-50 text-lg mb-6 leading-relaxed">{p}</p>)}
            <div class="bg-white/10 p-4 rounded-xl text-sm text-teal-100 mb-8 border border-white/10">{home.hero_fence.note}</div>
            <div class="mt-auto">
              <a class="inline-flex items-center justify-center px-8 py-4 bg-emerald-500 text-teal-900 rounded-full font-bold uppercase tracking-wider transition-all hover:bg-emerald-400 shadow-sm hover:-translate-y-1" href={home.hero_fence.cta.href}>{home.hero_fence.cta.label}</a>
            </div>
          </div>
          <div class="w-full lg:w-1/2 relative min-h-[400px]" aria-hidden="true">
            <img class="absolute inset-0 w-full h-full object-cover" decoding="async" src={home.hero_fence.image} alt={home.hero_fence.image_alt} loading="lazy" />
          </div>
        </div>
      </section>
    </div>

    <div class="max-w-7xl mx-auto px-4 py-8">
      <div class="bg-white rounded-3xl overflow-hidden shadow-sm border border-gray-100">
        <div class="flex flex-col lg:flex-row items-stretch">
          <div class="w-full lg:w-5/12 bg-gray-100 relative min-h-[300px]" style="flex-basis:45%">
            <figure class="absolute inset-0 w-full h-full">
              <img class="w-full h-full object-cover" loading="lazy" decoding="async" src={home.feature_card.image} alt={home.feature_card.image_alt} />
            </figure>
          </div>
          <div class="w-full lg:w-7/12 p-8 sm:p-12 lg:p-16 flex flex-col justify-center" style="flex-basis:55%">
            <p class="text-emerald-500 font-bold uppercase tracking-widest text-sm mb-3">{home.feature_card.label}</p>
            <h2 class="text-4xl font-serif text-teal-900 mb-6 leading-tight">{home.feature_card.title}</h2>
            <p class="text-lg text-gray-700 leading-relaxed mb-8">{home.feature_card.copy}</p>
            <div class="flex flex-wrap gap-4">
              <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-8 py-4 rounded-full transition-all shadow-md hover:-translate-y-1 bg-teal-700 text-white hover:bg-teal-900" href="/adoptions">{home.feature_card.buttons[0].label}</a>
              <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-8 py-4 rounded-full transition-all border-2 border-teal-700 text-teal-700 hover:-translate-y-1 hover:bg-teal-50" href="/dog-and-cat-shelter">{home.feature_card.buttons[1].label}</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <HomeSponsors home={home} sponsors={sponsors} />
    <HomePartners home={home} sponsors={sponsors} />
    <HomeTestimonials home={home} reviews={reviewsData} />
    <HomeDonations home={home} />

    <div class="max-w-7xl mx-auto px-4 py-8" id="Social">
      <div class="bg-blue-50 rounded-3xl p-8 sm:p-12 shadow-sm border border-blue-100 flex flex-col sm:flex-row items-center gap-8">
        <div class="flex-shrink-0 w-20 h-20 rounded-full bg-[#1877F2] flex items-center justify-center text-white shadow-lg" aria-hidden="true">
          <svg class="w-10 h-10" viewBox="0 0 24 24" fill="currentColor">
            <path d="M22 12.06C22 6.51 17.52 2 12 2S2 6.51 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94Z"/>
          </svg>
        </div>
        <div class="flex-1 text-center sm:text-left">
          <p class="text-blue-600 font-bold uppercase tracking-widest text-sm mb-2">Follow along</p>
          <h2 class="text-3xl font-serif text-teal-900 mb-3 leading-tight">Find us on Facebook</h2>
          <p class="text-gray-700 leading-relaxed mb-6">Photos, adoption updates, and shelter news, posted as they happen. Give us a follow to stay in the loop between visits.</p>
          <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-8 py-4 rounded-full transition-all shadow-md hover:-translate-y-1 bg-[#1877F2] text-white hover:bg-blue-700" href={SITE.integrations.social.facebook} target="_blank" rel="noopener noreferrer">Visit our Facebook page</a>
        </div>
      </div>
    </div>

    <HomeNewsletter home={home} latestNewsletter={latestNewsletter} />
    <HomeFAQ home={home} />
    <HomeAccomplishments home={home} />
    <HomeGames home={home} />
    <HomeContact home={home} />
  </div>
</BaseLayout>

<script>
  function initHomePage() {
    const fpwDialog = document.getElementById('featuredPetsFsDialog') as HTMLDialogElement | null;
    const fpwExpand = document.getElementById('fpwExpandBtn');
    if (fpwDialog && fpwExpand) {
      fpwExpand.addEventListener('click', () => {
        const mount = fpwDialog.querySelector('#fpw-fs-longest');
        const row = document.getElementById('longestRow');
        if (mount && row && !mount.childElementCount) {
          mount.innerHTML = row.innerHTML;
        }
        fpwDialog.showModal();
      });
      fpwDialog.querySelector('.fpw-fs-dialog__close')?.addEventListener('click', () => fpwDialog.close());
    }
  }
  document.addEventListener('astro:page-load', initHomePage);
</script>