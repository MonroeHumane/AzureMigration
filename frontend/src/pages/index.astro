        <h2 class="wp-block-heading">{home.newsletter.title}</h2>
        <p class="wp-block-paragraph">{home.newsletter.intro}</p>

        <div class="monroe-home-newsletter-slot">
          <section id="hs-news-2025review" class="hs-news-section" aria-labelledby="hs-news-2025review-title" data-hs-lightbox="hsLb-181">
            <div class="hs-wrap">
              <div class="hs-card" role="region" aria-label="2025 in Review">
                <div class="hs-hero">
                  <img src={home.newsletter.hero_image} alt="2025 in Review" width="1200" height="400" decoding="async" loading="lazy" />
                  <div class="hs-hero-overlay"></div>
                  <div class="hs-hero-text">
                    <div class="hs-eyebrow">{home.newsletter.eyebrow}</div>
                    <h3 class="hs-hero-title">{home.newsletter.label}</h3>
                  </div>
                </div>
                <div class="hs-head">
                  <div>
                    <h3 id="hs-news-2025review-title" class="hs-title">{home.newsletter.title}</h3>
                    <div class="hs-sub">{home.newsletter.byline}</div>
                  </div>
                  <div class="hs-actions" role="group" aria-label="Quick pet filters">
                    {home.newsletter.filters.map((f) => (
