---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPets } from '../lib/directus';
import home from '../data/homepage.json';
import reviewsData from '../data/reviews.json';
import MobileTOC from '../components/MobileTOC.astro';
import HomeNewsletterSection from '../components/home/HomeNewsletterSection.astro';
import HomeFeaturedPets from '../components/home/HomeFeaturedPets.astro';
import HomeEventsSection from '../components/home/HomeEventsSection.astro';
import HomeTestimonialsSection from '../components/home/HomeTestimonialsSection.astro';
import HomeAccomplishmentsSection from '../components/home/HomeAccomplishmentsSection.astro';
import HomeDonationsSection from '../components/home/HomeDonationsSection.astro';
import HomeVetPartnersSection from '../components/home/HomeVetPartnersSection.astro';
import HomeAuctionSponsorsSection from '../components/home/HomeAuctionSponsorsSection.astro';
import HomeSponsorsMarquee from '../components/home/HomeSponsorsMarquee.astro';
import HomeMembershipSection from '../components/home/HomeMembershipSection.astro';
import HomeSupporterStorySection from '../components/home/HomeSupporterStorySection.astro';
import HomeSocialSection from '../components/home/HomeSocialSection.astro';
import HomeFaqSection from '../components/home/HomeFaqSection.astro';
import HomeGamesSection from '../components/home/HomeGamesSection.astro';
import HomeContactSection from '../components/home/HomeContactSection.astro';
import HomeHeroSection from '../components/home/HomeHeroSection.astro';
import HomeIntroSection from '../components/home/HomeIntroSection.astro';
import HomeHeroFenceSection from '../components/home/HomeHeroFenceSection.astro';
import HomeFeatureCardSection from '../components/home/HomeFeatureCardSection.astro';

import '../styles/monroe-home.css';
import '../styles/monroe-home-widgets.css';

import { getSiteSettings, getEventFlyers, getNewsletterIssues, getFeaturedNewsletterIssue } from '../lib/directus';
import { hasLetterBody, renderLetterHtml } from '../scripts/newsletter-hydrate';
const pets = (await getPets()).slice(0, 6);
const settings = await getSiteSettings();
const events = await getEventFlyers();
const newsletters = await getNewsletterIssues();
const featuredNewsletter = await getFeaturedNewsletterIssue();
const now = new Date();

// Spotlight the soonest genuinely upcoming flyer event, not just whichever
// one happens to sort first in the data — events[0] was surfacing a Gala
// from months ago as the "latest" event long after it had passed.
const latestEvent = events
  .filter((e) => e.event_date && new Date(e.event_date) >= now)
  .sort((a, b) => new Date(a.event_date!).getTime() - new Date(b.event_date!).getTime())[0];
const latestNewsletter = featuredNewsletter || newsletters[0] || null;
const latestLetterHtml = renderLetterHtml(latestNewsletter);
const showHomeLetter = hasLetterBody(latestNewsletter);

// "Next event" widget: spotlight the soonest upcoming event from event flyers if present,
// falling back to home.next_event.
const nextEvent = latestEvent
  ? {
      kicker: 'Latest event',
      date: new Date(latestEvent.event_date + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }),
      title: latestEvent.title,
      time: latestEvent.description || '',
      buttons: home.next_event.buttons,
    }
  : home.next_event;

// Upcoming flyers for homepage rail — same Directus collection / sort path as /events.
const upcomingFlyers = events
  .filter((e) => e.event_date && new Date(e.event_date) >= now)
  .sort((a, b) => new Date(a.event_date!).getTime() - new Date(b.event_date!).getTime());

interface Review { author?: string; rating?: number; time?: number; text?: string }
type HomeReview = { author: string; text: string; rating?: number; time?: number };
const reviews = (reviewsData as Review[]).filter((r): r is HomeReview => Boolean(r.author && r.text));

if (home.accomplishments.years['2025']) {
  home.accomplishments.years['2025'][0].value = settings.adoptions_count;
  home.accomplishments.years['2025'][0].display = settings.adoptions_count.toLocaleString();
  home.accomplishments.years['2025'][1].value = settings.return_to_owner_count;
  home.accomplishments.years['2025'][1].display = settings.return_to_owner_count.toLocaleString();
  home.accomplishments.years['2025'][2].value = settings.intakes_count;
  home.accomplishments.years['2025'][2].display = settings.intakes_count.toLocaleString();
}

const accomplishmentYears = Object.keys(home.accomplishments.years).sort((a, b) => Number(b) - Number(a));
const defaultAccomplishmentYear = accomplishmentYears[0];



const sideNavSections = [
  { id: 'Top', title: 'Top' },
  { id: 'Events', title: 'Events & News' },
  { id: 'Intro', title: 'About Our Shelter' },
  { id: 'FeaturedPets', title: 'Find a Pet' },
  { id: 'hs-hero-fence-widget', title: 'Hero Fence' },
  { id: 'VetPartners', title: 'Vet Care Partners' },
  { id: 'furry-friends-auction-sponsors', title: 'Auction Benefactors' },
  { id: 'sponsorMarqueeWidget', title: 'Sponsors' },
  { id: 'Membership', title: 'Membership' },
  { id: 'Testimonials', title: 'Community Voices' },
  { id: 'SupporterStory', title: 'Supporter Story' },
  { id: 'Donations', title: 'Donations & Giving' },
  { id: 'Social', title: 'Facebook' },
  { id: 'Newsletter', title: latestNewsletter?.title || 'Newsletter' },
  { id: 'FAQ', title: 'Shelter FAQ' },
  { id: 'Accomplishments', title: 'Annual Outcomes' },
  { id: 'Games', title: 'Shelter Games' },
  { id: 'Contact', title: 'Contact & Hours' },
];
---

<BaseLayout
  title="Animal Shelter | Monroe County | 734-243-3669"
  description={home.hero.copy}
  bodyClass="home-editable-has-flyers-rail"
>
  <!-- Floating Side Homepage Navigation Dock: seamless hover overlay, zero layout shift -->
  <nav class="home-side-dock" id="homeSideDock" aria-label="On this page navigation">
    <div class="home-side-dock__panel">
      <div class="home-side-dock__header" aria-hidden="true">
        <svg class="home-side-dock__header-icon" viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <span class="home-side-dock__header-title">On This Page</span>
      </div>
      <ul class="home-side-dock__list" role="list">
        {sideNavSections.map((sec) => (
          <li>
            <a href={`#${sec.id}`} class="home-side-dock__link" data-dock-target={sec.id}>
              <span class="home-side-dock__dot" aria-hidden="true"></span>
              <span class="home-side-dock__text">{sec.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <MobileTOC sections={sideNavSections} />

  <div class="home-editable-shell is-layout-constrained">
    <!-- 1. Hero / cover: native Astro component (Phase 3 — hybrid BEM for parity) -->
    <HomeHeroSection />

    <!-- 2. Events band: native Astro component (Phase 3) -->
    <HomeEventsSection
      pets={pets}
      latestEvent={latestEvent}
      nextEvent={nextEvent}
      upcomingFlyers={upcomingFlyers}
    />

    <!-- 3. Intro: native Astro component (Phase 3 — hybrid BEM for parity) -->
    <HomeIntroSection />

    <!-- 4. Featured pets: native Astro component (Phase 3) -->
    <HomeFeaturedPets pets={pets} />

    <!-- 5. Hero Fence: native Astro component (Phase 3 — hybrid BEM for parity) -->
    <HomeHeroFenceSection />

    <!-- 6. Feature card: native Astro component (Phase 3 — hybrid BEM for parity) -->
    <HomeFeatureCardSection />

    <!-- 7. Vet partners: native Astro component (Phase 3) -->
    <HomeVetPartnersSection />

    <!-- 8. Auction sponsors: native Astro component (Phase 3) -->
    <HomeAuctionSponsorsSection />

    <!-- 9. Community partners marquee: native Astro component (Phase 3) -->
    <HomeSponsorsMarquee />

    <!-- 10. Membership: native Astro component (Phase 3) -->
    <HomeMembershipSection />

    <!-- 11. Testimonials: native Astro component (Phase 3) -->
    <HomeTestimonialsSection reviews={reviews} />

    <!-- 11b. Supporter Story: native Astro component (Phase 3) -->
    <HomeSupporterStorySection />

    <!-- 12. Donations: native Astro component (Phase 3) -->
    <HomeDonationsSection />

    <!-- 13. Social: native Astro component (Phase 3) -->
    <HomeSocialSection />

    <!-- 14. Newsletter: native Astro component (Phase 3) -->
    <HomeNewsletterSection issue={latestNewsletter} />

    <!-- 15. FAQ: native Astro component (Phase 3) -->
    <HomeFaqSection />

    <!-- 16. Accomplishments: native Astro component (Phase 3) -->
    <HomeAccomplishmentsSection
      years={home.accomplishments.years}
      yearOrder={accomplishmentYears}
      defaultYear={defaultAccomplishmentYear}
    />

    <!-- 17. Games: native Astro component (Phase 3) -->
    <HomeGamesSection />

    <!-- 18. Contact: native Astro component (Phase 3) -->
    <HomeContactSection />

    <!-- 12. Donations -->
    <div class="wp-block-group alignwide home-editable-section is-layout-constrained">
      <div class="wp-block-group home-editable-donate-card home-editable-runtime-card is-layout-constrained" id="Donations">
        <p class="home-editable-section-label wp-block-paragraph">{home.donations.label}</p>
        <h2 class="wp-block-heading">{home.donations.title}</h2>
        <p class="wp-block-paragraph">{home.donations.intro}</p>

        <div class="home-editable-paypal-giving home-editable-paypal-giving--split">
          <div class="home-editable-paypal-giving-split">
            <div class="home-editable-paypal-giving-split__col">
              <div class="pp-giving-wrapper">
                <iframe src={home.donations.cat_room.href} style="width:100%; height:550px; border:1px solid rgba(15,118,110,0.15); border-radius:1rem; box-shadow:0 20px 48px rgba(17,41,41,0.12); background:#fff;" title="Donate to the Cat Room"></iframe>
              </div>
            </div>
            <div class="home-editable-paypal-giving-split__col">
              <div class="pp-giving-wrapper">
                <iframe src={home.donations.general.href} style="width:100%; height:550px; border:1px solid rgba(15,118,110,0.15); border-radius:1rem; box-shadow:0 20px 48px rgba(17,41,41,0.12); background:#fff;" title="Make a Difference"></iframe>
              </div>
            </div>
          </div>
          <div class="offline-donations" style="margin-top:2rem;">
            <div class="offline-donations-header">
              <h4>{home.donations.offline.title}</h4>
              <p>{home.donations.offline.label}</p>
            </div>
            <div class="offline-donations-body">
              <div class="offline-donations-amount">{home.donations.offline.amount}</div>
              <div class="offline-donations-label">{home.donations.offline.caption}</div>
            </div>
          </div>
        </div>
          <div class="wp-block-columns home-editable-give-grid is-layout-flex">
          {home.donations.tiles.map((tile) => (
            <div class="wp-block-column is-layout-flow">
              <div class="wp-block-group home-editable-give-tile is-layout-constrained" id={tile.title === 'Volunteer' ? 'Volunteer' : undefined}>
                <h3 class="wp-block-heading">{tile.title}</h3>
                <p class="wp-block-paragraph">{tile.copy}</p>
                <div class:list={['wp-block-button', { 'is-style-outline': tile.variant === 'outline' }]}> 
                  <a
                    class:list={['wp-block-button__link wp-element-button', { 'has-base-color has-contrast-background-color has-text-color has-background': tile.variant !== 'outline' }]}
                    href={tile.href}
                    {...(tile.external ? { target: '_blank', rel: 'noreferrer noopener' } : {})}
                  >
                    {tile.button}
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- 13. Social: live Facebook Page Plugin. The `.home-editable-social-embed__*`
         classes below already existed in monroe-home.css (a chrome/viewport/iframe/
         loader structure with an always-visible "Open on Facebook" CTA baked into the
         loader itself) from an earlier attempt at this same embed — reusing it here
         rather than inventing new markup. That CTA is plain HTML, not JS-gated, so a
         real Facebook link stays visible even if the iframe is blocked by tracking
         protection/ad-blockers (the reason a live embed was reverted once before) or
         if JS never runs at all. -->
    <!-- 13. Social: live Facebook Page Plugin & Shelter Community Hub -->
    <div class="wp-block-group alignwide home-editable-section is-layout-constrained" id="Social">
      <div class="home-editable-social-split-wrap">
        <div class="home-editable-social-split-grid">
          
          <!-- Left Column: Shelter Social Community Hub -->
          <div class="home-editable-social-info-col">
            <div class="home-editable-social-badge-row">
              <span class="home-editable-social-badge">
                <svg class="home-editable-social-badge__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M22 12.06C22 6.51 17.52 2 12 2S2 6.51 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94Z"/>
                </svg>
                <span>Follow Along &bull; @adopthsmc</span>
              </span>
              <span class="home-editable-social-pill">Live Community Feed</span>
            </div>

            <h2 class="home-editable-social-title">
              Find Us on Facebook
            </h2>

            <p class="home-editable-social-desc">
              Photos, emergency intakes, urgent lost &amp; found alerts, and heartwarming adoption celebrations posted in real time. Follow our official page to stay connected between shelter visits and help Monroe County rescues find loving forever homes.
            </p>

            <!-- Community Highlights Grid -->
            <div class="home-editable-social-features">
              <div class="home-editable-social-feature-item">
                <div class="home-editable-social-feature-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                  </svg>
                </div>
                <div>
                  <h3 class="home-editable-social-feature-heading">Daily Rescue Intakes</h3>
                  <p class="home-editable-social-feature-text">Be the first to see newly arrived shelter cats and dogs ready for foster or adoption.</p>
                </div>
              </div>

              <div class="home-editable-social-feature-item">
                <div class="home-editable-social-feature-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                    <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
                  </svg>
                </div>
                <div>
                  <h3 class="home-editable-social-feature-heading">Lost &amp; Found Pet Network</h3>
                  <p class="home-editable-social-feature-text">Fast community-powered alerts helping reunite missing pets with local families.</p>
                </div>
              </div>

              <div class="home-editable-social-feature-item">
                <div class="home-editable-social-feature-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                    <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/>
                  </svg>
                </div>
                <div>
                  <h3 class="home-editable-social-feature-heading">Events &amp; Clinic Dates</h3>
                  <p class="home-editable-social-feature-text">Schedules for affordable community vaccine clinics, microchip events, and fundraisers.</p>
                </div>
              </div>

              <div class="home-editable-social-feature-item">
                <div class="home-editable-social-feature-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                    <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="home-editable-social-feature-heading">“Happy Tails” Updates</h3>
                  <p class="home-editable-social-feature-text">Celebrating shelter alumni thriving in their new homes with loving families.</p>
                </div>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="home-editable-social-actions">
              <a
                class="home-editable-social-btn home-editable-social-btn--primary"
                href={SITE.integrations.social.facebook}
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
                <span>Visit @adopthsmc on Facebook →</span>
              </a>
              <a
                class="home-editable-social-btn home-editable-social-btn--secondary"
                href="/adopt"
              >
                <span>Meet Adoptable Pets →</span>
              </a>
            </div>
          </div>

          <!-- Right Column: Live Facebook Feed Embed -->
          <div class="home-editable-social-feed-col">
            <div class="home-editable-social-embed__frame">
              <div class="home-editable-social-embed" data-facebook-embed>
                <div class="home-editable-social-embed__chrome">
                  <div class="home-editable-social-embed__viewport">
                    <iframe
                      class="home-editable-social-embed__iframe border-0"
                      data-facebook-iframe
                      src={`https://www.facebook.com/plugins/page.php?href=${encodeURIComponent(SITE.integrations.social.facebook)}&tabs=timeline&width=500&height=650&small_header=false&adapt_container_width=true&hide_cover=true&show_facepile=false`}
                      allowfullscreen={true}
                      allow="encrypted-media"
                      loading="lazy"
                      title="Humane Society of Monroe County on Facebook"
                    ></iframe>
                    <div class="home-editable-social-embed__loader">
                      <div class="home-editable-social-embed__loader-icon" aria-hidden="true">
                        <svg class="w-8 h-8 text-[#1877f2]" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                        </svg>
                      </div>
                      <strong style="font-size: 1.05rem; font-weight: 700; color: #163433; margin-bottom: 0.25rem;">Humane Society of Monroe County</strong>
                      <p class="home-editable-social-embed__loader-text">Daily shelter news, intakes &amp; adoption stories</p>
                      <div class="home-editable-social-embed__cta">
                        <a class="home-editable-social-embed__open" href={SITE.integrations.social.facebook} target="_blank" rel="noopener noreferrer">Visit @adopthsmc on Facebook</a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- 14. Newsletter: featured published issue -->
    <div class="wp-block-group alignwide home-editable-section home-editable-newsletter-section is-layout-constrained">
      <div class="wp-block-group home-editable-news-card home-editable-runtime-card is-style-monroe-news-band is-layout-constrained" id="Newsletter">
        <p class="home-editable-section-label wp-block-paragraph" id="newsletter-section-label" data-nl-label>{latestNewsletter?.title || home.newsletter.label}</p>
        <h2 class="wp-block-heading" data-nl-masthead>{latestNewsletter?.newsletter_title || home.newsletter.title}</h2>
        <p class="wp-block-paragraph home-nl-band-intro">{home.newsletter.intro}</p>

        <article class="home-nl" data-newsletter-home aria-labelledby="hs-news-featured-title">
          <div class="home-nl__layout">
            <div class="home-nl__photo">
              <img
                data-nl-hero
                src={latestNewsletter?.hero_image || home.newsletter.hero_image}
                alt={latestNewsletter?.title || 'Latest newsletter'}
                width="1168"
                height="514"
                decoding="async"
                loading="lazy"
              />
            </div>
            <div class="home-nl__letter">
              <p class="home-nl__kicker" data-nl-topline>{latestNewsletter?.top_line || home.newsletter.eyebrow}</p>
              <p class="home-nl__date" data-nl-date>{latestNewsletter ? formatDate(latestNewsletter.issue_date, '') : ''}</p>
              <h3 id="hs-news-featured-title" class="home-nl__title" data-nl-title>{latestNewsletter?.title || home.newsletter.title}</h3>
              <p class="home-nl__byline" data-nl-byline>{latestNewsletter?.byline || home.newsletter.byline}</p>
              <p class="home-nl__excerpt" data-nl-excerpt>{latestNewsletter?.excerpt || 'No published newsletter yet.'}</p>
              <div class="home-nl__actions">
                <a
                  data-nl-link
                  class="home-nl__btn home-nl__btn--primary"
                  href={latestNewsletter?.slug ? `/newsletter/issue/${latestNewsletter.slug}` : '/newsletter'}
                >{latestNewsletter ? 'Read the letter' : 'View archive'}</a>
                <a
                  data-nl-pdf
                  class:list={['home-nl__btn', 'home-nl__btn--ghost', !latestNewsletter?.pdf_url && 'home-nl__btn--off']}
                  href={latestNewsletter?.pdf_url || '#'}
                  target="_blank"
                  rel="noopener noreferrer"
                >Download PDF</a>
                <a class="home-nl__btn home-nl__btn--ghost" href="/newsletter">All issues</a>
              </div>
            </div>
          </div>

          <details class="home-nl-read" hidden={!showHomeLetter}>
            <summary class="home-nl-read__toggle">
              <span class="home-nl-read__toggle-copy">
                <span class="home-nl-read__toggle-open">Read the full letter</span>
                <span class="home-nl-read__toggle-close">Close letter</span>
              </span>
              <span class="home-nl-read__chevron" aria-hidden="true"></span>
            </summary>
            <div class="home-nl-read__panel">
              <div class="home-nl-read__paper">
                <header class="home-nl-read__head">
                  <p class="home-nl-read__kicker" data-nl-topline-letter>{latestNewsletter?.top_line || home.newsletter.eyebrow}</p>
                  <p class="home-nl-read__date" data-nl-date-letter>{latestNewsletter ? formatDate(latestNewsletter.issue_date, '') : ''}</p>
                  <h4 class="home-nl-read__title">{latestNewsletter?.title || home.newsletter.title}</h4>
                  <p class="home-nl-read__byline">{latestNewsletter?.byline || home.newsletter.byline}</p>
                </header>
                <div class="home-nl-read__body" data-nl-full-letter set:html={latestLetterHtml}></div>
                <button type="button" class="home-nl-read__done" data-nl-letter-close>Close letter</button>
              </div>
            </div>
          </details>
        </article>
      </div>
    </div>

    <!-- 15. FAQ -->
    <div class="wp-block-group alignwide home-editable-section is-layout-constrained">
      <div class="wp-block-group home-editable-faq-card is-layout-constrained" id="FAQ">
        <p class="home-editable-section-label wp-block-paragraph">{home.faq.label}</p>
        <h2 class="wp-block-heading">{home.faq.title}</h2>
        <p class="wp-block-paragraph">{home.faq.intro}</p>
        <div class="wp-block-columns home-editable-faq-grid is-layout-flex">
          {home.faq.tiles.map((tile) => (
            <div class="wp-block-column is-layout-flow">
              <div class="wp-block-group home-editable-faq-tile is-layout-constrained">
                <h3 class="wp-block-heading">{tile.title}</h3>
                <p class="wp-block-paragraph">{tile.copy}</p>
                <div class="wp-block-button">
                  <a class="wp-block-button__link has-base-color has-contrast-background-color has-text-color has-background wp-element-button" href={tile.href} {...(tile.external ? { target: '_blank', rel: 'noreferrer noopener' } : {})}>{tile.button}</a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- 16. Accomplishments -->
    <div id="Accomplishments" class="wp-block-group alignwide home-editable-section home-editable-accomplishments-band is-layout-constrained">
      <div class="wp-block-group home-editable-accomplishments-card is-layout-constrained">
        <p class="has-text-align-center home-editable-pill wp-block-paragraph">{home.accomplishments.pill}</p>
        <h2 class="wp-block-heading has-text-align-center home-editable-heading-impact">{home.accomplishments.title}</h2>
        <p class="has-text-align-center wp-block-paragraph">{home.accomplishments.intro}</p>

        <div class="monroe-accomplishments-widget home-editable-accomplishments-grid" data-monroe-accomplishments-widget>
          <div class="monroe-accomplishments-widget__tabs" role="tablist" aria-label="Shelter outcome years">
            {accomplishmentYears.map((year) => (
              <button
                type="button"
                class:list={['monroe-accomplishments-widget__tab', { 'is-active': year === defaultAccomplishmentYear }]}
                role="tab"
                id={`monroe-accomplishments-tab-${year}`}
                aria-selected={year === defaultAccomplishmentYear ? 'true' : 'false'}
                aria-controls={`monroe-accomplishments-panel-${year}`}
                data-accomplishments-year={year}
              >
                {year}
              </button>
            ))}
          </div>
          {accomplishmentYears.map((year) => {
            const stats = home.accomplishments.years[year as keyof typeof home.accomplishments.years];
            return (
            <div
              class:list={['monroe-accomplishments-widget__panel', { 'is-active': year === defaultAccomplishmentYear }]}
              role="tabpanel"
              id={`monroe-accomplishments-panel-${year}`}
              aria-labelledby={`monroe-accomplishments-tab-${year}`}
              data-accomplishments-panel={year}
              hidden={year !== defaultAccomplishmentYear}
            >
              <div class="monroe-accomplishments-widget__stats">
                {stats.map((s) => (
                  <div class:list={['monroe-accomplishments-stat', 'is-tile', { 'is-accent': s.accent }]}> 
                    <span class="monroe-accomplishments-stat__value" data-count={s.value}>{s.display}</span>
                    <span class="monroe-accomplishments-stat__label">{s.label}</span>
                  </div>
                ))}
              </div>
            </div>
            );
          })}
        </div>
      </div>
    </div>

    <!-- 17. Games -->
    <div id="Games" class="wp-block-group alignwide home-editable-section home-editable-games-band is-layout-flow">
      <div class="wp-block-group home-editable-games-card is-layout-constrained">
        <p class="has-text-align-center home-editable-pill wp-block-paragraph">{home.games.pill}</p>
        <div class="home-editable-games-head">
          <h2 class="wp-block-heading has-text-align-center home-editable-heading-impact" id="home-games-heading">{home.games.title}</h2>
          <p class="has-text-align-center home-editable-games-intro">{home.games.intro}</p>
        </div>
        <ul class="home-editable-games-teasers" role="list">
          {home.games.teasers.map((t) => (
            <li class="home-editable-games-teasers__item">
              <a class="home-editable-games-teasers__link" href="/games">
                <span class="home-editable-games-teasers__icon" aria-hidden="true">{t.icon}</span>
                <span class="home-editable-games-teasers__title">{t.title}</span>
                <span class="home-editable-games-teasers__desc">{t.desc}</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="wp-block-buttons is-content-justification-center home-editable-games-cta">
          <div class="wp-block-button">
            <a class="wp-block-button__link has-base-color has-contrast-background-color has-text-color has-background wp-element-button" href="/games">{home.games.cta}</a>
          </div>
        </div>
      </div>
    </div>

    <!-- 18. Contact -->
    <div class="wp-block-group alignwide home-editable-section is-layout-constrained">
      <div class="wp-block-group home-editable-contact-card is-layout-constrained" id="Contact">
        <p class="home-editable-pill wp-block-paragraph">{home.contact.pill}</p>
        <h2 class="wp-block-heading home-editable-heading-impact">{home.contact.title}</h2>
        <p class="wp-block-paragraph">{home.contact.intro}</p>

        <div class="monroe-contact-form-wrap">
          <div aria-live="polite" aria-atomic="true" class="monroe-contact-form__feedback"></div>
          <p class="monroe-contact-form__lead">{home.contact.lead}</p>
          <form class="monroe-contact-form" data-monroe-contact-mailto data-email={home.contact.email}>
            <p class="monroe-contact-form__hp" aria-hidden="true">
              <label for="monroe_contact_website">Website</label>
              <input type="text" name="monroe_contact_website" id="monroe_contact_website" value="" tabindex="-1" autocomplete="off" />
            </p>
            <div class="monroe-contact-form__grid">
              <p class="monroe-contact-form__field">
                <label for="monroe_contact_name">Name{" "}<span class="required">*</span></label>
                <input type="text" name="monroe_contact_name" id="monroe_contact_name" required autocomplete="name" placeholder="Name" value="" />
              </p>
              <p class="monroe-contact-form__field">
                <label for="monroe_contact_phone">Phone</label>
                <input type="tel" name="monroe_contact_phone" id="monroe_contact_phone" inputmode="tel" autocomplete="tel" placeholder="Phone" value="" />
              </p>
            </div>
            <p class="monroe-contact-form__field">
              <label for="monroe_contact_email">Email{" "}<span class="required">*</span></label>
              <input type="email" name="monroe_contact_email" id="monroe_contact_email" required autocomplete="email" placeholder="Email" value="" />
            </p>
            <p class="monroe-contact-form__field">
              <label for="monroe_contact_message">Message{" "}<span class="required">*</span></label>
              <textarea name="monroe_contact_message" id="monroe_contact_message" rows="5" required placeholder="Message"></textarea>
            </p>
            <p class="monroe-contact-form__submit">
              <button type="submit" class="wp-block-button__link wp-element-button monroe-contact-form__button">{home.contact.submit}</button>
            </p>
          </form>
        </div>

        <div class="wp-block-buttons is-layout-flex">
          <div class="wp-block-button">
            <a class="wp-block-button__link has-base-color has-contrast-background-color has-text-color has-background wp-element-button" href={TEL}>{home.contact.call_button}</a>
          </div>
        </div>

        <div class="home-editable-contact-location">
          <div class="home-editable-contact-location__map">
            <iframe
              src={`https://www.google.com/maps?q=${encodeURIComponent(SITE.contact.address.full)}&output=embed`}
              width="100%"
              height="280"
              style="border:0;"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Map to Humane Society of Monroe County"
            ></iframe>
          </div>
          <div class="home-editable-contact-location__details">
            <p class="home-editable-contact-location__address">{SITE.contact.address.full}</p>
            <p class="home-editable-contact-location__hours-badge" data-hours-badge>
              <span class="home-editable-contact-location__hours-dot" data-hours-dot aria-hidden="true"></span>
              <span data-hours-text>Checking hours…</span>
            </p>
            <ul class="home-editable-contact-location__hours-list">
              <li><span>Tue – Fri</span><span>{SITE.contact.hours.tuesdayToFriday}</span></li>
              <li><span>Saturday</span><span>{SITE.contact.hours.saturday}</span></li>
              <li><span>Sun – Mon</span><span>{SITE.contact.hours.sundayMonday}</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>

  </div>
</BaseLayout>

<script>
  import { hydrateHomeNewsletter } from '../scripts/newsletter-hydrate';

  function initHomePage() {
    hydrateHomeNewsletter();
    const fpwDialog = document.getElementById('featuredPetsFsDialog') as HTMLDialogElement | null;
    const fpwExpand = document.getElementById('fpwExpandBtn');
    if (fpwDialog && fpwExpand && fpwExpand.dataset.bound !== '1') {
      fpwExpand.dataset.bound = '1';
      fpwExpand.addEventListener('click', () => {
        const mount = fpwDialog.querySelector('#fpw-fs-longest');
        // Pull cards from the primary strip only — `#longestRow` also
        // contains an aria-hidden `.scroll-strip--clone` (duplicate cards
        // used to loop the auto-scroll marquee) plus the marquee's own
        // scroll-viewport/scroll-track wrapper and animation, none of which
        // belong in the static full-screen grid.
        const primaryStrip = document.querySelector('#longestRow .scroll-strip--primary');
        if (mount && primaryStrip && !mount.childElementCount) {
          mount.innerHTML = primaryStrip.innerHTML;
        }
        fpwDialog.showModal();
      });
      fpwDialog.querySelector('.fpw-fs-close, .fpw-fs-dialog__close')?.addEventListener('click', () => fpwDialog.close());
    }

    // Scroll-reveal for below-the-fold sections. Anything already visible on
    // load is left completely alone (never hidden) so there's no dependency
    // on JS running for the page to display correctly — this only adds a
    // fade/rise to sections the visitor scrolls down to.
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const revealIO = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-revealed');
          revealIO.unobserve(entry.target);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -80px 0px' });
      document.querySelectorAll<HTMLElement>('.home-editable-section').forEach((section) => {
        if (section.dataset.revealBound === '1') return;
        section.dataset.revealBound = '1';
        const rect = section.getBoundingClientRect();
        if (rect.top < window.innerHeight * 0.85) return;
        section.classList.add('reveal-pending');
        revealIO.observe(section);
      });
    }

    // Contact form: mailto submission (no backend on the static site).
    const contactForm = document.querySelector<HTMLFormElement>('[data-monroe-contact-mailto]');
    if (contactForm) {
      contactForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const data = new FormData(contactForm);
        if (data.get('monroe_contact_website')) return; // honeypot
        const name = String(data.get('monroe_contact_name') || '');
        const email = String(data.get('monroe_contact_email') || '');
        const phone = String(data.get('monroe_contact_phone') || '');
        const message = String(data.get('monroe_contact_message') || '');
        const subject = encodeURIComponent(`Website contact from ${name}`);
        const body = encodeURIComponent(`${message}\n\n- ${name}${phone ? ` (${phone})` : ''}\n${email}`);
        const feedback = contactForm.closest('.monroe-contact-form-wrap')?.querySelector<HTMLElement>('.monroe-contact-form__feedback');
        if (feedback) feedback.textContent = 'Opening your email client to send your message. Thank you!';
        window.location.href = `mailto:${contactForm.dataset.email}?subject=${subject}&body=${body}`;
      });
    }

    // Facebook Page Plugin: best-effort fade of the loader overlay once the iframe
    // reports loaded. The loader's "Open on Facebook" link is plain HTML (see the
    // template), so it stays usable regardless of whether this fires.
    const facebookIframe = document.querySelector<HTMLIFrameElement>('[data-facebook-iframe]');
    facebookIframe?.addEventListener('load', () => {
      facebookIframe.closest('[data-facebook-embed]')?.classList.add('is-loaded');
    });

    // Side navigation dock: active scrollspy tracking
    const dockLinks = document.querySelectorAll<HTMLAnchorElement>('.home-side-dock__link');
    if (dockLinks.length && 'IntersectionObserver' in window) {
      const sectionMap = new Map<string, HTMLAnchorElement>();
      dockLinks.forEach((link) => {
        const id = link.dataset.dockTarget;
        if (id) sectionMap.set(id, link);
      });

      const dockIO = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const activeLink = sectionMap.get(entry.target.id);
            if (activeLink) {
              dockLinks.forEach((l) => l.classList.remove('is-active'));
              activeLink.classList.add('is-active');
            }
          }
        });
      }, { rootMargin: '-20% 0px -70% 0px' });

      sectionMap.forEach((_, id) => {
        const el = document.getElementById(id);
        if (el) dockIO.observe(el);
      });
    }

    // Shelter open/closed badge, computed from SITE.contact.hours (Tue-Fri 11am-4pm,
    // Sat 11am-3pm, closed Sun/Mon) — mirrors the same schedule already encoded in
    // BaseLayout's schema.org openingHoursSpecification, just evaluated against "now".
    const hoursBadge = document.querySelector<HTMLElement>('[data-hours-badge]');
    if (hoursBadge) {
      const hoursText = hoursBadge.querySelector<HTMLElement>('[data-hours-text]');
      const hoursDot = hoursBadge.querySelector<HTMLElement>('[data-hours-dot]');
      const now = new Date();
      const day = now.getDay(); // 0=Sun ... 6=Sat
      const minutes = now.getHours() * 60 + now.getMinutes();
      const openRange = day >= 2 && day <= 5
        ? { start: 11 * 60, end: 16 * 60, closeLabel: '4:00 PM' }
        : day === 6
          ? { start: 11 * 60, end: 15 * 60, closeLabel: '3:00 PM' }
          : null;
      const isOpen = !!openRange && minutes >= openRange.start && minutes < openRange.end;
      if (hoursText) {
        hoursText.textContent = isOpen
          ? `Open now — closes ${openRange!.closeLabel}`
          : 'Closed now — see hours below';
      }
      if (hoursDot) hoursDot.classList.toggle('is-open', isOpen);
    }

    // Hero video background & low-power / data-saver poster fallback
    const hero = document.getElementById('Top');
    if (hero) {
      const video = hero.querySelector<HTMLVideoElement>('[data-hero-video]');
      const toggleBtn = hero.querySelector<HTMLButtonElement>('[data-hero-video-toggle]');
      const toggleLabel = hero.querySelector<HTMLElement>('[data-hero-video-toggle-label]');

      if (video && toggleBtn && toggleBtn.dataset.bound !== '1') {
        toggleBtn.dataset.bound = '1';
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const prefersReducedData = window.matchMedia('(prefers-reduced-data: reduce)').matches;
        const saveData = !!(navigator as any).connection?.saveData;

        let isPaused = prefersReducedMotion || prefersReducedData || saveData;

        const updateToggleUI = (paused: boolean) => {
          if (paused) {
            hero.classList.add('is-motion-paused');
            toggleBtn.setAttribute('aria-label', 'Play background video');
            toggleBtn.setAttribute('title', 'Play background video');
            if (toggleLabel) toggleLabel.textContent = 'Play';
          } else {
            hero.classList.remove('is-motion-paused');
            toggleBtn.setAttribute('aria-label', 'Pause background video');
            toggleBtn.setAttribute('title', 'Pause background motion');
            if (toggleLabel) toggleLabel.textContent = 'Pause';
          }
        };

        const handleVideoPlaying = () => {
          if (!isPaused) {
            hero.classList.add('is-video-playing');
          }
        };

        video.addEventListener('playing', handleVideoPlaying);
        video.addEventListener('canplay', handleVideoPlaying);

        if (!video.paused) {
          handleVideoPlaying();
        }

        if (isPaused) {
          video.pause();
          updateToggleUI(true);
        } else {
          // Attempt playback; gracefully catch Low Power Mode / battery-saver rejections
          const playPromise = video.play();
          if (playPromise !== undefined) {
            playPromise
              .then(() => {
                handleVideoPlaying();
                updateToggleUI(false);
              })
              .catch(() => {
                // Autoplay blocked by browser policy / battery saver
                isPaused = true;
                updateToggleUI(true);
              });
          }
        }

        toggleBtn.addEventListener('click', () => {
          if (isPaused) {
            isPaused = false;
            updateToggleUI(false);
            video.play().then(handleVideoPlaying).catch(() => {});
          } else {
            isPaused = true;
            updateToggleUI(true);
            video.pause();
          }
        });
      }
    }
  }

  document.addEventListener('astro:page-load', initHomePage);
</script>
