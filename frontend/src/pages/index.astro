    <!-- 15. FAQ -->
    <div class="wp-block-group alignwide home-editable-section is-layout-constrained">
      <div class="wp-block-group home-editable-faq-card is-layout-constrained" id="FAQ">
        <p class="home-editable-section-label wp-block-paragraph">{home.faq.label}</p>
        <h2 class="wp-block-heading">{home.faq.title}</h2>
        <p class="wp-block-paragraph">{home.faq.intro}</p>
        <div class="wp-block-columns home-editable-faq-grid is-layout-flex">
          {home.faq.tiles.map((tile) => (
            <div class="wp-block-column is-layout-flow">
              <div class="wp-block-group home-editable-faq-tile is-layout-constrained">
                <h3 class="wp-block-heading">{tile.title}</h3>
                <p class="wp-block-paragraph">{tile.copy}</p>
                <div class="wp-block-button">
                  <a class="wp-block-button__link has-base-color has-contrast-background-color has-text-color has-background wp-element-button" href={tile.href} {...(tile.external ? { target: '_blank', rel: 'noreferrer noopener' } : {})}>{tile.button}</a>
                </div>
              </div>
            </div>
          ))}
