</BaseLayout>

<script>
  function initHomePage() {
    // Featured pets: Expand view opens a <dialog> with the same cards.
    const fpwDialog = document.getElementById('featuredPetsFsDialog') as HTMLDialogElement | null;
    const fpwExpand = document.getElementById('fpwExpandBtn');
    if (fpwDialog && fpwExpand) {
      fpwExpand.addEventListener('click', () => {
        const mount = fpwDialog.querySelector('#fpw-fs-longest');
        // Pull cards from the primary strip only — `#longestRow` also
        // contains an aria-hidden `.scroll-strip--clone` (duplicate cards
        // used to loop the auto-scroll marquee) plus the marquee's own
        // scroll-viewport/scroll-track wrapper and animation, none of which
        // belong in the static full-screen grid.
        const primaryStrip = document.querySelector('#longestRow .scroll-strip--primary');
        if (mount && primaryStrip && !mount.childElementCount) {
          mount.innerHTML = primaryStrip.innerHTML;
        }
        fpwDialog.showModal();
      });
      fpwDialog.querySelector('.fpw-fs-close, .fpw-fs-dialog__close')?.addEventListener('click', () => fpwDialog.close());
    }

    // Newsletter lightbox.
    const newsSection = document.querySelector<HTMLElement>('[data-hs-lightbox]');
    if (newsSection) {
      const lb = newsSection.querySelector<HTMLElement>('.hs-lightbox');
      const lbImg = lb?.querySelector<HTMLImageElement>('[data-hs-lb-img]');
      const thumbs = Array.from(newsSection.querySelectorAll<HTMLElement>('[data-hs-lb-src]'));
      let current = 0;
      const show = (i: number) => {
        current = (i + thumbs.length) % thumbs.length;
        const src = thumbs[current].dataset.hsLbSrc;
        if (lbImg && src) lbImg.src = src;
        lb?.setAttribute('aria-hidden', 'false');
      };
      thumbs.forEach((thumb, i) => {
        const open = () => show(i);
        thumb.addEventListener('click', open);
        thumb.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            open();
          }
        });
      });
      lb?.querySelector('.hs-lb-close')?.addEventListener('click', () => lb.setAttribute('aria-hidden', 'true'));
      lb?.querySelector('.hs-lb-prev')?.addEventListener('click', () => show(current - 1));
      lb?.querySelector('.hs-lb-next')?.addEventListener('click', () => show(current + 1));
      document.addEventListener('keydown', (e) => {
        if (lb?.getAttribute('aria-hidden') === 'true') return;
        if (e.key === 'Escape') lb?.setAttribute('aria-hidden', 'true');
        if (e.key === 'ArrowLeft') show(current - 1);
        if (e.key === 'ArrowRight') show(current + 1);
      });
    }

    // Accomplishments tabs.
    const accWidget = document.querySelector<HTMLElement>('[data-monroe-accomplishments-widget]');
    if (accWidget) {
      // Check for staff portal live outcomes override
      try {
        const rawStored = localStorage.getItem('mchs_site_content_v2');
        if (rawStored) {
          const stored = JSON.parse(rawStored);
          if (stored && stored.outcomes) {
            Object.entries(stored.outcomes).forEach(([year, stats]: [string, any]) => {
              const panel = accWidget.querySelector(`[data-accomplishments-panel="${year}"]`);
              if (panel && Array.isArray(stats)) {
                stats.forEach((s: any) => {
                  const statTile = Array.from(panel.querySelectorAll('.monroe-accomplishments-stat')).find(
                    t => t.querySelector('.monroe-accomplishments-stat__label')?.textContent?.trim().toLowerCase() === s.label?.toLowerCase()
                  );
                  if (statTile) {
                    const valEl = statTile.querySelector('.monroe-accomplishments-stat__value') as HTMLElement;
                    if (valEl) {
                      valEl.dataset.count = String(s.value);
                      valEl.textContent = s.display || String(s.value);
                    }
                  }
                });
              }
            });
          }
        }
      } catch (e) {}

      accWidget.querySelectorAll<HTMLButtonElement>('.monroe-accomplishments-widget__tab').forEach((tab) => {
        tab.addEventListener('click', () => {
          const year = tab.dataset.accomplishmentsYear;
          accWidget.querySelectorAll('.monroe-accomplishments-widget__tab').forEach((t) => {
            const active = t === tab;
            t.classList.toggle('is-active', active);
            t.setAttribute('aria-selected', String(active));
          });
          accWidget.querySelectorAll<HTMLElement>('.monroe-accomplishments-widget__panel').forEach((panel) => {
            const active = panel.dataset.accomplishmentsPanel === year;
            panel.classList.toggle('is-active', active);
            panel.hidden = !active;
          });
        });
      });
    }

    // Accomplishments stat counters — count up from 0 the first time each
    // tile scrolls into view. data-count has been sitting on these tiles
    // unused; this is what it was for.
    const countEls = document.querySelectorAll<HTMLElement>('.monroe-accomplishments-stat__value[data-count]');
    if (countEls.length && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const countIO = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          countIO.unobserve(el);
          const target = Number(el.dataset.count);
          if (!Number.isFinite(target)) return;
          const original = el.textContent ?? '';
          const prefix = original.match(/^\D*/)?.[0] ?? '';
          const suffix = original.match(/\D*$/)?.[0] ?? '';
          const duration = 1200;
          const start = performance.now();
          const step = (now: number) => {
            const progress = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = `${prefix}${Math.round(target * eased).toLocaleString()}${suffix}`;
            if (progress < 1) requestAnimationFrame(step);
            else el.textContent = original;
          };
          requestAnimationFrame(step);
        });
      }, { threshold: 0.4 });
      countEls.forEach((el) => countIO.observe(el));
    }

    // Scroll-reveal for below-the-fold sections. Anything already visible on
    // load is left completely alone (never hidden) so there's no dependency
    // on JS running for the page to display correctly — this only adds a
    // fade/rise to sections the visitor scrolls down to.
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const revealIO = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-revealed');
          revealIO.unobserve(entry.target);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -80px 0px' });
      document.querySelectorAll<HTMLElement>('.home-editable-section').forEach((section) => {
        const rect = section.getBoundingClientRect();
        if (rect.top < window.innerHeight * 0.85) return;
        section.classList.add('reveal-pending');
        revealIO.observe(section);
      });
    }

    // Contact form: mailto submission (no backend on the static site).
    const contactForm = document.querySelector<HTMLFormElement>('[data-monroe-contact-mailto]');
    if (contactForm) {
      contactForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const data = new FormData(contactForm);
        if (data.get('monroe_contact_website')) return; // honeypot
        const name = String(data.get('monroe_contact_name') || '');
        const email = String(data.get('monroe_contact_email') || '');
        const phone = String(data.get('monroe_contact_phone') || '');
        const message = String(data.get('monroe_contact_message') || '');
        const subject = encodeURIComponent(`Website contact from ${name}`);
        const body = encodeURIComponent(`${message}\n\n- ${name}${phone ? ` (${phone})` : ''}\n${email}`);
        const feedback = contactForm.closest('.monroe-contact-form-wrap')?.querySelector<HTMLElement>('.monroe-contact-form__feedback');
        if (feedback) feedback.textContent = 'Opening your email client to send your message. Thank you!';
        window.location.href = `mailto:${contactForm.dataset.email}?subject=${subject}&body=${body}`;
      });
    }

    // Facebook Page Plugin: best-effort fade of the loader overlay once the iframe
    // reports loaded. The loader's "Open on Facebook" link is plain HTML (see the
    // template), so it stays usable regardless of whether this fires.
    const facebookIframe = document.querySelector<HTMLIFrameElement>('[data-facebook-iframe]');
    facebookIframe?.addEventListener('load', () => {
      facebookIframe.closest('[data-facebook-embed]')?.classList.add('is-loaded');
    });

    // Shelter open/closed badge, computed from SITE.contact.hours (Tue-Fri 11am-4pm,
    // Sat 11am-3pm, closed Sun/Mon) — mirrors the same schedule already encoded in
    // BaseLayout's schema.org openingHoursSpecification, just evaluated against "now".
    const hoursBadge = document.querySelector<HTMLElement>('[data-hours-badge]');
    if (hoursBadge) {
      const hoursText = hoursBadge.querySelector<HTMLElement>('[data-hours-text]');
      const hoursDot = hoursBadge.querySelector<HTMLElement>('[data-hours-dot]');
      const now = new Date();
      const day = now.getDay(); // 0=Sun ... 6=Sat
      const minutes = now.getHours() * 60 + now.getMinutes();
      const openRange = day >= 2 && day <= 5
        ? { start: 11 * 60, end: 16 * 60, closeLabel: '4:00 PM' }
        : day === 6
          ? { start: 11 * 60, end: 15 * 60, closeLabel: '3:00 PM' }
          : null;
      const isOpen = !!openRange && minutes >= openRange.start && minutes < openRange.end;
      if (hoursText) {
        hoursText.textContent = isOpen
          ? `Open now — closes ${openRange!.closeLabel}`
          : 'Closed now — see hours below';
      }
      if (hoursDot) hoursDot.classList.toggle('is-open', isOpen);
    }
    }

  document.addEventListener('astro:page-load', initHomePage);
</script>
