<script>
  function initHomePage() {
    // Homepage Scrollspy (Left Navigation Rail)
    const navLinks = Array.from(document.querySelectorAll('.home-editable-page-index__link'));
    const sections = navLinks
      .map((link) => {
        try {
          const url = new URL((link as HTMLAnchorElement).href);
          return document.querySelector(url.hash);
        } catch { return null; }
      })
      .filter(Boolean) as HTMLElement[];

    if (sections.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          let visibleSection: string | null = null;
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              visibleSection = entry.target.id;
            }
          });
          
          if (visibleSection) {
            navLinks.forEach((link) => {
              try {
                if (new URL((link as HTMLAnchorElement).href).hash === `#${visibleSection}`) {
                  link.classList.add('is-active');
                } else {
                  link.classList.remove('is-active');
                }
              } catch {}
            });
          }
        },
        { rootMargin: '-20% 0px -60% 0px', threshold: 0 }
      );
      sections.forEach((s) => observer.observe(s));
    }
    // Featured pets: Expand view opens a <dialog> with the same cards.
    const fpwDialog = document.getElementById('featuredPetsFsDialog') as HTMLDialogElement | null;
    const fpwExpand = document.getElementById('fpwExpandBtn');
    if (fpwDialog && fpwExpand) {
      fpwExpand.addEventListener('click', () => {
        const mount = fpwDialog.querySelector('#fpw-fs-longest');
        const row = document.getElementById('longestRow');
        if (mount && row && !mount.childElementCount) {
          mount.innerHTML = row.innerHTML;
        }
        fpwDialog.showModal();
      });
      fpwDialog.querySelector('.fpw-fs-dialog__close')?.addEventListener('click', () => fpwDialog.close());
    }

    // Newsletter lightbox.
    const newsSection = document.querySelector<HTMLElement>('[data-hs-lightbox]');
    if (newsSection) {
      const lb = newsSection.querySelector<HTMLElement>('.hs-lightbox');
      const lbImg = lb?.querySelector<HTMLImageElement>('[data-hs-lb-img]');
      const thumbs = Array.from(newsSection.querySelectorAll<HTMLElement>('[data-hs-lb-src]'));
      let current = 0;
      const show = (i: number) => {
        current = (i + thumbs.length) % thumbs.length;
        const src = thumbs[current].dataset.hsLbSrc;
        if (lbImg && src) lbImg.src = src;
        lb?.setAttribute('aria-hidden', 'false');
      };
      thumbs.forEach((thumb, i) => {
        const open = () => show(i);
        thumb.addEventListener('click', open);
        thumb.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            open();
          }
        });
      });
      lb?.querySelector('.hs-lb-close')?.addEventListener('click', () => lb.setAttribute('aria-hidden', 'true'));
      lb?.querySelector('.hs-lb-prev')?.addEventListener('click', () => show(current - 1));
      lb?.querySelector('.hs-lb-next')?.addEventListener('click', () => show(current + 1));
      document.addEventListener('keydown', (e) => {
        if (lb?.getAttribute('aria-hidden') === 'true') return;
        if (e.key === 'Escape') lb?.setAttribute('aria-hidden', 'true');
        if (e.key === 'ArrowLeft') show(current - 1);
        if (e.key === 'ArrowRight') show(current + 1);
      });
    }

    // Accomplishments tabs.
    const accWidget = document.querySelector<HTMLElement>('[data-monroe-accomplishments-widget]');
    if (accWidget) {
      accWidget.querySelectorAll<HTMLButtonElement>('.monroe-accomplishments-widget__tab').forEach((tab) => {
        tab.addEventListener('click', () => {
          const year = tab.dataset.accomplishmentsYear;
          accWidget.querySelectorAll('.monroe-accomplishments-widget__tab').forEach((t) => {
            const active = t === tab;
            t.classList.toggle('is-active', active);
            t.setAttribute('aria-selected', String(active));
          });
          accWidget.querySelectorAll<HTMLElement>('.monroe-accomplishments-widget__panel').forEach((panel) => {
            const active = panel.dataset.accomplishmentsPanel === year;
            panel.classList.toggle('is-active', active);
            panel.hidden = !active;
          });
        });
      });
    }

    // Accomplishments stat counters — count up from 0 the first time each
    // tile scrolls into view. data-count has been sitting on these tiles
    // unused; this is what it was for.
    const countEls = document.querySelectorAll<HTMLElement>('.monroe-accomplishments-stat__value[data-count]');
    if (countEls.length && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const countIO = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          countIO.unobserve(el);
          const target = Number(el.dataset.count);
          if (!Number.isFinite(target)) return;
          const original = el.textContent ?? '';
          const prefix = original.match(/^\D*/)?.[0] ?? '';
          const suffix = original.match(/\D*$/)?.[0] ?? '';
          const duration = 1200;
          const start = performance.now();
          const step = (now: number) => {
            const progress = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = `${prefix}${Math.round(target * eased).toLocaleString()}${suffix}`;
            if (progress < 1) requestAnimationFrame(step);
            else el.textContent = original;
          };
          requestAnimationFrame(step);
        });
      }, { threshold: 0.4 });
      countEls.forEach((el) => countIO.observe(el));
    }

    // Scroll-reveal for below-the-fold sections. Anything already visible on
    // load is left completely alone (never hidden) so there's no dependency
    // on JS running for the page to display correctly — this only adds a
    // fade/rise to sections the visitor scrolls down to.
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const revealIO = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-revealed');
          revealIO.unobserve(entry.target);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -80px 0px' });
      document.querySelectorAll<HTMLElement>('.home-editable-section').forEach((section) => {
        const rect = section.getBoundingClientRect();
        if (rect.top < window.innerHeight * 0.85) return;
        section.classList.add('reveal-pending');
        revealIO.observe(section);
      });
    }

    // Contact form: mailto submission (no backend on the static site).
    }

  document.addEventListener('astro:page-load', initHomePage);
</script>
