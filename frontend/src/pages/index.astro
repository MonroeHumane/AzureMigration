---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPets } from '../lib/directus';
import home from '../data/homepage.json';
import reviewsData from '../data/reviews.json';
import MobileTOC from '../components/MobileTOC.astro';
import HomeNewsletterSection from '../components/home/HomeNewsletterSection.astro';
import HomeFeaturedPets from '../components/home/HomeFeaturedPets.astro';
import HomeEventsSection from '../components/home/HomeEventsSection.astro';
import HomeTestimonialsSection from '../components/home/HomeTestimonialsSection.astro';
import HomeAccomplishmentsSection from '../components/home/HomeAccomplishmentsSection.astro';
import HomeDonationsSection from '../components/home/HomeDonationsSection.astro';
import HomeVetPartnersSection from '../components/home/HomeVetPartnersSection.astro';
import HomeAuctionSponsorsSection from '../components/home/HomeAuctionSponsorsSection.astro';
import HomeSponsorsMarquee from '../components/home/HomeSponsorsMarquee.astro';
import HomeMembershipSection from '../components/home/HomeMembershipSection.astro';
import HomeSupporterStorySection from '../components/home/HomeSupporterStorySection.astro';
import HomeSocialSection from '../components/home/HomeSocialSection.astro';
import HomeFaqSection from '../components/home/HomeFaqSection.astro';
import HomeGamesSection from '../components/home/HomeGamesSection.astro';
import HomeContactSection from '../components/home/HomeContactSection.astro';

import '../styles/monroe-home.css';
import '../styles/monroe-home-widgets.css';

import { getSiteSettings, getEventFlyers, getNewsletterIssues, getFeaturedNewsletterIssue } from '../lib/directus';
const pets = (await getPets()).slice(0, 6);
const settings = await getSiteSettings();
const events = await getEventFlyers();
const newsletters = await getNewsletterIssues();
const featuredNewsletter = await getFeaturedNewsletterIssue();
const now = new Date();

// Spotlight the soonest genuinely upcoming flyer event, not just whichever
// one happens to sort first in the data — events[0] was surfacing a Gala
// from months ago as the "latest" event long after it had passed.
const latestEvent = events
  .filter((e) => e.event_date && new Date(e.event_date) >= now)
  .sort((a, b) => new Date(a.event_date!).getTime() - new Date(b.event_date!).getTime())[0];
const latestNewsletter = featuredNewsletter || newsletters[0] || null;

// "Next event" widget: spotlight the soonest upcoming event from event flyers if present,
// falling back to home.next_event.
const nextEvent = latestEvent
  ? {
      kicker: 'Latest event',
      date: new Date(latestEvent.event_date + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }),
      title: latestEvent.title,
      time: latestEvent.description || '',
      buttons: home.next_event.buttons,
    }
  : home.next_event;

// Upcoming flyers for homepage rail — same Directus collection / sort path as /events.
const upcomingFlyers = events
  .filter((e) => e.event_date && new Date(e.event_date) >= now)
  .sort((a, b) => new Date(a.event_date!).getTime() - new Date(b.event_date!).getTime());

interface Review { author?: string; rating?: number; time?: number; text?: string }
type HomeReview = { author: string; text: string; rating?: number; time?: number };
const reviews = (reviewsData as Review[]).filter((r): r is HomeReview => Boolean(r.author && r.text));

if (home.accomplishments.years['2025']) {
  home.accomplishments.years['2025'][0].value = settings.adoptions_count;
  home.accomplishments.years['2025'][0].display = settings.adoptions_count.toLocaleString();
  home.accomplishments.years['2025'][1].value = settings.return_to_owner_count;
  home.accomplishments.years['2025'][1].display = settings.return_to_owner_count.toLocaleString();
  home.accomplishments.years['2025'][2].value = settings.intakes_count;
  home.accomplishments.years['2025'][2].display = settings.intakes_count.toLocaleString();
}

const accomplishmentYears = Object.keys(home.accomplishments.years).sort((a, b) => Number(b) - Number(a));
const defaultAccomplishmentYear = accomplishmentYears[0];



const sideNavSections = [
  { id: 'Top', title: 'Top' },
  { id: 'Events', title: 'Events & News' },
  { id: 'Intro', title: 'About Our Shelter' },
  { id: 'FeaturedPets', title: 'Find a Pet' },
  { id: 'hs-hero-fence-widget', title: 'Hero Fence' },
  { id: 'VetPartners', title: 'Vet Care Partners' },
  { id: 'furry-friends-auction-sponsors', title: 'Auction Benefactors' },
  { id: 'sponsorMarqueeWidget', title: 'Sponsors' },
  { id: 'Membership', title: 'Membership' },
  { id: 'Testimonials', title: 'Community Voices' },
  { id: 'SupporterStory', title: 'Supporter Story' },
  { id: 'Donations', title: 'Donations & Giving' },
  { id: 'Social', title: 'Facebook' },
  { id: 'Newsletter', title: latestNewsletter?.title || 'Newsletter' },
  { id: 'FAQ', title: 'Shelter FAQ' },
  { id: 'Accomplishments', title: 'Annual Outcomes' },
  { id: 'Games', title: 'Shelter Games' },
  { id: 'Contact', title: 'Contact & Hours' },
];
---

<BaseLayout
  title="Animal Shelter | Monroe County | 734-243-3669"
  description={home.hero.copy}
  bodyClass="home-editable-has-flyers-rail"
>
  <!-- Floating Side Homepage Navigation Dock: seamless hover overlay, zero layout shift -->
  <nav class="home-side-dock" id="homeSideDock" aria-label="On this page navigation">
    <div class="home-side-dock__panel">
      <div class="home-side-dock__header" aria-hidden="true">
        <svg class="home-side-dock__header-icon" viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <span class="home-side-dock__header-title">On This Page</span>
      </div>
      <ul class="home-side-dock__list" role="list">
        {sideNavSections.map((sec) => (
          <li>
            <a href={`#${sec.id}`} class="home-side-dock__link" data-dock-target={sec.id}>
              <span class="home-side-dock__dot" aria-hidden="true"></span>
              <span class="home-side-dock__text">{sec.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <MobileTOC sections={sideNavSections} />

  <div class="home-editable-shell is-layout-constrained">
    <!-- 1. Hero -->
    <div class="wp-block-cover has-custom-content-position is-position-center-center home-editable-hero" id="Top">
      <span aria-hidden="true" class="wp-block-cover__background has-contrast-background-color has-background-dim-40 has-background-dim"></span>
      <div class="home-hero-poster-backdrop" aria-hidden="true">
        <img
          src={home.hero.video_poster}
          alt=""
          loading="eager"
          decoding="async"
          class="home-hero-poster-img"
        />
      </div>
      <video
        class="wp-block-cover__video-background intrinsic-ignore"
        muted
        loop
        playsinline
        autoplay
        poster={home.hero.video_poster}
        src={home.hero.video_src}
        data-hero-video></video>
      <button
        type="button"
        class="home-hero-video-toggle"
        data-hero-video-toggle
        aria-label="Pause background video"
        title="Pause background motion"
      >
        <svg class="home-hero-toggle-icon home-hero-toggle-icon--pause" viewBox="0 0 24 24" fill="currentColor" width="13" height="13" aria-hidden="true">
          <rect x="5" y="4" width="4" height="16" rx="1.5"></rect>
          <rect x="15" y="4" width="4" height="16" rx="1.5"></rect>
        </svg>
        <svg class="home-hero-toggle-icon home-hero-toggle-icon--play" viewBox="0 0 24 24" fill="currentColor" width="13" height="13" aria-hidden="true">
          <polygon points="6 4 20 12 6 20 6 4"></polygon>
        </svg>
        <span class="home-hero-toggle-label" data-hero-video-toggle-label>Pause</span>
      </button>
      <div class="wp-block-cover__inner-container is-layout-flow">
        <div class="wp-block-group home-editable-hero-panel is-layout-constrained">
          <p class="home-editable-hero-display wp-block-paragraph">{home.hero.display}</p>
          <h1 class="wp-block-heading home-editable-hero-title">{home.hero.title}</h1>
          <p class="home-editable-hero-copy wp-block-paragraph">{home.hero.copy}</p>

          <div class="wp-block-buttons aligncenter is-layout-flex">
            <div class="wp-block-button">
              <a class="wp-block-button__link has-base-color has-vivid-cyan-blue-background-color has-text-color has-background wp-element-button" href="/adopt">{home.hero.buttons[0].label}</a>
            </div>
            <div class="wp-block-button home-editable-hero-btn--orange">
              <a class="wp-block-button__link wp-element-button" href="/adoptions">{home.hero.buttons[1].label}</a>
            </div>
            <div class="wp-block-button is-style-outline">
              <a class="wp-block-button__link wp-element-button" href={home.hero.buttons[2].href} target="_blank" rel="noreferrer noopener">{home.hero.buttons[2].label}</a>
            </div>
          </div>

          <div class="home-editable-hero-stats" aria-label="Shelter highlights">
            <div class="home-editable-stat-grid home-editable-stat-grid--hero">
              {home.hero.stats.map((s) => (
                <div class:list={['home-editable-stat', { 'is-accent': s.accent }]}>
                  <strong>{s.kicker}</strong>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Events band: native Astro component (Phase 3) -->
    <HomeEventsSection
      pets={pets}
      latestEvent={latestEvent}
      nextEvent={nextEvent}
      upcomingFlyers={upcomingFlyers}
    />

    <!-- 3. Intro -->
    <div class="wp-block-group alignwide home-editable-section is-layout-constrained">
      <div class="wp-block-group home-editable-intro-card is-layout-constrained" id="Intro">
        <div class="wp-block-columns are-vertically-aligned-center is-layout-flex">
          <div class="wp-block-column is-vertically-aligned-center is-layout-flow" style="flex-basis:65%">
            <p class="home-editable-pill wp-block-paragraph">{home.intro.pill}</p>
            <h2 class="wp-block-heading">{home.intro.title}</h2>
            <p class="wp-block-paragraph">{home.intro.copy}</p>
            <div class="wp-block-buttons is-layout-flex">
              <div class="wp-block-button">
                <a class="wp-block-button__link has-base-color has-contrast-background-color has-text-color has-background wp-element-button" href={TEL}>{home.intro.call_button}</a>
              </div>
            </div>
          </div>
          <div class="wp-block-column is-layout-flow" style="flex-basis:35%">
            <div class="home-editable-stat-grid">
              {home.intro.stats.map((s) => (
                <div class:list={['home-editable-stat', { 'is-accent': s.accent }]}>
                  <strong>{s.kicker}</strong>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 4. Featured pets: native Astro component (Phase 3) -->
    <HomeFeaturedPets pets={pets} />

    <!-- 5. Hero Fence -->
    <div class="wp-block-group alignwide home-editable-section is-layout-constrained">
      <section id="hs-hero-fence-widget" class="hs-feature-widget" aria-labelledby="hs-hero-fence-title">
        <div class="hs-wrap">
          <div class="hs-copy">
            <p class="hs-kicker">{home.hero_fence.kicker}</p>
            <h2 id="hs-hero-fence-title">{home.hero_fence.title}</h2>
            {home.hero_fence.body.map((p) => <p class="hs-body">{p}</p>)}
            <div class="hs-note">{home.hero_fence.note}</div>
            <div class="hs-actions">
              <a class="hs-btn" href={home.hero_fence.cta.href}>{home.hero_fence.cta.label}</a>
            </div>
          </div>
          <div class="hs-media" aria-hidden="true">
            <img decoding="async" src={home.hero_fence.image} alt={home.hero_fence.image_alt} loading="lazy" />
          </div>
        </div>
      </section>
    </div>

    <!-- 6. Feature card -->
    <div class="wp-block-group alignwide home-editable-section is-layout-constrained">
      <div class="wp-block-group home-editable-feature-card is-layout-constrained">
        <div class="wp-block-columns are-vertically-aligned-stretch is-layout-flex">
          <div class="wp-block-column is-vertically-aligned-stretch home-editable-feature-media is-layout-flow" style="flex-basis:45%">
            <figure class="wp-block-image size-full">
              <img loading="lazy" decoding="async" src={home.feature_card.image} alt={home.feature_card.image_alt} />
            </figure>
          </div>
          <div class="wp-block-column is-vertically-aligned-center home-editable-feature-copy is-layout-flow" style="flex-basis:55%">
            <p class="home-editable-section-label wp-block-paragraph">{home.feature_card.label}</p>
            <h2 class="wp-block-heading">{home.feature_card.title}</h2>
            <p class="wp-block-paragraph">{home.feature_card.copy}</p>
            <div class="wp-block-buttons is-layout-flex">
              <div class="wp-block-button">
                <a class="wp-block-button__link has-base-color has-vivid-cyan-blue-background-color has-text-color has-background wp-element-button" href="/adoptions">{home.feature_card.buttons[0].label}</a>
              </div>
              <div class="wp-block-button is-style-outline">
                <a class="wp-block-button__link wp-element-button" href="/dog-and-cat-shelter">{home.feature_card.buttons[1].label}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 7. Vet partners: native Astro component (Phase 3) -->
    <HomeVetPartnersSection />

    <!-- 8. Auction sponsors: native Astro component (Phase 3) -->
    <HomeAuctionSponsorsSection />

    <!-- 9. Community partners marquee: native Astro component (Phase 3) -->
    <HomeSponsorsMarquee />

    <!-- 10. Membership: native Astro component (Phase 3) -->
    <HomeMembershipSection />

    <!-- 11. Testimonials: native Astro component (Phase 3) -->
    <HomeTestimonialsSection reviews={reviews} />

    <!-- 11b. Supporter Story: native Astro component (Phase 3) -->
    <HomeSupporterStorySection />

    <!-- 12. Donations: native Astro component (Phase 3) -->
    <HomeDonationsSection />

    <!-- 13. Social: native Astro component (Phase 3) -->
    <HomeSocialSection />

    <!-- 14. Newsletter: native Astro component (Phase 3) -->
    <HomeNewsletterSection issue={latestNewsletter} />

    <!-- 15. FAQ: native Astro component (Phase 3) -->
    <HomeFaqSection />

    <!-- 16. Accomplishments: native Astro component (Phase 3) -->
    <HomeAccomplishmentsSection
      years={home.accomplishments.years}
      yearOrder={accomplishmentYears}
      defaultYear={defaultAccomplishmentYear}
    />

    <!-- 17. Games: native Astro component (Phase 3) -->
    <HomeGamesSection />

    <!-- 18. Contact: native Astro component (Phase 3) -->
    <HomeContactSection />

  </div>
</BaseLayout>

<script>
  import { hydrateHomeNewsletter } from '../scripts/newsletter-hydrate';

  function initHomePage() {
    hydrateHomeNewsletter();
    const fpwDialog = document.getElementById('featuredPetsFsDialog') as HTMLDialogElement | null;
    const fpwExpand = document.getElementById('fpwExpandBtn');
    if (fpwDialog && fpwExpand && fpwExpand.dataset.bound !== '1') {
      fpwExpand.dataset.bound = '1';
      fpwExpand.addEventListener('click', () => {
        const mount = fpwDialog.querySelector('#fpw-fs-longest');
        // Pull cards from the primary strip only — `#longestRow` also
        // contains an aria-hidden `.scroll-strip--clone` (duplicate cards
        // used to loop the auto-scroll marquee) plus the marquee's own
        // scroll-viewport/scroll-track wrapper and animation, none of which
        // belong in the static full-screen grid.
        const primaryStrip = document.querySelector('#longestRow .scroll-strip--primary');
        if (mount && primaryStrip && !mount.childElementCount) {
          mount.innerHTML = primaryStrip.innerHTML;
        }
        fpwDialog.showModal();
      });
      fpwDialog.querySelector('.fpw-fs-close, .fpw-fs-dialog__close')?.addEventListener('click', () => fpwDialog.close());
    }

    // Scroll-reveal for below-the-fold sections. Anything already visible on
    // load is left completely alone (never hidden) so there's no dependency
    // on JS running for the page to display correctly — this only adds a
    // fade/rise to sections the visitor scrolls down to.
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const revealIO = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-revealed');
          revealIO.unobserve(entry.target);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -80px 0px' });
      document.querySelectorAll<HTMLElement>('.home-editable-section').forEach((section) => {
        if (section.dataset.revealBound === '1') return;
        section.dataset.revealBound = '1';
        const rect = section.getBoundingClientRect();
        if (rect.top < window.innerHeight * 0.85) return;
        section.classList.add('reveal-pending');
        revealIO.observe(section);
      });
    }

    // Contact form: mailto submission (no backend on the static site).
    const contactForm = document.querySelector<HTMLFormElement>('[data-monroe-contact-mailto]');
    if (contactForm) {
      contactForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const data = new FormData(contactForm);
        if (data.get('monroe_contact_website')) return; // honeypot
        const name = String(data.get('monroe_contact_name') || '');
        const email = String(data.get('monroe_contact_email') || '');
        const phone = String(data.get('monroe_contact_phone') || '');
        const message = String(data.get('monroe_contact_message') || '');
        const subject = encodeURIComponent(`Website contact from ${name}`);
        const body = encodeURIComponent(`${message}\n\n- ${name}${phone ? ` (${phone})` : ''}\n${email}`);
        const feedback = contactForm.closest('.monroe-contact-form-wrap')?.querySelector<HTMLElement>('.monroe-contact-form__feedback');
        if (feedback) feedback.textContent = 'Opening your email client to send your message. Thank you!';
        window.location.href = `mailto:${contactForm.dataset.email}?subject=${subject}&body=${body}`;
      });
    }

    // Facebook Page Plugin: best-effort fade of the loader overlay once the iframe
    // reports loaded. The loader's "Open on Facebook" link is plain HTML (see the
    // template), so it stays usable regardless of whether this fires.
    const facebookIframe = document.querySelector<HTMLIFrameElement>('[data-facebook-iframe]');
    facebookIframe?.addEventListener('load', () => {
      facebookIframe.closest('[data-facebook-embed]')?.classList.add('is-loaded');
    });

    // Side navigation dock: active scrollspy tracking
    const dockLinks = document.querySelectorAll<HTMLAnchorElement>('.home-side-dock__link');
    if (dockLinks.length && 'IntersectionObserver' in window) {
      const sectionMap = new Map<string, HTMLAnchorElement>();
      dockLinks.forEach((link) => {
        const id = link.dataset.dockTarget;
        if (id) sectionMap.set(id, link);
      });

      const dockIO = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const activeLink = sectionMap.get(entry.target.id);
            if (activeLink) {
              dockLinks.forEach((l) => l.classList.remove('is-active'));
              activeLink.classList.add('is-active');
            }
          }
        });
      }, { rootMargin: '-20% 0px -70% 0px' });

      sectionMap.forEach((_, id) => {
        const el = document.getElementById(id);
        if (el) dockIO.observe(el);
      });
    }

    // Shelter open/closed badge, computed from SITE.contact.hours (Tue-Fri 11am-4pm,
    // Sat 11am-3pm, closed Sun/Mon) — mirrors the same schedule already encoded in
    // BaseLayout's schema.org openingHoursSpecification, just evaluated against "now".
    const hoursBadge = document.querySelector<HTMLElement>('[data-hours-badge]');
    if (hoursBadge) {
      const hoursText = hoursBadge.querySelector<HTMLElement>('[data-hours-text]');
      const hoursDot = hoursBadge.querySelector<HTMLElement>('[data-hours-dot]');
      const now = new Date();
      const day = now.getDay(); // 0=Sun ... 6=Sat
      const minutes = now.getHours() * 60 + now.getMinutes();
      const openRange = day >= 2 && day <= 5
        ? { start: 11 * 60, end: 16 * 60, closeLabel: '4:00 PM' }
        : day === 6
          ? { start: 11 * 60, end: 15 * 60, closeLabel: '3:00 PM' }
          : null;
      const isOpen = !!openRange && minutes >= openRange.start && minutes < openRange.end;
      if (hoursText) {
        hoursText.textContent = isOpen
          ? `Open now — closes ${openRange!.closeLabel}`
          : 'Closed now — see hours below';
      }
      if (hoursDot) hoursDot.classList.toggle('is-open', isOpen);
    }

    // Hero video background & low-power / data-saver poster fallback
    const hero = document.getElementById('Top');
    if (hero) {
      const video = hero.querySelector<HTMLVideoElement>('[data-hero-video]');
      const toggleBtn = hero.querySelector<HTMLButtonElement>('[data-hero-video-toggle]');
      const toggleLabel = hero.querySelector<HTMLElement>('[data-hero-video-toggle-label]');

      if (video && toggleBtn && toggleBtn.dataset.bound !== '1') {
        toggleBtn.dataset.bound = '1';
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const prefersReducedData = window.matchMedia('(prefers-reduced-data: reduce)').matches;
        const saveData = !!(navigator as any).connection?.saveData;

        let isPaused = prefersReducedMotion || prefersReducedData || saveData;

        const updateToggleUI = (paused: boolean) => {
          if (paused) {
            hero.classList.add('is-motion-paused');
            toggleBtn.setAttribute('aria-label', 'Play background video');
            toggleBtn.setAttribute('title', 'Play background video');
            if (toggleLabel) toggleLabel.textContent = 'Play';
          } else {
            hero.classList.remove('is-motion-paused');
            toggleBtn.setAttribute('aria-label', 'Pause background video');
            toggleBtn.setAttribute('title', 'Pause background motion');
            if (toggleLabel) toggleLabel.textContent = 'Pause';
          }
        };

        const handleVideoPlaying = () => {
          if (!isPaused) {
            hero.classList.add('is-video-playing');
          }
        };

        video.addEventListener('playing', handleVideoPlaying);
        video.addEventListener('canplay', handleVideoPlaying);

        if (!video.paused) {
          handleVideoPlaying();
        }

        if (isPaused) {
          video.pause();
          updateToggleUI(true);
        } else {
          // Attempt playback; gracefully catch Low Power Mode / battery-saver rejections
          const playPromise = video.play();
          if (playPromise !== undefined) {
            playPromise
              .then(() => {
                handleVideoPlaying();
                updateToggleUI(false);
              })
              .catch(() => {
                // Autoplay blocked by browser policy / battery saver
                isPaused = true;
                updateToggleUI(true);
              });
          }
        }

        toggleBtn.addEventListener('click', () => {
          if (isPaused) {
            isPaused = false;
            updateToggleUI(false);
            video.play().then(handleVideoPlaying).catch(() => {});
          } else {
            isPaused = true;
            updateToggleUI(true);
            video.pause();
          }
        });
      }
    }
  }

  document.addEventListener('astro:page-load', initHomePage);
</script>
