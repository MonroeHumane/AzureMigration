    <!-- 16. Accomplishments -->
    <div id="Accomplishments" class="wp-block-group alignwide home-editable-section home-editable-accomplishments-band is-layout-constrained">
      <div class="wp-block-group home-editable-accomplishments-card is-layout-constrained">
        <p class="has-text-align-center home-editable-pill wp-block-paragraph">{home.accomplishments.pill}</p>
        <h2 class="wp-block-heading has-text-align-center home-editable-heading-impact">{home.accomplishments.title}</h2>
        <p class="has-text-align-center wp-block-paragraph">{home.accomplishments.intro}</p>

        <div class="monroe-accomplishments-widget home-editable-accomplishments-grid" data-monroe-accomplishments-widget>
          <div class="monroe-accomplishments-widget__tabs" role="tablist" aria-label="Shelter outcome years">
            {Object.keys(home.accomplishments.years).map((year, i) => (
              <button
                type="button"
                class:list={['monroe-accomplishments-widget__tab', { 'is-active': i === 0 }]}
                role="tab"
                id={`monroe-accomplishments-tab-${year}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`monroe-accomplishments-panel-${year}`}
                data-accomplishments-year={year}
              >
                {year}
              </button>
            ))}
          </div>
          {Object.entries(home.accomplishments.years).map(([year, stats], i) => (
            <div
              class:list={['monroe-accomplishments-widget__panel', { 'is-active': i === 0 }]}
              role="tabpanel"
              id={`monroe-accomplishments-panel-${year}`}
              aria-labelledby={`monroe-accomplishments-tab-${year}`}
              data-accomplishments-panel={year}
              hidden={i !== 0}
            >
              <div class="monroe-accomplishments-widget__stats">
                {stats.map((s) => (
                  <div class:list={['monroe-accomplishments-stat', 'is-tile', { 'is-accent': s.accent }]}>
                    <span class="monroe-accomplishments-stat__value" data-count={s.value}>{s.display}</span>
                    <span class="monroe-accomplishments-stat__label">{s.label}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- 17. Games -->
    <div id="Games" class="wp-block-group alignwide home-editable-section home-editable-games-band is-layout-flow">
      <div class="wp-block-group home-editable-games-card is-layout-constrained">
        <p class="has-text-align-center home-editable-pill wp-block-paragraph">{home.games.pill}</p>
        <div class="home-editable-games-head">
          <h2 class="wp-block-heading has-text-align-center home-editable-heading-impact" id="home-games-heading">{home.games.title}</h2>
          <p class="has-text-align-center home-editable-games-intro">{home.games.intro}</p>
        </div>
        <ul class="home-editable-games-teasers" role="list">
          {home.games.teasers.map((t) => (
            <li class="home-editable-games-teasers__item">
              <a class="home-editable-games-teasers__link" href="/games">
                <span class="home-editable-games-teasers__icon" aria-hidden="true">{t.icon}</span>
                <span class="home-editable-games-teasers__title">{t.title}</span>
                <span class="home-editable-games-teasers__desc">{t.desc}</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="wp-block-buttons is-content-justification-center home-editable-games-cta">
          <div class="wp-block-button">
            <a class="wp-block-button__link has-base-color has-contrast-background-color has-text-color has-background wp-element-button" href="/games">{home.games.cta}</a>
          </div>
        </div>
      </div>
    </div>

    <!-- 18. Contact -->
    <div class="wp-block-group alignwide home-editable-section is-layout-constrained">
      <div class="wp-block-group home-editable-contact-card is-layout-constrained" id="Contact">
        <p class="home-editable-pill wp-block-paragraph">{home.contact.pill}</p>
        <h2 class="wp-block-heading home-editable-heading-impact">{home.contact.title}</h2>
        <p class="wp-block-paragraph">{home.contact.intro}</p>

        <div class="monroe-contact-form-wrap">
          <div aria-live="polite" aria-atomic="true" class="monroe-contact-form__feedback"></div>
          <p class="monroe-contact-form__lead">{home.contact.lead}</p>
          <form class="monroe-contact-form" data-monroe-contact-mailto data-email={home.contact.email}>
            <p class="monroe-contact-form__hp" aria-hidden="true">
              <label for="monroe_contact_website">Website</label>
              <input type="text" name="monroe_contact_website" id="monroe_contact_website" value="" tabindex="-1" autocomplete="off" />
            </p>
            <div class="monroe-contact-form__grid">
              <p class="monroe-contact-form__field">
                <label for="monroe_contact_name">Name <span class="required">*</span></label>
                <input type="text" name="monroe_contact_name" id="monroe_contact_name" required autocomplete="name" placeholder="Name" value="" />
              </p>
              <p class="monroe-contact-form__field">
                <label for="monroe_contact_phone">Phone</label>
                <input type="tel" name="monroe_contact_phone" id="monroe_contact_phone" inputmode="tel" autocomplete="tel" placeholder="Phone" value="" />
              </p>
            </div>
            <p class="monroe-contact-form__field">
              <label for="monroe_contact_email">Email <span class="required">*</span></label>
              <input type="email" name="monroe_contact_email" id="monroe_contact_email" required autocomplete="email" placeholder="Email" value="" />
            </p>
            <p class="monroe-contact-form__field">
              <label for="monroe_contact_message">Message <span class="required">*</span></label>
              <textarea name="monroe_contact_message" id="monroe_contact_message" rows="5" required placeholder="Message"></textarea>
            </p>
            <p class="monroe-contact-form__submit">
              <button type="submit" class="wp-block-button__link wp-element-button monroe-contact-form__button">{home.contact.submit}</button>
            </p>
          </form>
        </div>

        <div class="wp-block-buttons is-layout-flex">
          <div class="wp-block-button">
            <a class="wp-block-button__link has-base-color has-contrast-background-color has-text-color has-background wp-element-button" href={TEL}>{home.contact.call_button}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline async src="https://cdn.trustindex.io/loader.js?ver=1"></script>

<script>
  function initHomePage() {
    // Lazy hero video: swap data-src in once the page is idle.
    document.querySelectorAll<HTMLVideoElement>('[data-monroe-lazy-video]').forEach((video) => {
      const load = () => {
        if (video.src) return;
        video.src = video.dataset.src || '';
        video.play().catch(() => {});
      };
      if ('requestIdleCallback' in window) requestIdleCallback(load);
      else setTimeout(load, 800);
    });

    // Featured pets: Expand view opens a <dialog> with the same cards.
    const fpwDialog = document.getElementById('featuredPetsFsDialog') as HTMLDialogElement | null;
    const fpwExpand = document.getElementById('fpwExpandBtn');
    if (fpwDialog && fpwExpand) {
      fpwExpand.addEventListener('click', () => {
        const mount = fpwDialog.querySelector('#fpw-fs-longest');
        const row = document.getElementById('longestRow');
        if (mount && row && !mount.childElementCount) {
          mount.innerHTML = row.innerHTML;
        }
        fpwDialog.showModal();
      });
      fpwDialog.querySelector('.fpw-fs-dialog__close')?.addEventListener('click', () => fpwDialog.close());
    }

    // Newsletter lightbox.
    const newsSection = document.querySelector<HTMLElement>('[data-hs-lightbox]');
    if (newsSection) {
      const lb = newsSection.querySelector<HTMLElement>('.hs-lightbox');
      const lbImg = lb?.querySelector<HTMLImageElement>('[data-hs-lb-img]');
      const thumbs = Array.from(newsSection.querySelectorAll<HTMLElement>('[data-hs-lb-src]'));
      let current = 0;
      const show = (i: number) => {
        current = (i + thumbs.length) % thumbs.length;
        const src = thumbs[current].dataset.hsLbSrc;
        if (lbImg && src) lbImg.src = src;
        lb?.setAttribute('aria-hidden', 'false');
      };
      thumbs.forEach((thumb, i) => {
        const open = () => show(i);
        thumb.addEventListener('click', open);
        thumb.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            open();
          }
        });
      });
      lb?.querySelector('.hs-lb-close')?.addEventListener('click', () => lb.setAttribute('aria-hidden', 'true'));
      lb?.querySelector('.hs-lb-prev')?.addEventListener('click', () => show(current - 1));
      lb?.querySelector('.hs-lb-next')?.addEventListener('click', () => show(current + 1));
      document.addEventListener('keydown', (e) => {
        if (lb?.getAttribute('aria-hidden') === 'true') return;
        if (e.key === 'Escape') lb.setAttribute('aria-hidden', 'true');
        if (e.key === 'ArrowLeft') show(current - 1);
        if (e.key === 'ArrowRight') show(current + 1);
      });
    }

    // Accomplishments tabs.
    const accWidget = document.querySelector<HTMLElement>('[data-monroe-accomplishments-widget]');
    if (accWidget) {
      accWidget.querySelectorAll<HTMLButtonElement>('.monroe-accomplishments-widget__tab').forEach((tab) => {
        tab.addEventListener('click', () => {
          const year = tab.dataset.accomplishmentsYear;
          accWidget.querySelectorAll('.monroe-accomplishments-widget__tab').forEach((t) => {
            const active = t === tab;
            t.classList.toggle('is-active', active);
            t.setAttribute('aria-selected', String(active));
          });
          accWidget.querySelectorAll<HTMLElement>('.monroe-accomplishments-widget__panel').forEach((panel) => {
            const active = panel.dataset.accomplishmentsPanel === year;
            panel.classList.toggle('is-active', active);
            panel.hidden = !active;
          });
        });
      });
    }

    // Facebook feed: click-to-load facade (nothing leaves the page until asked).
    document.querySelectorAll<HTMLIFrameElement>('[data-monroe-fb-facade]').forEach((iframe) => {
      const viewport = iframe.closest('.home-editable-social-embed__viewport');
      const load = () => {
        if (iframe.src) return;
        const href = iframe.dataset.fbHref || '';
        iframe.src =
          'https://www.facebook.com/plugins/page.php?href=' +
          encodeURIComponent(href) +
          '&tabs=timeline&width=500&height=1500&small_header=false&adapt_container_width=true&hide_cover=false&show_facepile=true';
        iframe.closest('[data-fb-embed]')?.classList.add('is-loaded');
      };
      viewport?.addEventListener('click', load);
      iframe.addEventListener('load', load);
    });

    // Contact form: mailto submission (no backend on the static site).
    const contactForm = document.querySelector<HTMLFormElement>('[data-monroe-contact-mailto]');
    if (contactForm) {
      contactForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const data = new FormData(contactForm);
        if (data.get('monroe_contact_website')) return; // honeypot
        const name = String(data.get('monroe_contact_name') || '');
        const email = String(data.get('monroe_contact_email') || '');
        const phone = String(data.get('monroe_contact_phone') || '');
        const message = String(data.get('monroe_contact_message') || '');
        const subject = encodeURIComponent(`Website contact from ${name}`);
        const body = encodeURIComponent(`${message}\n\n— ${name}${phone ? ` (${phone})` : ''}\n${email}`);
        const feedback = contactForm.closest('.monroe-contact-form-wrap')?.querySelector<HTMLElement>('.monroe-contact-form__feedback');
        if (feedback) feedback.textContent = 'Opening your email application so your message can be sent. Thank you!';
        window.location.href = `mailto:${contactForm.dataset.email}?subject=${subject}&body=${body}`;
      });
    }
  }

  document.addEventListener('astro:page-load', initHomePage);
</script>
