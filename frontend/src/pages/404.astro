---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerShell from '../components/InnerShell.astro';
---

<BaseLayout title="Page Not Found | 734-243-3669" description="The page you were looking for could not be found.">
  <InnerShell>
    <header class="monroe-native-hero">
      <p class="monroe-native-eyebrow">Lost pup</p>
      <h1>Page Not Found</h1>
      <p class="monroe-native-lead">
        Looks like this pup wandered off the trail! The page you were looking for is not here.
      </p>
    </header>
    <section class="monroe-native-stack">
      <h2>Where to next?</h2>
      <div class="monroe-native-actions">
        <a class="monroe-btn" href="/">Back to the homepage</a>
        <a class="monroe-btn monroe-btn--outline" href="/adopt">Browse adoptable pets</a>
      </div>
    </section>
  </InnerShell>
</BaseLayout>
