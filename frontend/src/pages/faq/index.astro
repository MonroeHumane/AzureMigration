---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';

const faqs = [
  {
    category: 'Adoption & Visiting',
    q: 'How does the adoption process work?',
    a: 'We encourage you to browse our available pets online, fill out an adoption application, and visit during our open adoption hours. Our adoption counseling team will introduce you to the animal, answer any questions, and ensure a wonderful match for your home.',
    link: '/adoptions',
    linkText: 'View Adoption Process & Application',
  },
  {
    category: 'Adoption & Visiting',
    q: 'What are the adoption fees and what do they include?',
    a: 'Adoption fees cover spaying/neutering, microchip identification, rabies vaccine, age-appropriate core vaccinations, flea/tick preventative, heartworm testing for dogs, and FeLV/FIV testing for cats.',
    link: '/adoptions',
    linkText: 'See Adoption Details',
  },
  {
    category: 'Surrender & Stray Animals',
    q: 'What do I do if I need to surrender my pet?',
    a: 'If you are facing rehoming or hardship, please call our shelter directly at (734) 243-3669. We evaluate each situation to determine if we have open kennel space and resources, or provide rehoming guidance and pet food pantry support.',
    link: '/resources',
    linkText: 'View Community Resources',
  },
  {
    category: 'Surrender & Stray Animals',
    q: 'Who do I call for animal control or stray emergencies?',
    a: 'For stray animal pickup, animal bites, or emergency animal control in Monroe County, call Monroe County Animal Control at (734) 240-7700 or the Sheriff dispatch.',
    link: '/resources',
    linkText: 'Emergency Numbers',
  },
  {
    category: 'Donations & Giving',
    q: 'How can I donate to support the shelter?',
    a: 'You can make a direct, secure online donation via our donation portal, support our Cat Room expansion on PayPal, become an annual/monthly member, sponsor an event, or donate physical items like Purina pet food, bleach, paper towels, and blankets.',
    link: '/donate',
    linkText: 'Donate Now',
  },
  {
    category: 'Donations & Giving',
    q: 'Can I dedicate a memorial brick or tribute in honor of a loved one?',
    a: 'Yes! We have an active Memorials and Planned Giving program. You can dedicate gifts in memory of family members or beloved pets, and have their name commemorated on our live Honor Roll.',
    link: '/memorials',
    linkText: 'Visit Memorial Honor Roll',
  },
  {
    category: 'Volunteering & Community',
    q: 'How can I volunteer with Monroe Humane?',
    a: 'We welcome volunteers for dog walking, cat socialization, kennel enrichment, event assistance, and community outreach. Complete our online volunteer application to get started with an orientation.',
    link: '/volunteer-form',
    linkText: 'Volunteer Application',
  },
  {
    category: 'Volunteering & Community',
    q: 'What is the "Doggie Day Out" program?',
    a: 'Doggie Day Out allows approved community members and volunteers to take a shelter dog out for the day to enjoy a local park, get a pup cup, decompress from the shelter, and wear a "Adopt Me" vest to meet potential families!',
    link: '/dog-and-cat-shelter',
    linkText: 'Learn About Shelter Programs',
  },
];
---

<BaseLayout
  title={`Frequently Asked Questions | ${SITE.name}`}
  description="Find answers to common questions about animal adoptions, volunteer programs, pet surrenders, donations, and visiting Monroe Humane."
>
  <div class="pb-16 px-4 max-w-4xl mx-auto">
    <header class="mb-8 text-center">
      <p class="text-emerald-500 font-bold uppercase tracking-widest text-sm mb-2">Help &amp; Answers</p>
      <h1 class="text-3xl sm:text-5xl font-serif text-teal-900 mb-3">Frequently Asked Questions</h1>
      <p class="text-base sm:text-lg text-gray-600 leading-relaxed">
        Find quick answers to common questions regarding pet adoptions, donations, shelter programs, and visiting hours.
      </p>
    </header>

    <div class="mb-6">
      <label for="faqSearch" class="sr-only">Search questions</label>
      <input
        type="search"
        id="faqSearch"
        placeholder="Search questions (e.g. fees, surrender, volunteer, hours)..."
        class="w-full max-w-2xl mx-auto block px-5 py-3 text-base border-2 border-teal-700/25 rounded-full outline-none transition-colors focus:border-teal-700 bg-gray-50 focus:bg-white"
      />
    </div>

    <div id="faqList" class="flex flex-col gap-3.5 mb-10">
      {faqs.map((faq) => (
        <details class="group bg-white border border-gray-200 rounded-2xl shadow-xs hover:shadow-md transition-shadow faq-item" data-faq-q={faq.q.toLowerCase()} data-faq-a={faq.a.toLowerCase()}>
          <summary class="flex justify-between items-center px-6 py-4 cursor-pointer list-none outline-none font-serif text-xl sm:text-2xl text-teal-900 marker:hidden">
            <span>{faq.q}</span>
            <span class="text-teal-700 text-2xl transition-transform duration-200 group-open:rotate-45 leading-none shrink-0">+</span>
          </summary>
          <div class="px-6 pb-5 pt-2 text-gray-700 text-base leading-relaxed border-t border-teal-900/10 border-dashed mt-1">
            <p>{faq.a}</p>
            {faq.link && (
              <p class="mt-3">
                <a href={faq.link} class="inline-flex items-center justify-center px-4 py-2 rounded-full border-2 border-teal-700 text-teal-700 font-bold uppercase tracking-wider text-xs transition-all hover:bg-teal-50">
                  {faq.linkText} &rarr;
                </a>
              </p>
            )}
          </div>
        </details>
      ))}
    </div>

    <section class="bg-teal-50 rounded-2xl p-6 sm:p-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-serif text-teal-900 mb-3">Still have questions?</h2>
      <p class="max-w-2xl mx-auto text-gray-700 mb-6 leading-relaxed text-sm sm:text-base">
        Our adoption center team is happy to assist you by phone, email, or in person during shelter hours.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a class="inline-flex items-center justify-center px-5 py-2.5 rounded-full bg-emerald-500 text-teal-900 font-bold uppercase tracking-wider transition-all hover:bg-emerald-400 hover:-translate-y-0.5 text-xs" href="/contact">Contact Our Team</a>
        <a class="inline-flex items-center justify-center px-5 py-2.5 rounded-full border-2 border-teal-700 text-teal-700 font-bold uppercase tracking-wider transition-all hover:bg-white hover:-translate-y-0.5 text-xs" href={SITE.contact.phoneTel}>Call {SITE.contact.phoneFormatted}</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  function initFaq() {
    const search = document.getElementById('faqSearch') as HTMLInputElement | null;
    const items = Array.from(document.querySelectorAll<HTMLElement>('.faq-item'));

    search?.addEventListener('input', () => {
      const q = search.value.trim().toLowerCase();
      items.forEach((item) => {
        const match = !q || item.dataset.faqQ?.includes(q) || item.dataset.faqA?.includes(q);
        item.style.display = match ? '' : 'none';
        if (q && match) (item as HTMLDetailsElement).open = true;
      });
    });
  }
  document.addEventListener('astro:page-load', initFaq);
</script>