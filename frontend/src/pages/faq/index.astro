---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';

interface FaqItem {
  id: string;
  category: string;
  q: string;
  a: string;
  link?: string;
  linkText?: string;
}

const categories = [
  { id: 'all', label: 'All Questions', icon: '✨' },
  { id: 'adoptions', label: 'Adoptions & Visiting', icon: '🐾' },
  { id: 'surrender', label: 'Surrender & Strays', icon: '🏠' },
  { id: 'donations', label: 'Donations & Giving', icon: '💚' },
  { id: 'volunteering', label: 'Volunteering & Community', icon: '🙌' },
];

const faqs: FaqItem[] = [
  // Adoptions & Visiting
  {
    id: 'faq-adopt-process',
    category: 'adoptions',
    q: 'How does the adoption process work?',
    a: 'We encourage you to browse our available pets online, fill out an adoption application, and visit during our open adoption hours. Our adoption counseling team will introduce you to the animal, answer any questions, and ensure a wonderful match for your home.',
    link: '/adoptions',
    linkText: 'View Adoption Process & Application',
  },
  {
    id: 'faq-adopt-fees',
    category: 'adoptions',
    q: 'What are the adoption fees and what do they include?',
    a: 'Adoption fees cover spaying/neutering, microchip identification, rabies vaccine, age-appropriate core vaccinations, flea/tick preventative, heartworm testing for dogs, and FeLV/FIV testing for cats.',
    link: '/adoptions',
    linkText: 'See Adoption Fee Schedule',
  },
  {
    id: 'faq-adopt-visit',
    category: 'adoptions',
    q: 'Can I visit the shelter before submitting an application?',
    a: 'Yes! Walk-in visitors are always welcome during our open adoption hours. You can meet our adoptable cats and dogs, tour the facility, talk with our adoption counselors, and submit an application on-site or online whenever you are ready.',
    link: '/contact',
    linkText: 'Shelter Hours & Location',
  },

  // Surrender & Strays
  {
    id: 'faq-surrender-pet',
    category: 'surrender',
    q: 'What do I do if I need to surrender my pet?',
    a: 'If you are facing rehoming or personal hardship, please call our shelter directly at (734) 243-3669. We evaluate each situation to determine if we have open kennel space and resources, or provide rehoming guidance and pet food pantry support to help keep pets in their homes.',
    link: '/resources',
    linkText: 'View Community Resources',
  },
  {
    id: 'faq-stray-emergency',
    category: 'surrender',
    q: 'Who do I call for animal control or stray emergencies?',
    a: 'For stray animal pickup, animal bites, or emergency animal control in Monroe County, call Monroe County Animal Control at (734) 240-7700 or the Monroe County Sheriff dispatch.',
    link: '/resources',
    linkText: 'Emergency Contacts',
  },
  {
    id: 'faq-food-pantry',
    category: 'surrender',
    q: 'Does the shelter offer a pet food pantry for families in need?',
    a: 'Yes, Monroe Humane provides supplemental dog and cat food to local Monroe County families experiencing temporary financial hardship. Pantry distributions are available during our open lobby hours while supplies last.',
    link: '/resources',
    linkText: 'Pet Food Pantry Info',
  },

  // Donations & Giving
  {
    id: 'faq-donate-support',
    category: 'donations',
    q: 'How can I donate to support the shelter?',
    a: 'You can make a direct, secure online donation via our donation portal, support our Cat Room expansion fund on PayPal, become an annual or monthly sustaining member, sponsor an event, or drop off physical pet food and care supplies.',
    link: '/donate',
    linkText: 'Donate Securely Online',
  },
  {
    id: 'faq-memorial-tribute',
    category: 'donations',
    q: 'Can I dedicate a memorial brick or tribute in honor of a loved one?',
    a: 'Yes! We have an active Memorials and Planned Giving program. You can dedicate gifts in memory of family members or beloved pets, and have their names commemorated on our live Honor Roll.',
    link: '/memorials',
    linkText: 'Visit Memorial Honor Roll',
  },
  {
    id: 'faq-wishlist-items',
    category: 'donations',
    q: 'What physical items and supplies are needed most right now?',
    a: 'Our highest-demand items include dry and canned Purina dog and cat food, scoopable non-clumping and clumping cat litter, heavy-duty paper towels, bleach, liquid laundry detergent, peanut butter (xylitol-free), and durable chew toys like Kongs.',
    link: '/donate',
    linkText: 'View Shelter Wish List',
  },

  // Volunteering & Community
  {
    id: 'faq-volunteer-join',
    category: 'volunteering',
    q: 'How can I volunteer with Monroe Humane?',
    a: 'We welcome volunteers for dog walking, cat socialization, kennel enrichment, event assistance, and community outreach. Complete our online volunteer application to get started with an orientation session.',
    link: '/volunteer-form',
    linkText: 'Volunteer Application',
  },
  {
    id: 'faq-doggie-day-out',
    category: 'volunteering',
    q: 'What is the "Doggie Day Out" program?',
    a: 'Doggie Day Out allows approved community members and volunteers to take a shelter dog out for the day to enjoy a local park, get a pup cup, decompress from the shelter, and wear an "Adopt Me" vest to meet potential forever families!',
    link: '/dog-and-cat-shelter',
    linkText: 'Learn About Shelter Programs',
  },
  {
    id: 'faq-group-volunteering',
    category: 'volunteering',
    q: 'Can local businesses or youth groups volunteer together?',
    a: 'Absolutely! We regularly host corporate work days, school service groups, and scout troops for shelter beautification, enrichment toy making, and supply drives. Contact our volunteer team to coordinate a group project.',
    link: '/volunteer-form',
    linkText: 'Group Volunteer Inquiry',
  },
];
---

<BaseLayout
  title={`Frequently Asked Questions | ${SITE.name}`}
  description="Find answers to common questions about animal adoptions, volunteer programs, pet surrenders, donations, and visiting Monroe Humane."
>
  <main class="min-h-screen bg-slate-50/50 pb-20">
    <!-- Hero Banner -->
    <header class="relative overflow-hidden bg-gradient-to-br from-teal-950 via-teal-900 to-slate-900 text-white pt-14 pb-16 px-4 sm:px-6">
      <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#2dd4bf_1px,transparent_1px)] [background-size:16px_16px] pointer-events-none"></div>
      <div class="relative max-w-4xl mx-auto text-center">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 mb-4 backdrop-blur-xs">
          Help &amp; Answers
        </span>
        <h1 class="text-3xl sm:text-5xl font-serif font-bold text-white tracking-tight mb-4">
          Frequently Asked Questions
        </h1>
        <p class="text-base sm:text-lg text-teal-100/80 max-w-2xl mx-auto leading-relaxed">
          Quick answers to common questions regarding pet adoptions, shelter programs, donations, visiting hours, and pet care resources.
        </p>
      </div>
    </header>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 -mt-7">
      <!-- Search Card -->
      <div class="bg-white rounded-2xl shadow-xl shadow-teal-950/5 border border-slate-200/80 p-3 sm:p-4 backdrop-blur-md mb-6">
        <div class="relative flex items-center">
          <svg class="absolute left-4 w-5 h-5 text-teal-700/60 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="search"
            id="faqSearch"
            placeholder="Search questions (e.g. fees, surrender, volunteer, food pantry, hours)..."
            class="w-full pl-12 pr-10 py-3.5 text-slate-800 placeholder-slate-400 text-sm sm:text-base bg-slate-50 focus:bg-white rounded-xl border border-slate-200 focus:border-teal-600 focus:ring-2 focus:ring-teal-600/20 outline-none transition-all"
            autocomplete="off"
          />
          <button
            type="button"
            id="faqClearSearch"
            class="absolute right-3.5 text-slate-400 hover:text-slate-600 hidden p-1"
            aria-label="Clear search"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Filter Pills -->
        <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 mt-3 pt-3 border-t border-slate-100">
          <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider pl-1 hidden sm:inline">Filter:</span>
          {categories.map((cat) => (
            <button
              type="button"
              class={`faq-filter-btn px-3 py-1.5 rounded-full text-xs font-semibold transition-all duration-150 flex items-center gap-1.5 ${
                cat.id === 'all'
                  ? 'bg-teal-900 text-white shadow-xs'
                  : 'bg-slate-100 hover:bg-slate-200/80 text-slate-600 hover:text-slate-900'
              }`}
              data-cat-id={cat.id}
            >
              <span>{cat.icon}</span>
              <span>{cat.label}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Live Results Counter -->
      <div id="faqCountBar" class="flex items-center justify-between px-1 mb-4 text-xs font-medium text-slate-500">
        <span id="faqCountText">Showing all {faqs.length} questions</span>
        <button
          type="button"
          id="faqToggleAll"
          class="text-teal-700 hover:text-teal-900 font-semibold hover:underline"
        >
          Expand All
        </button>
      </div>

      <!-- FAQ List Container -->
      <div id="faqContainer" class="space-y-8">
        {categories.filter((c) => c.id !== 'all').map((cat) => {
          const catFaqs = faqs.filter((f) => f.category === cat.id);
          return (
            <section class="faq-category-group" data-cat-group={cat.id}>
              <div class="flex items-center gap-2.5 pb-3 border-b border-slate-200/80 mb-3">
                <span class="text-xl">{cat.icon}</span>
                <h2 class="text-lg sm:text-xl font-serif font-bold text-teal-950">
                  {cat.label}
                </h2>
                <span class="text-xs font-medium bg-teal-50 text-teal-800 border border-teal-200/70 px-2 py-0.5 rounded-full ml-auto">
                  {catFaqs.length}
                </span>
              </div>

              <div class="space-y-3">
                {catFaqs.map((faq) => (
                  <div
                    class="faq-card bg-white border border-slate-200/90 rounded-2xl shadow-xs transition-all duration-200 hover:border-teal-600/40 hover:shadow-md"
                    data-faq-id={faq.id}
                    data-faq-cat={faq.category}
                    data-faq-q={faq.q.toLowerCase()}
                    data-faq-a={faq.a.toLowerCase()}
                  >
                    <button
                      type="button"
                      class="faq-trigger w-full flex items-center justify-between gap-4 px-5 sm:px-6 py-4 text-left cursor-pointer select-none rounded-2xl focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-600"
                      aria-expanded="false"
                      aria-controls={`content-${faq.id}`}
                    >
                      <span class="text-base sm:text-lg font-medium text-teal-950 pr-2">
                        {faq.q}
                      </span>
                      <span class="faq-icon shrink-0 w-7 h-7 rounded-full bg-slate-100 flex items-center justify-center text-teal-800 transition-transform duration-300">
                        <svg class="w-4 h-4 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                        </svg>
                      </span>
                    </button>

                    <div
                      id={`content-${faq.id}`}
                      class="faq-content grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out"
                    >
                      <div class="overflow-hidden">
                        <div class="px-5 sm:px-6 pb-5 pt-1 text-slate-700 text-sm sm:text-base leading-relaxed border-t border-slate-100">
                          <p>{faq.a}</p>
                          {faq.link && (
                            <p class="mt-3.5">
                              <a
                                href={faq.link}
                                class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-teal-50 hover:bg-teal-100 text-teal-800 border border-teal-200 font-semibold text-xs uppercase tracking-wider transition-colors"
                              >
                                <span>{faq.linkText}</span>
                                <span>&rarr;</span>
                              </a>
                            </p>
                          )}
                        </div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          );
        })}
      </div>

      <!-- Empty State -->
      <div id="faqEmptyState" class="hidden text-center py-16 px-4 bg-white rounded-3xl border border-dashed border-slate-300 mt-4">
        <div class="text-4xl mb-3">🔍</div>
        <h3 class="text-lg font-bold text-slate-800 mb-1">No matching questions found</h3>
        <p class="text-sm text-slate-500 max-w-sm mx-auto mb-5">
          Try searching for a different keyword like "fees", "surrender", "volunteer", or "hours".
        </p>
        <button
          type="button"
          id="faqResetSearchBtn"
          class="px-4 py-2 rounded-full bg-teal-900 text-white text-xs font-bold uppercase tracking-wider hover:bg-teal-800 transition-colors"
        >
          Clear Search &amp; View All
        </button>
      </div>

      <!-- Bottom Support CTA Card -->
      <section class="mt-14 bg-gradient-to-br from-teal-950 via-teal-900 to-slate-900 rounded-3xl p-6 sm:p-10 text-white text-center shadow-lg relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-teal-500/10 rounded-full blur-2xl pointer-events-none"></div>
        <div class="relative max-w-2xl mx-auto">
          <span class="text-3xl mb-3 block">💬</span>
          <h2 class="text-2xl sm:text-3xl font-serif font-bold text-white mb-3">
            Still have questions?
          </h2>
          <p class="text-teal-100/80 mb-6 leading-relaxed text-sm sm:text-base">
            Our adoption center staff is always happy to assist you by phone, email, or in person during shelter hours.
          </p>
          <div class="flex flex-wrap justify-center gap-3">
            <a
              class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-emerald-500 hover:bg-emerald-400 text-teal-950 font-bold uppercase tracking-wider text-xs transition-all hover:-translate-y-0.5 shadow-md"
              href="/contact"
            >
              Contact Our Team
            </a>
            <a
              class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 font-bold uppercase tracking-wider text-xs transition-all hover:-translate-y-0.5 backdrop-blur-xs"
              href={SITE.contact.phoneTel}
            >
              Call {SITE.contact.phoneFormatted}
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  /* Accordion active states */
  .faq-card.is-open .faq-content {
    grid-template-rows: 1fr;
  }
  .faq-card.is-open .faq-icon {
    transform: rotate(45deg);
    background-color: rgb(240 253 250);
    color: rgb(15 118 110);
  }
</style>

<script>
  function initFaq() {
    const searchInput = document.getElementById('faqSearch') as HTMLInputElement | null;
    const clearBtn = document.getElementById('faqClearSearch') as HTMLButtonElement | null;
    const resetBtn = document.getElementById('faqResetSearchBtn') as HTMLButtonElement | null;
    const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.faq-filter-btn'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.faq-card'));
    const categoryGroups = Array.from(document.querySelectorAll<HTMLElement>('.faq-category-group'));
    const emptyState = document.getElementById('faqEmptyState');
    const countText = document.getElementById('faqCountText');
    const toggleAllBtn = document.getElementById('faqToggleAll') as HTMLButtonElement | null;

    let activeCategory = 'all';
    let allExpanded = false;

    // Accordion click handlers
    cards.forEach((card) => {
      const trigger = card.querySelector<HTMLButtonElement>('.faq-trigger');
      trigger?.addEventListener('click', () => {
        const isOpen = card.classList.contains('is-open');
        card.classList.toggle('is-open', !isOpen);
        trigger.setAttribute('aria-expanded', String(!isOpen));
      });
    });

    // Expand / Collapse all
    toggleAllBtn?.addEventListener('click', () => {
      allExpanded = !allExpanded;
      toggleAllBtn.textContent = allExpanded ? 'Collapse All' : 'Expand All';
      cards.forEach((card) => {
        if (card.style.display !== 'none') {
          card.classList.toggle('is-open', allExpanded);
          const trigger = card.querySelector<HTMLButtonElement>('.faq-trigger');
          trigger?.setAttribute('aria-expanded', String(allExpanded));
        }
      });
    });

    function filterFaqs() {
      const query = searchInput?.value.trim().toLowerCase() || '';
      clearBtn?.classList.toggle('hidden', query.length === 0);

      let visibleCount = 0;

      cards.forEach((card) => {
        const cat = card.dataset.faqCat;
        const q = card.dataset.faqQ || '';
        const a = card.dataset.faqA || '';

        const matchesCat = activeCategory === 'all' || cat === activeCategory;
        const matchesQuery = !query || q.includes(query) || a.includes(query);
        const isVisible = matchesCat && matchesQuery;

        card.style.display = isVisible ? '' : 'none';

        if (isVisible) {
          visibleCount++;
          // When searching, auto-expand matching cards
          if (query.length > 0) {
            card.classList.add('is-open');
            card.querySelector<HTMLButtonElement>('.faq-trigger')?.setAttribute('aria-expanded', 'true');
          }
        }
      });

      // Show/hide category section headings if they have no visible cards
      categoryGroups.forEach((group) => {
        const groupCat = group.dataset.catGroup;
        const hasVisibleCards = Array.from(group.querySelectorAll<HTMLElement>('.faq-card')).some(
          (c) => c.style.display !== 'none'
        );
        const matchesCat = activeCategory === 'all' || groupCat === activeCategory;
        group.style.display = matchesCat && hasVisibleCards ? '' : 'none';
      });

      // Update empty state
      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount > 0);
      }

      // Update counter text
      if (countText) {
        if (query) {
          countText.textContent = `Found ${visibleCount} matching question${visibleCount === 1 ? '' : 's'}`;
        } else if (activeCategory !== 'all') {
          countText.textContent = `Showing ${visibleCount} question${visibleCount === 1 ? '' : 's'}`;
        } else {
          countText.textContent = `Showing all ${visibleCount} questions`;
        }
      }
    }

    // Category button clicks
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCategory = btn.dataset.catId || 'all';

        filterBtns.forEach((b) => {
          const isActive = b === btn;
          b.classList.toggle('bg-teal-900', isActive);
          b.classList.toggle('text-white', isActive);
          b.classList.toggle('shadow-xs', isActive);
          b.classList.toggle('bg-slate-100', !isActive);
          b.classList.toggle('text-slate-600', !isActive);
        });

        filterFaqs();
      });
    });

    // Search input
    searchInput?.addEventListener('input', filterFaqs);

    // Clear search
    clearBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
      }
      filterFaqs();
    });

    // Reset button in empty state
    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      activeCategory = 'all';
      filterBtns.forEach((b) => {
        const isAll = b.dataset.catId === 'all';
        b.classList.toggle('bg-teal-900', isAll);
        b.classList.toggle('text-white', isAll);
        b.classList.toggle('shadow-xs', isAll);
        b.classList.toggle('bg-slate-100', !isAll);
        b.classList.toggle('text-slate-600', !isAll);
      });
      filterFaqs();
    });
  }

  document.addEventListener('astro:page-load', initFaq);
</script>