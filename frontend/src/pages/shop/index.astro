---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';

const SQUARE_URL = SITE.integrations.squareStore.url;
const SHOP_ASSETS = '/assets/recovered/images/monroe-humane.org/wp-content/themes/monroe-rebuild/assets/shop';

const products = [
  {
    title: 'Volunteer message tee',
    price: '$28',
    blurb: 'Soft tee with a bold volunteer graphic - great for events and dog walks.',
    image: `${SHOP_ASSETS}/volunteer-tee-back.png`,
    alt: 'Powder blue t-shirt, back view, with volunteer lettering and humane society style artwork.',
  },
  {
    title: 'Classic crew tee',
    price: '$26',
    blurb: 'Clean crewneck for everyday wear - pair with shelter swag or layer under a hoodie.',
    image: `${SHOP_ASSETS}/classic-tee-flatlay.jpg`,
    alt: 'White short-sleeve crewneck t-shirt on a neutral background.',
  },
  {
    title: 'Merch & gifts',
    price: 'From $12',
    blurb: 'Hats, drinkware, apparel, and more - browse the full catalog on our Square store.',
    image: `${SHOP_ASSETS}/merch-store-banner.png`,
    alt: 'Illustration showing hats, mugs, and folded shirts in a merchandise collage.',
    contain: true,
  },
];
---

<BaseLayout title="Shop | 734-243-3669" description="Every purchase helps tails wag and whiskers purr. Browse featured styles, then complete checkout on our secure Square store.">
  <div class="pb-16 min-h-screen bg-gray-50/50 pt-4 sm:pt-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <section class="bg-teal-900 rounded-3xl overflow-hidden shadow-lg flex flex-col lg:flex-row mb-8 sm:mb-10" aria-labelledby="monroe-shop-title">
        <div class="p-6 sm:p-10 lg:p-12 flex-1 flex flex-col justify-center">
          <p class="text-emerald-300 font-bold uppercase tracking-widest text-sm mb-3">Official Shelter Swag</p>
          <h1 id="monroe-shop-title" class="text-3xl sm:text-4xl md:text-5xl font-serif text-white mb-4 leading-tight">Monroe Humane Society Shop</h1>
          <p class="text-teal-100 text-base sm:text-lg mb-6 leading-relaxed">Every purchase helps tails wag and whiskers purr. Browse featured styles below, then complete checkout on our secure Square store.</p>
          <div class="flex flex-wrap gap-3">
            <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-5 py-3 rounded-full transition-all bg-emerald-500 text-teal-900 hover:bg-emerald-400 text-xs" href="#monroe-shop-catalog">Browse Featured Items</a>
            <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-5 py-3 rounded-full transition-all border-2 border-white text-white hover:bg-white hover:text-teal-900 text-xs" href={SQUARE_URL} target="_blank" rel="noopener noreferrer">Open Square Store &rarr;</a>
          </div>
        </div>
        <figure class="w-full lg:w-1/2 relative min-h-[260px] lg:min-h-[420px]">
          <img src={`${SHOP_ASSETS}/merch-store-banner.png`} alt="Illustration of hats, mugs, and folded shirts in a merchandise collage." class="absolute inset-0 w-full h-full object-cover" loading="eager" decoding="async" />
        </figure>
      </section>

      <section id="monroe-shop-catalog" class="mb-12 sm:mb-16">
        <div class="text-center max-w-3xl mx-auto mb-6 sm:mb-8">
          <span class="inline-block bg-teal-100 text-teal-800 font-bold uppercase tracking-widest text-xs px-3 py-1 rounded-full mb-3">Featured</span>
          <h2 class="text-3xl sm:text-4xl font-serif text-teal-900 mb-2">Popular Picks</h2>
          <p class="text-gray-600 text-base">Inventory, pricing, and shipping are managed on Square. Select an item to open the live store in a new tab.</p>
        </div>

        <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {products.map((p) => (
            <li class="bg-white rounded-3xl overflow-hidden shadow-sm border border-gray-100 flex flex-col hover:shadow-md transition-shadow">
              <div class="aspect-square bg-gray-100 relative p-8 flex items-center justify-center">
                <img src={p.image} alt={p.alt} class={`w-full h-full ${p.contain ? 'object-contain' : 'object-cover mix-blend-multiply'}`} loading="lazy" decoding="async" />
              </div>
              <div class="p-8 flex flex-col flex-1">
                <h3 class="text-2xl font-serif text-teal-900 mb-2">{p.title}</h3>
                <p class="text-emerald-600 font-bold mb-4">{p.price}</p>
                <p class="text-gray-600 mb-8 flex-1">{p.blurb}</p>
                <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-6 py-3 rounded-full transition-all bg-teal-50 text-teal-700 hover:bg-teal-100 w-full" href={SQUARE_URL} target="_blank" rel="noopener noreferrer">Shop on Square</a>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section id="shop-products" class="bg-teal-900 text-white rounded-3xl overflow-hidden shadow-xl p-8 sm:p-12 lg:p-16">
        <div class="flex flex-col lg:flex-row gap-12 lg:gap-24">
          <div class="flex-1">
            <h2 class="text-4xl font-serif mb-6">Checkout on Square</h2>
            <p class="text-teal-100 text-lg mb-8">Taxes, shipping, and payment are handled securely by Square.</p>
            <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-8 py-4 rounded-full transition-all bg-emerald-500 text-teal-900 hover:bg-emerald-400 w-full mb-8 shadow-sm" href={SQUARE_URL} target="_blank" rel="noopener noreferrer">Visit the online store</a>
            <div class="bg-white rounded-2xl overflow-hidden h-[600px] w-full">
              <iframe class="w-full h-full" title="Square online store" src={SQUARE_URL} loading="lazy"></iframe>
            </div>
            <p class="text-sm text-teal-200 mt-4 text-center">If the preview is blank, use the button above - some browsers block store embeds.</p>
          </div>
          <aside class="w-full lg:w-1/3 pt-8 lg:pt-0 lg:border-l lg:border-white/10 lg:pl-16 flex flex-col justify-center">
            <h3 id="monroe-shop-why-title" class="text-2xl font-serif mb-6">Why shop with us?</h3>
            <ul class="space-y-6 text-teal-50">
              <li class="flex items-start gap-4">
                <span class="text-emerald-400 mt-1">✓</span>
                <span>Proceeds fund shelter care &amp; adoption programs</span>
              </li>
              <li class="flex items-start gap-4">
                <span class="text-emerald-400 mt-1">✓</span>
                <span>Secure payments via Square</span>
              </li>
              <li class="flex items-start gap-4">
                <span class="text-emerald-400 mt-1">✓</span>
                <span>Perfect gifts for fosters &amp; volunteers</span>
              </li>
            </ul>
            <div class="mt-12 p-6 bg-white/5 rounded-2xl border border-white/10">
              <p class="text-sm text-teal-100 font-medium">Questions about an order? Call the shelter at <a href="tel:734-243-3669" class="text-emerald-400 hover:text-emerald-300">734-243-3669</a>.</p>
            </div>
          </aside>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>
