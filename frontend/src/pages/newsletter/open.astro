---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Newsletter | 734-243-3669" description="Monroe Humane Society Newsletter issue.">
  <div class="pb-24 px-4 max-w-7xl mx-auto mt-12" data-newsletter-issue data-newsletter-runtime>
    <div id="nl-shell" class="bg-white rounded-3xl overflow-hidden shadow-lg border border-gray-100">
      <div class="w-full bg-[#e7f0ec] px-3 pt-3 sm:px-4 sm:pt-4">
        <div class="relative w-full overflow-hidden rounded-2xl bg-[#dce8e3] aspect-[1168/514]">
          <img data-nl-hero src="https://mchs-directus.livelyfield-d0a70609.eastus.azurecontainerapps.io/assets/78654ea7-9572-4fe4-8f30-ac71319b44bd" alt="" class="absolute inset-0 h-full w-full object-contain object-center" loading="eager" decoding="async" />
        </div>
      </div>
      <header class="px-6 sm:px-10 pt-7 pb-8 bg-gradient-to-b from-[#f7fbf9] to-white border-b border-teal-900/10">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
          <div class="min-w-0 max-w-3xl">
            <p class="m-0 mb-3 inline-flex items-center rounded-full bg-teal-800/10 px-3 py-1 font-['Jost','Segoe_UI',sans-serif] text-[0.72rem] font-bold uppercase tracking-[0.14em] text-teal-800" data-nl-topline>PO Box 1457 • Monroe, MI</p>
            <h1 class="m-0 font-serif text-[clamp(2.25rem,5vw,3.75rem)] font-normal leading-[1.08] tracking-[0.01em] text-[#143534]" data-nl-headline>Loading…</h1>
            <h2 class="m-0 mt-3 text-lg sm:text-xl font-semibold text-teal-900/90" data-nl-masthead>Monroe Humane Society Newsletter</h2>
            <p class="m-0 mt-2 text-base text-[#5b6f6e]" data-nl-byline></p>
          </div>
          <div class="flex flex-wrap gap-2.5 lg:justify-end" role="group" aria-label="Newsletter actions">
            <a data-nl-pdf href="#" class="hidden inline-flex min-h-[2.75rem] items-center justify-center rounded-full border-2 border-teal-800 bg-white px-5 py-2.5 text-sm font-bold uppercase tracking-wider text-teal-800 transition hover:bg-teal-50" target="_blank" rel="noopener noreferrer">Download PDF</a>
            <a href="/adopt/dogs" class="inline-flex min-h-[2.75rem] items-center justify-center rounded-full bg-teal-800 px-5 py-2.5 text-sm font-bold uppercase tracking-wider text-white shadow-md transition hover:bg-teal-950">See Adoptable Dogs</a>
            <a href="/adopt/cats" class="inline-flex min-h-[2.75rem] items-center justify-center rounded-full bg-teal-800 px-5 py-2.5 text-sm font-bold uppercase tracking-wider text-white shadow-md transition hover:bg-teal-950">See Adoptable Cats</a>
            <a href="/adopt" class="inline-flex min-h-[2.75rem] items-center justify-center rounded-full border-2 border-teal-800 bg-white px-5 py-2.5 text-sm font-bold uppercase tracking-wider text-teal-800 transition hover:bg-teal-50">See All Pets</a>
          </div>
        </div>
      </header>
      <div class="p-8 sm:p-12 bg-white">
        <div class="grid grid-cols-1 gap-8 max-w-3xl mx-auto" data-nl-blocks></div>
      </div>
    </div>

    <nav class="flex justify-center gap-8 mt-12 pt-8 border-t border-gray-200" aria-label="Related pages">
      <a class="text-teal-700 font-bold uppercase tracking-wider text-sm hover:text-emerald-600 transition-colors" href="/newsletter">Newsletter archive</a>
      <a class="text-teal-700 font-bold uppercase tracking-wider text-sm hover:text-emerald-600 transition-colors" href="/">Back to home</a>
    </nav>
  </div>
</BaseLayout>

<script>
  import { hydrateIssuePage, slugFromPath } from '../../scripts/newsletter-hydrate';

  function showMissingIssue() {
    const root = document.querySelector('[data-newsletter-issue]');
    const shell = document.getElementById('nl-shell');
    if (!root || document.getElementById('nl-missing')) {
      shell?.classList.add('hidden');
      return;
    }
    shell?.classList.add('hidden');
    const missing = document.createElement('div');
    missing.id = 'nl-missing';
    missing.className = 'max-w-xl mx-auto text-center py-24';
    missing.innerHTML = `
      <h1 class="text-3xl font-serif text-teal-900 mb-4">Issue not found</h1>
      <p class="text-gray-600 mb-8">That newsletter is not published, or the link is out of date.</p>
      <a class="text-teal-700 font-bold uppercase tracking-wider text-sm hover:text-emerald-600" href="/newsletter">Back to archive</a>
    `;
    root.prepend(missing);
  }

  let started = false;
  async function init() {
    if (started) return;
    started = true;
    const ok = await hydrateIssuePage(slugFromPath());
    if (!ok) showMissingIssue();
  }
  document.addEventListener('astro:page-load', init);
</script>
