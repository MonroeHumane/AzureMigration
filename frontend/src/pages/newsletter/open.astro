---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Newsletter | 734-243-3669" description="Monroe Humane Society Newsletter issue.">
  <div class="pb-24 px-4 max-w-7xl mx-auto mt-12" data-newsletter-issue data-newsletter-runtime>
    <div id="nl-shell" class="bg-white rounded-3xl overflow-hidden shadow-lg border border-gray-100">
      <div class="w-full bg-[#e7f0ec]">
        <div class="relative w-full aspect-[1168/514] max-h-[min(28rem,55vh)] mx-auto">
          <img data-nl-hero src="https://mchs-directus.livelyfield-d0a70609.eastus.azurecontainerapps.io/assets/78654ea7-9572-4fe4-8f30-ac71319b44bd" alt="" class="absolute inset-0 h-full w-full object-contain object-center" loading="eager" decoding="async" />
        </div>
      </div>
      <div class="px-8 sm:px-12 pt-8 pb-6 bg-[#f7fbf9] border-b border-gray-100">
        <p class="text-teal-700 font-bold uppercase tracking-widest text-sm mb-2" data-nl-topline>PO Box 1457 • Monroe, MI</p>
        <h1 class="text-3xl sm:text-5xl font-serif text-teal-950 mb-3" data-nl-headline>Loading…</h1>
      </div>
      <div class="p-8 sm:p-12 border-b border-gray-100 flex flex-col md:flex-row md:items-center justify-between gap-6 bg-gray-50">
        <div>
          <h2 class="text-2xl font-bold text-teal-900 mb-1" data-nl-masthead>Monroe Humane Society Newsletter</h2>
          <div class="text-gray-500 font-medium" data-nl-byline></div>
        </div>
        <div class="flex flex-wrap gap-4" role="group" aria-label="Quick pet filters">
          <a data-nl-pdf href="#" class="hidden inline-flex items-center justify-center font-bold uppercase tracking-wider px-6 py-3 rounded-full transition-all shadow-md hover:-translate-y-1 border-2 border-teal-700 text-teal-700 hover:bg-teal-50 text-sm" target="_blank" rel="noopener noreferrer">Download PDF</a>
          <a href="/adopt/dogs" class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-6 py-3 rounded-full transition-all shadow-md hover:-translate-y-1 bg-teal-700 text-white hover:bg-teal-900 text-sm">See Adoptable Dogs</a>
          <a href="/adopt/cats" class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-6 py-3 rounded-full transition-all shadow-md hover:-translate-y-1 bg-teal-700 text-white hover:bg-teal-900 text-sm">See Adoptable Cats</a>
          <a href="/adopt" class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-6 py-3 rounded-full transition-all border-2 border-teal-700 text-teal-700 hover:-translate-y-1 hover:bg-teal-50 text-sm">See All Pets</a>
        </div>
      </div>
      <div class="p-8 sm:p-12 bg-white">
        <div class="grid grid-cols-1 gap-8 max-w-3xl mx-auto" data-nl-blocks></div>
      </div>
    </div>

    <nav class="flex justify-center gap-8 mt-12 pt-8 border-t border-gray-200" aria-label="Related pages">
      <a class="text-teal-700 font-bold uppercase tracking-wider text-sm hover:text-emerald-600 transition-colors" href="/newsletter">Newsletter archive</a>
      <a class="text-teal-700 font-bold uppercase tracking-wider text-sm hover:text-emerald-600 transition-colors" href="/">Back to home</a>
    </nav>
  </div>
</BaseLayout>

<script>
  import { hydrateIssuePage, slugFromPath } from '../../scripts/newsletter-hydrate';

  function showMissingIssue() {
    const root = document.querySelector('[data-newsletter-issue]');
    const shell = document.getElementById('nl-shell');
    if (!root || document.getElementById('nl-missing')) {
      shell?.classList.add('hidden');
      return;
    }
    shell?.classList.add('hidden');
    const missing = document.createElement('div');
    missing.id = 'nl-missing';
    missing.className = 'max-w-xl mx-auto text-center py-24';
    missing.innerHTML = `
      <h1 class="text-3xl font-serif text-teal-900 mb-4">Issue not found</h1>
      <p class="text-gray-600 mb-8">That newsletter is not published, or the link is out of date.</p>
      <a class="text-teal-700 font-bold uppercase tracking-wider text-sm hover:text-emerald-600" href="/newsletter">Back to archive</a>
    `;
    root.prepend(missing);
  }

  let started = false;
  async function init() {
    if (started) return;
    started = true;
    const ok = await hydrateIssuePage(slugFromPath());
    if (!ok) showMissingIssue();
  }
  document.addEventListener('astro:page-load', init);
</script>
