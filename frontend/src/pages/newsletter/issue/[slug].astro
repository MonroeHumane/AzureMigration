---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getNewsletterIssues } from '../../../lib/directus';
import { SITE } from '../../../config/site';

export async function getStaticPaths() {
  const issues = await getNewsletterIssues();
  const paths = issues.filter((issue) => issue.slug).map((issue) => ({
    params: { slug: issue.slug },
    props: { issue },
  }));
  const have = new Set(paths.map((path) => path.params.slug));
  for (const slug of ['2025-in-review', 'september-2026']) {
    if (have.has(slug)) continue;
    paths.push({
      params: { slug },
      props: {
        issue: {
          id: 'stub',
          title: slug === 'september-2026' ? 'September 2026' : 'Monroe Humane Society Newsletter',
          slug,
          byline: 'Humane Society of Monroe County',
          top_line: 'PO Box 1457 • Monroe, MI',
          newsletter_title: 'Monroe Humane Society Newsletter',
          hero_image: '/assets/recovered/images/monroe-humane.org/wp-content/uploads/2026/05/0dcb5211-4496-4c57-9b4a-73f5f856a667.png',
          excerpt: 'Stories, updates, and highlights from shelter care and community support.',
          blocks: [],
        },
      },
    });
  }
  return paths;
}

const { issue } = Astro.props;
const formatIssueLabel = (value?: string, fallback = '') => {
  if (!value) return fallback;
  const d = /^\d{4}-\d{2}-\d{2}$/.test(value) ? new Date(`${value}T12:00:00`) : new Date(value);
  if (Number.isNaN(d.getTime())) return fallback;
  return d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
};
const displayHeadline =
  issue.main_headline ||
  (issue as any).heading ||
  formatIssueLabel(issue.issue_date, '') ||
  issue.title ||
  'Newsletter';
const storyBlocks = (issue.blocks || []).filter((block: any) => !block.type || block.type === 'story');
const useTwoCol = storyBlocks.length >= 2 && storyBlocks.every((block: any) => String(block.body || '').length < 500);
const seoTitle = issue.seo_title || `${issue.title} | 734-243-3669`;
const seoDescription = issue.seo_description || issue.excerpt || `Monroe Humane Society Newsletter — ${issue.title}.`;
const newsArticle = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: issue.seo_title || issue.main_headline || issue.title,
  description: seoDescription,
  image: issue.hero_image ? [issue.hero_image] : undefined,
  datePublished: issue.issue_date || undefined,
  author: {
    '@type': 'Organization',
    name: issue.byline || 'Humane Society of Monroe County',
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
  mainEntityOfPage: `${SITE.url}/newsletter/issue/${issue.slug}`,
};
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={issue.hero_image}
  jsonLd={newsArticle}
>
  <div class="pb-24 px-4 max-w-7xl mx-auto mt-12" data-newsletter-issue>
    <div class="bg-white rounded-3xl overflow-hidden shadow-lg border border-gray-100">
      
      {/* Merch collage — full image, no overlays, no max-height clipping into the title. */}
      <div class="w-full bg-[#e7f0ec] px-3 pt-3 sm:px-4 sm:pt-4">
        <div class="relative w-full overflow-hidden rounded-2xl bg-[#dce8e3] aspect-[1168/514]">
          <img
            data-nl-hero
            src={issue.hero_image}
            alt={issue.title}
            class="absolute inset-0 h-full w-full object-contain object-center"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>

      {/* Title masthead — clear, unclipped, always shows 2026 issue label */}
      <header class="px-6 sm:px-10 pt-7 pb-8 bg-gradient-to-b from-[#f7fbf9] to-white border-b border-teal-900/10">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
          <div class="min-w-0 max-w-3xl">
            <p
              class="m-0 mb-3 inline-flex items-center rounded-full bg-teal-800/10 px-3 py-1 font-['Jost','Segoe_UI',sans-serif] text-[0.72rem] font-bold uppercase tracking-[0.14em] text-teal-800"
              data-nl-topline
            >
              {issue.top_line || 'PO Box 1457 • Monroe, MI'}
            </p>
            <h1
              class="m-0 font-serif text-[clamp(2.25rem,5vw,3.75rem)] font-normal leading-[1.08] tracking-[0.01em] text-[#143534]"
              data-nl-headline
            >
              {displayHeadline}
            </h1>
            <h2
              id="hs-news-issue-title"
              class="m-0 mt-3 text-lg sm:text-xl font-semibold text-teal-900/90"
              data-nl-masthead
            >
              {issue.newsletter_title || 'Monroe Humane Society Newsletter'}
            </h2>
            <p class="m-0 mt-2 text-base text-[#5b6f6e]" data-nl-byline>
              {issue.byline || 'by, Jacqueline Monteer'}
            </p>
          </div>
          <div class="flex flex-wrap gap-2.5 lg:justify-end" role="group" aria-label="Newsletter actions">
            <a
              data-nl-pdf
              href={issue.pdf_url || '#'}
              class:list={['inline-flex min-h-[2.75rem] items-center justify-center rounded-full border-2 border-teal-800 bg-white px-5 py-2.5 text-sm font-bold uppercase tracking-wider text-teal-800 transition hover:bg-teal-50', !issue.pdf_url && 'hidden']}
              target="_blank"
              rel="noopener noreferrer"
            >Download PDF</a>
            <a href="/adopt/dogs" class="inline-flex min-h-[2.75rem] items-center justify-center rounded-full bg-teal-800 px-5 py-2.5 text-sm font-bold uppercase tracking-wider text-white shadow-md transition hover:bg-teal-950">See Adoptable Dogs</a>
            <a href="/adopt/cats" class="inline-flex min-h-[2.75rem] items-center justify-center rounded-full bg-teal-800 px-5 py-2.5 text-sm font-bold uppercase tracking-wider text-white shadow-md transition hover:bg-teal-950">See Adoptable Cats</a>
            <a href="/adopt" class="inline-flex min-h-[2.75rem] items-center justify-center rounded-full border-2 border-teal-800 bg-white px-5 py-2.5 text-sm font-bold uppercase tracking-wider text-teal-800 transition hover:bg-teal-50">See All Pets</a>
          </div>
        </div>
      </header>

      <div class="p-8 sm:p-12 bg-white">
        <div class:list={['grid', 'gap-8', useTwoCol ? 'grid-cols-1 md:grid-cols-2 md:gap-12' : 'grid-cols-1 max-w-3xl mx-auto']} data-nl-blocks>
          {storyBlocks.map((block: any) => (
            <div class="prose prose-teal max-w-none">
              {block.title ? <h3 class="text-2xl font-serif text-teal-900 mb-6">{block.title}</h3> : null}
              {(block.body ?? '').split('\n').filter(Boolean).map((para: string) => (
                <p class="text-gray-700 leading-relaxed mb-4">{para}</p>
              ))}
            </div>
          ))}
        </div>
      </div>
      
    </div>

    <nav class="flex justify-center gap-8 mt-12 pt-8 border-t border-gray-200" aria-label="Related pages">
      <a class="text-teal-700 font-bold uppercase tracking-wider text-sm hover:text-emerald-600 transition-colors" href="/newsletter">Newsletter archive</a>
      <a class="text-teal-700 font-bold uppercase tracking-wider text-sm hover:text-emerald-600 transition-colors" href="/">Back to home</a>
    </nav>
  </div>
</BaseLayout>

<script>
  import { hydrateIssuePage } from '../../../scripts/newsletter-hydrate';
  function init() {
    hydrateIssuePage();
  }
  document.addEventListener('astro:page-load', init);
</script>
