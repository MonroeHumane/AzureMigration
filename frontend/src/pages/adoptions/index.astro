---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';

const ADOPTION_FORM_URL = SITE.integrations.googleForms.adoptionApp;
---

<BaseLayout
  title="Adoptions | Monroe County | 734-243-3669"
  description="Find a pet, review our policy, and submit one application - everything you need to adopt from Monroe Humane is on this page."
>
  <div class="pb-16 px-4 max-w-4xl mx-auto">
    <header class="text-center mb-8 sm:mb-10">
      <p class="text-emerald-500 font-bold uppercase tracking-widest text-sm mb-3">Adoption</p>
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-serif text-teal-900 mb-4">Adoptions | Monroe County</h1>
      <p class="text-lg sm:text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
        Find a pet, review our policy, and submit one application - everything you need to adopt from Monroe Humane is on this page.
      </p>
    </header>

    <ol class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8" aria-label="Adoption steps">
      <li class="bg-teal-50 rounded-2xl p-6 border border-teal-100 flex flex-col">
        <span class="w-10 h-10 bg-teal-900 text-white rounded-full flex items-center justify-center font-bold text-lg mb-4" aria-hidden="true">1</span>
        <strong class="text-lg font-serif text-teal-900 mb-2">Browse pets</strong>
        <p class="text-sm text-gray-600">Search adoptable dogs and cats and note the name of any animal you want to meet.</p>
      </li>
      <li class="bg-teal-50 rounded-2xl p-6 border border-teal-100 flex flex-col">
        <span class="w-10 h-10 bg-teal-900 text-white rounded-full flex items-center justify-center font-bold text-lg mb-4" aria-hidden="true">2</span>
        <strong class="text-lg font-serif text-teal-900 mb-2">Review policy</strong>
        <p class="text-sm text-gray-600">Read requirements below so your visit goes smoothly.</p>
      </li>
      <li class="bg-teal-50 rounded-2xl p-6 border border-teal-100 flex flex-col">
        <span class="w-10 h-10 bg-teal-900 text-white rounded-full flex items-center justify-center font-bold text-lg mb-4" aria-hidden="true">3</span>
        <strong class="text-lg font-serif text-teal-900 mb-2">Apply online</strong>
        <p class="text-sm text-gray-600">Submit the form and our team will follow up with next steps.</p>
      </li>
    </ol>

    <nav class="flex flex-wrap justify-center gap-2.5 sm:gap-3 mb-10 sm:mb-12" aria-label="On this page">
      <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-5 py-3 rounded-full bg-emerald-500 text-teal-900 hover:bg-emerald-400 transition-colors shadow-xs text-xs min-h-[42px]" href="/adopt">Browse adoptable pets</a>
      <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-5 py-3 rounded-full bg-gray-100 text-teal-900 hover:bg-gray-200 transition-colors text-xs min-h-[42px]" href="#AdoptionPolicy">Adoption policy</a>
      <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-5 py-3 rounded-full bg-gray-100 text-teal-900 hover:bg-gray-200 transition-colors text-xs min-h-[42px]" href="#Application">Application form</a>
      <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-5 py-3 rounded-full bg-transparent text-teal-700 hover:bg-teal-50 transition-colors text-xs min-h-[42px]" href="tel:734-243-3669">734-243-3669</a>
    </nav>

    <section id="AdoptionPolicy" class="mb-10 sm:mb-12 scroll-mt-28" tabindex="-1" aria-labelledby="monroe-adoptions-policy-heading">
      <h2 id="monroe-adoptions-policy-heading" class="text-2xl sm:text-3xl font-serif text-teal-900 mb-4">Adoption policy</h2>
      <div class="prose prose-teal max-w-none text-gray-700 mb-6 text-sm sm:text-base">
        <p>
          We match animals to homes based on the pet’s needs, your household, and local ordinances. Staff may ask for landlord approval, vet references, or a meet-and-greet with resident pets.
        </p>
        <p>
          Adopters must be 18 or older with a valid ID. Some animals require a fenced yard, quiet indoor-only homes, or experienced handlers - we will explain any special requirements for the pet you choose.
        </p>
      </div>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm text-gray-700">
        <li class="flex items-start gap-2.5">
          <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span>Valid photo ID and proof of address</span>
        </li>
        <li class="flex items-start gap-2.5">
          <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span>Landlord approval if you rent</span>
        </li>
        <li class="flex items-start gap-2.5">
          <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span>All household members present for a meet-and-greet when possible</span>
        </li>
        <li class="flex items-start gap-2.5">
          <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span>Existing pets up to date on vaccinations</span>
        </li>
      </ul>
    </section>

    <section class="bg-gray-50 rounded-2xl p-6 sm:p-8 mb-10 sm:mb-12 border border-gray-100" aria-labelledby="monroe-adoptions-expect-heading">
      <h2 id="monroe-adoptions-expect-heading" class="text-xl sm:text-2xl font-serif text-teal-900 mb-3">What happens next</h2>
      <div class="prose prose-teal max-w-none text-gray-700 text-sm sm:text-base">
        <p>
          Submit an adoption interest form so we can talk before finalizing a match. If you already have a pet in mind, include their name in your message. A team member will call or email to schedule a visit and discuss fees.
        </p>
        <p>
          Prefer not to use the online form? Call or email the shelter with the animal’s name (if known) and the best time to reach you.
        </p>
      </div>
    </section>

    <section id="Application" class="bg-white rounded-2xl shadow-xs border border-gray-100 p-5 sm:p-8 mb-10 scroll-mt-28" tabindex="-1" aria-labelledby="monroe-adoptions-application-heading">
      <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-6">
        <h2 id="monroe-adoptions-application-heading" class="text-3xl font-serif text-teal-900">Adoption application</h2>
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
          <a class="inline-flex items-center justify-center w-full sm:w-auto font-bold uppercase tracking-wider px-6 py-4 rounded-full transition-all bg-emerald-500 text-teal-900 hover:bg-emerald-400 shadow-sm min-h-[48px]" href="https://forms.gle/oMTQAaDiLyDRXBwK8" target="_blank" rel="noopener noreferrer">Open form in new tab</a>
          <a class="inline-flex items-center justify-center w-full sm:w-auto font-bold uppercase tracking-wider px-6 py-4 rounded-full transition-all border-2 border-teal-700 text-teal-700 hover:bg-teal-50 min-h-[48px]" href="/adopt">Back to pet search</a>
        </div>
      </div>
      <div class="w-full relative min-h-[2800px] md:min-h-[2200px] bg-gray-50 rounded-2xl overflow-hidden shadow-inner">
        <iframe
          title="Adoption interest form"
          src={`${ADOPTION_FORM_URL}?embedded=true`}
          class="absolute inset-0 w-full h-full"
          loading="lazy"></iframe>
      </div>
      <p class="text-sm text-gray-500 text-center mt-4">
        Prefer a full-screen view? <a href={ADOPTION_FORM_URL} target="_blank" rel="noopener noreferrer" class="text-teal-700 underline underline-offset-2 hover:text-teal-900">Open application in a new tab &rarr;</a>
      </p>
    </section>

    <section class="text-center" aria-labelledby="monroe-adoptions-contact-heading">
      <h2 id="monroe-adoptions-contact-heading" class="text-2xl font-serif text-teal-900 mb-4">Questions?</h2>
      <ul class="flex flex-col sm:flex-row justify-center items-center gap-3 sm:gap-8 text-base sm:text-lg">
        <li><a class="text-emerald-600 hover:text-emerald-700 font-medium inline-flex items-center min-h-[44px]" href="tel:734-243-3669">734-243-3669</a></li>
        <li><a class="text-emerald-600 hover:text-emerald-700 font-medium inline-flex items-center min-h-[44px]" href="mailto:info@monroe-humane.org">info@monroe-humane.org</a></li>
      </ul>
    </section>
  </div>
</BaseLayout>
