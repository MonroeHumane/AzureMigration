---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerShell from '../../components/InnerShell.astro';
import { SITE } from '../../config/site';
import '../../styles/monroe-adopt-extra.css';

const ADOPTION_FORM_URL = SITE.integrations.googleForms.adoptionApp;
---

<BaseLayout
  title="Adoptions | Monroe County | 734-243-3669"
  description="Find a pet, review our policy, and submit one application - everything you need to adopt from Monroe Humane is on this page."
>
  <InnerShell variant="adoptions">
    <header class="monroe-adoptions-hero">
        <p class="monroe-adoptions-eyebrow">Adoption</p>
        <h1>Adoptions | Monroe County</h1>
        <p class="monroe-adoptions-lead">
          Find a pet, review our policy, and submit one application - everything you need to adopt from Monroe Humane is on this page.
        </p>
      </header>

      <ol class="monroe-adoptions-steps" aria-label="Adoption steps">
        <li class="monroe-adoptions-step">
          <span class="monroe-adoptions-step__num" aria-hidden="true">1</span>
          <div>
            <strong>Browse pets</strong>
            <p>Search adoptable dogs and cats and note the name of any animal you want to meet.</p>
          </div>
        </li>
        <li class="monroe-adoptions-step">
          <span class="monroe-adoptions-step__num" aria-hidden="true">2</span>
          <div>
            <strong>Review policy</strong>
            <p>Read requirements below so your visit goes smoothly.</p>
          </div>
        </li>
        <li class="monroe-adoptions-step">
          <span class="monroe-adoptions-step__num" aria-hidden="true">3</span>
          <div>
            <strong>Apply online</strong>
            <p>Submit the form and our team will follow up with next steps.</p>
          </div>
        </li>
      </ol>

      <nav class="monroe-adoptions-quick" aria-label="On this page">
        <a class="monroe-adoptions-pill monroe-adoptions-pill--primary" href="/adopt">Browse adoptable pets</a>
        <a class="monroe-adoptions-pill" href="#AdoptionPolicy">Adoption policy</a>
        <a class="monroe-adoptions-pill" href="#Application">Application form</a>
        <a class="monroe-adoptions-pill monroe-adoptions-pill--ghost" href="tel:734-243-3669">734-243-3669</a>
      </nav>

      <section id="AdoptionPolicy" class="monroe-adoptions-section" tabindex="-1" aria-labelledby="monroe-adoptions-policy-heading">
        <h2 id="monroe-adoptions-policy-heading">Adoption policy</h2>
        <div class="monroe-adoptions-prose">
          <p>
            We match animals to homes based on the pet’s needs, your household, and local ordinances. Staff may ask for landlord approval, vet references, or a meet-and-greet with resident pets.
          </p>
          <p>
            Adopters must be 18 or older with a valid ID. Some animals require a fenced yard, quiet indoor-only homes, or experienced handlers - we will explain any special requirements for the pet you choose.
          </p>
        </div>
        <ul class="monroe-adoptions-checklist">
          <li>Valid photo ID and proof of address</li>
          <li>Landlord approval if you rent</li>
          <li>All household members present for a meet-and-greet when possible</li>
          <li>Existing pets up to date on vaccinations</li>
        </ul>
      </section>

      <section class="monroe-adoptions-section monroe-adoptions-section--muted" aria-labelledby="monroe-adoptions-expect-heading">
        <h2 id="monroe-adoptions-expect-heading">What happens next</h2>
        <div class="monroe-adoptions-prose">
          <p>
            Submit an adoption interest form so we can talk before finalizing a match. If you already have a pet in mind, include their name in your message. A team member will call or email to schedule a visit and discuss fees.
          </p>
          <p>
            Prefer not to use the online form? Call or email the shelter with the animal’s name (if known) and the best time to reach you.
          </p>
        </div>
      </section>

      <section id="Application" class="monroe-adoptions-section monroe-adoptions-section--form" tabindex="-1" aria-labelledby="monroe-adoptions-application-heading">
        <div class="monroe-adoptions-form-header">
          <h2 id="monroe-adoptions-application-heading">Adoption application</h2>
          <div class="monroe-adoptions-form-actions">
            <a class="monroe-btn" href="https://forms.gle/oMTQAaDiLyDRXBwK8" target="_blank" rel="noopener noreferrer">Open form in new tab</a>
            <a class="monroe-btn monroe-btn--outline" href="/adopt">Back to pet search</a>
          </div>
        </div>
        <div
          class="monroe-google-form-embed monroe-adopt-form-embed monroe-google-form-embed--adoption"
          style="--monroe-form-embed-h:2200px;--monroe-form-embed-h-mobile:2800px;--monroe-form-embed-h-active:2200px;"
          data-form-height="2200"
          data-form-height-mobile="2800"
          data-thank-you-height="520"
        >
          <iframe
            title="Adoption interest form"
            src={`${ADOPTION_FORM_URL}?embedded=true`}
            width="640"
            height="2200"
            style="border: 0;"
            loading="lazy"></iframe>
        </div>
        <p class="monroe-google-form-embed__hint">
          Google Forms cannot auto-size in iframes. If the form is cut off or has extra space below, use Open form in new tab.
        </p>
      </section>

      <section class="monroe-adoptions-contact" aria-labelledby="monroe-adoptions-contact-heading">
        <h2 id="monroe-adoptions-contact-heading">Questions?</h2>
        <ul class="monroe-adoptions-contact-list">
          <li><a href="tel:734-243-3669">734-243-3669</a></li>
          <li><a href="mailto:info@monroe-humane.org">info@monroe-humane.org</a></li>
        </ul>
      </section>
  </InnerShell>
</BaseLayout>
