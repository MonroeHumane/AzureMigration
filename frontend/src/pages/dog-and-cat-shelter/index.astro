---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/dog-cat-shelter.css';

const IMG = '/assets/recovered/images/lirp.cdn-website.com/77cfa591/dms3rep/multi/opt';
const DONATE_URL = '/donate';

const dayCards = [
  {
    src: `${IMG}/452546926_883292250498381_6921668243561390358_n-1920w.jpg`,
    alt: 'A group of people sitting on a bench with a dog at the shelter.',
    category: 'Morning Routine',
    title: 'Supervised playgroups',
    copy: 'Dogs play in matched groups of two to five with staff and volunteers watching every interaction.',
  },
  {
    src: `${IMG}/450429686_875396881287918_7603871138057923160_n-1920w.jpg`,
    alt: 'A white dog laying in the grass with a yellow ball on a Doggy Day Out outing.',
    category: 'Community Outing',
    title: 'Doggy Day Out',
    copy: 'Volunteers take dogs to parks, lakes, and calm outings that build confidence away from the kennel.',
  },
  {
    src: `${IMG}/444445234_867747615386178_1349564242973393587_n-af65a848-1920w.jpg`,
    alt: 'A close-up of a cat resting comfortably in the shelter cat room.',
    category: 'Quiet Hours',
    title: 'Comfortable kennels',
    copy: 'Air conditioning in dog kennels and the cat room keeps everyone cool and resting well.',
  },
];
---

<BaseLayout
  title="Dog & Cat Shelter | Monroe County | 734-243-3669"
  description="Trusted dog and cat shelter in Monroe County, Michigan. We care for dogs and cats until they find forever homes."
  bodyClass="monroe-inner-page page-slug-dog-and-cat-shelter"
>
  <div class="monroe-inner-page-shell monroe-native-inner monroe-native-inner--dog-and-cat-shelter">
    <div class="monroe-inner-page-shell__content">

      <!-- Hero Section -->
      <header class="monroe-shelter-hero" aria-labelledby="monroe-shelter-title">
        <div class="monroe-shelter-hero__copy">
          <p class="monroe-native-eyebrow">About our shelter</p>
          <h1 id="monroe-shelter-title">Dog &amp; cat shelter</h1>
          <p class="monroe-native-lead">
            Trusted dog and cat shelter in Monroe County, Michigan. We care for dogs and cats until they find forever homes &mdash; playful kittens, loyal dogs, and everyone in between get the individualized attention they need to thrive.
          </p>

          <div class="monroe-shelter-hero__actions">
            <a class="monroe-shelter-button monroe-shelter-button--primary" href="/adopt">View adoptable pets</a>
            <a class="monroe-shelter-button" href="tel:734-243-3669">Call 734-243-3669</a>
            <a class="monroe-shelter-button" href="/contact">Contact</a>
          </div>

          <ul class="monroe-shelter-hero__facts" aria-label="Shelter credentials">
            <li>
              <strong>Fear Free</strong>
              <span>Certified shelter team</span>
            </li>
            <li>
              <strong>Since 1954</strong>
              <span>Monroe County, MI</span>
            </li>
            <li>
              <strong>501(c)(3)</strong>
              <span>Community nonprofit</span>
            </li>
          </ul>
        </div>

        <div class="monroe-shelter-hero__visual">
          <div class="monroe-shelter-hero__note">
            <span>Warm, loving care every day</span>
          </div>
          <figure class="monroe-shelter-hero__main-photo">
            <img
              src={`${IMG}/452546926_883292250498381_6921668243561390358_n-1920w.jpg`}
              alt="Dog enjoying time with Monroe Humane volunteers"
              loading="eager"
              decoding="async"
            />
          </figure>
          <figure class="monroe-shelter-hero__inset-photo">
            <img
              src={`${IMG}/444445234_867747615386178_1349564242973393587_n-af65a848-1920w.jpg`}
              alt="Cat resting comfortably in shelter room"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
      </header>

      <!-- Navigation Pills -->
      <nav class="monroe-inner-page-pills monroe-shelter-pills" aria-label="On this page">
        <a class="monroe-inner-page-pills__link" href="#HowWeCare">How we care</a>
        <a class="monroe-inner-page-pills__link" href="#OurStory">Our story</a>
        <a class="monroe-inner-page-pills__link" href="#DayInLife">Day in the life</a>
        <a class="monroe-inner-page-pills__link" href="#GetInvolved">Get involved</a>
      </nav>

      <!-- How We Care Section -->
      <section id="HowWeCare" class="monroe-shelter-care" aria-labelledby="monroe-dog-cat-care-heading">
        <div class="monroe-shelter-section-heading">
          <div>
            <p class="monroe-native-eyebrow">Low-stress sheltering</p>
            <h2 id="monroe-dog-cat-care-heading">How we care for animals</h2>
          </div>
          <p>Every pet receives low-stress handling, daily exercise, group play, and temperature-controlled comfort.</p>
        </div>

        <div class="monroe-shelter-care__grid">
          <div class="monroe-shelter-care__card">
            <span class="monroe-shelter-care__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </span>
            <h3>Fear Free &amp; The Please Program</h3>
            <p>Our entire team is certified in the Fear Free program. We also incorporate The Please Program so animals quiet and settle calmly before coming out of their kennel and receiving treats.</p>
          </div>

          <div class="monroe-shelter-care__card">
            <span class="monroe-shelter-care__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
            </span>
            <h3>Playgroups, walks &amp; leash manners</h3>
            <p>Dogs benefit immensely from group playtime. We match dogs in supervised groups of two to five, and encourage volunteers and staff to help dogs learn good leash manners with all four paws on the ground.</p>
          </div>

          <div class="monroe-shelter-care__card">
            <span class="monroe-shelter-care__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 14 14"/></svg>
            </span>
            <h3>Doggy Day Out &amp; foster sleepovers</h3>
            <p>Volunteers take shelter dogs out for park strolls, lake visits, and pup cups. Staff often take pets home overnight to relieve kennel stress and give them a sense of home.</p>
          </div>

          <div class="monroe-shelter-care__card">
            <span class="monroe-shelter-care__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
            </span>
            <h3>Comfort in the building</h3>
            <p>Our facility features dedicated air conditioning throughout all dog kennels and the cat room. Animals rotate through office and community cuddle areas to decompress and prepare for family life.</p>
          </div>
        </div>
      </section>

      <!-- Our Story Section -->
      <section id="OurStory" class="monroe-shelter-story" aria-labelledby="monroe-dog-cat-mission-heading">
        <div class="monroe-shelter-story__photo">
          <img
            src={`${IMG}/450429686_875396881287918_7603871138057923160_n-1920w.jpg`}
            alt="A white rescue dog resting peacefully on the grass with a ball"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="monroe-shelter-story__copy">
          <p class="monroe-native-eyebrow">Our legacy &amp; mission</p>
          <h2 id="monroe-dog-cat-mission-heading">A safe haven since 1954</h2>
          <p>
            For more than seventy years the Humane Society of Monroe County has rehabilitated and rehomed dogs, puppies, cats, and kittens while promoting responsible pet ownership. Our mission is to provide a safe haven with the love and daily care every homeless pet deserves until they find a forever home.
          </p>
          <blockquote>
            &ldquo;Dedicated to providing a safe haven, compassionate care, and second chances for every animal that comes through our doors.&rdquo;
          </blockquote>
        </div>
      </section>

      <!-- Trust Row -->
      <section class="monroe-trust-row monroe-shelter-trust" aria-label="Trust and credentials">
        <ul class="monroe-trust-row__list">
          <li class="monroe-trust-row__item">
            <span class="monroe-trust-row__number">70+</span>
            <strong class="monroe-trust-row__label">Years of Service</strong>
            <span class="monroe-trust-row__detail">Serving Monroe County families and homeless pets since 1954</span>
          </li>
          <li class="monroe-trust-row__item">
            <span class="monroe-trust-row__number">100%</span>
            <strong class="monroe-trust-row__label">Fear Free Certified</strong>
            <span class="monroe-trust-row__detail">Team trained in gentle, low-stress animal handling</span>
          </li>
          <li class="monroe-trust-row__item">
            <span class="monroe-trust-row__number">501(c)(3)</span>
            <strong class="monroe-trust-row__label">Community Nonprofit</strong>
            <span class="monroe-trust-row__detail">Funded entirely by donors, volunteers, and local partners</span>
          </li>
        </ul>
      </section>

      <!-- Day in the Life Section -->
      <section id="DayInLife" class="monroe-day-in-life" aria-labelledby="monroe-dog-cat-day-heading">
        <div class="monroe-shelter-section-heading">
          <div>
            <p class="monroe-native-eyebrow">Shelter routines</p>
            <h2 id="monroe-dog-cat-day-heading">A day in the life at our shelter</h2>
          </div>
          <p>A peek inside our daily routines, enrichment programs, and volunteer outings.</p>
        </div>

        <div class="monroe-day-in-life__grid">
          {dayCards.map((card) => (
            <article class="monroe-day-in-life__card">
              <div class="monroe-day-in-life__media">
                <img src={card.src} alt={card.alt} loading="lazy" decoding="async" />
              </div>
              <div class="monroe-day-in-life__body">
                <span>{card.category}</span>
                <h3>{card.title}</h3>
                <p>{card.copy}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Get Involved Section -->
      <section id="GetInvolved" class="monroe-shelter-involved" aria-labelledby="monroe-dog-cat-involved-heading">
        <div class="monroe-shelter-involved__heading">
          <p class="monroe-native-eyebrow">Make a difference</p>
          <h2 id="monroe-dog-cat-involved-heading">Get involved</h2>
          <p>
            Adoption, volunteering, and giving power everything we do. Volunteers lead playgroups, Doggy Day Out outings, and daily enrichment. When you are ready to adopt, apply, donate, or ask a question, connect with our team!
          </p>
        </div>

        <div class="monroe-shelter-involved__grid">
          <a href="/adopt">
            <span aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </span>
            <strong>Search adoptable pets</strong>
            <small>Browse dogs and cats ready for adoption</small>
            <b aria-hidden="true">&rarr;</b>
          </a>
          <a href="/adoptions">
            <span aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </span>
            <strong>Adoption policy &amp; app</strong>
            <small>Learn how our matching process works</small>
            <b aria-hidden="true">&rarr;</b>
          </a>
          <a href="/volunteer-form">
            <span aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </span>
            <strong>Volunteer application</strong>
            <small>Help with playgroups, walks, and events</small>
            <b aria-hidden="true">&rarr;</b>
          </a>
          <a href={DONATE_URL} target="_blank" rel="noopener noreferrer">
            <span aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
            </span>
            <strong>Donate online</strong>
            <small>Fund food, medical care, and warm shelter</small>
            <b aria-hidden="true">&rarr;</b>
          </a>
        </div>

        <div class="monroe-shelter-involved__links">
          <a href="/contact">Contact form &amp; hours</a>
          <a href="/faq">Frequently asked questions</a>
          <a href="/#FeaturedPets">Featured pets on homepage</a>
          <a href="/#Donations">Ways to give</a>
        </div>
      </section>

    </div>
  </div>

  <script>
    // In-page navigation pills: active section tracking
    const pillLinks = document.querySelectorAll<HTMLAnchorElement>('.monroe-shelter-pills .monroe-inner-page-pills__link');
    if (pillLinks.length && 'IntersectionObserver' in window) {
      const sectionIds = Array.from(pillLinks)
        .map((a) => a.getAttribute('href')?.replace('#', ''))
        .filter(Boolean) as string[];

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              pillLinks.forEach((link) => {
                const active = link.getAttribute('href') === `#${entry.target.id}`;
                link.classList.toggle('is-active', active);
                if (active) {
                  link.setAttribute('aria-current', 'true');
                } else {
                  link.removeAttribute('aria-current');
                }
              });
            }
          });
        },
        { rootMargin: '-15% 0px -65% 0px' }
      );

      sectionIds.forEach((id) => {
        const el = document.getElementById(id);
        if (el) observer.observe(el);
      });
    }
  </script>
</BaseLayout>
