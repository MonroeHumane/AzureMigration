---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerShell from '../../components/InnerShell.astro';
import '../../styles/monroe-shelter.css';

const IMG = '/assets/recovered/images/lirp.cdn-website.com/77cfa591/dms3rep/multi/opt';
const DONATE_URL = '/donate';

const dayCards = [
  {
    src: `${IMG}/452546926_883292250498381_6921668243561390358_n-1920w.jpg`,
    alt: 'A group of people sitting on a bench with a dog at the shelter.',
    title: 'Supervised playgroups',
    copy: 'Dogs play in matched groups of two to five with staff and volunteers watching every interaction.',
  },
  {
    src: `${IMG}/450429686_875396881287918_7603871138057923160_n-1920w.jpg`,
    alt: 'A white dog laying in the grass with a yellow ball on a Doggy Day Out outing.',
    title: 'Doggy Day Out',
    copy: 'Volunteers take dogs to parks, lakes, and calm outings that build confidence away from the kennel.',
  },
  {
    src: `${IMG}/444445234_867747615386178_1349564242973393587_n-af65a848-1920w.jpg`,
    alt: 'A close-up of a cat resting comfortably in the shelter cat room.',
    title: 'Comfortable kennels',
    copy: 'Air conditioning in dog kennels and the cat room keeps everyone cool and resting well.',
  },
];
---

<BaseLayout
  title="Dog & Cat Shelter | Monroe County | 734-243-3669"
  description="Trusted dog and cat shelter in Monroe County, Michigan. We care for dogs and cats until they find forever homes."
>
  <InnerShell variant="dog-and-cat-shelter">
    <!-- Hero Header -->
    <header class="monroe-shelter-hero">
      <div class="monroe-shelter-hero__copy">
        <p class="monroe-native-eyebrow">About our shelter</p>
        <h1>Dog &amp; cat shelter</h1>
        <p class="monroe-native-lead">
          Trusted dog and cat shelter in Monroe County, Michigan. We care for dogs and cats until they find forever homes — playful kittens, loyal dogs, and everyone in between get the individualized attention they need to thrive.
        </p>
        <div class="monroe-shelter-hero__actions">
          <a class="monroe-shelter-button monroe-shelter-button--primary" href="/adopt">View adoptable pets</a>
          <a class="monroe-shelter-button" href="tel:734-243-3669">Call 734-243-3669</a>
          <a class="monroe-shelter-button" href="/contact">Contact us</a>
        </div>
        <ul class="monroe-shelter-hero__facts">
          <li>
            <strong>Fear Free</strong>
            <span>Certified shelter team</span>
          </li>
          <li>
            <strong>Since 1954</strong>
            <span>Monroe County, MI</span>
          </li>
          <li>
            <strong>501(c)(3)</strong>
            <span>Community nonprofit</span>
          </li>
        </ul>
      </div>
      <div class="monroe-shelter-hero__visual">
        <figure class="monroe-shelter-hero__main-photo">
          <img
            src={`${IMG}/452546926_883292250498381_6921668243561390358_n-1920w.jpg`}
            alt="Dog enjoying time with Monroe Humane volunteers"
            loading="eager"
            decoding="async"
            width="600"
            height="500"
          />
        </figure>
        <figure class="monroe-shelter-hero__inset-photo">
          <img
            src={`${IMG}/444445234_867747615386178_1349564242973393587_n-af65a848-1920w.jpg`}
            alt="Cat resting comfortably in shelter room"
            loading="lazy"
            decoding="async"
            width="250"
            height="250"
          />
        </figure>
        <div class="monroe-shelter-hero__note">
          <span>🐾</span> Warm, loving care every day
        </div>
      </div>
    </header>

    <!-- Navigation Pills -->
    <nav class="monroe-shelter-pills monroe-inner-page-pills" aria-label="On this page">
      <a class="monroe-inner-page-pills__link" href="#HowWeCare">How we care</a>
      <a class="monroe-inner-page-pills__link" href="#OurStory">Our story</a>
      <a class="monroe-inner-page-pills__link" href="#DayInLife">Day in the life</a>
      <a class="monroe-inner-page-pills__link" href="#GetInvolved">Get involved</a>
    </nav>

    <!-- How We Care -->
    <section class="monroe-shelter-care" id="HowWeCare" aria-labelledby="monroe-dog-cat-care-heading">
      <div class="monroe-shelter-section-heading">
        <h2 id="monroe-dog-cat-care-heading">How we care for animals</h2>
        <p>Every pet receives low-stress handling, daily exercise, group play, and temperature-controlled comfort.</p>
      </div>

      <div class="monroe-shelter-care__grid">
        <div class="monroe-shelter-care__card">
          <div class="monroe-shelter-care__icon" aria-hidden="true">🌿</div>
          <h3>Fear Free &amp; The Please Program</h3>
          <p>
            Our entire team is trained and certified in the Fear Free program. We also incorporate The Please Program so animals learn to settle calmly before leaving their kennel.
          </p>
        </div>

        <div class="monroe-shelter-care__card">
          <div class="monroe-shelter-care__icon" aria-hidden="true">🐕</div>
          <h3>Playgroups, walks &amp; leash manners</h3>
          <p>
            Dogs benefit immensely from group playtime. We match dogs in supervised groups of two to five, and help them master leash manners with all four paws on the ground.
          </p>
        </div>

        <div class="monroe-shelter-care__card">
          <div class="monroe-shelter-care__icon" aria-hidden="true">🚗</div>
          <h3>Doggy Day Out &amp; foster sleepovers</h3>
          <p>
            Volunteers take shelter dogs out for park strolls, lake visits, and pup cups. Staff often take pets home overnight to relieve kennel stress and assess household fit.
          </p>
        </div>

        <div class="monroe-shelter-care__card">
          <div class="monroe-shelter-care__icon" aria-hidden="true">❄️</div>
          <h3>Climate-controlled comfort</h3>
          <p>
            Our facility features dedicated air conditioning and heating throughout all dog kennels, cat rooms, and cuddle offices so every animal stays safe and relaxed.
          </p>
        </div>
      </div>
    </section>

    <!-- Story / Mission -->
    <section class="monroe-shelter-story" id="OurStory" aria-labelledby="monroe-dog-cat-mission-heading">
      <div style="padding: clamp(2rem, 5vw, 4rem); color: #fff;">
        <p class="monroe-native-eyebrow" style="color: #f2bd61;">Our Legacy</p>
        <h2 id="monroe-dog-cat-mission-heading" style="margin-bottom: 1rem;">A safe haven since 1954</h2>
        <p style="color: rgba(255, 255, 255, 0.9); font-size: 1.15rem; line-height: 1.7; max-width: 600px;">
          For more than seventy years the Humane Society of Monroe County has rehabilitated and rehomed dogs, puppies, cats, and kittens while promoting responsible pet ownership. Our mission is to provide a safe haven with the love and daily care every homeless pet deserves until they find a forever home.
        </p>
      </div>
      <div style="min-height: 320px; position: relative;">
        <img
          src={`${IMG}/450429686_875396881287918_7603871138057923160_n-1920w.jpg`}
          alt="Happy dog resting on grass"
          width="1920"
          height="1271"
          loading="lazy"
          decoding="async"
          style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;"
        />
      </div>
    </section>

    <!-- Day in the Life -->
    <section class="monroe-day-in-life" id="DayInLife" aria-labelledby="monroe-dog-cat-day-heading">
      <div class="monroe-shelter-section-heading">
        <h2 id="monroe-dog-cat-day-heading">A day in the life at our shelter</h2>
        <p>A peek inside our daily routines, enrichment programs, and volunteer outings.</p>
      </div>
      <div class="monroe-day-in-life__grid">
        {dayCards.map((card) => (
          <article class="monroe-day-in-life__card">
            <div class="monroe-day-in-life__media">
              <img src={card.src} alt={card.alt} loading="lazy" decoding="async" width="1920" height="1280" />
            </div>
            <h3>{card.title}</h3>
            <p>{card.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Get Involved -->
    <section class="monroe-shelter-involved" id="GetInvolved" aria-labelledby="monroe-dog-cat-involved-heading">
      <div class="monroe-shelter-care__card" style="background: linear-gradient(135deg, #fff9ee 0%, #fff 100%);">
        <h2 id="monroe-dog-cat-involved-heading">Get involved</h2>
        <p style="font-size: 1.1rem; line-height: 1.7; max-width: 750px; color: #4b5563; margin-bottom: 2rem;">
          Adoption, volunteering, and giving power everything we do. Volunteers lead playgroups, Doggy Day Out outings, and daily enrichment. When you are ready to adopt, apply, donate, or ask a question, connect with our team!
        </p>
        <div class="monroe-shelter-hero__actions">
          <a class="monroe-shelter-button monroe-shelter-button--primary" href="/adopt">Search adoptable pets</a>
          <a class="monroe-shelter-button" href="/adoptions">Adoption policy &amp; application</a>
          <a class="monroe-shelter-button" href="/volunteer-form">Volunteer application</a>
          <a class="monroe-shelter-button" href={DONATE_URL} target="_blank" rel="noopener noreferrer">Donate</a>
          <a class="monroe-shelter-button" href="/resources">Shelter services</a>
        </div>
      </div>
    </section>
  </InnerShell>
</BaseLayout>
