---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerShell from '../../components/InnerShell.astro';
import '../../styles/monroe-shelter.css';

const IMG = '/assets/recovered/images/lirp.cdn-website.com/77cfa591/dms3rep/multi/opt';
const DONATE_URL = 'https://www.betterunite.com/adopthsmc';

const dayCards = [
  {
    src: `${IMG}/452546926_883292250498381_6921668243561390358_n-1920w.jpg`,
    alt: 'A group of people sitting on a bench with a dog at the shelter.',
    title: 'Supervised playgroups',
    copy: 'Dogs play in matched groups of two to five with staff and volunteers watching every interaction.',
  },
  {
    src: `${IMG}/450429686_875396881287918_7603871138057923160_n-1920w.jpg`,
    alt: 'A white dog laying in the grass with a yellow ball on a Doggy Day Out outing.',
    title: 'Doggy Day Out',
    copy: 'Volunteers take dogs to parks, lakes, and calm outings that build confidence away from the kennel.',
  },
  {
    src: `${IMG}/444445234_867747615386178_1349564242973393587_n-af65a848-1920w.jpg`,
    alt: 'A close-up of a cat resting comfortably in the shelter cat room.',
    title: 'Comfortable kennels',
    copy: 'Air conditioning in dog kennels and the cat room keeps everyone cool and resting well.',
  },
];
---

<BaseLayout
  title="Dog & Cat Shelter | Monroe County | 734-243-3669"
  description="Trusted dog and cat shelter in Monroe County, Michigan. We care for dogs and cats until they find forever homes."
>
  <InnerShell variant="dog-and-cat-shelter">
    <header class="monroe-native-hero">
      <p class="monroe-native-eyebrow">About our shelter</p>
      <h1>Dog &amp; cat shelter</h1>
      <p class="monroe-native-lead">
        Trusted dog and cat shelter in Monroe County, Michigan. We care for dogs and cats until they find forever homes, playful kittens, loyal dogs, and everyone in between get the attention they need to thrive.
      </p>
      <div class="monroe-native-actions">
        <a class="monroe-btn" href="/adopt">View adoptable pets</a>
        <a class="monroe-btn monroe-btn--outline" href="tel:734-243-3669">Call us <span class="monroe-native-nowrap">734-243-3669</span></a>
        <a class="monroe-btn monroe-btn--outline" href="/#Contact">Contact</a>
      </div>
    </header>

    <nav class="monroe-inner-page-pills" aria-label="On this page">
      <a class="monroe-inner-page-pills__link" href="#monroe-dog-cat-care-heading">How we care</a>
      <a class="monroe-inner-page-pills__link" href="#monroe-dog-cat-mission-heading">Our story</a>
      <a class="monroe-inner-page-pills__link" href="#monroe-dog-cat-day-heading">Day in the life</a>
      <a class="monroe-inner-page-pills__link" href="#monroe-dog-cat-involved-heading">Get involved</a>
    </nav>

    <section class="monroe-native-stack monroe-native-anchor-section" aria-labelledby="monroe-dog-cat-care-heading">
      <h2 id="monroe-dog-cat-care-heading">How we care for animals</h2>
      <h3>Fear Free and The Please Program</h3>
      <p>
        We are a Fear Free shelter: our team is certified in the Fear Free program. We also incorporate The Please Program. Animals are asked to quiet and settle before coming out of their kennel and receiving a treat.
      </p>
      <h3>Playgroups, walks, and leash skills</h3>
      <p>
        We have found that dogs benefit more from playtime in groups than from traditional walks alone. We match dogs in groups of two to five so they can play together with supervision. Some dogs may go for walks after playtime, while others may not want to, we listen to each animal’s needs.
      </p>
      <p>
        During walks, we encourage volunteers and staff to help dogs learn good leash manners and keep four feet on the ground at all times, preparing them for homes with elderly family members or children.
      </p>
      <h3>Doggy Day Out and home-like experiences</h3>
      <p>
        Through our Doggy Day Out program, volunteers take dogs out for the day, parks, local lakes, or visits to someone’s home. Some dogs enjoy car rides with the window down or drive-thrus that offer pup cups. Staff often take animals home overnight to give them a sense of home and help with adjustment.
      </p>
      <p>
        We provide cuddle time for all animals and rotate them through office and community areas to relieve stress and prepare them for their forever homes.
      </p>
      <h3>Comfort in the building</h3>
      <p>Our shelter has air conditioning in all the kennels and the cat room for the comfort of our animals.</p>
    </section>

    <section class="monroe-native-stack" aria-labelledby="monroe-dog-cat-mission-heading">
      <h2 id="monroe-dog-cat-mission-heading">A safe haven since 1954</h2>
      <p>
        For more than seventy years the Humane Society of Monroe County has rehabilitated and rehomed dogs, puppies, cats, and kittens while promoting responsible pet ownership. Our mission is to provide a safe haven with the love and daily care every homeless pet deserves until they find a forever home.
      </p>
    </section>

    <section class="monroe-trust-row" aria-label="Trust and credentials">
      <ul class="monroe-trust-row__list">
        <li class="monroe-trust-row__item">
          <span class="monroe-trust-row__label">Fear Free certified</span>
          <span class="monroe-trust-row__detail">Team trained in low-stress animal handling</span>
        </li>
        <li class="monroe-trust-row__item">
          <span class="monroe-trust-row__label">Since 1954</span>
          <span class="monroe-trust-row__detail">Serving Monroe County families and pets</span>
        </li>
        <li class="monroe-trust-row__item">
          <span class="monroe-trust-row__label">Community nonprofit</span>
          <span class="monroe-trust-row__detail">Supported by donors, volunteers, and partners</span>
        </li>
      </ul>
    </section>

    <section class="monroe-day-in-life" aria-labelledby="monroe-dog-cat-day-heading">
      <h2 id="monroe-dog-cat-day-heading">A day in the life at our shelter</h2>
      <div class="monroe-day-in-life__grid">
        {dayCards.map((card) => (
          <article class="monroe-day-in-life__card">
            <div class="monroe-day-in-life__media">
              <img src={card.src} alt={card.alt} loading="lazy" decoding="async" width="1920" height="1280" />
            </div>
            <h3>{card.title}</h3>
            <p>{card.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="monroe-native-stack monroe-native-anchor-section" aria-labelledby="monroe-dog-cat-involved-heading">
      <h2 id="monroe-dog-cat-involved-heading">Get involved</h2>
      <p>
        Adoption, volunteering, and giving happen across our site, not duplicated here. Volunteers power playgroups, Doggy Day Out outings, and daily enrichment described above. When you are ready to adopt, apply, donate, or ask a question, use the links below.
      </p>
      <div class="monroe-native-actions">
        <a class="monroe-btn" href="/adopt">Search adoptable pets</a>
        <a class="monroe-btn monroe-btn--outline" href="/adoptions">Adoption policy &amp; application</a>
        <a class="monroe-btn monroe-btn--outline" href="/volunteer-form">Volunteer application</a>
        <a class="monroe-btn monroe-btn--outline" href={DONATE_URL} target="_blank" rel="noopener noreferrer">Donate</a>
        <a class="monroe-btn monroe-btn--outline" href="/resources">Shelter services</a>
      </div>
      <ul class="monroe-native-list monroe-native-foot">
        <li><a href="/#Contact">Contact form &amp; hours</a></li>
        <li><a href="/#FAQ">Frequently asked questions</a></li>
        <li><a href="/#FeaturedPets">Featured pets on the homepage</a></li>
        <li><a href="/#Donations">Ways to give on the homepage</a></li>
      </ul>
    </section>
  </InnerShell>
</BaseLayout>
