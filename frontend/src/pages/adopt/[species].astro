---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdoptSearchBody from '../../components/AdoptSearchBody.astro';

/*
 Species landing pages — the WP /adopt/species-dog/ and /adopt/species-cat/
 pages are the adopt page with a preselected type (legacy URLs redirect here).
*/

export function getStaticPaths() {
  const SPECIES = {
    dogs: {
      heading: 'Adoptable dogs',
      title: 'Adoptable Dogs | Monroe County | 734-243-3669',
      description: 'Meet dogs waiting for homes at the Humane Society of Monroe County. Filter by name, breed, or gender.',
      type: 'dog',
      current: 'dogs' as const,
    },
    cats: {
      heading: 'Adoptable cats',
      title: 'Adoptable Cats | Monroe County | 734-243-3669',
      description: 'Meet cats and kittens waiting for homes at the Humane Society of Monroe County. Filter by name, breed, or gender.',
      type: 'cat',
      current: 'cats' as const,
    },
    other: {
      heading: 'Other adoptable animals',
      title: 'Other Adoptable Animals | Monroe County | 734-243-3669',
      description: 'Meet other animals waiting for homes at the Humane Society of Monroe County.',
      type: 'other',
      current: 'all' as const,
    },
  };
  return Object.entries(SPECIES).map(([species, page]) => ({ params: { species }, props: { page } }));
}

const { page } = Astro.props;
---

<BaseLayout title={page.title} description={page.description}>
  <AdoptSearchBody heading={page.heading} current={page.current} defaultType={page.type} />
</BaseLayout>
