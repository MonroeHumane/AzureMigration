---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PetCard from '../../components/PetCard.astro';
import { getPets, type Pet } from '../../lib/directus';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const pets = await getPets();
  return pets.map((pet) => ({
    params: { id: pet.id },
    props: { pet, related: pets.filter((p) => p.type === pet.type && p.id !== pet.id).slice(0, 3) },
  }));
}

interface Props {
  pet: Pet;
  related: Pet[];
}

const { pet, related } = Astro.props;

const genderLabel = pet.gender === 'female' ? 'Female' : pet.gender === 'male' ? 'Male' : 'Unknown';
const genderIcon = pet.gender === 'female' ? '♀' : pet.gender === 'male' ? '♂' : '?';
const speciesTag = pet.type === 'dog' ? 'Dog' : pet.type === 'cat' ? 'Cat' : pet.species_label || 'Pet';
const photo = pet.image_webp || pet.image_url || pet.image || '/placeholder.svg';

const chipClasses: Record<string, string> = {
  dog: 'bg-sky-100 text-sky-800',
  cat: 'bg-sky-100 text-sky-800',
  other: 'bg-sky-100 text-sky-800',
};

let intakeDisplay = '';
if (pet.intake_date) {
  const d = new Date(pet.intake_date);
  if (!isNaN(d.getTime())) {
    intakeDisplay = d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
  }
}

const bio = pet.description && pet.description.trim() && pet.description !== pet.location
  ? pet.description
  : `${pet.name} is currently staying at our shelter${pet.location ? ` in the ${pet.location}` : ''}. ${pet.name} is looking for a loving forever home in Monroe County. Visit during shelter hours or submit an online adoption application today!`;

// Adoptédex Companion Card computation (matching card-model.js)
const isCat = pet.type === 'cat';
const ageLower = (pet.age_display || pet.age || '').toLowerCase();
const isBaby = ageLower.includes('puppy') || ageLower.includes('kitten') || ageLower.includes('baby') || ageLower.includes('month');
const isSenior = ageLower.includes('7 year') || ageLower.includes('8 year') || ageLower.includes('9 year') || ageLower.includes('10 year') || ageLower.includes('senior');

let rarityLabel = 'Shelter Companion';
let rarityKey = 'common';
let signatureMove = isCat
  ? { name: 'Purr Motor Surge', effect: 'Emits a soothing 45 Hz frequency that eases human stress instantly.' }
  : { name: 'Tail Wiggle Storm', effect: 'Wags tail at lightning speed, spreading enthusiasm throughout the shelter.' };

if (pet.archived_at) {
  rarityKey = 'alumni';
  rarityLabel = 'Adopted Alumni';
  signatureMove = { name: 'Forever Home Glow', effect: 'Fills the room with endless joy and unlocks unforgettable alumni memories.' };
} else if (isSenior) {
  rarityKey = 'golden_senior';
  rarityLabel = 'Golden Senior';
  signatureMove = { name: 'Gentle Soul Radiance', effect: 'Bestows utter peacefulness, granting maximum cuddle priority.' };
} else if (isBaby) {
  rarityKey = 'tiny_wonder';
  rarityLabel = 'Tiny Wonder';
  signatureMove = isCat
    ? { name: 'Pounce of Curiosity', effect: 'Darts across the room chasing phantom dust motes with 200% agility.' }
    : { name: 'Puppy Eyes Beam', effect: 'Instantly disarms all human skepticism, securing extra belly rubs.' };
} else if (pet.location === 'Foster Care') {
  rarityKey = 'longtimer';
  rarityLabel = 'Shelter Champion';
  signatureMove = { name: 'Shelter Champion Bond', effect: 'Guarantees unyielding lifelong loyalty and warm welcoming greetings.' };
}

// Deterministic attributes based on pet ID
const hashNum = (pet.id || '0').split('').reduce((acc, c) => acc + c.charCodeAt(0), 0);
const stats = {
  energy: 65 + (hashNum % 30),
  cuddle: 75 + ((hashNum * 3) % 24),
  loyalty: 80 + ((hashNum * 7) % 20),
};
---

<BaseLayout
  title={`Meet ${pet.name} | Adoptable ${speciesTag} | Monroe County`}
  description={`${pet.name} is a ${pet.age_display || ''} ${pet.breed || speciesTag} looking for a home at the Humane Society of Monroe County.`}
  image={photo}
>
  <div class="max-w-7xl mx-auto px-4 py-8 sm:py-12 pb-28 sm:pb-12">
    <a class="inline-block text-teal-700 font-bold mb-8 hover:text-teal-900 transition-colors uppercase tracking-wider text-sm" href="/adopt" data-smart-back>&larr; Back to all pets</a>

    <div class="bg-white rounded-3xl overflow-hidden shadow-sm border border-gray-200 md:flex md:gap-8 lg:gap-10 p-5 sm:p-8 lg:p-10 mb-16">
      <div class="w-full md:w-5/12 lg:w-5/12 flex-shrink-0 relative rounded-2xl overflow-hidden bg-gray-100 aspect-square md:aspect-[4/5] self-start mb-6 md:mb-0">
        <Image src={photo} alt={pet.name} width={480} height={600} decoding="async" class="w-full h-full object-cover absolute inset-0" />
        <span class="absolute top-4 left-4 bg-white/90 backdrop-blur px-4 py-1.5 rounded-full font-bold text-teal-900 tracking-wider text-sm shadow-sm">{speciesTag}</span>
      </div>

      <div class="flex-1">
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-teal-900 mb-2">{pet.name}</h1>
        <p class="text-base sm:text-lg text-gray-500 mb-6 font-medium">{pet.breed}</p>

        <div class="flex flex-wrap gap-2 mb-8">
          <span class={`px-3 py-1.5 rounded-lg font-bold text-sm tracking-wide ${chipClasses[pet.type] || chipClasses.other}`}>{speciesTag}</span>
          <span class="px-3 py-1.5 rounded-lg font-bold text-sm tracking-wide bg-amber-100 text-amber-900">{pet.age_display || 'Unknown age'}</span>
          <span class="px-3 py-1.5 rounded-lg font-bold text-sm tracking-wide bg-fuchsia-100 text-fuchsia-900">{genderIcon} {genderLabel}</span>
          {pet.size && <span class="px-3 py-1.5 rounded-lg font-bold text-sm tracking-wide bg-slate-100 text-slate-800">{pet.size}</span>}
          {pet.color && <span class="px-3 py-1.5 rounded-lg font-bold text-sm tracking-wide bg-slate-100 text-slate-800">{pet.color}</span>}
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 mb-8 bg-gray-50 rounded-2xl p-4 sm:p-6 border border-gray-100">
          <div class="flex flex-col"><strong class="text-xs uppercase tracking-widest text-gray-400 mb-1">Location</strong><span class="font-medium text-gray-800">{pet.location || 'Shelter'}</span></div>
          {intakeDisplay && <div class="flex flex-col"><strong class="text-xs uppercase tracking-widest text-gray-400 mb-1">At the shelter since</strong><span class="font-medium text-gray-800">{intakeDisplay}</span></div>}
          {pet.declawed && <div class="flex flex-col"><strong class="text-xs uppercase tracking-widest text-gray-400 mb-1">Declawed</strong><span class="font-medium text-gray-800">{pet.declawed}</span></div>}
          {pet.housetrained && <div class="flex flex-col"><strong class="text-xs uppercase tracking-widest text-gray-400 mb-1">Housetrained</strong><span class="font-medium text-gray-800">{pet.housetrained}</span></div>}
        </div>

        <div class="mb-10">
          <h2 class="text-2xl font-bold text-teal-900 mb-4">About {pet.name}</h2>
          <p class="text-gray-700 leading-relaxed whitespace-pre-wrap">{bio}</p>
        </div>

        <div class="flex flex-wrap gap-4 pt-8 border-t border-gray-200">
          <a class="inline-flex items-center justify-center w-full sm:w-auto font-bold uppercase tracking-wider px-8 py-4 rounded-full bg-teal-700 text-white transition-all shadow-md hover:-translate-y-1 hover:bg-teal-900 min-h-[48px]" href="/adoptions#Application">Apply to Adopt {pet.name} &rarr;</a>
          <a class="inline-flex items-center justify-center w-full sm:w-auto font-bold uppercase tracking-wider px-8 py-4 rounded-full bg-transparent border-2 border-teal-700 text-teal-700 transition-all hover:-translate-y-1 hover:bg-teal-50 min-h-[48px]" href="tel:734-243-3669">(734) 243-3669</a>
          <button
            type="button"
            class="pet-detail-favorite-btn inline-flex items-center justify-center gap-2 w-full sm:w-auto font-bold uppercase tracking-wider px-8 py-4 rounded-full bg-transparent border-2 border-gray-300 text-gray-600 transition-all hover:-translate-y-1 hover:border-teal-700 hover:text-teal-700 min-h-[48px] cursor-pointer"
            data-pet-detail-favorite-btn
            data-pet-id={pet.id}
            aria-pressed="false"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            <span data-pet-detail-favorite-label>Save to Favorites</span>
          </button>
        </div>
      </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════
         Interactive Adoptédex Companion Card Showcase (Kennel Bridge)
         ══════════════════════════════════════════════════════════ -->
    <section class="mb-16 bg-gradient-to-br from-stone-900 via-teal-950 to-slate-950 rounded-3xl p-6 sm:p-10 text-white shadow-xl border border-teal-800/40 relative overflow-hidden">
      <!-- Background Ambient Glow -->
      <div class="absolute -right-20 -top-20 w-80 h-80 bg-teal-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -left-20 -bottom-20 w-80 h-80 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <!-- Left: Explainer & Action -->
        <div class="lg:col-span-7 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-500/20 border border-teal-400/30 text-teal-300 text-xs font-bold uppercase tracking-wider">
            <span>✨</span>
            <span>Official Adoptédex Collector Card</span>
          </div>

          <h2 class="text-2xl sm:text-3xl font-serif text-white tracking-tight">
            Collect {pet.name} as a Virtual Companion
          </h2>

          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Scanning a kennel card in person or visiting {pet.name} online? You can officially discover and add {pet.name} to your Monroe Humane <strong>Adoptédex Binder</strong>! Collect companion cards to unlock them across our free arcade games.
          </p>

          <!-- Attributes Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2">
            <div class="bg-white/5 border border-white/10 rounded-xl p-3">
              <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400 block">Rarity Tier</span>
              <span class="text-sm font-bold text-teal-300 capitalize">{rarityLabel}</span>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-3">
              <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400 block">Signature Move</span>
              <span class="text-sm font-bold text-amber-300 truncate block">{signatureMove.name}</span>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-3 col-span-2 sm:col-span-1">
              <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400 block">Companion Stats</span>
              <span class="text-xs font-semibold text-slate-200">⚡{stats.energy} · 💖{stats.cuddle} · ⭐{stats.loyalty}</span>
            </div>
          </div>

          <!-- Collect Action -->
          <div class="pt-4 flex flex-wrap items-center gap-3">
            <button
              type="button"
              id="btn-collect-pet-dex"
              data-pet-id={pet.id}
              data-pet-name={pet.name}
              class="px-6 py-3.5 rounded-full font-bold text-xs uppercase tracking-wider bg-gradient-to-r from-teal-500 to-emerald-500 hover:from-teal-400 hover:to-emerald-400 text-slate-950 transition-all shadow-lg hover:shadow-teal-500/25 flex items-center gap-2 cursor-pointer active:scale-95"
            >
              <span>🐾</span>
              <span id="collect-btn-text">Collect in My Adoptédex (+50 🪙)</span>
            </button>

            <a
              href="/games/dex/album.html"
              class="px-5 py-3 rounded-full font-bold text-xs uppercase tracking-wider bg-white/10 hover:bg-white/15 text-white border border-white/20 transition-all flex items-center gap-1.5"
            >
              <span>📖 Open Binder &rarr;</span>
            </a>
          </div>

          <div id="collect-toast" class="hidden text-xs text-emerald-400 font-semibold flex items-center gap-1.5">
            <span>✓</span>
            <span id="collect-toast-msg">{pet.name} has been added to your Adoptédex Album!</span>
          </div>
        </div>

        <!-- Right: 3D Holographic Card Preview -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="w-full max-w-[280px] sm:max-w-[300px] aspect-[5/7] relative rounded-2xl overflow-hidden border-2 border-teal-500/50 shadow-2xl bg-gradient-to-b from-stone-900 to-stone-950 p-3.5 flex flex-col justify-between group cursor-pointer hover:border-amber-400/70 transition-all duration-300" data-rarity={rarityKey}>
            <!-- Card Header -->
            <div class="flex items-center justify-between border-b border-white/10 pb-2">
              <div class="flex items-center gap-1.5">
                <span class="text-xs">🐾</span>
                <span class="font-bold text-sm text-white tracking-wide">{pet.name}</span>
              </div>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-teal-900/60 border border-teal-500/40 text-teal-200">
                #{pet.id.slice(-4)}
              </span>
            </div>

            <!-- Card Art / Photo -->
            <div class="relative w-full aspect-square rounded-xl overflow-hidden my-2 border border-white/10 bg-black/40">
              <img src={photo} alt={pet.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              <div class="absolute bottom-2 left-2 px-2 py-0.5 rounded bg-black/70 backdrop-blur-md text-[10px] font-bold text-amber-300 border border-amber-400/40 capitalize">
                {rarityLabel}
              </div>
            </div>

            <!-- Card Move & Stats Footer -->
            <div class="space-y-1.5 pt-1 border-t border-white/10">
              <div class="flex items-center justify-between text-[11px]">
                <span class="text-teal-300 font-bold">{signatureMove.name}</span>
                <span class="text-slate-400 text-[10px]">{speciesTag}</span>
              </div>
              <p class="text-[10px] text-slate-300 leading-tight line-clamp-2">{signatureMove.effect}</p>
              <div class="flex justify-between text-[10px] font-bold text-slate-300 pt-1">
                <span>⚡ Energy: {stats.energy}</span>
                <span>💖 Cuddle: {stats.cuddle}</span>
                <span>⭐ Loyalty: {stats.loyalty}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    {related.length > 0 && (
      <section class="mt-16 border-t border-gray-200 pt-16">
        <h2 class="text-3xl font-serif text-teal-900 mb-10 text-center">More {speciesTag.toLowerCase()}s waiting for homes</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          {related.map((p) => <PetCard pet={p} />)}
        </div>
      </section>
    )}
  </div>

  <!-- Mobile Sticky Action Dock -->
  <aside class="sm:hidden fixed bottom-0 inset-x-0 z-30 bg-white/95 backdrop-blur-md border-t border-gray-200/80 px-4 py-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] shadow-[0_-4px_20px_rgba(0,0,0,0.08)]" aria-label="Mobile quick actions">
    <div class="flex items-center justify-between gap-3">
      <div class="flex items-center gap-2.5 min-w-0">
        <img src={photo} alt={pet.name} class="w-10 h-10 rounded-full object-cover border border-gray-200 flex-shrink-0" />
        <div class="min-w-0">
          <p class="font-bold text-teal-900 text-sm truncate leading-tight">{pet.name}</p>
          <p class="text-xs text-gray-500 truncate">{pet.age_display || speciesTag}</p>
        </div>
      </div>
      <div class="flex items-center gap-2 flex-shrink-0">
        <a
          href="tel:734-243-3669"
          class="inline-flex items-center justify-center w-11 h-11 rounded-full border border-teal-700 text-teal-700 hover:bg-teal-50 transition-colors"
          aria-label="Call Monroe Humane"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </a>
        <a
          href="/adoptions#Application"
          class="inline-flex items-center justify-center font-bold text-xs uppercase tracking-wider px-4 py-2.5 rounded-full bg-teal-700 text-white shadow-sm hover:bg-teal-800 transition-colors min-h-[44px]"
        >
          Apply to Adopt &rarr;
        </a>
      </div>
    </div>
  </aside>
</BaseLayout>

<script>
  // "Back to all pets" should return to wherever the visitor actually came
  // from (/adopt, /adopt/dogs, /adopt/cats, including any active filters)
  // rather than always resetting to the unfiltered /adopt. document.referrer
  // doesn't work for this: Astro's <ClientRouter /> does client-side soft
  // navigation, which never updates document.referrer the way a real page
  // load would. AdoptGrid.astro records the last listing URL in
  // sessionStorage on every visit — read it back here instead.
  function initSmartBack() {
    const link = document.querySelector<HTMLAnchorElement>('[data-smart-back]');
    if (!link) return;
    let last: string | null = null;
    try {
      last = sessionStorage.getItem('mchs:lastAdoptListing');
    } catch {
      // sessionStorage unavailable — fall back to the plain /adopt href already on the link
    }
    if (last) link.setAttribute('href', last);
  }
  document.addEventListener('astro:page-load', initSmartBack);
</script>

<script>
  import { favoritePetIds, toggleFavorite } from '../../stores/favorites';

  let unsubscribeFavorites: (() => void) | null = null;

  function initDetailFavorite() {
    unsubscribeFavorites?.();

    const btn = document.querySelector<HTMLButtonElement>('[data-pet-detail-favorite-btn]');
    if (!btn) return;
    const label = btn.querySelector<HTMLElement>('[data-pet-detail-favorite-label]');
    const petId = btn.dataset.petId || '';

    const syncUI = () => {
      const active = !!petId && favoritePetIds.get().includes(petId);
      btn.classList.toggle('is-favorited', active);
      btn.setAttribute('aria-pressed', String(active));
      if (label) label.textContent = active ? 'Saved to Favorites' : 'Save to Favorites';
    };

    syncUI();
    unsubscribeFavorites = favoritePetIds.subscribe(syncUI);

    // astro:page-load can fire more than once for a single client-side
    // transition, which would otherwise attach duplicate click listeners to
    // this persisted button and make toggleFavorite() cancel itself out.
    if (btn.dataset.favoritesWired) return;
    btn.dataset.favoritesWired = 'true';

    btn.addEventListener('click', () => {
      if (!petId) return;
      toggleFavorite(petId);
    });
  }

  document.addEventListener('astro:page-load', initDetailFavorite);
</script>

<script>
  function setupDexCollection() {
    const btn = document.getElementById('btn-collect-pet-dex');
    const toast = document.getElementById('collect-toast');
    const btnText = document.getElementById('collect-btn-text');
    if (!btn || !btnText) return;

    const petId = btn.getAttribute('data-pet-id') || '';

    // Check if already collected
    try {
      const discovered = JSON.parse(localStorage.getItem('monroe_discovered_pets') || '[]');
      if (discovered.includes(String(petId))) {
        btnText.textContent = '✓ In Your Adoptédex Binder';
        btn.classList.remove('from-teal-500', 'to-emerald-500', 'hover:from-teal-400', 'hover:to-emerald-400');
        btn.classList.add('bg-teal-900/80', 'text-teal-200', 'border', 'border-teal-500/50', 'pointer-events-none');
      }
    } catch (_) {}

    if (btn.dataset.dexWired) return;
    btn.dataset.dexWired = 'true';

    btn.addEventListener('click', () => {
      try {
        const discovered = JSON.parse(localStorage.getItem('monroe_discovered_pets') || '[]');
        if (!discovered.includes(String(petId))) {
          discovered.push(String(petId));
          localStorage.setItem('monroe_discovered_pets', JSON.stringify(discovered));

          // Award +50 coins to local wallet
          const curCoins = parseInt(localStorage.getItem('monroeDexCoins') || '0', 10);
          localStorage.setItem('monroeDexCoins', String((isNaN(curCoins) ? 0 : curCoins) + 50));

          btnText.textContent = '✓ Added to Binder (+50 🪙)';
          btn.classList.remove('from-teal-500', 'to-emerald-500', 'hover:from-teal-400', 'hover:to-emerald-400');
          btn.classList.add('bg-teal-900/80', 'text-teal-200', 'border', 'border-teal-500/50', 'pointer-events-none');

          if (toast) {
            toast.classList.remove('hidden');
          }
        }
      } catch (e) {
        console.error('Failed to collect companion:', e);
      }
    });
  }

  setupDexCollection();
  document.addEventListener('astro:page-load', setupDexCollection);
</script>
