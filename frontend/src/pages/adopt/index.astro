---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdoptGrid from '../../components/AdoptGrid.astro';
import { getPets } from '../../lib/directus';

const pets = await getPets();
---

<BaseLayout
  title="Available Pets | Monroe County | 734-243-3669"
  description="Meet dogs and cats waiting for homes in Monroe County. Filter by type, size, gender, and age, or jump straight to dogs, cats, or the adoption application."
>
  <div class="max-w-7xl mx-auto px-4 py-6 sm:py-8">
    <header class="text-center mb-5 sm:mb-6">
      <p class="uppercase tracking-widest font-bold text-sm text-teal-700 mb-2">Adoption Hub</p>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-serif text-teal-900 mb-3">Available Pets</h1>
      <p class="text-base text-gray-700 max-w-2xl mx-auto leading-relaxed">
        Meet dogs and cats waiting for homes in Monroe County. Filter in real-time below, or click any pet to see their full profile.
      </p>
    </header>

    <nav class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-3 mb-6 sm:mb-8" aria-label="Browse adoptable animals">
      <a class="inline-flex items-center justify-center font-bold tracking-wide px-5 py-2.5 rounded-full bg-teal-700 text-white shadow-sm transition-all hover:bg-teal-900" href="/adopt">All Pets</a>
      <a class="inline-flex items-center justify-center font-bold tracking-wide px-5 py-2.5 rounded-full bg-white text-teal-700 border-2 border-teal-700 transition-all hover:bg-teal-50" href="/adopt/dogs">Dogs</a>
      <a class="inline-flex items-center justify-center font-bold tracking-wide px-5 py-2.5 rounded-full bg-white text-teal-700 border-2 border-teal-700 transition-all hover:bg-teal-50" href="/adopt/cats">Cats</a>
      <a class="inline-flex items-center justify-center font-bold tracking-wide px-5 py-2.5 rounded-full bg-gray-100 text-gray-700 border-2 border-transparent transition-all hover:bg-gray-200 ml-0 sm:ml-2" href="/adoptions">Adoption Info &amp; Application</a>
    </nav>

    <AdoptGrid pets={pets} />

    <p class="mt-8 sm:mt-10 text-center text-gray-600 border-t border-gray-200 pt-6 font-medium">
      Ready to adopt? <a href="/adoptions" class="text-teal-700 hover:text-teal-900 underline underline-offset-2">Learn about our adoption process</a> or <a href="tel:734-243-3669" class="text-teal-700 hover:text-teal-900 underline underline-offset-2">call us at (734) 243-3669</a>.
    </p>
  </div>
</BaseLayout>
