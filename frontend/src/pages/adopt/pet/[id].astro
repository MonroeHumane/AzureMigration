---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import InnerShell from '../../../components/InnerShell.astro';
import { getPets, type Pet } from '../../../lib/directus';
import { SITE } from '../../../config/site';

export async function getStaticPaths() {
  const pets = await getPets();
  return pets.map((pet) => ({
    params: { id: pet.id },
    props: { pet },
  }));
}

interface Props {
  pet: Pet;
}

const { pet } = Astro.props;
const petImage = pet.image_url || pet.image || '/assets/recovered/images/placeholder.svg';
const shareUrl = new URL(Astro.url.pathname, SITE.url).href;
const fbShareUrl = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(shareUrl);
const pageTitle = 'Adopt ' + pet.name + ' | ' + (pet.breed || pet.type) + ' | 734-243-3669';
const pageDesc = 'Meet ' + pet.name + ', an adoptable ' + (pet.breed || pet.type) + ' waiting for a loving home at the Humane Society of Monroe County.';
const speciesPath = '/adopt/' + (pet.type === 'dog' ? 'dogs' : pet.type === 'cat' ? 'cats' : 'other');
const speciesLabel = pet.species_label || (pet.type === 'dog' ? 'Adoptable Dog' : pet.type === 'cat' ? 'Adoptable Cat' : 'Adoptable Pet');
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  image={petImage}
>
  <InnerShell variant="adopt">
    <div class="monroe-pet-detail">
      <nav class="monroe-pet-detail__breadcrumbs" aria-label="Breadcrumb">
        <a href="/adopt" class="monroe-btn monroe-btn--outline">← All adoptable pets</a>
        <a href={speciesPath} class="monroe-btn monroe-btn--outline">
          More {pet.type === 'dog' ? 'dogs' : pet.type === 'cat' ? 'cats' : 'pets'}
        </a>
      </nav>

      <article class="monroe-pet-detail__card">
        <div class="monroe-pet-detail__media">
          <img
            src={petImage}
            alt={'Photo of ' + pet.name}
            class="monroe-pet-detail__img"
            loading="eager"
            decoding="async"
          />
        </div>

        <div class="monroe-pet-detail__info">
          <p class="monroe-native-eyebrow">{speciesLabel}</p>
          <h1 class="monroe-pet-detail__title">{pet.name}</h1>

          <div class="monroe-pet-detail__tags">
            <span class="monroe-pet-pill"><strong>Breed:</strong> {pet.breed || 'Mixed'}</span>
            <span class="monroe-pet-pill"><strong>Age:</strong> {pet.age_display || pet.age || 'Unknown'}</span>
            <span class="monroe-pet-pill"><strong>Gender:</strong> {pet.gender || 'Unknown'}</span>
            {pet.size && <span class="monroe-pet-pill"><strong>Size:</strong> {pet.size}</span>}
            {pet.location && <span class="monroe-pet-pill"><strong>Location:</strong> {pet.location}</span>}
          </div>

          <div class="monroe-pet-detail__bio">
            <h2>About {pet.name}</h2>
            <p>{pet.description || ('Come meet ' + pet.name + ' at our Monroe shelter! Friendly and ready for a forever home.')}</p>
          </div>

          <div class="monroe-native-actions" style="margin-top: 1.5rem;">
            <a class="monroe-btn" href="/adoptions/#Application">Apply to adopt {pet.name}</a>
            <a class="monroe-btn monroe-btn--outline" href={SITE.contact.phoneTel}>Call {SITE.contact.phoneFormatted}</a>
            <a class="monroe-btn monroe-btn--outline" href={fbShareUrl} target="_blank" rel="noopener noreferrer">Share on Facebook</a>
          </div>
        </div>
      </article>

      <section class="monroe-native-stack" style="margin-top: 2rem;" aria-labelledby="monroe-pet-steps-heading">
        <h2 id="monroe-pet-steps-heading">How to adopt from Monroe Humane</h2>
        <ol class="monroe-native-list">
          <li><strong>Step 1: Submit an interest application</strong> online using our quick application form.</li>
          <li><strong>Step 2: Shelter Meet &amp; Greet</strong> at 911 S. Raisinville Rd during public hours (Tue–Fri 11am–4pm, Sat 11am–3pm).</li>
          <li><strong>Step 3: Take your new family member home</strong> with complete medical records, vaccinations, and microchip.</li>
        </ol>
      </section>
    </div>
  </InnerShell>
</BaseLayout>

<style>
  .monroe-pet-detail {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .monroe-pet-detail__breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .monroe-pet-detail__card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    background: #ffffff;
    border-radius: 20px;
    padding: 1.75rem;
    border: 1px solid rgba(23, 54, 53, 0.12);
    box-shadow: 0 16px 36px rgba(23, 54, 53, 0.07);
  }
  @media (max-width: 860px) {
    .monroe-pet-detail__card {
      grid-template-columns: 1fr;
    }
  }
  .monroe-pet-detail__media {
    border-radius: 16px;
    overflow: hidden;
    background: #f4efe6;
    max-height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .monroe-pet-detail__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .monroe-pet-detail__info {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .monroe-pet-detail__title {
    margin: 0.25rem 0 1rem;
    font-family: 'Jost', 'Montserrat', sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    color: #173635;
  }
  .monroe-pet-detail__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .monroe-pet-pill {
    background: rgba(15, 118, 110, 0.1);
    color: #0f766e;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 500;
  }
  .monroe-pet-detail__bio h2 {
    font-size: 1.25rem;
    margin: 0 0 0.5rem;
    color: #173635;
  }
  .monroe-pet-detail__bio p {
    line-height: 1.6;
    color: #334e4d;
    margin: 0;
  }
</style>