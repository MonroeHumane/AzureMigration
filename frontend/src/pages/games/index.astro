---
import BaseLayout from '../../layouts/BaseLayout.astro';

const GAMES = [
  {
    id: 'dex',
    title: 'Pet Booster Packs',
    desc: 'Rip open shiny foil packs to collect adorable cards of real shelter pets! Find rare holographic cards and build your ultimate pet album.',
    action: 'Open Booster Packs',
    icon: '✨',
    url: '/games/dex/dex.html?embed=1',
    needsDex: true,
    bgClass: 'bg-gradient-to-br from-amber-400 via-orange-400 to-rose-500',
    hoverClass: 'group-hover:shadow-[0_0_40px_rgba(245,158,11,0.6)] group-hover:-translate-y-2',
    iconClass: 'text-yellow-100 drop-shadow-[0_0_15px_rgba(255,255,255,0.8)]',
  },
  {
    id: 'match',
    title: 'Pet Match Memory',
    desc: 'Flip cards to find pairs of adoptable dogs and cats! Match companions and beat levels to earn free Pet Booster Packs.',
    action: 'Play Pet Match',
    icon: '🧩',
    url: '/games/match/match.html?embed=1',
    needsDex: true,
    bgClass: 'bg-gradient-to-br from-teal-400 via-emerald-500 to-cyan-600',
    hoverClass: 'group-hover:shadow-[0_0_40px_rgba(16,185,129,0.5)] group-hover:-translate-y-2',
    iconClass: 'text-emerald-50 drop-shadow-[0_0_15px_rgba(255,255,255,0.5)]',
  },
  {
    id: 'catwalk',
    title: 'Flappy Cat',
    desc: 'Tap to fly! Guide a wireframe cat home through a night patrol of dogs and drifting fishbones.',
    action: 'Play Flappy Cat',
    icon: '🐱',
    url: '/games/catwalk?embed=1',
    needsDex: false,
    bgClass: 'bg-gradient-to-b from-sky-400 via-blue-500 to-indigo-600',
    hoverClass: 'group-hover:shadow-[0_0_40px_rgba(56,189,248,0.5)] group-hover:-translate-y-2',
    iconClass: 'text-sky-100 drop-shadow-[0_0_15px_rgba(255,255,255,0.5)]',
  }
];
---

<BaseLayout
  title="Humane Games | Monroe County Humane Society"
  description="Play free browser games featuring real adoptable pets. Rip open booster packs, play memory match, and tap to fly with Flappy Cat."
  bodyClass="bg-slate-50"
>
  <main class="min-h-screen pb-24" data-monroe-humane-games-root>
    
    <!-- Hero Section -->
    <section class="relative bg-gradient-to-br from-indigo-900 via-purple-900 to-slate-900 text-white overflow-hidden pt-24 pb-32">
      <!-- Decorative background elements -->
      <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/stardust.png')] opacity-20"></div>
      <div class="absolute top-0 right-0 w-96 h-96 bg-fuchsia-500/20 rounded-full blur-[120px] mix-blend-screen pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-indigo-500/20 rounded-full blur-[150px] mix-blend-screen pointer-events-none"></div>

      <div class="max-w-5xl mx-auto px-6 relative z-10 text-center">
        <span class="inline-block py-1 px-3 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-indigo-200 text-sm font-semibold tracking-wide uppercase mb-6">
          Humane Arcade
        </span>
        <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-6 text-transparent bg-clip-text bg-gradient-to-r from-white via-indigo-100 to-purple-200 drop-shadow-sm">
          Small games for big hearts.
        </h1>
        <p class="text-xl md:text-2xl text-indigo-200 max-w-2xl mx-auto font-medium leading-relaxed mb-12">
          Play free mini-games featuring real adoptable pets. Earn booster packs, build your album, and maybe find your next best friend.
        </p>

        <!-- Arcade Pass (Nickname Form) -->
        <div class="max-w-lg mx-auto bg-white/10 backdrop-blur-xl border border-white/20 p-8 rounded-3xl shadow-2xl relative overflow-hidden group">
          <div class="absolute inset-0 bg-gradient-to-r from-white/0 via-white/5 to-white/0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-1000"></div>
          
          <h2 class="text-2xl font-bold text-white mb-2 flex items-center justify-center gap-3">
            <span class="text-3xl">🎫</span> Your Arcade Pass
          </h2>
          <p class="text-indigo-200 mb-6 text-sm">Create a nickname to save your booster packs and game progress across sessions.</p>
          
          <div class="flex flex-col sm:flex-row gap-3">
            <input 
              type="text" 
              id="monroeDexUsername" 
              maxlength="20" 
              placeholder="e.g. PetLover99"
              class="flex-1 bg-white/5 border border-white/20 rounded-xl px-5 py-3 text-white placeholder-indigo-300/50 focus:outline-none focus:ring-2 focus:ring-fuchsia-500 focus:border-transparent transition-all"
            />
            <button 
              type="button" 
              data-monroe-dex-view-album
              class="bg-gradient-to-r from-fuchsia-500 to-purple-600 hover:from-fuchsia-400 hover:to-purple-500 text-white font-bold py-3 px-6 rounded-xl shadow-lg transition-transform active:scale-95 whitespace-nowrap"
            >
              View Album
            </button>
          </div>
          <p class="text-sm text-emerald-400 mt-4 h-5 opacity-0 transition-opacity" data-monroe-dex-toast aria-live="polite"></p>
        </div>
      </div>
    </section>

    <!-- Game Cards Grid -->
    <section class="max-w-6xl mx-auto px-6 -mt-16 relative z-20">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {GAMES.map(game => (
          <button 
            type="button" 
            class="group text-left w-full focus:outline-none"
            data-monroe-humane-game={game.id}
            data-needs-dex={game.needsDex ? '1' : '0'}
            aria-label={`Play ${game.title}`}
          >
            <div class={`relative h-full rounded-3xl p-8 flex flex-col items-start transition-all duration-300 ease-out border border-white/20 shadow-xl ${game.bgClass} ${game.hoverClass} overflow-hidden`}>
              
              <!-- Shine overlay -->
              <div class="absolute inset-0 bg-gradient-to-br from-white/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none mix-blend-overlay"></div>
              
              <div class={`text-6xl mb-6 transform group-hover:scale-110 group-hover:rotate-6 transition-transform duration-300 ${game.iconClass}`}>
                {game.icon}
              </div>
              
              <h3 class="text-3xl font-extrabold text-white mb-4 tracking-tight drop-shadow-md">
                {game.title}
              </h3>
              
              <p class="text-white/90 text-lg font-medium leading-relaxed mb-8 flex-1 drop-shadow-sm">
                {game.desc}
              </p>
              
              <div class="mt-auto w-full flex items-center justify-between bg-white/20 backdrop-blur-md border border-white/30 rounded-2xl py-3 px-5 text-white font-bold group-hover:bg-white/30 transition-colors">
                <span>{game.action}</span>
                <span class="text-2xl transform group-hover:translate-x-2 transition-transform">➔</span>
              </div>
              
            </div>
          </button>
        ))}
      </div>
    </section>

    <!-- CTA Section -->
    <section class="max-w-4xl mx-auto px-6 mt-32 text-center">
      <h2 class="text-3xl font-bold text-slate-800 mb-6">Real Pets. Real Impact.</h2>
      <p class="text-xl text-slate-600 mb-10">When you're done playing, explore our live shelter database to see the real animals behind the cards, or check out our upcoming events.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/adopt" class="bg-teal-700 hover:bg-teal-600 text-white font-bold py-4 px-8 rounded-full shadow-lg transition-transform hover:-translate-y-1">Meet the Pets</a>
        <a href="/volunteer-form" class="bg-white hover:bg-slate-50 text-teal-700 font-bold py-4 px-8 rounded-full shadow-lg border border-slate-200 transition-transform hover:-translate-y-1">Volunteer</a>
      </div>
    </section>

  </main>

  <!-- Fullscreen Game Modal Player -->
  <div class="fixed inset-0 z-[9999] bg-slate-900 flex flex-col transition-opacity duration-300 opacity-0 pointer-events-none" data-monroe-humane-games-player aria-modal="true" role="dialog" aria-labelledby="monroe-humane-games-player-title">
    <div class="flex items-center justify-between px-6 py-4 bg-slate-950 border-b border-slate-800 shadow-xl relative z-10">
      <div class="flex items-center gap-3">
        <span class="text-2xl" data-monroe-humane-games-player-icon>🎮</span>
        <h2 class="text-xl font-bold text-white tracking-wide" id="monroe-humane-games-player-title">Humane Games</h2>
      </div>
      <button class="bg-slate-800 hover:bg-slate-700 text-white font-semibold py-2 px-5 rounded-full border border-slate-700 hover:border-slate-500 transition-all text-sm flex items-center gap-2" type="button" data-monroe-humane-games-player-close aria-label="Close game">
        <span>Close Game</span> <span class="text-lg leading-none">&times;</span>
      </button>
    </div>
    <div class="flex-1 w-full h-full relative bg-black">
      <iframe
        class="w-full h-full border-0 block"
        data-monroe-humane-games-frame
        title="Humane Games Player"
        loading="lazy"
        allow="autoplay; fullscreen; gamepad"
      ></iframe>
    </div>
  </div>

</BaseLayout>

<script>
  function initGames() {
    const root = document.querySelector<HTMLElement>('[data-monroe-humane-games-root]');
    if (!root) return;

    const player = document.querySelector<HTMLElement>('[data-monroe-humane-games-player]');
    const frame = player?.querySelector<HTMLIFrameElement>('[data-monroe-humane-games-frame]');
    const titleEl = player?.querySelector<HTMLElement>('[data-monroe-humane-games-player-title]');
    const iconEl = player?.querySelector<HTMLElement>('[data-monroe-humane-games-player-icon]');
    const input = document.getElementById('monroeDexUsername') as HTMLInputElement | null;
    const toastEl = root.querySelector<HTMLElement>('[data-monroe-dex-toast]');

    const savedName = () => localStorage.getItem('monroeDexUser') || '';
    if (input && savedName()) {
      input.value = savedName();
    }

    const showToast = (msg: string, isError = false) => {
      if (!toastEl) return;
      toastEl.textContent = msg;
      toastEl.classList.remove('opacity-0', 'text-emerald-400', 'text-rose-400');
      toastEl.classList.add('opacity-100', isError ? 'text-rose-400' : 'text-emerald-400');
      setTimeout(() => {
        toastEl.classList.remove('opacity-100');
        toastEl.classList.add('opacity-0');
      }, 3000);
    };

    const saveNick = () => {
      const name = (input?.value ?? '').trim().slice(0, 20);
      if (name) {
        localStorage.setItem('monroeDexUser', name);
      }
      return name;
    };

    input?.addEventListener('change', saveNick);
    input?.addEventListener('blur', saveNick);

    // View album button
    root.querySelector<HTMLButtonElement>('[data-monroe-dex-view-album]')?.addEventListener('click', (e) => {
      e.preventDefault();
      const nick = saveNick() || savedName();
      if (!nick) {
        input?.focus();
        showToast('Please create a nickname first!', true);
        return;
      }
      launchGame('/games/dex/dex.html?embed=1', 'Pet Booster Packs', '✨');
    });

    // Launch game cards
    const launchGame = (url: string, name: string, icon: string) => {
      if (!player || !frame) return;
      frame.src = url;
      if (titleEl) titleEl.textContent = name;
      if (iconEl) iconEl.textContent = icon;
      
      player.classList.remove('opacity-0', 'pointer-events-none');
      document.body.style.overflow = 'hidden';
    };

    // Add click listeners to game cards
    const GAME_DATA = {
      dex: { url: '/games/dex/dex.html?embed=1', title: 'Pet Booster Packs', icon: '✨' },
      match: { url: '/games/match/match.html?embed=1', title: 'Pet Match Memory', icon: '🧩' },
      catwalk: { url: '/games/catwalk?embed=1', title: 'Flappy Cat', icon: '🐱' }
    };

    root.querySelectorAll<HTMLButtonElement>('[data-monroe-humane-game]').forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.dataset.monroeHumaneGame as keyof typeof GAME_DATA;
        const game = GAME_DATA[id];
        if (!game) return;

        if (card.dataset.needsDex === '1' && !savedName()) {
          input?.focus();
          input?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          
          // Add a gentle shake animation to the input to draw attention
          input?.classList.add('animate-pulse', 'ring-2', 'ring-rose-500');
          setTimeout(() => input?.classList.remove('animate-pulse', 'ring-2', 'ring-rose-500'), 1000);
          
          showToast('Create a nickname to save your progress!', true);
          return;
        }
        
        saveNick();
        launchGame(game.url, game.title, game.icon);
      });
    });

    // Close game modal
    const closePlayer = () => {
      if (!player) return;
      player.classList.add('opacity-0', 'pointer-events-none');
      if (frame) frame.src = 'about:blank'; // Stop audio/video
      document.body.style.overflow = '';
    };

    player?.querySelector('[data-monroe-humane-games-player-close]')?.addEventListener('click', closePlayer);

    // Escape key handling
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (player && !player.classList.contains('opacity-0')) {
          closePlayer();
        }
      }
    });
  }

  document.addEventListener('astro:page-load', initGames);
  if (!document.startViewTransition) initGames();
</script>
