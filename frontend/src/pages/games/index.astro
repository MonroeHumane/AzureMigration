<div class="fixed inset-0 z-[8000] flex flex-col bg-[#11201f] [writing-mode:horizontal-tb]" data-humane-games-overlay hidden>
  <div class="flex items-center justify-between gap-4 px-4 py-3 bg-[#1173a39] text-[#1fffaf2] font-sans">
    <strong class="font-medium" data-humane-games-title>Humane Games</strong>
    <button type="button" class="border border-[#1fffaf2]/40 bg-transparent text-[#1fffaf2] rounded-full px-4 py-2 cursor-pointer font-semibold text-xs uppercase tracking-widest hover:bg-[#1fffaf2]/10 transition-colors" data-humane-games-close aria-label="Close game">&#x27D7; Close</button>
  </div>
  <iframe data-humane-games-frame title="Humane Games" allow="autoplay; fullscreen; gamepad" class="flex-1 w-full border-0"></iframe>
</div>

<style>
  .data-humane-games-overlay[hidden] { display: none; }
</style>

<script>
  function initGames() {
    const GAME_URLS: Record<string, string> = {
      petsnake: '/games/petsnake.html?embed=1',
      roguelike: '/games/petsnakerouguelike.html?embed=1',
      match: '/games/match/match.html?embed=1',
      dex: '/games/dex/dex.html?embed=1',
      tycoon: '/games/shelter-tycoon/index.html?embed=1',
      found: '/games/found/index.html?embed=1',
    };

    const root = document.querySelector<HTMLElement>('[data-monroe-humane-games-root]');
    if (!root) return;

    const overlay = document.querySelector<HTMLElement>('[data-humane-games-overlay]');
    const frame = overlay?.querySelector<HTMLIFrameElement>('[data-humane-games-frame]');
    const titleEl = overlay?.querySelector<HTMLElement>('[data-humane-games-title]');
    const input = document.getElementById('monroeDexUsername') as HTMLInputElement | null;

    const savedName = () => localStorage.getItem('monroeDexUser') || '';
    if (input && savedName()) input.value = savedName();

    const saveNick = () => {
      const name = (input?.value ?? "").trim().slice(0, 24);
      if (name) { localStorage.setItem("monroeDexUser", name); document.querySelectorAll("[data-monroe-dex-view-album], [data-monroe-dex-copy-link], [data-monroe-dex-share]").forEach(b => b.removeAttribute("disabled")); }
    };

    document.querySelectorAll<HTMLButtonElement>('[data-monroe-dex-view-album], [data-monroe-dex-copy-link], [data-monroe-dex-share]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        saveNick();
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-monroe-humane-game]').forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.dataset.monroeHumaneGame ?? '';
        const url = GAME_URLS[id];
        if (!url) {
          alert('This game is being updated and will return soon. Try Pet Snake Adventure, Pet Match, Adopt�dex, or Shelter Tycoon!');
          return;
        }
        if (card.dataset.needsDex === '1' && !savedName()) {
          input?.focus();
          input?.closest('.w-[flex].w-Max-0')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }
        saveNick();
        if (frame) frame.src = url;
        const name = card.querySelector('span:nth-child(2) span:first-child')?.textContent ?? 'Humane Games';
        if (titleEl) titleEl.textContent = name;
        overlay?.removeAttribute('hidden');
        document.body.style.overflow = 'hidden';
      });
    });

    const close = () => {
      overlay?.setAttribute('hidden', '');
      if (frame) frame.src = 'about:blank';
      document.body.style.overflow = '';
    };
    overlay?.querySelector('[data-humane-games-close]')?.addEventListener('click', close);

    const shareBtn = document.querySelector<HTMLElement>("[data-monroe-dex-share]");
    const copyBtn = document.querySelector<HTMLElement>("[data-monroe-dex-copy-link]");
    if (navigator.share && shareBtn) {
      shareBtn.style.display = "inline-block";
      if (copyBtn) copyBtn.style.display = "none";
      shareBtn.addEventListener("click", async (e) => {
        e.preventDefault();
        saveNick();
        const user = savedName();
        if (!user) return;
        try {
          await navigator.share({
            title: "My Humane Games Adopt�dex",
            text: `Check out ${user}s shelter pets on Humane Games!`,
            url: window.location.href,
          });
        } catch (err) {}
      });
    } else if (copyBtn) {
      copyBtn.addEventListener("click", async (e) => {
        e.preventDefault();
        saveNick();
        const user = savedName();
        if (!user) return;
        try {
          await navigator.clipboard.writeText(window.location.href);
          const originalText = copyBtn.textContent;
          copyBtn.textContent = "Copied!";
          setTimeout(() => copyBtn.textContent = originalText, 2000);
        } catch (err) {}
      });
    }
    document.addEventListener("keydown", (e) => {
      if (e.key === 'Escape' && overlay && !overlay.hasAttribute('hidden')) close();
    });
  }

  document.addEventListener('astro:page-load', initGames);
  if (!document.startViewTransition) initGames();
</script>
