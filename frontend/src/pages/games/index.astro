            aria-label="Play Found"
          >
            <span class="w-16 h-16 bg-teal-50 rounded-2xl flex items-center justify-center text-3xl mb-6" aria-hidden="true">
              <span>??</span>
            </span>
            <span class="flex-col flex mb-4">
              <span class="text-2xl font-bold text-teal-900 mb-2 group-hover:text-emerald-700 transition-colors">Found</span>
              <span class="text-gray-600 leading-relaxed">A stray cat is trying to find its way home - jump and explore a cozy neighborhood.</span>
            </span>
            <span class="mt-auto mb-4">
              <span class="inline-block px-3 py-1 bg-gray-100 text-gray-600 text-xs font-bold uppercase tracking-wider rounded-full">Play anytime</span>
            </span>
            <span class="text-emerald-600 font-bold uppercase tracking-widest text-sm" aria-hidden="true">Play &gt;</span>
          </button>
        </li>

        <li>
          <button
            type="button"
            class="group w-full h-full flex flex-col bg-white border border-gray-200 rounded-3xl p-8 text-left shadow-sm hover:shadow-md transition-all hover:-translate-y-1"
            data-monroe-humane-game="match"
            data-needs-dex="1"
            aria-label="Play Pet Match"
          >
            <span class="w-16 h-16 bg-teal-50 rounded-2xl flex items-center justify-center text-3xl mb-6" aria-hidden="true">
              <span>??</span>
            </span>
            <span class="flex-col flex mb-4">
              <span class="text-2xl font-bold text-teal-900 mb-2 group-hover:text-emerald-700 transition-colors">Pet Match</span>
              <span class="text-gray-600 leading-relaxed">Match pet photos - levels get bigger as you go.</span>
            </span>
            <span class="mt-auto mb-4 flex flex-wrap gap-2">
              <span class="inline-block px-3 py-1 bg-amber-50 text-amber-700 border border-amber-200 text-xs font-bold uppercase tracking-wider rounded-full">Saves to Adopt�dex</span>
              <span class="inline-block px-3 py-1 bg-red-50 text-red-700 border border-red-200 text-xs font-bold uppercase tracking-wider rounded-full" data-monroe-dex-lock hidden>Nickname required</span>
            </span>
            <span class="text-emerald-600 font-bold uppercase tracking-widest text-sm" aria-hidden="true">Play &gt;</span>
          </button>
        </li>

        <li>
          <button
            type="button"
            class="group w-full h-full flex flex-col bg-white border border-gray-200 rounded-3xl p-8 text-left shadow-sm hover:shadow-md transition-all hover:-translate-y-1"
            data-monroe-humane-game="dex"
            data-needs-dex="1"
            aria-label="Play Adopt�dex"
          >
            <span class="w-16 h-16 bg-teal-50 rounded-2xl flex items-center justify-center text-3xl mb-6" aria-hidden="true">
              <span>??</span>
            </span>
            <span class="flex-col flex mb-4">
              <span class="text-2xl font-bold text-teal-900 mb-2 group-hover:text-emerald-700 transition-colors">Adopt�dex</span>
              <span class="text-gray-600 leading-relaxed">Meet adoptable pets and build your album.</span>
            </span>
            <span class="mt-auto mb-4 flex flex-wrap gap-2">
              <span class="inline-block px-3 py-1 bg-amber-50 text-amber-700 border border-amber-200 text-xs font-bold uppercase tracking-wider rounded-full">Saves to Adopt�dex</span>
              <span class="inline-block px-3 py-1 bg-red-50 text-red-700 border border-red-200 text-xs font-bold uppercase tracking-wider rounded-full" data-monroe-dex-lock hidden>Nickname required</span>
            </span>
            <span class="text-emerald-600 font-bold uppercase tracking-widest text-sm" aria-hidden="true">Play &gt;</span>
          </button>
        </li>

        <li>
          <button
            type="button"
            class="group w-full h-full flex flex-col bg-white border border-gray-200 rounded-3xl p-8 text-left shadow-sm hover:shadow-md transition-all hover:-translate-y-1"
            data-monroe-humane-game="tycoon"
            data-needs-dex="1"
            aria-label="Play Shelter Tycoon"
          >
            <span class="w-16 h-16 bg-teal-50 rounded-2xl flex items-center justify-center text-3xl mb-6" aria-hidden="true">
              <span>???</span>
            </span>
            <span class="flex-col flex mb-4">
              <span class="text-2xl font-bold text-teal-900 mb-2 group-hover:text-emerald-700 transition-colors">Shelter Tycoon</span>
              <span class="text-gray-600 leading-relaxed">Run a humane society - intake real pets, complete care plans, find forever homes.</span>
            </span>
            <span class="mt-auto mb-4 flex flex-wrap gap-2">
              <span class="inline-block px-3 py-1 bg-amber-50 text-amber-700 border border-amber-200 text-xs font-bold uppercase tracking-wider rounded-full">Saves progress + Adopt�dex</span>
              <span class="inline-block px-3 py-1 bg-red-50 text-red-700 border border-red-200 text-xs font-bold uppercase tracking-wider rounded-full" data-monroe-dex-lock hidden>Nickname required</span>
            </span>
            <span class="text-emerald-600 font-bold uppercase tracking-widest text-sm" aria-hidden="true">Play &gt;</span>
          </button>
        </li>
      </ul>
      <p class="text-center mt-8 text-gray-500 font-medium">
          Opens on top of this page. Press Escape to close.
      </p>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 bg-gray-50 rounded-3xl p-8 md:p-16 mb-24">
      <section aria-labelledby="monroe-games-how-heading">
        <h2 id="monroe-games-how-heading" class="text-3xl font-serif text-teal-900 mb-8">How to play</h2>
        <ul class="flex flex-col gap-6">
          <li class="flex gap-4">
            <span class="w-10 h-10 bg-teal-100 text-teal-900 rounded-full flex items-center justify-center font-bold flex-shrink-0" aria-hidden="true">1</span>
            <span class="text-gray-700 leading-relaxed pt-2">Choose your Adopt�dex nickname once - it works for every Humane Game.</span>
          </li>
          <li class="flex gap-4">
            <span class="w-10 h-10 bg-teal-100 text-teal-900 rounded-full flex items-center justify-center font-bold flex-shrink-0" aria-hidden="true">2</span>
            <span class="text-gray-700 leading-relaxed pt-2">The game opens in a full-screen layer on this page.</span>
          </li>
          <li class="flex gap-4">
            <span class="w-10 h-10 bg-teal-100 text-teal-900 rounded-full flex items-center justify-center font-bold flex-shrink-0" aria-hidden="true">3</span>
            <span class="text-gray-700 leading-relaxed pt-2">Close anytime with the Close game button or Escape to return here.</span>
          </li>
        </ul>
      </section>
    </div>

    <section class="bg-teal-900 text-white rounded-3xl p-10 sm:p-16 text-center shadow-xl" aria-labelledby="monroe-games-cta-heading">
      <h2 id="monroe-games-cta-heading" class="text-4xl font-serif mb-6">Help real pets in Monroe County</h2>
      <p class="text-teal-100 text-lg mb-10 max-w-2xl mx-auto leading-relaxed">When you are done playing, browse adoptable animals, volunteer, or see upcoming shelter events.</p>
      <div class="flex flex-wrap justify-center gap-4">
          <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-6 py-3 rounded-full transition-all bg-emerald-500 text-teal-900 hover:bg-emerald-400 hover:-translate-y-1" href="/adopt/">
              Adoptable pets
          </a>
          <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-6 py-3 rounded-full transition-all border-2 border-white text-white hover:bg-white hover:text-teal-900 hover:-translate-y-1" href="/volunteer-form">
              Volunteer
          </a>
          <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-6 py-3 rounded-full transition-all border-2 border-white text-white hover:bg-white hover:text-teal-900 hover:-translate-y-1" href="/events">
              Events
          </a>
