---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/humane-games-launcher.css';

const GAMES = [
  {
    id: 'petsnake',
    title: 'Pet Snake',
    shortTitle: 'Pet Snake',
    icon: '🐍',
    desc: 'Guide a cat or dog through a snack trail — grab treats, dodge bombs, and chase a high score.',
    badge: 'Play anytime',
    url: '/games/petsnake.html?embed=1',
    needsDex: false,
  },
  {
    id: 'roguelike',
    title: 'Pet Snake Adventure',
    shortTitle: 'Adventure',
    icon: '🗺️',
    desc: 'A 15-floor roguelike journey with upgrades, affixes, and a vacuum boss.',
    badge: 'Play anytime',
    url: '/games/petsnakerouguelike.html?embed=1',
    needsDex: false,
  },
  {
    id: 'found',
    title: 'Found',
    shortTitle: 'Found',
    icon: '🐱',
    desc: 'A stray cat is trying to find its way home — jump, explore, and navigate a cozy neighborhood.',
    badge: 'Play anytime',
    url: '/games/found/index.html?embed=1',
    needsDex: false,
  },
  {
    id: 'catwalk',
    title: 'Catwalk',
    shortTitle: 'Catwalk',
    icon: '/ᐠ｡ꞈ｡ᐟ\\',
    desc: 'Guide a wireframe cat home through a night patrol of dogs and drifting fishbones.',
    badge: 'Play anytime',
    url: '/games/catwalk?embed=1',
    needsDex: false,
  },
  {
    id: 'match',
    title: 'Pet Match',
    shortTitle: 'Match',
    icon: '🃏',
    desc: 'Match pet photos — levels get bigger as you go and photos save to your album.',
    badge: 'Saves to Adoptédex',
    url: '/games/match/match.html?embed=1',
    needsDex: true,
  },
  {
    id: 'dex',
    title: 'Adoptédex',
    shortTitle: 'Album',
    icon: '📖',
    desc: 'Meet adoptable pets and build your permanent shelter card collection.',
    badge: 'Saves to Adoptédex',
    url: '/games/dex/dex.html?embed=1',
    needsDex: true,
  },
  {
    id: 'tycoon',
    title: 'Shelter Tycoon',
    shortTitle: 'Tycoon',
    icon: '🏠',
    desc: 'Run a humane society — intake real pets, complete care plans, and find forever homes.',
    badge: 'Saves progress + Adoptédex',
    url: '/games/shelter-tycoon/index.html?embed=1',
    needsDex: true,
  },
];
---

<BaseLayout
  title="Humane Games | Monroe County Humane Society"
  description="Free browser games featuring real adoptable pets from Monroe Humane. Play Pet Snake, Match Memory, Shelter Tycoon, and build your Adoptédex album."
  bodyClass="wp-singular page-template-default page page-id-200 monroe-inner-page page-slug-games"
>
  <div class="monroe-inner-page-shell monroe-native-inner monroe-native-inner--games">
    <div class="monroe-inner-page-shell__content monroe-games-page" data-monroe-humane-games-root>

      <!-- Hero & Nickname Auth Header -->
      <header class="monroe-games-hero" aria-labelledby="monroe-games-title">
        <div class="monroe-games-hero__copy">
          <p class="monroe-native-eyebrow">Services</p>
          <h1 id="monroe-games-title">Humane Games</h1>
          <p class="monroe-native-lead">
            Free browser games featuring real adoptable pets &mdash; play for a few minutes, then meet the animals on our site.
          </p>
          <ul class="monroe-games-feature-pills" aria-label="Highlights">
            <li>Free in your browser</li>
            <li>Live shelter pets</li>
            <li>Your Adoptédex album</li>
          </ul>
          <p class="monroe-games-hero__about">
            <button class="monroe-games-hero__about-link" type="button" data-monroe-humane-games-about-open>
              About Humane Games
            </button>
          </p>
        </div>

        <div class="monroe-games-hero__panel monroe-humane-games">
          <span class="monroe-humane-games__panel-glyph" aria-hidden="true">🐾</span>
          <section class="monroe-humane-games__dex-gate" aria-labelledby="monroe-dex-gate-heading">
            <h2 class="monroe-humane-games__dex-gate-title" id="monroe-dex-gate-heading">Your Adoptédex name</h2>
            <p class="monroe-humane-games__dex-gate-hint">One nickname saves your Adoptédex album and game progress.</p>
            <div class="monroe-humane-games__dex-gate-fields">
              <div class="monroe-humane-games__dex-gate-row">
                <label class="monroe-humane-games__dex-label" for="monroeDexUsername">Nickname</label>
                <input
                  class="monroe-humane-games__dex-input"
                  type="text"
                  id="monroeDexUsername"
                  name="monroeDexUsername"
                  maxlength="20"
                  autocomplete="nickname"
                  placeholder="e.g. PetFriend42"
                  data-monroe-dex-username
                />
              </div>
              <label class="monroe-humane-games__dex-remember">
                <input type="checkbox" checked data-monroe-dex-remember />
                <span>Remember on this device</span>
              </label>
            </div>
            <div class="monroe-humane-games__dex-actions">
              <button type="button" class="monroe-humane-games__btn monroe-humane-games__btn--ghost" data-monroe-dex-view-album>
                View my album
              </button>
              <button type="button" class="monroe-humane-games__btn monroe-humane-games__btn--ghost" data-monroe-dex-copy-link>
                Copy share link
              </button>
            </div>
            <p class="monroe-humane-games__dex-toast" data-monroe-dex-toast hidden aria-live="polite"></p>
          </section>
        </div>
      </header>

      <!-- Game Picker Grid -->
      <section class="monroe-games-picker monroe-humane-games" aria-labelledby="monroe-games-picker-heading">
        <div class="monroe-games-picker__intro">
          <p class="monroe-native-eyebrow">Play now</p>
          <h2 id="monroe-games-picker-heading">Choose a game</h2>
          <p class="monroe-games-picker__lead">Seven free games and counting &mdash; pick one and jump in.</p>
        </div>

        <ul class="monroe-humane-games__grid">
          {GAMES.map((game) => (
            <li class="monroe-humane-games__grid-item">
              <button
                type="button"
                class={`monroe-humane-games__card monroe-humane-games__card--${game.id}`}
                data-monroe-humane-game={game.id}
                data-needs-dex={game.needsDex ? '1' : '0'}
                aria-label={`Play ${game.title}`}
              >
                <span class="monroe-humane-games__card-icon-wrap" aria-hidden="true">
                  <span class="monroe-humane-games__card-icon">{game.icon}</span>
                </span>
                <span class="monroe-humane-games__card-body">
                  <span class="monroe-humane-games__card-title">{game.title}</span>
                  <span class="monroe-humane-games__card-desc">{game.desc}</span>
                </span>
                <span class="monroe-humane-games__card-meta">
                  <span class="monroe-humane-games__card-badge">{game.badge}</span>
                  {game.needsDex && (
                    <span class="monroe-humane-games__card-lock" data-monroe-dex-lock hidden>Nickname required</span>
                  )}
                </span>
                <span class="monroe-humane-games__card-action" aria-hidden="true">Play &rsaquo;</span>
              </button>
            </li>
          ))}
        </ul>

        <p class="monroe-humane-games__hint">
          Opens on top of this page. Press Escape to close.
        </p>
      </section>

      <!-- How to Play Section -->
      <section class="monroe-games-how" aria-labelledby="monroe-games-how-heading">
        <h2 id="monroe-games-how-heading">How to play</h2>
        <ol class="monroe-games-how__steps">
          <li>
            <span class="monroe-games-how__step-num" aria-hidden="true">1</span>
            <span>Choose your Adoptédex nickname once &mdash; it works for every Humane Game.</span>
          </li>
          <li>
            <span class="monroe-games-how__step-num" aria-hidden="true">2</span>
            <span>The game opens in a full-screen layer right on this page.</span>
          </li>
          <li>
            <span class="monroe-games-how__step-num" aria-hidden="true">3</span>
            <span>Close anytime with the Close game button or Escape key to return here.</span>
          </li>
        </ol>
      </section>

      <!-- CTA Band -->
      <section class="monroe-games-cta-band" aria-labelledby="monroe-games-cta-heading">
        <h2 id="monroe-games-cta-heading">Help real pets in Monroe County</h2>
        <p>When you are done playing, browse adoptable animals, volunteer, or see upcoming shelter events.</p>
        <div class="monroe-games-cta-band__actions">
          <a class="monroe-games-cta-band__link monroe-games-cta-band__link--primary" href="/adopt">
            Adoptable pets
          </a>
          <a class="monroe-games-cta-band__link" href="/volunteer-form">
            Volunteer
          </a>
          <a class="monroe-games-cta-band__link" href="/events">
            Events
          </a>
        </div>
      </section>

    </div>
  </div>

  <!-- About Dialog -->
  <div class="monroe-humane-games-about" data-monroe-humane-games-about hidden>
    <div class="monroe-humane-games-about__panel" role="dialog" aria-modal="true" aria-labelledby="monroe-humane-games-about-title">
      <button class="monroe-humane-games-about__close" type="button" data-monroe-humane-games-about-close aria-label="Close about dialog">
        <span aria-hidden="true">&times;</span>
      </button>
      <p class="monroe-native-eyebrow">About Humane Games</p>
      <h3 class="monroe-humane-games-about__title" id="monroe-humane-games-about-title">Small games for big hearts</h3>
      <p class="monroe-humane-games-about__body">
        Humane Games is a tiny browser arcade made for Monroe Humane supporters. Everything loads fast, plays nicely on phones, tablets, and computers, and stays gentle &mdash; no ads, no trackers, no surprise sound.
      </p>
      <p class="monroe-humane-games-about__body">
        Grab a quick mood boost, then hop back to browse adoptable pets or see how you can help the shelter.
      </p>
      <a class="monroe-games-cta-band__link monroe-games-cta-band__link--primary" href="/adopt">
        Browse adoptable pets
      </a>
    </div>
  </div>

  <!-- Fullscreen Game Modal Player -->
  <div class="monroe-humane-games-player" data-monroe-humane-games-player hidden role="dialog" aria-modal="true" aria-labelledby="monroe-humane-games-player-title">
    <div class="monroe-humane-games-player__toolbar">
      <h2 class="monroe-humane-games-player__title" id="monroe-humane-games-player-title" data-monroe-humane-games-player-title>Humane Games</h2>
      <button class="monroe-humane-games-player__close" type="button" data-monroe-humane-games-player-close aria-label="Close game">
        &times; Close game
      </button>
    </div>
    <div class="monroe-humane-games-player__frame-wrap">
      <iframe
        class="monroe-humane-games-player__frame"
        data-monroe-humane-games-frame
        title="Humane Games Player"
        loading="lazy"
        allow="autoplay; fullscreen; gamepad"
      ></iframe>
    </div>
  </div>
</BaseLayout>

<style>
  [data-monroe-humane-games-player][hidden],
  [data-monroe-humane-games-about][hidden] {
    display: none !important;
  }

  .monroe-humane-games-player {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    background: #173a39;
  }

  .monroe-humane-games-player__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    background: #0f2d2c;
    border-bottom: 1px solid rgba(255, 250, 242, 0.15);
    color: #fffaf2;
  }

  .monroe-humane-games-player__title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: #fffaf2;
  }

  .monroe-humane-games-player__close {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 1.1rem;
    border: 1px solid rgba(255, 250, 242, 0.3);
    border-radius: 999px;
    background: transparent;
    color: #fffaf2;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .monroe-humane-games-player__close:hover {
    background: rgba(255, 250, 242, 0.15);
    border-color: #fffaf2;
  }

  .monroe-humane-games-player__frame-wrap {
    flex: 1;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .monroe-humane-games-player__frame {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .monroe-humane-games-about {
    position: fixed;
    inset: 0;
    z-index: 9998;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(6px);
  }

  .monroe-humane-games-about__panel {
    position: relative;
    max-width: 520px;
    width: 100%;
    padding: 2.25rem;
    background: #fff;
    border-radius: 24px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  .monroe-humane-games-about__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 999px;
    background: #f1f5f9;
    color: #475569;
    font-size: 1.25rem;
    cursor: pointer;
  }

  .monroe-humane-games-about__close:hover {
    background: #e2e8f0;
    color: #0f172a;
  }

  .monroe-humane-games-about__title {
    margin: 0.5rem 0 1rem;
    font-size: 1.65rem;
    color: #173a39;
  }

  .monroe-humane-games-about__body {
    color: #475569;
    line-height: 1.6;
    margin-bottom: 1rem;
  }
</style>

<script>
  function initGames() {
    const GAME_URLS: Record<string, string> = {
      petsnake: '/games/petsnake.html?embed=1',
      roguelike: '/games/petsnakerouguelike.html?embed=1',
      found: '/games/found/index.html?embed=1',
      match: '/games/match/match.html?embed=1',
      dex: '/games/dex/dex.html?embed=1',
      tycoon: '/games/shelter-tycoon/index.html?embed=1',
    };

    const root = document.querySelector<HTMLElement>('[data-monroe-humane-games-root]');
    if (!root) return;

    const player = document.querySelector<HTMLElement>('[data-monroe-humane-games-player]');
    const frame = player?.querySelector<HTMLIFrameElement>('[data-monroe-humane-games-frame]');
    const titleEl = player?.querySelector<HTMLElement>('[data-monroe-humane-games-player-title]');
    const input = document.getElementById('monroeDexUsername') as HTMLInputElement | null;
    const toastEl = root.querySelector<HTMLElement>('[data-monroe-dex-toast]');

    const savedName = () => localStorage.getItem('monroeDexUser') || '';
    if (input && savedName()) {
      input.value = savedName();
    }

    const showToast = (msg: string) => {
      if (!toastEl) return;
      toastEl.textContent = msg;
      toastEl.removeAttribute('hidden');
      setTimeout(() => toastEl.setAttribute('hidden', ''), 2500);
    };

    const saveNick = () => {
      const name = (input?.value ?? '').trim().slice(0, 20);
      if (name) {
        localStorage.setItem('monroeDexUser', name);
      }
      return name;
    };

    input?.addEventListener('change', saveNick);
    input?.addEventListener('blur', saveNick);

    // View album button
    root.querySelector<HTMLButtonElement>('[data-monroe-dex-view-album]')?.addEventListener('click', (e) => {
      e.preventDefault();
      const nick = saveNick() || savedName();
      if (!nick) {
        input?.focus();
        showToast('Please choose a nickname first!');
        return;
      }
      launchGame('dex', 'Adoptédex');
    });

    // Copy share link button
    root.querySelector<HTMLButtonElement>('[data-monroe-dex-copy-link]')?.addEventListener('click', async (e) => {
      e.preventDefault();
      saveNick();
      try {
        await navigator.clipboard.writeText(window.location.href);
        showToast('Share link copied to clipboard!');
      } catch {
        showToast('Link copied!');
      }
    });

    // Launch game cards
    const launchGame = (id: string, name: string) => {
      const url = GAME_URLS[id];
      if (!url || !player || !frame) return;
      frame.src = url;
      if (titleEl) titleEl.textContent = name;
      player.removeAttribute('hidden');
      document.body.style.overflow = 'hidden';
    };

    root.querySelectorAll<HTMLButtonElement>('[data-monroe-humane-game]').forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.dataset.monroeHumaneGame ?? '';
        const name = card.querySelector('.monroe-humane-games__card-title')?.textContent ?? 'Humane Games';
        if (card.dataset.needsDex === '1' && !savedName()) {
          input?.focus();
          input?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          showToast('Choose a nickname to save your progress!');
          return;
        }
        saveNick();
        launchGame(id, name);
      });
    });

    // Close game modal
    const closePlayer = () => {
      if (!player) return;
      player.setAttribute('hidden', '');
      if (frame) frame.src = 'about:blank';
      document.body.style.overflow = '';
    };

    player?.querySelector('[data-monroe-humane-games-player-close]')?.addEventListener('click', closePlayer);

    // About modal
    const aboutModal = document.querySelector<HTMLElement>('[data-monroe-humane-games-about]');
    root.querySelector('[data-monroe-humane-games-about-open]')?.addEventListener('click', () => {
      aboutModal?.removeAttribute('hidden');
    });
    aboutModal?.querySelector('[data-monroe-humane-games-about-close]')?.addEventListener('click', () => {
      aboutModal?.setAttribute('hidden', '');
    });
    aboutModal?.addEventListener('click', (e) => {
      if (e.target === aboutModal) aboutModal.setAttribute('hidden', '');
    });

    // Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (player && !player.hasAttribute('hidden')) closePlayer();
        if (aboutModal && !aboutModal.hasAttribute('hidden')) aboutModal.setAttribute('hidden', '');
      }
    });
  }

  document.addEventListener('astro:page-load', initGames);
  if (!document.startViewTransition) initGames();
</script>
