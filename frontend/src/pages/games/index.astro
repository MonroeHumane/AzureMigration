---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArcadeLeaderboardModal from '../../components/games/ArcadeLeaderboardModal.astro';

interface GameItem {
  id: string;
  title: string;
  badge: string;
  desc: string;
  action: string;
  icon: string;
  url: string;
  leaderboardId?: string;
  needsDex: boolean;
  perks: string[];
  gradientBg: string;
  glowBorder: string;
  accentText: string;
}

const GAMES: GameItem[] = [
  {
    id: 'booster',
    title: 'Pet Booster Packs',
    badge: '✨ Collectible Cards',
    desc: 'Rip open shiny foil packs to collect adorable cards of real shelter pets! Find rare holographic cards and build your ultimate pet album.',
    action: 'Open Booster Packs',
    icon: '✨',
    url: '/games/booster/index.html?embed=1',
    needsDex: true,
    perks: ['🧩 Match & Win Packs', '🐾🐾✨ Holographic Rares'],
    gradientBg: 'from-amber-500 via-orange-500 to-rose-600',
    glowBorder: 'hover:border-amber-400/80 hover:shadow-[0_12px_40px_-8px_rgba(245,158,11,0.45)]',
    accentText: 'text-amber-300'
  },
  {
    id: 'match',
    title: 'Pet Match Memory',
    badge: '🧩 Match & Earn Packs',
    desc: 'Flip cards to find pairs of adoptable dogs and cats! Match companions and beat levels to earn free Pet Booster Packs.',
    action: 'Play Pet Match',
    icon: '🧩',
    url: '/games/match/match.html?embed=1',
    leaderboardId: 'match',
    needsDex: true,
    perks: ['🎁 Free Pack on Milestones', '🐾 Real Shelter Profiles'],
    gradientBg: 'from-teal-600 via-emerald-600 to-cyan-700',
    glowBorder: 'hover:border-emerald-400/80 hover:shadow-[0_12px_40px_-8px_rgba(16,185,129,0.45)]',
    accentText: 'text-emerald-300'
  },
  {
    id: 'flappy',
    title: 'Flappy Cat',
    badge: '🐱 Tap to Fly ✦',
    desc: 'Tap to fly! Flap your paws and guide a brave shelter cat home through floating yarn balls, scratching posts, and flying fish treats.',
    action: 'Play Flappy Cat',
    icon: '🐱',
    url: '/games/flappy-cat/index.html?embed=1',
    leaderboardId: 'flappy_cat',
    needsDex: false,
    perks: ['🏆 Endless High Scores', '🐟 Collect Fish Treats'],
    gradientBg: 'from-sky-600 via-indigo-600 to-purple-700',
    glowBorder: 'hover:border-sky-400/80 hover:shadow-[0_12px_40px_-8px_rgba(56,189,248,0.45)]',
    accentText: 'text-sky-300'
  },
  {
    id: 'catwalk',
    title: 'Catwalk Night Patrol',
    badge: '🌙 Vector Arcade ✦',
    desc: 'Guide a vector shelter cat home through midnight streets! Dodge oncoming traffic, hop across fishbone rivers, and rescue all nine lives.',
    action: 'Play Catwalk',
    icon: '🐾',
    url: '/games/catwalk?embed=1',
    leaderboardId: 'catwalk',
    needsDex: false,
    perks: ['🎮 Vector CRT Lines', '📱 Mobile Touch D-Pad'],
    gradientBg: 'from-emerald-600 via-teal-700 to-green-800',
    glowBorder: 'hover:border-emerald-400/80 hover:shadow-[0_12px_40px_-8px_rgba(16,185,129,0.45)]',
    accentText: 'text-emerald-300'
  },
  {
    id: 'shelter_run',
    title: 'Shelter Run',
    badge: '🏃 Endless Runner',
    desc: 'Sprint through Monroe County trails! Jump over obstacles, slide under branches, and rescue runaway pets along your journey.',
    action: 'Play Shelter Run',
    icon: '🏃',
    url: '/games/shelter-run/index.html?embed=1',
    leaderboardId: 'shelter_run',
    needsDex: true,
    perks: ['🏆 Distance Milestones', '🐾 Rescue Pets On-the-Run'],
    gradientBg: 'from-violet-600 via-purple-700 to-indigo-800',
    glowBorder: 'hover:border-purple-400/80 hover:shadow-[0_12px_40px_-8px_rgba(168,85,247,0.45)]',
    accentText: 'text-purple-300'
  }
];

const MASCOTS = [
  { id: 'smokey', icon: '🐱', name: 'Smokey', desc: 'Curious Explorer' },
  { id: 'barnaby', icon: '🐕', name: 'Barnaby', desc: 'Playful Retriever' },
  { id: 'marmalade', icon: '🐾', name: 'Marmalade', desc: 'Ginger Tabby' },
  { id: 'daisy', icon: '🐶', name: 'Daisy', desc: 'Rescue Pup' },
  { id: 'pip', icon: '🐰', name: 'Pip', desc: 'Shelter Bunny' }
];
---

<BaseLayout
  title="Humane Games & Pet Booster Packs | Humane Society of Monroe County"
  description="Play free browser games featuring real adoptable pets. Rip open shiny foil booster packs, play memory match, and tap to fly with Flappy Cat."
  bodyClass="bg-[#071a17]"
>
  <main class="min-h-screen pb-24 text-slate-100" data-monroe-humane-games-root>
    
    <!-- Hero Section with Monroe Humane Brand Styling -->
    <section class="relative bg-gradient-to-b from-[#061815] via-[#0c2824] to-[#071a17] text-white pt-16 sm:pt-24 pb-28 sm:pb-36 px-4 sm:px-6 overflow-hidden border-b border-teal-900/60">
      <!-- Atmospheric background glow & starlight -->
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(20,184,166,0.15),transparent_40%),radial-gradient(circle_at_80%_30%,rgba(245,158,11,0.1),transparent_35%)] pointer-events-none"></div>
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-teal-500/10 blur-[130px] rounded-full pointer-events-none"></div>

      <div class="max-w-5xl mx-auto text-center relative z-10">
        <!-- Pill Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-teal-950/80 border border-teal-700/60 text-teal-300 text-xs font-bold uppercase tracking-wider mb-6 shadow-sm">
          <span>🎮 Humane Arcade</span>
          <span class="text-teal-600">·</span>
          <span class="text-amber-300">Monroe County Humane Society</span>
        </div>

        <h1 class="text-4xl sm:text-6xl md:text-7xl font-serif font-black tracking-tight mb-5 text-white drop-shadow-sm">
          Small games for big hearts.
        </h1>
        <p class="text-base sm:text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed mb-10">
          Play free browser games featuring real adoptable pets. Rip open foil booster packs, build your pet album, and discover companions waiting for loving homes.
        </p>

        <!-- Interactive Arcade Pass / Player Card -->
        <div class="max-w-xl mx-auto bg-[#0b2b25]/85 backdrop-blur-xl border border-teal-700/60 p-6 sm:p-7 rounded-3xl shadow-2xl relative overflow-hidden text-left group">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-4 border-b border-teal-800/60">
            <div class="flex items-center gap-3">
              <!-- Mascot Avatar Picker Button -->
              <div class="relative">
                <button
                  type="button"
                  id="btn-mascot-picker"
                  class="w-12 h-12 rounded-2xl bg-[#061e1b] border-2 border-teal-600/80 hover:border-amber-400 flex items-center justify-center text-2xl shadow-inner transition hover:scale-105 cursor-pointer relative group/mascot"
                  title="Choose your Mascot Companion"
                  aria-label="Change Mascot Companion"
                >
                  <span id="pass-mascot-icon">🐱</span>
                  <span class="absolute -bottom-1 -right-1 w-4 h-4 rounded-full bg-amber-500 text-[10px] text-slate-950 font-bold flex items-center justify-center shadow-xs">✎</span>
                </button>

                <!-- Mascot Chooser Popover -->
                <div
                  id="mascot-chooser-popover"
                  class="hidden absolute top-14 left-0 z-50 bg-[#061e1a] border border-teal-700/80 p-3 rounded-2xl shadow-2xl w-64 backdrop-blur-xl animate-in fade-in zoom-in-95 duration-150"
                >
                  <div class="text-[10px] font-bold uppercase tracking-wider text-teal-300 mb-2">Choose Companion</div>
                  <div class="grid grid-cols-5 gap-1.5 mb-2">
                    {MASCOTS.map((m) => (
                      <button
                        type="button"
                        data-mascot-id={m.id}
                        data-mascot-icon={m.icon}
                        class="mascot-select-btn w-10 h-10 rounded-xl bg-[#082823] hover:bg-teal-700/60 border border-teal-800 hover:border-amber-400 flex items-center justify-center text-xl transition cursor-pointer"
                        title={`${m.name} (${m.desc})`}
                      >
                        {m.icon}
                      </button>
                    ))}
                  </div>
                  <div id="mascot-desc-preview" class="text-[11px] text-slate-300 font-medium text-center">Smokey: Curious Explorer</div>
                </div>
              </div>

              <div>
                <div class="flex items-center gap-2">
                  <h2 class="text-lg font-bold text-white tracking-tight">Your Humane Arcade Pass</h2>
                  <span id="pass-rank-badge" class="px-2 py-0.5 rounded-full bg-teal-950/90 border border-teal-700/70 text-[10px] font-bold text-amber-300 tracking-wide">
                    Novice Rescuer 🐾
                  </span>
                </div>
                <p class="text-xs text-slate-300 mt-0.5">Saves your booster packs, cards &amp; mascot across games.</p>
              </div>
            </div>

            <!-- Header Quick Actions -->
            <div class="flex items-center gap-2 self-start sm:self-auto shrink-0">
              <button
                type="button"
                id="btn-open-leaderboard"
                data-open-leaderboard
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 hover:text-amber-200 border border-amber-500/40 text-xs font-bold transition cursor-pointer shadow-xs"
                title="View Arcade High Scores"
              >
                <span>🏆 Scores</span>
              </button>

              <button
                type="button"
                id="btn-view-album"
                class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-teal-800/70 hover:bg-teal-700 text-teal-100 hover:text-white border border-teal-600/60 text-xs font-semibold transition cursor-pointer shadow-xs"
              >
                <span>📖 Album</span>
                <span class="text-teal-300">&rarr;</span>
              </button>
            </div>
          </div>

          <!-- Nickname & Live Stats Bar -->
          <div class="mt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <div class="relative flex-1">
              <label for="monroeDexUsername" class="sr-only">Player Nickname</label>
              <input
                type="text"
                id="monroeDexUsername"
                maxlength="20"
                placeholder="Choose nickname (e.g. PetLover42)"
                class="w-full bg-[#051a17] border border-teal-800/80 rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-slate-400 focus:outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500/50 transition font-medium"
              />
              <span id="pass-saved-indicator" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-[10px] font-bold text-emerald-400 bg-emerald-950/80 px-2 py-0.5 rounded-md border border-emerald-800">
                SAVED ✓
              </span>
            </div>

            <!-- Stats Ribbon -->
            <div class="flex items-center gap-2 text-xs shrink-0">
              <div class="px-3 py-2 rounded-xl bg-[#061e1b] border border-teal-800/70 text-slate-200">
                <span class="text-[10px] text-slate-400 uppercase tracking-wider block font-semibold">Packs Ready</span>
                <span id="stat-packs-count" class="font-mono font-bold text-amber-300 text-sm">1</span>
              </div>
              <div class="px-3 py-2 rounded-xl bg-[#061e1b] border border-teal-800/70 text-slate-200">
                <span class="text-[10px] text-slate-400 uppercase tracking-wider block font-semibold">Cards in Album</span>
                <span id="stat-cards-count" class="font-mono font-bold text-emerald-300 text-sm">0</span>
              </div>
            </div>
          </div>

          <div id="arcade-pass-toast" class="hidden mt-3 text-xs text-emerald-400 font-semibold flex items-center gap-1.5" role="status">
            <span>✨</span>
            <span id="arcade-pass-toast-msg">Player pass updated!</span>
          </div>
        </div>
      </div>
    </section>

    <!-- The 5 Flagship Game Cards Section -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 -mt-16 sm:-mt-20 relative z-20">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {GAMES.map((game) => (
          <div class={`group relative rounded-3xl p-6 sm:p-7 flex flex-col bg-gradient-to-b from-[#0b2823] to-[#071d1a] border border-teal-800/80 shadow-xl transition-all duration-300 ${game.glowBorder} justify-between`}>
            
            <!-- Glow sheen backdrop -->
            <div class={`absolute top-0 right-0 w-44 h-44 bg-gradient-to-br ${game.gradientBg} opacity-15 blur-[60px] rounded-full pointer-events-none group-hover:opacity-25 transition-opacity`}></div>

            <div>
              <!-- Top Row: Icon Box & Badge -->
              <div class="flex items-center justify-between gap-2 mb-5">
                <div class="w-14 h-14 rounded-2xl bg-[#061e1a] border border-teal-700/60 flex items-center justify-center text-3xl shadow-inner group-hover:scale-105 transition-transform">
                  {game.icon}
                </div>
                
                <div class="flex items-center gap-1.5">
                  {game.leaderboardId && (
                    <button
                      type="button"
                      data-open-leaderboard
                      data-leaderboard-game={game.leaderboardId}
                      class="px-2 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-950/60 border border-amber-600/40 text-amber-300 hover:bg-amber-900/60 transition cursor-pointer"
                      title="View High Scores"
                    >
                      🏆 High Scores
                    </button>
                  )}
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold tracking-wider uppercase bg-teal-950/80 border border-teal-700/60 text-slate-200">
                    {game.badge}
                  </span>
                </div>
              </div>

              <!-- Title & Description -->
              <h3 class="text-2xl font-serif font-black text-white tracking-tight mb-2.5">
                {game.title}
              </h3>
              <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6 font-normal">
                {game.desc}
              </p>

              <!-- Micro Perks / Highlights -->
              <div class="space-y-1.5 mb-8">
                {game.perks.map((perk) => (
                  <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#041512] border border-teal-900/80 text-[11px] font-medium text-slate-300 mr-1.5 mb-1">
                    <span>{perk}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Primary Action Button -->
            <div class="pt-4 border-t border-teal-900/60 mt-auto space-y-2">
              <button
                type="button"
                data-launch-game={game.id}
                data-game-url={game.url}
                data-game-title={game.title}
                data-game-icon={game.icon}
                class={`w-full py-3.5 px-5 rounded-2xl font-bold text-xs uppercase tracking-wider text-white bg-gradient-to-r ${game.gradientBg} hover:opacity-95 transition-all shadow-md flex items-center justify-between group-hover:shadow-lg cursor-pointer active:scale-[0.98]`}
              >
                <span>{game.action}</span>
                <span class="text-lg leading-none transition-transform group-hover:translate-x-1">&rarr;</span>
              </button>

              {game.id === 'booster' && (
                <button
                  type="button"
                  id="btn-booster-album-link"
                  class="w-full py-1.5 text-center text-[11px] font-semibold text-amber-300 hover:text-amber-200 transition cursor-pointer flex items-center justify-center gap-1"
                >
                  <span>🎴 View Pet Album &amp; Rare Cards</span>
                  <span>↗</span>
                </button>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Real Pets Impact & Conversion Section -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 mt-24 sm:mt-32 text-center">
      <div class="p-8 sm:p-12 rounded-3xl bg-[#0b2420]/80 border border-teal-800/70 shadow-2xl relative overflow-hidden">
        <div class="w-12 h-12 rounded-2xl bg-teal-900/80 text-teal-300 border border-teal-700 flex items-center justify-center text-2xl mx-auto mb-4">
          🐾
        </div>
        <h2 class="text-2xl sm:text-4xl font-serif font-black text-white mb-3 tracking-tight">
          Every card is a real shelter pet waiting for love.
        </h2>
        <p class="text-sm sm:text-base text-slate-300 max-w-xl mx-auto leading-relaxed mb-8">
          The dogs and cats featured on cards in Pet Booster Packs and Pet Match Memory are real animals in our care at Monroe County Humane Society. Ready to meet them in person?
        </p>

        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href="/adopt/"
            class="px-6 py-3 rounded-full bg-emerald-500 hover:bg-emerald-400 text-teal-950 font-bold uppercase tracking-wider text-xs transition-all shadow-md hover:-translate-y-0.5"
          >
            Meet Adoptable Pets
          </a>
          <a
            href="/volunteer-form/"
            class="px-6 py-3 rounded-full bg-white hover:bg-slate-100 text-teal-950 font-bold uppercase tracking-wider text-xs transition-all shadow-md hover:-translate-y-0.5"
          >
            Volunteer at Shelter
          </a>
          <a
            href="/donate/"
            class="px-6 py-3 rounded-full border border-teal-600 text-teal-200 hover:bg-teal-900/50 font-bold uppercase tracking-wider text-xs transition-all"
          >
            Support Pet Care
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Fullscreen Arcade Cabinet Modal Player 2.0 -->
  <div
    id="game-cabinet-modal"
    class="fixed inset-0 z-[9999] bg-slate-950/98 backdrop-blur-md flex flex-col hidden opacity-0 transition-opacity duration-200 select-none"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cabinet-game-title"
  >
    <!-- Cabinet Top Header Chrome -->
    <header class="h-14 px-3 sm:px-6 bg-[#061815] border-b border-teal-800/80 flex items-center justify-between shrink-0 select-none z-30">
      <div class="flex items-center gap-2.5">
        <span id="cabinet-game-icon" class="text-2xl">🎮</span>
        <div>
          <h3 id="cabinet-game-title" class="text-sm font-bold text-white tracking-wide leading-tight">
            Humane Arcade
          </h3>
          <span class="text-[10px] text-teal-400 block font-mono">Monroe County Humane Society</span>
        </div>
      </div>

      <div class="flex items-center gap-1.5 sm:gap-2">
        <!-- Sound Mute Toggle -->
        <button
          type="button"
          id="cabinet-sound-btn"
          class="px-2.5 py-1.5 rounded-lg bg-teal-950 hover:bg-teal-900 text-slate-300 hover:text-white border border-teal-800 text-xs font-semibold transition cursor-pointer flex items-center gap-1"
          title="Toggle Game Sound"
        >
          <span id="cabinet-sound-icon">🔊</span>
          <span class="hidden sm:inline" id="cabinet-sound-label">Sound</span>
        </button>

        <!-- CRT Scanline Filter Toggle -->
        <button
          type="button"
          id="cabinet-crt-btn"
          class="px-2.5 py-1.5 rounded-lg bg-teal-950 hover:bg-teal-900 text-slate-300 hover:text-white border border-teal-800 text-xs font-semibold transition cursor-pointer flex items-center gap-1"
          title="Toggle Retro CRT Scanlines"
        >
          <span>📺</span>
          <span class="hidden sm:inline">CRT</span>
        </button>

        <!-- Fullscreen Button -->
        <button
          type="button"
          id="cabinet-fullscreen-btn"
          class="px-2.5 py-1.5 rounded-lg bg-teal-950 hover:bg-teal-900 text-slate-300 hover:text-white border border-teal-800 text-xs font-semibold transition cursor-pointer hidden sm:inline-flex items-center gap-1.5"
          title="Toggle Fullscreen"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
          <span>Fullscreen</span>
        </button>

        <!-- Close Cabinet Button -->
        <button
          type="button"
          id="cabinet-close-btn"
          class="px-3 py-1.5 rounded-lg bg-rose-950/80 hover:bg-rose-900 text-rose-200 hover:text-white border border-rose-800/80 text-xs font-bold transition cursor-pointer flex items-center gap-1 active:scale-95"
          title="Exit Cabinet"
        >
          <span>Close</span>
          <span class="text-sm font-black">&times;</span>
        </button>
      </div>
    </header>

    <!-- Cabinet Screen Frame (contains Iframe & CRT overlay) -->
    <div class="flex-1 w-full h-full relative bg-black flex items-center justify-center overflow-hidden">
      <!-- Loading Spinner -->
      <div id="cabinet-loading-spinner" class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-[#071a17] z-10 transition-opacity">
        <div class="w-9 h-9 border-3 border-teal-500 border-t-transparent rounded-full animate-spin"></div>
        <p class="text-xs text-teal-300 font-mono tracking-wider animate-pulse">BOOTING HUMANE ARCADE…</p>
      </div>

      <!-- CRT Scanline & Phosphor Sheen Overlay -->
      <div
        id="cabinet-crt-overlay"
        class="hidden absolute inset-0 pointer-events-none z-20 crt-effect"
      ></div>

      <!-- Active Game Iframe -->
      <iframe
        id="cabinet-game-iframe"
        class="w-full h-full border-0 block"
        title="Humane Game Player"
        allow="autoplay; fullscreen; gamepad"
      ></iframe>
    </div>

    <!-- Cabinet Bottom Quick-Switch Dock (Mobile-First Ergonomic Nav) -->
    <nav
      id="cabinet-quick-dock"
      class="h-14 sm:h-15 px-2 sm:px-4 bg-[#061815]/95 backdrop-blur-md border-t border-teal-800/80 flex items-center justify-start sm:justify-center gap-1 sm:gap-2.5 shrink-0 select-none z-30 overflow-x-auto scrollbar-none pb-[max(0.25rem,env(safe-area-inset-bottom))]"
      aria-label="Arcade Quick Switch Dock"
    >
      <button
        type="button"
        data-dock-game="booster"
        data-dock-url="/games/booster/index.html?embed=1"
        data-dock-title="Pet Booster Packs"
        data-dock-icon="✨"
        class="cabinet-dock-btn flex-1 sm:flex-initial shrink-0 min-w-[70px] sm:min-w-[80px] px-2 sm:px-3 py-1.5 rounded-xl text-slate-300 hover:text-white border border-transparent hover:border-teal-700/60 hover:bg-teal-900/40 flex flex-col sm:flex-row items-center justify-center gap-1 transition cursor-pointer text-center"
      >
        <span class="text-base sm:text-sm">✨</span>
        <span class="text-[10px] sm:text-xs font-bold leading-tight truncate">Packs</span>
      </button>

      <button
        type="button"
        data-dock-game="match"
        data-dock-url="/games/match/match.html?embed=1"
        data-dock-title="Pet Match Memory"
        data-dock-icon="🧩"
