---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Games | 734-243-3669"
  description="Free browser games featuring real adoptable pets from Monroe Humane. Play Flappy Cat, Match Memory, Shelter Run, and more - then meet the animals in real life."
>
  <main class="pt-32 pb-24 px-4 max-w-7xl mx-auto" data-monroe-humane-games-root>
    <header class="mb-20 flex flex-col lg:flex-row gap-12 items-center" aria-labelledby="monroe-games-title">
      <div class="flex-1 text-center lg:text-left">
        <p class="text-emerald-500 font-bold uppercase tracking-widest text-sm mb-4">Services</p>
        <h1 id="monroe-games-title" class="text-5xl md:text-6xl font-serif text-teal-900 mb-6">Humane Games</h1>
        <p class="text-xl text-gray-600 mb-8 leading-relaxed">
            Free browser games featuring real adoptable pets - play for a few minutes, then meet the animals on our site.
        </p>
        <ul class="flex flex-wrap justify-center lg:justify-start gap-3 mb-8" aria-label="Highlights">
          <li class="px-5 py-2 bg-teal-50 text-teal-800 border border-teal-100 rounded-full font-medium">Free in your browser</li>
          <li class="px-5 py-2 bg-teal-50 text-teal-800 border border-teal-100 rounded-full font-medium">Live shelter pets</li>
          <li class="px-5 py-2 bg-teal-50 text-teal-800 border border-teal-100 rounded-full font-medium">Your Adopt�dex album</li>
        </ul>
        <p>
          <button class="text-emerald-700 font-bold hover:text-emerald-900 underline underline-offset-4 decoration-emerald-200 transition-all" type="button" data-monroe-humane-games-about-open>
              About Humane Games
          </button>
        </p>
      </div>

      <div class="w-full lg:w-5/12 max-w-md mx-auto">
        <section class="bg-white border border-gray-200 rounded-3xl p-8 shadow-md relative overflow-hidden" aria-labelledby="monroe-dex-gate-heading">
          <span class="absolute -top-6 -right-6 text-9xl opacity-5" aria-hidden="true">??</span>
          <h2 class="text-2xl font-serif text-teal-900 mb-2 relative z-10" id="monroe-dex-gate-heading">Your Adopt�dex name</h2>
          <p class="text-gray-600 mb-6 relative z-10">One nickname saves your Adopt�dex album and Shelter Tycoon progress.</p>

          <div class="mb-6 relative z-10">
            <div class="mb-4">
              <label class="block font-bold text-teal-900 mb-2" for="monroeDexUsername">Nickname</label>
              <input
                class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-xl focus:ring-2 focus:ring-teal-700 focus:bg-white transition-all outline-none"
                type="text"
                id="monroeDexUsername"
                name="monroeDexUsername"
                maxlength="20"
                autocomplete="nickname"
                placeholder="e.g. PetFriend42"
                data-monroe-dex-username
              >
            </div>
            <label class="flex items-center gap-2 text-gray-600 cursor-pointer">
              <input type="checkbox" class="rounded text-teal-700 focus:ring-teal-700" checked data-monroe-dex-remember>
              <span>Remember on this device</span>
            </label>
          </div>

          <div class="flex flex-wrap gap-3 relative z-10">
            <button type="button" class="flex-1 basis-full sm:basis-0 px-4 py-2 rounded-full border-2 border-teal-700 text-teal-700 font-bold uppercase tracking-wider text-sm hover:bg-teal-50 transition-colors disabled:opacity-50 disabled:cursor-not-allowed" data-monroe-dex-view-album disabled>
                View my album
            </button>
            <button type="button" class="flex-1 basis-full sm:basis-0 px-4 py-2 rounded-full border-2 border-teal-700 text-teal-700 font-bold uppercase tracking-wider text-sm hover:bg-teal-50 transition-colors disabled:opacity-50 disabled:cursor-not-allowed" data-monroe-dex-copy-link disabled>
                Copy share link
            </button>
            <button type="button" class="flex-1 basis-full sm:basis-0 px-4 py-2 rounded-full border-2 border-teal-700 text-teal-700 font-bold uppercase tracking-wider text-sm hover:bg-teal-50 transition-colors disabled:opacity-50 disabled:cursor-not-allowed" data-monroe-dex-share disabled style="display: none;">
                Share my album
            </button>
          </div>
          <p data-monroe-dex-privacy></p>
          <p data-monroe-dex-toast hidden aria-live="polite"></p>
        </section>
      </div>
    </header>


    <section class="mb-24" aria-labelledby="monroe-games-picker-heading">
      <div class="text-center mb-12">
        <p class="text-emerald-500 font-bold uppercase tracking-widest text-sm mb-4">Play now</p>
        <h2 id="monroe-games-picker-heading" class="text-4xl font-serif text-teal-900 mb-4">Choose a game</h2>
        <p class="text-xl text-gray-600">Six free games and counting - pick one and jump in.</p>
      </div>
      <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <li>
          <button
            type="button"
            class="group w-full h-full flex flex-col bg-white border border-gray-200 rounded-3xl p-8 text-left shadow-sm hover:shadow-md transition-all hover:-translate-y-1"
