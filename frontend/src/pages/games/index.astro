---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerShell from '../../components/InnerShell.astro';
import '../../styles/monroe-games.css';
---

<BaseLayout
  title="Games | 734-243-3669"
  description="Free browser games featuring real adoptable pets from Monroe Humane. Play Flappy Cat, Match Memory, Shelter Run, and more — then meet the animals in real life."
>
<InnerShell variant="games">
        <div class="monroe-games-page" data-monroe-humane-games-root>
            <header class="monroe-games-hero" aria-labelledby="monroe-games-title">
                <div class="monroe-games-hero__copy">
                    <p class="monroe-native-eyebrow">Services</p>
                    <h1 id="monroe-games-title">Humane Games</h1>
                    <p class="monroe-native-lead">
                        Free browser games featuring real adoptable pets — play for a few minutes, then meet the animals on our site.                    </p>
                    <ul class="monroe-games-feature-pills" aria-label="Highlights">
                        <li>Free in your browser</li>
                        <li>Live shelter pets</li>
                        <li>Your Adoptédex album</li>
                    </ul>
                    <p class="monroe-games-hero__about">
                        <button class="monroe-games-hero__about-link" type="button" data-monroe-humane-games-about-open>
                            About Humane Games                        </button>
                    </p>
                </div>
                <div class="monroe-games-hero__panel monroe-humane-games">
                    <span class="monroe-humane-games__panel-glyph" aria-hidden="true">🐾</span>
                    <section class="monroe-humane-games__dex-gate" aria-labelledby="monroe-dex-gate-heading">
                        <h2 class="monroe-humane-games__dex-gate-title" id="monroe-dex-gate-heading">Your Adoptédex name</h2>
                        <p class="monroe-humane-games__dex-gate-hint">One nickname saves your Adoptédex album and Shelter Tycoon progress.</p>
                        <div class="monroe-humane-games__dex-gate-fields">
                            <div class="monroe-humane-games__dex-gate-row">
                                <label class="monroe-humane-games__dex-label" for="monroeDexUsername">Nickname</label>
                                <input
                                    class="monroe-humane-games__dex-input"
                                    type="text"
                                    id="monroeDexUsername"
                                    name="monroeDexUsername"
                                    maxlength="20"
                                    autocomplete="nickname"
                                    placeholder="e.g. PetFriend42"
                                    data-monroe-dex-username
                                >
                            </div>
                            <label class="monroe-humane-games__dex-remember">
                                <input type="checkbox" checked data-monroe-dex-remember>
                                <span>Remember on this device</span>
                            </label>
                        </div>
                        <div class="monroe-humane-games__dex-actions">
                            <button type="button" class="monroe-humane-games__btn monroe-humane-games__btn--ghost" data-monroe-dex-view-album disabled>
                                View my album                            </button>
                            <button type="button" class="monroe-humane-games__btn monroe-humane-games__btn--ghost" data-monroe-dex-copy-link disabled>
                                Copy share link                            </button>
                        </div>
                        <p class="monroe-humane-games__dex-privacy" data-monroe-dex-privacy></p>
                        <p class="monroe-humane-games__dex-toast" data-monroe-dex-toast hidden aria-live="polite"></p>
                    </section>
                </div>
            </header>
            <section class="monroe-games-picker monroe-humane-games" aria-labelledby="monroe-games-picker-heading">
                <div class="monroe-games-picker__intro">
                    <p class="monroe-native-eyebrow">Play now</p>
                    <h2 id="monroe-games-picker-heading">Choose a game</h2>
                    <p class="monroe-games-picker__lead">Five free games and counting — pick one and jump in.</p>
                </div>
                <ul class="monroe-humane-games__grid">
                                                                    <li class="monroe-humane-games__grid-item">
                            <button
                                type="button"
                                class="monroe-humane-games__card monroe-humane-games__card--roguelike"
                                data-monroe-humane-game="roguelike"
                                                                aria-label="Play Pet Snake Adventure"
                            >
                                <span class="monroe-humane-games__card-icon-wrap" aria-hidden="true">
                                    <span class="monroe-humane-games__card-icon">🗺️</span>
                                </span>
                                <span class="monroe-humane-games__card-body">
                                    <span class="monroe-humane-games__card-title">Pet Snake</span>
                                    <span class="monroe-humane-games__card-desc">Roguelike as a cat or dog — collect treats and dodge bombs.</span>
                                </span>
                                <span class="monroe-humane-games__card-meta">
                                    <span class="monroe-humane-games__card-badge">Play anytime</span>
                                                                    </span>
                                <span class="monroe-humane-games__card-action" aria-hidden="true">Play ›</span>
                            </button>
                        </li>
                                                                    <li class="monroe-humane-games__grid-item">
                            <button
                                type="button"
                                class="monroe-humane-games__card monroe-humane-games__card--match"
                                data-monroe-humane-game="match"
                                 data-needs-dex="1"                                aria-label="Play Pet Match"
                            >
                                <span class="monroe-humane-games__card-icon-wrap" aria-hidden="true">
                                    <span class="monroe-humane-games__card-icon">🃏</span>
                                </span>
                                <span class="monroe-humane-games__card-body">
                                    <span class="monroe-humane-games__card-title">Pet Match</span>
                                    <span class="monroe-humane-games__card-desc">Match pet photos — levels get bigger as you go.</span>
                                </span>
                                <span class="monroe-humane-games__card-meta">
                                    <span class="monroe-humane-games__card-badge">Saves to Adoptédex</span>
                                                                            <span class="monroe-humane-games__card-lock" data-monroe-dex-lock hidden>Nickname required</span>
                                                                    </span>
                                <span class="monroe-humane-games__card-action" aria-hidden="true">Play ›</span>
                            </button>
                        </li>
                                                                    <li class="monroe-humane-games__grid-item">
                            <button
                                type="button"
                                class="monroe-humane-games__card monroe-humane-games__card--dex"
                                data-monroe-humane-game="dex"
                                 data-needs-dex="1"                                aria-label="Play Adoptédex"
                            >
                                <span class="monroe-humane-games__card-icon-wrap" aria-hidden="true">
                                    <span class="monroe-humane-games__card-icon">📖</span>
                                </span>
                                <span class="monroe-humane-games__card-body">
                                    <span class="monroe-humane-games__card-title">Adoptédex</span>
                                    <span class="monroe-humane-games__card-desc">Meet adoptable pets and build your album.</span>
                                </span>
                                <span class="monroe-humane-games__card-meta">
                                    <span class="monroe-humane-games__card-badge">Saves to Adoptédex</span>
                                                                            <span class="monroe-humane-games__card-lock" data-monroe-dex-lock hidden>Nickname required</span>
                                                                    </span>
                                <span class="monroe-humane-games__card-action" aria-hidden="true">Play ›</span>
                            </button>
                        </li>
                                                                    <li class="monroe-humane-games__grid-item">
                            <button
                                type="button"
                                class="monroe-humane-games__card monroe-humane-games__card--tycoon"
                                data-monroe-humane-game="tycoon"
                                 data-needs-dex="1"                                aria-label="Play Shelter Tycoon"
                            >
                                <span class="monroe-humane-games__card-icon-wrap" aria-hidden="true">
                                    <span class="monroe-humane-games__card-icon">🏠</span>
                                </span>
                                <span class="monroe-humane-games__card-body">
                                    <span class="monroe-humane-games__card-title">Shelter Tycoon</span>
                                    <span class="monroe-humane-games__card-desc">Run a humane society — intake real pets, complete care plans, find forever homes.</span>
                                </span>
                                <span class="monroe-humane-games__card-meta">
                                    <span class="monroe-humane-games__card-badge">Saves progress + Adoptédex</span>
                                                                            <span class="monroe-humane-games__card-lock" data-monroe-dex-lock hidden>Nickname required</span>
                                                                    </span>
                                <span class="monroe-humane-games__card-action" aria-hidden="true">Play ›</span>
                            </button>
                        </li>
                                                                    <li class="monroe-humane-games__grid-item">
                        </li>
                                    </ul>
                <p class="monroe-humane-games__hint">
                    Opens on top of this page. Press Escape to close.                </p>
            </section>
            <section class="monroe-games-how" aria-labelledby="monroe-games-how-heading">
                <h2 id="monroe-games-how-heading">How to play</h2>
                <ol class="monroe-games-how__steps">
                    <li>
                        <span class="monroe-games-how__step-num" aria-hidden="true">1</span>
                        <span>Choose your Adoptédex nickname once — it works for every Humane Game.</span>
                    </li>
                    <li>
                        <span class="monroe-games-how__step-num" aria-hidden="true">2</span>
                        <span>The game opens in a full-screen layer on this page.</span>
                    </li>
                    <li>
                        <span class="monroe-games-how__step-num" aria-hidden="true">3</span>
                        <span>Close anytime with the Close game button or Escape to return here.</span>
                    </li>
                </ol>
            </section>
            <section class="monroe-games-cta-band" aria-labelledby="monroe-games-cta-heading">
                <h2 id="monroe-games-cta-heading">Help real pets in Monroe County</h2>
                <p>When you are done playing, browse adoptable animals, volunteer, or see upcoming shelter events.</p>
                <div class="monroe-games-cta-band__actions">
                    <a class="monroe-games-cta-band__link monroe-games-cta-band__link--primary" href="/adopt/">
                        Adoptable pets                    </a>
                    <a class="monroe-games-cta-band__link" href="/volunteer-form">
                        Volunteer                    </a>
                    <a class="monroe-games-cta-band__link" href="/events">
                        Events                    </a>
                </div>
            </section>
        </div>
</InnerShell>
</BaseLayout>

<div class="monroe-humane-games-overlay" data-humane-games-overlay hidden>
  <div class="monroe-humane-games-overlay__bar">
    <strong data-humane-games-title>Humane Games</strong>
    <button type="button" data-humane-games-close aria-label="Close game">✕ Close</button>
  </div>
  <iframe data-humane-games-frame title="Humane Games" allow="autoplay; fullscreen; gamepad"></iframe>
</div>

<style>
  .monroe-humane-games-overlay { position: fixed; inset: 0; z-index: 8000; display: flex; flex-direction: column; background: #10201f; }
  .monroe-humane-games-overlay[hidden] { display: none; }
  .monroe-humane-games-overlay__bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.65rem 1rem; color: #fffaf2; background: #173a39; font-family: 'Jost', 'Segoe UI', sans-serif; }
  .monroe-humane-games-overlay__bar button { border: 1px solid rgba(255,250,242,0.4); background: transparent; color: #fffaf2; border-radius: 999px; padding: 0.4rem 1rem; cursor: pointer; font: 600 0.8rem/1 'Jost', sans-serif; letter-spacing: 0.06em; text-transform: uppercase; }
  .monroe-humane-games-overlay iframe { flex: 1; width: 100%; border: 0; }
</style>

<script>
  // Humane Games launcher: nickname gate + full-screen game overlay.
  // Replaces the WP launcher JS with a minimal registry-driven island.
  const GAME_URLS: Record<string, string> = {
    roguelike: '/games/petsnakerouguelike.html?embed=1',
    match: '/games/match/match.html?embed=1',
    dex: '/games/dex/dex.html?embed=1',
    tycoon: '/games/shelter-tycoon/index.html?embed=1',
  };

  const root = document.querySelector<HTMLElement>('[data-monroe-humane-games-root]');
  const overlay = document.querySelector<HTMLElement>('[data-humane-games-overlay]');
  const frame = overlay?.querySelector<HTMLIFrameElement>('[data-humane-games-frame]');
  const titleEl = overlay?.querySelector<HTMLElement>('[data-humane-games-title]');
  const input = document.getElementById('monroeDexUsername') as HTMLInputElement | null;

  const savedName = () => localStorage.getItem('monroeDexUser') ?? '';
  if (input && savedName()) input.value = savedName();

  const saveNick = () => {
    const name = (input?.value ?? '').trim().slice(0, 24);
    if (name) localStorage.setItem('monroeDexUser', name);
  };

  document.querySelectorAll<HTMLButtonElement>('[data-monroe-humane-games-nickname-save], .monroe-humane-games__dex-actions button').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      saveNick();
      btn.closest('.monroe-humane-games__dex-gate')?.setAttribute('data-nickname-set', savedName() ? '1' : '0');
    });
  });

  root?.querySelectorAll<HTMLButtonElement>('[data-monroe-humane-game]').forEach((card) => {
    card.addEventListener('click', () => {
      const id = card.dataset.monroeHumaneGame ?? '';
      const url = GAME_URLS[id];
      if (!url) {
        alert('This game is being updated and will return soon. Try Pet Snake Adventure, Pet Match, Adoptédex, or Shelter Tycoon!');
        return;
      }
      if (card.dataset.needsDex === '1' && !savedName()) {
        input?.focus();
        input?.closest('.monroe-humane-games__dex-gate')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      saveNick();
      if (frame) frame.src = url;
      const name = card.querySelector('.monroe-humane-games__card-title')?.textContent ?? 'Humane Games';
      if (titleEl) titleEl.textContent = name;
      overlay?.removeAttribute('hidden');
      document.body.style.overflow = 'hidden';
    });
  });

  const close = () => {
    overlay?.setAttribute('hidden', '');
    if (frame) frame.src = 'about:blank';
    document.body.style.overflow = '';
  };
  overlay?.querySelector('[data-humane-games-close]')?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay && !overlay.hidden) close();
  });
</script>
