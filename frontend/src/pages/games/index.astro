<style>
  /* CRT Scanline & Phosphor Sheen Simulation */
  .crt-effect {
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.35) 50%),
                linear-gradient(90deg, rgba(255, 0, 0, 0.04), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.04));
    background-size: 100% 3px, 4px 100%;
    box-shadow: inset 0 0 80px rgba(0, 0, 0, 0.85);
  }

  /* Active Quick-Switch Dock Button styling */
  .cabinet-dock-btn.dock-active {
    background: rgba(13, 148, 136, 0.25);
    border-color: rgba(45, 212, 191, 0.7);
    color: #5eead4;
    box-shadow: 0 0 16px rgba(20, 184, 166, 0.35);
  }

  /* Scrollbar hiding for horizontal touch track */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* Touch optimizations */
  button, input {
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
</style>

<script>
  // Synthesized Native Web Audio Engine (0 Network Overhead)
  class ArcadeSoundEngine {
    private ctx: AudioContext | null = null;
    public muted: boolean = false;

    constructor() {
      try {
        this.muted = localStorage.getItem('monroeArcadeMuted') === 'true';
      } catch (e) {
        this.muted = false;
      }
    }

    private getContext(): AudioContext | null {
      if (this.muted) return null;
      if (!this.ctx) {
        const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
        if (AudioCtx) {
          this.ctx = new AudioCtx();
        }
      }
      if (this.ctx && this.ctx.state === 'suspended') {
        this.ctx.resume().catch(() => {});
      }
      return this.ctx;
    }

    public playCoin() {
      const ctx = this.getContext();
      if (!ctx) return;
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'square';
      osc.frequency.setValueAtTime(987.77, now); // B5
      osc.frequency.setValueAtTime(1318.51, now + 0.08); // E6
      gain.gain.setValueAtTime(0.08, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now);
      osc.stop(now + 0.36);
    }

    public playBlip() {
      const ctx = this.getContext();
      if (!ctx) return;
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(440, now);
      osc.frequency.exponentialRampToValueAtTime(880, now + 0.07);
      gain.gain.setValueAtTime(0.1, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now);
      osc.stop(now + 0.09);
    }

    public playFanfare() {
      const ctx = this.getContext();
      if (!ctx) return;
      const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
      notes.forEach((freq, idx) => {
        const now = ctx.currentTime + idx * 0.09;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(freq, now);
        gain.gain.setValueAtTime(0.12, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.26);
      });
    }

    public toggleMute(): boolean {
      this.muted = !this.muted;
      try {
        localStorage.setItem('monroeArcadeMuted', String(this.muted));
      } catch (e) {}
      if (!this.muted) {
        this.playBlip();
      }
      return this.muted;
    }
  }

  function initHumaneArcade() {
    const root = document.querySelector<HTMLElement>('[data-monroe-humane-games-root]');
    if (!root) return;

    const audio = new ArcadeSoundEngine();

    const nameInput = document.getElementById('monroeDexUsername') as HTMLInputElement | null;
    const saveIndicator = document.getElementById('pass-saved-indicator');
    const toast = document.getElementById('arcade-pass-toast');
    const toastMsg = document.getElementById('arcade-pass-toast-msg');
    const packsCountEl = document.getElementById('stat-packs-count');
    const cardsCountEl = document.getElementById('stat-cards-count');
    const rankBadge = document.getElementById('pass-rank-badge');

    // Mascot Elements
    const mascotBtn = document.getElementById('btn-mascot-picker');
    const mascotIconEl = document.getElementById('pass-mascot-icon');
    const mascotPopover = document.getElementById('mascot-chooser-popover');
    const mascotDescPreview = document.getElementById('mascot-desc-preview');
    const mascotButtons = document.querySelectorAll<HTMLElement>('.mascot-select-btn');

    // Cabinet Modal Elements
    const cabinetModal = document.getElementById('game-cabinet-modal');
    const cabinetIframe = document.getElementById('cabinet-game-iframe') as HTMLIFrameElement | null;
    const cabinetTitle = document.getElementById('cabinet-game-title');
    const cabinetIcon = document.getElementById('cabinet-game-icon');
    const cabinetSpinner = document.getElementById('cabinet-loading-spinner');
    const closeBtn = document.getElementById('cabinet-close-btn');
    const fullscreenBtn = document.getElementById('cabinet-fullscreen-btn');
    const soundBtn = document.getElementById('cabinet-sound-btn');
    const soundIcon = document.getElementById('cabinet-sound-icon');
    const soundLabel = document.getElementById('cabinet-sound-label');
    const crtBtn = document.getElementById('cabinet-crt-btn');
    const crtOverlay = document.getElementById('cabinet-crt-overlay');
    const dockButtons = document.querySelectorAll<HTMLElement>('.cabinet-dock-btn');

    let currentGameId: string = 'booster';

    // ─────────────────────────────────────────────────────────────────────────
    // Player Pass State & Mascot Persistence
    // ─────────────────────────────────────────────────────────────────────────
    const STORAGE_USER_KEY = 'monroeDexUser';
    const STORAGE_PACKS_KEY = 'monroeDexPacks';
    const STORAGE_CARDS_KEY = 'monroeDexCards';
    const STORAGE_MASCOT_KEY = 'monroeArcadeMascot';
    const STORAGE_CRT_KEY = 'monroeArcadeCrt';

    const MASCOT_MAP: Record<string, { icon: string; name: string; desc: string }> = {
      smokey: { icon: '🐱', name: 'Smokey', desc: 'Curious Explorer' },
      barnaby: { icon: '🐕', name: 'Barnaby', desc: 'Playful Retriever' },
      marmalade: { icon: '🐾', name: 'Marmalade', desc: 'Ginger Tabby' },
      daisy: { icon: '🐶', name: 'Daisy', desc: 'Rescue Pup' },
      pip: { icon: '🐰', name: 'Pip', desc: 'Shelter Bunny' }
    };

    function getSavedUser(): string {
      try {
        let u = (localStorage.getItem(STORAGE_USER_KEY) || '').trim();
        if (!u) {
          u = 'Rescuer_' + Math.floor(1000 + Math.random() * 9000);
          localStorage.setItem(STORAGE_USER_KEY, u);
        }
        return u;
      } catch (e) {
        return 'guest';
      }
    }

    function getSavedPacks(): number {
      try {
        const val = localStorage.getItem(STORAGE_PACKS_KEY);
        return val ? Math.max(0, parseInt(val, 10)) : 1;
      } catch (e) {
        return 1;
      }
    }

    function getSavedCards(): number {
      try {
        const val = localStorage.getItem(STORAGE_CARDS_KEY);
        return val ? Math.max(0, parseInt(val, 10)) : 0;
      } catch (e) {
        return 0;
      }
    }

    function getSavedMascot(): string {
      try {
        return localStorage.getItem(STORAGE_MASCOT_KEY) || 'smokey';
      } catch (e) {
        return 'smokey';
      }
    }

    function getRankBadge(cards: number): string {
      if (cards >= 20) return 'Humane Hero 👑';
      if (cards >= 10) return 'Master Collector 💎';
      if (cards >= 5) return 'Companion Champion 🏆';
      if (cards >= 1) return 'Shelter Scout ⭐';
      return 'Novice Rescuer 🐾';
    }

    function triggerHaptic(ms = 15) {
      if ('vibrate' in navigator && typeof navigator.vibrate === 'function') {
        try {
          navigator.vibrate(ms);
        } catch (e) {}
      }
    }

    function updatePassDisplay() {
      const user = getSavedUser();
      if (nameInput && user && nameInput.value !== user) {
        nameInput.value = user;
      }

      const packs = getSavedPacks();
      const cards = getSavedCards();
      if (packsCountEl) packsCountEl.textContent = String(packs);
      if (cardsCountEl) cardsCountEl.textContent = String(cards);
      if (rankBadge) rankBadge.textContent = getRankBadge(cards);

      const mascotId = getSavedMascot();
      const mascot = MASCOT_MAP[mascotId] || MASCOT_MAP.smokey;
      if (mascotIconEl) mascotIconEl.textContent = mascot.icon;
    }

    function saveUser() {
      if (!nameInput) return;
      const raw = nameInput.value.trim().slice(0, 20);
      if (raw) {
        try {
          localStorage.setItem(STORAGE_USER_KEY, raw);
          if (saveIndicator) {
            saveIndicator.classList.remove('hidden');
            setTimeout(() => saveIndicator.classList.add('hidden'), 2000);
          }
          audio.playBlip();
        } catch (e) {
          console.warn('Failed saving nickname:', e);
        }
      }
    }

    nameInput?.addEventListener('change', saveUser);
    nameInput?.addEventListener('blur', saveUser);
    nameInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        saveUser();
        nameInput.blur();
      }
    });

    // Mascot Chooser Interactions
    mascotBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      audio.playBlip();
      triggerHaptic(12);
      if (mascotPopover) {
        mascotPopover.classList.toggle('hidden');
      }
    });

    mascotButtons.forEach((btn) => {
      btn.addEventListener('mouseenter', () => {
        const id = btn.getAttribute('data-mascot-id') || 'smokey';
        const m = MASCOT_MAP[id];
        if (m && mascotDescPreview) {
          mascotDescPreview.textContent = `${m.name}: ${m.desc}`;
        }
      });

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = btn.getAttribute('data-mascot-id') || 'smokey';
        try {
          localStorage.setItem(STORAGE_MASCOT_KEY, id);
        } catch (e) {}
        updatePassDisplay();
        audio.playCoin();
        triggerHaptic(20);
        if (mascotPopover) mascotPopover.classList.add('hidden');
      });
    });

    document.addEventListener('click', (e) => {
      if (mascotPopover && !mascotPopover.classList.contains('hidden')) {
        if (!mascotPopover.contains(e.target as Node) && e.target !== mascotBtn) {
          mascotPopover.classList.add('hidden');
        }
      }
    });

    // ─────────────────────────────────────────────────────────────────────────
    // Sound & CRT State Controls
    // ─────────────────────────────────────────────────────────────────────────
    function updateSoundUi() {
      if (!soundIcon || !soundLabel) return;
      if (audio.muted) {
        soundIcon.textContent = '🔇';
        soundLabel.textContent = 'Muted';
      } else {
        soundIcon.textContent = '🔊';
        soundLabel.textContent = 'Sound';
      }
    }

    soundBtn?.addEventListener('click', () => {
      const isMuted = audio.toggleMute();
      updateSoundUi();
      triggerHaptic(10);
      // Broadcast to active iframe
      if (cabinetIframe && cabinetIframe.contentWindow) {
        cabinetIframe.contentWindow.postMessage({ type: 'arcade:set_mute', muted: isMuted }, '*');
      }
    });

    let crtEnabled = false;
    try {
      crtEnabled = localStorage.getItem(STORAGE_CRT_KEY) === 'true';
    } catch (e) {}

    function updateCrtUi() {
      if (!crtOverlay || !crtBtn) return;
      if (crtEnabled) {
        crtOverlay.classList.remove('hidden');
        crtBtn.classList.add('bg-teal-700', 'text-white', 'border-teal-400');
      } else {
        crtOverlay.classList.add('hidden');
        crtBtn.classList.remove('bg-teal-700', 'text-white', 'border-teal-400');
      }
    }

    crtBtn?.addEventListener('click', () => {
      crtEnabled = !crtEnabled;
      try {
        localStorage.setItem(STORAGE_CRT_KEY, String(crtEnabled));
      } catch (e) {}
      audio.playBlip();
      triggerHaptic(10);
      updateCrtUi();
    });

    updateSoundUi();
    updateCrtUi();
    updatePassDisplay();

    // ─────────────────────────────────────────────────────────────────────────
    // Launching & Managing Cabinet Player 2.0
    // ─────────────────────────────────────────────────────────────────────────
    function updateDockActive(gameId: string) {
      currentGameId = gameId;
      dockButtons.forEach((btn) => {
        const id = btn.getAttribute('data-dock-game');
        if (id === gameId) {
          btn.classList.add('dock-active');
        } else {
          btn.classList.remove('dock-active');
        }
      });
    }

    function openCabinet(url: string, title: string, icon: string, gameId = 'game') {
      if (!cabinetModal || !cabinetIframe) return;

      audio.playCoin();
      triggerHaptic(20);

      const user = getSavedUser();
      const apiUrl = (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1')
        ? 'https://mchs-arcade-api.livelyfield-d0a70609.eastus.azurecontainerapps.io/arcade-api/v1/'
        : (window.location.origin + '/arcade-api/v1/');

      const separator = url.includes('?') ? '&' : '?';
      let finalUrl = `${url}${separator}embed=1&dex_api=${encodeURIComponent(apiUrl)}`;
      if (user) {
        finalUrl += `&user=${encodeURIComponent(user)}&dex_user=${encodeURIComponent(user)}`;
      }

      if (cabinetTitle) cabinetTitle.textContent = title;
      if (cabinetIcon) cabinetIcon.textContent = icon;
      if (cabinetSpinner) cabinetSpinner.classList.remove('hidden', 'opacity-0');

      updateDockActive(gameId);

      cabinetIframe.onload = () => {
        if (cabinetSpinner) {
          cabinetSpinner.classList.add('opacity-0');
          setTimeout(() => cabinetSpinner.classList.add('hidden'), 200);
        }
        // Send initial mute state to loaded game
        try {
          cabinetIframe?.contentWindow?.postMessage({ type: 'arcade:set_mute', muted: audio.muted }, '*');
        } catch (e) {}
      };

      cabinetIframe.src = finalUrl;
      cabinetModal.classList.remove('hidden');
      requestAnimationFrame(() => {
        cabinetModal.classList.remove('opacity-0');
      });
      document.body.style.overflow = 'hidden';
    }

    function closeCabinet() {
      if (!cabinetModal || !cabinetIframe) return;
      audio.playBlip();
      cabinetModal.classList.add('opacity-0');
      setTimeout(() => {
        cabinetModal.classList.add('hidden');
        cabinetIframe.src = 'about:blank'; // stop audio & animation loops
        document.body.style.overflow = '';
        updatePassDisplay();
      }, 200);
    }

    closeBtn?.addEventListener('click', closeCabinet);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && cabinetModal && !cabinetModal.classList.contains('hidden')) {
        closeCabinet();
      }
    });

    fullscreenBtn?.addEventListener('click', () => {
      audio.playBlip();
      if (!document.fullscreenElement) {
        cabinetModal?.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    });

    // Bottom Quick-Switch Dock item switching
    dockButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const url = btn.getAttribute('data-dock-url');
        const title = btn.getAttribute('data-dock-title');
        const icon = btn.getAttribute('data-dock-icon');
        const gameId = btn.getAttribute('data-dock-game') || 'game';

        if (url && title && icon) {
          audio.playBlip();
          triggerHaptic(15);
          openCabinet(url, title, icon, gameId);
        }
      });
    });

    // ─────────────────────────────────────────────────────────────────────────
    // Card Triggers & Quick Album Views
    // ─────────────────────────────────────────────────────────────────────────
    root.querySelectorAll<HTMLElement>('[data-launch-game]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const url = btn.getAttribute('data-game-url') || '';
        const title = btn.getAttribute('data-game-title') || 'Humane Game';
        const icon = btn.getAttribute('data-game-icon') || '🎮';
        const id = btn.getAttribute('data-launch-game') || 'game';
        if (url) openCabinet(url, title, icon, id);
      });
    });

    const openAlbum = () => {
      openCabinet('/games/dex/album.html?embed=1', 'Pet Discovery Album', '📖', 'dex');
    };

    document.getElementById('btn-view-album')?.addEventListener('click', openAlbum);
    document.getElementById('btn-booster-album-link')?.addEventListener('click', openAlbum);

    // ─────────────────────────────────────────────────────────────────────────
    // Cross-Frame Message Bridge (Pack Awards, Unlocks & Scores)
    // ─────────────────────────────────────────────────────────────────────────
    window.addEventListener('message', (event) => {
      const data = event.data;
      if (!data || typeof data !== 'object') return;

      // When a game awards a booster pack (e.g. Pet Match level milestones)
      if (data.type === 'adoptedex:pack_awarded' || data.action === 'pack_awarded') {
        const current = getSavedPacks();
        const next = current + 1;
        try {
          localStorage.setItem(STORAGE_PACKS_KEY, String(next));
        } catch (e) {}
        updatePassDisplay();
        audio.playFanfare();
        triggerHaptic(40);

        // Show Celebration Toast
        const awardToast = document.getElementById('milestone-award-toast');
        const awardTitle = document.getElementById('milestone-award-title');
        const awardText = document.getElementById('milestone-award-text');
        const awardIcon = document.getElementById('milestone-award-icon');
        if (awardToast && awardText && awardTitle && awardIcon) {
          awardIcon.textContent = '🎁';
          awardTitle.textContent = 'Milestone Unlocked!';
          awardText.textContent = '+1 Pet Booster Pack added to your Arcade Pass!';
          awardToast.classList.remove('hidden');
          setTimeout(() => awardToast.classList.add('hidden'), 4500);
        }
      }

      // When Pet Booster opens a pack, decrement the live pack counter
      if (data.type === 'adoptedex:pack_opened' || data.action === 'pack_opened') {
        const next = typeof data.remainingPacks === 'number'
          ? Math.max(0, data.remainingPacks)
          : Math.max(0, getSavedPacks() - 1);
        try {
          localStorage.setItem(STORAGE_PACKS_KEY, String(next));
        } catch (e) {}
        updatePassDisplay();
        triggerHaptic(15);
      }

      // When Pet Booster reveals a newly discovered card
      if (data.type === 'adoptedex:pet_discovered' || data.action === 'pet_discovered') {
        const current = getSavedCards();
        const added = Array.isArray(data.petIds) && data.petIds.length ? data.petIds.length : 1;
        const next = current + added;
        try {
          localStorage.setItem(STORAGE_CARDS_KEY, String(next));
        } catch (e) {}
        updatePassDisplay();
        audio.playCoin();
        triggerHaptic(25);
      }

      // When any game reports a high score (Flappy Cat, Catwalk, Shelter Run, Match)
      if (data.type === 'arcade:score_recorded') {
        const score = Number(data.score) || 0;
        const game = data.game || data.gameId || 'Game';
        audio.playCoin();
        triggerHaptic(30);

        const awardToast = document.getElementById('milestone-award-toast');
        const awardTitle = document.getElementById('milestone-award-title');
        const awardText = document.getElementById('milestone-award-text');
        const awardIcon = document.getElementById('milestone-award-icon');
        if (awardToast && awardText && awardTitle && awardIcon) {
          awardIcon.textContent = '🏆';
          awardTitle.textContent = 'Score Recorded!';
          awardText.textContent = `${score.toLocaleString()} pts recorded to the Community Leaderboard!`;
          awardToast.classList.remove('hidden');
          setTimeout(() => awardToast.classList.add('hidden'), 4000);
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHumaneArcade);
  } else {
    initHumaneArcade();
  }
  document.addEventListener('astro:page-load', initHumaneArcade);
</script>
