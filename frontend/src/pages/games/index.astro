---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArcadeLeaderboardModal from '../../components/games/ArcadeLeaderboardModal.astro';

interface GameItem {
  id: string;
  title: string;
  badge: string;
  desc: string;
  action: string;
  icon: string;
  url: string;
  leaderboardId?: string;
  needsDex: boolean;
  perks: string[];
  gradientBg: string;
  glowBorder: string;
  accentText: string;
}


/** Legacy / experimental HTML games kept for deep links; not in primary cabinet. */
const LEGACY_GAMES: { title: string; href: string; note: string }[] = [
  { title: 'Pet Snake', href: '/games/petsnake.html', note: 'Classic arcade (legacy)' },
  { title: 'Pet Snake Adventure', href: '/games/petsnakerouguelike.html', note: 'Roguelike (legacy)' },
  { title: 'Shelter Tycoon', href: '/games/shelter-tycoon/index.html', note: 'Management sim (legacy)' },
];

const GAMES: GameItem[] = [
  {
    id: 'booster',
    title: 'Pet Booster Packs',
    badge: '✨ Collectible Cards',
    desc: 'Rip open shiny foil packs to collect adorable cards of real shelter pets! Find rare holographic cards and build your ultimate pet album.',
    action: 'Open Booster Packs',
    icon: '✨',
    url: '/games/booster/index.html?embed=1',
    needsDex: true,
    perks: ['🧩 Match & Win Packs', '🐾🐾✨ Holographic Rares'],
    gradientBg: 'from-amber-500 via-orange-500 to-rose-600',
    glowBorder: 'hover:border-amber-400/80 hover:shadow-[0_12px_40px_-8px_rgba(245,158,11,0.45)]',
    accentText: 'text-amber-300'
  },
  {
    id: 'match',
    title: 'Pet Match Memory',
    badge: '🧩 Match & Earn Packs',
    desc: 'Flip cards to find pairs of adoptable dogs and cats! Match companions and beat levels to earn free Pet Booster Packs.',
    action: 'Play Pet Match',
    icon: '🧩',
    url: '/games/match/match.html?embed=1',
    leaderboardId: 'match',
    needsDex: true,
    perks: ['🎁 Free Pack on Milestones', '🐾 Real Shelter Profiles'],
    gradientBg: 'from-teal-600 via-emerald-600 to-cyan-700',
    glowBorder: 'hover:border-emerald-400/80 hover:shadow-[0_12px_40px_-8px_rgba(16,185,129,0.45)]',
    accentText: 'text-emerald-300'
  },
  {
    id: 'flappy',
    title: 'Flappy Cat',
    badge: '🐱 Tap to Fly ✦',
    desc: 'Tap to fly! Flap your paws and guide a brave shelter cat home through floating yarn balls, scratching posts, and flying fish treats.',
    action: 'Play Flappy Cat',
    icon: '🐱',
    url: '/games/flappy-cat/game/index.html?embed=1',
    leaderboardId: 'flappy_cat',
    needsDex: false,
    perks: ['🏆 Endless High Scores', '🐟 Collect Fish Treats'],
    gradientBg: 'from-sky-600 via-indigo-600 to-purple-700',
    glowBorder: 'hover:border-sky-400/80 hover:shadow-[0_12px_40px_-8px_rgba(56,189,248,0.45)]',
    accentText: 'text-sky-300'
  },
  {
    id: 'catwalk',
    title: 'Catwalk Night Patrol',
    badge: '🌙 Vector Arcade ✦',
    desc: 'Guide a vector shelter cat home through midnight streets! Dodge oncoming traffic, hop across fishbone rivers, and rescue all nine lives.',
    action: 'Play Catwalk',
    icon: '🐾',
    url: '/games/catwalk?embed=1',
    leaderboardId: 'catwalk',
    needsDex: false,
    perks: ['🎮 Vector CRT Lines', '📱 Mobile Touch D-Pad'],
    gradientBg: 'from-emerald-600 via-teal-700 to-green-800',
    glowBorder: 'hover:border-emerald-400/80 hover:shadow-[0_12px_40px_-8px_rgba(16,185,129,0.45)]',
    accentText: 'text-emerald-300'
  },
  {
    id: 'shelter_run',
    title: 'Shelter Run',
    badge: '🏃 Endless Runner',
    desc: 'Sprint through Monroe County trails! Jump over obstacles, slide under branches, and rescue runaway pets along your journey.',
    action: 'Play Shelter Run',
    icon: '🏃',
    url: '/games/shelter-run/index.html?embed=1',
    leaderboardId: 'shelter_run',
    needsDex: true,
    perks: ['🏆 Distance Milestones', '🐾 Rescue Pets On-the-Run'],
    gradientBg: 'from-violet-600 via-purple-700 to-indigo-800',
    glowBorder: 'hover:border-purple-400/80 hover:shadow-[0_12px_40px_-8px_rgba(168,85,247,0.45)]',
    accentText: 'text-purple-300'
  }
];

const MASCOTS = [
  { id: 'smokey', icon: '🐱', name: 'Smokey', desc: 'Curious Explorer' },
  { id: 'barnaby', icon: '🐕', name: 'Barnaby', desc: 'Playful Retriever' },
  { id: 'marmalade', icon: '🐾', name: 'Marmalade', desc: 'Ginger Tabby' },
  { id: 'daisy', icon: '🐶', name: 'Daisy', desc: 'Rescue Pup' },
  { id: 'pip', icon: '🐰', name: 'Pip', desc: 'Shelter Bunny' }
];
---

<BaseLayout
  title="Humane Games & Pet Booster Packs | Humane Society of Monroe County"
  description="Play free browser games featuring real adoptable pets. Rip open shiny foil booster packs, play memory match, and tap to fly with Flappy Cat."
  bodyClass="monroe-inner-page"
>
  <main class="min-h-screen pb-24 bg-[#faf8f5] dark:bg-[#071a17]" data-monroe-humane-games-root>

    <!-- ══════════════════════════════════════════════════════════
         Compact Hero + Arcade Pass — dual-column, light-theme
    ══════════════════════════════════════════════════════════ -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-5 sm:pt-7 pb-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-stretch">

        <!-- ── Left: Brand Hero Card ────────────────────────────── -->
        <div class="lg:col-span-6 bg-gradient-to-br from-[#133c39] via-[#1a4f4b] to-[#0f2e2c] text-white rounded-3xl p-5 sm:p-7 border border-teal-700/50 shadow-lg flex flex-col justify-between relative overflow-hidden">
          <!-- Subtle atmospheric glow -->
          <div class="absolute top-0 right-0 w-48 h-48 bg-amber-400/10 blur-[80px] rounded-full pointer-events-none"></div>

          <div class="relative z-10">
            <!-- Badge -->
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/20 text-xs font-bold uppercase tracking-wider mb-4">
              <span class="text-amber-300">🎮 Humane Arcade</span>
              <span class="opacity-50">·</span>
              <span class="text-teal-200 font-normal">Monroe County Humane Society</span>
            </div>

            <h1 class="text-2xl sm:text-3xl font-serif font-black tracking-tight mb-2.5 leading-tight">
              Small games for big hearts.
            </h1>
            <p class="text-sm text-teal-100/80 leading-relaxed">
              Play free browser games featuring real adoptable pets. Rip open foil booster packs, build your pet album, and discover companions waiting for loving homes.
            </p>
          </div>
        </div>

        <!-- ── Right: Arcade Pass Card ──────────────────────────── -->
        <div class="lg:col-span-6 bg-white dark:bg-[#0b2823] rounded-3xl border border-stone-200 dark:border-teal-700/60 shadow-sm flex flex-col justify-between overflow-visible">
          <!-- Pass Header -->
          <div class="p-4 sm:p-5 border-b border-stone-100 dark:border-teal-800/60">
            <div class="flex items-start gap-3">
              <!-- Mascot Avatar Picker Button -->
              <div class="relative shrink-0">
                <button
                  type="button"
                  id="btn-mascot-picker"
                  class="w-10 h-10 rounded-xl bg-stone-100 dark:bg-[#061e1b] border-2 border-stone-200 dark:border-teal-600/80 hover:border-amber-400 flex items-center justify-center text-xl shadow-inner transition hover:scale-105 cursor-pointer"
                  title="Choose your Mascot Companion"
                  aria-label="Change Mascot Companion"
                >
                  <span id="pass-mascot-icon">🐱</span>
                  <span class="absolute -bottom-1 -right-1 w-3.5 h-3.5 rounded-full bg-amber-500 text-[9px] text-slate-950 font-bold flex items-center justify-center shadow-xs">✎</span>
                </button>

                <!-- Mascot Chooser Popover -->
                <div
                  id="mascot-chooser-popover"
                  class="hidden absolute top-12 left-0 z-50 bg-white dark:bg-[#061e1a] border border-stone-200 dark:border-teal-700/80 p-3 rounded-2xl shadow-xl w-60 animate-in fade-in zoom-in-95 duration-150"
                >
                  <div class="text-[10px] font-bold uppercase tracking-wider text-teal-700 dark:text-teal-300 mb-2">Choose Companion</div>
                  <div class="grid grid-cols-5 gap-1.5 mb-2">
                    {MASCOTS.map((m) => (
                      <button
                        type="button"
                        data-mascot-id={m.id}
                        data-mascot-icon={m.icon}
                        class="mascot-select-btn w-9 h-9 rounded-xl bg-stone-50 dark:bg-[#082823] hover:bg-teal-50 dark:hover:bg-teal-700/60 border border-stone-200 dark:border-teal-800 hover:border-amber-400 flex items-center justify-center text-lg transition cursor-pointer"
                        title={`${m.name} (${m.desc})`}
                      >
                        {m.icon}
                      </button>
                    ))}
                  </div>
                  <div id="mascot-desc-preview" class="text-[11px] text-slate-500 dark:text-slate-300 font-medium text-center">Smokey: Curious Explorer</div>
                </div>
              </div>

              <!-- Title + Rank -->
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-1.5 flex-wrap">
                  <h2 class="text-sm font-bold text-slate-900 dark:text-white tracking-tight">Your Arcade Pass</h2>
                  <span id="pass-rank-badge" class="px-2 py-0.5 rounded-full bg-teal-50 dark:bg-teal-950/90 border border-teal-200 dark:border-teal-700/70 text-[10px] font-bold text-teal-700 dark:text-amber-300 tracking-wide">
                    Novice Rescuer 🐾
                  </span>
                </div>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 leading-snug">Saves your packs, cards &amp; mascot across games.</p>
              </div>

              <!-- Quick Actions -->
              <div class="flex items-center gap-1.5 shrink-0">
                <button
                  type="button"
                  id="btn-open-leaderboard"
                  data-open-leaderboard
                  class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-amber-50 dark:bg-amber-500/20 hover:bg-amber-100 dark:hover:bg-amber-500/30 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-500/40 text-[11px] font-bold transition cursor-pointer"
                  title="View Arcade High Scores"
                >
                  🏆 Scores
                </button>
                <button
                  type="button"
                  id="btn-view-album"
                  class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-teal-50 dark:bg-teal-800/70 hover:bg-teal-100 dark:hover:bg-teal-700 text-teal-700 dark:text-teal-100 border border-teal-200 dark:border-teal-600/60 text-[11px] font-semibold transition cursor-pointer"
                >
                  📖 Album →
                </button>
              </div>
            </div>
          </div>

          <!-- Nickname + Stats -->
          <div class="p-4 sm:p-5 flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
            <div class="relative flex-1">
              <label for="monroeDexUsername" class="sr-only">Player Nickname</label>
              <input
                type="text"
                id="monroeDexUsername"
                maxlength="20"
                placeholder="Choose nickname (e.g. PetLover42)"
                class="w-full bg-stone-50 dark:bg-[#051a17] border border-stone-200 dark:border-teal-800/80 rounded-xl px-3 py-2 text-xs text-slate-800 dark:text-white placeholder-slate-400 focus:outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500/40 transition font-medium"
              />
              <span id="pass-saved-indicator" class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-[10px] font-bold text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/80 px-1.5 py-0.5 rounded-md border border-emerald-200 dark:border-emerald-800">
                SAVED ✓
              </span>
            </div>

            <!-- Stat Pills -->
            <div class="flex items-center gap-1.5 text-xs shrink-0">
              <div class="px-3 py-1.5 rounded-xl bg-stone-50 dark:bg-[#061e1b] border border-stone-200 dark:border-teal-800/70 text-slate-700 dark:text-slate-200 text-center">
                <span class="text-[9px] text-slate-500 dark:text-slate-400 uppercase tracking-wider block font-semibold">Packs</span>
                <span id="stat-packs-count" class="font-mono font-bold text-amber-600 dark:text-amber-300 text-sm">1</span>
              </div>
              <button
                type="button"
                id="stat-cards-box"
                class="px-3 py-1.5 rounded-xl bg-stone-50 dark:bg-[#061e1b] hover:bg-teal-50 dark:hover:bg-[#082a25] border border-stone-200 dark:border-teal-800/70 hover:border-teal-400 dark:hover:border-teal-500/80 text-slate-700 dark:text-slate-200 transition cursor-pointer text-center"
                title="View Pet Discovery Binder"
              >
                <span class="text-[9px] text-slate-500 dark:text-slate-400 uppercase tracking-wider block font-semibold">Cards</span>
                <span id="stat-cards-count" class="font-mono font-bold text-teal-600 dark:text-emerald-300 text-sm">0</span>
              </button>
            </div>
          </div>

          <div id="arcade-pass-toast" class="hidden px-4 pb-3 text-xs text-emerald-600 dark:text-emerald-400 font-semibold flex items-center gap-1.5" role="status">
            <span>✨</span>
            <span id="arcade-pass-toast-msg">Player pass updated!</span>
          </div>
        </div>

      </div>
    </div>
    <!-- ════════════════════════════════════════════════════════ -->

    <!-- The 5 Flagship Game Cards Section -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-2">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
        {GAMES.map((game) => (
          <div class={`group relative rounded-3xl p-6 sm:p-7 flex flex-col bg-white dark:bg-gradient-to-b dark:from-[#0b2823] dark:to-[#071d1a] border border-stone-200/90 dark:border-teal-800/80 shadow-sm hover:shadow-xl transition-all duration-300 ${game.glowBorder} justify-between`}>
            
            <!-- Glow sheen backdrop -->
            <div class={`absolute top-0 right-0 w-44 h-44 bg-gradient-to-br ${game.gradientBg} opacity-15 blur-[60px] rounded-full pointer-events-none group-hover:opacity-25 transition-opacity`}></div>

            <div>
              <!-- Top Row: Icon Box & Badge -->
              <div class="flex items-center justify-between gap-2 mb-5">
                <div class="w-14 h-14 rounded-2xl bg-stone-50 dark:bg-[#061e1a] border border-stone-200 dark:border-teal-700/60 flex items-center justify-center text-3xl shadow-inner group-hover:scale-105 transition-transform">
                  {game.icon}
                </div>
                
                <div class="flex items-center gap-1.5">
                  {game.leaderboardId && (
                    <button
                      type="button"
                      data-open-leaderboard
                      data-leaderboard-game={game.leaderboardId}
                      class="px-2 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-50 dark:bg-amber-950/60 border border-amber-300 dark:border-amber-600/40 text-amber-700 dark:text-amber-300 hover:bg-amber-100 dark:hover:bg-amber-900/60 transition cursor-pointer"
                      title="View High Scores"
                    >
                      🏆 High Scores
                    </button>
                  )}
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold tracking-wider uppercase bg-teal-50 dark:bg-teal-950/80 border border-teal-200 dark:border-teal-700/60 text-teal-700 dark:text-slate-200">
                    {game.badge}
                  </span>
                </div>
              </div>

              <!-- Title & Description -->
              <h3 class="text-2xl font-serif font-black text-slate-900 dark:text-white tracking-tight mb-2.5">
                {game.title}
              </h3>
              <p class="text-slate-600 dark:text-slate-300 text-xs sm:text-sm leading-relaxed mb-6 font-normal">
                {game.desc}
              </p>

              <!-- Micro Perks / Highlights -->
              <div class="space-y-1.5 mb-8">
                {game.perks.map((perk) => (
                  <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-stone-50 dark:bg-[#041512] border border-stone-200 dark:border-teal-900/80 text-[11px] font-medium text-slate-600 dark:text-slate-300 mr-1.5 mb-1">
                    <span>{perk}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Primary Action Button -->
            <div class="pt-4 border-t border-stone-100 dark:border-teal-900/60 mt-auto space-y-2">
              <button
                type="button"
                data-launch-game={game.id}
                data-game-url={game.url}
                data-game-title={game.title}
                data-game-icon={game.icon}
                class={`w-full py-3.5 px-5 rounded-2xl font-bold text-xs uppercase tracking-wider text-white bg-gradient-to-r ${game.gradientBg} hover:opacity-95 transition-all shadow-md flex items-center justify-between group-hover:shadow-lg cursor-pointer active:scale-[0.98]`}
              >
                <span>{game.action}</span>
                <span class="text-lg leading-none transition-transform group-hover:translate-x-1">&rarr;</span>
              </button>

              {game.id === 'booster' && (
                <button
                  type="button"
                  id="btn-booster-album-link"
                  class="w-full py-1.5 text-center text-[11px] font-semibold text-amber-300 hover:text-amber-200 transition cursor-pointer flex items-center justify-center gap-1"
                >
                  <span>🎴 View Pet Album &amp; Rare Cards</span>
                  <span>↗</span>
                </button>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Real Pets Impact & Conversion Section -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 mt-14 sm:mt-20 text-center">
      <div class="p-8 sm:p-10 rounded-3xl bg-white dark:bg-[#0b2420]/80 border border-stone-200 dark:border-teal-800/70 shadow-sm relative overflow-hidden">
        <div class="w-12 h-12 rounded-2xl bg-teal-50 dark:bg-teal-900/80 text-teal-600 dark:text-teal-300 border border-teal-200 dark:border-teal-700 flex items-center justify-center text-2xl mx-auto mb-4">
          🐾
        </div>
        <h2 class="text-2xl sm:text-4xl font-serif font-black text-slate-900 dark:text-white mb-3 tracking-tight">
          Every card is a real shelter pet waiting for love.
        </h2>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 max-w-xl mx-auto leading-relaxed mb-8">
          The dogs and cats featured on cards in Pet Booster Packs and Pet Match Memory are real animals in our care at Monroe County Humane Society. Ready to meet them in person?
        </p>

        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href="/adopt/"
            class="px-6 py-3 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold uppercase tracking-wider text-xs transition-all shadow-md hover:-translate-y-0.5"
          >
            Meet Adoptable Pets
          </a>
          <a
            href="/volunteer-form/"
            class="px-6 py-3 rounded-full bg-teal-900 hover:bg-teal-800 text-white font-bold uppercase tracking-wider text-xs transition-all shadow-md hover:-translate-y-0.5"
          >
            Volunteer at Shelter
          </a>
          <a
            href="/donate/"
            class="px-6 py-3 rounded-full border border-teal-600 text-teal-700 dark:text-teal-200 hover:bg-teal-50 dark:hover:bg-teal-900/50 font-bold uppercase tracking-wider text-xs transition-all"
          >
            Support Pet Care
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Fullscreen Arcade Cabinet Modal Player 2.0 -->
  <div
    id="game-cabinet-modal"
    class="fixed inset-0 z-[9999] bg-slate-950/98 backdrop-blur-md flex flex-col hidden opacity-0 transition-opacity duration-200 select-none"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cabinet-game-title"
  >
    <!-- Cabinet Top Header Chrome -->
    <header class="min-h-14 h-14 pt-[env(safe-area-inset-top,0px)] px-3 sm:px-6 bg-[#061815] border-b border-teal-800/80 flex items-center justify-between shrink-0 select-none z-30">
      <div class="flex items-center gap-2.5">
        <span id="cabinet-game-icon" class="text-2xl">🎮</span>
        <div>
          <h3 id="cabinet-game-title" class="text-sm font-bold text-white tracking-wide leading-tight">
            Humane Arcade
          </h3>
          <span class="text-[10px] text-teal-400 block font-mono">Monroe County Humane Society</span>
        </div>
      </div>

      <div class="flex items-center gap-1.5 sm:gap-2">
        <!-- Sound Mute Toggle -->
        <button
          type="button"
          id="cabinet-sound-btn"
          class="min-h-11 min-w-11 px-2.5 py-1.5 rounded-lg bg-teal-950 hover:bg-teal-900 text-slate-300 hover:text-white border border-teal-800 text-xs font-semibold transition cursor-pointer flex items-center justify-center gap-1 touch-manipulation"
          title="Toggle Game Sound"
        >
          <span id="cabinet-sound-icon">🔊</span>
          <span class="hidden sm:inline" id="cabinet-sound-label">Sound</span>
        </button>

        <!-- CRT Scanline Filter Toggle -->
        <button
          type="button"
          id="cabinet-crt-btn"
          class="min-h-11 min-w-11 px-2.5 py-1.5 rounded-lg bg-teal-950 hover:bg-teal-900 text-slate-300 hover:text-white border border-teal-800 text-xs font-semibold transition cursor-pointer flex items-center justify-center gap-1 touch-manipulation"
          title="Toggle Retro CRT Scanlines"
        >
          <span>📺</span>
          <span class="hidden sm:inline">CRT</span>
        </button>

        <!-- Fullscreen Button -->
        <button
          type="button"
          id="cabinet-fullscreen-btn"
          class="min-h-11 px-2.5 py-1.5 rounded-lg bg-teal-950 hover:bg-teal-900 text-slate-300 hover:text-white border border-teal-800 text-xs font-semibold transition cursor-pointer hidden sm:inline-flex items-center gap-1.5 touch-manipulation"
          title="Toggle Fullscreen"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
          <span>Fullscreen</span>
        </button>

        <!-- Close Cabinet Button -->
        <button
          type="button"
          id="cabinet-close-btn"
          class="min-h-11 min-w-11 px-3 py-1.5 rounded-lg bg-rose-950/80 hover:bg-rose-900 text-rose-200 hover:text-white border border-rose-800/80 text-xs font-bold transition cursor-pointer flex items-center justify-center gap-1 active:scale-95 touch-manipulation"
          title="Exit Cabinet"
        >
          <span>Close</span>
          <span class="text-sm font-black">&times;</span>
        </button>
      </div>
    </header>

    <!-- Cabinet Screen Frame (contains Iframe & CRT overlay) -->
    <div class="flex-1 w-full h-full relative bg-black flex items-center justify-center overflow-hidden">
      <!-- Loading Spinner -->
