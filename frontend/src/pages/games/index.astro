            aria-label="Play Pet Snake Adventure"
          >
            <span class="w-16 h-16 bg-teal-50 rounded-2xl flex items-center justify-center text-3xl mb-6" aria-hidden="true">
              <span>?????</span>
            </span>
            <span class="flex-col flex mb-4">
              <span class="text-2xl font-bold text-teal-900 mb-2 group-hover:text-emerald-700 transition-colors">Pet Snake Adventure</span>
              <span class="text-gray-600 leading-relaxed">A 15-floor roguelike journey with upgrades, affixes, and a vacuum boss.</span>
            </span>
            <span class="mt-auto mb-4">
              <span class="inline-block px-3 py-1 bg-gray-100 text-gray-600 text-xs font-bold uppercase tracking-wider rounded-full">Play anytime</span>
            </span>
            <span class="text-emerald-600 font-bold uppercase tracking-widest text-sm" aria-hidden="true">Play &gt;</span>
          </button>
        </li>

        <li>
          <button
            type="button"
            class="group w-full h-full flex flex-col bg-white border border-gray-200 rounded-3xl p-8 text-left shadow-sm hover:shadow-md transition-all hover:-translate-y-1"
