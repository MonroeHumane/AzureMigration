---
const embedded = Astro.url.searchParams.get('embed') === '1';
---

<!doctype html>
<html lang="en-US" class:list={{ 'is-embedded': embedded }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
    <meta name="theme-color" content="#040b08" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="description" content="Guide a vector cat through the night patrol into five safe homes." />
    <title>Catwalk | Humane Games</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Share+Tech+Mono&display=swap" rel="stylesheet" />
    <script is:inline src="/games/dex/dex-shared.js?v=6"></script>
  </head>
  <body>
    <h1 class="catwalk-page-title">Catwalk — Humane Games</h1>
    <!-- Single unified viewport-fitting arcade cabinet window -->
    <main class="catwalk-cabinet" data-catwalk-root>
      <div class="catwalk-bezel">
        <canvas width="720" height="864" data-game-canvas tabindex="0" aria-label="Catwalk Night Patrol playfield"></canvas>

        <!-- In-game vector overlay modal -->
        <div class="catwalk__overlay" data-overlay>
          <div class="catwalk__overlay-card">
            <p class="catwalk__overlay-badge">Nine lives online</p>
            <h2 data-overlay-title>Get the cats home</h2>
            <p data-overlay-copy>Dodge the dogs. Ride the fishbones. Fill all five cat houses.</p>
            <div class="catwalk__overlay-actions">
              <button type="button" class="btn-primary" data-start>Start patrol</button>
            </div>
            <p class="catwalk__overlay-hint catwalk__overlay-hint--desktop">
              <kbd>WASD</kbd> / <kbd>←↑↓→</kbd> move · <kbd>Space</kbd> / <kbd>P</kbd> pause · click HUD icons for sound
            </p>
            <p class="catwalk__overlay-hint catwalk__overlay-hint--mobile">
              Use the D-pad or swipe the board · Pause / mute buttons below · Tap Start to patrol
            </p>
          </div>
        </div>

        <!-- Mobile HUD: pause + mute (canvas icons are small on phones) -->
        <div class="catwalk__touch-hud" aria-label="Game controls">
          <button type="button" data-touch-mute aria-label="Toggle sound">♪</button>
          <button type="button" data-touch-pause aria-label="Pause or resume">❚❚</button>
        </div>

        <!-- Touch/mobile d-pad controls embedded smoothly into bottom of bezel if on mobile -->
        <nav class="catwalk__touch-dpad" aria-label="Movement controls">
          <button type="button" data-move="up" aria-label="Move up">▲</button>
          <div class="dpad-row">
            <button type="button" data-move="left" aria-label="Move left">◀</button>
            <button type="button" data-move="down" aria-label="Move down">▼</button>
            <button type="button" data-move="right" aria-label="Move right">▶</button>
          </div>
        </nav>
      </div>
    </main>

    <script>
      import '../../games/catwalk/main';

      const dpad = document.querySelector<HTMLElement>('.catwalk__touch-dpad');
      const touchHud = document.querySelector<HTMLElement>('.catwalk__touch-hud');
      const syncTouchChrome = () => {
        const embedded = document.documentElement.classList.contains('is-embedded');
        const coarse = window.matchMedia('(pointer: coarse)').matches;
        const noHover = window.matchMedia('(hover: none)').matches;
        const narrow = window.matchMedia('(max-width: 900px)').matches;
        const show = (noHover && coarse) || (embedded && (coarse || narrow));
        if (dpad) dpad.style.display = show ? 'flex' : '';
        if (touchHud) touchHud.style.display = show ? 'flex' : '';
        document.documentElement.classList.toggle('catwalk-touch', show);
      };
      syncTouchChrome();
      window.addEventListener('resize', syncTouchChrome);
      window.matchMedia('(pointer: coarse)').addEventListener?.('change', syncTouchChrome);
      window.matchMedia('(orientation: landscape)').addEventListener?.('change', syncTouchChrome);

      // Reduce double-tap zoom annoyances in the cabinet iframe.
      ['gesturestart', 'gesturechange', 'gestureend'].forEach((type) => {
        document.addEventListener(type, (e) => e.preventDefault(), { passive: false });
      });
      let lastTouchEnd = 0;
      document.addEventListener(
        'touchend',
        (e) => {
          const now = Date.now();
          if (now - lastTouchEnd <= 300) e.preventDefault();
          lastTouchEnd = now;
        },
        { passive: false }
      );
    </script>
  </body>
</html>

<style>
  .catwalk-page-title {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  :global(*) { box-sizing: border-box; margin: 0; padding: 0; }
  :global(html) {
    color: #dfffe9;
    background: #040b08;
    font-family: 'Share Tech Mono', Consolas, monospace;
    height: 100%;
    overflow: hidden;
    touch-action: manipulation;
    -webkit-text-size-adjust: 100%;
  }
  :global(body) {
    height: 100%;
    margin: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(ellipse at center, #091a13 0%, #040b08 75%, #010403 100%);
    overscroll-behavior: none;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* Single self-contained arcade window */
  .catwalk-cabinet {
    position: relative;
    width: 100%;
    height: 100dvh;
    max-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding:
      max(4px, env(safe-area-inset-top, 0px))
      max(4px, env(safe-area-inset-right, 0px))
      max(4px, env(safe-area-inset-bottom, 0px))
      max(4px, env(safe-area-inset-left, 0px));
  }

  .catwalk-bezel {
    position: relative;
    height: 100%;
    max-height: calc(100dvh - 16px);
    max-width: 100%;
    aspect-ratio: 720 / 864;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 2px solid #1a3c2c;
    border-radius: 8px;
    background: #040b08;
    box-shadow:
      0 0 0 1px #0d2218,
      0 0 35px rgba(77, 250, 139, 0.12),
      0 12px 40px rgba(0, 0, 0, 0.85);
    overflow: hidden;
  }

  /* CRT glass curvature and scanline overlay */
  .catwalk-bezel::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
    border-radius: 6px;
    box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.65);
    background: radial-gradient(circle at 50% 20%, rgba(255, 255, 255, 0.03) 0%, transparent 60%);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    aspect-ratio: 720 / 864;
    cursor: default;
    touch-action: none;
  }

  /* Integrated In-Game Overlay */
  .catwalk__overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: grid;
    place-content: center;
    justify-items: center;
    padding: max(16px, env(safe-area-inset-top, 0px)) 20px max(16px, env(safe-area-inset-bottom, 0px));
    text-align: center;
    background: rgba(4, 11, 8, 0.88);
    backdrop-filter: blur(6px);
  }

  .catwalk__overlay[hidden] {
    display: none !important;
  }

  .catwalk__overlay-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: min(440px, 100%);
    border: 1px solid #1a3c2c;
    border-radius: 6px;
    padding: clamp(18px, 4vh, 32px) clamp(16px, 4vw, 28px);
    background: rgba(9, 26, 19, 0.94);
    box-shadow: 0 0 40px rgba(77, 250, 139, 0.15);
  }

  .catwalk__overlay-badge {
    color: #22a058;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .catwalk__overlay h2 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(32px, 6vw, 56px);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: 0.04em;
    color: #dfffe9;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .catwalk__overlay p {
    color: #81b59b;
    font-size: 13px;
    line-height: 1.45;
    margin-bottom: 20px;
  }

  .catwalk__overlay-hint {
    color: #476b58 !important;
    font-size: 11px !important;
    margin-top: 18px !important;
    margin-bottom: 0 !important;
    letter-spacing: 0.05em;
    line-height: 1.5 !important;
  }

  .catwalk__overlay-hint kbd {
    display: inline-block;
    font: 700 10px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    padding: 2px 5px;
    margin: 0 1px;
    border-radius: 4px;
    border: 1px solid #1a3c2c;
    background: #0d2218;
    color: #4dfa8b;
  }

  .catwalk__overlay-hint--mobile { display: none; }
  .catwalk__overlay-hint--desktop { display: block; }

  @media (hover: none) and (pointer: coarse) {
    .catwalk__overlay-hint--desktop { display: none; }
    .catwalk__overlay-hint--mobile { display: block; }
  }
  :global(html.catwalk-touch) .catwalk__overlay-hint--desktop { display: none; }
  :global(html.catwalk-touch) .catwalk__overlay-hint--mobile { display: block; }

  .btn-primary {
    font-family: 'Share Tech Mono', Consolas, monospace;
    font-size: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: bold;
    color: #040b08;
    background: #4dfa8b;
    border: 1px solid #4dfa8b;
    border-radius: 4px;
    padding: 14px 32px;
    min-height: 48px;
    min-width: 160px;
    cursor: pointer;
    box-shadow: 0 0 20px rgba(77, 250, 139, 0.35);
    transition: all 0.15s ease;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .btn-primary:hover, .btn-primary:focus-visible {
    background: #e8ffef;
    border-color: #e8ffef;
    box-shadow: 0 0 28px rgba(77, 250, 139, 0.6);
    outline: none;
    transform: translateY(-1px);
  }

  .catwalk__touch-hud {
    display: none;
    position: absolute;
    top: max(8px, env(safe-area-inset-top, 0px));
    right: max(8px, env(safe-area-inset-right, 0px));
    z-index: 7;
    gap: 8px;
    pointer-events: auto;
  }

  .catwalk__touch-hud button {
    width: 48px;
    height: 48px;
    min-width: 44px;
    min-height: 44px;
    border: 1px solid #22a058;
    border-radius: 8px;
    background: rgba(4, 11, 8, 0.88);
    color: #4dfa8b;
    font-size: 16px;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .catwalk__touch-hud button:active {
    background: #4dfa8b;
    color: #040b08;
  }

  /* Optional Touch D-Pad for Mobile screens.
     Portrait: above the 32px canvas bottom bar so it never covers the top HUD. */
  .catwalk__touch-dpad {
    display: none;
    position: absolute;
    left: 50%;
    top: auto;
    bottom: max(8px, calc(100% * 32 / 864 + 6px), env(safe-area-inset-bottom, 0px));
    transform: translateX(-50%);
    z-index: 6;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 0.9;
    pointer-events: auto;
  }

  .dpad-row {
    display: flex;
    gap: 8px;
  }

  .catwalk__touch-dpad button {
    width: 56px;
    height: 52px;
    min-width: 44px;
    min-height: 44px;
    border: 1px solid #22a058;
    border-radius: 8px;
    background: rgba(4, 11, 8, 0.82);
    color: #4dfa8b;
    font-size: 18px;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .catwalk__touch-dpad button:hover {
    border-color: #4dfa8b;
    box-shadow: 0 0 12px rgba(77, 250, 139, 0.25);
  }

  .catwalk__touch-dpad button:active {
    background: #4dfa8b;
    color: #040b08;
  }

  @media (hover: none) and (pointer: coarse) {
    .catwalk__touch-dpad,
    .catwalk__touch-hud {
      display: flex;
    }
  }

  /* Cabinet embed: real phones (coarse) and 390px / narrow iframes (fine pointer). */
  @media (pointer: coarse), (max-width: 900px) {
    :global(html.is-embedded) .catwalk__touch-dpad,
    :global(html.is-embedded) .catwalk__touch-hud {
      display: flex !important;
    }
  }

  /* Landscape phones: park D-pad on the left so top HUD + homes stay visible */
  @media (orientation: landscape) and (max-height: 520px) {
    .catwalk-cabinet {
      padding: max(2px, env(safe-area-inset-top, 0px)) max(2px, env(safe-area-inset-right, 0px)) max(2px, env(safe-area-inset-bottom, 0px)) max(2px, env(safe-area-inset-left, 0px));
    }
    .catwalk-bezel {
      max-height: calc(100dvh - 8px);
    }
    .catwalk__overlay {
      padding: 10px;
    }
    .catwalk__overlay-card {
      padding: 14px 16px;
    }
    .catwalk__overlay h2 {
      font-size: clamp(26px, 8vh, 40px);
      margin-bottom: 8px;
    }
    .catwalk__overlay p {
      margin-bottom: 12px;
      font-size: 12px;
    }
    .catwalk__touch-dpad {
      left: max(6px, env(safe-area-inset-left, 0px));
      right: auto;
      bottom: 50%;
      transform: translateY(50%);
      opacity: 0.92;
    }
    .catwalk__touch-dpad button {
      width: 48px;
      height: 44px;
      font-size: 15px;
    }
    .catwalk__touch-hud {
      top: max(4px, env(safe-area-inset-top, 0px));
      right: max(4px, env(safe-area-inset-right, 0px));
    }
    .catwalk__touch-hud button {
      width: 44px;
      height: 44px;
    }
  }

  /* Home-entry success flash (in-play, not hub chrome) */
  .catwalk-bezel.catwalk-home-flash::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    border-radius: 6px;
    background: radial-gradient(circle at 50% 12%, rgba(255, 209, 102, 0.55), rgba(77, 250, 139, 0.18) 45%, transparent 70%);
    animation: catwalkHomeFlash 0.42s ease-out;
  }
  @keyframes catwalkHomeFlash {
    0% { opacity: 0.95; }
    100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .catwalk-bezel.catwalk-home-flash::after {
      animation: none;
      opacity: 0.35;
      transition: opacity 0.2s ease;
    }
  }
</style>
