---
const embedded = Astro.url.searchParams.get('embed') === '1';
---

<!doctype html>
<html lang="en-US" class:list={{ 'is-embedded': embedded }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#040b08" />
    <meta name="description" content="Guide a vector cat through the night patrol into five safe homes." />
    <title>Catwalk | Humane Games</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Share+Tech+Mono&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- Single unified viewport-fitting arcade cabinet window -->
    <main class="catwalk-cabinet" data-catwalk-root>
      <div class="catwalk-bezel">
        <canvas width="720" height="864" data-game-canvas></canvas>

        <!-- In-game vector overlay modal -->
        <div class="catwalk__overlay" data-overlay>
          <div class="catwalk__overlay-card">
            <p class="catwalk__overlay-badge">Nine lives online</p>
            <h2 data-overlay-title>Get the cats home</h2>
            <p data-overlay-copy>Dodge the dogs. Ride the fishbones. Fill all five cat houses.</p>
            <div class="catwalk__overlay-actions">
              <button type="button" class="btn-primary" data-start>Start patrol</button>
            </div>
            <p class="catwalk__overlay-hint">Keys: W A S D or Arrows • Space/P to Pause • Click audio icon to toggle sound</p>
          </div>
        </div>

        <!-- Touch/mobile d-pad controls embedded smoothly into bottom of bezel if on mobile -->
        <nav class="catwalk__touch-dpad" aria-label="Movement controls">
          <button type="button" data-move="up" aria-label="Move up">▲</button>
          <div class="dpad-row">
            <button type="button" data-move="left" aria-label="Move left">◀</button>
            <button type="button" data-move="down" aria-label="Move down">▼</button>
            <button type="button" data-move="right" aria-label="Move right">▶</button>
          </div>
        </nav>
      </div>
    </main>

    <script>
      import '../../games/catwalk/main';
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; margin: 0; padding: 0; }
  :global(html) {
    color: #dfffe9;
    background: #040b08;
    font-family: 'Share Tech Mono', Consolas, monospace;
    height: 100%;
    overflow: hidden;
  }
  :global(body) {
    height: 100%;
    margin: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(ellipse at center, #091a13 0%, #040b08 75%, #010403 100%);
  }

  /* Single self-contained arcade window */
  .catwalk-cabinet {
    position: relative;
    width: 100%;
    height: 100dvh;
    max-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(4px, 1.5vh, 16px);
  }

  .catwalk-bezel {
    position: relative;
    height: 100%;
    max-height: calc(100dvh - 16px);
    aspect-ratio: 720 / 864;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 2px solid #1a3c2c;
    border-radius: 8px;
    background: #040b08;
    box-shadow:
      0 0 0 1px #0d2218,
      0 0 35px rgba(77, 250, 139, 0.12),
      0 12px 40px rgba(0, 0, 0, 0.85);
    overflow: hidden;
  }

  /* CRT glass curvature and scanline overlay */
  .catwalk-bezel::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
    border-radius: 6px;
    box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.65);
    background: radial-gradient(circle at 50% 20%, rgba(255, 255, 255, 0.03) 0%, transparent 60%);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    aspect-ratio: 720 / 864;
    cursor: default;
  }

  /* Integrated In-Game Overlay */
  .catwalk__overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: grid;
    place-content: center;
    justify-items: center;
    padding: 24px;
    text-align: center;
    background: rgba(4, 11, 8, 0.88);
    backdrop-filter: blur(6px);
  }

  .catwalk__overlay[hidden] {
    display: none !important;
  }

  .catwalk__overlay-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 440px;
    border: 1px solid #1a3c2c;
    border-radius: 6px;
    padding: 32px 28px;
    background: rgba(9, 26, 19, 0.94);
    box-shadow: 0 0 40px rgba(77, 250, 139, 0.15);
  }

  .catwalk__overlay-badge {
    color: #22a058;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .catwalk__overlay h2 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(38px, 6vw, 56px);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: 0.04em;
    color: #dfffe9;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .catwalk__overlay p {
    color: #81b59b;
    font-size: 13px;
    line-height: 1.45;
    margin-bottom: 20px;
  }

  .catwalk__overlay-hint {
    color: #476b58 !important;
    font-size: 11px !important;
    margin-top: 18px !important;
    margin-bottom: 0 !important;
    letter-spacing: 0.05em;
  }

  .btn-primary {
    font-family: 'Share Tech Mono', Consolas, monospace;
    font-size: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: bold;
    color: #040b08;
    background: #4dfa8b;
    border: 1px solid #4dfa8b;
    border-radius: 4px;
    padding: 12px 32px;
    cursor: pointer;
    box-shadow: 0 0 20px rgba(77, 250, 139, 0.35);
    transition: all 0.15s ease;
  }

  .btn-primary:hover, .btn-primary:focus-visible {
    background: #e8ffef;
    border-color: #e8ffef;
    box-shadow: 0 0 28px rgba(77, 250, 139, 0.6);
    outline: none;
    transform: translateY(-1px);
  }

  /* Optional Touch D-Pad for Mobile screens */
  .catwalk__touch-dpad {
    display: none;
    position: absolute;
    bottom: 42px;
    z-index: 6;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    opacity: 0.85;
  }

  .dpad-row {
    display: flex;
    gap: 6px;
  }

  .catwalk__touch-dpad button {
    width: 48px;
    height: 42px;
    border: 1px solid #22a058;
    border-radius: 4px;
    background: rgba(4, 11, 8, 0.8);
    color: #4dfa8b;
    font-size: 16px;
    cursor: pointer;
    touch-action: manipulation;
  }

  .catwalk__touch-dpad button:active {
    background: #4dfa8b;
    color: #040b08;
  }

  @media (hover: none) and (pointer: coarse) {
    .catwalk__touch-dpad {
      display: flex;
    }
  }
</style>
