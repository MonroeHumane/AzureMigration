---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../config/site";

const ZEFFY_URL = SITE.integrations.zeffy.shirtContest;
---

<BaseLayout
  title="Membership Shirt Design Contest | Vote for Your Favorite | 734-243-3669"
  description="Vote for your favorite Monroe Humane membership shirt design! Browse all 12 designs and cast your vote online via Zeffy or in person at the shelter."
>
  <main class="pt-32 pb-24 px-4 max-w-4xl mx-auto">
    <header class="mb-16 text-center">
      <p class="text-emerald-500 font-bold uppercase tracking-widest text-sm mb-4">Community vote</p>
      <h1 class="text-5xl md:text-6xl font-serif text-teal-900 mb-6">Membership Shirt Design Contest</h1>
      <p class="text-xl text-gray-600 mb-8 leading-relaxed">
        Browse the 12 designs below and vote for your favorite membership shirt design for the Humane Society of Monroe County. Voting is open online and in person at the shelter.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-emerald-500 text-teal-900 font-bold uppercase tracking-wider transition-all hover:bg-emerald-400 hover:-translate-y-1" href={ZEFFY_URL} target="_blank" rel="noopener noreferrer">
            Vote online via Zeffy
        </a>
        <a class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-teal-700 text-teal-700 font-bold uppercase tracking-wider transition-all hover:bg-teal-50 hover:-translate-y-1" href="/vote-confirmed">
            Vote confirmation
        </a>
      </div>
    </header>

    <div class="space-y-16">
      <section aria-labelledby="monroe-contest-designs-heading" class="bg-gray-50 rounded-3xl p-8 border border-gray-200">
        <h2 id="monroe-contest-designs-heading" class="text-3xl font-serif text-teal-900 mb-4">The 12 designs</h2>
        <p class="text-gray-600 mb-6 leading-relaxed">
          Each design below is a submission from the Monroe County community. Review all 12 and then cast your vote - one vote per person. Voting closes at the shelter's final in-person event.
        </p>
        <p class="text-gray-600 italic">
          <strong>Note:</strong> Design images will appear here once the contest gallery assets are uploaded to <code class="bg-gray-200 px-1 py-0.5 rounded text-sm">/public/assets/contest/</code>.
          Until then, use the Zeffy voting link above to view and vote online.
        </p>
      </section>

      <section aria-labelledby="monroe-contest-voting-heading">
        <h2 id="monroe-contest-voting-heading" class="text-3xl font-serif text-teal-900 mb-4">Vote online</h2>
        <p class="text-gray-600 mb-8 leading-relaxed">
          Use the secure Zeffy link to submit your online vote (1 vote per person). A small Zeffy ticket fee of $1 supports shelter animals directly.
        </p>
        <div class="mb-8">
          <a class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-emerald-500 text-teal-900 font-bold uppercase tracking-wider transition-all hover:bg-emerald-400 hover:-translate-y-1" href={ZEFFY_URL} target="_blank" rel="noopener noreferrer">
              Cast your vote on Zeffy
          </a>
        </div>
        <div class="rounded-[18px] border border-teal-900/20 bg-white overflow-hidden shadow-lg mb-4">
          <iframe
            title="Membership shirt design contest - Zeffy voting"
            src={ZEFFY_URL + "?embed=1"}
            width="100%"
            height="640"
            style="border: 0;"
            loading="lazy"
            allow="payment"
          ></iframe>
        </div>
        <p class="text-sm text-gray-500">
          If the embed does not display,{" "}<a class="text-teal-700 font-semibold hover:underline" href={ZEFFY_URL} target="_blank" rel="noopener noreferrer">open the voting page on Zeffy directly</a>.
        </p>
      </section>

      <section aria-labelledby="monroe-contest-inperson-heading">
        <h2 id="monroe-contest-inperson-heading" class="text-3xl font-serif text-teal-900 mb-4">In-person voting</h2>
        <p class="text-gray-600 mb-6 leading-relaxed">
          Visit the shelter during open hours and ask a staff member to vote in person. Printed ballots are available at the front desk.
        </p>
        <ul class="list-disc list-inside text-gray-600 space-y-2 mb-8 ml-2">
          <li>Tuesday - Friday: 11:00 AM - 4:00 PM</li>
          <li>Saturday: 11:00 AM - 3:00 PM</li>
          <li>Sunday &amp; Monday: Closed</li>
          <li>Location:{" "}<a class="text-teal-700 font-semibold hover:underline" href={SITE.contact.address.googleMapsUrl} target="_blank" rel="noopener noreferrer">{SITE.contact.address.street}, Monroe, MI {SITE.contact.address.zip}</a></li>
        </ul>
        <div class="flex flex-wrap gap-4">
          <a class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-teal-700 text-teal-700 font-bold uppercase tracking-wider transition-all hover:bg-teal-50 hover:-translate-y-1" href={SITE.contact.phoneTel}>{SITE.contact.phoneFormatted}</a>
          <a class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-teal-700 text-teal-700 font-bold uppercase tracking-wider transition-all hover:bg-teal-50 hover:-translate-y-1" href="/events">Upcoming shelter events</a>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>