---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerShell from '../../components/InnerShell.astro';

/*
 Legacy auction landing (WP slug /auction-in-april-2025/) — kept as a
 pointer to the live BetterUnite auction campaign.
*/
---

<BaseLayout
  title="Furry Friends Auction | 734-243-3669"
  description="Annual Furry Friends Gala & Auction supporting homeless shelter pets in Monroe County."
>
  <InnerShell variant="specialsponsors">
    <header class="monroe-native-hero">
      <p class="monroe-native-eyebrow">Annual fundraiser</p>
      <h1>Auction Time – Support Our Furry Friends!</h1>
      <p class="monroe-native-lead">
        Join Our Annual Auction — Raffle Open! Tickets, sponsorships, and donations are handled through our BetterUnite auction campaign.
      </p>
    </header>
    <section class="monroe-native-stack" aria-labelledby="monroe-auction-more-heading">
      <h2 id="monroe-auction-more-heading">Events &amp; fundraisers</h2>
      <p><a href="https://www.betterunite.com/adopthsmc-33rdannualfundsforfurryfriendsauction-1" target="_blank" rel="noopener noreferrer">33rd Annual Funds for Furry Friends Auction on BetterUnite</a></p>
      <p><a href="/events">All shelter events</a></p>
    </section>
  </InnerShell>
</BaseLayout>
