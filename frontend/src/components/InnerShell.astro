---
/*
 Shared inner-page shell — the monroe-native landing frame every interior
 page renders inside (hero band + stacked cards). variant selects the
 per-page tweaks defined in monroe-inner-page.css
 (e.g. "specialsponsors", "donate-now", "donations", "resources").
 */

interface Props {
  variant?: string;
}

const variantClasses: Record<string, string[]> = {
  adopt: ['monroe-adopt-page--renewed', 'monroe-native-inner--adopt'],
  'dog-and-cat-shelter': ['monroe-native-inner--dog-and-cat-shelter'],
  events: ['monroe-events-page', 'monroe-native-inner--events'],
  games: ['monroe-games-page-shell', 'monroe-native-inner--games'],
  membership: ['monroe-membership-page', 'monroe-native-inner--membership'],
  memorials: ['monroe-memorial-page', 'monroe-native-inner--memorials', 'monroe-memorial-giving-page'],
  'memorial-tribute': ['monroe-memorial-page', 'monroe-native-inner--memorial-tribute'],
  'memorial-give': ['monroe-memorial-giving-page', 'monroe-native-inner--memorial-give'],
  shop: ['monroe-shop-page', 'monroe-native-inner--shop'],
};

const { variant = '' } = Astro.props;
const extra = variant ? (variantClasses[variant] ?? [`monroe-native-inner--${variant}`]) : [];
---

<div class:list={['monroe-inner-page-shell', 'monroe-native-inner', ...extra]}>
  <div class="monroe-inner-page-shell__content">
    <slot />
  </div>
</div>
