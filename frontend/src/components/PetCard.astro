---
import type { Pet } from '../lib/directus';
import { Image } from 'astro:assets';

interface Props {
  pet: Pet;
}

const { pet } = Astro.props;

const genderLabel = pet.gender === 'female' ? 'Female' : pet.gender === 'male' ? 'Male' : 'Unknown';
const genderIcon = pet.gender === 'female' ? '♀' : pet.gender === 'male' ? '♂' : '?';
const chips = [pet.species_label || pet.type, pet.size, genderLabel, pet.age_display, pet.color].filter(Boolean);

// Real intake_date from the Petango sync — surface it as a badge instead of
// leaving it unused. New arrivals get a spotlight; long-time residents get
// a gentle nudge, since shelter UX research consistently flags "who's been
// overlooked" as a high-value signal for adopters.
let daysAtShelter: number | null = null;
if (pet.intake_date) {
  const d = new Date(pet.intake_date);
  if (!isNaN(d.getTime())) daysAtShelter = Math.floor((Date.now() - d.getTime()) / 86400000);
}
const isNewArrival = daysAtShelter !== null && daysAtShelter >= 0 && daysAtShelter <= 14;
const isLongTimer = daysAtShelter !== null && daysAtShelter >= 180;
---

<a
  class="group flex flex-col bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-200 transition-all hover:shadow-xl hover:-translate-y-1 focus-visible:ring-2 focus-visible:ring-teal-700 outline-none"
  href={`/adopt/${pet.id}`}
  data-pet-card
  data-pet-id={pet.id}
  data-pet-type={pet.type}
  data-pet-gender={pet.gender}
  data-pet-size={(pet.size || '').toLowerCase()}
  data-pet-age={pet.age}
  data-pet-name={pet.name.toLowerCase()}
  data-pet-breed={(pet.breed || '').toLowerCase()}
  data-pet-search={`${pet.name} ${pet.breed} ${pet.description || ''}`.toLowerCase()}
  aria-label={`Meet ${pet.name}, a ${pet.age_display || ''} ${pet.breed || pet.type}`}
>
  <div class="relative aspect-[4/3] w-full overflow-hidden bg-gray-100">
    <Image class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src={pet.image_url || pet.image || ''} alt={pet.name} loading="lazy" decoding="async" width={480} height={360} />
    <span class="absolute top-3 left-3 bg-white/90 backdrop-blur w-9 h-9 rounded-full flex items-center justify-center text-lg shadow-sm z-10">{pet.type === 'dog' ? '🐶' : pet.type === 'cat' ? '🐱' : '🐾'}</span>
    {isNewArrival && <span class="absolute top-3 right-3 px-3 py-1.5 text-xs font-bold uppercase tracking-wider rounded-full shadow-sm z-10 text-white bg-emerald-500">New arrival</span>}
    {!isNewArrival && isLongTimer && <span class="absolute top-3 right-3 px-3 py-1.5 text-xs font-bold uppercase tracking-wider rounded-full shadow-sm z-10 text-white bg-purple-500">Been waiting a while</span>}
  </div>
  <div class="p-5 flex flex-col flex-1">
    <h3 class="font-serif text-2xl text-teal-900 mb-1 leading-tight group-hover:text-teal-700 transition-colors">{pet.name}</h3>
    <p class="text-sm text-gray-500 mb-4 line-clamp-1">{pet.breed}</p>
    <div class="flex flex-wrap gap-1.5 mb-6">
      {chips.map((chip) => <span class="px-2.5 py-1 bg-gray-100 text-gray-600 text-xs font-semibold rounded-md uppercase tracking-widest">{chip}</span>)}
    </div>
    <span class="mt-auto text-sm font-bold text-teal-700 uppercase tracking-widest group-hover:text-teal-900 transition-colors">Meet {pet.name} &rarr;</span>
  </div>
</a>
