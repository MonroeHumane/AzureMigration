---
import type { Pet } from '../lib/directus';
import { Image } from 'astro:assets';

interface Props {
  pet: Pet;
}

const { pet } = Astro.props;

const genderLabel = pet.gender === 'female' ? 'Female' : pet.gender === 'male' ? 'Male' : 'Unknown';
const genderIcon = pet.gender === 'female' ? '♀' : pet.gender === 'male' ? '♂' : '';
const speciesLabel = pet.species_label || (pet.type === 'dog' ? 'Dog' : pet.type === 'cat' ? 'Cat' : 'Pet');

interface ChipItem {
  label: string;
  style: string;
}

const chips: ChipItem[] = [];
chips.push({
  label: speciesLabel,
  style: 'bg-teal-50/80 text-teal-900 border-teal-200/60',
});
if (pet.gender) {
  chips.push({
    label: genderIcon ? `${genderIcon} ${genderLabel}` : genderLabel,
    style: pet.gender === 'female' ? 'bg-rose-50/80 text-rose-900 border-rose-200/60' : 'bg-sky-50/80 text-sky-900 border-sky-200/60',
  });
}
if (pet.age_display) {
  chips.push({
    label: pet.age_display,
    style: 'bg-amber-50/80 text-amber-900 border-amber-200/60',
  });
}
if (pet.size) {
  chips.push({
    label: pet.size,
    style: 'bg-stone-50 text-stone-700 border-stone-200/70',
  });
}
if (pet.color && chips.length < 4) {
  chips.push({
    label: pet.color,
    style: 'bg-stone-50 text-stone-700 border-stone-200/70',
  });
}

// Real intake_date from the Petango sync — surface it as a badge instead of
// leaving it unused. New arrivals get a spotlight; long-time residents get
// a gentle nudge, since shelter UX research consistently flags "who's been
// overlooked" as a high-value signal for adopters.
let daysAtShelter: number | null = null;
if (pet.intake_date) {
  const d = new Date(pet.intake_date);
  if (!isNaN(d.getTime())) daysAtShelter = Math.floor((Date.now() - d.getTime()) / 86400000);
}
const isNewArrival = daysAtShelter !== null && daysAtShelter >= 0 && daysAtShelter <= 14;
const isLongTimer = daysAtShelter !== null && daysAtShelter >= 180;

let intakeDisplay = '';
if (pet.intake_date) {
  const d = new Date(pet.intake_date);
  if (!isNaN(d.getTime())) {
    intakeDisplay = d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
  }
}
---

<div
  class="group relative flex flex-col bg-white rounded-3xl overflow-hidden shadow-[0_4px_20px_-4px_rgba(19,60,57,0.07)] border border-teal-950/10 transition-all duration-300 hover:shadow-[0_20px_35px_-10px_rgba(19,60,57,0.16)] hover:-translate-y-1.5 hover:border-teal-700/30 active:scale-[0.99] focus-within:ring-2 focus-within:ring-teal-700"
  data-pet-card
  data-pet-id={pet.id}
  data-pet-type={pet.type}
  data-pet-gender={pet.gender}
  data-pet-gender-label={genderLabel}
  data-pet-size={(pet.size || '').toLowerCase()}
  data-pet-age={pet.age}
  data-pet-age-display={pet.age_display || ''}
  data-pet-name={pet.name}
  data-pet-breed={pet.breed || ''}
  data-pet-species-tag={speciesLabel}
  data-pet-image={pet.image_url || pet.image || '/assets/recovered/images/placeholder.svg'}
  data-pet-location={pet.location || 'Shelter'}
  data-pet-intake={intakeDisplay}
  data-pet-desc={pet.description || ''}
  data-pet-status-badge={isNewArrival ? 'new' : isLongTimer ? 'waiting' : ''}
  data-pet-search={`${pet.name} ${pet.breed} ${pet.description || ''}`.toLowerCase()}
>
  <div class="relative aspect-[4/3] w-full overflow-hidden bg-gray-100">
    <a href={`/adopt/${pet.id}`} class="absolute inset-0 z-0" aria-label={`Meet ${pet.name}, a ${pet.age_display || ''} ${pet.breed || pet.type}`}>
      <Image class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" src={pet.image_url || pet.image || ''} alt={pet.name} loading="lazy" decoding="async" width={480} height={360} />
      <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent opacity-60 group-hover:opacity-80 transition-opacity duration-300 pointer-events-none" aria-hidden="true"></div>
    </a>
    <span class="absolute top-3 left-3 bg-white/85 backdrop-blur-md px-3 py-1 rounded-full text-[11px] font-bold text-teal-950 shadow-xs z-10 uppercase tracking-wider border border-white/60 pointer-events-none">{speciesLabel}</span>
    <div class="absolute top-3 right-3 z-10 flex flex-col items-end gap-2">
      {isNewArrival && (
        <span class="inline-flex items-center gap-1.5 px-3 py-1 text-[11px] font-bold uppercase tracking-wider rounded-full shadow-xs text-emerald-950 bg-emerald-300/90 backdrop-blur-md border border-emerald-200/80 pointer-events-none">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse" aria-hidden="true"></span>
          New arrival
        </span>
      )}
      {!isNewArrival && isLongTimer && (
        <span class="inline-flex items-center gap-1.5 px-3 py-1 text-[11px] font-bold uppercase tracking-wider rounded-full shadow-xs text-purple-950 bg-purple-200/90 backdrop-blur-md border border-purple-300/80 pointer-events-none">
          Needs a home
        </span>
      )}
      <button
        type="button"
        class="pet-favorite-btn w-8 h-8 inline-flex items-center justify-center rounded-full bg-white/85 hover:bg-white text-teal-950 backdrop-blur-md border border-white/60 shadow-xs transition-all hover:scale-110 cursor-pointer"
        data-pet-favorite-btn
        aria-pressed="false"
        aria-label={`Save ${pet.name} to favorites`}
        title="Save to favorites"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      </button>
    </div>
    <button
      type="button"
      class="absolute bottom-3 right-3 z-10 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-white/90 hover:bg-white text-teal-950 backdrop-blur-md border border-white/70 shadow-sm transition-all hover:scale-105 cursor-pointer opacity-95 group-hover:opacity-100"
      data-pet-quickview-btn
      aria-label={`Quick view ${pet.name}`}
      title={`Quick preview ${pet.name}`}
    >
      <svg class="w-3.5 h-3.5 text-teal-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
      <span>Quick View</span>
    </button>
  </div>
  <div class="p-5 sm:p-6 flex flex-col flex-1 relative z-10">
    <h3 class="font-serif text-2xl text-teal-900 mb-1 leading-tight group-hover:text-teal-700 transition-colors">
      <a href={`/adopt/${pet.id}`} class="hover:underline">{pet.name}</a>
    </h3>
    <p class="text-sm text-gray-500 mb-4 line-clamp-1">{pet.breed}</p>
    <div class="flex flex-wrap gap-1.5 mb-6">
      {chips.map((chip) => (
        <span class={`px-2.5 py-1 text-xs font-semibold rounded-lg border uppercase tracking-wider ${chip.style}`}>
          {chip.label}
        </span>
      ))}
    </div>
    <div class="mt-auto flex items-center justify-between pt-2 border-t border-teal-950/5">
      <a href={`/adopt/${pet.id}`} class="text-xs font-bold text-teal-700 uppercase tracking-widest hover:text-teal-900 transition-colors inline-flex items-center gap-1">
        <span>Meet {pet.name}</span>
        <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
      <button
        type="button"
        class="text-xs font-semibold text-teal-800 hover:text-teal-950 hover:underline cursor-pointer sm:hidden"
        data-pet-quickview-btn
      >
        Quick View
      </button>
    </div>
  </div>
</div>
