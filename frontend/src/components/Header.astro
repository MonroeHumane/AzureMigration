---
/*
 Global navigation — unified desktop flyouts and responsive mobile drawer.
 One data model drives desktop dropdowns and mobile navigation.
 */

interface NavChild {
  label: string;
  href: string;
  external?: boolean;
}

interface NavItem {
  label: string;
  href?: string;
  overviewHref?: string;
  children?: NavChild[];
}

import { SITE } from '../config/site';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const LOGO_SRC = SITE.assets.logo;
const DONATE_URL = '/donate';

const NAV: NavItem[] = [
  { label: 'Home', href: '/' },
  {
    label: 'Services',
    overviewHref: '/dog-and-cat-shelter',
    children: [
      { label: 'Adoptable Pets', href: '/adopt' },
      { label: 'About Our Shelter', href: '/dog-and-cat-shelter' },
      { label: 'Hero Fence', href: '/#hs-hero-fence-widget' },
      { label: 'Community Reviews', href: '/#Testimonials' },
      { label: 'Games', href: '/games' },
    ],
  },
  {
    label: 'Adopt',
    overviewHref: '/adoptions',
    children: [
      { label: 'Available Pets', href: '/adopt' },
      { label: 'Adoption Policy', href: '/adoptions/#AdoptionPolicy' },
      { label: 'Application', href: '/adoptions/#Application' },
    ],
  },
  {
    label: 'Resources',
    overviewHref: '/resources',
    children: [
      { label: 'Shop', href: '/shop' },
      { label: 'Membership', href: '/membership' },
      { label: 'FAQ', href: '/faq' },
      { label: 'Newsletter archive', href: '/newsletter' },
      { label: 'Latest newsletter', href: '/#Newsletter' },
      { label: 'Community Reviews', href: '/#Testimonials' },
      { label: 'Fundraisers', href: DONATE_URL },
      { label: 'Volunteer', href: '/volunteer-form' },
    ],
  },
  {
    label: 'Events',
    overviewHref: '/events',
    children: [
      { label: 'Event flyers', href: '/events' },
      { label: 'Calendar', href: '/events#Calendar' },
      { label: 'Special Sponsors', href: '/specialsponsors' },
    ],
  },
  {
    label: 'Donations',
    overviewHref: '/donate',
    children: [
      { label: 'Make a donation', href: '/donate' },
      { label: 'Memorial & tributes', href: '/memorials' },
      { label: 'Planned giving', href: '/memorials/give' },
    ],
  },
  { label: 'Contact', href: '/contact' },
];

const firstSegment = (href: string) => '/' + href.replace(/^https?:\/\/[^/]+/, '').split('/')[1];
const currentSegment = firstSegment(currentPath);

const isCurrent = (item: NavItem) => {
  if (item.href) {
    if (item.href === '/' || currentPath === '/') return currentPath === item.href;
    return firstSegment(item.href) === currentSegment;
  }
  const candidates = [item.overviewHref ?? '/', ...(item.children?.map((c) => c.href) ?? [])];
  return candidates.some((href) => firstSegment(href) === currentSegment);
};
---

<header class="monroe-global-nav" data-monroe-global-nav data-monroe-nav-drawer-max={SITE.ui.mobileDrawerBreakpoint}>
  <div class="monroe-global-nav__inner">
    <div class="monroe-global-nav__bar">
      <div class="monroe-global-nav__bar-cta">
        <a class="monroe-global-nav__bar-adopt" href="/adopt">Adopt</a>
        <a class="monroe-global-nav__bar-donate" href={DONATE_URL}>Donate</a>
      </div>
      <a class="monroe-global-nav__brand" href="/" aria-label={`${SITE.name}, home`}>
        <img src={LOGO_SRC} alt="Monroe Humane Logo" loading="eager" fetchpriority="high" decoding="async" width="320" height="120" style="max-width: 200px;" />
      </a>

      <button class="monroe-global-nav__menu-toggle" type="button" aria-expanded="false" aria-controls="monroe-global-nav-menu">
        <span></span>
        <span></span>
        <span></span>
        <span class="screen-reader-text">Toggle navigation</span>
      </button>
    </div>

    <nav class="monroe-global-nav__panel" id="monroe-global-nav-menu" aria-label="Primary navigation">
      <ul class="monroe-global-nav__list">
        {NAV.map((item, i) =>
          item.children ? (
            <li class:list={['monroe-global-nav__item', 'has-children', { 'is-current': isCurrent(item) }]}>
              <div class="monroe-global-nav__trigger-group">
                <a class="monroe-global-nav__link monroe-global-nav__link--parent" href={item.overviewHref}>
                  <span>{item.label}</span>
                </a>
                <button
                  class="monroe-global-nav__trigger monroe-global-nav__trigger--chevron"
                  type="button"
                  aria-expanded="false"
                  aria-haspopup="true"
                  aria-label={`Toggle ${item.label} submenu`}
                  aria-controls={`monroe-nav-dd-${i}`}
                >
                  <span class="monroe-global-nav__chevron" aria-hidden="true" />
                </button>
              </div>
              <div id={`monroe-nav-dd-${i}`} class="monroe-global-nav__dropdown" role="region" aria-label={`${item.label} submenu`}>
                <a class="monroe-global-nav__dropdown-link monroe-global-nav__dropdown-link--top" href={item.overviewHref}>
                  <span>{item.label}</span>
                  <span class="monroe-global-nav__dropdown-overview">Overview</span>
                </a>
                <ul class="monroe-global-nav__submenu">
                  {item.children.map((child) => (
                    <li class="monroe-global-nav__item">
                      <a
                        class="monroe-global-nav__link"
                        href={child.href}
                        {...(child.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ) : (
            <li class:list={['monroe-global-nav__item', { 'is-current': isCurrent(item) }]}>
              <a class="monroe-global-nav__link" href={item.href} aria-current={isCurrent(item) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          )
        )}
      </ul>
      <div class="monroe-global-nav__cta-row">
        <a class="monroe-global-nav__member" href="/membership">Membership</a>
        <a class="monroe-global-nav__donate" href={DONATE_URL}>Donate</a>
        <a class="monroe-global-nav__call" href={SITE.contact.phoneTel}>Call Us</a>
        <a class="monroe-global-nav__application" href="/adoptions">Application</a>
      </div>
    </nav>
  </div>
</header>
<button type="button" class="monroe-global-nav__backdrop" aria-label="Close menu" tabindex="-1" hidden></button>

<script>
  let cleanupHeaderListeners: (() => void) | null = null;

  function initHeader() {
    if (cleanupHeaderListeners) {
      cleanupHeaderListeners();
      cleanupHeaderListeners = null;
    }

    const header = document.querySelector<HTMLElement>('[data-monroe-global-nav]');
    if (!header) return;

    const ac = new AbortController();
    const { signal } = ac;
    const root = document.documentElement;
    const toggle = header.querySelector<HTMLButtonElement>('.monroe-global-nav__menu-toggle');
    const backdrop = document.querySelector<HTMLButtonElement>('.monroe-global-nav__backdrop');
    const panel = header.querySelector<HTMLElement>('.monroe-global-nav__panel');
    const mql = window.matchMedia('(max-width: 1200px)');

    // Publish the closed-header height so body padding and anchors track it exactly.
    const measure = () => {
      if (header.classList.contains('is-open')) return;
      const h = Math.round(header.getBoundingClientRect().height);
      if (h > 0) {
        root.style.setProperty('--monroe-nav-height', `${h}px`);
      }
    };

    const setCondensed = () => header.classList.toggle('is-condensed', window.scrollY > 12);

    // Desktop flyouts don't track scroll position, so a scroll while one is open leaves it
    // floating over content that has since moved. Mobile skips this: dropdowns there are
    // accordion items inside the drawer, and closing them on scroll would fight the user.
    const closeDropdownsOnScroll = () => {
      if (!mql.matches) closeAllDropdowns();
    };

    const closeAllDropdowns = () => {
      header.querySelectorAll('.monroe-global-nav__item.is-open').forEach((li) => {
        li.classList.remove('is-open');
        li.querySelector('.monroe-global-nav__trigger')?.setAttribute('aria-expanded', 'false');
      });
      syncInert();
    };

    // Collapsed submenus stay out of the tab order (drawer accordion + closed desktop flyouts).
    const syncInert = () => {
      header.querySelectorAll<HTMLElement>('.monroe-global-nav__dropdown').forEach((dd) => {
        const isMobile = mql.matches;
        if (isMobile) {
          const open = dd.closest('.monroe-global-nav__item')?.classList.contains('is-open') ?? false;
          dd.inert = !open;
        } else {
          dd.inert = false;
        }
      });
    };

    const closeDrawer = () => {
      header.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      if (backdrop) backdrop.hidden = true;
      closeAllDropdowns();
    };

    toggle?.addEventListener('click', () => {
      const open = header.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
      root.classList.remove('monroe-nav-hidden');
      if (open) {
        if (backdrop) backdrop.hidden = false;
        syncInert();
        header.querySelector<HTMLElement>('.monroe-global-nav__link')?.focus();
      } else {
        closeDrawer();
      }
    }, { signal });

    backdrop?.addEventListener('click', closeDrawer, { signal });

    // Touch Physics: Swipe UP on drawer panel to dismiss
    if (panel) {
      let drawerTouchStartY = 0;
      let drawerTouchStartX = 0;

      panel.addEventListener('touchstart', (e) => {
        if (e.touches.length > 0) {
          drawerTouchStartY = e.touches[0].clientY;
          drawerTouchStartX = e.touches[0].clientX;
        }
      }, { passive: true, signal });

      panel.addEventListener('touchend', (e) => {
        if (e.changedTouches.length > 0) {
          const drawerTouchEndY = e.changedTouches[0].clientY;
          const drawerTouchEndX = e.changedTouches[0].clientX;
          const deltaY = drawerTouchStartY - drawerTouchEndY; // upward swipe
          const deltaX = Math.abs(drawerTouchEndX - drawerTouchStartX);

          // If swiped UP by > 50px and panel is at top of scroll
          if (header.classList.contains('is-open') && deltaY > 50 && deltaY > deltaX && panel.scrollTop <= 5) {
            closeDrawer();
          }
        }
      }, { passive: true, signal });
    }

    // Close on Escape or click outside
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAllDropdowns();
        if (header.classList.contains('is-open')) {
          closeDrawer();
          toggle?.focus();
        }
      }
    }, { signal });

    document.addEventListener('click', (e) => {
      if (!header.contains(e.target as Node)) {
        closeAllDropdowns();
      }
    }, { signal });

    // Dropdown items: clean hover and click handlers
    header.querySelectorAll<HTMLElement>('.monroe-global-nav__item.has-children').forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>('.monroe-global-nav__trigger');

      // Desktop: mouseleave immediately closes any stuck open state
      item.addEventListener('mouseleave', () => {
        if (!mql.matches) {
          item.classList.remove('is-open');
          trigger?.setAttribute('aria-expanded', 'false');
        }
      }, { signal });

      // Mouseenter on another item closes adjacent open ones
      item.addEventListener('mouseenter', () => {
        if (!mql.matches) {
          item.parentElement?.querySelectorAll(':scope > .monroe-global-nav__item.is-open').forEach((other) => {
            if (other !== item) {
              other.classList.remove('is-open');
              other.querySelector('.monroe-global-nav__trigger')?.setAttribute('aria-expanded', 'false');
            }
          });
        }
      }, { signal });

      trigger?.addEventListener('click', () => {
        const wasOpen = item.classList.contains('is-open');
        // Accordion: one flyout open at a time within the same menu level
        item.parentElement?.querySelectorAll(':scope > .monroe-global-nav__item.is-open').forEach((other) => {
          if (other !== item) {
            other.classList.remove('is-open');
            other.querySelector('.monroe-global-nav__trigger')?.setAttribute('aria-expanded', 'false');
          }
        });
        item.classList.toggle('is-open', !wasOpen);
        trigger.setAttribute('aria-expanded', String(!wasOpen));
        syncInert();
      }, { signal });
    });

    // Leaving drawer territory closes it.
    mql.addEventListener('change', () => {
      closeDrawer();
      measure();
      syncInert();
      root.classList.remove('monroe-nav-hidden');
    }, { signal });

    // Scroll-Aware Screen Maximizing: Hide on scroll down, Reveal on scroll up
    let lastScrollY = window.scrollY;
    const SCROLL_DELTA_THRESHOLD = 10;

    const handleScrollAwareNav = () => {
      if (!mql.matches) {
        root.classList.remove('monroe-nav-hidden');
        return;
      }

      const currentY = window.scrollY;

      // Always reveal within top 60px of the page
      if (currentY <= 60) {
        root.classList.remove('monroe-nav-hidden');
        lastScrollY = currentY;
        return;
      }

      // Do not hide if mobile drawer or any modal dialog is currently open
      if (header.classList.contains('is-open') || document.querySelector('dialog[open]')) {
        root.classList.remove('monroe-nav-hidden');
        lastScrollY = currentY;
        return;
      }

      const diff = currentY - lastScrollY;
      if (diff > SCROLL_DELTA_THRESHOLD) {
        // Scrolled down -> maximize screen by translating bars out of viewport
        root.classList.add('monroe-nav-hidden');
      } else if (diff < -SCROLL_DELTA_THRESHOLD) {
        // Scrolled up -> reveal navigation bars immediately
        root.classList.remove('monroe-nav-hidden');
      }

      lastScrollY = currentY;
    };

    measure();
    setCondensed();
    syncInert();

    const onResize = () => measure();
    const onScrollCondensed = () => setCondensed();
    const onScrollClose = () => closeDropdownsOnScroll();
    const onScrollAware = () => handleScrollAwareNav();

    window.addEventListener('resize', onResize, { passive: true, signal });
    window.addEventListener('scroll', onScrollCondensed, { passive: true, signal });
    window.addEventListener('scroll', onScrollClose, { passive: true, signal });
    window.addEventListener('scroll', onScrollAware, { passive: true, signal });

    let ro: ResizeObserver | null = null;
    if ('ResizeObserver' in window) {
      ro = new ResizeObserver(() => measure());
      ro.observe(header);
    }

    cleanupHeaderListeners = () => {
      ac.abort();
      if (ro) {
        ro.disconnect();
        ro = null;
      }
    };
  }

  document.addEventListener('astro:before-swap', () => {
    document.documentElement.classList.remove('monroe-nav-hidden');
    if (cleanupHeaderListeners) {
      cleanupHeaderListeners();
      cleanupHeaderListeners = null;
    }
  });

  document.addEventListener('astro:page-load', initHeader);
</script>

