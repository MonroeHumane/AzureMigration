---
import { SITE } from '../config/site';

interface NavChild {
  label: string;
  href: string;
  external?: boolean;
}

interface NavItem {
  label: string;
  href?: string;
  overviewHref?: string;
  children?: NavChild[];
}

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const LOGO_SRC = SITE.assets.logo;
const DONATE_URL = SITE.integrations.betterUnite.generalDonation;
const MEMBERSHIP_URL = SITE.integrations.betterUnite.membership;

const NAV: NavItem[] = [
  { label: 'Home', href: '/' },
  {
    label: 'Services',
    overviewHref: '/dog-and-cat-shelter',
    children: [
      { label: 'Adoptable Pets', href: '/adopt' },
      { label: 'About Our Shelter', href: '/dog-and-cat-shelter' },
      { label: 'Hero Fence', href: '/#hs-hero-fence-widget' },
      { label: 'Games', href: '/games' },
    ],
  },
  {
    label: 'Adopt',
    overviewHref: '/adoptions',
    children: [
      { label: 'Available Pets', href: '/adopt' },
      { label: 'Adoption Policy', href: '/adoptions/#AdoptionPolicy' },
      { label: 'Application', href: '/adoptions/#Application' },
    ],
  },
  {
    label: 'Resources',
    overviewHref: '/resources',
    children: [
      { label: 'Shop', href: '/shop' },
      { label: 'Membership plans', href: '/membership' },
      { label: 'Join online', href: MEMBERSHIP_URL, external: true },
      { label: 'FAQ', href: '/faq' },
      { label: 'Newsletter archive', href: '/newsletter' },
      { label: '25 in Review', href: '/newsletter/issue/2025-in-review' },
      { label: 'Fundraisers', href: DONATE_URL, external: true },
      { label: 'Volunteer', href: '/volunteer-form' },
    ],
  },
  {
    label: 'Events',
    overviewHref: '/events',
    children: [
      { label: 'Vote for shirt design', href: '/artwork-contest' },
      { label: 'Event flyers', href: '/events' },
      { label: 'Calendar', href: '/events#Calendar' },
      { label: 'Special Sponsors', href: '/specialsponsors' },
    ],
  },
  {
    label: 'Donations',
    overviewHref: '/donate',
    children: [
      { label: 'Make a donation', href: '/donate' },
      { label: 'Memorial & tributes', href: '/memorials' },
      { label: 'Planned giving', href: '/memorials/give' },
    ],
  },
  { label: 'Contact', href: '/contact' },
];

const firstSegment = (href: string) => '/' + href.replace(/^https?:\/\/[^/]+/, '').split('/')[1];
const currentSegment = firstSegment(currentPath);

const isCurrent = (item: NavItem) => {
  if (item.href) {
    if (item.href === '/' || currentPath === '/') return currentPath === item.href;
    return firstSegment(item.href) === currentSegment;
  }
  const candidates = [item.overviewHref ?? '/', ...(item.children?.map((c) => c.href) ?? [])];
  return candidates.some((href) => firstSegment(href) === currentSegment);
};
---

<header class="sticky top-0 z-50 w-full flex-none transition-all duration-300 bg-white/90 backdrop-blur-md border-b border-gray-100 shadow-sm" id="header" data-monroe-global-nav>
  <div class="absolute inset-0 bg-white/90 backdrop-blur-md z-0 pointer-events-none xl:hidden" data-nav-backdrop hidden></div>
  <div class="relative max-w-[1400px] mx-auto px-6 lg:px-12 z-10 text-default flex justify-between h-20 lg:h-24 transition-all duration-300" id="header-container">
    
    <div class="flex items-center justify-between w-full xl:w-auto">
      <a class="flex items-center shrink-0" href="/" aria-label="Home">
        <img class="h-12 sm:h-16 w-auto object-contain transition-all duration-300" src={LOGO_SRC} alt="" width="320" height="120" />
      </a>
      
      <div class="flex items-center gap-4 xl:hidden">
        <a class="px-5 py-2 text-sm font-semibold tracking-wide text-white bg-teal-700 hover:bg-teal-800 rounded-full transition-colors" href={DONATE_URL} target="_blank" rel="noopener noreferrer">Donate</a>
        <button type="button" class="flex flex-col items-center justify-center w-10 h-10 gap-[5px] text-teal-900 group" aria-label="Toggle Menu" data-nav-toggle>
          <span class="w-6 h-[2px] bg-current rounded-full transition-all duration-300 group-[.is-open]:rotate-45 group-[.is-open]:translate-y-[7px]"></span>
          <span class="w-6 h-[2px] bg-current rounded-full transition-all duration-300 group-[.is-open]:opacity-0"></span>
          <span class="w-6 h-[2px] bg-current rounded-full transition-all duration-300 group-[.is-open]:-rotate-45 group-[.is-open]:-translate-y-[7px]"></span>
        </button>
      </div>
    </div>

    <nav class="fixed inset-0 top-20 lg:top-24 xl:static w-full xl:w-auto bg-white xl:bg-transparent overflow-y-auto xl:overflow-visible transition-transform duration-300 translate-x-full xl:translate-x-0 group-[.is-open]/header:translate-x-0 hidden xl:flex items-center shadow-2xl xl:shadow-none" aria-label="Main navigation" data-nav-menu>
      <ul class="flex flex-col xl:flex-row w-full xl:w-auto text-lg xl:text-[15px] font-medium xl:font-semibold text-gray-700 p-6 xl:p-0 gap-2 xl:gap-8 2xl:gap-10">
        {NAV.map((item, i) => (
          <li class="relative group" data-nav-item>
            {item.children ? (
              <>
                <button type="button" class:list={["flex items-center justify-between w-full px-4 py-3 xl:px-0 xl:py-2 hover:text-teal-700 transition-colors", { "text-teal-700": isCurrent(item) }]} aria-expanded="false" data-nav-trigger>
                  {item.label}
                  <svg class="w-4 h-4 ml-1 transition-transform duration-200 group-[.is-open]:rotate-180 xl:group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                  </svg>
                </button>
                <div class="hidden group-[.is-open]:block xl:group-[.is-open]:hidden xl:group-hover:block xl:absolute xl:top-full xl:left-1/2 xl:-translate-x-1/2 bg-gray-50 xl:bg-white xl:shadow-lg xl:rounded-2xl xl:border xl:border-gray-100 xl:min-w-[240px] xl:p-2 overflow-hidden transition-all duration-200 xl:opacity-0 xl:group-hover:opacity-100 xl:translate-y-2 xl:group-hover:translate-y-0" data-nav-dropdown>
                  <a class="block px-6 py-3 xl:px-4 xl:py-2 text-sm font-bold text-teal-800 bg-teal-50/50 xl:bg-transparent xl:hover:bg-teal-50 rounded-lg mb-2" href={item.overviewHref}>
                    {item.label} Overview &rarr;
                  </a>
                  <ul class="flex flex-col gap-1 pb-4 xl:pb-0 px-2 xl:px-0">
                    {item.children.map((child) => (
                      <li>
                        <a class="block px-4 py-2.5 text-sm font-medium text-gray-600 hover:text-teal-700 hover:bg-teal-50/50 rounded-lg transition-colors" href={child.href} {...(child.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </>
            ) : (
              <a class:list={["block px-4 py-3 xl:px-0 xl:py-2 hover:text-teal-700 transition-colors", { "text-teal-700": isCurrent(item) }]} href={item.href}>
                {item.label}
              </a>
            )}
          </li>
        ))}
      </ul>
      <div class="xl:hidden mt-auto p-6 border-t border-gray-100 flex flex-col gap-4 bg-gray-50/50">
         <a class="w-full py-4 text-center text-sm font-bold text-white bg-teal-700 rounded-full" href={DONATE_URL} target="_blank">Donate Now</a>
         <a class="w-full py-4 text-center text-sm font-bold text-teal-700 bg-white border-2 border-teal-700 rounded-full" href={SITE.contact.phoneTel}>Call Us</a>
      </div>
    </nav>
    
    <div class="hidden xl:flex items-center gap-4 shrink-0">
      <a class="px-8 py-3 text-sm font-bold tracking-wide text-white bg-teal-700 hover:bg-teal-800 rounded-full transition-all shadow-sm hover:shadow-md hover:-translate-y-0.5" href={DONATE_URL} target="_blank" rel="noopener noreferrer">
        Donate
      </a>
    </div>

  </div>
</header>

<script>
  function initNav() {
    const header = document.getElementById('header');
    const toggle = document.querySelector('[data-nav-toggle]');
    const menu = document.querySelector('[data-nav-menu]');
    
    if (!header || !toggle || !menu) return;

    toggle.addEventListener('click', () => {
      const isOpen = toggle.classList.contains('is-open');
      toggle.classList.toggle('is-open');
      header.classList.toggle('is-open');
      
      if (!isOpen) {
        menu.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      } else {
        document.body.style.overflow = '';
        setTimeout(() => {
          if (!toggle.classList.contains('is-open')) menu.classList.add('hidden');
        }, 300);
      }
    });

    // Handle accordion on mobile
    const triggers = document.querySelectorAll('[data-nav-trigger]');
    triggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const parent = trigger.closest('[data-nav-item]');
        if (window.innerWidth < 1280) { // xl breakpoint
          const wasOpen = parent?.classList.contains('is-open');
          
          // Close others
          document.querySelectorAll('[data-nav-item].is-open').forEach(item => {
            if (item !== parent) item.classList.remove('is-open');
          });

          parent?.classList.toggle('is-open', !wasOpen);
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initNav);
</script>
