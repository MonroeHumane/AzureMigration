---
/**
 * Native Astro homepage Donations & Giving (Phase 3).
 * PayPal campaign iframes + offline gifts callout + give tiles.
 * Tailwind parity with `.home-editable-donate-card` / give-grid / offline-donations.
 * Preserves `#Donations` and Volunteer tile `#Volunteer` for nav / deep links.
 */
import home from '../../data/homepage.json';

type DonateTile = {
  title: string;
  copy: string;
  button: string;
  href: string;
  external?: boolean;
  variant?: string;
};

interface Props {
  label?: string;
  title?: string;
  intro?: string;
  catRoomHref?: string;
  generalHref?: string;
  offline?: typeof home.donations.offline;
  tiles?: DonateTile[];
}

const {
  label = home.donations.label,
  title = home.donations.title,
  intro = home.donations.intro,
  catRoomHref = home.donations.cat_room.href,
  generalHref = home.donations.general.href,
  offline = home.donations.offline,
  tiles = home.donations.tiles as DonateTile[],
} = Astro.props;
---

<div
  class="wp-block-group alignwide home-editable-section is-layout-constrained mx-auto w-full min-w-0 max-w-[var(--monroe-home-content-max)] box-border scroll-mt-[calc(var(--monroe-nav-height,96px)+var(--monroe-sticky-wayfinding-offset,0px)+var(--monroe-scroll-anchor-gap,12px))]"
>
  <div
    id="Donations"
    class="home-editable-runtime-card home-don-card overflow-visible rounded-[28px] border border-[rgba(36,72,67,0.12)] shadow-[0_28px_60px_rgba(31,53,51,0.1)]"
  >
    <p
      class="m-0 mb-3 font-['Jost','Segoe_UI',sans-serif] text-[0.8rem] font-bold uppercase leading-tight tracking-[0.16em] text-teal-700"
    >
      {label}
    </p>
    <h2
      class="m-0 mb-3 font-serif text-[clamp(2rem,4vw,3.6rem)] font-normal leading-none text-[#153635]"
    >
      {title}
    </h2>
    <p
      class="m-0 max-w-3xl font-['Questrial','Segoe_UI',sans-serif] text-[1.02rem] font-normal leading-[1.8] text-[#405757]"
    >
      {intro}
    </p>

    <div class="mt-6">
      <div class="home-don-paypal-split grid grid-cols-1 items-stretch gap-[clamp(1rem,3vw,2rem)] md:grid-cols-2">
        <div class="min-w-0">
          <iframe
            src={catRoomHref}
            class="home-don-iframe"
            title="Donate to the Cat Room"
            loading="lazy"
          ></iframe>
        </div>
        <div class="min-w-0">
          <iframe
            src={generalHref}
            class="home-don-iframe"
            title="Make a Difference"
            loading="lazy"
          ></iframe>
        </div>
      </div>

      <div class="home-don-offline mt-8">
        <div>
          <h4 class="m-0 mb-1 text-base font-semibold text-[#153635]">{offline.title}</h4>
          <p class="m-0 text-[0.82rem] text-[rgba(22,52,51,0.75)]">{offline.label}</p>
        </div>
        <div class="mt-2">
          <div class="text-[1.75rem] font-extrabold tracking-[-0.02em] text-teal-700">
            {offline.amount}
          </div>
          <div class="text-[0.82rem] text-[rgba(22,52,51,0.72)]">{offline.caption}</div>
        </div>
      </div>
    </div>

    <div class="home-don-give-grid mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
      {
        tiles.map((tile) => (
          <div class="flex min-w-0">
            <div
              class="home-don-tile flex w-full min-h-full flex-col"
              id={tile.title === 'Volunteer' ? 'Volunteer' : undefined}
            >
              <h3 class="home-don-tile__title m-0 mb-[0.45rem] border-b-2 border-teal-700/20 pb-2 font-serif text-[clamp(1.28rem,2.4vw,1.52rem)] font-normal leading-[1.12] tracking-[0.01em] text-[#153635]">
                {tile.title}
              </h3>
              <p class="mb-4 flex-1 font-['Questrial','Segoe_UI',sans-serif] text-[0.97rem] font-normal leading-[1.62] text-[#3d5555]">
                {tile.copy}
              </p>
              <div class="mt-auto w-full">
                <a
                  class:list={[
                    'home-don-tile__btn inline-flex w-full box-border items-center justify-center rounded-full px-4 py-[0.65rem] text-center font-["Jost","Segoe_UI",sans-serif] text-[0.92rem] font-semibold no-underline transition-opacity duration-200 hover:opacity-90 focus-visible:opacity-90',
                    tile.variant === 'outline' ? 'is-outline' : 'is-solid',
                  ]}
                  href={tile.href}
                  {...(tile.external ? { target: '_blank', rel: 'noreferrer noopener' } : {})}
                >
                  {tile.button}
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .home-don-card {
    padding: var(--monroe-home-card-pad, clamp(1.5rem, 3.5vw, 2.5rem));
    background: linear-gradient(140deg, rgba(255, 255, 255, 0.98), rgba(249, 246, 239, 0.96));
  }

  .home-don-iframe {
    display: block;
    width: 100%;
    height: 550px;
    border: 1px solid rgba(15, 118, 110, 0.15);
    border-radius: 1rem;
    box-shadow: 0 20px 48px rgba(17, 41, 41, 0.12);
    background: #fff;
  }

  .home-don-offline {
    padding: 1rem 1.15rem;
    border-radius: 0.75rem;
    background: rgba(15, 118, 110, 0.06);
    border: 1px dashed rgba(15, 118, 110, 0.25);
  }

  .home-don-tile {
    margin: 0;
    padding: clamp(1.2rem, 2.8vw, 1.55rem);
    border-radius: 20px;
    border: 1px solid rgba(36, 72, 67, 0.11);
    background: linear-gradient(
      168deg,
      #ffffff 0%,
      rgba(252, 250, 246, 0.98) 55%,
      rgba(245, 250, 248, 0.92) 100%
    );
    box-shadow: 0 12px 32px rgba(17, 41, 41, 0.07);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .home-don-tile:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 40px rgba(15, 118, 110, 0.1);
  }

  .home-don-tile__btn.is-solid {
    background: #173a39;
    color: #fff;
    border: 0;
  }

  .home-don-tile__btn.is-outline {
    background: transparent;
    color: #173a39;
    border: 2px solid rgba(23, 58, 57, 0.55);
  }

  @media (max-width: 900px) {
    .home-don-paypal-split {
      grid-template-columns: 1fr;
    }
    .home-don-iframe {
      min-height: 420px;
      height: 420px;
    }
  }

  @media (max-width: 768px) {
    .home-don-give-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
