---
interface Props {
  home: any;
  reviews: any[];
}
const { home, reviews } = Astro.props;
---
<div class="max-w-[1400px] mx-auto px-6 lg:px-12 py-16" id="Testimonials">
  <div class="bg-white rounded-3xl p-8 sm:p-12 border border-gray-100 shadow-sm text-center">
    <div class="max-w-3xl mx-auto mb-12">
      <p class="text-emerald-500 font-bold uppercase tracking-widest text-sm mb-3">{home.testimonials.label}</p>
      <h2 class="text-4xl md:text-5xl font-serif tracking-tight text-teal-900 mb-6 leading-tight">{home.testimonials.title}</h2>
      <p class="text-lg text-gray-700 leading-relaxed">{home.testimonials.intro}</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 text-left">
      {reviews.slice(0, 6).map((review: any) => (
        <figure class="bg-gray-50 p-8 rounded-2xl border border-gray-100 flex flex-col h-full shadow-sm">
          <div class="text-emerald-400 text-2xl mb-4">
            {"⭐".repeat(review.rating || 5)}
          </div>
          <blockquote class="text-gray-700 italic mb-6 flex-grow leading-relaxed">
            "{review.text}"
          </blockquote>
          <figcaption class="mt-auto border-t border-gray-200 pt-4 flex flex-col">
            <span class="font-bold text-teal-900">{review.author}</span>
            <span class="text-sm text-gray-500">Google Review</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</div>