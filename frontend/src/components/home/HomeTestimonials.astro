---
interface Props { home: any; reviews: any[]; }
const { home, reviews } = Astro.props;
---
<section id="Testimonials" class="py-20 lg:py-32 bg-cream-100 bg-[#fffaf2]">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-24">
      <span class="text-sm font-bold uppercase tracking-widest text-emerald-600 mb-4 block">{home.testimonials.label}</span>
      <h2 class="text-4xl md:text-5xl font-serif text-teal-950 tracking-tight leading-tight mb-6">{home.testimonials.title}</h2>
      <p class="text-lg text-slate-600 leading-relaxed">{home.testimonials.intro}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {reviews.slice(0, 6).map((review) => (
        <div class="bg-white rounded-[2rem] p-8 lg:p-10 shadow-[0_8px_30px_rgb(0,0,0,0.03)] border border-slate-100 relative flex flex-col h-full hover:shadow-[0_8px_30px_rgb(0,0,0,0.06)] transition-shadow">
          <div class="text-amber-400 flex gap-1 mb-6">
            {"Ҷ".repeat(review.rating || 5)}
          </div>
          <p class="text-slate-600 italic leading-relaxed mb-8 flex-grow">"{review.text}"</p>
          <div class="flex items-center gap-4 mt-auto border-t border-slate-100 pt-6">
            <div class="w-12 h-12 bg-teal-50 rounded-full flex items-center justify-center text-teal-900 font-bold uppercase">
              {(review.author || 'A').charAt(0)}
            </div>
            <div>
              <p class="font-bold text-teal-950">{review.author || 'Adopter'}</p>
              <p class="text-sm text-slate-500">Google Review</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
