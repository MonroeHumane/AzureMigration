---
/**
 * Native Astro homepage intro / About Our Shelter card (Phase 3).
 * Preserves `#Intro` for Header / side-dock deep links.
 * Keeps `home-editable-intro-card` + wp-block column BEM so monroe-home.css
 * intro chrome stays pixel-parity (hybrid; Tailwind port after soak/purge).
 */
import home from '../../data/homepage.json';
import { SITE } from '../../config/site';

interface Props {
  pill?: string;
  title?: string;
  copy?: string;
  callButton?: string;
  phoneTel?: string;
  stats?: typeof home.intro.stats;
}

const {
  pill = home.intro.pill,
  title = home.intro.title,
  copy = home.intro.copy,
  callButton = home.intro.call_button,
  phoneTel = SITE.contact.phoneTel,
  stats = home.intro.stats,
} = Astro.props;
---

<div class="wp-block-group alignwide home-editable-section is-layout-constrained">
  <div class="wp-block-group home-editable-intro-card is-layout-constrained" id="Intro">
    <div class="wp-block-columns are-vertically-aligned-center is-layout-flex">
      <div class="wp-block-column is-vertically-aligned-center is-layout-flow" style="flex-basis:65%">
        <p class="home-editable-pill wp-block-paragraph">{pill}</p>
        <h2 class="wp-block-heading">{title}</h2>
        <p class="wp-block-paragraph">{copy}</p>
        <div class="wp-block-buttons is-layout-flex">
          <div class="wp-block-button">
            <a class="wp-block-button__link has-base-color has-contrast-background-color has-text-color has-background wp-element-button" href={phoneTel}>{callButton}</a>
          </div>
        </div>
      </div>
      <div class="wp-block-column is-layout-flow" style="flex-basis:35%">
        <div class="home-editable-stat-grid">
          {stats.map((s) => (
            <div class:list={['home-editable-stat', { 'is-accent': s.accent }]}>
              <strong>{s.kicker}</strong>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
