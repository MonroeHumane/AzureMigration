---
interface Props {
  home: any;
}
const { home } = Astro.props;
---
<div class="max-w-7xl mx-auto px-4 py-16" id="FAQ">
  <div class="bg-white rounded-3xl p-8 sm:p-12 border border-gray-100 shadow-sm">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <p class="text-emerald-500 font-bold uppercase tracking-widest text-sm mb-3">{home.faq.label}</p>
      <h2 class="text-4xl font-serif text-teal-900 mb-6 leading-tight">{home.faq.title}</h2>
      <p class="text-lg text-gray-700 leading-relaxed">{home.faq.intro}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {home.faq.tiles.map((tile: any) => (
        <div class="bg-gray-50 p-8 rounded-2xl border border-gray-100 flex flex-col h-full">
          <h3 class="text-2xl font-serif text-teal-900 mb-4">{tile.title}</h3>
          <p class="text-gray-600 mb-8 flex-grow">{tile.copy}</p>
          <div>
            <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-8 py-3.5 rounded-full transition-all shadow-md hover:-translate-y-1 bg-teal-900 text-white hover:bg-teal-700" 
               href={tile.href} 
               {...(tile.external ? { target: '_blank', rel: 'noreferrer noopener' } : {})}>
               {tile.button}
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>