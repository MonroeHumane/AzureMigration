---
interface Props { home: any; }
const { home } = Astro.props;
---
<section id="FAQ" class="py-20 lg:py-32 bg-slate-50">
  <div class="max-w-[1000px] mx-auto px-6 lg:px-12">
    <div class="text-center mb-16 lg:mb-20">
      <span class="text-sm font-bold uppercase tracking-widest text-emerald-600 mb-4 block">{home.faq.label}</span>
      <h2 class="text-4xl md:text-5xl font-serif text-teal-950 tracking-tight leading-tight mb-6">{home.faq.title}</h2>
      <p class="text-lg text-slate-600 leading-relaxed">{home.faq.intro}</p>
    </div>
    <div class="space-y-4">
      {home.faq.tiles.map((tile: any) => (
        <details class="group bg-white rounded-2xl border border-slate-200 overflow-hidden [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between p-6 lg:p-8 cursor-pointer font-bold text-lg text-teal-950 hover:text-emerald-600 transition-colors focus:outline-none">
            {tile.q}
            <span class="ml-6 flex-shrink-0 relative w-6 h-6 text-teal-900 group-hover:text-emerald-600">
              <span class="absolute inset-0 bg-current rounded-full w-6 h-0.5 top-1/2 -translate-y-1/2 transition-transform duration-300"></span>
              <span class="absolute inset-0 bg-current rounded-full w-0.5 h-6 left-1/2 -translate-x-1/2 transition-transform duration-300 group-open:rotate-90"></span>
            </span>
          </summary>
          <div class="px-6 pb-6 lg:px-8 lg:pb-8 text-slate-600 leading-relaxed prose prose-teal max-w-none" set:html={tile.a} />
        </details>
      ))}
    </div>
  </div>
</section>
