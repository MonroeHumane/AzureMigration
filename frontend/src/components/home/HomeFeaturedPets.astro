---
import PetCard from '../PetCard.astro';
import type { Pet } from '../../lib/directus';

interface Props {
  home: any;
  pets: Pet[];
}

const { home, pets } = Astro.props;
---
<section class="w-full max-w-[1400px] mx-auto px-6 lg:px-12 py-16 lg:py-24" id="FeaturedPets">
  <div class="text-center max-w-3xl mx-auto mb-16">
    <h2 class="text-4xl md:text-5xl font-serif text-teal-950 mb-6 tracking-tight leading-tight">{home.featured_pets.title}</h2>
    <p class="text-lg md:text-xl text-gray-600 leading-relaxed">{home.featured_pets.copy}</p>
  </div>

  <div class="bg-gradient-to-b from-teal-50/80 to-white rounded-[2.5rem] p-8 md:p-12 lg:p-16 shadow-xl border border-teal-100/50">
    <div class="flex flex-col sm:flex-row items-center justify-between mb-12 gap-6 border-b border-teal-900/10 pb-8">
      <h3 class="text-2xl md:text-3xl font-serif text-teal-900 flex items-center gap-4">
        <span class="relative flex h-4 w-4">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-4 w-4 bg-emerald-500 shadow-sm"></span>
        </span>
        Longest Residents
      </h3>
      <a class="inline-flex items-center justify-center font-bold uppercase tracking-widest px-8 py-3.5 rounded-full bg-teal-900 text-white transition-all shadow-md hover:bg-emerald-600 hover:-translate-y-0.5 text-sm" href="/adopt">Search All Pets &rarr;</a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
      {pets.map((pet) => (
        <div class="transition-transform duration-300 hover:-translate-y-2">
          <PetCard pet={pet} />
        </div>
      ))}
    </div>
  </div>
</section>
