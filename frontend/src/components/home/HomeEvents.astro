---
import type { Pet } from '../../lib/directus';
interface Props {
  home: any;
  latestEvent: any;
  nextEvent: any;
  pets: Pet[];
}
const { home, latestEvent, nextEvent, pets } = Astro.props;
const formatDate = (value: string | undefined, fallback: string) => {
  if (!value) return fallback;
  const d = new Date(value);
  if (isNaN(d.getTime())) return fallback;
  return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
};
---
<section id="Events" class="py-20 lg:py-32 bg-white">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="flex flex-col lg:flex-row items-end justify-between mb-16 gap-6">
      <div class="max-w-2xl">
        <span class="text-sm font-bold uppercase tracking-widest text-emerald-600 mb-4 block">{home.events_feature.kicker}</span>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-serif text-teal-950 tracking-tight leading-tight">
          {latestEvent ? latestEvent.title : home.events_feature.title}
        </h2>
      </div>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <div class="lg:col-span-8 bg-slate-50 rounded-[2.5rem] p-8 md:p-12 border border-slate-100 flex flex-col lg:flex-row gap-12 items-center">
        <div class="flex-1 w-full relative">
          <div class="aspect-[4/5] rounded-[2rem] overflow-hidden shadow-2xl relative group">
             <a href={latestEvent ? (latestEvent.link_url || '/events') : home.events_feature.cta.href} class="block absolute inset-0 z-20"></a>
             <img src={latestEvent ? `https://directus.monroe-humane.org/assets/${latestEvent.image}` : home.events_feature.flyer_image} alt={latestEvent ? latestEvent.title : home.events_feature.flyer_alt} class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
          </div>
        </div>
        <div class="flex-1 w-full">
          <p class="text-emerald-600 font-bold mb-4 bg-emerald-50 inline-block px-4 py-2 rounded-full text-sm">
            {latestEvent ? formatDate(latestEvent.event_date, home.events_feature.deadline) : home.events_feature.deadline}
          </p>
          <p class="text-lg text-slate-600 leading-relaxed mb-6 font-medium">
            {latestEvent ? latestEvent.description : home.events_feature.body[0]}
          </p>
          {!latestEvent && home.events_feature.body.slice(1).map((p: string) => (
            <p class="text-slate-600 mb-4 leading-relaxed">{p}</p>
          ))}
          {home.events_feature.note && <p class="text-sm text-slate-500 italic mb-8">{home.events_feature.note}</p>}
          <a href={latestEvent ? (latestEvent.link_url || '/events') : home.events_feature.cta.href} class="inline-flex items-center justify-center px-8 py-4 bg-teal-900 text-white rounded-full font-bold shadow-md hover:bg-emerald-600 hover:-translate-y-1 transition-all">
            {latestEvent ? 'Learn More' : home.events_feature.cta.label}
          </a>
        </div>
      </div>
      <div class="lg:col-span-4 flex flex-col gap-8">
         <div class="bg-teal-950 rounded-[2.5rem] p-8 md:p-10 text-white flex-1 relative overflow-hidden">
            <h3 class="font-bold uppercase tracking-widest text-xs mb-6 text-emerald-400 border-b border-white/10 pb-4">{home.events_feature.ways_title}</h3>
            <ul class="space-y-6">
              {home.events_feature.ways.map((w: any) => (
                <li class="flex gap-4">
                  <span class="text-2xl">{w.icon}</span>
                  <span class="text-teal-100/90 leading-relaxed">{w.text}</span>
                </li>
              ))}
            </ul>
         </div>
      </div>
    </div>
  </div>
</section>
