---
interface Props { home: any; }
const { home } = Astro.props;
---
<section id="Contact" class="py-20 lg:py-32 bg-slate-50 relative">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="bg-white rounded-[3rem] shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-slate-100 p-8 lg:p-16 flex flex-col lg:flex-row gap-12 lg:gap-24">
      <div class="lg:w-1/2">
        <span class="text-sm font-bold uppercase tracking-widest text-emerald-600 mb-4 block">{home.contact.pill}</span>
        <h2 class="text-4xl md:text-5xl font-serif text-teal-950 mb-6 tracking-tight leading-tight">{home.contact.title}</h2>
        <p class="text-lg text-slate-600 leading-relaxed mb-10">{home.contact.intro}</p>
        <p class="text-xs font-bold tracking-widest uppercase text-slate-400 mb-6 pb-4 border-b border-slate-100">{home.contact.lead}</p>
        <form class="monroe-contact-form flex flex-col gap-4 mb-10" data-monroe-contact-mailto data-email={home.contact.email}>
          <div class="grid grid-cols-2 gap-4">
            <input type="text" placeholder="Name" class="p-4 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500" />
            <input type="email" placeholder="Email" class="p-4 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500" />
          </div>
          <textarea placeholder="Message" rows="4" class="p-4 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500"></textarea>
          <button type="submit" class="inline-flex items-center justify-center px-8 py-4 bg-teal-900 text-white font-bold rounded-full transition-all hover:bg-emerald-600 shadow-md">
            {home.contact.submit}
          </button>
        </form>
      </div>
      <div class="lg:w-1/2 flex flex-col justify-center items-center bg-teal-50 rounded-[2rem] p-12 text-center border border-teal-100">
        <div class="w-20 h-20 bg-teal-900 rounded-full flex items-center justify-center text-white mb-6 shadow-lg">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
        </div>
        <h3 class="text-2xl font-serif text-teal-950 mb-4">Give us a ring</h3>
        <p class="text-slate-600 mb-8 max-w-sm">Need immediate assistance or have specific questions about adoption?</p>
        <a href="tel:7342433669" class="inline-flex items-center justify-center px-8 py-4 bg-white text-teal-900 border border-slate-200 font-bold rounded-full transition-all hover:bg-teal-50 shadow-sm">
          {home.contact.call_button}
        </a>
      </div>
    </div>
  </div>
</section>
