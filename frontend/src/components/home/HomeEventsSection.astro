---
/**
 * Native Astro homepage Events band (Phase 3).
 * Replaces the WP-era `#Events` winner feature + upcoming-event hero.
 * Uses the same Directus `getEventFlyers()` path as `/events` for the
 * next-event spotlight; optional upcoming flyers strip for image flyers.
 * Preserves `#Events` + `data-home-nav-section="Events"` for side-dock / TOC.
 *
 * Note: legacy side `.home-editable-flyers-rail` markup is already absent from
 * the homepage (CSS-only orphan under `home-editable-has-flyers-rail`).
 */
import type { EventFlyer, Pet } from '../../lib/directus';
import home from '../../data/homepage.json';

interface NextEventView {
  kicker: string;
  date: string;
  title: string;
  time: string;
  buttons: Array<{ label: string; href?: string; variant?: string }>;
}

interface Props {
  pets: Pet[];
  latestEvent?: EventFlyer | null;
  nextEvent: NextEventView;
  /** Upcoming published flyers for the horizontal rail (same Directus source as /events). */
  upcomingFlyers?: EventFlyer[];
  eventsFeature?: typeof home.events_feature;
}

const {
  pets,
  latestEvent = null,
  nextEvent,
  upcomingFlyers = [],
  eventsFeature = home.events_feature,
} = Astro.props;

const slideCount = Math.max(pets.length, 1);
const slideDurationSec = slideCount * 4;

const googleCalHref = latestEvent
  ? `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(latestEvent.title || '')}&dates=${(latestEvent.event_date || '').replace(/-/g, '')}/${(latestEvent.event_date || '').replace(/-/g, '')}&details=${encodeURIComponent(latestEvent.description || '')}&location=Monroe%2C%20MI`
  : '';

const flyerRail = upcomingFlyers
  .filter((f) => f.image && f.image.trim() !== '')
  .slice(0, 6);

const formatFlyerDate = (value?: string) => {
  if (!value) return '';
  const d = new Date(`${value}T12:00:00Z`);
  return Number.isNaN(d.getTime())
    ? ''
    : d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
};
---

<div
  id="Events"
  class="home-editable-events-band wp-block-group alignwide home-editable-section is-layout-constrained flex flex-col gap-[clamp(1.25rem,2.5vw,2rem)] scroll-mt-[calc(var(--monroe-nav-height,96px)+var(--monroe-sticky-wayfinding-offset,0px)+var(--monroe-scroll-anchor-gap,12px))] relative z-[3] mt-[clamp(1.15rem,3vw,1.85rem)]"
>
  <!-- Contest / events feature (winner announcement) -->
  <section
    class="home-events-feature relative isolate mx-auto w-full max-w-full overflow-hidden rounded-[22px] border border-slate-900/12 bg-white p-[clamp(18px,2.6vw,34px)] shadow-[0_18px_40px_rgba(0,0,0,0.10),0_2px_10px_rgba(0,0,0,0.06)]"
    data-home-nav-section="Events"
    aria-labelledby="hs-shirt-artwork-contest-title"
  >
    <div
      class="pointer-events-none absolute inset-0 z-0 rounded-[22px] shadow-[inset_0_1px_0_rgba(255,255,255,0.75)]"
      aria-hidden="true"
    >
    </div>
    <div class="relative z-[1] mx-auto max-w-[760px] text-center">
      <p
        class="mb-2.5 inline-flex items-center justify-center gap-2.5 font-['Jost','Segoe_UI',sans-serif] text-[12px] font-bold uppercase leading-tight tracking-[0.22em] text-slate-900/80"
      >
        <span
          class="inline-block h-0.5 w-[18px] rounded-full bg-[linear-gradient(90deg,#2f7d0b,#3aa313)]"
          aria-hidden="true"
        ></span>
        {eventsFeature.kicker}
      </p>
      <h2
        id="hs-shirt-artwork-contest-title"
        class="mb-[18px] font-serif text-[clamp(30px,3.4vw,48px)] font-normal leading-[1.1] tracking-[-0.01em] text-[#2f7d0b] [text-shadow:0_1px_0_rgba(255,255,255,0.7)]"
      >
        {eventsFeature.title}
      </h2>
      {
        eventsFeature.body.map((p) => (
          <p class="mx-auto mb-4 max-w-[66ch] font-['Questrial','Segoe_UI',sans-serif] text-[17px] font-normal leading-[1.75] text-slate-600">
            {p}
          </p>
        ))
      }
      <p
        class="mb-5 rounded-2xl border border-[#2f7d0b]/18 bg-[linear-gradient(180deg,rgba(47,125,11,0.08),rgba(47,125,11,0.04))] px-4 py-3.5 font-['Jost','Segoe_UI',sans-serif] text-[15px] font-semibold leading-[1.65] text-slate-900 shadow-[0_10px_22px_rgba(47,125,11,0.10)]"
      >
        <span aria-hidden="true">🐾 </span>{eventsFeature.note}
      </p>
      {
        eventsFeature.letter_href && (
          <p class="mx-auto mb-0 max-w-[66ch] font-['Questrial','Segoe_UI',sans-serif] text-[17px] leading-[1.75] text-slate-600">
            <a
              href={eventsFeature.letter_href}
              class="font-semibold text-teal-800 underline decoration-teal-700/30 underline-offset-2 transition hover:text-teal-700 hover:decoration-teal-700"
            >
              {eventsFeature.letter_label || 'Read the letter'}
            </a>
          </p>
        )
      }
    </div>
  </section>

  <!-- Upcoming / next event hero (Directus flyers → nextEvent) -->
  <div class="home-editable-upcoming-event-section m-0 p-0">
    <div
      class="overflow-hidden rounded-[28px] border border-teal-900/12 bg-white shadow-[0_28px_60px_rgba(31,53,51,0.1)]"
    >
      <div class="grid grid-cols-1 items-stretch min-[769px]:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
        <div class="min-h-0">
          {
            pets.length > 0 ? (
              <div
                class="home-events-slideshow relative m-0 min-h-[320px] overflow-hidden bg-[linear-gradient(135deg,#0f766e,#173a39)] min-[769px]:min-h-[420px]"
                aria-hidden="true"
              >
                {pets.map((pet, i) => (
                  <img
                    src={pet.image}
                    alt=""
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    class="home-events-slide absolute inset-0 h-full w-full object-cover"
                    style={`animation-duration: ${slideDurationSec}s; animation-delay: ${i * 4}s`}
                  />
                ))}
              </div>
            ) : (
              <div
                class="flex min-h-[320px] items-center justify-center bg-[linear-gradient(135deg,#0f766e,#173a39)] text-white/85 min-[769px]:min-h-[420px]"
                aria-hidden="true"
              >
                <svg
                  class="h-12 w-12 text-teal-300/60"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"
                  />
                </svg>
              </div>
            )
          }
        </div>

        <div class="flex flex-col justify-center p-[clamp(1.5rem,3.5vw,2.5rem)]">
          <p
            class="mb-2 inline-flex w-fit items-center gap-2 rounded-full bg-teal-700/12 px-[0.7rem] py-[0.35rem] font-['Jost','Segoe_UI',sans-serif] text-[0.76rem] font-bold uppercase tracking-[0.12em] text-teal-700"
          >
            {nextEvent.kicker}
          </p>
          <p
            class="mb-[0.85rem] inline-flex w-fit items-center gap-2 rounded-full bg-teal-700/12 px-[0.7rem] py-[0.35rem] font-['Jost','Segoe_UI',sans-serif] text-[0.76rem] font-bold uppercase tracking-[0.12em] text-teal-700"
          >
            {nextEvent.date}
          </p>
          <h2 class="m-0 mb-3 font-serif text-[clamp(2rem,4vw,3.6rem)] font-normal leading-none text-[#153635]">
            {nextEvent.title}
          </h2>
          <p class="m-0 mb-5 font-['Questrial','Segoe_UI',sans-serif] text-[1.02rem] leading-[1.8] text-[#405757]">
            {nextEvent.time}
          </p>

          <div class="flex flex-wrap items-center gap-2">
            <a
              href={nextEvent.buttons[0]?.href || '/events'}
              class="inline-flex items-center justify-center rounded-full bg-[#2bb8f3] px-[1.25rem] py-2.5 text-[0.9rem] font-bold text-[#082021] no-underline shadow-sm transition hover:-translate-y-px hover:brightness-105 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400"
            >
              {nextEvent.buttons[0]?.label || 'View event details'}
            </a>
            <a
              href={nextEvent.buttons[1]?.href || '/events'}
              class="inline-flex items-center justify-center rounded-full border-2 border-teal-800/25 bg-transparent px-[1.25rem] py-2.5 text-[0.9rem] font-bold text-teal-900 no-underline transition hover:border-teal-800/45 hover:bg-teal-900/5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-500"
            >
              {nextEvent.buttons[1]?.label || 'Full event calendar'}
            </a>
            {
              latestEvent && (
                <div class="mt-1 inline-flex items-center gap-1.5 text-xs sm:mt-0">
                  <a
                    href={googleCalHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 rounded-lg border border-teal-900/20 bg-teal-900/10 px-2.5 py-1.5 font-semibold text-teal-900 transition hover:bg-teal-900/20"
                    title="Add to Google Calendar"
                  >
                    <svg
                      class="h-3.5 w-3.5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    <span>+ Google</span>
                  </a>
                  <a
                    href="/events.ics"
                    class="inline-flex items-center gap-1 rounded-lg border border-teal-900/20 bg-teal-900/10 px-2.5 py-1.5 font-semibold text-teal-900 transition hover:bg-teal-900/20"
                    title="Subscribe to all shelter events (.ics)"
                  >
                    <span>Subscribe (.ics)</span>
                  </a>
                </div>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Upcoming flyers rail (Directus event_flyers, same source as /events) -->
  {
    flyerRail.length > 0 && (
      <section
        class="home-events-flyers-rail rounded-[22px] border border-teal-900/10 bg-[#fffdf9] p-[clamp(1rem,2.5vw,1.5rem)] shadow-[0_12px_28px_rgba(15,30,29,0.06)]"
        aria-label="Upcoming event flyers"
      >
        <div class="mb-3 flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="m-0 mb-1 font-['Jost','Segoe_UI',sans-serif] text-[0.72rem] font-bold uppercase tracking-[0.14em] text-teal-900/70">
              Event flyers
            </p>
            <h3 class="m-0 font-serif text-[clamp(1.35rem,2.4vw,1.85rem)] font-normal leading-tight text-[#153635]">
              Coming up from the calendar
            </h3>
          </div>
          <a
            href="/events"
            class="inline-flex items-center gap-1 text-sm font-bold text-teal-800 no-underline transition hover:text-teal-700"
          >
            <span>All events</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <ul class="m-0 flex list-none gap-3 overflow-x-auto p-0 pb-1 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          {flyerRail.map((flyer) => (
            <li class="w-[min(220px,70vw)] shrink-0">
              <a
                href={flyer.link_url || '/events'}
                target={flyer.link_url ? '_blank' : undefined}
                rel={flyer.link_url ? 'noopener noreferrer' : undefined}
                class="group relative block overflow-hidden rounded-[12px] shadow-[0_8px_20px_rgba(15,30,29,0.14)] transition hover:-translate-y-0.5 hover:shadow-[0_12px_28px_rgba(15,30,29,0.2)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-500"
                title={flyer.title}
              >
                <img
                  src={flyer.image}
                  alt={flyer.title}
                  class="block h-auto w-full rounded-lg object-cover"
                  loading="lazy"
                  decoding="async"
                />
                <span class="pointer-events-none absolute inset-x-0 bottom-0 bg-[rgba(15,30,29,0.72)] px-2.5 py-1.5 text-center text-[0.68rem] font-bold tracking-[0.05em] text-white opacity-0 backdrop-blur-[4px] transition group-hover:opacity-100 group-focus-visible:opacity-100">
                  View flyer ↗
                </span>
              </a>
              <p class="mt-2 truncate text-sm font-bold text-teal-900">{flyer.title}</p>
              {flyer.event_date && (
                <p class="m-0 text-xs font-semibold uppercase tracking-wider text-emerald-800">
                  {formatFlyerDate(flyer.event_date)}
                </p>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }
</div>

<style>
  .home-events-slide {
    opacity: 0;
    animation-name: homeEventsNextSlide;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  @keyframes homeEventsNextSlide {
    0% {
      opacity: 0;
    }
    3% {
      opacity: 1;
    }
    17% {
      opacity: 1;
    }
    22% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-events-slide {
      animation: none !important;
      opacity: 0;
    }
    .home-events-slide:first-child {
      opacity: 1;
    }
  }
</style>
