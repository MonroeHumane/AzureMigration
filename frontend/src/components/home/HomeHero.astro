---
interface Props {
  home: any;
}
const { home } = Astro.props;
---
<section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden bg-slate-900" id="Top">
  <!-- Video Background with Gradient Overlay -->
  <div class="absolute inset-0 z-0">
    <video class="w-full h-full object-cover" muted loop playsinline autoplay poster={home.hero.video_poster} src={home.hero.video_src}></video>
    <div class="absolute inset-0 bg-gradient-to-b from-slate-900/80 via-slate-900/60 to-slate-900/90 mix-blend-multiply"></div>
  </div>
  
  <div class="relative z-10 w-full max-w-[1400px] mx-auto px-6 lg:px-12 sm:px-6 md:px-8 py-20 lg:py-32 flex flex-col items-center text-center mt-16">
    
    <!-- Kicker -->
    <div class="mb-6">
      <span class="inline-block py-1.5 px-4 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm font-semibold tracking-widest uppercase backdrop-blur-sm shadow-lg">
        {home.hero.display}
      </span>
    </div>

    <!-- Title -->
    <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-serif text-white mb-8 tracking-tight leading-tighter drop-shadow-2xl max-w-5xl mx-auto">
      {home.hero.title}
    </h1>

    <!-- Subtitle -->
    <p class="text-xl sm:text-2xl text-slate-300 mb-12 leading-relaxed max-w-3xl mx-auto font-medium">
      {home.hero.copy}
    </p>

    <!-- Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 justify-center w-full sm:w-auto mb-20">
      <a class="flex items-center justify-center px-8 py-4 bg-emerald-500 text-slate-900 rounded-full font-bold text-lg tracking-wide transition-all hover:bg-emerald-400 shadow-[0_0_40px_-10px_rgba(16,185,129,0.5)] hover:-translate-y-1" href="/adoptions">
        {home.hero.buttons[1].label}
      </a>
      <a class="flex items-center justify-center px-8 py-4 bg-white/10 text-white border border-white/20 backdrop-blur-md rounded-full font-bold text-lg tracking-wide transition-all hover:bg-white/20 hover:border-white/40 shadow-lg hover:-translate-y-1" href="/adopt">
        {home.hero.buttons[0].label}
      </a>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full max-w-4xl mx-auto text-left">
      {home.hero.stats.map((s: any) => (
        <div class="relative group overflow-hidden rounded-2xl bg-white/5 backdrop-blur-md border border-white/10 p-8 transition-all hover:bg-white/10 hover:border-white/20">
          <div class="relative z-10">
            <strong class="block text-xs uppercase tracking-widest text-emerald-400 mb-3 font-semibold">{s.kicker}</strong>
            <h3 class="text-4xl md:text-5xl font-serif tracking-tight text-white mb-2">{s.title}</h3>
            <p class="text-slate-300 text-sm leading-relaxed">{s.body}</p>
          </div>
          {s.accent && <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/10 to-transparent z-0"></div>}
        </div>
      ))}
    </div>
  </div>
</section>
