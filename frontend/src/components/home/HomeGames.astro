---
interface Props { home: any; }
const { home } = Astro.props;
---
<section id="Games" class="py-20 lg:py-32 bg-emerald-500 text-teal-950 overflow-hidden relative">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12 relative z-10 text-center">
    <div class="max-w-4xl mx-auto">
      <span class="inline-block px-4 py-1.5 bg-white text-emerald-600 rounded-full font-bold uppercase tracking-widest text-xs mb-6 shadow-sm">
        {home.games.pill}
      </span>
      <h2 class="text-4xl md:text-5xl lg:text-7xl font-serif tracking-tight leading-tight mb-8">
        {home.games.title}
      </h2>
      <p class="text-xl text-teal-900/80 leading-relaxed mb-12 font-medium">
        {home.games.intro}
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        {home.games.teasers.map((t: any) => (
          <div class="bg-white/20 backdrop-blur-sm rounded-2xl p-6 border border-white/30 text-left">
            <h3 class="font-bold text-xl mb-2">{t.title}</h3>
            <p class="text-teal-900 text-sm leading-relaxed">{t.desc}</p>
          </div>
        ))}
      </div>
      <a href="/games" class="inline-flex items-center justify-center px-10 py-5 bg-teal-950 text-white rounded-full font-bold text-lg tracking-wide transition-all shadow-xl hover:-translate-y-1 hover:bg-teal-900">
        {home.games.cta}
      </a>
    </div>
  </div>
</section>
