---
interface Props {
  home: any;
}
const { home } = Astro.props;
---
<div id="Games" class="max-w-[1400px] mx-auto px-6 lg:px-12 py-16">
  <div class="bg-gradient-to-br from-teal-50 to-emerald-50 rounded-3xl p-8 sm:p-12 border border-teal-100 shadow-sm text-center">
    <div class="max-w-3xl mx-auto mb-12">
      <p class="inline-block px-4 py-1.5 bg-white text-teal-700 rounded-full font-bold uppercase tracking-widest text-xs mb-4 shadow-sm">{home.games.pill}</p>
      <h2 class="text-4xl sm:text-5xl font-serif text-teal-900 mb-6 leading-tight" id="home-games-heading">{home.games.title}</h2>
      <p class="text-lg text-teal-800/80 leading-relaxed">{home.games.intro}</p>
    </div>

    <ul class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12 text-left" role="list">
      {home.games.teasers.map((t: any) => (
        <li class="group">
          <a class="block bg-white h-full p-8 rounded-2xl border border-teal-100 shadow-sm hover:shadow-md transition-all hover:-translate-y-1 hover:border-teal-300" href="/games">
            <span class="block text-4xl mb-4 group-hover:scale-110 transition-transform origin-bottom-left" aria-hidden="true">{t.icon}</span>
            <span class="block text-xl font-bold text-teal-900 mb-2">{t.title}</span>
            <span class="block text-teal-700 text-sm leading-relaxed">{t.desc}</span>
          </a>
        </li>
      ))}
    </ul>

    <div>
      <a class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-8 py-4 rounded-full transition-all shadow-md hover:-translate-y-1 bg-teal-700 text-white hover:bg-teal-900" href="/games">
        {home.games.cta}
      </a>
    </div>
  </div>
</div>