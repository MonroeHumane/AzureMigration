---
interface Props { home: any; latestNewsletter: any; }
const { home, latestNewsletter } = Astro.props;
---
<section id="Newsletter" class="py-20 lg:py-32 bg-white">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="bg-teal-950 rounded-[3rem] p-8 lg:p-16 text-white overflow-hidden relative flex flex-col lg:flex-row items-center gap-12 lg:gap-24 shadow-2xl">
      <div class="absolute right-0 top-0 w-1/2 h-full opacity-20 bg-cover bg-center" style={`background-image: url('${latestNewsletter ? latestNewsletter.hero_image : home.newsletter.hero_image}')`}></div>
      <div class="lg:w-1/2 relative z-10">
        <span class="text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4 block">{home.newsletter.label}</span>
        <h2 class="text-4xl md:text-5xl font-serif tracking-tight leading-tight mb-6">{home.newsletter.title}</h2>
        <p class="text-lg text-teal-100/90 leading-relaxed mb-10">{home.newsletter.intro}</p>
        <div class="flex flex-wrap gap-4">
          <a href="/newsletter" class="inline-flex items-center justify-center px-8 py-4 bg-emerald-500 text-teal-950 rounded-full font-bold tracking-wide transition-all shadow-md hover:bg-emerald-400 hover:-translate-y-0.5">
            View Archives
          </a>
          {latestNewsletter && (
            <a href={`/newsletter/issue/${latestNewsletter.slug}`} class="inline-flex items-center justify-center px-8 py-4 bg-white/10 border border-white/20 rounded-full font-bold tracking-wide transition-all hover:bg-white/20">
              Read Latest Issue
            </a>
          )}
        </div>
      </div>
      <div class="lg:w-1/2 relative z-10 w-full">
         <div class="aspect-video rounded-[2rem] overflow-hidden shadow-2xl border border-white/10 group">
           <img src={latestNewsletter ? latestNewsletter.hero_image : home.newsletter.hero_image} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" alt="Newsletter" />
         </div>
      </div>
    </div>
  </div>
</section>
