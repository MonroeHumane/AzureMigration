---
interface Props {
  home: any;
  latestNewsletter: any;
}
const { home, latestNewsletter } = Astro.props;

const formatDate = (value: string | undefined, fallback: string) => {
  if (!value) return fallback;
  const d = new Date(value);
  if (isNaN(d.getTime())) return fallback;
  return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
};
---
<div class="max-w-7xl mx-auto px-4 py-16" id="Newsletter">
  <div class="bg-gray-50 rounded-3xl p-8 sm:p-12 border border-gray-100 shadow-sm">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <p class="text-emerald-500 font-bold uppercase tracking-widest text-sm mb-3">{home.newsletter.label}</p>
      <h2 class="text-4xl font-serif text-teal-900 mb-6 leading-tight">{home.newsletter.title}</h2>
      <p class="text-lg text-gray-700 leading-relaxed">{home.newsletter.intro}</p>
    </div>

    <div class="bg-white rounded-3xl overflow-hidden shadow-lg border border-gray-100">
      <!-- Newsletter Hero -->
      <div class="relative h-64 sm:h-80 md:h-96 w-full">
        <div class="absolute inset-0 bg-teal-900/40 mix-blend-multiply z-10"></div>
        <img src={latestNewsletter ? latestNewsletter.hero_image : home.newsletter.hero_image} 
             alt={latestNewsletter ? latestNewsletter.title : "2025 in Review"} 
             class="absolute inset-0 w-full h-full object-cover z-0" loading="lazy" decoding="async" />
        <div class="absolute inset-0 p-8 flex flex-col justify-end z-20 bg-gradient-to-t from-black/80 via-black/30 to-transparent">
          <p class="text-emerald-400 font-bold uppercase tracking-widest text-sm mb-2">{home.newsletter.eyebrow}</p>
          <h3 class="text-3xl sm:text-5xl font-serif text-white">{latestNewsletter ? "Latest Newsletter" : home.newsletter.label}</h3>
        </div>
      </div>

      <!-- Newsletter Body -->
      <div class="p-8 sm:p-12 flex flex-col lg:flex-row gap-12">
        <!-- Sidebar / Actions -->
        <div class="w-full lg:w-1/3 flex flex-col">
          <h3 class="text-2xl font-bold text-teal-900 mb-2">{latestNewsletter ? latestNewsletter.title : home.newsletter.title}</h3>
          <p class="text-gray-500 font-medium mb-8 pb-8 border-b border-gray-100">
            {latestNewsletter ? formatDate(latestNewsletter.issue_date, home.newsletter.byline) : home.newsletter.byline}
          </p>
          
          <div class="flex flex-col gap-4 mt-auto">
            {latestNewsletter && latestNewsletter.pdf_url && (
              <a href={latestNewsletter.pdf_url} class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-8 py-4 rounded-full transition-all border-2 border-teal-700 text-teal-700 hover:-translate-y-1 hover:bg-teal-50" target="_blank" rel="noopener noreferrer">Download PDF</a>
            )}
            <a href="/newsletter" class="inline-flex items-center justify-center font-bold uppercase tracking-wider px-8 py-4 rounded-full transition-all shadow-md hover:-translate-y-1 bg-emerald-500 text-teal-900 hover:bg-emerald-400">All Issues</a>
          </div>
        </div>

        <!-- Content -->
        <div class="w-full lg:w-2/3 border-t lg:border-t-0 lg:border-l border-gray-100 pt-8 lg:pt-0 lg:pl-12">
          {latestNewsletter ? (
            <div class="prose prose-teal max-w-none prose-lg">
              <p class="text-gray-700 leading-relaxed mb-6">{latestNewsletter.excerpt}</p>
              <a href={`/newsletter/issue/${latestNewsletter.slug}`} class="inline-flex items-center text-teal-700 font-bold hover:text-emerald-600 transition-colors group">
                Read Full Issue 
                <span class="ml-2 group-hover:translate-x-1 transition-transform">&rarr;</span>
              </a>
            </div>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              {home.newsletter.letters.map((letter: any) => (
                <div class="bg-gray-50 p-6 rounded-2xl border border-gray-100">
                  <h4 class="text-xl font-bold text-teal-900 mb-4">{letter.title}</h4>
                  {letter.paragraphs && <p class="text-gray-600 mb-4 line-clamp-4">{letter.paragraphs[0]}</p>}
                  <a href="/newsletter" class="text-teal-700 font-medium hover:text-emerald-600 text-sm">Read More &rarr;</a>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</div>