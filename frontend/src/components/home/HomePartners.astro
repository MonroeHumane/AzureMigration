---
interface Props {
  home: any;
  sponsors: any;
}
const { home, sponsors } = Astro.props;
---
<section class="bg-teal-950 py-20 lg:py-24 overflow-hidden relative">
  <div class="absolute inset-0 bg-[url('/img/pattern.svg')] opacity-5 z-0" aria-hidden="true"></div>
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12 mb-16 text-center text-white relative z-10">
    <h3 class="text-3xl font-serif mb-4">{home.community_partners.title}</h3>
    <p class="text-teal-200/80 max-w-2xl mx-auto text-lg">{home.community_partners.intro}</p>
  </div>
  
  <div id="sponsorMarqueeWidget" class="relative w-full z-10" aria-label="Community partners">
    <div class="flex whitespace-nowrap group">
      {[false, true, true].map((clone) => (
        <div class="flex items-center gap-16 sm:gap-32 px-8 sm:px-16 animate-[marquee_30s_linear_infinite]" aria-hidden={clone ? 'true' : undefined}>
          {sponsors.community_partners.map((p: any) => (
            <img src={p.image} alt={p.name} loading="lazy" decoding="async" class="h-12 md:h-20 w-auto object-contain brightness-0 invert opacity-50 hover:opacity-100 transition-opacity" />
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<section class="max-w-[1400px] mx-auto px-6 lg:px-12 py-20 lg:py-32" id="Membership">
  <div class="bg-slate-50 rounded-[3rem] p-12 sm:p-20 text-center border border-slate-100 shadow-[0_8px_30px_rgb(0,0,0,0.02)] relative overflow-hidden">
    <div class="relative z-10 max-w-3xl mx-auto">
      <span class="text-emerald-500 font-bold uppercase tracking-widest text-sm mb-4 block">{home.membership_home.label}</span>
      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-serif text-teal-950 mb-10 leading-tight">{home.membership_home.title}</h2>
      
      <div class="inline-block bg-white px-10 py-8 rounded-[2rem] shadow-lg border border-slate-100" role="status">
        <p class="text-xl font-bold text-emerald-600 uppercase tracking-widest">{home.membership_home.under_construction}</p>
      </div>
    </div>
  </div>
</section>
<style>
@keyframes marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-100%); }
}
</style>
