---
interface Props {
  home: any;
  sponsors: any;
}
const { home, sponsors } = Astro.props;
---
<div class="bg-teal-900 py-16 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 mb-12 text-center text-white">
    <h3 class="text-2xl font-bold mb-4">{home.community_partners.title}</h3>
    <p class="text-teal-200">{home.community_partners.intro}</p>
  </div>
  
  <section id="sponsorMarqueeWidget" class="relative w-full" aria-label="Community partners">
    <div class="flex whitespace-nowrap group">
      {[false, true, true].map((clone) => (
        <div class="flex items-center gap-12 sm:gap-24 px-6 sm:px-12 animate-[marquee_20s_linear_infinite]" aria-hidden={clone ? 'true' : undefined}>
          {sponsors.community_partners.map((p: any) => (
            <img src={p.image} alt={p.name} loading="lazy" decoding="async" class="h-12 md:h-16 w-auto object-contain brightness-0 invert opacity-70 hover:opacity-100 transition-opacity" />
          ))}
        </div>
      ))}
    </div>
  </section>
</div>

<div class="max-w-7xl mx-auto px-4 py-16" id="Membership">
  <div class="bg-teal-50 rounded-3xl p-8 sm:p-12 text-center border border-teal-100 shadow-sm relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/img/pattern.svg')] opacity-5 z-0" aria-hidden="true"></div>
    <div class="relative z-10 max-w-3xl mx-auto">
      <p class="text-emerald-500 font-bold uppercase tracking-widest text-sm mb-3">{home.membership_home.label}</p>
      <h2 class="text-4xl sm:text-5xl font-serif text-teal-900 mb-8 leading-tight">{home.membership_home.title}</h2>
      
      <div class="inline-block bg-white px-8 py-6 rounded-2xl shadow-md border border-teal-100" role="status">
        <p class="text-xl font-medium text-teal-800">{home.membership_home.under_construction}</p>
      </div>
    </div>
  </div>
</div>
<style>
@keyframes marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-100%); }
}
</style>