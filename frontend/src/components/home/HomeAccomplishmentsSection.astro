---
/**
 * Native Astro homepage Accomplishments / Annual Outcomes (Phase 3).
 * Year tabs + outcome stat tiles with Tailwind parity to
 * `.home-editable-accomplishments-*` / `.monroe-accomplishments-*`.
 * Preserves `#Accomplishments` for side-dock / Mobile TOC.
 * Client script: year tabs, localStorage staff outcomes override
 * (`mchs_site_content_v2`), and scroll-into-view count-up.
 */
import home from '../../data/homepage.json';

export type AccomplishmentStat = {
  value: number;
  display: string;
  label: string;
  accent?: boolean;
};

interface Props {
  years: Record<string, AccomplishmentStat[]>;
  pill?: string;
  title?: string;
  intro?: string;
  /** Newest year first; defaults to sorted keys. */
  yearOrder?: string[];
  defaultYear?: string;
}

const {
  years,
  pill = home.accomplishments.pill,
  title = home.accomplishments.title,
  intro = home.accomplishments.intro,
  yearOrder,
  defaultYear,
} = Astro.props;

const accomplishmentYears =
  yearOrder && yearOrder.length
    ? yearOrder
    : Object.keys(years).sort((a, b) => Number(b) - Number(a));
const activeYear = defaultYear ?? accomplishmentYears[0];
---

<div
  id="Accomplishments"
  class="wp-block-group alignwide home-editable-section home-editable-accomplishments-band is-layout-constrained mx-auto my-5 w-full min-w-0 max-w-[var(--monroe-home-content-max)] box-border p-0 scroll-mt-[calc(var(--monroe-nav-height,96px)+var(--monroe-sticky-wayfinding-offset,0px)+var(--monroe-scroll-anchor-gap,12px))]"
>
  <div
    class="home-acc-card rounded-[28px] border border-[rgba(36,72,67,0.12)] text-center shadow-[0_28px_60px_rgba(31,53,51,0.1)] overflow-visible"
  >
    <p
      class="mx-auto mb-[clamp(0.85rem,2vw,1.1rem)] inline-flex items-center gap-2 rounded-full bg-teal-700/12 px-[0.7rem] py-[0.35rem] font-['Jost','Segoe_UI',sans-serif] text-[0.76rem] font-bold uppercase leading-none tracking-[0.12em] text-teal-700"
    >
      {pill}
    </p>
    <h2
      class="m-0 mb-[0.55rem] font-serif text-[clamp(1.75rem,3.2vw,2.25rem)] font-normal leading-[1.08] tracking-[0.02em] text-[var(--monroe-color-impact-green,#068110)]"
    >
      {title}
    </h2>
    <p
      class="mx-auto mb-[clamp(1.35rem,3vw,1.75rem)] max-w-[34rem] font-['Questrial','Segoe_UI',sans-serif] text-[clamp(0.95rem,2.2vw,1.02rem)] font-normal leading-[1.55] text-[rgba(64,87,87,0.92)]"
    >
      {intro}
    </p>

    <div
      class="home-acc-widget mx-auto mt-0 flex w-full max-w-[min(920px,100%)] flex-col items-center gap-[clamp(2.25rem,5vw,3rem)]"
      data-monroe-accomplishments-widget
    >
      <div
        class="m-0 inline-flex flex-wrap items-center justify-center gap-1 rounded-full border border-teal-700/12 bg-teal-700/10 p-[0.3rem] shadow-[inset_0_1px_0_rgba(255,255,255,0.55)]"
        role="tablist"
        aria-label="Shelter outcome years"
      >
        {
          accomplishmentYears.map((year) => (
            <button
              type="button"
              class:list={[
                'monroe-accomplishments-widget__tab home-acc-tab',
                year === activeYear && 'is-active',
              ]}
              role="tab"
              id={`monroe-accomplishments-tab-${year}`}
              aria-selected={year === activeYear ? 'true' : 'false'}
              aria-controls={`monroe-accomplishments-panel-${year}`}
              data-accomplishments-year={year}
            >
              {year}
            </button>
          ))
        }
      </div>

      {
        accomplishmentYears.map((year) => {
          const stats = years[year] ?? [];
          const isActive = year === activeYear;
          return (
            <div
              class:list={[
                'monroe-accomplishments-widget__panel m-0 w-full p-0',
                isActive ? 'is-active' : '',
              ]}
              role="tabpanel"
              id={`monroe-accomplishments-panel-${year}`}
              aria-labelledby={`monroe-accomplishments-tab-${year}`}
              data-accomplishments-panel={year}
              hidden={!isActive}
            >
              <div class="home-acc-stats">
                {stats.map((s) => (
                  <div
                    class:list={[
                      'monroe-accomplishments-stat is-tile home-acc-stat',
                      s.accent && 'is-accent',
                    ]}
                    data-accomplishments-stat
                  >
                    <span
                      class="monroe-accomplishments-stat__value home-acc-stat__value"
                      data-count={s.value}
                      data-stat-value
                    >
                      {s.display}
                    </span>
                    <span
                      class="monroe-accomplishments-stat__label home-acc-stat__label"
                      data-stat-label
                    >
                      {s.label}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</div>

<style>
  .home-acc-card {
    padding:
      clamp(1.65rem, 3.5vw, 2.35rem)
      clamp(1.15rem, 3vw, 1.85rem)
      clamp(2.75rem, 5.5vw, 3.5rem);
    background:
      radial-gradient(circle at 50% 0%, rgba(15, 118, 110, 0.08), transparent 42%),
      linear-gradient(155deg, rgba(232, 248, 243, 0.92), rgba(255, 250, 240, 0.98));
  }

  .home-acc-tab {
    appearance: none;
    border: 0;
    background: transparent;
    color: #0f766e;
    font-family: 'Jost', 'Segoe UI', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    min-height: 2.75rem;
    padding: 0.5rem 1.15rem;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
  }

  .home-acc-tab:hover,
  .home-acc-tab:focus-visible {
    outline: none;
    background: rgba(255, 255, 255, 0.72);
    box-shadow: 0 2px 8px rgba(15, 118, 110, 0.1);
  }

  .home-acc-tab.is-active,
  .home-acc-tab.is-active:hover,
  .home-acc-tab.is-active:focus-visible {
    background: linear-gradient(135deg, #0f766e, #068110);
    color: #fff;
    box-shadow: 0 6px 18px rgba(15, 118, 110, 0.22);
  }

  .home-acc-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.85rem, 2.5vw, 1.25rem);
    width: 100%;
  }

  .home-acc-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 100%;
    padding: clamp(1.15rem, 2.8vw, 1.5rem) clamp(0.85rem, 2vw, 1rem);
    text-align: center;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(36, 72, 67, 0.11);
    box-shadow: 0 12px 32px rgba(17, 41, 41, 0.07);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .home-acc-stat.is-accent {
    background: linear-gradient(145deg, #0f766e, #068110);
    border-color: transparent;
    box-shadow: 0 14px 36px rgba(15, 118, 110, 0.18);
  }

  .home-acc-stat__value {
    display: inline-block;
    font-family: 'Abril Fatface', Georgia, serif;
    font-size: clamp(2.35rem, 4.8vw, 3.25rem);
    font-weight: 400;
    line-height: 1;
    color: #068110;
    font-variant-numeric: tabular-nums;
    min-width: 2.5ch;
    text-align: center;
  }

  .home-acc-stat.is-accent .home-acc-stat__value {
    color: #fff;
  }

  .home-acc-stat__label {
    font-family: 'Jost', 'Segoe UI', sans-serif;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.35;
    color: #0f766e;
  }

  .home-acc-stat.is-accent .home-acc-stat__label {
    color: rgba(255, 255, 255, 0.92);
  }

  @media (hover: hover) and (pointer: fine) {
    .home-acc-stat:not(.is-accent):hover {
      transform: translateY(-2px);
      box-shadow: 0 18px 40px rgba(15, 118, 110, 0.1);
    }
  }

  @media (hover: none), (pointer: coarse) {
    .home-acc-stat:hover {
      transform: none;
    }
  }

  @media (max-width: 768px) and (min-width: 481px) {
    .home-acc-stats {
      gap: 0.5rem;
    }
    .home-acc-stat {
      padding: 0.75rem 0.35rem;
      border-radius: 18px;
      min-width: 0;
    }
    .home-acc-stat__value {
      font-size: clamp(1.35rem, 4.2vw, 1.85rem);
    }
    .home-acc-stat__label {
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      line-height: 1.25;
      max-width: 100%;
      hyphens: auto;
    }
  }

  @media (max-width: 480px) {
    .home-acc-card {
      padding: 1.35rem 1.15rem clamp(2.25rem, 5.5vw, 3rem);
    }
    .home-acc-widget {
      gap: clamp(2rem, 5vw, 2.75rem);
    }
    .home-acc-stats {
      grid-template-columns: 1fr;
      gap: 0.65rem;
      max-width: 20rem;
      margin-inline: auto;
    }
    .home-acc-stat {
      padding: 1rem 0.85rem;
      border-radius: 18px;
    }
    .home-acc-stat__value {
      font-size: clamp(1.75rem, 6vw, 2.15rem);
    }
    .home-acc-stat__label {
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      line-height: 1.3;
    }
  }

  /* Keep panels with [hidden] fully collapsed even if utility CSS races. */
  .monroe-accomplishments-widget__panel[hidden] {
    display: none !important;
  }
</style>

<script>
  const accWidget = document.querySelector('[data-monroe-accomplishments-widget]');
  if (accWidget instanceof HTMLElement && accWidget.dataset.bound !== '1') {
    accWidget.dataset.bound = '1';

    try {
      const rawStored = localStorage.getItem('mchs_site_content_v2');
      if (rawStored) {
        const stored = JSON.parse(rawStored);
        if (stored && stored.outcomes) {
          Object.entries(stored.outcomes).forEach(([year, stats]) => {
            const panel = accWidget.querySelector(`[data-accomplishments-panel="${year}"]`);
            if (panel && Array.isArray(stats)) {
              stats.forEach((s) => {
                const statTile = Array.from(panel.querySelectorAll('[data-accomplishments-stat]')).find(
                  (t) =>
                    t.querySelector('[data-stat-label]')?.textContent?.trim().toLowerCase() ===
                    String(s?.label || '').toLowerCase(),
                );
                if (statTile) {
                  const valEl = statTile.querySelector('[data-stat-value]');
                  if (valEl instanceof HTMLElement) {
                    valEl.dataset.count = String(s.value);
                    valEl.textContent = s.display || String(s.value);
                  }
                }
              });
            }
          });
        }
      }
    } catch {
      /* ignore bad localStorage */
    }

    accWidget.querySelectorAll('[data-accomplishments-year]').forEach((tab) => {
      if (!(tab instanceof HTMLButtonElement)) return;
      tab.addEventListener('click', () => {
        const year = tab.dataset.accomplishmentsYear;
        accWidget.querySelectorAll('[data-accomplishments-year]').forEach((t) => {
          const active = t === tab;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', String(active));
        });
        accWidget.querySelectorAll('[data-accomplishments-panel]').forEach((panel) => {
          if (!(panel instanceof HTMLElement)) return;
          const active = panel.dataset.accomplishmentsPanel === year;
          panel.classList.toggle('is-active', active);
          panel.hidden = !active;
        });
      });
    });
  }

  const countEls = document.querySelectorAll(
    '[data-monroe-accomplishments-widget] [data-stat-value][data-count]',
  );
  if (
    countEls.length &&
    'IntersectionObserver' in window &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const countIO = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target;
          if (!(el instanceof HTMLElement)) return;
          countIO.unobserve(el);
          const target = Number(el.dataset.count);
          if (!Number.isFinite(target)) return;
          const original = el.textContent ?? '';
          const prefix = original.match(/^\D*/)?.[0] ?? '';
          const suffix = original.match(/\D*$/)?.[0] ?? '';
          const duration = 1200;
          const start = performance.now();
          const step = (now) => {
            const progress = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = `${prefix}${Math.round(target * eased).toLocaleString()}${suffix}`;
            if (progress < 1) requestAnimationFrame(step);
            else el.textContent = original;
          };
          requestAnimationFrame(step);
        });
      },
      { threshold: 0.4 },
    );
    countEls.forEach((el) => {
      if (!(el instanceof HTMLElement)) return;
      if (el.dataset.ioBound === '1') return;
      el.dataset.ioBound = '1';
      countIO.observe(el);
    });
  }
</script>
