---
interface Props { home: any; }
const { home } = Astro.props;
---
<section id="Donations" class="py-20 lg:py-32 bg-gradient-to-br from-teal-950 via-teal-900 to-emerald-950 text-white relative overflow-hidden">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-20">
      <span class="text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4 block">{home.donations.label}</span>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-serif tracking-tight leading-tight mb-6">{home.donations.title}</h2>
      <p class="text-lg md:text-xl text-teal-100 font-medium leading-relaxed">{home.donations.intro}</p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16">
      <div class="bg-white rounded-[2rem] p-4 shadow-2xl overflow-hidden group border border-emerald-500/20">
         <div class="relative h-[550px] w-full rounded-[1.5rem] overflow-hidden">
           <iframe src={home.donations.general.href} class="absolute inset-0 w-full h-full border-0 bg-white" title="Make a Difference"></iframe>
         </div>
      </div>
      <div class="bg-white rounded-[2rem] p-4 shadow-2xl overflow-hidden group border border-emerald-500/20">
         <div class="relative h-[550px] w-full rounded-[1.5rem] overflow-hidden">
           <iframe src={home.donations.cat_room.href} class="absolute inset-0 w-full h-full border-0 bg-white" title="Support the Cat Room"></iframe>
         </div>
      </div>
    </div>
    <div class="max-w-4xl mx-auto bg-white/10 backdrop-blur-md rounded-[2rem] p-8 lg:p-12 border border-white/20 flex flex-col md:flex-row items-center justify-between gap-8 text-center md:text-left">
      <div>
        <h4 class="font-serif text-2xl lg:text-3xl text-white mb-2">{home.donations.offline.title}</h4>
        <p class="text-teal-200">{home.donations.offline.label}</p>
      </div>
      <div class="flex flex-col items-center md:items-end">
        <div class="text-4xl lg:text-5xl font-serif text-emerald-400">{home.donations.offline.amount}</div>
        <div class="text-xs text-teal-300 uppercase tracking-widest mt-2">{home.donations.offline.caption}</div>
      </div>
    </div>
  </div>
</section>
