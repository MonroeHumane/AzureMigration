---
interface Props { home: any; }
const { home } = Astro.props;
---
<section id="Accomplishments" class="py-20 lg:py-32 bg-teal-950 text-white relative overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-emerald-500/10 via-teal-950 to-teal-950 pointer-events-none"></div>
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12 relative z-10 text-center">
    <div class="max-w-3xl mx-auto mb-16 lg:mb-24">
      <span class="inline-block px-4 py-1.5 bg-emerald-500 text-teal-950 rounded-full font-bold uppercase tracking-widest text-xs mb-6 shadow-sm">
        {home.accomplishments.pill}
      </span>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-serif tracking-tight leading-tight mb-6">
        {home.accomplishments.title}
      </h2>
      <p class="text-lg md:text-xl text-teal-100/90 leading-relaxed font-medium">
        {home.accomplishments.intro}
      </p>
    </div>
    <div class="flex flex-col gap-12">
      {Object.keys(home.accomplishments.years).reverse().map((year) => (
        <div class="bg-white/5 backdrop-blur-md rounded-[2.5rem] p-8 lg:p-12 border border-white/10 hover:bg-white/10 transition-all duration-300">
          <h3 class="text-3xl font-serif text-emerald-400 mb-8 border-b border-white/10 pb-4 inline-block">{year} Impacts</h3>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
            {home.accomplishments.years[year].map((stat: any) => (
              <div class="flex flex-col items-center">
                <span class={`text-4xl lg:text-6xl font-serif mb-2 ${stat.accent ? 'text-white drop-shadow-md' : 'text-emerald-400'}`}>
                  {stat.display}
                </span>
                <span class="text-sm font-bold tracking-widest uppercase text-teal-100/80 text-center">{stat.label}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
