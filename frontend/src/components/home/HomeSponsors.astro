---
interface Props {
  home: any;
  sponsors: any;
}
const { home, sponsors } = Astro.props;
---
<div class="max-w-7xl mx-auto px-4 py-16">
  <!-- Vet Partners -->
  <div class="mb-16">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <p class="text-emerald-500 font-bold uppercase tracking-widest text-sm mb-3">{home.vet_partners.label}</p>
      <h2 class="text-4xl font-serif text-teal-900 mb-6 leading-tight">{home.vet_partners.title}</h2>
      <p class="text-lg text-gray-700 leading-relaxed">{home.vet_partners.intro}</p>
    </div>
    
    <section id="VetPartners" class="bg-gray-50 rounded-3xl p-8 sm:p-12 border border-gray-100" aria-labelledby="sponsor-widget-title">
      <h3 id="sponsor-widget-title" class="sr-only">{home.vet_partners.title}</h3>
      <p class="text-center font-medium text-teal-800 mb-8 border-b border-gray-200 pb-4">{home.vet_partners.subtitle}</p>
      
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {sponsors.vet_partners.map((v: any) => (
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col items-center justify-center text-center group hover:-translate-y-1 transition-transform">
            <img src={v.image} alt={v.alt} loading="lazy" decoding="async" class="w-full h-auto max-h-24 object-contain mb-4 grayscale opacity-70 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-300" />
            <h4 class="font-bold text-teal-900 text-sm mb-4 flex-grow">{v.name}</h4>
            <a class="text-xs font-bold uppercase tracking-widest text-emerald-600 hover:text-teal-700" href={v.link} target="_blank" rel="noopener noreferrer">Visit website</a>
          </div>
        ))}
      </div>
    </section>
  </div>

  <!-- Auction Sponsors -->
  <div>
    <section id="furry-friends-auction-sponsors" class="bg-white rounded-3xl p-8 sm:p-12 shadow-sm border border-teal-100" aria-labelledby="furry-friends-auction-sponsors-title">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h3 id="furry-friends-auction-sponsors-title" class="text-3xl font-serif text-teal-900 mb-4">{home.auction_sponsors.title || 'Furry Friends Auction Sponsors'}</h3>
        <p class="text-gray-600 font-medium">{home.auction_sponsors.subtitle}</p>
      </div>
      
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
        {sponsors.auction_sponsors.map((v: any) => (
          <div class="bg-gray-50 p-6 rounded-2xl flex flex-col items-center justify-center text-center group hover:bg-white hover:shadow-md transition-all">
            <img src={v.image} alt={v.alt} loading="lazy" decoding="async" class="w-full h-auto max-h-20 object-contain mb-4 grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-300" />
            <h4 class="font-bold text-gray-700 text-sm mb-3 flex-grow">{v.name}</h4>
            <a class="text-xs font-bold uppercase tracking-widest text-emerald-600 hover:text-teal-700" href={v.link} target="_blank" rel="noopener noreferrer">Visit website</a>
          </div>
        ))}
      </div>
    </section>
  </div>
</div>