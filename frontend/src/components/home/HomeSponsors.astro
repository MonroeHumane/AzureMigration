---
interface Props {
  home: any;
  sponsors: any;
}
const { home, sponsors } = Astro.props;
---
<section class="py-20 lg:py-32 bg-white">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <!-- Vet Partners -->
    <div class="mb-20">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-emerald-500 font-bold uppercase tracking-widest text-sm mb-4 block">{home.vet_partners.label}</span>
        <h2 class="text-4xl md:text-5xl font-serif tracking-tight text-teal-900 mb-6 leading-tight">{home.vet_partners.title}</h2>
        <p class="text-lg text-gray-700 leading-relaxed">{home.vet_partners.intro}</p>
      </div>
      
      <div id="VetPartners" class="bg-slate-50 rounded-[3rem] p-8 sm:p-12 border border-slate-100 shadow-[0_8px_30px_rgb(0,0,0,0.02)]">
        <p class="text-center font-bold uppercase tracking-widest text-sm text-teal-800 mb-10 border-b border-gray-200 pb-4">{home.vet_partners.subtitle}</p>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          {sponsors.vet_partners.map((v: any) => (
            <div class="bg-white p-8 rounded-[2rem] shadow-sm border border-slate-100 flex flex-col items-center justify-center text-center group hover:-translate-y-1 hover:shadow-md transition-all">
              <img src={v.image} alt={v.alt} loading="lazy" decoding="async" class="w-full h-auto max-h-24 object-contain mb-6 grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-300" />
              <h4 class="font-bold text-teal-900 text-sm mb-4 flex-grow">{v.name}</h4>
              <a class="text-xs font-bold uppercase tracking-widest text-emerald-600 hover:text-teal-700" href={v.link} target="_blank" rel="noopener noreferrer">Visit website</a>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Auction Sponsors -->
    <div>
      <div id="furry-friends-auction-sponsors" class="bg-teal-50 rounded-[3rem] p-8 sm:p-12 shadow-sm border border-teal-100">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <h3 class="text-3xl font-serif text-teal-900 mb-4">{home.auction_sponsors.title || 'Furry Friends Auction Sponsors'}</h3>
          <p class="text-teal-900/80 font-medium">{home.auction_sponsors.subtitle}</p>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
          {sponsors.auction_sponsors.map((v: any) => (
            <div class="bg-white p-6 rounded-[1.5rem] flex flex-col items-center justify-center text-center group hover:shadow-md transition-all border border-teal-100/50">
              <img src={v.image} alt={v.alt} loading="lazy" decoding="async" class="w-full h-auto max-h-20 object-contain mb-4 grayscale opacity-50 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-300" />
              <h4 class="font-bold text-teal-900 text-xs mb-3 flex-grow">{v.name}</h4>
              <a class="text-[10px] font-bold uppercase tracking-widest text-emerald-600 hover:text-teal-700" href={v.link} target="_blank" rel="noopener noreferrer">Visit website</a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
