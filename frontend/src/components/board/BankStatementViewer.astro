---
interface Props {
  data?: any;
}

const { data = null } = Astro.props;
---

<section id="bank-statement-viewer" class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden transition-all duration-300">
  <!-- Header Bar -->
  <div class="px-6 py-5 border-b border-slate-200 bg-[#fbf9f5]">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="inline-flex p-2 rounded-lg bg-[#173a39] text-emerald-300 shadow-xs">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"></path>
              <path d="M18 14h-8"></path>
              <path d="M15 18h-5"></path>
              <path d="M10 6h8v4h-8V6Z"></path>
            </svg>
          </span>
          <div>
            <div class="flex items-center gap-2">
              <h2 class="text-lg font-bold text-[#173a39] tracking-tight">
                First Merchants Bank Statement & QBO Reconciliation
              </h2>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300">
                Locked & Certified
              </span>
            </div>
            <p id="bank-stat-meta-note" class="text-xs text-slate-500 mt-0.5">
              Account XXXXXX8478 · Statement Period: August 1 – August 31, 2026 · Loading certified statement...
            </p>
          </div>
        </div>
      </div>

      <!-- Quick Metrics Ribbon -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
        <div class="p-2 rounded bg-slate-50 border border-slate-200">
          <span class="text-[10px] uppercase font-semibold text-slate-400 block">Bank Statement</span>
          <span id="bank-stat-balance" class="font-mono font-bold text-slate-900 text-sm">--</span>
        </div>
        <div class="p-2 rounded bg-emerald-50 border border-emerald-200">
          <span class="text-[10px] uppercase font-semibold text-emerald-700 block">Book Cash (GL)</span>
          <span id="bank-stat-cash" class="font-mono font-bold text-emerald-900 text-sm">--</span>
        </div>
        <div class="p-2 rounded bg-amber-50 border border-amber-200">
          <span class="text-[10px] uppercase font-semibold text-amber-700 block">Certified Float</span>
          <span id="bank-stat-float" class="font-mono font-bold text-amber-900 text-sm">--</span>
        </div>
        <div class="p-2 rounded bg-teal-50 border border-teal-200">
          <span class="text-[10px] uppercase font-semibold text-teal-700 block">QBO Variance</span>
          <span class="font-mono font-bold text-teal-900 text-sm">$0.00 (Exact)</span>
        </div>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex flex-wrap items-center gap-2 mt-5 pt-3 border-t border-slate-200/80">
      <button
        type="button"
        data-statement-tab="tabular"
        class="statement-tab-btn active inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-[#173a39] text-white shadow-xs transition"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
          <line x1="3" x2="21" y1="9" y2="9"></line>
          <line x1="3" x2="21" y1="15" y2="15"></line>
          <line x1="9" x2="9" y1="3" y2="21"></line>
          <line x1="15" x2="15" y1="3" y2="21"></line>
        </svg>
        Tabular Statement Explorer (108 Items)
      </button>

      <button
        type="button"
        data-statement-tab="reconciliation"
        class="statement-tab-btn inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          <path d="m9 12 2 2 4-4"></path>
        </svg>
        Certified QBO Float Walk (-$1,057.13)
      </button>

      <button
        type="button"
        data-statement-tab="balances"
        class="statement-tab-btn inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-teal-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="20" x2="18" y2="10"></line>
          <line x1="12" y1="20" x2="12" y2="4"></line>
          <line x1="6" y1="20" x2="6" y2="14"></line>
        </svg>
        Daily Balance Trajectory (August Arc)
      </button>

      <button
        type="button"
        data-statement-tab="pdf"
        class="statement-tab-btn inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-rose-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
        </svg>
        Official PDF Documents (Bank & QBO Rec)
      </button>
    </div>
  </div>

  <!-- TAB 1: TABULAR STATEMENT EXPLORER -->
  <div id="tab-panel-tabular" class="statement-panel p-5 space-y-4">
    <!-- Filter & Search Controls -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 bg-slate-50 p-3 rounded-lg border border-slate-200">
      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="text-[11px] font-semibold text-slate-500 mr-1">Filter:</span>
        <button type="button" data-filter="all" class="filter-pill active px-2.5 py-1 rounded-md font-semibold bg-[#173a39] text-white transition">
          All (108)
        </button>
        <button type="button" data-filter="deposits" class="filter-pill px-2.5 py-1 rounded-md font-semibold bg-white border border-slate-200 text-emerald-800 hover:bg-emerald-50 transition">
          Deposits (46 · $40.9k)
        </button>
        <button type="button" data-filter="withdrawals" class="filter-pill px-2.5 py-1 rounded-md font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 transition">
          Withdrawals (62 · $70.6k)
        </button>
        <button type="button" data-filter="checks" class="filter-pill px-2.5 py-1 rounded-md font-semibold bg-white border border-slate-200 text-indigo-700 hover:bg-indigo-50 transition">
          Paper Checks (7 · $10.4k)
        </button>
        <button type="button" data-filter="payroll" class="filter-pill px-2.5 py-1 rounded-md font-semibold bg-white border border-slate-200 text-amber-800 hover:bg-amber-50 transition">
          Payroll Clearing (18 · $31.5k)
        </button>
        <button type="button" data-filter="ap" class="filter-pill px-2.5 py-1 rounded-md font-semibold bg-white border border-slate-200 text-purple-800 hover:bg-purple-50 transition">
          AP Vendor Debits (15 · $21.9k)
        </button>
      </div>

      <!-- Real-time Text Search -->
      <div class="relative w-full md:w-72">
        <div class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none text-slate-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
        <input
          type="text"
          id="statement-search-input"
          placeholder="Search payee, check #, amount..."
          class="w-full pl-8 pr-3 py-1.5 text-xs rounded-md border border-slate-300 bg-white text-slate-800 placeholder-slate-400 focus:outline-hidden focus:ring-1 focus:ring-[#173a39] focus:border-[#173a39]"
        />
      </div>
    </div>

    <!-- Live Counter and Summary Bar -->
    <div class="flex items-center justify-between text-xs text-slate-500 px-1">
      <div>
        Showing <span id="filtered-count" class="font-bold text-slate-800">108</span> of 108 statement transactions
      </div>
      <div class="flex items-center gap-3">
        <span>Filtered Credits: <strong id="filtered-credits" class="font-mono text-emerald-700 font-semibold">$40,889.25</strong></span>
        <span>Filtered Debits: <strong id="filtered-debits" class="font-mono text-slate-900 font-semibold">$70,643.29</strong></span>
      </div>
    </div>

    <!-- Transaction Table -->
    <div class="border border-slate-200 rounded-lg overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-slate-100/80 text-slate-700 font-semibold border-b border-slate-200">
            <th class="py-2.5 px-3 whitespace-nowrap">Date</th>
            <th class="py-2.5 px-3">Transaction Description / Payee</th>
            <th class="py-2.5 px-3">Type & Channel</th>
            <th class="py-2.5 px-3">Relational GL Account / Stream</th>
            <th class="py-2.5 px-3 text-right">Amount</th>
            <th class="py-2.5 px-3 text-right">Running Balance</th>
          </tr>
        </thead>
        <tbody id="statement-tbody" class="divide-y divide-slate-100">
          <tr id="statement-tx-loading-row">
            <td colspan="6" class="py-12 text-center text-slate-400">
              <div class="inline-flex items-center gap-2">
                <svg class="animate-spin h-4 w-4 text-[#173a39]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                </svg>
                <span>Loading certified transactions...</span>
              </div>
            </td>
          </tr>
        </tbody>
        <tfoot class="bg-[#173a39] text-white font-semibold text-xs border-t-2 border-[#0f766e]">
          <tr>
            <td colspan="4" class="py-3 px-3 uppercase tracking-wider text-white">
              Official Statement Totals (First Merchants Bank Aug 31, 2026)
            </td>
            <td class="py-3 px-3 text-right font-mono text-emerald-300 font-bold whitespace-nowrap">
              <span id="stmt-total-deposits">--</span><br/>
              <span id="stmt-total-withdrawals" class="text-rose-300 font-normal">--</span>
            </td>
            <td class="py-3 px-3 text-right font-mono text-white text-sm font-bold whitespace-nowrap">
              <span id="stmt-ending-balance">--</span>
            </td>
          </tr>
        </tfoot>
      </table>
    </div>

    <!-- Empty Search State -->
    <div id="statement-empty-state" class="hidden text-center py-10 text-slate-500 bg-slate-50 rounded-lg border border-dashed border-slate-300">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 mx-auto text-slate-400 mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <p class="font-semibold text-slate-700">No transactions match your search or filter</p>
      <p class="text-xs text-slate-400 mt-1">Try clearing the search query or selecting "All" to reset view.</p>
    </div>
  </div>

  <!-- TAB 2: CERTIFIED QBO RECONCILIATION & FLOAT WALK -->
  <div id="tab-panel-reconciliation" class="statement-panel hidden p-5 space-y-6">
    <!-- Reconciliation Summary Banner -->
    <div class="p-4 rounded-lg bg-emerald-50/70 border border-emerald-200 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="p-2 rounded-full bg-emerald-600 text-white">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-emerald-950">
            Certified QBO Bank Reconciliation Locked ($0.00 Variance)
          </h3>
          <p class="text-xs text-emerald-800">
            Reconciled by Jeffery Howard on 09/04/2026 at 18:14:04. Verified against official report <code class="bg-emerald-100/80 px-1 py-0.5 rounded font-mono">QBO_Reconciliation_Report_08312026.pdf</code>.
          </p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <a
          id="qbo-rec-report-pdf-link"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold bg-emerald-800 text-white hover:bg-emerald-900 transition shadow-xs"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
          </svg>
          Open Certified Report PDF
        </a>
      </div>
    </div>

    <!-- Visual Waterfall Step-Down Diagram -->
    <div class="bg-slate-50 p-5 rounded-xl border border-slate-200">
      <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-3">
        Cent-for-Cent Reconciled Float Step-Down (Statement Ending to Book Cash)
      </h4>
      <div class="grid grid-cols-1 md:grid-cols-5 gap-3 text-xs">
        <!-- Step 1: Bank Statement -->
        <div class="p-3 bg-white rounded-lg border border-slate-200 shadow-xs flex flex-col justify-between">
          <div>
            <span class="text-[10px] uppercase font-bold text-slate-400 block">1. Bank Statement</span>
            <span class="text-xs font-semibold text-slate-800">Ending Balance</span>
            <p class="text-[10px] text-slate-500 mt-1">First Merchants Bank Aug 31 closing</p>
          </div>
          <div class="mt-3 pt-2 border-t border-slate-100">
            <span id="float-step-1-bank" class="font-mono text-sm font-bold text-slate-900">--</span>
            <span class="block text-[10px] text-slate-400">(Bank closing)</span>
          </div>
        </div>

        <!-- Step 2: Ghost Duplicates -->
        <div class="p-3 bg-amber-50/70 rounded-lg border border-amber-200 shadow-xs flex flex-col justify-between">
          <div>
            <span class="text-[10px] uppercase font-bold text-amber-700 block">2. Ghost Duplicates</span>
            <span class="text-xs font-semibold text-amber-950">3 Legacy Entries</span>
            <p class="text-[10px] text-amber-800 mt-1">Austin Roberts (2) + Jeffery Howard (1)</p>
          </div>
          <div class="mt-3 pt-2 border-t border-amber-200">
            <span class="font-mono text-sm font-bold text-amber-900">-$927.14</span>
            <span class="block text-[10px] text-amber-700">Permanent voidable drafts</span>
          </div>
        </div>

        <!-- Step 3: Uncleared Check 4465 -->
        <div class="p-3 bg-rose-50/70 rounded-lg border border-rose-200 shadow-xs flex flex-col justify-between">
          <div>
            <span class="text-[10px] uppercase font-bold text-rose-700 block">3. Uncleared Check</span>
            <span class="text-xs font-semibold text-rose-950">Check 4465 (Nolff)</span>
            <p class="text-[10px] text-rose-800 mt-1">Operational expense issued 08/19</p>
          </div>
          <div class="mt-3 pt-2 border-t border-rose-200">
            <span class="font-mono text-sm font-bold text-rose-900">-$254.99</span>
            <span class="block text-[10px] text-rose-700">In transit at month-end</span>
          </div>
        </div>

        <!-- Step 4: Deposit in Transit -->
        <div class="p-3 bg-emerald-50/70 rounded-lg border border-emerald-200 shadow-xs flex flex-col justify-between">
          <div>
            <span class="text-[10px] uppercase font-bold text-emerald-700 block">4. Deposit in Transit</span>
            <span class="text-xs font-semibold text-emerald-950">Weekend Deposit</span>
            <p class="text-[10px] text-emerald-800 mt-1">Shelter donations received 08/02</p>
          </div>
          <div class="mt-3 pt-2 border-t border-emerald-200">
            <span class="font-mono text-sm font-bold text-emerald-900">+$125.00</span>
            <span class="block text-[10px] text-emerald-700">Cleared early next cycle</span>
          </div>
        </div>

        <!-- Step 5: Certified Register Cash -->
        <div class="p-3 bg-[#173a39] text-white rounded-lg border border-teal-900 shadow-xs flex flex-col justify-between">
          <div>
            <span class="text-[10px] uppercase font-bold text-emerald-300 block">5. Certified GL Cash</span>
            <span class="text-xs font-semibold text-white">QBO Register Balance</span>
            <p class="text-[10px] text-slate-300 mt-1">Post-$5.41 exact match</p>
          </div>
          <div class="mt-3 pt-2 border-t border-teal-800">
            <span id="float-step-5-gl" class="font-mono text-sm font-bold text-emerald-300">--</span>
            <span class="block text-[10px] text-emerald-400">Locked in Balance Sheet</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Forensic Details: The Ghost Duplicates Schedule -->
    <div class="border border-slate-200 rounded-lg overflow-hidden">
      <div class="px-4 py-3 bg-slate-100/70 border-b border-slate-200 flex items-center justify-between">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-800">
          Reconciled Float Detail: Ghost Duplicates vs. Genuine In-Transit
        </h4>
        <span class="text-xs font-mono font-semibold text-slate-700">
          Total Net Float: <span id="float-net-total">-$1,057.13</span>
        </span>
      </div>
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="bg-slate-50 text-slate-600 font-semibold border-b border-slate-200">
            <th class="py-2 px-3">Date</th>
            <th class="py-2 px-3">Payee / Description</th>
            <th class="py-2 px-3">Category / Type</th>
            <th class="py-2 px-3 text-right">Amount</th>
            <th class="py-2 px-3">Status</th>
            <th class="py-2 px-3">Forensic Reason & Action Plan</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <!-- Ghost Duplicate 1 -->
          <tr class="bg-amber-50/30">
            <td class="py-2.5 px-3 font-mono text-slate-700">2026-02-27</td>
            <td class="py-2.5 px-3 font-semibold text-slate-900">Austin Roberts</td>
            <td class="py-2.5 px-3 text-slate-600">Payroll Check (Unnumbered)</td>
            <td class="py-2.5 px-3 text-right font-mono font-bold text-amber-900">-$145.00</td>
            <td class="py-2.5 px-3">
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-900 border border-amber-200">Ghost Duplicate</span>
            </td>
            <td class="py-2.5 px-3 text-slate-600 text-[11px]">
              Preliminary draft never paid by bank. Austin was paid via true $567.90 paycheck on same date. Safe to void in QBO.
            </td>
          </tr>
          <!-- Ghost Duplicate 2 -->
          <tr class="bg-amber-50/30">
            <td class="py-2.5 px-3 font-mono text-slate-700">2026-04-10</td>
            <td class="py-2.5 px-3 font-semibold text-slate-900">Austin Roberts</td>
            <td class="py-2.5 px-3 text-slate-600">Payroll Check (Unnumbered)</td>
            <td class="py-2.5 px-3 text-right font-mono font-bold text-amber-900">-$341.64</td>
            <td class="py-2.5 px-3">
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-900 border border-amber-200">Ghost Duplicate</span>
            </td>
            <td class="py-2.5 px-3 text-slate-600 text-[11px]">
              Preliminary draft never paid by bank. Austin was paid via true $370.00 paycheck on same date. Safe to void in QBO.
            </td>
          </tr>
          <!-- Ghost Duplicate 3 -->
          <tr class="bg-amber-50/30">
            <td class="py-2.5 px-3 font-mono text-slate-700">2026-06-22</td>
            <td class="py-2.5 px-3 font-semibold text-slate-900">Jeffery Howard</td>
            <td class="py-2.5 px-3 text-slate-600">Direct Deposit Draft (Unnumbered)</td>
            <td class="py-2.5 px-3 text-right font-mono font-bold text-amber-900">-$440.50</td>
            <td class="py-2.5 px-3">
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-900 border border-amber-200">Ghost Duplicate</span>
            </td>
            <td class="py-2.5 px-3 text-slate-600 text-[11px]">
              Draft duplicate entry. True payment was physical Check 4445 ($440.50) which already cleared First Merchants in July. Safe to void in QBO.
            </td>
          </tr>
          <!-- Genuine Uncleared Check 4465 -->
          <tr class="bg-rose-50/20">
            <td class="py-2.5 px-3 font-mono text-slate-700">2026-08-19</td>
            <td class="py-2.5 px-3 font-semibold text-slate-900">Whitaker Nolff</td>
            <td class="py-2.5 px-3 text-slate-600">Paper Check #4465</td>
            <td class="py-2.5 px-3 text-right font-mono font-bold text-rose-800">-$254.99</td>
            <td class="py-2.5 px-3">
