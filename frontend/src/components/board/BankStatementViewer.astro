                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                </svg>
                <span>Loading certified transactions...</span>
              </div>
            </td>
          </tr>
        </tbody>
        <tfoot class="bg-[#173a39] text-white font-semibold text-xs border-t-2 border-[#0f766e]">
          <tr>
            <td colspan="4" class="py-3 px-3 uppercase tracking-wider text-white">
              Official Statement Totals (First Merchants Bank Aug 31, 2026)
            </td>
            <td class="py-3 px-3 text-right font-mono text-emerald-300 font-bold whitespace-nowrap">
              <span id="stmt-total-deposits">+{formatCents(metadata.total_deposits_amount)}</span><br/>
              <span id="stmt-total-withdrawals" class="text-rose-300 font-normal">-{formatCents(metadata.total_withdrawals_amount)}</span>
            </td>
            <td class="py-3 px-3 text-right font-mono text-white text-sm font-bold whitespace-nowrap">
              <span id="stmt-ending-balance">{formatCents(metadata.statement_ending_balance)}</span>
            </td>
          </tr>
        </tfoot>
      </table>
    </div>

    <!-- Empty Search State -->
    <div id="statement-empty-state" class="hidden text-center py-10 text-slate-500 bg-slate-50 rounded-lg border border-dashed border-slate-300">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 mx-auto text-slate-400 mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <p class="font-semibold text-slate-700">No transactions match your search or filter</p>
      <p class="text-xs text-slate-400 mt-1">Try clearing the search query or selecting "All" to reset view.</p>
    </div>
  </div>


  <!-- TAB 3: DAILY BALANCE TRAJECTORY -->
  <div id="tab-panel-balances" class="statement-panel hidden p-5 space-y-4">
    <div class="bg-slate-50 p-4 rounded-lg border border-slate-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs">
      <div>
        <h4 class="font-bold text-slate-800 text-sm">First Merchants August Cash Flow & Daily Liquidity</h4>
        <p class="text-slate-500 mt-0.5">
          Tracking the month's 22 banking days from opening to month-end reconciliation close.
        </p>
      </div>
      <div class="flex items-center gap-3">
        <div class="text-right">
          <span class="text-[10px] text-slate-400 block uppercase">Peak Liquidity</span>
          <span id="daily-peak-val" class="font-mono font-bold text-emerald-800 text-sm">$68,493.92</span>
        </div>
        <div class="text-right">
          <span class="text-[10px] text-slate-400 block uppercase">August Low</span>
          <span id="daily-august-low-val" class="font-mono font-bold text-slate-800 text-sm">{formatCents(metadata.statement_ending_balance)}</span>
        </div>
      </div>
    </div>

    <!-- Daily Balances Table with Liquidity Bars -->
    <div class="border border-slate-200 rounded-lg overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-slate-100 text-slate-700 font-semibold border-b border-slate-200">
            <th class="py-2.5 px-3 whitespace-nowrap">Bank Date</th>
            <th class="py-2.5 px-3 text-right">Daily Closing Balance</th>
            <th class="py-2.5 px-3 text-right">Net Flow (Delta)</th>
            <th class="py-2.5 px-3 w-48">Liquidity vs Peak</th>
            <th class="py-2.5 px-3">Primary Operational Event</th>
          </tr>
        </thead>
        <tbody id="daily-balances-tbody" class="divide-y divide-slate-100">
          <tr>
            <td colspan="5" class="py-8 text-center text-slate-400">
              <div class="inline-flex items-center gap-2">
                <svg class="animate-spin h-4 w-4 text-[#173a39]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                </svg>
                <span>Loading daily balance arc...</span>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- TAB 4: DUAL PDF DOCUMENT VIEWER -->
  <div id="tab-panel-pdf" class="statement-panel hidden p-5 space-y-4">
    <!-- PDF Selector Buttons & Actions -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 bg-slate-50 p-3.5 rounded-lg border border-slate-200">
      <div class="flex flex-wrap items-center gap-2">
        <button
          type="button"
          id="btn-pdf-bank"
          class="pdf-doc-btn active px-3 py-1.5 rounded-md text-xs font-semibold bg-[#173a39] text-white shadow-xs transition"
          data-pdf-url=""
          data-pdf-title="First Merchants Bank Statement (Aug 2026)"
        >
          1. First Merchants Bank Statement (6 Pages)
        </button>
        <button
          type="button"
          id="btn-pdf-qbo"
          class="pdf-doc-btn px-3 py-1.5 rounded-md text-xs font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 transition"
          data-pdf-url=""
          data-pdf-title="QuickBooks Online Official Reconciliation Report (Locked 09/04/2026)"
        >
          2. QBO Official Reconciliation Report (3 Pages)
        </button>
      </div>

      <div class="flex items-center gap-2">
        <a
          id="pdf-open-newtab"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold bg-white border border-slate-300 text-slate-700 hover:bg-slate-100 transition shadow-xs"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
          Open in New Tab
        </a>
        <a
          id="pdf-download-btn"
          href="#"
          download
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold bg-[#173a39] text-white hover:bg-teal-900 transition shadow-xs"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Download PDF
        </a>
      </div>
    </div>

    <!-- Active PDF Title Header -->
    <div class="flex items-center justify-between text-xs px-1 text-slate-600">
      <div>
        Currently Viewing: <strong id="current-pdf-title" class="text-slate-900 font-semibold">First Merchants Bank Statement (Aug 2026)</strong>
      </div>
      <span class="text-[11px] text-slate-400">Native PDF viewer with zoom & page controls</span>
    </div>

    <!-- Embedded PDF Container -->
    <div class="w-full bg-slate-100 rounded-lg border border-slate-300 overflow-hidden shadow-inner">
      <iframe
        id="pdf-viewer-frame"
        src=""
        class="w-full h-[700px] border-0"
        title="Bank Statement PDF Viewer"
      ></iframe>
    </div>
  </div>
</section>

<script>
  // Tab Switching Logic
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.statement-tab-btn');
  const panels = document.querySelectorAll<HTMLElement>('.statement-panel');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const tabKey = btn.getAttribute('data-statement-tab');
      if (!tabKey) return;

      // Update button styles
      tabButtons.forEach(b => {
        b.classList.remove('active', 'bg-[#173a39]', 'text-white');
        b.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
      });
      btn.classList.add('active', 'bg-[#173a39]', 'text-white');
      btn.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200');

      // Show targeted panel
      panels.forEach(p => p.classList.add('hidden'));
      const targetPanel = document.getElementById(`tab-panel-${tabKey}`);
      if (targetPanel) {
        targetPanel.classList.remove('hidden');
      }
    });
  });

  // Tabular Filtering & Search Logic
  const filterPills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const searchInput = document.getElementById('statement-search-input') as HTMLInputElement | null;
  const filteredCountEl = document.getElementById('filtered-count');
  const filteredCreditsEl = document.getElementById('filtered-credits');
  const filteredDebitsEl = document.getElementById('filtered-debits');
  const emptyStateEl = document.getElementById('statement-empty-state');

  let activeFilter = 'all';
  let activeQuery = '';

  const formatCurrency = (num: number) => {
    return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 }).format(num);
  };

  const applyTableFilters = () => {
    const currentRows = document.querySelectorAll<HTMLTableRowElement>('.statement-row');
    let visibleCount = 0;
    let sumCredits = 0;
    let sumDebits = 0;

    currentRows.forEach(row => {
      const isDeposit = row.getAttribute('data-is-deposit') === 'true';
      const isCheck = row.getAttribute('data-is-check') === 'true';
      const isPayroll = row.getAttribute('data-is-payroll') === 'true';
      const isAP = row.getAttribute('data-is-ap') === 'true';
      const searchText = row.getAttribute('data-search') || '';
      const amount = parseFloat(row.getAttribute('data-amount') || '0');

      // Category matching
      let matchesFilter = true;
      if (activeFilter === 'deposits') matchesFilter = isDeposit;
      else if (activeFilter === 'withdrawals') matchesFilter = !isDeposit;
      else if (activeFilter === 'checks') matchesFilter = isCheck;
      else if (activeFilter === 'payroll') matchesFilter = isPayroll;
      else if (activeFilter === 'ap') matchesFilter = isAP;

      // Query matching
      let matchesQuery = true;
      if (activeQuery.trim()) {
        matchesQuery = searchText.includes(activeQuery.toLowerCase().trim());
      }

      if (matchesFilter && matchesQuery) {
        row.style.display = '';
        visibleCount++;
        if (amount > 0) {
          sumCredits += amount;
        } else {
          sumDebits += Math.abs(amount);
        }
      } else {
        row.style.display = 'none';
      }
    });

    if (filteredCountEl) filteredCountEl.textContent = visibleCount.toString();
    if (filteredCreditsEl) filteredCreditsEl.textContent = formatCurrency(sumCredits);
    if (filteredDebitsEl) filteredDebitsEl.textContent = formatCurrency(sumDebits);

    if (emptyStateEl) {
      if (visibleCount === 0) {
        emptyStateEl.classList.remove('hidden');
      } else {
        emptyStateEl.classList.add('hidden');
      }
    }
  };

  filterPills.forEach(pill => {
    pill.addEventListener('click', () => {
      const filter = pill.getAttribute('data-filter') || 'all';
      activeFilter = filter;

      filterPills.forEach(p => {
        p.classList.remove('active', 'bg-[#173a39]', 'text-white');
        p.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
      });
      pill.classList.add('active', 'bg-[#173a39]', 'text-white');
      pill.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200');

      applyTableFilters();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      activeQuery = (e.target as HTMLInputElement).value;
      applyTableFilters();
    });
  }

  // Dual PDF Switcher
  const btnPdfBank = document.getElementById('btn-pdf-bank') as HTMLButtonElement | null;
  const btnPdfQbo = document.getElementById('btn-pdf-qbo') as HTMLButtonElement | null;
  const pdfFrame = document.getElementById('pdf-viewer-frame') as HTMLIFrameElement | null;
  const pdfOpenNewTab = document.getElementById('pdf-open-newtab') as HTMLAnchorElement | null;
  const pdfDownloadBtn = document.getElementById('pdf-download-btn') as HTMLAnchorElement | null;
  const pdfTitleEl = document.getElementById('current-pdf-title');

  const setPdfDocument = (btn: HTMLButtonElement) => {
    const url = btn.getAttribute('data-pdf-url');
    const title = btn.getAttribute('data-pdf-title');
    if (!url || !pdfFrame) return;

    pdfFrame.src = `${url}#toolbar=1&navpanes=0&scrollbar=1`;
    if (pdfOpenNewTab) pdfOpenNewTab.href = url;
    if (pdfDownloadBtn) pdfDownloadBtn.href = url;
    if (pdfTitleEl && title) pdfTitleEl.textContent = title;

    [btnPdfBank, btnPdfQbo].forEach(b => {
      if (!b) return;
      b.classList.remove('active', 'bg-[#173a39]', 'text-white');
      b.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
    });
    btn.classList.add('active', 'bg-[#173a39]', 'text-white');
    btn.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200');
  };

  if (btnPdfBank) {
    btnPdfBank.addEventListener('click', () => setPdfDocument(btnPdfBank));
  }
  if (btnPdfQbo) {
    btnPdfQbo.addEventListener('click', () => setPdfDocument(btnPdfQbo));
  }

  window.addEventListener('bank-statement-rendered', () => {
    applyTableFilters();
  });
</script>
