---
// Bank statement rows and PDF URLs hydrate after getStaffToken() via /api/financials and /api/statement.
---

<section id="bank-statement-viewer" class="bg-white dark:bg-[#0b2420]/85 rounded-2xl border border-slate-200 dark:border-teal-800/80 shadow-xs overflow-hidden transition-all duration-300">
  <!-- Header Bar -->
  <div class="px-6 py-5 border-b border-slate-200 dark:border-teal-800/80 bg-[#fbf9f5] dark:bg-[#061815]/60">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="inline-flex p-2 rounded-lg bg-[#173a39] text-emerald-300 shadow-xs">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"></path>
              <path d="M18 14h-8"></path>
              <path d="M15 18h-5"></path>
              <path d="M10 6h8v4h-8V6Z"></path>
            </svg>
          </span>
          <div>
            <div class="flex items-center gap-2">
              <h2 class="text-lg font-bold text-[#173a39] dark:text-white tracking-tight">
                Checking account
              </h2>
              <span id="bank-recon-badge" class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-700/80">
                Outstanding checks
              </span>
            </div>
            <p id="bank-stat-meta-note" class="text-xs text-slate-500 dark:text-teal-300/80 mt-0.5">
              Statement period loads after sign-in
            </p>
          </div>
        </div>
      </div>

      <!-- Quick Metrics Ribbon (3 Clean Cards) -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 text-xs w-full lg:w-auto">
        <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-[#061815]/60 border border-slate-200 dark:border-teal-900/60">
          <span class="text-[10px] uppercase font-semibold text-slate-500 dark:text-teal-300 block">Bank statement</span>
          <span id="bank-stat-balance" class="font-mono font-bold text-slate-900 dark:text-white text-sm">--</span>
        </div>
        <div class="p-2.5 rounded-xl bg-emerald-50/70 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60">
          <span class="text-[10px] uppercase font-semibold text-emerald-700 dark:text-emerald-300 block">Books</span>
          <span id="bank-stat-cash" class="font-mono font-bold text-emerald-900 dark:text-emerald-200 text-sm">--</span>
        </div>
        <div class="p-2.5 rounded-xl bg-teal-50 dark:bg-teal-950/40 border border-teal-200 dark:border-teal-800/60">
          <span class="text-[10px] uppercase font-semibold text-teal-700 dark:text-teal-300 block">Difference after outstanding checks</span>
          <span id="bank-stat-recon" class="font-mono font-bold text-teal-900 dark:text-teal-200 text-sm">--</span>
          <span id="bank-stat-recon-sub" class="text-[10px] text-teal-800/80 dark:text-teal-300/80 block mt-0.5"></span>
        </div>
      </div>
    </div>

    <div id="echarts-waterfall-container" class="w-full mt-4 mb-2"></div>

    <!-- Year stays put; months wrap so a 12-month year does not scroll the dropdown away -->
    <div class="flex flex-col sm:flex-row sm:items-start gap-2 mt-4 pt-3 border-t border-slate-200/80 dark:border-teal-900/60 text-xs">
      <div class="flex items-center gap-2 shrink-0">
        <span class="text-[11px] font-bold text-slate-400 dark:text-teal-300/70 uppercase tracking-wider">Statement</span>
        <label for="bank-year-select" class="sr-only">Statement year</label>
        <select
          id="bank-year-select"
          class="h-8 px-2 rounded-lg font-bold text-xs bg-white border border-slate-200 text-slate-800 cursor-pointer dark:bg-teal-950/60 dark:border-teal-800/80 dark:text-white"
        >
          <option value="2026" selected>2026</option>
        </select>
      </div>
      <div id="bank-month-pager" class="flex flex-wrap items-center gap-1.5 min-w-0">
      {['2026-01','2026-02','2026-03','2026-04','2026-05','2026-06','2026-07','2026-08'].map((id) => (
        <button
          type="button"
          class={`bank-month-btn h-8 px-2.5 rounded-lg font-bold text-xs whitespace-nowrap transition cursor-pointer ${
            id === '2026-08'
              ? 'bg-[#173a39] text-white dark:bg-emerald-500/20 dark:text-emerald-300 border border-[#173a39] dark:border-emerald-500/40 shadow-xs'
              : 'bg-white text-slate-700 border border-slate-200 hover:bg-slate-50 dark:bg-teal-950/60 dark:text-teal-200 dark:border-teal-800/80 dark:hover:bg-teal-900'
          }`}
          data-bank-month={id}
        >
          {id === '2026-01' ? 'Jan' : id === '2026-02' ? 'Feb' : id === '2026-03' ? 'Mar' : id === '2026-04' ? 'Apr' : id === '2026-05' ? 'May' : id === '2026-06' ? 'Jun' : id === '2026-07' ? 'Jul' : 'Aug'}
        </button>
      ))}
      </div>
    </div>
    <div id="bank-ytd-strip" class="mt-2.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] text-slate-600 dark:text-teal-200/80">
      <span id="bank-ytd-label" class="font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">2026 YTD bank</span>
      <span>In <strong id="bank-ytd-in" class="font-mono text-emerald-700 dark:text-emerald-400">--</strong></span>
      <span>Out <strong id="bank-ytd-out" class="font-mono text-rose-700 dark:text-rose-400">--</strong></span>
      <span>Net <strong id="bank-ytd-net" class="font-mono text-slate-800 dark:text-white">--</strong></span>
    </div>

    <!-- Direct Access PDF & Print Ribbon -->
    <div class="flex flex-wrap items-center justify-between gap-2 mt-4 pt-3 border-t border-slate-200/80 dark:border-teal-900/60 text-xs">
      <div class="flex flex-wrap items-center gap-2">
        <a
          id="btn-open-statement-pdf"
          href="/internal/board/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-white dark:bg-teal-950/60 border border-slate-300 dark:border-teal-800/80 text-slate-800 dark:text-teal-200 hover:bg-slate-50 dark:hover:bg-teal-900 transition shadow-xs"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-rose-600 dark:text-rose-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
          </svg>
          Open bank PDF
        </a>
        <a
          href="/internal/board/print/"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-300 dark:border-emerald-700/60 text-emerald-900 dark:text-emerald-300 hover:bg-emerald-100 dark:hover:bg-emerald-900 transition shadow-xs"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-700 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect width="12" height="8" x="6" y="14"></rect>
          </svg>
          Print packet
        </a>
        <button
          id="btn-export-bank-csv"
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-teal-50 dark:bg-teal-950/60 border border-teal-300 dark:border-teal-700/80 text-teal-900 dark:text-emerald-300 hover:bg-teal-100 dark:hover:bg-teal-900 transition shadow-xs cursor-pointer"
          title="Download the bank statement and reconciliation audit spreadsheet"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-teal-700 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Export Bank CSV</span>
        </button>
      </div>
    </div>

    <!-- Navigation Tabs (3 Tabs) -->
    <div class="flex flex-wrap items-center gap-2 mt-4 pt-3 border-t border-slate-200/80 dark:border-teal-900/60">
      <button
        type="button"
        data-statement-tab="tabular"
        class="statement-tab-btn active inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-[#173a39] text-white dark:bg-emerald-500/20 dark:text-emerald-300 border border-[#173a39] dark:border-emerald-500/40 shadow-xs transition"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
          <line x1="3" x2="21" y1="9" y2="9"></line>
          <line x1="3" x2="21" y1="15" y2="15"></line>
          <line x1="9" x2="9" y1="3" y2="21"></line>
          <line x1="15" x2="15" y1="3" y2="21"></line>
        </svg>
        Statement Transactions
      </button>

      <button
        type="button"
        data-statement-tab="balances"
        class="statement-tab-btn inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white dark:bg-teal-950/60 border border-slate-200 dark:border-teal-800/80 text-slate-700 dark:text-teal-200 hover:bg-slate-50 dark:hover:bg-teal-900 transition"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-teal-600 dark:text-teal-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="20" x2="18" y2="10"></line>
          <line x1="12" y1="20" x2="12" y2="4"></line>
          <line x1="6" y1="20" x2="6" y2="14"></line>
        </svg>
        Daily Balance Trajectory
      </button>

      <button
        type="button"
        data-statement-tab="pdf"
        class="statement-tab-btn inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white dark:bg-teal-950/60 border border-slate-200 dark:border-teal-800/80 text-slate-700 dark:text-teal-200 hover:bg-slate-50 dark:hover:bg-teal-900 transition"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-rose-600 dark:text-rose-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
        </svg>
        Official PDF Documents
      </button>
    </div>
  </div>

  <!-- TAB 1: TABULAR STATEMENT EXPLORER -->
  <div id="tab-panel-tabular" class="statement-panel p-5 space-y-4">
    <!-- Filter & Search Controls -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 bg-slate-50 dark:bg-[#061815]/60 p-3 rounded-xl border border-slate-200 dark:border-teal-900/60">
      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="text-[11px] font-semibold text-slate-500 dark:text-teal-300/70 mr-1">Filter:</span>
        <button type="button" data-filter="all" class="filter-pill active px-2.5 py-1 rounded-md font-semibold bg-[#173a39] text-white dark:bg-emerald-500/20 dark:text-emerald-300 border border-[#173a39] dark:border-emerald-500/40 transition">
          All
        </button>
        <button type="button" data-filter="deposits" class="filter-pill px-2.5 py-1 rounded-md font-semibold bg-white dark:bg-teal-950/60 border border-slate-200 dark:border-teal-800/80 text-emerald-800 dark:text-emerald-300 hover:bg-emerald-50 dark:hover:bg-teal-900 transition">
          Deposits
        </button>
        <button type="button" data-filter="withdrawals" class="filter-pill px-2.5 py-1 rounded-md font-semibold bg-white dark:bg-teal-950/60 border border-slate-200 dark:border-teal-800/80 text-slate-700 dark:text-teal-200 hover:bg-slate-100 dark:hover:bg-teal-900 transition">
          Withdrawals
        </button>
        <button type="button" data-filter="checks" class="filter-pill px-2.5 py-1 rounded-md font-semibold bg-white dark:bg-teal-950/60 border border-slate-200 dark:border-teal-800/80 text-indigo-700 dark:text-indigo-300 hover:bg-indigo-50 dark:hover:bg-teal-900 transition">
          Paper Checks
        </button>
        <button type="button" data-filter="payroll" class="filter-pill px-2.5 py-1 rounded-md font-semibold bg-white dark:bg-teal-950/60 border border-slate-200 dark:border-teal-800/80 text-amber-800 dark:text-amber-300 hover:bg-amber-50 dark:hover:bg-teal-900 transition">
          Payroll Clearing
        </button>
        <button type="button" data-filter="ap" class="filter-pill px-2.5 py-1 rounded-md font-semibold bg-white dark:bg-teal-950/60 border border-slate-200 dark:border-teal-800/80 text-purple-800 dark:text-purple-300 hover:bg-purple-50 dark:hover:bg-teal-900 transition">
          AP Vendor Debits
        </button>
      </div>

      <!-- Real-time Text Search -->
      <div class="relative w-full md:w-72">
        <div class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none text-slate-400 dark:text-teal-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
        <input
          type="text"
          id="statement-search-input"
          placeholder="Search payee, check #, amount..."
          class="w-full pl-8 pr-3 py-1.5 text-xs rounded-lg border border-slate-300 dark:border-teal-800/80 bg-white dark:bg-teal-950/80 text-slate-800 dark:text-white placeholder-slate-400 dark:placeholder-teal-400/60 focus:outline-hidden focus:ring-1 focus:ring-[#173a39] dark:focus:ring-emerald-400 focus:border-[#173a39] dark:focus:border-emerald-400"
        />
      </div>
    </div>

    <!-- Live Counter and Summary Bar -->
    <div class="flex items-center justify-between text-xs text-slate-500 dark:text-teal-300/80 px-1">
      <div>
        Showing <span id="filtered-count" class="font-bold text-slate-800 dark:text-white">--</span> statement transactions
      </div>
      <div class="flex items-center gap-3">
        <span>Filtered Credits: <strong id="filtered-credits" class="font-mono text-emerald-700 dark:text-emerald-300 font-semibold">--</strong></span>
        <span>Filtered Debits: <strong id="filtered-debits" class="font-mono text-slate-900 dark:text-white font-semibold">--</strong></span>
      </div>
    </div>

    <!-- Transaction Table -->
    <div class="border border-slate-200 dark:border-teal-800/80 rounded-xl overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-slate-100/80 dark:bg-teal-950/80 text-slate-700 dark:text-teal-200 font-semibold border-b border-slate-200 dark:border-teal-800/80">
            <th class="py-2.5 px-3 whitespace-nowrap">Date</th>
            <th class="py-2.5 px-3">Transaction Description / Payee</th>
            <th class="py-2.5 px-3">Type &amp; Channel</th>
            <th class="py-2.5 px-3">Relational GL Account / Stream</th>
            <th class="py-2.5 px-3 text-right">Amount</th>
            <th class="py-2.5 px-3 text-right">Running Balance</th>
          </tr>
        </thead>
        <tbody id="statement-tbody" class="divide-y divide-slate-100 dark:divide-teal-900/40">
          <tr id="statement-tx-loading-row">
            <td colspan="6" class="py-12 text-center text-slate-400 dark:text-teal-300/60">
              <div class="inline-flex items-center gap-2">
                <svg class="animate-spin h-4 w-4 text-[#173a39] dark:text-emerald-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                </svg>
                <span>Loading certified transactions...</span>
              </div>
            </td>
          </tr>
        </tbody>
        <tfoot class="bg-[#173a39] dark:bg-[#061815] text-white font-semibold text-xs border-t-2 border-[#0f766e] dark:border-teal-700">
          <tr>
            <td colspan="4" id="stmt-totals-label" class="py-3 px-3 uppercase tracking-wider text-white">
              Official Statement Totals (First Merchants Bank)
            </td>
            <td class="py-3 px-3 text-right font-mono text-emerald-300 font-bold whitespace-nowrap">
              <span id="stmt-total-deposits">--</span><br/>
              <span id="stmt-total-withdrawals" class="text-rose-300 font-normal">--</span>
            </td>
            <td class="py-3 px-3 text-right font-mono text-white text-sm font-bold whitespace-nowrap">
              <span id="stmt-ending-balance">--</span>
            </td>
          </tr>
        </tfoot>
      </table>
    </div>

    <!-- Empty Search State -->
    <div id="statement-empty-state" class="hidden text-center py-10 text-slate-500 dark:text-teal-300/80 bg-slate-50 dark:bg-[#061815]/60 rounded-xl border border-dashed border-slate-300 dark:border-teal-800/60">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 mx-auto text-slate-400 mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <p class="font-semibold text-slate-700">No transactions match your search or filter</p>
      <p class="text-xs text-slate-400 mt-1">Try clearing the search query or selecting "All" to reset view.</p>
    </div>
  </div>


  <!-- TAB 3: DAILY BALANCE TRAJECTORY -->
  <div id="tab-panel-balances" class="statement-panel hidden p-5 space-y-4">
    <div class="bg-slate-50 dark:bg-[#061815]/60 p-4 rounded-xl border border-slate-200 dark:border-teal-900/60 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs">
      <div>
        <h4 class="font-bold text-slate-800 dark:text-white text-sm">First Merchants daily liquidity</h4>
        <p class="text-slate-500 dark:text-teal-300/80 mt-0.5" id="daily-balances-subtitle">
          Latest month's certified daily balances. Other months show PDF in/out in the transactions tab.
        </p>
      </div>
      <div class="flex items-center gap-3">
        <div class="text-right">
          <span class="text-[10px] text-slate-400 dark:text-teal-400 block uppercase">Peak Liquidity</span>
          <span id="daily-peak-val" class="font-mono font-bold text-emerald-800 dark:text-emerald-300 text-sm">--</span>
        </div>
        <div class="text-right">
          <span class="text-[10px] text-slate-400 dark:text-teal-400 block uppercase">Month-end / low</span>
          <span id="daily-august-low-val" class="font-mono font-bold text-slate-800 dark:text-white text-sm">--</span>
        </div>
      </div>
    </div>

    <!-- Daily Balances Table with Liquidity Bars -->
    <div class="border border-slate-200 dark:border-teal-800/80 rounded-xl overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-slate-100 dark:bg-teal-950/80 text-slate-700 dark:text-teal-200 font-semibold border-b border-slate-200 dark:border-teal-800/80">
            <th class="py-2.5 px-3 whitespace-nowrap">Bank Date</th>
            <th class="py-2.5 px-3 text-right">Daily Closing Balance</th>
            <th class="py-2.5 px-3 text-right">Net Flow (Delta)</th>
            <th class="py-2.5 px-3 w-48">Liquidity vs Peak</th>
            <th class="py-2.5 px-3">Primary Operational Event</th>
          </tr>
        </thead>
        <tbody id="daily-balances-tbody" class="divide-y divide-slate-100 dark:divide-teal-900/40">
          <tr>
            <td colspan="5" class="py-8 text-center text-slate-400 dark:text-teal-300/60">
              <div class="inline-flex items-center gap-2">
                <svg class="animate-spin h-4 w-4 text-[#173a39] dark:text-emerald-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                </svg>
                <span>Loading daily balance arc...</span>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- TAB 4: DUAL PDF DOCUMENT VIEWER -->
  <div id="tab-panel-pdf" class="statement-panel hidden p-5 space-y-4">
    <!-- PDF Selector Buttons & Actions -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 bg-slate-50 dark:bg-[#061815]/60 p-3.5 rounded-xl border border-slate-200 dark:border-teal-900/60">
      <div class="flex flex-wrap items-center gap-2">
        <button
          type="button"
          id="btn-pdf-bank"
          class="pdf-doc-btn active px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#173a39] text-white dark:bg-emerald-500/20 dark:text-emerald-300 border border-[#173a39] dark:border-emerald-500/40 shadow-xs transition"
          data-pdf-url=""
          data-pdf-title="First Merchants Bank Statement (Aug 2026)"
        >
          1. First Merchants Bank Statement
        </button>
        <button
          type="button"
          id="btn-pdf-qbo"
          class="pdf-doc-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-white dark:bg-teal-950/60 border border-slate-200 dark:border-teal-800/80 text-slate-700 dark:text-teal-200 hover:bg-slate-100 dark:hover:bg-teal-900 transition"
          data-pdf-url=""
          data-pdf-title="QuickBooks Online Official Reconciliation Report (Locked 09/04/2026)"
        >
          2. QBO Official Reconciliation Report (3 Pages)
        </button>
      </div>

      <div class="flex items-center gap-2">
        <a
          id="pdf-open-newtab"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-white dark:bg-teal-950/60 border border-slate-300 dark:border-teal-800/80 text-slate-700 dark:text-teal-200 hover:bg-slate-100 dark:hover:bg-teal-900 transition shadow-xs"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-500 dark:text-teal-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
          Open in New Tab
        </a>
        <a
          id="pdf-download-btn"
          href="#"
          download
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#173a39] text-white hover:bg-teal-900 dark:bg-teal-800 dark:hover:bg-teal-700 transition shadow-xs"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Download PDF
        </a>
      </div>
    </div>

    <!-- Active PDF Title Header -->
    <div class="flex items-center justify-between text-xs px-1 text-slate-600 dark:text-teal-200/80">
      <div>
        Currently Viewing: <strong id="current-pdf-title" class="text-slate-900 dark:text-white font-semibold">First Merchants Bank Statement (Aug 2026)</strong>
      </div>
      <span class="text-[11px] text-slate-400 dark:text-teal-400/60">Native PDF viewer with zoom &amp; page controls</span>
    </div>

    <!-- Embedded PDF Container -->
    <div class="w-full bg-slate-100 dark:bg-[#061815] rounded-xl border border-slate-300 dark:border-teal-800/80 overflow-hidden shadow-inner">
      <iframe
        id="pdf-viewer-frame"
        src=""
        class="w-full h-[700px] border-0"
        title="Bank Statement PDF Viewer"
      ></iframe>
    </div>
  </div>
</section>

<script>
  let activeFilter = 'all';
  let activeQuery = '';

  const formatCurrency = (num: number) => {
    return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 }).format(num);
  };

  function applyTableFilters() {
    const currentRows = document.querySelectorAll<HTMLTableRowElement>('.statement-row');
    const filteredCountEl = document.getElementById('filtered-count');
    const filteredCreditsEl = document.getElementById('filtered-credits');
    const filteredDebitsEl = document.getElementById('filtered-debits');
    const emptyStateEl = document.getElementById('statement-empty-state');

    let visibleCount = 0;
    let sumCredits = 0;
    let sumDebits = 0;

    currentRows.forEach(row => {
      const isDeposit = row.getAttribute('data-is-deposit') === 'true';
      const isCheck = row.getAttribute('data-is-check') === 'true';
      const isPayroll = row.getAttribute('data-is-payroll') === 'true';
      const isAP = row.getAttribute('data-is-ap') === 'true';
      const searchText = row.getAttribute('data-search') || '';
      const amount = parseFloat(row.getAttribute('data-amount') || '0');

      // Category matching
      let matchesFilter = true;
      if (activeFilter === 'deposits') matchesFilter = isDeposit;
      else if (activeFilter === 'withdrawals') matchesFilter = !isDeposit;
      else if (activeFilter === 'checks') matchesFilter = isCheck;
      else if (activeFilter === 'payroll') matchesFilter = isPayroll;
      else if (activeFilter === 'ap') matchesFilter = isAP;

      // Query matching
      let matchesQuery = true;
      if (activeQuery.trim()) {
        matchesQuery = searchText.includes(activeQuery.toLowerCase().trim());
      }

      if (matchesFilter && matchesQuery) {
        row.style.display = '';
        visibleCount++;
        if (amount > 0) {
          sumCredits += amount;
        } else {
          sumDebits += Math.abs(amount);
        }
      } else {
        row.style.display = 'none';
      }
    });

    if (filteredCountEl) filteredCountEl.textContent = visibleCount.toString();
    if (filteredCreditsEl) filteredCreditsEl.textContent = formatCurrency(sumCredits);
    if (filteredDebitsEl) filteredDebitsEl.textContent = formatCurrency(sumDebits);

    if (emptyStateEl) {
      if (visibleCount === 0) {
        emptyStateEl.classList.remove('hidden');
      } else {
        emptyStateEl.classList.add('hidden');
      }
    }
  }

  function initBankStatementViewer() {
    const pager = document.getElementById('bank-month-pager');
    if (pager && pager.dataset.bound !== '1') {
      pager.dataset.bound = '1';
      pager.addEventListener('click', (event) => {
        const btn = (event.target as HTMLElement | null)?.closest?.('[data-bank-month]') as HTMLButtonElement | null;
        const key = btn?.getAttribute('data-bank-month');
        if (key && typeof (window as any).__switchBankMonth === 'function') {
          (window as any).__switchBankMonth(key);
        }
      });
    }

    const yearSelect = document.getElementById('bank-year-select') as HTMLSelectElement | null;
    if (yearSelect && yearSelect.dataset.bound !== '1') {
      yearSelect.dataset.bound = '1';
      yearSelect.addEventListener('change', () => {
        if (typeof (window as any).__switchBankYear === 'function') {
          (window as any).__switchBankYear(yearSelect.value);
        }
      });
    }

    // Tab Switching Logic
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.statement-tab-btn');
    const panels = document.querySelectorAll<HTMLElement>('.statement-panel');

    tabButtons.forEach(btn => {
      if (btn.dataset.bound !== '1') {
        btn.dataset.bound = '1';
        btn.addEventListener('click', () => {
          const tabKey = btn.getAttribute('data-statement-tab');
          if (!tabKey) return;

          // Update button styles with dark ops support
          tabButtons.forEach(b => {
            b.classList.remove('active', 'bg-[#173a39]', 'text-white');
            b.classList.add('bg-white', 'dark:bg-teal-950/60', 'text-slate-700', 'dark:text-teal-200', 'border', 'border-slate-200', 'dark:border-teal-800/80');
          });
          btn.classList.add('active', 'bg-[#173a39]', 'text-white');
          btn.classList.remove('bg-white', 'dark:bg-teal-950/60', 'text-slate-700', 'dark:text-teal-200', 'border', 'border-slate-200', 'dark:border-teal-800/80');

          // Show targeted panel
          panels.forEach(p => p.classList.add('hidden'));
          const targetPanel = document.getElementById(`tab-panel-${tabKey}`);
          if (targetPanel) {
            targetPanel.classList.remove('hidden');
          }
        });
      }
    });

    // Tabular Filtering & Search Logic
    const filterPills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const searchInput = document.getElementById('statement-search-input') as HTMLInputElement | null;

    filterPills.forEach(pill => {
      if (pill.dataset.bound !== '1') {
        pill.dataset.bound = '1';
        pill.addEventListener('click', () => {
          const filter = pill.getAttribute('data-filter') || 'all';
          activeFilter = filter;

          filterPills.forEach(p => {
            p.classList.remove('active', 'bg-[#173a39]', 'text-white');
            p.classList.add('bg-white', 'dark:bg-teal-950/60', 'text-slate-700', 'dark:text-teal-200', 'border', 'border-slate-200', 'dark:border-teal-800/80');
          });
          pill.classList.add('active', 'bg-[#173a39]', 'text-white');
          pill.classList.remove('bg-white', 'dark:bg-teal-950/60', 'text-slate-700', 'dark:text-teal-200', 'border', 'border-slate-200', 'dark:border-teal-800/80');

          applyTableFilters();
        });
      }
    });

    if (searchInput && searchInput.dataset.bound !== '1') {
      searchInput.dataset.bound = '1';
      searchInput.addEventListener('input', (e) => {
        activeQuery = (e.target as HTMLInputElement).value;
        applyTableFilters();
      });
    }

    // Dual PDF Switcher
    const btnPdfBank = document.getElementById('btn-pdf-bank') as HTMLButtonElement | null;
    const btnPdfQbo = document.getElementById('btn-pdf-qbo') as HTMLButtonElement | null;
    const pdfFrame = document.getElementById('pdf-viewer-frame') as HTMLIFrameElement | null;
    const pdfOpenNewTab = document.getElementById('pdf-open-newtab') as HTMLAnchorElement | null;
    const pdfDownloadBtn = document.getElementById('pdf-download-btn') as HTMLAnchorElement | null;
    const pdfTitleEl = document.getElementById('current-pdf-title');

    const setPdfDocument = (btn: HTMLButtonElement) => {
      const url = btn.getAttribute('data-pdf-url');
      const title = btn.getAttribute('data-pdf-title');
      if (!url || !pdfFrame) return;

      pdfFrame.src = `${url}#toolbar=1&navpanes=0&scrollbar=1`;
      if (pdfOpenNewTab) pdfOpenNewTab.href = url;
      if (pdfDownloadBtn) pdfDownloadBtn.href = url;
      if (pdfTitleEl && title) pdfTitleEl.textContent = title;

      [btnPdfBank, btnPdfQbo].forEach(b => {
        if (!b) return;
        b.classList.remove('active', 'bg-[#173a39]', 'text-white');
        b.classList.add('bg-white', 'dark:bg-teal-950/60', 'text-slate-700', 'dark:text-teal-200', 'border', 'border-slate-200', 'dark:border-teal-800/80');
      });
      btn.classList.add('active', 'bg-[#173a39]', 'text-white');
      btn.classList.remove('bg-white', 'dark:bg-teal-950/60', 'text-slate-700', 'dark:text-teal-200', 'border', 'border-slate-200', 'dark:border-teal-800/80');
    };

    if (btnPdfBank && btnPdfBank.dataset.bound !== '1') {
      btnPdfBank.dataset.bound = '1';
      btnPdfBank.addEventListener('click', () => setPdfDocument(btnPdfBank));
    }
    if (btnPdfQbo && btnPdfQbo.dataset.bound !== '1') {
      btnPdfQbo.dataset.bound = '1';
      btnPdfQbo.addEventListener('click', () => setPdfDocument(btnPdfQbo));
    }

    // CSV Export Handler for Bank Statement & Reconciliation Audit
    const exportBankBtn = document.getElementById('btn-export-bank-csv');
    if (exportBankBtn && exportBankBtn.dataset.bound !== '1') {
      exportBankBtn.dataset.bound = '1';
      exportBankBtn.addEventListener('click', () => {
        try {
          const stmt = (window as any).__HSMC_CURRENT_BANK_STMT__;
          const meta = stmt?.metadata || {};
          const period = meta.statement_period || meta.month_name || 'Period';
          const monthKey = meta.month_key || (document.querySelector('.bank-month-btn.active')?.getAttribute('data-bank-month')) || 'Statement';
          const bankBalance = meta.statement_ending_balance != null ? Number(meta.statement_ending_balance).toFixed(2) : (document.getElementById('bank-stat-balance')?.textContent?.trim().replace(/[^0-9.-]/g, '') || '0.00');
          const bookBalance = meta.qbo_register_balance != null ? Number(meta.qbo_register_balance).toFixed(2) : (document.getElementById('bank-stat-cash')?.textContent?.trim().replace(/[^0-9.-]/g, '') || '0.00');
          const reconFloat = meta.reconciled_float != null ? Number(meta.reconciled_float).toFixed(2) : (document.getElementById('bank-stat-recon')?.textContent?.trim().replace(/[^0-9.-]/g, '') || '0.00');
          const totDep = meta.total_deposits_amount != null ? Number(meta.total_deposits_amount).toFixed(2) : (document.getElementById('stmt-total-deposits')?.textContent?.trim().replace(/[^0-9.-]/g, '') || '0.00');
          const totWd = meta.total_withdrawals_amount != null ? Number(meta.total_withdrawals_amount).toFixed(2) : (document.getElementById('stmt-total-withdrawals')?.textContent?.trim().replace(/[^0-9.-]/g, '') || '0.00');

          const rows: string[][] = [
            ['Humane Society of Monroe County - Bank Statement & Reconciliation Audit'],
            ['Institution', 'First Merchants Bank'],
            ['Account', 'Commercial Operating Checking (••••2187)'],
            ['Statement Period', `"${period.replace(/"/g, '""')}"`],
            ['Statement Ending Bank Balance ($)', bankBalance],
            ['General Ledger Book Register Balance ($)', bookBalance],
            ['Reconciled Uncleared Float / Outstanding Checks ($)', reconFloat],
            ['Total Deposits & Credits ($)', totDep],
            ['Total Withdrawals & Debits ($)', totWd],
            [],
            ['STATEMENT TRANSACTIONS LEDGER'],
            ['Date', 'Payee / Entity', 'Check #', 'Type', 'Category', 'Relational Link / Account', 'Amount ($)', 'Running Balance ($)', 'Memo / Description']
          ];

          if (stmt && (stmt.deposits || stmt.withdrawals)) {
            const deps = (stmt.deposits || []).map((d: any) => ({
              date: d.date,
              payee: d.channel ? `${d.channel} Transfer` : 'Deposit',
              checkNum: '',
              type: d.channel === 'Branch' ? 'Branch Deposit' : d.channel === 'Square' ? 'Merchant Card' : 'Electronic Credit',
              category: d.category || 'Revenue',
              relLink: d.relational_account || '',
              amount: Number(d.amount) || 0,
              desc: d.description || ''
            }));
            const wds = (stmt.withdrawals || []).map((w: any) => ({
              date: w.date,
              payee: w.payee || 'Withdrawal',
              checkNum: w.check_number || '',
              type: w.type || 'Debit',
              category: w.category || 'Operating Expense',
              relLink: w.relational_link || '',
              amount: -Math.abs(Number(w.amount) || 0),
              desc: w.description || w.relational_notes || ''
            }));
            const all = [...deps, ...wds].sort((a, b) => {
              if (a.date === b.date) return b.amount - a.amount;
              return a.date.localeCompare(b.date);
            });
            let running = Number(meta.statement_beginning_balance) || 0;
            all.forEach((tx) => {
              running = Math.round((running + tx.amount) * 100) / 100;
              rows.push([
                tx.date,
                `"${tx.payee.replace(/"/g, '""')}"`,
                tx.checkNum ? `"${tx.checkNum}"` : '',
                `"${tx.type.replace(/"/g, '""')}"`,
                `"${tx.category.replace(/"/g, '""')}"`,
                `"${tx.relLink.replace(/"/g, '""')}"`,
                tx.amount.toFixed(2),
                running.toFixed(2),
                `"${tx.desc.replace(/"/g, '""')}"`
              ]);
            });
          } else {
            const trs = document.querySelectorAll('#statement-tbody tr');
            trs.forEach(tr => {
              const tds = tr.querySelectorAll('td');
              if (tds.length >= 6) {
                const date = tds[0]?.textContent?.trim() || '';
                const payee = tds[1]?.querySelector('.font-medium span')?.textContent?.trim() || tds[1]?.textContent?.trim() || '';
                const checkTag = tds[1]?.querySelector('.bg-indigo-100')?.textContent?.trim() || '';
                const desc = tds[1]?.querySelector('.font-mono')?.textContent?.trim() || '';
                const type = tds[2]?.querySelector('span')?.textContent?.trim() || '';
                const category = tds[2]?.querySelectorAll('span')[1]?.textContent?.trim() || '';
                const rel = tds[3]?.querySelector('.font-mono')?.textContent?.trim() || '';
                const amt = tds[4]?.textContent?.trim().replace(/[^0-9.-]/g, '') || '';
                const bal = tds[5]?.textContent?.trim().replace(/[^0-9.-]/g, '') || '';
                rows.push([
                  date,
                  `"${payee.replace(/"/g, '""')}"`,
                  checkTag ? `"${checkTag}"` : '',
                  `"${type.replace(/"/g, '""')}"`,
                  `"${category.replace(/"/g, '""')}"`,
                  `"${rel.replace(/"/g, '""')}"`,
                  amt,
                  bal,
                  `"${desc.replace(/"/g, '""')}"`
                ]);
              }
            });
          }

          if (stmt?.daily_balances && stmt.daily_balances.length) {
            rows.push([]);
            rows.push(['DAILY ENDING BALANCES WATERFALL']);
            rows.push(['Date', 'Ending Balance ($)']);
            stmt.daily_balances.forEach((d: any) => {
              rows.push([d.date, (Number(d.balance) || 0).toFixed(2)]);
            });
          }

          const csvString = rows.map(r => r.join(',')).join('\r\n');
          const blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
          const url = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = url;
          link.setAttribute('download', `HSMC_Bank_Statement_${String(monthKey).replace(/[^a-zA-Z0-9_-]/g, '_')}_Audit.csv`);
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
          URL.revokeObjectURL(url);
        } catch (err) {
          console.error('Failed to export bank CSV:', err);
        }
      });
    }

    applyTableFilters();
  }

  if (!(window as any).__HSMC_BANK_RENDER_BOUND__) {
    (window as any).__HSMC_BANK_RENDER_BOUND__ = true;
    window.addEventListener('bank-statement-rendered', () => {
      applyTableFilters();
    });
  }

  document.addEventListener('astro:page-load', initBankStatementViewer);
</script>
