            <th class="py-2.5 px-3">Transaction Description / Payee</th>
            <th class="py-2.5 px-3">Type & Channel</th>
            <th class="py-2.5 px-3">Relational GL Account / Stream</th>
            <th class="py-2.5 px-3 text-right">Amount</th>
            <th class="py-2.5 px-3 text-right">Running Balance</th>
          </tr>
        </thead>
        <tbody id="statement-tbody" class="divide-y divide-slate-100">
          {allWithRunning.map((tx) => (
            <tr
              class="hover:bg-slate-50/80 transition statement-row"
              data-is-deposit={tx.isDeposit ? 'true' : 'false'}
              data-is-check={tx.isCheck ? 'true' : 'false'}
              data-is-payroll={tx.isPayroll ? 'true' : 'false'}
              data-is-ap={tx.isAP ? 'true' : 'false'}
              data-search={`${tx.date} ${tx.description} ${tx.payee} ${tx.category} ${tx.relational_link} ${tx.relational_notes} ${tx.check_number || ''} ${Math.abs(tx.amount)}`.toLowerCase()}
              data-amount={tx.amount}
            >
              <!-- Date -->
              <td class="py-2.5 px-3 font-mono text-slate-600 whitespace-nowrap">
                {tx.date}
              </td>

              <!-- Description & Payee -->
              <td class="py-2.5 px-3">
                <div class="font-medium text-slate-900 flex items-center gap-1.5">
                  <span>{tx.payee}</span>
                  {tx.check_number && (
                    <span class="inline-flex items-center px-1.5 py-0.2 rounded text-[10px] font-bold bg-indigo-100 text-indigo-800 border border-indigo-200">
                      Check #{tx.check_number}
                    </span>
                  )}
                </div>
                <div class="text-[11px] text-slate-500 font-mono">
                  {tx.description}
                </div>
                {tx.relational_notes && (
                  <div class="text-[10px] text-slate-400 italic">
                    {tx.relational_notes}
                  </div>
                )}
              </td>

              <!-- Type & Channel -->
              <td class="py-2.5 px-3 whitespace-nowrap">
                <span class={`inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold ${
                  tx.isDeposit
                    ? 'bg-emerald-50 text-emerald-800 border border-emerald-200'
                    : tx.isCheck
                    ? 'bg-indigo-50 text-indigo-800 border border-indigo-200'
                    : tx.isPayroll
                    ? 'bg-amber-50 text-amber-900 border border-amber-200'
                    : 'bg-slate-100 text-slate-700'
                }`}>
                  {tx.type}
                </span>
                <span class="block text-[10px] text-slate-400 mt-0.5">{tx.category}</span>
              </td>

              <!-- Relational Link -->
              <td class="py-2.5 px-3">
                <div class="flex items-center gap-1">
                  {tx.isAP && (
                    <span class="inline-flex items-center px-1.5 py-0.2 rounded text-[9px] font-bold bg-purple-100 text-purple-800 border border-purple-200">
                      AP Aging
