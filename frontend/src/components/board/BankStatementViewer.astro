---
import statementData from '../../data/statement_2026_08.json';

interface Props {
  data?: typeof statementData;
}

const { data = statementData } = Astro.props;

const formatDollar = (val: number) => {
  const isNeg = val < 0;
  const abs = Math.abs(val);
  const formatted = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 }).format(abs);
  return isNeg ? `(${formatted})` : formatted;
};

const formatCents = (val: number) => {
  return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 }).format(val);
};

// Compute combined list with uniform structure for tabular display
const depositsFormatted = data.deposits.map((d, i) => ({
  id: `dep-${i}`,
  date: d.date,
  description: d.description,
  payee: d.channel ? `${d.channel} Transfer` : 'Deposit',
  type: d.channel === 'Branch' ? 'Branch Deposit' : d.channel === 'Square' ? 'Merchant Card' : 'Electronic Credit',
  isDeposit: true,
  amount: d.amount,
  category: d.category,
  relational_link: d.relational_account,
  relational_notes: d.relational_notes,
  isPayroll: false,
  isCheck: false,
  isAP: false,
  check_number: null,
}));

const withdrawalsFormatted = data.withdrawals.map((w, i) => {
  const isCheck = !!w.check_number;
  const isPayroll = w.category.includes('Paycheck') || w.category.includes('Payroll') || (w.relational_link && w.relational_link.includes('126'));
  const isAP = !!w.relational_link && (w.relational_link.includes('AP Aging') || w.relational_link.includes('Capital Assets'));
  
  return {
    id: `wd-${i}`,
    date: w.date,
    description: w.description,
    payee: w.payee,
    type: w.type,
    isDeposit: false,
    amount: -Math.abs(w.amount),
    category: w.category,
    relational_link: w.relational_link,
    relational_notes: w.relational_notes,
    isPayroll,
    isCheck,
    isAP,
    check_number: w.check_number || null,
  };
});

// All 108 transactions sorted chronologically
const allTransactions = [...depositsFormatted, ...withdrawalsFormatted].sort((a, b) => {
  if (a.date === b.date) {
    return b.amount - a.amount; // deposits first on same day
  }
  return a.date.localeCompare(b.date);
});

// Calculate running balance starting from $54,280.38
let running = data.metadata.statement_beginning_balance;
const allWithRunning = allTransactions.map((tx) => {
  running = Math.round((running + tx.amount) * 100) / 100;
  return {
    ...tx,
    runningBalance: running,
  };
});

// Precompute daily deltas
const dailyBalances = data.daily_balances.map((item, idx, arr) => {
  const prevBal = idx > 0 ? arr[idx - 1].balance : data.metadata.statement_beginning_balance;
  const delta = Math.round((item.balance - prevBal) * 100) / 100;
  return {
    ...item,
    prevBal,
    delta,
  };
});

const maxDailyBalance = Math.max(...data.daily_balances.map(d => d.balance));
---

<section id="bank-statement-viewer" class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden transition-all duration-300">
  <!-- Header Bar -->
  <div class="px-6 py-5 border-b border-slate-200 bg-[#fbf9f5]">
