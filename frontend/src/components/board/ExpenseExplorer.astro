---
// ExpenseExplorer.astro
// Two-Way Cash Flow Explorer: Symmetric 3-Level Inflows & Expenses Drilldown
// Level 1: Category → Level 2: Vendor/Channel/Payee → Level 3: Transaction
// Multi-Month Support: Jan 2026 – Aug 2026 + All 2026 YTD
interface Withdrawal {
  date: string;
  description: string;
  amount: number;
  category: string;
  payee: string;
  type: string;
  relational_link?: string;
  relational_notes?: string;
  check_number?: string;
}

interface Deposit {
  date: string;
  description: string;
  amount: number;
  category: string;
  channel: string;
  relational_account?: string;
  relational_notes?: string;
}

interface Props {
  withdrawals?: Withdrawal[];
  deposits?: Deposit[];
  statementPeriod?: string;
}

const { withdrawals = [], deposits = [], statementPeriod = 'August 2026' } = Astro.props;

// ── EXPENSE CATEGORY DEFINITIONS FOR AUG BANK REC ─────────────────────────
const EXPENSE_CATEGORY_DEFS = [
  {
    key: 'wages',
    name: 'Wages & Payroll',
    color: 'amber',
    group: 'payroll',
    groupLabel: 'Payroll',
    description: 'Staff direct deposit + physical paychecks across shelter operations',
    sourceCategories: ['Staff Payroll', 'Staff Paycheck'],
  },
  {
    key: 'taxes',
    name: 'Payroll Taxes',
    color: 'rose',
    group: 'payroll',
    groupLabel: 'Payroll',
    description: 'Federal, FICA & Michigan state payroll tax remittances',
    sourceCategories: ['Payroll Taxes'],
  },
  {
    key: 'medical',
    name: 'Veterinary & Medical',
    color: 'teal',
    group: 'operations',
    groupLabel: 'Operations',
    description: 'Vaccines, medications, surgical supplies, compounded drugs, clinics',
    sourceCategories: ['Veterinary & Medical Care', 'Veterinary Supply'],
  },
  {
    key: 'facilities',
    name: 'Facilities & Sanitation',
    color: 'slate',
    group: 'operations',
    groupLabel: 'Operations',
    description: 'Laundry, bedding, cleaning chemicals, waste management',
    sourceCategories: ['Facilities & Sanitation'],
  },
  {
    key: 'insurance',
    name: 'Insurance',
    color: 'blue',
    group: 'operations',
    groupLabel: 'Operations',
    description: 'Commercial property & shelter animal liability policy',
    sourceCategories: ['Insurance & Risk'],
  },
  {
    key: 'capital',
    name: 'Capital Projects',
    color: 'emerald',
    group: 'capital',
    groupLabel: 'Capital',
    description: 'Play yard fencing, kennel improvements, fixed assets',
    sourceCategories: ['Capital Improvements'],
  },
  {
    key: 'creditcard',
    name: 'Credit Card Clearing',
    color: 'purple',
    group: 'operations',
    groupLabel: 'Operations',
    description: 'Monthly Elan credit card autopayment covering shelter card purchases',
    sourceCategories: ['Credit Card Liability'],
  },
  {
    key: 'software',
    name: 'Software & Technology',
    color: 'indigo',
    group: 'operations',
    groupLabel: 'Operations',
    description: 'QuickBooks, Microsoft 365, PetPoint/PetSync cloud subscriptions',
    sourceCategories: ['Software & Technology', 'Software & Cloud'],
  },
  {
    key: 'bankfees',
    name: 'Bank & Merchant Fees',
    color: 'gray',
    group: 'operations',
    groupLabel: 'Operations',
    description: 'Processing fees, merchant gateway charges, bank analysis fees',
    sourceCategories: ['Bank & Processing Fees'],
  },
];

// ── INFLOW CATEGORY DEFINITIONS FOR AUG BANK REC ──────────────────────────
const INFLOW_CATEGORY_DEFS = [
  {
    key: 'community',
    name: 'Branch & Community Donations',
    color: 'emerald',
    group: 'contributions',
    groupLabel: 'Contributions',
    description: 'Community gifts, cash & checks deposited at the Telegraph Rd branch',
    sourceCategories: ['Branch Deposit'],
  },
  {
    key: 'contract',
    name: 'Municipal Animal Control Contract',
    color: 'blue',
    group: 'contracts',
    groupLabel: 'Contracts',
    description: 'City & County municipal shelter animal holding & intake contracts',
    sourceCategories: ['Municipal Contract'],
  },
  {
    key: 'adoptions',
    name: 'Adoption & Service Fees (Square)',
    color: 'teal',
    group: 'services',
    groupLabel: 'Earned Revenue',
    description: 'Pet adoption processing fees, microchipping, retail counter supplies',
    sourceCategories: ['Merchant Processing'],
  },
  {
    key: 'digital',
    name: 'Digital Donations & Grants',
    color: 'purple',
    group: 'contributions',
    groupLabel: 'Contributions',
    description: 'BetterUnite pledges, institutional foundation grants, Zeffy fee-free, PayPal',
    sourceCategories: ['Fundraising Platform', 'Institutional Grants', 'Fee-Free Platform', 'Digital Donations'],
  },
];

// ── BUILD DEFAULT EXPENSES TREE (August Bank Statement) ────────────────────
type VendorEntry = {
  payee: string;
  total: number;
  txCount: number;
  transactions: Withdrawal[];
};

type ExpenseCategoryEntry = {
  key: string;
  name: string;
  color: string;
  group: string;
  groupLabel: string;
  description: string;
  total: number;
  txCount: number;
  vendors: VendorEntry[];
};

const expenseCategories: ExpenseCategoryEntry[] = EXPENSE_CATEGORY_DEFS.map((def) => {
  const txs = withdrawals.filter((w) => def.sourceCategories.includes(w.category));
  const vendorMap = new Map<string, Withdrawal[]>();
  for (const tx of txs) {
    const k = tx.payee ?? 'Unknown';
    if (!vendorMap.has(k)) vendorMap.set(k, []);
    vendorMap.get(k)!.push(tx);
  }
  const vendors: VendorEntry[] = Array.from(vendorMap.entries())
    .map(([payee, vtxs]) => ({
      payee,
      total: vtxs.reduce((s, t) => s + t.amount, 0),
      txCount: vtxs.length,
      transactions: [...vtxs].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()),
    }))
    .sort((a, b) => b.total - a.total);

  return {
    ...def,
    total: txs.reduce((s, t) => s + t.amount, 0),
    txCount: txs.length,
    vendors,
  };
}).filter((c) => c.txCount > 0).sort((a, b) => b.total - a.total);

const grandTotalExpenses = expenseCategories.reduce((s, c) => s + c.total, 0);

// ── BUILD DEFAULT INFLOWS TREE (August Bank Statement) ─────────────────────
type ChannelEntry = {
  payee: string;
  total: number;
  txCount: number;
  transactions: Deposit[];
};

type InflowCategoryEntry = {
  key: string;
  name: string;
  color: string;
  group: string;
  groupLabel: string;
  description: string;
  total: number;
  txCount: number;
  vendors: ChannelEntry[];
};

const inflowCategories: InflowCategoryEntry[] = INFLOW_CATEGORY_DEFS.map((def) => {
  const txs = deposits.filter((d) => def.sourceCategories.includes(d.category));
  const channelMap = new Map<string, Deposit[]>();
  for (const tx of txs) {
    const k = tx.channel || tx.category || 'Direct';
    if (!channelMap.has(k)) channelMap.set(k, []);
    channelMap.get(k)!.push(tx);
  }
  const vendors: ChannelEntry[] = Array.from(channelMap.entries())
    .map(([channel, dtxs]) => ({
      payee: channel,
      total: dtxs.reduce((s, t) => s + t.amount, 0),
      txCount: dtxs.length,
      transactions: [...dtxs].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()),
    }))
    .sort((a, b) => b.total - a.total);

  return {
    ...def,
    total: txs.reduce((s, t) => s + t.amount, 0),
    txCount: txs.length,
    vendors,
  };
}).filter((c) => c.txCount > 0).sort((a, b) => b.total - a.total);

const grandTotalInflows = inflowCategories.reduce((s, c) => s + c.total, 0);
const netMonthVariance = grandTotalInflows - grandTotalExpenses;

// ── Helpers ────────────────────────────────────────────────────────────────
function fmt(n: number) {
  return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 }).format(n);
}
function fmtDate(d: string) {
  return new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

type ColorSet = { bg: string; border: string; text: string; badge: string; badgeText: string; row: string };
function cc(color: string): ColorSet {
  const map: Record<string, ColorSet> = {
    amber:   { bg: 'bg-amber-50',   border: 'border-amber-200',   text: 'text-amber-900',   badge: 'bg-amber-100',   badgeText: 'text-amber-800',   row: 'hover:bg-amber-50/60' },
    rose:    { bg: 'bg-rose-50',    border: 'border-rose-200',    text: 'text-rose-900',    badge: 'bg-rose-100',    badgeText: 'text-rose-800',    row: 'hover:bg-rose-50/60' },
    teal:    { bg: 'bg-teal-50',    border: 'border-teal-200',    text: 'text-teal-900',    badge: 'bg-teal-100',    badgeText: 'text-teal-800',    row: 'hover:bg-teal-50/60' },
    slate:   { bg: 'bg-slate-50',   border: 'border-slate-200',   text: 'text-slate-700',   badge: 'bg-slate-100',   badgeText: 'text-slate-700',   row: 'hover:bg-slate-50/60' },
    blue:    { bg: 'bg-blue-50',    border: 'border-blue-200',    text: 'text-blue-900',    badge: 'bg-blue-100',    badgeText: 'text-blue-800',    row: 'hover:bg-blue-50/60' },
    emerald: { bg: 'bg-emerald-50', border: 'border-emerald-200', text: 'text-emerald-900', badge: 'bg-emerald-100', badgeText: 'text-emerald-800', row: 'hover:bg-emerald-50/60' },
    purple:  { bg: 'bg-purple-50',  border: 'border-purple-200',  text: 'text-purple-900',  badge: 'bg-purple-100',  badgeText: 'text-purple-800',  row: 'hover:bg-purple-50/60' },
    indigo:  { bg: 'bg-indigo-50',  border: 'border-indigo-200',  text: 'text-indigo-900',  badge: 'bg-indigo-100',  badgeText: 'text-indigo-800',  row: 'hover:bg-indigo-50/60' },
    gray:    { bg: 'bg-gray-50',    border: 'border-gray-200',    text: 'text-gray-700',    badge: 'bg-gray-100',    badgeText: 'text-gray-700',    row: 'hover:bg-gray-50/60' },
  };
  return map[color] ?? map['slate'];
}

const monthKeys = [
  { id: 'month_2026_7', label: 'Aug 2026' },
  { id: 'month_2026_6', label: 'Jul 2026' },
  { id: 'month_2026_5', label: 'Jun 2026' },
  { id: 'month_2026_4', label: 'May 2026' },
  { id: 'month_2026_3', label: 'Apr 2026' },
  { id: 'month_2026_2', label: 'Mar 2026' },
  { id: 'month_2026_1', label: 'Feb 2026' },
  { id: 'month_2026_0', label: 'Jan 2026' },
  { id: 'all_ytd',      label: 'All 2026 YTD' },
];

---

<div id="expense-explorer-root" class="space-y-4">

  <!-- ── Mode Switcher & Flow Summary ──────────────────────────────────────── -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-xs p-4 sm:p-5">
    
    <!-- Month-to-Month Period Selector Tabs -->
    <div class="flex items-center gap-1.5 overflow-x-auto pb-3 mb-4 border-b border-slate-100 text-xs scrollbar-thin">
      <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider shrink-0 mr-1.5 flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke-width="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6" stroke-width="2" stroke-linecap="round"></line>
          <line x1="8" y1="2" x2="8" y2="6" stroke-width="2" stroke-linecap="round"></line>
          <line x1="3" y1="10" x2="21" y2="10" stroke-width="2"></line>
        </svg>
        Period:
      </span>
      {monthKeys.map((m) => (
        <button
          type="button"
          class={`ee-period-btn px-2.5 py-1.5 rounded-lg font-bold text-xs whitespace-nowrap transition cursor-pointer ${
            m.id === 'month_2026_7'
              ? 'bg-[#173a39] text-white shadow-xs'
              : 'bg-slate-100/90 text-slate-700 hover:bg-slate-200/80 border border-slate-200/70'
          }`}
          data-month-id={m.id}
          data-month-label={m.label}
        >
          {m.label}
        </button>
      ))}
    </div>

    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-teal-100 text-teal-800 border border-teal-200">
            Cash Flow Explorer
          </span>
          <span class="text-[11px] text-slate-400 font-medium" id="ee-period-subtitle">
            {statementPeriod} · QuickBooks General Ledger Detail
          </span>
        </div>
        <h2 class="text-xl font-bold text-slate-800 tracking-tight" id="ee-title">
          August 2026 Cash Flow Drilldown
        </h2>
        <p class="text-xs text-slate-500 mt-0.5" id="ee-desc">
          Explore month-to-month transactions. Level 1: Categories · Level 2: Bundled payees &amp; vendors · Level 3: Individual transactions.
        </p>
      </div>

      <!-- Net Monthly Variance Callout -->
      <div class="flex items-center gap-3 bg-slate-50 p-2.5 rounded-lg border border-slate-200 shrink-0" id="ee-variance-card">
        <div class="text-right">
          <div class="text-[10px] uppercase font-bold text-slate-400" id="ee-variance-label">August Net Margin</div>
          <div class="font-mono font-black text-sm text-slate-500" id="ee-variance-value">{expenseCategories.length ? fmt(netMonthVariance) : '--'}</div>
          <div class="text-[9px] text-slate-500" id="ee-variance-caption">QuickBooks Online Verified</div>
        </div>
        <div class="w-8 h-8 rounded-lg bg-slate-200/70 text-slate-600 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Mode Selector Tabs -->
    <div class="flex flex-wrap items-center gap-2 mt-4 pt-4 border-t border-slate-100">
      <button
        id="ee-tab-expenses"
        class="ee-mode-tab active px-4 py-2 rounded-lg font-bold text-xs flex items-center gap-2 transition cursor-pointer"
        data-mode="expenses"
      >
        <svg class="w-3.5 h-3.5 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
        <span>Expenditures</span>
        <span class="px-1.5 py-0.5 rounded-full text-[10px] font-mono bg-white/20 text-white" id="ee-badge-exp-count">
          {expenseCategories.length ? `${expenseCategories.length} categories` : 'Loading…'}
        </span>
      </button>

      <button
        id="ee-tab-inflows"
        class="ee-mode-tab px-4 py-2 rounded-lg font-bold text-xs flex items-center gap-2 transition bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 cursor-pointer"
        data-mode="inflows"
      >
        <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
        <span>Revenue Inflows</span>
        <span class="px-1.5 py-0.5 rounded-full text-[10px] font-mono bg-slate-100 text-slate-600" id="ee-badge-inf-count">
          {inflowCategories.length ? `${inflowCategories.length} categories` : 'Loading…'}
        </span>
      </button>

      <!-- Global Filter & Actions -->
      <div class="ml-auto flex items-center gap-2 flex-wrap">
        <div class="relative min-w-[180px]">
          <input
            type="text"
            id="ee-global-search"
            placeholder="Search payees, items, checks..."
            class="w-full pl-7 pr-2 py-1.5 text-xs rounded-lg border border-slate-200 bg-white text-slate-800 placeholder-slate-400 focus:outline-hidden focus:ring-1 focus:ring-teal-600"
          />
          <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2 top-2.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>

        <button
          id="ee-export-active-btn"
          class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-white text-slate-700 border border-slate-200 hover:bg-slate-50 transition flex items-center gap-1.5 shadow-2xs cursor-pointer"
          title="Download active view as CSV"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span id="ee-export-label">Export CSV</span>
        </button>
      </div>
    </div>

    <!-- Group Filter Chips (Expenses) -->
    <div id="ee-expense-filters" class="flex flex-wrap items-center gap-1.5 mt-3 pt-3 border-t border-slate-100">
      <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mr-1">Group:</span>
      <button class="ee-filter-chip active" data-ee-filter="all">All Groups</button>
      <button class="ee-filter-chip" data-ee-filter="payroll">Payroll &amp; Taxes</button>
      <button class="ee-filter-chip" data-ee-filter="operations">Shelter &amp; Medical Ops</button>
      <button class="ee-filter-chip" data-ee-filter="capital">Capital Projects</button>
    </div>

    <!-- Group Filter Chips (Inflows) -->
    <div id="ee-inflow-filters" class="hidden flex-wrap items-center gap-1.5 mt-3 pt-3 border-t border-slate-100">
      <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mr-1">Group:</span>
      <button class="ee-filter-chip active" data-ee-filter="all">All Inflows</button>
      <button class="ee-filter-chip" data-ee-filter="contributions">Donations &amp; Grants</button>
      <button class="ee-filter-chip" data-ee-filter="services">Adoption Fees</button>
      <button class="ee-filter-chip" data-ee-filter="contracts">Contracts</button>
    </div>

  </div>

  <!-- ── 1. EXPENSES VIEW ─────────────────────────────────────────────────── -->
  <div id="ee-view-expenses" class="space-y-2">
    <div id="ee-expense-category-list" class="space-y-2">
      {expenseCategories.length === 0 && (
        <div class="rounded-xl border border-slate-200 bg-white px-5 py-8 text-center text-sm text-slate-500">
          Loading cash-flow categories after sign-in…
        </div>
      )}
      {expenseCategories.map((cat, catIdx) => {
        const c = cc(cat.color);
        return (
          <div
            class={`ee-category-block rounded-xl border ${c.border} bg-white shadow-xs overflow-hidden`}
            data-cat-key={cat.key}
            data-cat-group={cat.group}
            data-cat-total={cat.total.toFixed(2)}
            data-cat-name={cat.name}
          >
            <!-- Level 1: Category header row -->
            <button
              class={`ee-cat-toggle w-full flex items-center gap-3 px-5 py-4 text-left transition ${c.row} group`}
              aria-expanded="false"
              data-cat-idx={catIdx}
              data-view="expense"
            >
              <span class={`w-2.5 h-2.5 rounded-full ${c.badgeText.replace('text-', 'bg-')} shrink-0`}></span>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-bold text-slate-800 text-sm">{cat.name}</span>
                  <span class={`px-1.5 py-0.5 rounded text-[10px] font-bold ${c.badge} ${c.badgeText}`}>{cat.groupLabel}</span>
                </div>
                <p class="text-[11px] text-slate-500 mt-0.5 truncate">{cat.description}</p>
              </div>
              <div class="text-right flex-shrink-0 mr-1">
                <span class={`font-black font-mono text-base block ${c.text}`}>{fmt(cat.total)}</span>
                <span class="text-[11px] text-slate-400 block">{cat.vendors.length} payees · {cat.txCount} txs</span>
              </div>
              <span class="ee-chevron text-slate-400 group-hover:text-slate-600 transition-transform duration-200 flex-shrink-0 ml-1 flex items-center justify-center">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </span>
            </button>

            <!-- Level 2: Vendor panel -->
            <div class="ee-vendor-panel hidden border-t border-slate-100" data-cat-idx={catIdx}>
              <!-- Vendor sort header -->
              <div class="px-5 py-2.5 bg-slate-50 border-b border-slate-100 flex items-center gap-3">
                <span class="flex-1 text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                  Payee / Vendor / Employee
                </span>
                <span class="w-20 text-right text-[10px] font-bold text-slate-400 uppercase tracking-wider hidden sm:block">Transactions</span>
                <span class="w-28 text-right text-[10px] font-bold text-slate-400 uppercase tracking-wider">Amount</span>
                <span class="w-5"></span>
              </div>

              <!-- Vendor rows -->
              <div class="ee-vendor-rows divide-y divide-slate-50">
                {cat.vendors.map((vendor, vIdx) => (
                  <div class="ee-vendor-block">
                    <!-- Level 2: Vendor toggle row -->
                    <button
                      class="ee-vendor-toggle w-full flex items-center gap-3 px-5 py-3 text-left transition hover:bg-slate-50/80 group"
                      aria-expanded="false"
                      data-cat-idx={catIdx}
                      data-vendor-idx={vIdx}
                    >
                      <span class="w-5 h-5 rounded-full bg-slate-100 text-slate-600 text-[9px] font-black flex items-center justify-center flex-shrink-0 select-none">
                        {vIdx + 1}
                      </span>
                      <span class="flex-1 min-w-0 font-semibold text-sm text-slate-800 truncate text-left">{vendor.payee}</span>
                      <span class="w-20 text-right text-[11px] text-slate-400 hidden sm:block">{vendor.txCount} txs</span>
                      <span class="w-28 text-right font-black font-mono text-sm text-slate-900 flex-shrink-0">{fmt(vendor.total)}</span>
                      <span class="ee-vendor-chevron text-slate-400 group-hover:text-slate-600 transition-transform duration-150 w-5 flex items-center justify-center flex-shrink-0">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                      </span>
                    </button>

                    <!-- Level 3: Transactions panel -->
                    <div class="ee-tx-panel hidden bg-slate-50/70 border-t border-slate-100" data-cat-idx={catIdx} data-vendor-idx={vIdx}>
                      <div class="px-6 py-2.5 border-b border-slate-100 flex items-center justify-between gap-2">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
                          {vendor.payee} · {vendor.txCount} transaction{vendor.txCount !== 1 ? 's' : ''}
                        </span>
                        <button
                          class="ee-export-vendor-btn text-[10px] font-bold text-teal-700 hover:text-teal-900 transition whitespace-nowrap"
                          data-cat-idx={catIdx}
                          data-vendor-idx={vIdx}
                          data-type="expense"
                        >
                          Export CSV
                        </button>
                      </div>
                      <div class="overflow-x-auto">
                        <table class="w-full text-xs min-w-[480px]">
                          <thead>
                            <tr class="border-b border-slate-200 bg-white">
                              <th class="text-left px-6 py-2 text-[10px] font-bold uppercase tracking-wider text-slate-400 w-16">Date</th>
                              <th class="text-left px-3 py-2 text-[10px] font-bold uppercase tracking-wider text-slate-400">Description / Memo</th>
                              <th class="text-left px-3 py-2 text-[10px] font-bold uppercase tracking-wider text-slate-400 hidden sm:table-cell w-28">Type</th>
                              <th class="text-right px-6 py-2 text-[10px] font-bold uppercase tracking-wider text-slate-400 w-24">Amount</th>
                            </tr>
                          </thead>
                          <tbody class="divide-y divide-slate-100">
                            {vendor.transactions.map((tx) => (
                              <tr class="hover:bg-white transition">
                                <td class="px-6 py-2.5 text-slate-500 whitespace-nowrap font-medium">{fmtDate(tx.date)}</td>
                                <td class="px-3 py-2.5">
                                  <div class="font-semibold text-slate-700 leading-tight">{tx.description}</div>
                                  {tx.relational_notes && (
                                    <div class="text-slate-400 text-[10px] mt-0.5 leading-tight">{tx.relational_notes}</div>
                                  )}
                                  {tx.check_number && (
                                    <span class="inline-block mt-0.5 px-1.5 rounded text-[9px] font-bold bg-slate-200 text-slate-600">
                                      Ck #{tx.check_number}
