---
interface Props {
  qboOperatingNet: number;
  allInNet: number;
  bridge: {
    endowment_distributions: number;
    recycling_and_rebates: number;
    recycling_detail: {
      bottle_and_can_recycling: number;
      retail_partner_rebates: number;
      court_restitution: number;
    };
    fleet_transit_and_fuel: number;
    fleet_detail: {
      gas: number;
      repairs_and_maintenance: number;
    };
    net_bridge_total: number;
    c2_commentary: string;
  };
}

const { qboOperatingNet, allInNet, bridge } = Astro.props;

const formatCents = (val: number) => {
  const isNeg = val < 0;
  const abs = Math.abs(val);
  const formatted = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 }).format(abs);
  return isNeg ? `(${formatted})` : formatted;
};

const formatSigned = (val: number) => {
  const isNeg = val < 0;
  const abs = Math.abs(val);
  const formatted = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 }).format(abs);
  return isNeg ? `- ${formatted}` : `+ ${formatted}`;
};
---

<div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden">
  <div class="px-5 py-4 border-b border-slate-100 bg-[#f5efe3]/50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
    <div>
      <h3 class="text-base font-semibold text-[#173a39]">
        Certified Operating-to-All-In Reconciliation Bridge
      </h3>
      <p class="text-xs text-slate-500 mt-0.5">
        CONF-1 Certified: Preserving QBO operating net on certified statements with C2 commentary for substance.
      </p>
    </div>
    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200 self-start sm:self-auto">
      Cent-for-Cent Reconciled (+{formatCents(bridge.net_bridge_total).replace('(', '').replace(')', '')})
    </span>
  </div>

  <div class="p-5">
    <div class="space-y-3">
      <!-- Starting point -->
      <div class="flex items-center justify-between p-3 rounded-lg bg-amber-50/60 border border-amber-200/70">
        <div>
          <span class="text-sm font-bold text-amber-950">QBO Certified Operating Net</span>
          <p class="text-xs text-amber-800/80">Operating Inflows ($344,249.31) less COGS & Operating Outflows ($480,595.48)</p>
        </div>
        <span class="text-base font-bold font-mono text-amber-900">{formatCents(qboOperatingNet)}</span>
      </div>

      <!-- Additions & Subtractions -->
      <div class="pl-4 pr-3 py-2 space-y-2 border-l-2 border-[#1c746c]/30 ml-3">
        <!-- Endowment -->
        <div class="flex items-center justify-between text-sm">
          <div class="flex items-center gap-2">
            <span class="text-emerald-600 font-bold text-xs">+</span>
            <span class="text-slate-700 font-medium">Endowment Distributions</span>
            <span class="text-xs text-slate-400">(Monroe County Community Foundation quarterly draws)</span>
          </div>
          <span class="font-mono font-medium text-emerald-700">{formatSigned(bridge.endowment_distributions)}</span>
        </div>

        <!-- Recycling & Rebates -->
        <div class="flex items-center justify-between text-sm">
          <div class="flex items-center gap-2">
            <span class="text-emerald-600 font-bold text-xs">+</span>
            <span class="text-slate-700 font-medium">Recycling, Rebates & Restitution</span>
            <span class="text-xs text-slate-400">(Can drive $8.2k · Kroger/Meijer $3.0k · Court $60)</span>
          </div>
          <span class="font-mono font-medium text-emerald-700">{formatSigned(bridge.recycling_and_rebates)}</span>
        </div>

        <!-- Fleet Transit -->
        <div class="flex items-center justify-between text-sm">
          <div class="flex items-center gap-2">
            <span class="text-rose-600 font-bold text-xs">-</span>
            <span class="text-slate-700 font-medium">Fleet Transit & Gasoline Spend</span>
            <span class="text-xs text-slate-400">(Fuel card $10.8k · Maintenance $190.10)</span>
          </div>
          <span class="font-mono font-medium text-rose-700">{formatSigned(bridge.fleet_transit_and_fuel)}</span>
        </div>
      </div>

      <!-- Net Bridge Subtotal -->
      <div class="flex items-center justify-between px-3 py-2 rounded-lg bg-slate-50 border border-slate-200">
        <span class="text-xs font-semibold text-slate-700 uppercase tracking-wide">Net Non-Operating Adjustment</span>
        <span class="text-sm font-bold font-mono text-emerald-700">+{formatCents(bridge.net_bridge_total)}</span>
      </div>

      <!-- Final Bottom Line -->
      <div class="flex items-center justify-between p-3.5 rounded-lg bg-rose-50 border border-rose-300">
        <div>
          <span class="text-sm font-bold text-rose-950">All-In Certified Bottom Line</span>
          <p class="text-xs text-rose-800/80">Total Inflows ($383,968.86) less Total Expenditures ($491,541.93)</p>
        </div>
        <span class="text-lg font-bold font-mono text-rose-700">{formatCents(allInNet)}</span>
      </div>
    </div>

    <!-- C2 Commentary Callout -->
    <div class="mt-4 p-3 rounded-lg bg-[#f9f7f2] border border-[#e5ded0] text-xs text-[#173a39] leading-relaxed">
      <div class="flex items-start gap-2">
        <svg class="w-4 h-4 text-[#1c746c] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
          <span class="font-semibold text-[#173a39]">Governance Standard Note (CONF-1 & C2):</span>
          <span>
            {bridge.c2_commentary} Per board governance determination, the certified financial statement adheres strictly to QBO account types to prevent duplicate accounting versions, while this bridge details operational substance.
          </span>
        </div>
      </div>
    </div>
  </div>
</div>\n