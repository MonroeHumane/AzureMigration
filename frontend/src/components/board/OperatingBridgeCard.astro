---
interface Props {
  qboOperatingNet?: number;
  allInNet?: number;
  bridge?: {
    endowment_distributions: number;
    recycling_and_rebates: number;
    recycling_detail: {
      bottle_and_can_recycling: number;
      retail_partner_rebates: number;
      court_restitution: number;
    };
    fleet_transit_and_fuel: number;
    fleet_detail: {
      gas: number;
      repairs_and_maintenance: number;
    };
    net_bridge_total: number;
    c2_commentary: string;
  };
}

const { qboOperatingNet, allInNet, bridge } = Astro.props;

const formatCents = (val: number) => {
  const isNeg = val < 0;
  const abs = Math.abs(val);
  const formatted = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 }).format(abs);
  return isNeg ? `(${formatted})` : formatted;
};

const formatSigned = (val: number) => {
  const isNeg = val < 0;
  const abs = Math.abs(val);
  const formatted = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 }).format(abs);
  return isNeg ? `- ${formatted}` : `+ ${formatted}`;
};
---

<div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden">
  <div class="px-5 py-4 border-b border-slate-100 bg-[#f5efe3]/50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
    <div>
      <h3 class="text-base font-semibold text-[#173a39]">Operating bridge</h3>
    </div>
    <span id="bridge-badge" class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200 self-start sm:self-auto">
      {bridge ? `Net Outside Support: +${formatCents(bridge.net_bridge_total).replace('(', '').replace(')', '')}` : 'Net Outside Support'}
    </span>
  </div>

  <div class="p-5">
    <div class="space-y-3">
      <!-- Starting point -->
      <div class="flex items-center justify-between p-3 rounded-lg bg-amber-50/60 border border-amber-200/70">
        <div>
          <span class="text-sm font-medium text-slate-800">Shelter net</span>
          <p class="text-xs text-slate-500"><span id="bridge-op-inflows"></span> <span id="bridge-op-outflows"></span></p>
        </div>
        <span id="bridge-qbo-net" class="text-base font-bold font-mono text-amber-900">{qboOperatingNet !== undefined ? formatCents(qboOperatingNet) : '--'}</span>
      </div>

      <!-- Additions & Subtractions -->
      <div class="pl-4 pr-3 py-2 space-y-2.5 border-l-2 border-[#1c746c]/30 ml-3">
        <!-- Endowment -->
        <div class="flex items-center justify-between text-sm">
          <div class="flex items-center gap-2">
            <span class="text-emerald-600 font-bold text-xs">(+)</span>
            <div>
              <span class="text-slate-700">Endowment</span>
            </div>
          </div>
          <span id="bridge-endowment" class="font-mono font-medium text-emerald-700">{bridge ? formatSigned(bridge.endowment_distributions) : '--'}</span>
        </div>

        <!-- Recycling & Rebates -->
        <div class="flex items-center justify-between text-sm">
          <div class="flex items-center gap-2">
            <span class="text-emerald-600 font-bold text-xs">(+)</span>
            <div>
              <span class="text-slate-700">Recycling / rebates</span>
            </div>
          </div>
          <span id="bridge-recycling" class="font-mono font-medium text-emerald-700">{bridge ? formatSigned(bridge.recycling_and_rebates) : '--'}</span>
        </div>

        <!-- Fleet Transit -->
        <div class="flex items-center justify-between text-sm">
          <div class="flex items-center gap-2">
            <span class="text-rose-600 font-bold text-xs">(-)</span>
            <div>
              <span class="text-slate-700">Fleet</span>
            </div>
          </div>
          <span id="bridge-fleet" class="font-mono font-medium text-rose-700">{bridge ? formatSigned(bridge.fleet_transit_and_fuel) : '--'}</span>
        </div>
      </div>

      <!-- Net Bridge Subtotal -->
      <div class="flex items-center justify-between px-3 py-2 rounded-lg bg-slate-50 border border-slate-200">
        <div>
          <span class="text-xs text-slate-600">Outside support</span>
        </div>
        <span id="bridge-net-total" class="text-sm font-bold font-mono text-emerald-700">{bridge ? `+${formatCents(bridge.net_bridge_total)}` : '--'}</span>
      </div>

      <!-- Final Bottom Line -->
      <div class="flex items-center justify-between p-3.5 rounded-lg bg-rose-50 border border-rose-300">
        <div>
          <span class="text-sm font-medium text-slate-800">YTD net</span>
          <p class="text-xs text-slate-500"><span id="bridge-allin-inflows"></span> <span id="bridge-allin-outflows"></span></p>
        </div>
        <span id="bridge-all-in-net" class="text-lg font-bold font-mono text-rose-700">{allInNet !== undefined ? formatCents(allInNet) : '--'}</span>
      </div>
    </div>

    <!-- Commentary Callout -->
    <div class="mt-4 p-3.5 rounded-lg bg-[#f9f7f2] border border-[#e5ded0] text-xs text-[#173a39] leading-relaxed">
      <div class="flex items-start gap-2.5">
        <svg class="w-4 h-4 text-[#1c746c] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
          <p class="text-slate-600">
            <span id="bridge-c2-commentary">{bridge?.c2_commentary || ''}</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>