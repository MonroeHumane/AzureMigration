---
import monthlyDrilldownsData from '../../data/monthly_drilldown_2026.json';

interface MonthlyItem {
  name: string;
  amount: number;
  group?: string;
}

interface MonthRow {
  id: string;
  month: string;
  is_partial: boolean;
  revenue: number;
  cogs: number;
  operating_exp: number;
  other_exp: number;
  total_exp: number;
  net_margin: number;
  margin_pct: number;
  status: string;
  driver: string;
  rev_items: MonthlyItem[];
  exp_items: MonthlyItem[];
}

interface Props {
  statements?: MonthRow[];
}

const { statements = [] } = Astro.props;

const formatDollar = (val: number) => {
  const isNeg = val < 0;
  const abs = Math.abs(val);
  const formatted = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 }).format(abs);
  return isNeg ? `(${formatted})` : formatted;
};

// Compute certified totals if provided
const totalRev = statements.reduce((acc, m) => acc + m.revenue, 0);
const totalCogs = statements.reduce((acc, m) => acc + m.cogs, 0);
const totalOpExp = statements.reduce((acc, m) => acc + m.operating_exp, 0);
const totalOtherExp = statements.reduce((acc, m) => acc + m.other_exp, 0);
const totalExp = statements.reduce((acc, m) => acc + m.total_exp, 0);
const totalNet = statements.reduce((acc, m) => acc + m.net_margin, 0);
const totalMarginPct = totalRev > 0 ? (totalNet / totalRev) * 100 : 0;

const monthsMap = (monthlyDrilldownsData as any).months || {};
---

<div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden" id="monthly-statement-root" data-statements={statements.length ? JSON.stringify(statements) : ''}>
  <div class="px-5 py-4 border-b border-slate-100 bg-[#f5efe3]/50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
    <div>
      <h3 class="text-base font-semibold text-[#173a39]">
        2026 Month-by-Month Operating Statement
      </h3>
      <p class="text-xs text-slate-500 mt-0.5">
        Reconciled from QuickBooks Online general ledger. Click any month row to view 3-level interactive drilldown (Categories → Payees/Entities → Granular Transactions).
      </p>
    </div>
    <div class="flex items-center gap-2 self-start sm:self-auto">
      <button
        id="export-statement-csv-btn"
        type="button"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-white text-[#173a39] border border-slate-300 hover:bg-slate-50 hover:border-slate-400 shadow-xs transition cursor-pointer"
        title="Download certified 8-month statement as Excel/CSV"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Export CSV (Excel)</span>
      </button>
      <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200">
        Exact Footing Reconciled
      </span>
    </div>
  </div>

  <!-- Desktop Table View -->
  <div class="hidden md:block overflow-x-auto">
    <table class="w-full text-left text-xs sm:text-sm">
      <thead class="bg-slate-100/80 text-slate-600 font-semibold text-xs uppercase tracking-wider border-b border-slate-200">
        <tr>
          <th scope="col" class="py-3 px-4">Period</th>
          <th scope="col" class="py-3 px-3 text-right">Revenue</th>
          <th scope="col" class="py-3 px-3 text-right">Direct Care (COGS)</th>
          <th scope="col" class="py-3 px-3 text-right">Operations & Payroll</th>
          <th scope="col" class="py-3 px-3 text-right">Fleet & Other</th>
          <th scope="col" class="py-3 px-3 text-right">Total Exp</th>
          <th scope="col" class="py-3 px-3 text-right">Net Margin</th>
          <th scope="col" class="py-3 px-3 text-right">Margin %</th>
          <th scope="col" class="py-3 px-4">Driver & Status</th>
        </tr>
      </thead>
      <tbody id="statement-rows-tbody" class="divide-y divide-slate-200/70">
        {statements.length > 0 ? (
          statements.map((m) => {
            const isSurplus = m.net_margin >= 0;
            const drilldown = monthsMap[m.id] || null;
            const revCats = drilldown?.revenueCategories || [];
            const expCats = drilldown?.expenseCategories || [];

            return (
              <>
                <tr
                  class="hover:bg-slate-50/80 transition cursor-pointer group"
                  id={`row-${m.id}`}
                  data-target={`drawer-${m.id}`}
                  title="Click to toggle month drilldown"
                >
                  <td class="py-3 px-4 font-semibold text-slate-900 whitespace-nowrap flex items-center gap-2">
                    <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-slate-600 transition transform group-[.is-open]:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                    <span>{m.month}</span>
                    {m.is_partial && (
                      <span class="px-1.5 py-0.5 text-[10px] font-bold bg-amber-100 text-amber-800 rounded border border-amber-200">
                        Partial
                      </span>
                    )}
                  </td>
                  <td class="py-3 px-3 text-right font-mono font-medium text-slate-900 whitespace-nowrap">{formatDollar(m.revenue)}</td>
                  <td class="py-3 px-3 text-right font-mono text-slate-700 whitespace-nowrap">{formatDollar(m.cogs)}</td>
                  <td class="py-3 px-3 text-right font-mono text-slate-700 whitespace-nowrap">{formatDollar(m.operating_exp)}</td>
                  <td class="py-3 px-3 text-right font-mono text-slate-700 whitespace-nowrap">{formatDollar(m.other_exp)}</td>
                  <td class="py-3 px-3 text-right font-mono font-medium text-slate-900 whitespace-nowrap">{formatDollar(m.total_exp)}</td>
                  <td class={`py-3 px-3 text-right font-mono font-bold whitespace-nowrap ${isSurplus ? 'text-emerald-600' : 'text-rose-600'}`}>
                    {isSurplus ? '+' : ''}{formatDollar(m.net_margin)}
                  </td>
                  <td class={`py-3 px-3 text-right font-semibold whitespace-nowrap ${isSurplus ? 'text-emerald-600' : 'text-rose-600'}`}>
                    {m.margin_pct.toFixed(1)}%
                  </td>
                  <td class="py-3 px-4 text-xs text-slate-500 whitespace-nowrap flex items-center justify-between">
                    <span class="truncate max-w-[140px] sm:max-w-xs" title={m.driver}>{m.driver}</span>
                    <span class={`ml-2 inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium ${
                      isSurplus ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-rose-50 text-rose-700 border border-rose-200'
                    }`}>
                      {m.status}
                    </span>
                  </td>
                </tr>

                {/* 3-Level Interactive Drawer */}
                <tr id={`drawer-${m.id}`} class="hidden bg-[#fbf9f5] border-y border-slate-200/80">
                  <td colspan="9" class="p-4 sm:p-6">
                    <div class="space-y-4">
                      {/* Top Bar: Title, Live Search, Action to Jump to Cash Flow Explorer */}
                      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-3 border-b border-slate-200">
                        <div>
                          <div class="flex items-center gap-2">
                            <span class="text-sm font-bold text-slate-900">{m.month} Hierarchical Drilldown</span>
                            <span class="text-[11px] text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 font-medium">QuickBooks Verified</span>
                            <span class="text-[11px] text-slate-500">
                              ({drilldown?.totalExpenseTxs || 0} spend txs · {drilldown?.totalRevenueTxs || 0} inflow txs)
                            </span>
                          </div>
                          <p class="text-xs text-slate-500 mt-0.5">
                            Level 1: Categories with cost · Level 2: Bundled payees &amp; vendors · Level 3: Individual transactions
                          </p>
                        </div>

                        <div class="flex flex-wrap items-center gap-2">
                          {/* Search Filter Input */}
                          <div class="relative min-w-[220px]">
                            <input
                              type="text"
                              placeholder="Filter categories, payees, checks..."
                              class="drawer-search-input w-full pl-7 pr-2 py-1.5 text-xs rounded-md border border-slate-300 bg-white text-slate-800 placeholder-slate-400 focus:outline-hidden focus:ring-1 focus:ring-teal-600 focus:border-teal-600"
                              data-drawer-id={`drawer-${m.id}`}
                            />
                            <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2 top-2.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                          </div>

                          {/* Action to Jump to Section 3 (Cash Flow Explorer) */}
                          <button
                            type="button"
                            class="jump-to-explorer-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold bg-[#173a39] text-white hover:bg-teal-900 transition shadow-xs cursor-pointer"
                            data-month-id={m.id}
                            title="Open this month in the interactive Cash Flow Explorer with search & export"
                          >
                            <span>Explore in Cash Flow Explorer</span>
                            <svg class="w-3 h-3 text-teal-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                          </button>
                        </div>
                      </div>

                      {/* Side-by-Side: Revenue Inflows (Left) & Expenditures (Right) */}
                      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

                        {/* Revenue Inflows Schedule */}
                        <div class="bg-white rounded-xl border border-emerald-200/80 shadow-2xs overflow-hidden flex flex-col">
                          <div class="bg-emerald-900 text-white px-4 py-2.5 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shrink-0"></span>
                              <h4 class="text-xs font-bold uppercase tracking-wider text-emerald-100">
                                Revenue Inflows ({m.month})
                              </h4>
                            </div>
                            <span class="text-xs font-mono font-bold text-emerald-200 bg-emerald-950/60 px-2 py-0.5 rounded border border-emerald-700/60">
                              {formatDollar(m.revenue)}
                            </span>
                          </div>

                          <div class="p-3 divide-y divide-slate-100 max-h-[500px] overflow-y-auto drawer-cat-list" data-flow="revenue">
                            {revCats.length > 0 ? (
                              revCats.map((cat: any, catIdx: number) => {
                                const catId = `rev-cat-${m.id}-${catIdx}`;
                                return (
                                  <div class="py-2 drawer-cat-item" data-cat-name={cat.name.toLowerCase()}>
                                    {/* Level 1: Category Header (Clickable) */}
                                    <button
                                      type="button"
                                      class="w-full flex items-center justify-between text-left p-2 rounded-lg hover:bg-emerald-50/60 transition cursor-pointer group/cat cat-toggle-btn"
                                      data-toggle-target={catId}
                                    >
                                      <div class="flex items-center gap-2 min-w-0 pr-2">
                                        <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0 transition-transform transform group-[.is-cat-open]/cat:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                        </svg>
                                        <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
                                        <div class="min-w-0">
                                          <span class="font-semibold text-slate-800 text-xs block truncate">{cat.name}</span>
                                          <span class="text-[10px] text-slate-400 block truncate">{cat.group}</span>
                                        </div>
                                      </div>
                                      <div class="text-right shrink-0 flex items-center gap-2">
                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-emerald-100/70 text-emerald-800">
                                          {cat.payeeCount} {cat.payeeCount === 1 ? 'entity' : 'entities'} · {cat.txCount} txs
                                        </span>
                                        <span class="font-mono font-bold text-xs text-emerald-700 min-w-[70px] text-right">
                                          +{formatDollar(cat.total)}
                                        </span>
                                      </div>
                                    </button>

                                    {/* Level 2: Bundled Payees / Donors List */}
                                    <div id={catId} class="hidden pl-6 pr-2 pt-1 pb-2 space-y-1.5 bg-emerald-50/30 rounded-b-lg border-l-2 border-emerald-400 mt-1">
                                      {cat.payees.map((payee: any, pIdx: number) => {
                                        const payeeId = `rev-payee-${m.id}-${catIdx}-${pIdx}`;
                                        return (
                                          <div class="drawer-payee-item bg-white/80 rounded border border-emerald-100 p-2" data-payee-name={payee.name.toLowerCase()}>
                                            <button
                                              type="button"
                                              class="w-full flex items-center justify-between text-left transition cursor-pointer group/payee payee-toggle-btn"
                                              data-toggle-target={payeeId}
                                            >
                                              <div class="flex items-center gap-1.5 min-w-0 pr-2">
                                                <svg class="w-3 h-3 text-slate-400 shrink-0 transition-transform transform group-[.is-payee-open]/payee:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                                </svg>
                                                <span class="text-xs font-medium text-slate-800 truncate">{payee.name}</span>
                                              </div>
                                              <div class="flex items-center gap-1.5 shrink-0">
                                                <span class="text-[10px] text-slate-400 font-mono">({payee.txCount} txs)</span>
                                                <span class="font-mono font-semibold text-xs text-emerald-800">+{formatDollar(payee.total)}</span>
                                              </div>
                                            </button>

                                            {/* Level 3: Individual Transactions */}
                                            <div id={payeeId} class="hidden mt-2 pt-2 border-t border-slate-100 space-y-1">
                                              {payee.transactions.map((t: any) => (
                                                <div class="flex items-center justify-between text-[11px] py-1 px-1.5 bg-slate-50/80 rounded hover:bg-emerald-50/50 transition">
                                                  <div class="min-w-0 pr-2">
                                                    <div class="flex items-center gap-1.5">
                                                      <span class="text-[10px] font-mono text-slate-400 shrink-0">{t.date}</span>
                                                      {t.num && <span class="px-1 py-0.2 rounded bg-slate-200 text-slate-700 text-[9px] font-mono shrink-0">#{t.num}</span>}
                                                      <span class="text-slate-700 font-medium truncate">{t.type}</span>
                                                    </div>
                                                    {t.memo && <div class="text-[10px] text-slate-500 truncate mt-0.5">{t.memo}</div>}
                                                  </div>
                                                  <span class="font-mono font-bold text-xs text-emerald-700 shrink-0">+{formatDollar(t.amount)}</span>
                                                </div>
                                              ))}
                                            </div>
                                          </div>
                                        );
                                      })}
                                    </div>
                                  </div>
                                );
                              })
                            ) : (
                              (m.rev_items || []).map((it) => (
                                <div class="py-2 px-2 flex items-center justify-between">
                                  <span class="text-xs text-slate-800">{it.name}</span>
                                  <span class="font-mono font-bold text-xs text-emerald-700">+{formatDollar(it.amount)}</span>
                                </div>
                              ))
                            )}
                          </div>

                          <div class="mt-auto px-4 py-2.5 bg-emerald-50/70 border-t border-emerald-100 flex items-center justify-between text-xs text-emerald-900 font-bold">
                            <span>Total Verified Inflows ({revCats.length || (m.rev_items || []).length} categories):</span>
                            <span class="font-mono font-bold text-emerald-800">{formatDollar(m.revenue)}</span>
                          </div>
                        </div>

                        {/* Expenditures Schedule */}
                        <div class="bg-white rounded-xl border border-rose-200/80 shadow-2xs overflow-hidden flex flex-col">
                          <div class="bg-[#173a39] text-white px-4 py-2.5 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                              <span class="w-2.5 h-2.5 rounded-full bg-amber-400 shrink-0"></span>
                              <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200">
                                Expenditures by Category ({m.month})
                              </h4>
                            </div>
                            <span class="text-xs font-mono font-bold text-amber-200 bg-teal-950/60 px-2 py-0.5 rounded border border-teal-700/60">
                              {formatDollar(m.total_exp)}
                            </span>
                          </div>

                          <div class="p-3 divide-y divide-slate-100 max-h-[500px] overflow-y-auto drawer-cat-list" data-flow="expense">
                            {expCats.length > 0 ? (
                              expCats.map((cat: any, catIdx: number) => {
                                const catId = `exp-cat-${m.id}-${catIdx}`;
                                return (
                                  <div class="py-2 drawer-cat-item" data-cat-name={cat.name.toLowerCase()}>
                                    {/* Level 1: Category Header (Clickable) */}
                                    <button
                                      type="button"
                                      class="w-full flex items-center justify-between text-left p-2 rounded-lg hover:bg-slate-50 transition cursor-pointer group/cat cat-toggle-btn"
                                      data-toggle-target={catId}
                                    >
                                      <div class="flex items-center gap-2 min-w-0 pr-2">
                                        <svg class="w-3.5 h-3.5 text-teal-700 shrink-0 transition-transform transform group-[.is-cat-open]/cat:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                        </svg>
                                        <span class="w-2 h-2 rounded-full bg-slate-400 shrink-0"></span>
                                        <div class="min-w-0">
                                          <span class="font-semibold text-slate-800 text-xs block truncate">{cat.name}</span>
                                          <span class="text-[10px] text-slate-400 block truncate">{cat.group}</span>
                                        </div>
                                      </div>
                                      <div class="text-right shrink-0 flex items-center gap-2">
                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-slate-100 text-slate-700">
                                          {cat.payeeCount} {cat.payeeCount === 1 ? 'payee' : 'payees'} · {cat.txCount} txs
                                        </span>
                                        <span class="font-mono font-bold text-xs text-slate-900 min-w-[70px] text-right">
                                          {formatDollar(cat.total)}
                                        </span>
                                      </div>
                                    </button>

                                    {/* Level 2: Bundled Payees / Vendors List */}
                                    <div id={catId} class="hidden pl-6 pr-2 pt-1 pb-2 space-y-1.5 bg-slate-50/60 rounded-b-lg border-l-2 border-[#173a39] mt-1">
                                      {cat.payees.map((payee: any, pIdx: number) => {
                                        const payeeId = `exp-payee-${m.id}-${catIdx}-${pIdx}`;
                                        return (
                                          <div class="drawer-payee-item bg-white/90 rounded border border-slate-200 p-2" data-payee-name={payee.name.toLowerCase()}>
                                            <button
                                              type="button"
                                              class="w-full flex items-center justify-between text-left transition cursor-pointer group/payee payee-toggle-btn"
                                              data-toggle-target={payeeId}
                                            >
                                              <div class="flex items-center gap-1.5 min-w-0 pr-2">
                                                <svg class="w-3 h-3 text-slate-400 shrink-0 transition-transform transform group-[.is-payee-open]/payee:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                                </svg>
                                                <span class="text-xs font-medium text-slate-800 truncate">{payee.name}</span>
                                              </div>
                                              <div class="flex items-center gap-1.5 shrink-0">
                                                <span class="text-[10px] text-slate-400 font-mono">({payee.txCount} txs)</span>
                                                <span class="font-mono font-semibold text-xs text-slate-900">{formatDollar(payee.total)}</span>
                                              </div>
                                            </button>

                                            {/* Level 3: Individual Transactions */}
                                            <div id={payeeId} class="hidden mt-2 pt-2 border-t border-slate-100 space-y-1">
                                              {payee.transactions.map((t: any) => (
                                                <div class="flex items-center justify-between text-[11px] py-1 px-1.5 bg-slate-50/80 rounded hover:bg-slate-100 transition">
                                                  <div class="min-w-0 pr-2">
                                                    <div class="flex items-center gap-1.5">
                                                      <span class="text-[10px] font-mono text-slate-400 shrink-0">{t.date}</span>
                                                      {t.num && <span class="px-1 py-0.2 rounded bg-slate-200 text-slate-700 text-[9px] font-mono shrink-0">#{t.num}</span>}
                                                      <span class="text-slate-700 font-medium truncate">{t.type}</span>
                                                    </div>
                                                    {t.memo && <div class="text-[10px] text-slate-500 truncate mt-0.5">{t.memo}</div>}
                                                    {t.split && <div class="text-[9px] text-slate-400 truncate">Account: {t.split}</div>}
                                                  </div>
                                                  <span class="font-mono font-bold text-xs text-slate-900 shrink-0">{formatDollar(t.amount)}</span>
                                                </div>
                                              ))}
                                            </div>
                                          </div>
                                        );
                                      })}
                                    </div>
                                  </div>
                                );
                              })
                            ) : (
                              (m.exp_items || []).map((it) => (
                                <div class="py-2 px-2 flex items-center justify-between">
                                  <span class="text-xs text-slate-800">{it.name}</span>
                                  <span class="font-mono font-bold text-xs text-slate-900">{formatDollar(it.amount)}</span>
                                </div>
                              ))
                            )}
                          </div>

                          <div class="mt-auto px-4 py-2.5 bg-slate-50 border-t border-slate-200 flex items-center justify-between text-xs text-slate-900 font-bold">
                            <span>Total Verified Spend ({expCats.length || (m.exp_items || []).length} categories):</span>
                            <span class="font-mono font-bold text-slate-900">{formatDollar(m.total_exp)}</span>
                          </div>
                        </div>

                      </div>
                    </div>
                  </td>
                </tr>
              </>
            );
          })
        ) : (
          <tr id="statement-loading-row" class="animate-pulse">
            <td colspan="9" class="py-8 text-center text-slate-400">
              <div class="inline-flex items-center gap-2">
                <svg class="animate-spin h-4 w-4 text-teal-700" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span>Loading certified monthly statements...</span>
              </div>
            </td>
          </tr>
        )}
      </tbody>
      {/* Certified Footing Row */}
      <tfoot class="bg-[#173a39] text-white font-semibold text-xs border-t-2 border-[#0f766e]">
        <tr>
          <td class="py-3 px-4 font-bold text-white uppercase tracking-wider">
            2026 YTD Certified Footing
          </td>
          <td id="footing-rev" class="py-3 px-3 text-right font-mono text-emerald-300 font-bold">{statements.length ? formatDollar(totalRev) : '--'}</td>
          <td id="footing-cogs" class="py-3 px-3 text-right font-mono text-slate-300">{statements.length ? formatDollar(totalCogs) : '--'}</td>
          <td id="footing-op-exp" class="py-3 px-3 text-right font-mono text-slate-300">{statements.length ? formatDollar(totalOpExp) : '--'}</td>
          <td id="footing-other-exp" class="py-3 px-3 text-right font-mono text-slate-300">{statements.length ? formatDollar(totalOtherExp) : '--'}</td>
          <td id="footing-total-exp" class="py-3 px-3 text-right font-mono text-amber-300 font-bold">{statements.length ? formatDollar(totalExp) : '--'}</td>
          <td id="footing-net-margin" class="py-3 px-3 text-right font-mono text-rose-400 font-bold">{statements.length ? formatDollar(totalNet) : '--'}</td>
          <td id="footing-margin-pct" class="py-3 px-3 text-right text-rose-300 font-bold">{statements.length ? `${totalMarginPct.toFixed(1)}%` : '--%'}</td>
          <td class="py-3 px-4 text-emerald-400 text-xs">
            ✓ Balanced &amp; reconciled to QuickBooks Online
          </td>
        </tr>
      </tfoot>
    </table>
  </div>

  <!-- Mobile Stacked Card View (hidden on md+) -->
  <div id="monthly-statement-mobile-container" class="md:hidden divide-y divide-slate-200 bg-slate-50/50">
    {statements.length > 0 ? (
      statements.map((m) => {
        const isSurplus = m.net_margin >= 0;
        const drilldown = monthsMap[m.id] || null;
        const revCats = drilldown?.revenueCategories || [];
        const expCats = drilldown?.expenseCategories || [];

        return (
          <div class="p-4 bg-white hover:bg-slate-50/80 transition" id={`mobile-card-${m.id}`}>
            <div class="flex items-start justify-between gap-2 mb-2">
              <div>
                <div class="flex items-center gap-1.5 font-bold text-slate-900 text-sm">
                  <span>{m.month}</span>
                  {m.is_partial && (
                    <span class="px-1.5 py-0.5 text-[10px] font-bold bg-amber-100 text-amber-800 rounded border border-amber-200">
                      Partial
                    </span>
                  )}
                </div>
                <div class="text-[11px] text-slate-500 mt-0.5" title={m.driver}>
                  {m.driver}
                </div>
              </div>
              <div class="text-right flex flex-col items-end shrink-0">
                <span class={`font-mono font-bold text-sm ${isSurplus ? 'text-emerald-600' : 'text-rose-600'}`}>
                  {isSurplus ? '+' : ''}{formatDollar(m.net_margin)}
                </span>
                <span class={`inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold mt-0.5 ${
                  isSurplus ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-rose-50 text-rose-700 border border-rose-200'
                }`}>
                  {m.margin_pct.toFixed(1)}% &bull; {m.status}
                </span>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-2 bg-slate-50 p-2.5 rounded-lg border border-slate-200/80 text-xs mb-2.5">
              <div>
                <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">Revenue</span>
                <span class="font-mono font-semibold text-slate-800">{formatDollar(m.revenue)}</span>
              </div>
              <div>
                <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">Total Exp</span>
                <span class="font-mono font-semibold text-slate-800">{formatDollar(m.total_exp)}</span>
              </div>
              <div>
                <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">Direct Care</span>
                <span class="font-mono text-slate-600">{formatDollar(m.cogs)}</span>
              </div>
              <div>
                <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">Ops &amp; Payroll</span>
                <span class="font-mono text-slate-600">{formatDollar(m.operating_exp)}</span>
              </div>
            </div>

            <button
              type="button"
              class="w-full py-1.5 px-3 rounded text-xs font-semibold text-teal-800 bg-teal-50 hover:bg-teal-100/80 border border-teal-200/60 flex items-center justify-center gap-1.5 transition cursor-pointer"
              data-mobile-target={`mobile-drawer-${m.id}`}
            >
              <span>View Hierarchical Drilldown</span>
              <svg class="w-3.5 h-3.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <div id={`mobile-drawer-${m.id}`} class="hidden pt-3 space-y-3">
              {/* Mobile Revenue List */}
              <div class="bg-white rounded-lg border border-emerald-200 shadow-2xs overflow-hidden">
                <div class="bg-emerald-800 text-white px-3 py-2 flex items-center justify-between">
                  <span class="text-xs font-bold flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-300"></span>
                    Revenue Inflows ({m.month})
                  </span>
                  <span class="font-mono font-bold text-xs text-emerald-200">{formatDollar(m.revenue)}</span>
                </div>
                <div class="p-2 divide-y divide-slate-100 text-xs max-h-72 overflow-y-auto">
                  {revCats.map((cat: any) => (
                    <div class="py-2">
                      <div class="flex justify-between items-center">
                        <span class="font-semibold text-slate-800 flex items-center gap-1.5">
                          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
                          {cat.name}
                        </span>
                        <span class="font-mono font-bold text-emerald-700">+{formatDollar(cat.total)}</span>
                      </div>
                      <div class="text-[10px] text-slate-400 mt-0.5">
                        {cat.payeeCount} {cat.payeeCount === 1 ? 'entity' : 'entities'} · {cat.txCount} transactions
                      </div>
                      {cat.payees && cat.payees.length > 0 && (
                        <div class="mt-1 pl-2 border-l border-emerald-300 space-y-0.5">
                          {cat.payees.slice(0, 3).map((p: any) => (
                            <div class="flex justify-between text-[10px] text-slate-600">
                              <span class="truncate pr-1">{p.name}</span>
                              <span class="font-mono shrink-0">+{formatDollar(p.total)}</span>
                            </div>
                          ))}
                          {cat.payees.length > 3 && (
                            <div class="text-[9px] text-slate-400 italic">+{cat.payees.length - 3} more entities...</div>
                          )}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              </div>

              {/* Mobile Expenditures List */}
              <div class="bg-white rounded-lg border border-rose-200 shadow-2xs overflow-hidden">
                <div class="bg-[#173a39] text-white px-3 py-2 flex items-center justify-between">
                  <span class="text-xs font-bold flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-amber-300"></span>
                    Expenditures ({m.month})
                  </span>
                  <span class="font-mono font-bold text-xs text-amber-200">{formatDollar(m.total_exp)}</span>
                </div>
                <div class="p-2 divide-y divide-slate-100 text-xs max-h-72 overflow-y-auto">
                  {expCats.map((cat: any) => (
                    <div class="py-2">
                      <div class="flex justify-between items-center">
                        <span class="font-semibold text-slate-800 flex items-center gap-1.5">
                          <span class="w-1.5 h-1.5 rounded-full bg-slate-400 shrink-0"></span>
                          {cat.name}
                        </span>
                        <span class="font-mono font-bold text-slate-900">{formatDollar(cat.total)}</span>
                      </div>
                      <div class="text-[10px] text-slate-400 mt-0.5">
                        {cat.payeeCount} {cat.payeeCount === 1 ? 'payee' : 'payees'} · {cat.txCount} transactions
                      </div>
                      {cat.payees && cat.payees.length > 0 && (
                        <div class="mt-1 pl-2 border-l border-[#173a39] space-y-0.5">
                          {cat.payees.slice(0, 3).map((p: any) => (
                            <div class="flex justify-between text-[10px] text-slate-600">
                              <span class="truncate pr-1">{p.name}</span>
                              <span class="font-mono shrink-0">{formatDollar(p.total)}</span>
                            </div>
                          ))}
                          {cat.payees.length > 3 && (
                            <div class="text-[9px] text-slate-400 italic">+{cat.payees.length - 3} more payees...</div>
                          )}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              </div>

              {/* Mobile Button to Cash Flow Explorer */}
              <button
                type="button"
                class="jump-to-explorer-btn w-full py-2 px-3 rounded-md text-xs font-bold bg-[#173a39] text-white flex items-center justify-center gap-1.5"
                data-month-id={m.id}
              >
                <span>Explore in Full Cash Flow Explorer →</span>
              </button>
            </div>
          </div>
        );
      })
    ) : (
      <div class="p-6 text-center text-slate-400 text-xs">
        Loading mobile statements...
      </div>
    )}

    {/* Mobile Certified Footing Card */}
    <div class="p-4 bg-[#173a39] text-white">
      <div class="text-[11px] font-bold uppercase tracking-wider text-emerald-300 mb-2 flex items-center justify-between">
        <span>2026 YTD Certified Footing</span>
        <span class="text-[10px] text-emerald-400 font-normal">✓ Cent-for-cent</span>
      </div>
      <div class="grid grid-cols-2 gap-2 text-xs">
        <div>
          <span class="text-slate-300 block text-[10px]">Total Revenue</span>
          <span id="mobile-footing-rev" class="font-mono font-bold text-emerald-300">{statements.length ? formatDollar(totalRev) : '--'}</span>
        </div>
        <div>
          <span class="text-slate-300 block text-[10px]">Total Expenditures</span>
          <span id="mobile-footing-exp" class="font-mono font-bold text-amber-300">{statements.length ? formatDollar(totalExp) : '--'}</span>
        </div>
        <div>
          <span class="text-slate-300 block text-[10px]">Net Margin</span>
          <span id="mobile-footing-net" class="font-mono font-bold text-rose-400">{statements.length ? formatDollar(totalNet) : '--'}</span>
        </div>
        <div>
          <span class="text-slate-300 block text-[10px]">Margin %</span>
          <span id="mobile-footing-pct" class="font-mono font-bold text-rose-300">{statements.length ? `${totalMarginPct.toFixed(1)}%` : '--%'}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initMonthlyStatement() {
    // Desktop drawer expand/collapse (Month level)
    document.querySelectorAll('[data-target]').forEach((row) => {
      row.addEventListener('click', () => {
        const targetId = row.getAttribute('data-target');
        if (targetId) {
          const drawer = document.getElementById(targetId);
          if (drawer) {
            drawer.classList.toggle('hidden');
            row.classList.toggle('is-open');
          }
        }
      });
    });

    // Mobile drawer expand/collapse
    document.querySelectorAll('[data-mobile-target]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-mobile-target');
        if (targetId) {
          const drawer = document.getElementById(targetId);
          if (drawer) {
            drawer.classList.toggle('hidden');
            const svg = btn.querySelector('svg');
            if (svg) svg.classList.toggle('rotate-180');
          }
        }
      });
    });

    // Level 1: Category toggle inside drawer
    document.querySelectorAll('.cat-toggle-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const targetId = btn.getAttribute('data-toggle-target');
        if (targetId) {
          const targetEl = document.getElementById(targetId);
          if (targetEl) {
            targetEl.classList.toggle('hidden');
            btn.classList.toggle('is-cat-open');
          }
        }
      });
    });

    // Level 2: Payee toggle inside drawer
    document.querySelectorAll('.payee-toggle-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const targetId = btn.getAttribute('data-toggle-target');
        if (targetId) {
          const targetEl = document.getElementById(targetId);
          if (targetEl) {
            targetEl.classList.toggle('hidden');
            btn.classList.toggle('is-payee-open');
          }
        }
      });
    });

    // In-drawer real-time filter search
    document.querySelectorAll('.drawer-search-input').forEach((input) => {
      input.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
        const drawerId = input.getAttribute('data-drawer-id');
        if (!drawerId) return;
        const drawer = document.getElementById(drawerId);
        if (!drawer) return;

        const catItems = drawer.querySelectorAll<HTMLElement>('.drawer-cat-item');
        catItems.forEach((catItem) => {
          const catName = catItem.getAttribute('data-cat-name') || '';
          const payeeItems = catItem.querySelectorAll<HTMLElement>('.drawer-payee-item');
          let catMatched = catName.includes(query);
          let matchedPayeeCount = 0;

          payeeItems.forEach((pItem) => {
            const pName = pItem.getAttribute('data-payee-name') || '';
            const textContent = pItem.textContent?.toLowerCase() || '';
            const pMatch = pName.includes(query) || textContent.includes(query);
            if (pMatch) {
              pItem.classList.remove('hidden');
              matchedPayeeCount++;
            } else {
              pItem.classList.add('hidden');
            }
          });

          if (!query || catMatched || matchedPayeeCount > 0) {
            catItem.classList.remove('hidden');
            // Auto-expand if searching
            if (query) {
              const catSub = catItem.querySelector('[id^="rev-cat-"], [id^="exp-cat-"]');
              if (catSub) catSub.classList.remove('hidden');
            }
          } else {
            catItem.classList.add('hidden');
          }
        });
      });
    });

    // Cross-module linking: Jump to Cash Flow Explorer for selected month
    document.querySelectorAll('.jump-to-explorer-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const monthId = btn.getAttribute('data-month-id');
        if (!monthId) return;

        // Trigger month selection in Expense Explorer if function is available
        if (typeof (window as any).switchExpenseExplorerMonth === 'function') {
          (window as any).switchExpenseExplorerMonth(monthId);
        }

        // Show all modules or activate expenses section
        const expensesSec = document.getElementById('sec-expenses');
        if (expensesSec) {
          expensesSec.classList.remove('hidden');
          expensesSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // Handle CSV export
    const exportBtn = document.getElementById('export-statement-csv-btn');
    const root = document.getElementById('monthly-statement-root');
    if (exportBtn && root) {
      exportBtn.addEventListener('click', () => {
        try {
          const raw = root.getAttribute('data-statements');
          if (!raw) return;
          const statements = JSON.parse(raw);

          const headers = [
            'Period',
            'Revenue ($)',
            'Direct Care COGS ($)',
            'Operations & Payroll ($)',
            'Fleet & Other ($)',
            'Total Expenditures ($)',
            'Net Margin ($)',
            'Margin (%)',
            'Driver & Status'
          ];

          const rows = statements.map((s: any) => [
            `"${s.month.replace(/"/g, '""')}"`,
            s.revenue.toFixed(2),
            s.cogs.toFixed(2),
            s.operating_exp.toFixed(2),
            s.other_exp.toFixed(2),
            s.total_exp.toFixed(2),
            s.net_margin.toFixed(2),
            s.margin_pct.toFixed(1),
            `"${(s.driver || '').replace(/"/g, '""')}"`
          ]);

          // Compute Footed Certified Totals
          const totRev = statements.reduce((a: number, b: any) => a + b.revenue, 0);
          const totCogs = statements.reduce((a: number, b: any) => a + b.cogs, 0);
          const totOp = statements.reduce((a: number, b: any) => a + b.operating_exp, 0);
          const totOther = statements.reduce((a: number, b: any) => a + b.other_exp, 0);
          const totExp = statements.reduce((a: number, b: any) => a + b.total_exp, 0);
          const totNet = statements.reduce((a: number, b: any) => a + b.net_margin, 0);
          const totMarginPct = (totNet / totRev) * 100;

          rows.push([
            '"2026 YTD Certified Footing"',
            totRev.toFixed(2),
            totCogs.toFixed(2),
            totOp.toFixed(2),
            totOther.toFixed(2),
            totExp.toFixed(2),
            totNet.toFixed(2),
            totMarginPct.toFixed(1),
            '"Reconciled to QuickBooks Online general ledger"'
          ]);

          const csvString = [headers.join(','), ...rows.map((r: string[]) => r.join(','))].join('\r\n');
          const blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
          const url = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = url;
          link.setAttribute('download', `HSMC_2026_Operating_Statement_YTD_${new Date().toISOString().slice(0, 10)}.csv`);
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
          URL.revokeObjectURL(url);
        } catch (err) {
          console.error('Failed to export statement CSV:', err);
        }
      });
    }
  }

  document.addEventListener('astro:page-load', initMonthlyStatement);
  if (document.readyState !== 'loading') {
    initMonthlyStatement();
  } else {
    document.addEventListener('DOMContentLoaded', initMonthlyStatement);
  }
</script>