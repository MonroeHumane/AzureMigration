---
interface MonthlyItem {
  name: string;
  amount: number;
}

interface MonthRow {
  id: string;
  month: string;
  is_partial: boolean;
  revenue: number;
  cogs: number;
  operating_exp: number;
  other_exp: number;
  total_exp: number;
  net_margin: number;
  margin_pct: number;
  status: string;
  driver: string;
  rev_items: MonthlyItem[];
  exp_items: MonthlyItem[];
}

interface Props {
  statements?: MonthRow[];
}

const { statements = [] } = Astro.props;

const formatDollar = (val: number) => {
  const isNeg = val < 0;
  const abs = Math.abs(val);
  const formatted = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 }).format(abs);
  return isNeg ? `(${formatted})` : formatted;
};

// Compute certified totals if provided
const totalRev = statements.reduce((acc, m) => acc + m.revenue, 0);
const totalCogs = statements.reduce((acc, m) => acc + m.cogs, 0);
const totalOpExp = statements.reduce((acc, m) => acc + m.operating_exp, 0);
const totalOtherExp = statements.reduce((acc, m) => acc + m.other_exp, 0);
const totalExp = statements.reduce((acc, m) => acc + m.total_exp, 0);
const totalNet = statements.reduce((acc, m) => acc + m.net_margin, 0);
const totalMarginPct = totalRev > 0 ? (totalNet / totalRev) * 100 : 0;
---

<div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden" id="monthly-statement-root" data-statements={statements.length ? JSON.stringify(statements) : ''}>
  <div class="px-5 py-4 border-b border-slate-100 bg-[#f5efe3]/50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
    <div>
      <h3 class="text-base font-semibold text-[#173a39]">
        2026 Month-by-Month Operating Statement
      </h3>
      <p class="text-xs text-slate-500 mt-0.5">
        CONF-3 Verified: Certified cent-for-cent QBO pull. Zero plug lines. Click any row to expand line-item schedule.
      </p>
    </div>
    <div class="flex items-center gap-2 self-start sm:self-auto">
      <button
        id="export-statement-csv-btn"
        type="button"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-white text-[#173a39] border border-slate-300 hover:bg-slate-50 hover:border-slate-400 shadow-xs transition cursor-pointer"
        title="Download certified 8-month statement as Excel/CSV"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Export CSV (Excel)</span>
      </button>
      <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200">
        Exact Footing Reconciled
      </span>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-xs sm:text-sm">
      <thead class="bg-slate-100/80 text-slate-600 font-semibold text-xs uppercase tracking-wider border-b border-slate-200">
        <tr>
          <th scope="col" class="py-3 px-4">Period</th>
          <th scope="col" class="py-3 px-3 text-right">Revenue</th>
          <th scope="col" class="py-3 px-3 text-right">Direct Care (COGS)</th>
          <th scope="col" class="py-3 px-3 text-right">Operations & Payroll</th>
          <th scope="col" class="py-3 px-3 text-right">Fleet & Other</th>
          <th scope="col" class="py-3 px-3 text-right">Total Exp</th>
          <th scope="col" class="py-3 px-3 text-right">Net Margin</th>
          <th scope="col" class="py-3 px-3 text-right">Margin %</th>
          <th scope="col" class="py-3 px-4">Driver & Status</th>
        </tr>
      </thead>
      <tbody id="statement-rows-tbody" class="divide-y divide-slate-200/70">
        {statements.length > 0 ? (
          statements.map((m) => {
            const isSurplus = m.net_margin >= 0;
            return (
              <>
                <tr
                  class="hover:bg-slate-50/80 transition cursor-pointer group"
                  id={`row-${m.id}`}
                  data-target={`drawer-${m.id}`}
                >
                  <td class="py-3 px-4 font-semibold text-slate-900 whitespace-nowrap flex items-center gap-2">
                    <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-slate-600 transition transform group-[.is-open]:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                    <span>{m.month}</span>
                    {m.is_partial && (
                      <span class="px-1.5 py-0.5 text-[10px] font-bold bg-amber-100 text-amber-800 rounded border border-amber-200">
                        Partial
                      </span>
                    )}
                  </td>
                  <td class="py-3 px-3 text-right font-mono font-medium text-slate-900 whitespace-nowrap">{formatDollar(m.revenue)}</td>
                  <td class="py-3 px-3 text-right font-mono text-slate-700 whitespace-nowrap">{formatDollar(m.cogs)}</td>
                  <td class="py-3 px-3 text-right font-mono text-slate-700 whitespace-nowrap">{formatDollar(m.operating_exp)}</td>
                  <td class="py-3 px-3 text-right font-mono text-slate-700 whitespace-nowrap">{formatDollar(m.other_exp)}</td>
                  <td class="py-3 px-3 text-right font-mono font-medium text-slate-900 whitespace-nowrap">{formatDollar(m.total_exp)}</td>
                  <td class={`py-3 px-3 text-right font-mono font-bold whitespace-nowrap ${isSurplus ? 'text-emerald-600' : 'text-rose-600'}`}>
                    {isSurplus ? '+' : ''}{formatDollar(m.net_margin)}
                  </td>
                  <td class={`py-3 px-3 text-right font-semibold whitespace-nowrap ${isSurplus ? 'text-emerald-600' : 'text-rose-600'}`}>
                    {m.margin_pct.toFixed(1)}%
                  </td>
                  <td class="py-3 px-4 text-xs text-slate-500 whitespace-nowrap flex items-center justify-between">
                    <span class="truncate max-w-[140px] sm:max-w-xs" title={m.driver}>{m.driver}</span>
                    <span class={`ml-2 inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium ${
                      isSurplus ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-rose-50 text-rose-700 border border-rose-200'
                    }`}>
                      {m.status}
                    </span>
                  </td>
                </tr>
                <tr id={`drawer-${m.id}`} class="hidden bg-[#fbf9f5] border-y border-slate-200/80">
                  <td colspan="9" class="p-4 sm:p-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                      <div class="bg-white p-4 rounded-lg border border-slate-200 shadow-2xs">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-emerald-800 pb-2 border-b border-slate-100 mb-2">
                          Revenue Inflows Schedule ({m.month})
                        </h4>
                        <div class="space-y-1">
                          {m.rev_items.map((it) => (
                            <div class="flex justify-between text-slate-600">
                              <span>{it.name}</span>
                              <span class="font-mono font-medium text-slate-800">{formatDollar(it.amount)}</span>
                            </div>
                          ))}
                        </div>
                      </div>
                      <div class="bg-white p-4 rounded-lg border border-slate-200 shadow-2xs">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-rose-800 pb-2 border-b border-slate-100 mb-2">
                          Expenditures Schedule ({m.month})
                        </h4>
                        <div class="space-y-1">
                          {m.exp_items.map((it) => (
                            <div class="flex justify-between text-slate-600">
                              <span>{it.name}</span>
                              <span class="font-mono font-medium text-slate-800">{formatDollar(it.amount)}</span>
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>
                  </td>
                </tr>
              </>
            );
          })
        ) : (
          <tr id="statement-loading-row" class="animate-pulse">
            <td colspan="9" class="py-8 text-center text-slate-400">
              <div class="inline-flex items-center gap-2">
                <svg class="animate-spin h-4 w-4 text-teal-700" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span>Loading certified monthly statements...</span>
              </div>
            </td>
          </tr>
        )}
      </tbody>
      <!-- Certified Footing Row -->
      <tfoot class="bg-[#173a39] text-white font-semibold text-xs border-t-2 border-[#0f766e]">
        <tr>
          <td class="py-3 px-4 font-bold text-white uppercase tracking-wider">
            2026 YTD Certified Footing
          </td>
          <td id="footing-rev" class="py-3 px-3 text-right font-mono text-emerald-300 font-bold">{statements.length ? formatDollar(totalRev) : '--'}</td>
          <td id="footing-cogs" class="py-3 px-3 text-right font-mono text-slate-300">{statements.length ? formatDollar(totalCogs) : '--'}</td>
          <td id="footing-op-exp" class="py-3 px-3 text-right font-mono text-slate-300">{statements.length ? formatDollar(totalOpExp) : '--'}</td>
          <td id="footing-other-exp" class="py-3 px-3 text-right font-mono text-slate-300">{statements.length ? formatDollar(totalOtherExp) : '--'}</td>
          <td id="footing-total-exp" class="py-3 px-3 text-right font-mono text-amber-300 font-bold">{statements.length ? formatDollar(totalExp) : '--'}</td>
          <td id="footing-net-margin" class="py-3 px-3 text-right font-mono text-rose-400 font-bold">{statements.length ? formatDollar(totalNet) : '--'}</td>
          <td id="footing-margin-pct" class="py-3 px-3 text-right text-rose-300 font-bold">{statements.length ? `${totalMarginPct.toFixed(1)}%` : '--%'}</td>
          <td class="py-3 px-4 text-emerald-400 text-xs">
            ✓ Cent-for-cent footed without plug lines
          </td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

<script>
  function initMonthlyStatement() {
    // Handle drawer expand/collapse
    document.querySelectorAll('[data-target]').forEach((row) => {
      row.addEventListener('click', () => {
        const targetId = row.getAttribute('data-target');
        if (targetId) {
          const drawer = document.getElementById(targetId);
          if (drawer) {
            drawer.classList.toggle('hidden');
            row.classList.toggle('is-open');
          }
        }
      });
    });

    // Handle CSV export
    const exportBtn = document.getElementById('export-statement-csv-btn');
    const root = document.getElementById('monthly-statement-root');
    if (exportBtn && root) {
      exportBtn.addEventListener('click', () => {
        try {
          const raw = root.getAttribute('data-statements');
          if (!raw) return;
          const statements = JSON.parse(raw);

          const headers = [
            'Period',
            'Revenue ($)',
            'Direct Care COGS ($)',
            'Operations & Payroll ($)',
            'Fleet & Other ($)',
            'Total Expenditures ($)',
            'Net Margin ($)',
            'Margin (%)',
            'Driver & Status'
          ];

          const rows = statements.map((s: any) => [
            `"${s.month.replace(/"/g, '""')}"`,
            s.revenue.toFixed(2),
            s.cogs.toFixed(2),
            s.operating_exp.toFixed(2),
            s.other_exp.toFixed(2),
            s.total_exp.toFixed(2),
            s.net_margin.toFixed(2),
            s.margin_pct.toFixed(1),
            `"${(s.driver || '').replace(/"/g, '""')}"`
          ]);

          // Compute Footed Certified Totals
          const totRev = statements.reduce((a: number, b: any) => a + b.revenue, 0);
          const totCogs = statements.reduce((a: number, b: any) => a + b.cogs, 0);
          const totOp = statements.reduce((a: number, b: any) => a + b.operating_exp, 0);
          const totOther = statements.reduce((a: number, b: any) => a + b.other_exp, 0);
          const totExp = statements.reduce((a: number, b: any) => a + b.total_exp, 0);
          const totNet = statements.reduce((a: number, b: any) => a + b.net_margin, 0);
          const totMarginPct = (totNet / totRev) * 100;

          rows.push([
            '"2026 YTD Certified Footing"',
            totRev.toFixed(2),
            totCogs.toFixed(2),
            totOp.toFixed(2),
            totOther.toFixed(2),
            totExp.toFixed(2),
            totNet.toFixed(2),
            totMarginPct.toFixed(1),
            '"Cent-for-cent QBO certified pull without plug lines"'
          ]);

          const csvString = [headers.join(','), ...rows.map((r: string[]) => r.join(','))].join('\r\n');
          const blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
          const url = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = url;
          link.setAttribute('download', `HSMC_2026_Operating_Statement_YTD_${new Date().toISOString().slice(0, 10)}.csv`);
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
          URL.revokeObjectURL(url);
        } catch (err) {
          console.error('Failed to export statement CSV:', err);
        }
      });
    }
  }

  document.addEventListener('astro:page-load', initMonthlyStatement);
  if (document.readyState !== 'loading') {
    initMonthlyStatement();
  } else {
    document.addEventListener('DOMContentLoaded', initMonthlyStatement);
  }
</script>\n