---
import type { BoardMeeting, BoardDocument } from '../../lib/directus';

interface Props {
  meetings: BoardMeeting[];
  documents: BoardDocument[];
}

const { meetings = [], documents = [] } = Astro.props;

const formatMeetingDate = (dateStr: string) => {
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-US', {
      weekday: 'short',
      month: 'short',
      day: 'numeric',
      year: 'numeric',
      hour: 'numeric',
      minute: '2-digit',
    });
  } catch (e) {
    return dateStr;
  }
};

const formatDocDate = (dateStr: string) => {
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    });
  } catch (e) {
    return dateStr;
  }
};
---

<div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden">
  <!-- Card Header -->
  <div class="px-6 py-4 border-b border-slate-100 bg-[#fbf9f5] flex flex-col md:flex-row md:items-center md:justify-between gap-3">
    <div>
      <div class="flex items-center gap-2">
        <span class="inline-flex p-1.5 rounded-lg bg-[#173a39] text-teal-100">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
          </svg>
        </span>
        <h3 class="text-base font-bold text-[#173a39]">
          Board Governance & Executive Reports
        </h3>
      </div>
      <p class="text-xs text-slate-500 mt-1">
        Official meeting agendas, approved minutes, monthly operations reports, and compliance documentation.
      </p>
    </div>

    <!-- Directus Integration Status Indicator -->
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Directus ACA Backend Synced
      </span>
    </div>
  </div>

  <div class="p-6 grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Left Column: Board Meetings & Agendas (6 cols) -->
    <div class="lg:col-span-6 space-y-4">
      <div class="flex items-center justify-between pb-2 border-b border-slate-100">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          Board Meetings & Agendas
        </h4>
        <span class="text-[11px] text-slate-400 font-medium">Monthly Regular Schedule</span>
      </div>

      <div class="space-y-3">
        {meetings.map((m) => (
          <div class={`p-4 rounded-xl border transition ${m.status === 'scheduled' ? 'bg-[#f0f9f8] border-teal-200 shadow-2xs' : 'bg-slate-50/70 border-slate-200'}`}>
            <div class="flex items-start justify-between gap-2">
              <div>
                <span class={`inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide mb-1.5 ${m.status === 'scheduled' ? 'bg-teal-700 text-white' : 'bg-slate-200 text-slate-700'}`}>
                  {m.status === 'scheduled' ? 'Next Upcoming Meeting' : 'Archived Meeting'}
                </span>
                <h5 class="text-sm font-bold text-slate-900">{m.title}</h5>
                <div class="flex flex-wrap items-center gap-y-1 gap-x-3 text-xs text-slate-500 mt-1">
                  <span class="font-medium text-slate-700 flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    {formatMeetingDate(m.date)}
                  </span>
                  <span class="text-slate-400">·</span>
                  <span>{m.location}</span>
                </div>
              </div>

              {m.packet_url && (
                <a
                  href={m.packet_url}
                  target="_blank"
                  class="shrink-0 px-2.5 py-1 rounded-md text-[11px] font-semibold bg-white border border-slate-200 text-[#173a39] hover:bg-slate-50 hover:border-slate-300 transition shadow-2xs inline-flex items-center gap-1"
                >
                  <span>Packet</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                </a>
              )}
            </div>

            {m.description && (
              <p class="text-xs text-slate-600 mt-2.5 leading-relaxed">
                {m.description}
              </p>
            )}

            {m.agenda_items && m.agenda_items.length > 0 && (
              <div class="mt-3 pt-2.5 border-t border-slate-200/60">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-1">
                  Key Order of Business:
                </span>
                <ul class="space-y-1 text-xs text-slate-700">
                  {m.agenda_items.map((item, idx) => (
                    <li class="flex items-start gap-1.5">
                      <span class="font-mono text-[10px] text-slate-400 mt-0.5">{idx + 1}.</span>
                      <span class="text-[11.5px] leading-tight">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>

    <!-- Right Column: Governance Documents & ED Reports (6 cols) -->
    <div class="lg:col-span-6 space-y-4">
      <div class="flex items-center justify-between pb-2 border-b border-slate-100">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          Executive & Compliance Repository
        </h4>
        <span class="text-[11px] text-slate-400 font-medium">Board Packets & Audits</span>
      </div>

      <div class="space-y-3">
        {documents.map((doc) => (
          <div class="p-3.5 rounded-xl border border-slate-200 bg-white hover:border-slate-300 transition shadow-2xs space-y-2">
            <div class="flex items-start justify-between gap-2">
              <div class="space-y-0.5">
                <div class="flex items-center gap-2">
                  <span class={`inline-flex px-1.5 py-0.5 rounded text-[9.5px] font-bold uppercase tracking-wider ${
                    doc.category === 'ed_report' ? 'bg-indigo-50 text-indigo-700 border border-indigo-200' :
                    doc.category === 'financial' ? 'bg-amber-50 text-amber-800 border border-amber-200' :
                    doc.category === 'regulatory' ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' :
                    'bg-slate-100 text-slate-700 border border-slate-200'
                  }`}>
                    {doc.category_label || doc.category}
                  </span>
                  <span class="text-[10px] text-slate-400">{formatDocDate(doc.date)}</span>
                </div>
                <h5 class="text-xs font-bold text-slate-900 leading-snug">{doc.title}</h5>
                <p class="text-[10.5px] text-slate-500">{doc.author}</p>
              </div>

              <span class="shrink-0 px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-slate-100 text-slate-600">
                {doc.file_type || 'PDF'}
              </span>
            </div>

            <p class="text-xs text-slate-600 leading-relaxed text-[11.5px]">
              {doc.summary}
            </p>

            {doc.highlights && doc.highlights.length > 0 && (
              <div class="bg-slate-50/80 rounded-lg p-2 border border-slate-100">
                <span class="text-[9.5px] font-bold uppercase tracking-wider text-slate-400 block mb-1">
                  Key Metrics & Takeaways:
                </span>
                <ul class="space-y-0.5 text-[11px] text-slate-700">
                  {doc.highlights.map((h) => (
                    <li class="flex items-start gap-1">
                      <span class="text-teal-600 font-bold">•</span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
