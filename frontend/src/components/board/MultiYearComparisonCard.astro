---
interface Props {
  comparison?: any;
}

const { comparison = null } = Astro.props;
---

<div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden">
  <div class="px-5 py-4 border-b border-slate-100 bg-[#f5efe3]/50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
    <div>
      <h3 class="text-base font-semibold text-[#173a39]">
        3-Year Multi-Year Operational Trajectory (2024 – 2026 YTD)
      </h3>
      <p class="text-xs text-slate-500 mt-0.5">
        Benchmarking against 2025 Audited Actuals and 2024 Form 990 Reconciled Run-Rate.
      </p>
    </div>
    <div class="inline-flex items-center gap-1.5 text-xs text-slate-500">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      <span>Audited / Certified Comparative</span>
    </div>
  </div>

  <div class="p-5 grid grid-cols-1 md:grid-cols-3 gap-5">
    <!-- 2024 Column -->
    <div class="p-4 rounded-xl border border-slate-200 bg-slate-50/50 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="text-base font-bold text-slate-900">2024 Full Year</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-200 text-slate-800">
            Form 990 Reconciled
          </span>
        </div>
        <p class="text-xs text-slate-500 mb-4">Historical Baseline</p>

        <div class="space-y-2 text-xs">
          <div class="flex justify-between py-1 border-b border-slate-200/60">
            <span class="text-slate-600">Total Revenue:</span>
            <span id="my-2024-rev" class="font-mono font-semibold text-slate-800">--</span>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-200/60">
            <span class="text-slate-600">Total Expenditures:</span>
            <span id="my-2024-exp" class="font-mono font-semibold text-slate-800">--</span>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-200/60">
            <span class="text-slate-600">Net Margin:</span>
            <span id="my-2024-net" class="font-mono font-bold text-rose-700">--</span>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-200/60">
            <span class="text-slate-600">Margin %:</span>
            <span id="my-2024-margin" class="font-semibold text-rose-600">--%</span>
          </div>
          <div class="flex justify-between py-1">
            <span class="text-slate-600">Program Efficiency:</span>
            <span id="my-2024-prog" class="font-semibold text-emerald-700">--%</span>
          </div>
        </div>
      </div>
      <div class="mt-4 pt-3 border-t border-slate-200 text-[11px] text-slate-500 leading-snug">
        Baseline operational deficit funded from cash reserves.
      </div>
    </div>

    <!-- 2025 Column (Audited) -->
    <div class="p-4 rounded-xl border border-blue-200 bg-blue-50/30 flex flex-col justify-between relative overflow-hidden">
      <div class="absolute top-0 right-0 left-0 h-1 bg-blue-500"></div>
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="text-base font-bold text-slate-900">2025 Full Year</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-blue-100 text-blue-800">
            Audited Actual
          </span>
        </div>
        <p class="text-xs text-blue-700 font-medium mb-4">Audited Statement</p>

        <div class="space-y-2 text-xs">
          <div class="flex justify-between py-1 border-b border-blue-100">
            <span class="text-slate-600">Total Revenue:</span>
            <span id="my-2025-rev" class="font-mono font-semibold text-slate-800">--</span>
          </div>
          <div class="flex justify-between py-1 border-b border-blue-100">
            <span class="text-slate-600">Total Expenditures:</span>
            <span id="my-2025-exp" class="font-mono font-semibold text-slate-800">--</span>
          </div>
          <div class="flex justify-between py-1 border-b border-blue-100 bg-emerald-50/80 px-1.5 rounded">
            <span class="font-semibold text-emerald-950">Audited All-In Net:</span>
            <span id="my-2025-net" class="font-mono font-bold text-emerald-700">--</span>
          </div>
          <!-- Critical dual disclosure: Operating net ex-bequest -->
          <div class="flex justify-between py-1 border-b border-blue-100 bg-amber-50/80 px-1.5 rounded">
            <div>
              <span class="font-semibold text-amber-950">Ex-Bequest Operating Net:</span>
              <p class="text-[10px] text-amber-800">Excludes one-time estate gift</p>
            </div>
            <span id="my-2025-ex-bequest" class="font-mono font-bold text-amber-800">--</span>
          </div>
          <div class="flex justify-between py-1">
            <span class="text-slate-600">Program Efficiency:</span>
            <span id="my-2025-prog" class="font-semibold text-emerald-700">--%</span>
          </div>
        </div>
      </div>
      <div class="mt-4 pt-3 border-t border-blue-100 text-[11px] text-slate-500 leading-snug">
        <strong>Governance Standard:</strong> Surplus is presented alongside the ex-bequest operating net to accurately show recurring operational burn.
      </div>
    </div>

    <!-- 2026 Column (YTD Current) -->
    <div class="p-4 rounded-xl border border-rose-200 bg-rose-50/20 flex flex-col justify-between relative overflow-hidden">
      <div class="absolute top-0 right-0 left-0 h-1 bg-rose-500"></div>
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="text-base font-bold text-slate-900">2026 YTD Current</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-rose-100 text-rose-800">
            Jan 1 – Aug 31
          </span>
        </div>
        <p class="text-xs text-rose-700 font-medium mb-4">Certified Close</p>

        <div class="space-y-2 text-xs">
          <div class="flex justify-between py-1 border-b border-rose-100">
            <span class="text-slate-600">YTD Revenue:</span>
            <span id="my-2026-rev" class="font-mono font-semibold text-slate-800">--</span>
          </div>
          <div class="flex justify-between py-1 border-b border-rose-100">
            <span class="text-slate-600">YTD Expenditures:</span>
            <span id="my-2026-exp" class="font-mono font-semibold text-slate-800">--</span>
          </div>
          <div class="flex justify-between py-1 border-b border-rose-100">
            <span class="text-slate-600">YTD All-In Net:</span>
            <span id="my-2026-net" class="font-mono font-bold text-rose-700">--</span>
          </div>
          <div class="flex justify-between py-1 border-b border-rose-100">
            <span class="text-slate-600">YTD Margin %:</span>
            <span id="my-2026-margin" class="font-semibold text-rose-600">--%</span>
          </div>
          <div class="flex justify-between py-1">
            <span class="text-slate-600">Program Efficiency:</span>
            <span id="my-2026-prog" class="font-semibold text-[#1c746c]">--%</span>
          </div>
        </div>
      </div>
      <div class="mt-4 pt-3 border-t border-rose-100 text-[11px] text-slate-500 leading-snug">
        On track with historical seasonal shelter run-rates; program ratio continues to outperform charity benchmarks.
      </div>
    </div>
  </div>
</div>