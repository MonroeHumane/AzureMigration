---
interface Props {
  kpis?: {
    all_in_revenue: number;
    all_in_expenditures: number;
    all_in_net: number;
    all_in_margin_pct: number;
    qbo_operating_revenue: number;
    qbo_cogs: number;
    qbo_operating_expenditures: number;
    qbo_operating_net: number;
    non_operating_bridge: number;
    program_ratio_pct: number;
    program_spend: number;
    mg_spend: number;
    fund_spend: number;
    operating_cash: number;
    operating_checking_first_merchants: number;
    undeposited_funds: number;
    petty_cash: number;
    bank_register_cash: number;
    fidelity_reserve: number;
    total_liquidity: number;
    runway_bank_days: number;
    runway_reserve_months: number;
    average_monthly_burn: number;
  };
}

const { kpis } = Astro.props;

// Round whole dollars for headline tiles
const formatDollar = (val: number) => {
  const isNeg = val < 0;
  const abs = Math.abs(Math.round(val));
  const formatted = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(abs);
  return isNeg ? `(${formatted})` : formatted;
};

// Exact cents for tooltips and footnotes
const formatCents = (val: number) => {
  const isNeg = val < 0;
  const abs = Math.abs(val);
  const formatted = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 }).format(abs);
  return isNeg ? `(${formatted})` : formatted;
};
---

<section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
  <!-- Card 1: All-In Net Margin (Headline) -->
  <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-xs hover:border-slate-300 transition relative overflow-hidden group">
    <div class="absolute top-0 left-0 right-0 h-1 bg-rose-500"></div>
    <div class="flex items-center justify-between text-xs text-slate-500 mb-1">
      <span class="font-semibold uppercase tracking-wider text-slate-700">All-In Net Margin</span>
      <span class="px-2 py-0.5 rounded-md text-[11px] font-semibold bg-rose-50 text-rose-700 border border-rose-200">
        Certified Headline
      </span>
    </div>
    <div class="mt-2 flex items-baseline gap-2">
      <span id="kpi-all-in-net" class="text-3xl font-bold tracking-tight text-rose-600">
        {kpis ? formatDollar(kpis.all_in_net) : '--'}
      </span>
      <span id="kpi-all-in-margin" class="text-sm font-semibold text-rose-500">
        {kpis ? `${kpis.all_in_margin_pct.toFixed(1)}%` : '--%'}
      </span>
    </div>
    <p class="text-xs text-slate-500 mt-2">
      Rev: <span id="kpi-all-in-rev" class="font-medium text-slate-700">{kpis ? formatDollar(kpis.all_in_revenue) : '--'}</span> · 
      Exp: <span id="kpi-all-in-exp" class="font-medium text-slate-700">{kpis ? formatDollar(kpis.all_in_expenditures) : '--'}</span>
    </p>
    <div class="mt-3 pt-3 border-t border-slate-100 text-[11px] text-slate-600 flex justify-between items-center">
      <span>Exact cent balance:</span>
      <span id="kpi-all-in-exact" class="font-mono font-medium text-slate-800">{kpis ? formatCents(kpis.all_in_net) : '--'}</span>
    </div>
  </div>

  <!-- Card 2: QBO Operating Net -->
  <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-xs hover:border-slate-300 transition relative overflow-hidden">
    <div class="absolute top-0 left-0 right-0 h-1 bg-amber-500"></div>
    <div class="flex items-center justify-between text-xs text-slate-500 mb-1">
      <span class="font-semibold uppercase tracking-wider text-slate-700">QBO Operating Net</span>
      <span class="px-2 py-0.5 rounded-md text-[11px] font-semibold bg-amber-50 text-amber-800 border border-amber-200">
        Core Operations
      </span>
    </div>
    <div class="mt-2 flex items-baseline gap-2">
      <span id="kpi-qbo-net" class="text-3xl font-bold tracking-tight text-amber-700">
        {kpis ? formatDollar(kpis.qbo_operating_net) : '--'}
      </span>
      <span class="text-xs text-slate-500 font-medium">Pre-Endowment</span>
    </div>
    <p class="text-xs text-slate-500 mt-2">
      Operating Rev: <span id="kpi-qbo-rev" class="font-medium text-slate-700">{kpis ? formatDollar(kpis.qbo_operating_revenue) : '--'}</span> · 
      OpExp: <span id="kpi-qbo-exp" class="font-medium text-slate-700">{kpis ? formatDollar(kpis.qbo_cogs + kpis.qbo_operating_expenditures) : '--'}</span>
    </p>
    <div class="mt-3 pt-3 border-t border-slate-100 text-[11px] text-slate-600 flex justify-between items-center">
      <span>Non-operating bridge:</span>
      <span id="kpi-qbo-bridge" class="font-mono font-medium text-emerald-700">{kpis ? `+${formatDollar(kpis.non_operating_bridge)}` : '--'}</span>
    </div>
  </div>

  <!-- Card 3: Program Efficiency Ratio -->
  <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-xs hover:border-slate-300 transition relative overflow-hidden">
    <div class="absolute top-0 left-0 right-0 h-1 bg-[#1c746c]"></div>
    <div class="flex items-center justify-between text-xs text-slate-500 mb-1">
      <span class="font-semibold uppercase tracking-wider text-slate-700">Program Ratio</span>
      <span class="px-2 py-0.5 rounded-md text-[11px] font-semibold bg-emerald-50 text-[#1c746c] border border-emerald-200">
        Benchmark ≥75%
      </span>
    </div>
    <div class="mt-2 flex items-baseline gap-2">
      <span id="kpi-program-ratio" class="text-3xl font-bold tracking-tight text-[#1c746c]">
        {kpis ? `${kpis.program_ratio_pct.toFixed(1)}%` : '--%'}
      </span>
      <span class="text-xs font-semibold text-emerald-700">High Efficiency</span>
    </div>
    <p class="text-xs text-slate-500 mt-2">
      Program: <span id="kpi-program-spend" class="font-medium text-slate-700">{kpis ? formatDollar(kpis.program_spend) : '--'}</span> ÷ 
      OpExp: <span id="kpi-program-opexp" class="font-medium text-slate-700">{kpis ? formatDollar(kpis.qbo_operating_expenditures) : '--'}</span>
    </p>
    <div class="mt-3 pt-3 border-t border-slate-100 text-[11px] text-slate-600 flex justify-between items-center">
      <span>Form 990 Part IX:</span>
      <span id="kpi-program-exact" class="font-mono font-medium text-slate-800">{kpis ? formatCents(kpis.program_spend) : '--'}</span>
    </div>
  </div>

  <!-- Card 4: Total Liquidity & Runway -->
  <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-xs hover:border-slate-300 transition relative overflow-hidden">
    <div class="absolute top-0 left-0 right-0 h-1 bg-[#173a39]"></div>
    <div class="flex items-center justify-between text-xs text-slate-500 mb-1">
      <span class="font-semibold uppercase tracking-wider text-slate-700">Cash Stack & Runway</span>
      <span id="kpi-runway-badge" class="px-2 py-0.5 rounded-md text-[11px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
        {kpis ? `${(kpis.total_liquidity / Math.abs(kpis.qbo_operating_net / 8)).toFixed(1)} Mo Net Runway` : '-- Mo Net Runway'}
      </span>
    </div>
    <div class="mt-2 flex items-baseline gap-2">
      <span id="kpi-total-liquidity" class="text-3xl font-bold tracking-tight text-[#173a39]">
        {kpis ? formatDollar(kpis.total_liquidity) : '--'}
      </span>
      <span class="text-xs font-medium text-slate-500">Total Liquidity</span>
    </div>
    <p class="text-xs text-slate-500 mt-2">
      Operating: <span id="kpi-operating-cash" class="font-medium text-slate-700">{kpis ? formatDollar(kpis.operating_cash) : '--'}</span> · 
      Fidelity: <span id="kpi-fidelity-reserve" class="font-medium text-slate-700">{kpis ? formatDollar(kpis.fidelity_reserve) : '--'}</span>
    </p>
    <div class="mt-3 pt-3 border-t border-slate-100 text-[11px] text-slate-600 flex justify-between items-center">
      <span>Zero-Inflow Buffer:</span>
      <span id="kpi-zero-inflow" class="font-mono font-medium text-slate-800">{kpis ? `${kpis.runway_reserve_months.toFixed(1)} Mo Gross OpExp` : '-- Mo Gross OpExp'}</span>
    </div>
  </div>
</section>