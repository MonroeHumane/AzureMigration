---
interface Props {
  kpis?: {
    all_in_revenue: number;
    all_in_expenditures: number;
    all_in_net: number;
    all_in_margin_pct: number;
    qbo_operating_revenue: number;
    qbo_cogs: number;
    qbo_operating_expenditures: number;
    qbo_operating_net: number;
    non_operating_bridge: number;
    program_ratio_pct: number;
    program_spend: number;
    mg_spend: number;
    fund_spend: number;
    operating_cash: number;
    operating_checking_first_merchants: number;
    undeposited_funds: number;
    petty_cash: number;
    bank_register_cash: number;
    fidelity_reserve: number;
    total_liquidity: number;
    runway_bank_days: number;
    runway_reserve_months: number;
    average_monthly_burn: number;
  };
}

const { kpis } = Astro.props;

const formatDollar = (val: number) => {
  const isNeg = val < 0;
  const abs = Math.abs(Math.round(val));
  const formatted = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(abs);
  return isNeg ? `(${formatted})` : formatted;
};

const formatCents = (val: number) => {
  const isNeg = val < 0;
  const abs = Math.abs(val);
  const formatted = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 }).format(abs);
  return isNeg ? `(${formatted})` : formatted;
};

const qbChecking = kpis?.operating_checking_first_merchants ?? null;
---

<section class="bg-white dark:bg-[#0b2420]/85 rounded-xl border border-slate-200 dark:border-teal-800/80 dark:text-white overflow-hidden">
  <div class="px-5 py-6 sm:px-8 sm:py-8">
    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">First Merchants checking</p>
    <div class="mt-1 flex flex-wrap items-end justify-between gap-3">
      <span id="kpi-total-liquidity" class="text-4xl sm:text-5xl font-bold tracking-tight text-slate-900 dark:text-white">
        {qbChecking != null ? formatCents(qbChecking) : '--'}
      </span>
      <a href="#bank-statement-viewer" data-goto-section="audit" class="text-sm font-semibold text-teal-800 hover:text-teal-950 dark:text-emerald-300">See bank</a>
    </div>
    <p id="kpi-cash-runway" class="mt-2 text-sm text-slate-600 dark:text-teal-200/80">
      Balance at August 31.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-slate-200 dark:divide-teal-800/80 border-t border-slate-200 dark:border-teal-800/80">
    <div class="px-5 py-4 sm:px-6">
      <div class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">This year leftover</div>
      <div id="kpi-all-in-net" class="mt-1 text-lg font-semibold font-mono text-slate-900 dark:text-white">
        {kpis ? formatDollar(kpis.all_in_net) : '--'}
      </div>
      <p class="text-xs text-slate-500 mt-0.5">
        <span id="kpi-all-in-rev">{kpis ? formatDollar(kpis.all_in_revenue) : '--'}</span>
        in ·
        <span id="kpi-all-in-exp">{kpis ? formatDollar(kpis.all_in_expenditures) : '--'}</span>
        out
      </p>
    </div>
    <div class="px-5 py-4 sm:px-6">
      <div class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Animal care</div>
      <div id="kpi-program-cents" class="mt-1 text-lg font-semibold text-slate-900 dark:text-white">
        {kpis ? `${Math.round(kpis.program_ratio_pct)}¢ of every dollar spent` : '--'}
      </div>
    </div>
  </div>

  <span id="kpi-fidelity-reserve" class="hidden"></span>

  <span id="kpi-all-in-margin" class="hidden">{kpis ? `${kpis.all_in_margin_pct.toFixed(1)}%` : ''}</span>
  <span id="kpi-all-in-exact" class="hidden">{kpis ? formatCents(kpis.all_in_net) : '--'}</span>
  <span id="kpi-qbo-net" class="hidden">{kpis ? formatDollar(kpis.qbo_operating_net) : '--'}</span>
  <span id="kpi-qbo-rev" class="hidden">{kpis ? formatDollar(kpis.qbo_operating_revenue) : '--'}</span>
  <span id="kpi-qbo-exp" class="hidden">{kpis ? formatDollar(kpis.qbo_cogs + kpis.qbo_operating_expenditures) : '--'}</span>
  <span id="kpi-qbo-bridge" class="hidden">{kpis ? `+${formatDollar(kpis.non_operating_bridge)}` : '--'}</span>
  <span id="kpi-program-ratio" class="hidden">{kpis ? `${kpis.program_ratio_pct.toFixed(1)}%` : '--'}</span>
  <span id="kpi-program-target" class="hidden">{kpis ? (kpis.program_ratio_pct >= 75 ? '≥75%' : '<75%') : ''}</span>
  <span id="kpi-program-spend" class="hidden">{kpis ? formatDollar(kpis.program_spend) : '--'}</span>
  <span id="kpi-program-opexp" class="hidden">{kpis ? formatDollar(kpis.qbo_operating_expenditures) : '--'}</span>
  <span id="kpi-program-exact" class="hidden">{kpis ? formatCents(kpis.program_spend) : '--'}</span>
  <span id="kpi-runway-badge" class="hidden"></span>
  <span id="kpi-zero-inflow" class="hidden"></span>
</section>
