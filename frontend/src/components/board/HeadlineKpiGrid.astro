---
interface Props {
  kpis?: {
    all_in_revenue: number;
    all_in_expenditures: number;
    all_in_net: number;
    all_in_margin_pct: number;
    qbo_operating_revenue: number;
    qbo_cogs: number;
    qbo_operating_expenditures: number;
    qbo_operating_net: number;
    non_operating_bridge: number;
    program_ratio_pct: number;
    program_spend: number;
    mg_spend: number;
    fund_spend: number;
    operating_cash: number;
    operating_checking_first_merchants: number;
    undeposited_funds: number;
    petty_cash: number;
    bank_register_cash: number;
    fidelity_reserve: number;
    total_liquidity: number;
    runway_bank_days: number;
    runway_reserve_months: number;
    average_monthly_burn: number;
  };
}

const { kpis } = Astro.props;

const formatDollar = (val: number) => {
  const isNeg = val < 0;
  const abs = Math.abs(Math.round(val));
  const formatted = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(abs);
  return isNeg ? `(${formatted})` : formatted;
};

const formatCents = (val: number) => {
  const isNeg = val < 0;
  const abs = Math.abs(val);
  const formatted = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 }).format(abs);
  return isNeg ? `(${formatted})` : formatted;
};

const qbChecking = kpis?.operating_checking_first_merchants ?? null;
---

<section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
  <!-- Pillar 1: First Merchants Checking -->
  <div class="bg-white dark:bg-[#0b2420]/85 rounded-2xl border border-slate-200 dark:border-teal-800/80 p-5 shadow-xs flex flex-col justify-between transition-colors">
    <div>
      <div class="flex items-center justify-between gap-2">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-teal-300">Operating Checking</span>
        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-teal-50 text-teal-800 dark:bg-teal-900/50 dark:text-emerald-300 border border-teal-200/80 dark:border-teal-700/60">First Merchants</span>
      </div>
      <div class="mt-2 flex items-baseline justify-between gap-2">
        <span id="kpi-total-liquidity" class="text-2xl sm:text-3xl font-bold font-mono text-slate-900 dark:text-white tracking-tight">
          {qbChecking != null ? formatCents(qbChecking) : '--'}
        </span>
      </div>
    </div>
    <div class="mt-3 pt-3 border-t border-slate-100 dark:border-teal-900/60 flex items-center justify-between text-xs">
      <span id="kpi-cash-runway" class="text-slate-500 dark:text-teal-300/80 text-[11px]">Balance at period close</span>
      <a href="#bank-statement-viewer" @click="activeSection = 'audit'; window.history.replaceState({}, '', '?section=audit'); window.scrollTo({top: 0, behavior: 'smooth'})" class="font-bold text-teal-700 hover:text-teal-900 dark:text-emerald-300 hover:underline transition flex items-center gap-1 text-[11px]" title="View Certified Bank Statement & Reconciliation">
        Statement &amp; Rec &rarr;
      </a>
    </div>
  </div>

  <!-- Pillar 2: Board Designated Operating Reserve (Fidelity) -->
  <div class="bg-white dark:bg-[#0b2420]/85 rounded-2xl border border-slate-200 dark:border-teal-800/80 p-5 shadow-xs flex flex-col justify-between transition-colors">
    <div>
      <div class="flex items-center justify-between gap-2">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-teal-300">Operating Reserve</span>
        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-50 text-indigo-800 dark:bg-indigo-900/50 dark:text-indigo-300 border border-indigo-200/80 dark:border-indigo-700/60">Fidelity Board Designated</span>
      </div>
      <div class="mt-2 flex items-baseline justify-between gap-2">
        <span id="kpi-fidelity-reserve" class="text-2xl sm:text-3xl font-bold font-mono text-indigo-700 dark:text-indigo-300 tracking-tight">
          {kpis ? formatDollar(kpis.fidelity_reserve) : '$205,144'}
        </span>
      </div>
    </div>
    <div class="mt-3 pt-3 border-t border-slate-100 dark:border-teal-900/60 flex items-center justify-between text-xs">
      <span class="text-slate-500 dark:text-teal-300/80 text-[11px]">Emergency safety buffer</span>
      <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-indigo-100/70 text-indigo-900 dark:bg-indigo-900/40 dark:text-indigo-200">Protected</span>
    </div>
  </div>

  <!-- Pillar 3: Total Liquid Available Reserves & Runway -->
  <div class="bg-white dark:bg-[#0b2420]/85 rounded-2xl border border-slate-200 dark:border-teal-800/80 p-5 shadow-xs flex flex-col justify-between transition-colors">
    <div>
      <div class="flex items-center justify-between gap-2">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-teal-300">Total Liquid Reserves</span>
        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-700/60">Checking + Reserve</span>
      </div>
      <div class="mt-2 flex items-baseline justify-between gap-2">
        <span id="kpi-total-liquid-combined" class="text-2xl sm:text-3xl font-bold font-mono text-emerald-700 dark:text-emerald-300 tracking-tight">
          {kpis ? formatDollar((kpis.operating_checking_first_merchants || 24526.34) + (kpis.fidelity_reserve || 205144)) : '$229,670'}
        </span>
      </div>
    </div>
    <div class="mt-3 pt-3 border-t border-slate-100 dark:border-teal-900/60 flex items-center justify-between text-xs">
      <span class="text-slate-500 dark:text-teal-300/80 text-[11px]">Full liquidity runway</span>
      <span id="kpi-runway-chip" class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-900/60 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-700/80">
        180+ Days (6+ Mos)
      </span>
    </div>
  </div>

  <!-- Pillar 4: YTD Net Surplus & Mission Efficiency -->
  <div class="bg-white dark:bg-[#0b2420]/85 rounded-2xl border border-slate-200 dark:border-teal-800/80 p-5 shadow-xs flex flex-col justify-between transition-colors">
    <div>
      <div class="flex items-center justify-between gap-2">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-teal-300">YTD Net &amp; Mission Spend</span>
        <span id="kpi-program-cents" class="px-2 py-0.5 rounded text-[10px] font-bold bg-teal-50 text-teal-800 dark:bg-teal-900/50 dark:text-teal-300 border border-teal-200/80 dark:border-teal-700/60">
          {kpis ? `${Math.round(kpis.program_ratio_pct)}¢/dollar Care` : '81¢/dollar Care'}
        </span>
      </div>
      <div class="mt-2 flex items-baseline justify-between gap-2">
        <span id="kpi-all-in-net" class="text-2xl sm:text-3xl font-bold font-mono text-slate-900 dark:text-white tracking-tight">
          {kpis ? formatDollar(kpis.all_in_net) : '--'}
        </span>
      </div>
    </div>
    <div class="mt-3 pt-3 border-t border-slate-100 dark:border-teal-900/60 flex items-center justify-between text-xs">
      <p class="text-[11px] text-slate-500 dark:text-teal-300/80">
        <span id="kpi-all-in-rev">{kpis ? formatDollar(kpis.all_in_revenue) : '--'}</span> in &middot;
        <span id="kpi-all-in-exp">{kpis ? formatDollar(kpis.all_in_expenditures) : '--'}</span> out
      </p>
      <span class="text-[10px] font-bold text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-1.5 py-0.5 rounded">&ge;75% BBB Goal</span>
    </div>
  </div>

  <!-- Backward-compatible hidden stubs for loader bindings -->
  <span id="kpi-all-in-margin" class="hidden">{kpis ? `${kpis.all_in_margin_pct.toFixed(1)}%` : ''}</span>
  <span id="kpi-all-in-exact" class="hidden">{kpis ? formatCents(kpis.all_in_net) : '--'}</span>
  <span id="kpi-qbo-net" class="hidden">{kpis ? formatDollar(kpis.qbo_operating_net) : '--'}</span>
  <span id="kpi-qbo-rev" class="hidden">{kpis ? formatDollar(kpis.qbo_operating_revenue) : '--'}</span>
  <span id="kpi-qbo-exp" class="hidden">{kpis ? formatDollar(kpis.qbo_cogs + kpis.qbo_operating_expenditures) : '--'}</span>
  <span id="kpi-qbo-bridge" class="hidden">{kpis ? `+${formatDollar(kpis.non_operating_bridge)}` : '--'}</span>
  <span id="kpi-program-ratio" class="hidden">{kpis ? `${kpis.program_ratio_pct.toFixed(1)}%` : '--'}</span>
  <span id="kpi-program-target" class="hidden">{kpis ? (kpis.program_ratio_pct >= 75 ? '≥75%' : '<75%') : ''}</span>
  <span id="kpi-program-spend" class="hidden">{kpis ? formatDollar(kpis.program_spend) : '--'}</span>
  <span id="kpi-program-opexp" class="hidden">{kpis ? formatDollar(kpis.qbo_operating_expenditures) : '--'}</span>
  <span id="kpi-program-exact" class="hidden">{kpis ? formatCents(kpis.program_spend) : '--'}</span>
  <span id="kpi-runway-badge" class="hidden"></span>
  <span id="kpi-zero-inflow" class="hidden"></span>
  <span id="kpi-operating-cash" class="hidden"></span>
</section>
