          <tr class="bg-amber-50/70 font-semibold text-amber-950 border-t border-amber-200">
            <td colspan="2" class="py-2 px-4 uppercase tracking-wider text-[11px]">
              Contra-AP Clearing Credits (Credit Balances on Account · Not Spend / Expense)
            </td>
            <td class="py-2 px-3 text-right font-mono text-amber-800 font-bold">{formatCents(contraCreditTotal)}</td>
            <td class="py-2 px-4 text-center text-amber-800 text-[10px]">Contra-Liabilities</td>
          </tr>
          {contraCreditList.map((item) => (
            <tr class="bg-amber-50/20 hover:bg-amber-50/50 transition">
              <td class="py-2 px-4 font-medium text-slate-900 pl-6">
                <div class="flex items-center gap-2">
                  <span>{item.vendor}</span>
                  {item.is_related_party && (
                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-100 text-amber-900 border border-amber-300" title={item.related_party_note || 'Form 990 Schedule L Related Party Disclosure'}>
                      Form 990 Related Party
                    </span>
                  )}
                </div>
              </td>
              <td class="py-2 px-3 text-slate-600">{item.category}</td>
              <td class="py-2 px-3 text-right font-mono font-semibold text-amber-700">{formatCents(item.amount)}</td>
              <td class="py-2 px-4 text-center">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold bg-amber-100 text-amber-900 border border-amber-200">
                  Contra-AP Credit
                </span>
              </td>
            </tr>
          ))}
        </tbody>
        <tfoot class="bg-[#173a39] text-white font-semibold text-xs border-t-2 border-[#0f766e]">
          <tr>
            <td colspan="2" class="py-2.5 px-4 uppercase tracking-wider text-white">Certified Accounts Payable Total</td>
            <td class="py-2.5 px-3 text-right font-mono text-emerald-300 font-bold">{formatCents(apTotal)}</td>
            <td class="py-2.5 px-4 text-center text-emerald-400 text-[11px]">19 Accounts Reconciled ($2,739.76 + $793.35)</td>
          </tr>
        </tfoot>
      </table>
    </div>

    <!-- Governance & Disclosures Footer -->
    <div class="p-4 bg-slate-50 border-t border-slate-200 grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
      <div class="p-2.5 rounded bg-white border border-slate-200 text-slate-600">
        <span class="font-bold text-slate-800 block mb-1">Form 990 Governance & Related Party Disclosures:</span>
        <p class="text-[11px] leading-relaxed">
          Related parties <strong>Kelly Karlet</strong> ($239.20) and <strong>Jackie Monteer</strong> ($50.12) represent bona fide caregiver mileage and shelter operational reimbursements. <strong>Robert Monteer</strong> (-$52.96) is an expense clearing credit balance on staff account. Executive Director <strong>Jeffery Howard</strong> is compensated exclusively through standard board-approved W-2 payroll and carries no vendor payables.
        </p>
      </div>
      <div class="p-2.5 rounded bg-white border border-slate-200 text-slate-600">
        <span class="font-bold text-slate-800 block mb-1">Contra-AP Accounting & Cash Recognition Note:</span>
        <p class="text-[11px] leading-relaxed">
          Credit balances (-$177.63 across Accident Fund, Patty Hutchinson, Robert Monteer, and Kara Brookins) represent contra-AP credit memos offsetting gross payables, not negative operational expenditures. First Merchants statement ending cash ($24,526.34) and GL book cash ($23,469.20) are certified and locked as of August 31, 2026 with an exact reconciled float of -$1,057.13 ($927.14 legacy ghost checks + $254.99 Whitaker Nolff check 4465 - $125.00 deposit in transit).
        </p>
      </div>
    </div>
  </div>
</div>
