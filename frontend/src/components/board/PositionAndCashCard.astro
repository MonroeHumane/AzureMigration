          </div>

          <div class="p-2 rounded bg-amber-50/60 border border-amber-200 text-[11px] text-amber-900 leading-tight">
            <strong>QBO Total Liabilities Walk:</strong> Trade debt is {formatDollar(position.liabilities.total_operating_obligations_current)}. Total QBO Balance Sheet liabilities shows {formatDollar(position.liabilities.total_liabilities_qbo || -101360.25)} due to internal payroll clearing offsets (-$126,535.16 DD and -$39,703.89 taxes).
          </div>
        </div>
      </div>

      <div class="mt-4 pt-3 border-t border-slate-100 text-[11px] text-slate-500 flex justify-between">
        <span>Sum of Operating Obligations:</span>
        <span class="font-mono font-semibold text-slate-800">{formatDollar(position.liabilities.total_operating_obligations_current)}</span>
      </div>
    </div>

    <!-- Col 3: Net Assets Structure & Exact Workbook Equity Walk ($1,138,635.65) -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-xs p-5 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3">
          <h3 class="text-sm font-bold uppercase tracking-wider text-[#173a39]">Workbook Equity Structure</h3>
          <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-purple-100 text-purple-800">
            Total Equity: {formatDollar(position.net_assets.total_equity_qbo)}
          </span>
        </div>

        <div class="space-y-2 text-xs">
          <!-- Exact Workbook Equity Walk Lines -->
          <div class="p-2.5 rounded bg-slate-50 border border-slate-200 space-y-1">
            <div class="flex justify-between font-semibold text-slate-800">
              <div>
                <span>Net Assets Without Donor Restrictions</span>
                <p class="text-[10px] text-slate-400 font-normal">Includes Fidelity $205.1k reserve + $728.0k undesignated</p>
              </div>
              <span class="font-mono">{formatDollar(position.net_assets.without_donor_restrictions.total_without_donor_restrictions)}</span>
            </div>

            <div class="flex justify-between font-semibold text-purple-900 pt-1 border-t border-slate-200">
              <span>(+) Net Assets With Donor Restrictions</span>
              <span class="font-mono">{formatDollar(position.net_assets.with_donor_restrictions.total_with_donor_restrictions)}</span>
            </div>

            <div class="flex justify-between text-rose-700">
              <div>
                <span>(-) Opening Balance Equity (Conversion)</span>
                <p class="text-[10px] text-rose-500/80">Historical conversion offset absorbed into retained earnings</p>
              </div>
              <span class="font-mono">{formatDollar(position.net_assets.opening_balance_equity)}</span>
            </div>

            <div class="flex justify-between text-slate-700">
              <span>(+) Retained Earnings</span>
              <span class="font-mono">{formatDollar(position.net_assets.retained_earnings_historical)}</span>
            </div>

            <div class="flex justify-between text-rose-700">
              <span>(-) 2026 YTD Net Deficit</span>
              <span class="font-mono">{formatDollar(position.net_assets.current_year_net_margin)}</span>
            </div>

            <div class="pt-1.5 border-t-2 border-slate-300 flex justify-between font-bold text-slate-900">
              <span>(=) Certified Workbook Equity</span>
              <span class="font-mono text-[#1c746c]">{formatDollar(position.net_assets.total_equity_qbo)}</span>
            </div>
          </div>

          <!-- Balance Sheet Equilibrium Confirmation -->
          <div class="p-2 rounded bg-emerald-50 border border-emerald-200 text-[10.5px] text-emerald-900 leading-tight">
            <strong>Equilibrium Check:</strong> Total Liabilities ({formatDollar(position.liabilities.total_liabilities_qbo || -101360.25)}) + Total Equity ({formatDollar(position.net_assets.total_equity_qbo)}) = Total Assets ({formatDollar(position.assets.total_assets)}) with <strong>$0.00 variance</strong>.
          </div>
        </div>
      </div>

      <div class="mt-3 pt-2 border-t border-slate-100 flex justify-between items-center text-xs font-bold text-[#173a39]">
        <span>Total Liabilities & Equity:</span>
        <span class="font-mono text-slate-950 text-sm">{formatDollar(position.assets.total_assets)}</span>
      </div>
    </div>
  </div>

  <!-- Integrated Accounts Payable Schedule: 19 accounts itemized, summing cent-for-cent to $3,533.11 -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden">
    <div class="px-5 py-3.5 border-b border-slate-100 bg-[#f5efe3]/40 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <div>
        <h4 class="text-sm font-bold text-[#173a39]">
          Accounts Payable Schedule (QBO Vendor Balance Summary)
        </h4>
        <p class="text-xs text-slate-500 mt-0.5">
          Top 8 Primary ({formatCents(top8Total)}) + Remaining Aging Accounts ({formatCents(remainingTotal)}) = Certified Total ({formatCents(apTotal)}).
        </p>
      </div>
      <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-semibold bg-rose-100 text-rose-800 border border-rose-200 self-start sm:self-auto">
        Total AP: {formatCents(apTotal)}
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-600 font-semibold uppercase tracking-wider border-b border-slate-200">
          <tr>
            <th scope="col" class="py-2.5 px-4">Vendor / Payee</th>
            <th scope="col" class="py-2.5 px-3">Expense Category</th>
            <th scope="col" class="py-2.5 px-3 text-right">Balance Due</th>
            <th scope="col" class="py-2.5 px-4 text-center">Status / Classification</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <!-- Top 8 Primary Operating Accounts Header -->
          <tr class="bg-slate-100/60 font-semibold text-slate-700">
            <td colspan="2" class="py-2 px-4 uppercase tracking-wider text-[11px]">Top 8 Primary Operating Accounts</td>
            <td class="py-2 px-3 text-right font-mono text-slate-900">{formatCents(top8Total)}</td>
            <td class="py-2 px-4 text-center text-slate-500 text-[10px]">Primary Rolling Trade</td>
          </tr>
          {top8List.map((item) => (
            <tr class="hover:bg-slate-50/80 transition">
              <td class="py-2 px-4 font-medium text-slate-900 pl-6">
                <div class="flex items-center gap-2">
                  <span>{item.vendor}</span>
                  {item.is_related_party && (
                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-100 text-amber-900 border border-amber-300" title={item.related_party_note || 'Form 990 Schedule L Related Party Disclosure'}>
                      Form 990 Related Party
                    </span>
                  )}
                </div>
              </td>
              <td class="py-2 px-3 text-slate-600">{item.category}</td>
              <td class="py-2 px-3 text-right font-mono font-semibold text-slate-900">{formatCents(item.amount)}</td>
              <td class="py-2 px-4 text-center">
                <span class={`inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold ${item.status.includes('Pending') ? 'bg-amber-100 text-amber-800' : 'bg-emerald-50 text-emerald-700 border border-emerald-200'}`}>
                  {item.status}
                </span>
              </td>
            </tr>
          ))}

          <!-- Remaining Active Accounts Header (7 items) -->
          <tr class="bg-slate-100/60 font-semibold text-slate-700 border-t border-slate-200">
            <td colspan="2" class="py-2 px-4 uppercase tracking-wider text-[11px]">Remaining Active Trade Accounts (7 Payables)</td>
            <td class="py-2 px-3 text-right font-mono text-slate-900">{formatCents(activeRemainingTotal)}</td>
            <td class="py-2 px-4 text-center text-slate-500 text-[10px]">Subsidiary Operating Lines</td>
          </tr>
          {activeRemainingList.map((item) => (
            <tr class="hover:bg-slate-50/80 transition">
              <td class="py-2 px-4 font-medium text-slate-900 pl-6">
                <div class="flex items-center gap-2">
                  <span>{item.vendor}</span>
                  {item.is_related_party && (
                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-100 text-amber-900 border border-amber-300" title={item.related_party_note || 'Form 990 Schedule L Related Party Disclosure'}>
                      Form 990 Related Party
                    </span>
