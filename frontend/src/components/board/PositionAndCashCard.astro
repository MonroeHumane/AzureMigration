---
interface Props {
  position?: any;
  apSchedule?: any[];
}

const { position = null, apSchedule = [] } = Astro.props;
---

<div class="space-y-6">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Col 1: Liquid Assets & Cash Stack -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-xs p-5 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3">
          <h3 class="text-sm font-bold uppercase tracking-wider text-[#173a39]">Statement of Assets (QBO)</h3>
          <span id="pos-total-assets-badge" class="px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-100 text-emerald-800">
            Total: --
          </span>
        </div>

        <div class="space-y-2.5 text-xs">
          <!-- Line 1: General Ledger Book Cash -->
          <div class="flex justify-between py-1 border-b border-slate-50">
            <div>
              <span class="text-slate-800 font-semibold">First Merchants Operating Checking (Book)</span>
              <p class="text-[10px] text-slate-400">General Ledger operating cash balance</p>
            </div>
            <span id="pos-checking-book" class="font-mono font-medium text-slate-900">--</span>
          </div>

          <!-- Line 2: Bank Statement Ending Cash (Certified & Reconciled) -->
          <div class="flex justify-between items-center py-1.5 border-b border-slate-50 bg-emerald-50/70 px-2 rounded border border-emerald-200/60">
            <div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-950 font-semibold">First Merchants Bank Statement Ending Cash</span>
                <a href="#bank-statement-viewer" class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[9px] font-bold bg-emerald-200 text-emerald-900 hover:bg-emerald-300 transition" title="Inspect August 31 Bank Statement and Reconciliation Report">
                  Statement & Rec &rarr;
                </a>
              </div>
              <p class="text-[10px] text-emerald-800">Certified & locked to Aug 31 statement ($0.00 difference)</p>
            </div>
            <span id="pos-checking-register" class="font-mono font-bold text-emerald-900">--</span>
          </div>

          <div class="flex justify-between py-1 border-b border-slate-50">
            <span class="text-slate-600">Undeposited Funds</span>
            <span id="pos-undeposited-funds" class="font-mono font-medium text-slate-900">--</span>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-50">
            <span class="text-slate-600">Petty Cash</span>
            <span id="pos-petty-cash" class="font-mono font-medium text-slate-900">--</span>
          </div>

          <div class="flex justify-between py-1.5 bg-[#f5efe3]/70 px-2 rounded font-semibold text-[#173a39]">
            <div>
              <span>Total Book Operating Cash</span>
              <p class="text-[10px] text-slate-500 font-normal">Book Checking + Undeposited + Petty Cash</p>
            </div>
            <span id="pos-total-book-cash" class="font-mono text-[#1c746c] text-sm">--</span>
          </div>

          <div class="flex justify-between py-1 border-b border-slate-50">
            <div>
              <span class="text-slate-700 font-medium">QBO Tax Holding Escrow</span>
              <p class="text-[10px] text-slate-400">Current asset escrow · excluded from cash tile</p>
            </div>
            <span id="pos-tax-escrow" class="font-mono font-medium text-slate-800">--</span>
          </div>

          <div class="flex justify-between py-1 border-b border-slate-50">
            <div>
              <span class="text-slate-700 font-medium">Fidelity Board Reserve</span>
              <p class="text-[10px] text-slate-400">Designated reserve inside unrestricted · principal draw needs vote</p>
            </div>
            <span id="pos-fidelity-reserve" class="font-mono font-medium text-indigo-700">--</span>
          </div>

          <div class="flex justify-between py-1 border-b border-slate-50">
            <div>
              <span class="text-slate-700 font-medium">Fixed Capital Assets (Net of Depr.)</span>
              <p class="text-[10px] text-slate-400">Land, Buildings net, Equip net, Contra</p>
            </div>
            <span id="pos-fixed-assets" class="font-mono font-medium text-slate-900">--</span>
          </div>
        </div>
      </div>

      <div class="mt-4 pt-3 border-t border-slate-100 flex justify-between items-center text-xs font-bold text-[#173a39]">
        <span>Total Balance Sheet Assets:</span>
        <span id="pos-total-assets" class="font-mono text-slate-950 text-sm">--</span>
      </div>
    </div>

    <!-- Col 2: Current Liabilities & Operating Obligations -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-xs p-5 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3">
          <h3 class="text-sm font-bold uppercase tracking-wider text-[#173a39]">Current Obligations</h3>
          <span id="pos-total-liab-badge" class="px-2 py-0.5 rounded text-[11px] font-semibold bg-rose-100 text-rose-800">
            Current: --
          </span>
        </div>

        <div class="space-y-2.5 text-xs">
          <div class="flex justify-between py-1 border-b border-slate-50">
            <div>
              <span class="text-slate-700 font-medium">Accounts Payable (Trade Schedule)</span>
              <p class="text-[10px] text-slate-400">Scheduled rolling vendor accounts</p>
            </div>
            <span id="pos-accounts-payable" class="font-mono font-semibold text-rose-700">--</span>
          </div>

          <div class="flex justify-between py-1 border-b border-slate-50">
            <span class="text-slate-600">First Merchants Credit Card (QBO Exact)</span>
            <span id="pos-merchants-cc" class="font-mono font-medium text-slate-900">--</span>
          </div>

          <div class="flex justify-between py-1 border-b border-slate-50">
            <div>
              <span class="text-slate-700 font-medium">Drawn Line of Credit</span>
              <p class="text-[10px] text-slate-400">Operational revolving line</p>
            </div>
            <span id="pos-line-of-credit" class="font-mono font-semibold text-amber-700">--</span>
          </div>

          <div class="p-2.5 rounded bg-slate-50 border border-slate-200 mt-2">
            <div class="flex justify-between text-slate-700 font-semibold mb-1">
              <span>Direct Deposit Clearing (Acct 126)</span>
              <span id="pos-payroll-payable" class="font-mono text-slate-500">--</span>
            </div>
            <p class="text-[11px] text-slate-500 leading-tight">
              <strong>Footnote:</strong> <span id="pos-payroll-clearing-note">Direct deposit clearing liability account.</span>
            </p>
          </div>

          <div class="p-2 rounded bg-amber-50/60 border border-amber-200 text-[11px] text-amber-900 leading-tight">
            <strong>QBO Total Liabilities Walk:</strong> Trade debt is certified and reconciled against vendor schedules.
          </div>
        </div>
      </div>

      <div class="mt-4 pt-3 border-t border-slate-100 text-[11px] text-slate-500 flex justify-between">
        <span>Sum of Operating Obligations:</span>
        <span id="pos-total-liabilities" class="font-mono font-semibold text-slate-800">--</span>
      </div>
    </div>

    <!-- Col 3: Net Assets Structure & Exact Workbook Equity Walk -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-xs p-5 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3">
          <h3 class="text-sm font-bold uppercase tracking-wider text-[#173a39]">Workbook Equity Structure</h3>
          <span id="pos-total-equity-badge" class="px-2 py-0.5 rounded text-[11px] font-semibold bg-purple-100 text-purple-800">
            Total Equity: --
          </span>
        </div>

        <div class="space-y-2 text-xs">
          <!-- Exact Workbook Equity Walk Lines -->
          <div class="p-2.5 rounded bg-slate-50 border border-slate-200 space-y-1">
            <div class="flex justify-between font-semibold text-slate-800">
              <div>
                <span>Net Assets Without Donor Restrictions</span>
                <p class="text-[10px] text-slate-400 font-normal">Includes Fidelity designated reserve + undesignated operating</p>
              </div>
              <span id="pos-net-without-restrictions" class="font-mono">--</span>
            </div>

            <div class="flex justify-between font-semibold text-purple-900 pt-1 border-t border-slate-200">
              <span>(+) Net Assets With Donor Restrictions</span>
              <span id="pos-net-with-restrictions" class="font-mono">--</span>
            </div>

            <div class="flex justify-between text-rose-700">
              <div>
                <span>(-) Opening Balance Equity (Conversion)</span>
                <p class="text-[10px] text-rose-500/80">Historical conversion offset absorbed into retained earnings</p>
              </div>
              <span id="pos-opening-equity" class="font-mono">--</span>
            </div>

            <div class="flex justify-between text-slate-700">
              <span>(+) Retained Earnings</span>
              <span id="pos-retained-earnings" class="font-mono">--</span>
            </div>

            <div class="flex justify-between text-rose-700">
              <span>(-) 2026 YTD Net Deficit</span>
              <span id="pos-current-net" class="font-mono">--</span>
            </div>

            <div class="pt-1.5 border-t-2 border-slate-300 flex justify-between font-bold text-slate-900">
              <span>(=) Certified Workbook Equity</span>
              <span id="pos-total-equity" class="font-mono text-[#1c746c]">--</span>
            </div>
          </div>

          <!-- Balance Sheet Equilibrium Confirmation -->
          <div class="p-2 rounded bg-emerald-50 border border-emerald-200 text-[10.5px] text-emerald-900 leading-tight">
            <strong>Equilibrium Check:</strong> Total Liabilities + Total Equity = Total Assets with <strong>$0.00 variance</strong>.
          </div>
        </div>
      </div>

      <div class="mt-3 pt-2 border-t border-slate-100 flex justify-between items-center text-xs font-bold text-[#173a39]">
        <span>Total Liabilities & Equity:</span>
        <span id="pos-total-eq-assets" class="font-mono text-slate-950 text-sm">--</span>
      </div>
    </div>
  </div>

  <!-- Integrated Accounts Payable Schedule -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden" id="ap-schedule-root" data-ap-schedule={JSON.stringify(apSchedule)}>
    <div class="px-5 py-3.5 border-b border-slate-100 bg-[#f5efe3]/40 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <div>
        <h4 class="text-sm font-bold text-[#173a39]">
          Accounts Payable Schedule (QBO Vendor Balance Summary)
        </h4>
        <p id="pos-ap-summary-note" class="text-xs text-slate-500 mt-0.5">
          Accounts payable schedule and vendor aging details.
        </p>
      </div>
      <div class="flex items-center gap-2 self-start sm:self-auto">
        <button
          id="export-ap-csv-btn"
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-white text-[#173a39] border border-slate-300 hover:bg-slate-50 hover:border-slate-400 shadow-xs transition cursor-pointer"
          title="Download Accounts Payable aging schedule as CSV"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-rose-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Export AP (CSV)</span>
        </button>
        <span id="pos-ap-total-badge" class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-semibold bg-rose-100 text-rose-800 border border-rose-200">
          Total AP: --
        </span>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-600 font-semibold uppercase tracking-wider border-b border-slate-200">
          <tr>
            <th scope="col" class="py-2.5 px-4">Vendor / Payee</th>
            <th scope="col" class="py-2.5 px-3">Expense Category</th>
            <th scope="col" class="py-2.5 px-3">Group</th>
            <th scope="col" class="py-2.5 px-3 text-right">Balance Due</th>
            <th scope="col" class="py-2.5 px-4 text-center">Status / Classification</th>
          </tr>
        </thead>
        <tbody id="pos-ap-tbody" class="divide-y divide-slate-100">
          <tr>
            <td colspan="5" class="py-8 text-center text-slate-400">
              <div class="inline-flex items-center gap-2">
                <svg class="animate-spin h-4 w-4 text-[#173a39]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                </svg>
                <span>Loading AP schedule...</span>
              </div>
            </td>
          </tr>
        </tbody>
        <tfoot class="bg-[#173a39] text-white font-semibold text-xs border-t-2 border-[#0f766e]">
          <tr>
            <td colspan="3" class="py-2.5 px-4 uppercase tracking-wider text-white">Certified Accounts Payable Total</td>
            <td id="pos-ap-foot-total" class="py-2.5 px-3 text-right font-mono text-emerald-300 font-bold">--</td>
            <td class="py-2.5 px-4 text-center text-emerald-400 text-[11px]">All Accounts Reconciled</td>
          </tr>
        </tfoot>
      </table>
    </div>

    <!-- Governance & Disclosures Footer -->
    <div class="p-4 bg-slate-50 border-t border-slate-200 grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
      <div class="p-2.5 rounded bg-white border border-slate-200 text-slate-600">
        <span class="font-bold text-slate-800 block mb-1">Form 990 Governance & Related Party Disclosures:</span>
        <p class="text-[11px] leading-relaxed">
          Related parties represent bona fide caregiver mileage and shelter operational reimbursements. Robert Monteer is an expense clearing credit balance on staff account. Executive Director Jeffery Howard is compensated exclusively through standard board-approved W-2 payroll and carries no vendor payables.
        </p>
      </div>
      <div class="p-2.5 rounded bg-white border border-slate-200 text-slate-600">
        <span class="font-bold text-slate-800 block mb-1">Contra-AP Accounting & Cash Recognition Note:</span>
        <p class="text-[11px] leading-relaxed">
          Credit balances represent contra-AP credit memos offsetting gross payables, not negative operational expenditures. First Merchants statement ending cash and GL book cash are certified and locked as of August 31, 2026 with an exact reconciled float.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  function initApScheduleExport() {
    const btn = document.getElementById('export-ap-csv-btn');
    const root = document.getElementById('ap-schedule-root');
    if (btn && root) {
      btn.addEventListener('click', () => {
        try {
          const raw = root.getAttribute('data-ap-schedule');
          if (!raw) return;
          const items = JSON.parse(raw);

          const headers = [
            'Vendor / Payee',
            'Expense Category',
            'Balance Due ($)',
            'Group',
            'Status / Classification',
            'Related Party Note',
            'Contra Note'
          ];

          const rows = items.map((item: any) => [
            `"${(item.vendor || '').replace(/"/g, '""')}"`,
            `"${(item.category || '').replace(/"/g, '""')}"`,
            item.amount.toFixed(2),
            `"${(item.group || '').replace(/"/g, '""')}"`,
            `"${(item.status || '').replace(/"/g, '""')}"`,
            `"${(item.related_party_note || '').replace(/"/g, '""')}"`,
            `"${(item.credit_note || '').replace(/"/g, '""')}"`
          ]);

          const total = items.reduce((a: number, b: any) => a + b.amount, 0);
          rows.push([
            '"Certified Accounts Payable Total"',
            '"Accounts Reconciled"',
            total.toFixed(2),
            '"Total"',
            '"Reconciled"',
            '""',
            '""'
          ]);

          const csvString = [headers.join(','), ...rows.map((r: string[]) => r.join(','))].join('\r\n');
          const blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
          const url = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = url;
          link.setAttribute('download', `HSMC_Accounts_Payable_Schedule_${new Date().toISOString().slice(0, 10)}.csv`);
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
          URL.revokeObjectURL(url);
        } catch (err) {
          console.error('Failed to export AP CSV:', err);
        }
      });
    }
  }

  document.addEventListener('astro:page-load', initApScheduleExport);
  if (document.readyState !== 'loading') {
    initApScheduleExport();
  } else {
    document.addEventListener('DOMContentLoaded', initApScheduleExport);
  }
</script>
