---
interface Props {
  position?: any;
}

const { position = null } = Astro.props;
---

<div class="space-y-6">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Col 1: Liquid Assets & Cash Stack -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-xs p-5 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3">
          <h3 class="text-sm font-bold uppercase tracking-wider text-[#173a39]">Statement of Assets (QBO)</h3>
          <span id="pos-total-assets-badge" class="px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-100 text-emerald-800">
            Total: --
          </span>
        </div>

        <div class="space-y-2.5 text-xs">
          <!-- Line 1: General Ledger Book Cash -->
          <div class="flex justify-between py-1 border-b border-slate-50">
            <div>
              <span class="text-slate-800 font-semibold">First Merchants Operating Checking (Book)</span>
              <p class="text-[10px] text-slate-400">General Ledger operating cash balance</p>
            </div>
            <span id="pos-checking-book" class="font-mono font-medium text-slate-900">--</span>
          </div>

          <!-- Line 2: Bank Statement Ending Cash (Certified & Reconciled) -->
          <div class="flex justify-between items-center py-1.5 border-b border-slate-50 bg-emerald-50/70 px-2 rounded border border-emerald-200/60">
            <div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-950 font-semibold">First Merchants Bank Statement Ending Cash</span>
                <a href="#bank-statement-viewer" class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[9px] font-bold bg-emerald-200 text-emerald-900 hover:bg-emerald-300 transition" title="Inspect August 31 Bank Statement and Reconciliation Report">
                  Statement & Rec &rarr;
                </a>
              </div>
              <p class="text-[10px] text-emerald-800">Certified & locked to Aug 31 statement ($0.00 difference)</p>
            </div>
            <span id="pos-checking-register" class="font-mono font-bold text-emerald-900">--</span>
          </div>

          <div class="flex justify-between py-1 border-b border-slate-50">
            <span class="text-slate-600">Undeposited Funds</span>
            <span id="pos-undeposited-funds" class="font-mono font-medium text-slate-900">--</span>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-50">
            <span class="text-slate-600">Petty Cash</span>
            <span id="pos-petty-cash" class="font-mono font-medium text-slate-900">--</span>
          </div>

          <div class="flex justify-between py-1.5 bg-[#f5efe3]/70 px-2 rounded font-semibold text-[#173a39]">
            <div>
              <span>Total Book Operating Cash</span>
              <p class="text-[10px] text-slate-500 font-normal">Book Checking + Undeposited + Petty Cash</p>
            </div>
            <span id="pos-total-book-cash" class="font-mono text-[#1c746c] text-sm">--</span>
          </div>

          <div class="flex justify-between py-1 border-b border-slate-50">
            <div>
              <span class="text-slate-700 font-medium">QBO Tax Holding Escrow</span>
              <p class="text-[10px] text-slate-400">Current asset escrow · excluded from cash tile</p>
            </div>
            <span id="pos-tax-escrow" class="font-mono font-medium text-slate-800">--</span>
          </div>

          <div class="flex justify-between py-1 border-b border-slate-50">
            <div>
              <span class="text-slate-700 font-medium">Fidelity Board Reserve</span>
              <p class="text-[10px] text-slate-400">Designated reserve inside unrestricted · principal draw needs vote</p>
            </div>
            <span id="pos-fidelity-reserve" class="font-mono font-medium text-indigo-700">--</span>
          </div>

          <div class="flex justify-between py-1 border-b border-slate-50">
            <div>
              <span class="text-slate-700 font-medium">Fixed Capital Assets (Net of Depr.)</span>
              <p class="text-[10px] text-slate-400">Land, Buildings net, Equip net, Contra</p>
            </div>
            <span id="pos-fixed-assets" class="font-mono font-medium text-slate-900">--</span>
          </div>
        </div>
      </div>

      <div class="mt-4 pt-3 border-t border-slate-100 flex justify-between items-center text-xs font-bold text-[#173a39]">
        <span>Total Balance Sheet Assets:</span>
        <span id="pos-total-assets" class="font-mono text-slate-950 text-sm">--</span>
      </div>
    </div>

    <!-- Col 2: Current Liabilities & Operating Obligations -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-xs p-5 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3">
          <h3 class="text-sm font-bold uppercase tracking-wider text-[#173a39]">Current Obligations</h3>
          <span id="pos-total-liab-badge" class="px-2 py-0.5 rounded text-[11px] font-semibold bg-rose-100 text-rose-800">
            Current: --
          </span>
        </div>

        <div class="space-y-2.5 text-xs">
          <div class="flex justify-between py-1 border-b border-slate-50">
            <div>
              <span class="text-slate-700 font-medium">Accounts Payable (Trade Schedule)</span>
              <p class="text-[10px] text-slate-400">Scheduled rolling vendor accounts</p>
            </div>
            <span id="pos-accounts-payable" class="font-mono font-semibold text-rose-700">--</span>
          </div>

          <div class="flex justify-between py-1 border-b border-slate-50">
            <span class="text-slate-600">First Merchants Credit Card (QBO Exact)</span>
            <span id="pos-merchants-cc" class="font-mono font-medium text-slate-900">--</span>
          </div>

          <div class="flex justify-between py-1 border-b border-slate-50">
            <div>
              <span class="text-slate-700 font-medium">Drawn Line of Credit</span>
              <p class="text-[10px] text-slate-400">Operational revolving line</p>
            </div>
            <span id="pos-line-of-credit" class="font-mono font-semibold text-amber-700">--</span>
          </div>

          <div class="p-2.5 rounded bg-slate-50 border border-slate-200 mt-2">
            <div class="flex justify-between text-slate-700 font-semibold mb-1">
              <span>Direct Deposit Clearing (Acct 126)</span>
              <span id="pos-payroll-payable" class="font-mono text-slate-500">--</span>
            </div>
            <p class="text-[11px] text-slate-500 leading-tight">
              <strong>Footnote:</strong> <span id="pos-payroll-clearing-note">Direct deposit clearing liability account.</span>
            </p>
          </div>

          <div class="p-2 rounded bg-slate-50 border border-slate-200 text-[11px] text-slate-600 leading-tight">
            Operational trade obligations reconciled against active accounts.
          </div>
        </div>
      </div>

      <div class="mt-4 pt-3 border-t border-slate-100 text-[11px] text-slate-500 flex justify-between">
        <span>Sum of Operating Obligations:</span>
        <span id="pos-total-liabilities" class="font-mono font-semibold text-slate-800">--</span>
      </div>
    </div>

    <!-- Col 3: Net Assets Structure & Equity -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-xs p-5 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3">
          <h3 class="text-sm font-bold uppercase tracking-wider text-[#173a39]">Net Assets & Equity Structure</h3>
          <span id="pos-total-equity-badge" class="px-2 py-0.5 rounded text-[11px] font-semibold bg-purple-100 text-purple-800">
            Total Equity: --
          </span>
        </div>

        <div class="space-y-2 text-xs">
          <!-- Exact Net Assets Walk Lines -->
          <div class="p-2.5 rounded bg-slate-50 border border-slate-200 space-y-1">
            <div class="flex justify-between font-semibold text-slate-800">
              <div>
                <span>Net Assets Without Donor Restrictions</span>
                <p class="text-[10px] text-slate-400 font-normal">Includes Fidelity designated reserve + undesignated operating</p>
              </div>
              <span id="pos-net-without-restrictions" class="font-mono">--</span>
            </div>

            <div class="flex justify-between font-semibold text-purple-900 pt-1 border-t border-slate-200">
              <span>(+) Net Assets With Donor Restrictions</span>
              <span id="pos-net-with-restrictions" class="font-mono">--</span>
            </div>

            <div class="flex justify-between text-rose-700">
              <div>
                <span>(-) Opening Balance Equity (Conversion)</span>
                <p class="text-[10px] text-rose-500/80">Historical conversion offset absorbed into retained earnings</p>
              </div>
              <span id="pos-opening-equity" class="font-mono">--</span>
            </div>

            <div class="flex justify-between text-slate-700">
              <span>(+) Retained Earnings</span>
              <span id="pos-retained-earnings" class="font-mono">--</span>
            </div>

            <div class="flex justify-between text-rose-700">
              <span>(-) 2026 YTD Net Deficit</span>
              <span id="pos-current-net" class="font-mono">--</span>
            </div>

            <div class="pt-1.5 border-t-2 border-slate-300 flex justify-between font-bold text-slate-900">
              <span>(=) Total Net Assets / Equity</span>
              <span id="pos-total-equity" class="font-mono text-[#1c746c]">--</span>
            </div>
          </div>

          <!-- Balance Sheet Equilibrium Confirmation -->
          <div class="p-2 rounded bg-emerald-50 border border-emerald-200 text-[10.5px] text-emerald-900 leading-tight">
            <strong>Balanced:</strong> Total Liabilities + Equity = Total Assets (<strong>$0.00 variance</strong>).
          </div>
        </div>
      </div>

      <div class="mt-3 pt-2 border-t border-slate-100 flex justify-between items-center text-xs font-bold text-[#173a39]">
        <span>Total Liabilities & Equity:</span>
        <span id="pos-total-eq-assets" class="font-mono text-slate-950 text-sm">--</span>
      </div>
    </div>
  </div>
</div>

