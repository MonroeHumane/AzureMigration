---
interface RestrictedFund {
  fund: string;
  amount: number;
  source: string;
}

interface PayableItem {
  vendor: string;
  amount: number;
  category: string;
  status: string;
  group: string;
  is_related_party?: boolean;
  related_party_note?: string;
  is_contra_credit?: boolean;
  credit_note?: string;
}

interface Props {
  position: {
    assets: {
      operating_checking_first_merchants: number;
      operating_checking_bank_register: number;
      undeposited_funds: number;
      petty_cash: number;
      total_book_operating_cash: number;
      tax_holding_escrow: number;
      fidelity_board_designated_reserve: number;
      total_liquid_reserves: number;
      fixed_assets_net: number;
      total_assets: number;
      bank_register_note?: string;
    };
    liabilities: {
      accounts_payable: number;
      first_merchants_credit_card: number;
      drawn_line_of_credit: number;
      payroll_clearing_direct_deposit_payable: number;
      payroll_clearing_footnote: string;
      total_operating_obligations_current: number;
      total_liabilities_qbo?: number;
      reconciliation_note?: string;
    };
    net_assets: {
      without_donor_restrictions: {
        undesignated_operating: number;
        board_designated_fidelity_reserve: number;
        total_without_donor_restrictions: number;
        fidelity_note: string;
      };
      with_donor_restrictions: {
        cat_room_expansion_fund: number;
        angels_medical_fund: number;
        schlick_estate_restricted_corpus: number;
        total_with_donor_restrictions: number;
        restricted_watch_items: RestrictedFund[];
      };
      retained_earnings_historical: number;
      opening_balance_equity: number;
      current_year_net_margin: number;
      total_equity_qbo: number;
      opening_equity_footnote: string;
    };
  };
  apSchedule: PayableItem[];
}

const { position, apSchedule } = Astro.props;

const formatDollar = (val: number) => {
  const isNeg = val < 0;
  const abs = Math.abs(val);
  const formatted = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 }).format(abs);
  return isNeg ? `(${formatted})` : formatted;
};

const formatCents = (val: number) => {
  const isNeg = val < 0;
  const abs = Math.abs(val);
  const formatted = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 }).format(abs);
  return isNeg ? `(${formatted})` : formatted;
};

const apTotal = apSchedule.reduce((acc, it) => acc + it.amount, 0);
const top8List = apSchedule.filter(it => it.group === 'Top 8 Primary');
const top8Total = top8List.reduce((acc, it) => acc + it.amount, 0);

const activeRemainingList = apSchedule.filter(it => it.group === 'Remaining AP Aging' && !it.is_contra_credit);
const activeRemainingTotal = activeRemainingList.reduce((acc, it) => acc + it.amount, 0);

const contraCreditList = apSchedule.filter(it => it.is_contra_credit);
const contraCreditTotal = contraCreditList.reduce((acc, it) => acc + it.amount, 0);
const remainingTotal = activeRemainingTotal + contraCreditTotal;
---

<div class="space-y-6">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Col 1: Liquid Assets & Cash Stack -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-xs p-5 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3">
          <h3 class="text-sm font-bold uppercase tracking-wider text-[#173a39]">Statement of Assets (QBO)</h3>
          <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-100 text-emerald-800">
            Total: {formatDollar(position.assets.total_assets)}
          </span>
        </div>

        <div class="space-y-2.5 text-xs">
          <!-- Line 1: General Ledger Book Cash -->
          <div class="flex justify-between py-1 border-b border-slate-50">
            <div>
              <span class="text-slate-800 font-semibold">First Merchants Operating Checking (Book)</span>
              <p class="text-[10px] text-slate-400">General Ledger operating cash balance</p>
            </div>
            <span class="font-mono font-medium text-slate-900">{formatDollar(position.assets.operating_checking_first_merchants)}</span>
          </div>

          <!-- Line 2: Bank Statement Ending Cash (Certified & Reconciled) -->
          <div class="flex justify-between items-center py-1.5 border-b border-slate-50 bg-emerald-50/70 px-2 rounded border border-emerald-200/60">
            <div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-950 font-semibold">First Merchants Bank Statement Ending Cash</span>
                <a href="#bank-statement-viewer" class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[9px] font-bold bg-emerald-200 text-emerald-900 hover:bg-emerald-300 transition" title="Inspect August 31 Bank Statement and Reconciliation Report">
                  Statement & Rec &rarr;
                </a>
              </div>
              <p class="text-[10px] text-emerald-800">Certified & locked to Aug 31 statement ($24,526.34 bank · $0.00 difference)</p>
            </div>
            <span class="font-mono font-bold text-emerald-900">{formatDollar(position.assets.operating_checking_bank_register)}</span>
          </div>

          <div class="flex justify-between py-1 border-b border-slate-50">
            <span class="text-slate-600">Undeposited Funds</span>
            <span class="font-mono font-medium text-slate-900">{formatDollar(position.assets.undeposited_funds)}</span>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-50">
            <span class="text-slate-600">Petty Cash</span>
            <span class="font-mono font-medium text-slate-900">{formatDollar(position.assets.petty_cash)}</span>
          </div>

          <div class="flex justify-between py-1.5 bg-[#f5efe3]/70 px-2 rounded font-semibold text-[#173a39]">
            <div>
              <span>Total Book Operating Cash</span>
              <p class="text-[10px] text-slate-500 font-normal">Book Checking ($23,469) + Undeposited ($14,004) + Petty ($200)</p>
            </div>
            <span class="font-mono text-[#1c746c] text-sm">{formatDollar(position.assets.total_book_operating_cash)}</span>
          </div>

          <div class="flex justify-between py-1 border-b border-slate-50">
            <div>
              <span class="text-slate-700 font-medium">QBO Tax Holding Escrow</span>
              <p class="text-[10px] text-slate-400">Current asset escrow · excluded from cash tile</p>
            </div>
            <span class="font-mono font-medium text-slate-800">{formatDollar(position.assets.tax_holding_escrow)}</span>
          </div>

          <div class="flex justify-between py-1 border-b border-slate-50">
            <div>
              <span class="text-slate-700 font-medium">Fidelity Board Reserve</span>
              <p class="text-[10px] text-slate-400">Designated reserve inside unrestricted · principal draw needs vote</p>
            </div>
            <span class="font-mono font-medium text-indigo-700">{formatDollar(position.assets.fidelity_board_designated_reserve)}</span>
          </div>

          <div class="flex justify-between py-1 border-b border-slate-50">
            <div>
              <span class="text-slate-700 font-medium">Fixed Capital Assets (Net of Depr.)</span>
              <p class="text-[10px] text-slate-400">Land $659.8k, Buildings net $133.9k, Equip net $6.6k, Contra -$9.0k</p>
            </div>
            <span class="font-mono font-medium text-slate-900">{formatDollar(position.assets.fixed_assets_net)}</span>
          </div>
        </div>
      </div>

      <div class="mt-4 pt-3 border-t border-slate-100 flex justify-between items-center text-xs font-bold text-[#173a39]">
        <span>Total Balance Sheet Assets:</span>
        <span class="font-mono text-slate-950 text-sm">{formatDollar(position.assets.total_assets)}</span>
      </div>
    </div>

    <!-- Col 2: Current Liabilities & Operating Obligations -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-xs p-5 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3">
          <h3 class="text-sm font-bold uppercase tracking-wider text-[#173a39]">Current Obligations</h3>
          <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-rose-100 text-rose-800">
            Current: {formatDollar(position.liabilities.total_operating_obligations_current)}
          </span>
        </div>

        <div class="space-y-2.5 text-xs">
          <div class="flex justify-between py-1 border-b border-slate-50">
            <div>
              <span class="text-slate-700 font-medium">Accounts Payable (Trade Schedule)</span>
              <p class="text-[10px] text-slate-400">19 scheduled rolling vendor accounts</p>
            </div>
            <span class="font-mono font-semibold text-rose-700">{formatDollar(position.liabilities.accounts_payable)}</span>
          </div>

          <div class="flex justify-between py-1 border-b border-slate-50">
            <span class="text-slate-600">First Merchants Credit Card (QBO Exact)</span>
            <span class="font-mono font-medium text-slate-900">{formatDollar(position.liabilities.first_merchants_credit_card)}</span>
          </div>

          <div class="flex justify-between py-1 border-b border-slate-50">
            <div>
              <span class="text-slate-700 font-medium">Drawn Line of Credit</span>
              <p class="text-[10px] text-slate-400">Operational revolving line</p>
            </div>
            <span class="font-mono font-semibold text-amber-700">{formatDollar(position.liabilities.drawn_line_of_credit)}</span>
          </div>

          <div class="p-2.5 rounded bg-slate-50 border border-slate-200 mt-2">
            <div class="flex justify-between text-slate-700 font-semibold mb-1">
              <span>Direct Deposit Clearing (Acct 126)</span>
              <span class="font-mono text-slate-500">{formatDollar(position.liabilities.payroll_clearing_direct_deposit_payable)}</span>
            </div>
            <p class="text-[11px] text-slate-500 leading-tight">
              <strong>Footnote:</strong> {position.liabilities.payroll_clearing_footnote}
