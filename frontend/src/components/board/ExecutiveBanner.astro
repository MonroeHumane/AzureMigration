---
interface Props {
  meta?: {
    period_title?: string;
    cutoff_date?: string;
    closed_months_count?: number;
    has_partial_cutoff?: boolean;
    published_by?: string;
    published_at?: string;
    sha256_checksum?: string;
    basis?: string;
    governance_level?: string;
  };
}

const { meta } = Astro.props;
---

<header class="bg-[#0b2420]/85 backdrop-blur-md border-b border-teal-800/80 shadow-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-wrap items-baseline justify-between gap-3">
    <div>
      <a href="/internal/" class="text-xs text-teal-400 hover:text-emerald-300 transition inline-flex items-center gap-1 font-medium">← Return to Hub</a>
      <h1 id="banner-period-title" class="text-2xl font-bold text-white tracking-tight mt-1">
        {meta?.period_title || '2026 YTD Executive Financials'}
      </h1>
      <p class="text-xs text-teal-300/80 mt-0.5">
        <span id="banner-cutoff">{meta?.cutoff_date || 'Closed Aug 31, 2026'}</span>
        <span id="banner-governance" class="hidden">{meta?.governance_level || ''}</span>
        <span id="banner-publisher" class="hidden">{meta?.published_by || ''}</span>
        <span id="banner-basis" class="hidden"></span>
      </p>
    </div>
    <a
      href="/internal/board/print/"
      target="_blank"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-teal-950/80 hover:bg-teal-900 text-emerald-300 hover:text-white border border-teal-700/80 text-xs font-semibold transition shadow-xs"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect width="12" height="8" x="6" y="14"></rect></svg>
      <span>Print Board Packet</span>
    </a>
  </div>
</header>
