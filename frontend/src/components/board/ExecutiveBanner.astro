---
interface Props {
  meta: {
    period_title: string;
    cutoff_date: string;
    closed_months_count: number;
    has_partial_cutoff: boolean;
    published_by: string;
    published_at: string;
    sha256_checksum: string;
    basis: string;
    governance_level: string;
  };
}

const { meta } = Astro.props;
const formattedPublishedDate = new Date(meta.published_at).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
  timeZoneName: 'short'
});
---

<header class="bg-white border-b border-slate-200 shadow-xs sticky top-0 z-30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1 flex-wrap">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-100 text-rose-800 border border-rose-200">
            {meta.governance_level}
          </span>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-[#f5efe3] text-[#173a39] border border-[#e5ded0]">
            Accounting Basis: {meta.basis}
          </span>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800 border border-emerald-200">
            QBO Verified
          </span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-bold text-[#173a39] tracking-tight">
          {meta.period_title}
        </h1>
        <p class="text-sm text-slate-600 mt-1 flex flex-wrap items-center gap-x-2">
          <span><strong>Official Cutoff:</strong> August 31, 2026 · 8 Closed & Reconciled Months (Jan 1 – Aug 31, 2026)</span>
          <span class="text-slate-300">•</span>
          <span><strong>Publisher:</strong> {meta.published_by}</span>
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <a
          href="/internal/board/print"
          target="_blank"
          class="inline-flex items-center gap-2 px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 text-sm font-medium rounded-lg transition border border-slate-300 shadow-xs"
          title="Open printable executive packet"
        >
          <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span>Print Packet (PDF)</span>
        </a>

        <div class="relative group">
          <button
            type="button"
            id="copy-hash-btn"
            data-checksum={meta.sha256_checksum}
            class="inline-flex items-center gap-2 px-3 py-2 bg-[#173a39] hover:bg-[#0f766e] text-white text-xs font-mono rounded-lg transition shadow-xs"
            title="Click to copy canonical SHA-256 Checksum"
          >
            <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>Canonical SHA-256: {meta.sha256_checksum.slice(0, 8)}...</span>
          </button>
          <div class="hidden group-hover:block absolute right-0 mt-1 w-84 p-3 bg-slate-950 text-slate-200 text-xs rounded-md shadow-xl border border-slate-800 z-50">
            <p class="font-semibold text-emerald-400 mb-1">Cryptographic Data Integrity Checksum</p>
            <p class="break-all font-mono text-[11px] text-slate-300">{meta.sha256_checksum}</p>
            <p class="mt-2 text-[10px] text-slate-400">Published: {formattedPublishedDate}</p>
            <p class="mt-1 text-[10px] text-emerald-300">Hashes canonical subset: headline KPIs + bridge + monthly footings + cutoff date.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const copyBtn = document.getElementById('copy-hash-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const hash = copyBtn.getAttribute('data-checksum');
      if (hash) {
        navigator.clipboard.writeText(hash).then(() => {
          const originalText = copyBtn.innerHTML;
          copyBtn.innerHTML = '<span class="text-emerald-400">✓ Checksum Copied!</span>';
          setTimeout(() => {
            copyBtn.innerHTML = originalText;
          }, 2000);
        });
      }
    });
  }
</script>\n