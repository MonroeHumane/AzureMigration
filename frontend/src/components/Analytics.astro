---
/**
 * Analytics.astro
 * Conditionally loads Google Analytics 4 and Microsoft Clarity.
 * Supply PUBLIC_GA_MEASUREMENT_ID and PUBLIC_CLARITY_PROJECT_ID in your .env file.
 */

const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const clarityId = import.meta.env.PUBLIC_CLARITY_PROJECT_ID;
---

{gaId && (
  <>
    <script is:inline src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} async></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
      
      document.addEventListener('astro:page-load', () => {
        gtag('config', gaId, { page_path: window.location.pathname });
      });
    </script>
  </>
)}

{clarityId && (
  <script is:inline define:vars={{ clarityId }}>
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", clarityId);
  </script>
)}
