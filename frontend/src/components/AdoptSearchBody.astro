---
import { getPets } from '../lib/directus';
import InnerShell from './InnerShell.astro';
import '../styles/monroe-adopt.css';
import '../styles/monroe-adopt-extra.css';

/*
  Unified Reactive Adopt Hub — Single-Hub Architecture with Interactive Detail Drawer,
  URL deep linking, instant client-side filtering, and Live Directus SWR Sync.
*/

interface Props {
  heading?: string;
  current?: 'all' | 'dogs' | 'cats';
  defaultType?: string;
}

const { heading = 'Available pets', current = 'all', defaultType = '' } = Astro.props;
const pets = await getPets();
const chips = (p: (typeof pets)[number]) =>
  [p.species_label || p.type, p.gender, p.age_display, p.location].filter(Boolean);
---

<InnerShell variant="adopt">
  <header class="monroe-adopt-hero">
    <div class="monroe-adopt-hero__copy">
      <p class="monroe-adopt-eyebrow">Adoption Hub</p>
      <h1>{heading}</h1>
      <p class="monroe-adopt-lead">
        Meet dogs and cats waiting for homes in Monroe County. Filter in real-time below, or click any pet to view their complete profile and start an adoption application.
      </p>
    </div>
  </header>

  <nav class="monroe-adopt-quick" aria-label="Browse adoptable animals">
    <button type="button" class:list={["monroe-adopt-pill", "monroe-adopt-pill--primary", { "monroe-adopt-pill--current": current === "dogs" }]} data-filter-trigger="dog">Dogs</button>
    <button type="button" class:list={["monroe-adopt-pill", "monroe-adopt-pill--primary", { "monroe-adopt-pill--current": current === "cats" }]} data-filter-trigger="cat">Cats</button>
    <button type="button" class:list={["monroe-adopt-pill", "monroe-adopt-pill--primary", { "monroe-adopt-pill--current": current === "all" }]} data-filter-trigger="">All Pets</button>
    <a class="monroe-adopt-pill monroe-adopt-pill--ghost" href="/adoptions">Adoption Info &amp; Application</a>
  </nav>

  <section class="monroe-adopt-search" aria-label="Browse available animals">
    <div id="masw" class="monroe-animal-search-widget monroe-animal-search-widget--no-header monroe-animal-search-widget--compact">
      <div class="animal-search-filters">
        <div class="animal-search-controls" role="search" aria-labelledby="masw-search-legend">
          <p id="masw-search-legend" class="screen-reader-text">Find a pet</p>

          <div class="animal-search-toolbar">
            <div class="animal-search-query-row">
              <label for="masw-q" class="screen-reader-text">Search by name, breed, or description</label>
              <div class="animal-search-query-combo">
                <input type="search" id="masw-q" class="animal-search-q" autocomplete="off"
                  placeholder="Search by name, breed, or description…" />
                <button type="button" class="animal-search-submit" aria-label="Search pets">
                  <span class="search-icon" aria-hidden="true">🔍</span>
                </button>
              </div>
            </div>

            <div class="filter-row filter-row--primary">
              <div class="filter-group">
                <label for="masw-type">Type</label>
                <select id="masw-type" class="animal-filter" data-filter-key="type" data-default={defaultType}>
                  <option value="">All types</option>
                  <option value="dog">Dogs</option>
                  <option value="cat">Cats</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div class="filter-group">
                <label for="masw-gender">Gender</label>
                <select id="masw-gender" class="animal-filter" data-filter-key="gender">
                  <option value="">Any gender</option>
                  <option value="male">Male</option>
                  <option value="female">Female</option>
                </select>
              </div>
            </div>

            <div class="animal-search-sort-row">
              <label for="masw-sort">Sort by</label>
              <select id="masw-sort" class="animal-sort">
                <option value="name">Name (A–Z)</option>
                <option value="type">Type</option>
                <option value="breed">Breed</option>
              </select>
            </div>

            <div class="animal-search-toolbar-actions">
              <button type="button" class="reset-button reset-button--compact" data-adopt-reset>Reset</button>
            </div>
          </div>
        </div>
      </div>

      <div class="animal-search-results">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
          <p class="animal-search-summary" data-adopt-summary aria-live="polite" style="font-weight: 700; color: #0f766e;"></p>
          <span id="liveSyncStatus" style="font-size: 0.85rem; color: #64748b; display: flex; align-items: center; gap: 0.4rem;">
            <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #10b981;"></span>
            Live Shelter Roster
          </span>
        </div>

        <div class="results-empty" hidden aria-hidden="true">
          <div class="empty-state">
            <div class="empty-icon">🐾</div>
            <h4>No pets match your search</h4>
            <p>Try adjusting your search query or reset the filters to see all available animals.</p>
            <button type="button" class="cta-button empty-state-reset" data-adopt-reset>Reset filters</button>
          </div>
        </div>

        <div class="results-grid monroe-pet-results monroe-pet-results--grid" data-adopt-grid>
          {pets.map((pet) => (
            <div
              class="animal-card animal-card--interactive"
              data-adopt-id={pet.id}
              data-adopt-type={pet.type}
              data-adopt-gender={(pet.gender ?? '').toLowerCase()}
              data-adopt-name={pet.name.toLowerCase()}
              data-adopt-breed={(pet.breed ?? '').toLowerCase()}
              data-adopt-desc={(pet.description ?? '').toLowerCase()}
              data-adopt-age={pet.age_display || pet.age}
              data-adopt-image={pet.image}
              data-adopt-location={pet.location || 'Shelter'}
              data-adopt-raw-name={pet.name}
              data-adopt-raw-breed={pet.breed}
              style="cursor: pointer;"
              tabindex="0"
              role="button"
              aria-label={`View details for ${pet.name}`}
            >
              <div class="animal-image">
                <img src={pet.image} alt={pet.name} loading="lazy" decoding="async" />
              </div>
              <div class="animal-info">
                <h4 class="animal-name">{pet.name}</h4>
                <div class="animal-breed">{pet.breed}</div>
                <div class="animal-chip-row">
                  {chips(pet).map((chip) => <span class="animal-chip">{chip}</span>)}
                </div>
                <button type="button" class="animal-view-profile animal-action-btn" style="width: 100%; border: none; font-family: inherit; font-size: inherit; cursor: pointer;">
                  Meet {pet.name} &rarr;
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="animal-search-footer">
        <p class="adoption-info">
          Ready to adopt? <a href="/adoptions">Learn about our adoption process</a> or
          <a href="tel:734-243-3669">call us at (734) 243-3669</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Slide-Over Pet Detail Drawer Modal -->
  <dialog id="petModal" class="pet-modal-drawer" style="border: none; border-radius: 24px; padding: 0; max-width: 720px; width: 92vw; max-height: 90vh; box-shadow: 0 25px 60px rgba(0,0,0,0.4); margin: auto; background: #ffffff; overflow: hidden;">
    <div style="position: relative; max-height: 90vh; display: flex; flex-direction: column; overflow: hidden;">
      <!-- Modal Header Image -->
      <div style="position: relative; height: 320px; background: #0c2a26; overflow: hidden;">
        <img id="modalPetImg" src="" alt="" style="width: 100%; height: 100%; object-fit: cover;" />
        <button id="modalCloseBtn" type="button" aria-label="Close" style="position: absolute; top: 1rem; right: 1rem; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: rgba(0,0,0,0.65); color: #fff; border: none; font-size: 1.4rem; cursor: pointer; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(8px);">✕</button>
        <span id="modalSpeciesTag" style="position: absolute; bottom: 1rem; left: 1.25rem; background: rgba(15, 118, 110, 0.95); color: #fff; padding: 0.4rem 1rem; border-radius: 999px; font-weight: 700; font-size: 0.9rem; backdrop-filter: blur(4px);">Dog</span>
      </div>

      <!-- Modal Body -->
      <div style="padding: 1.75rem; overflow-y: auto; flex: 1;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
          <h2 id="modalPetName" style="font-family: 'Abril Fatface', Georgia, serif; font-size: 2.4rem; color: #16302f; line-height: 1.1;">Pet Name</h2>
          <button id="modalShareBtn" type="button" style="background: rgba(15,118,110,0.1); border: 1px solid rgba(15,118,110,0.25); color: #0f766e; border-radius: 999px; padding: 0.4rem 0.9rem; font-size: 0.85rem; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 0.35rem;">
            <span>🔗</span> Share
          </button>
        </div>
        <p id="modalPetBreed" style="font-size: 1.15rem; color: #0f766e; font-weight: 600; margin-bottom: 1.25rem;">Breed</p>

        <!-- Chips Row -->
        <div id="modalChips" style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem;">
          <!-- Dynamically populated -->
        </div>

        <!-- Medical & Shelter Care Badges -->
        <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 14px; padding: 1rem 1.25rem; margin-bottom: 1.5rem;">
          <h4 style="color: #166534; font-size: 0.95rem; font-weight: 700; margin-bottom: 0.5rem;">🐾 Included With Adoption:</h4>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem; font-size: 0.9rem; color: #15803d;">
            <div>✓ Spayed / Neutered</div>
            <div>✓ Microchipped</div>
            <div>✓ Rabies &amp; Core Vaccines</div>
            <div>✓ Veterinary Examined</div>
          </div>
        </div>

        <!-- Bio / Description -->
        <div style="margin-bottom: 1.75rem;">
          <h3 style="font-size: 1.2rem; color: #1e293b; margin-bottom: 0.5rem;">About <span id="modalPetAboutName">This Pet</span></h3>
          <p id="modalPetBio" style="color: #475569; font-size: 1.05rem; line-height: 1.65;">
            Looking for a loving home in Monroe County!
          </p>
        </div>

        <!-- Action CTAs -->
        <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; padding-top: 1rem; border-top: 1px solid #e2e8f0;">
          <a id="modalApplyBtn" href="/adoptions" class="monroe-btn" style="flex: 1; min-width: 200px; text-align: center;">
            Apply to Adopt <span id="modalBtnName"></span> &rarr;
          </a>
          <a href="tel:734-243-3669" class="monroe-btn monroe-btn--outline" style="flex: 1; min-width: 180px; text-align: center;">
            📞 (734) 243-3669
          </a>
        </div>
      </div>
    </div>
  </dialog>
</InnerShell>

<style>
  dialog::backdrop {
    background: rgba(4, 16, 14, 0.75);
    backdrop-filter: blur(6px);
  }
  .animal-card--interactive {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .animal-card--interactive:hover,
  .animal-card--interactive:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(15, 118, 110, 0.18);
  }
  .monroe-adopt-pill.active {
    background: #0f766e !important;
    color: #ffffff !important;
  }
</style>

<script>
  // Unified Client-Side Search, Filter, Sort, Deep-Linking & Live Directus SWR
  const widget = document.querySelector<HTMLElement>('#masw');
  const grid = widget?.querySelector<HTMLElement>('[data-adopt-grid]');
  const summary = widget?.querySelector<HTMLElement>('[data-adopt-summary]');
  const empty = widget?.querySelector<HTMLElement>('.results-empty');
  const q = widget?.querySelector<HTMLInputElement>('#masw-q');
  const typeSel = widget?.querySelector<HTMLSelectElement>('#masw-type');
  const genderSel = widget?.querySelector<HTMLSelectElement>('#masw-gender');
  const sortSel = widget?.querySelector<HTMLSelectElement>('#masw-sort');
  const pillBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter-trigger]'));

  // Modal Elements
  const modal = document.getElementById('petModal') as HTMLDialogElement | null;
  const modalCloseBtn = document.getElementById('modalCloseBtn');
  const modalPetImg = document.getElementById('modalPetImg') as HTMLImageElement | null;
  const modalPetName = document.getElementById('modalPetName');
  const modalPetBreed = document.getElementById('modalPetBreed');
  const modalSpeciesTag = document.getElementById('modalSpeciesTag');
  const modalChips = document.getElementById('modalChips');
  const modalPetBio = document.getElementById('modalPetBio');
  const modalPetAboutName = document.getElementById('modalPetAboutName');
  const modalBtnName = document.getElementById('modalBtnName');
  const modalShareBtn = document.getElementById('modalShareBtn');

  // 1. URL Query Parameter Sync
  const params = new URLSearchParams(window.location.search);
  if (params.has('q') && q) q.value = params.get('q') || '';
  if (params.has('gender') && genderSel) genderSel.value = params.get('gender') || '';
  if (params.has('type') && typeSel) typeSel.value = params.get('type') || '';
  if (params.has('sort') && sortSel) sortSel.value = params.get('sort') || 'name';

  const getCards = () => Array.from(grid?.querySelectorAll<HTMLElement>('.animal-card') ?? []);

  const updatePillStates = (activeType: string) => {
    pillBtns.forEach((btn) => {
      const isTarget = btn.dataset.filterTrigger === activeType;
      btn.classList.toggle('monroe-adopt-pill--current', isTarget);
      btn.classList.toggle('active', isTarget);
    });
  };

  const apply = (updateUrl = true) => {
    const query = (q?.value ?? '').trim().toLowerCase();
    const type = typeSel?.value ?? '';
    const gender = genderSel?.value ?? '';
    const sort = sortSel?.value ?? 'name';

    updatePillStates(type);

    if (updateUrl && window.history.replaceState) {
      const url = new URL(window.location.href);
      if (query) url.searchParams.set('q', query); else url.searchParams.delete('q');
      if (type) url.searchParams.set('type', type); else url.searchParams.delete('type');
      if (gender) url.searchParams.set('gender', gender); else url.searchParams.delete('gender');
      if (sort && sort !== 'name') url.searchParams.set('sort', sort); else url.searchParams.delete('sort');
      window.history.replaceState({}, '', url.pathname + (url.search ? url.search : ''));
    }

    const visible = getCards().filter((card) => {
      if (type && card.dataset.adoptType !== type) return false;
      if (gender && card.dataset.adoptGender !== gender) return false;
      if (query) {
        const hay = `${card.dataset.adoptName} ${card.dataset.adoptBreed} ${card.dataset.adoptDesc}`.toLowerCase();
        if (!hay.includes(query)) return false;
      }
      return true;
    });

    visible.sort((a, b) =>
      sort === 'name'
        ? (a.dataset.adoptName ?? '').localeCompare(b.dataset.adoptName ?? '')
        : sort === 'breed'
          ? (a.dataset.adoptBreed ?? '').localeCompare(b.dataset.adoptBreed ?? '')
          : (a.dataset.adoptType ?? '').localeCompare(b.dataset.adoptType ?? '') || (a.dataset.adoptName ?? '').localeCompare(b.dataset.adoptName ?? '')
    );

    getCards().forEach((card) => {
      const show = visible.includes(card);
      card.style.display = show ? '' : 'none';
      if (show) grid?.appendChild(card);
    });

    if (empty) empty.hidden = visible.length > 0;
    if (summary) {
      summary.textContent = `${visible.length} ${visible.length === 1 ? 'pet' : 'pets'} available for adoption`;
    }
  };

  // Quick Filter Pill Click
  pillBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const triggerType = btn.dataset.filterTrigger || '';
      if (typeSel) typeSel.value = triggerType;
      apply(true);
    });
  });

  [q, typeSel, genderSel, sortSel].forEach((el) => el?.addEventListener('input', () => apply(true)));
  widget?.querySelectorAll('[data-adopt-reset]').forEach((btn) =>
    btn.addEventListener('click', () => {
      if (q) q.value = '';
      if (typeSel) typeSel.value = '';
      if (genderSel) genderSel.value = '';
      if (sortSel) sortSel.value = 'name';
      apply(true);
    })
  );

  // 2. Pet Detail Drawer Open/Close
  function openPetModal(card: HTMLElement, updateHistory = true) {
    if (!modal) return;
    const id = card.dataset.adoptId || '';
    const name = card.dataset.adoptRawName || 'Pet';
    const breed = card.dataset.adoptRawBreed || 'Shelter Pet';
    const type = card.dataset.adoptType || 'pet';
    const age = card.dataset.adoptAge || '';
    const gender = card.dataset.adoptGender || '';
    const location = card.dataset.adoptLocation || 'Shelter';
    const img = card.dataset.adoptImage || '';

    if (modalPetImg) {
      modalPetImg.src = img;
      modalPetImg.alt = name;
    }
    if (modalPetName) modalPetName.textContent = name;
    if (modalPetBreed) modalPetBreed.textContent = breed;
    if (modalSpeciesTag) modalSpeciesTag.textContent = type.toUpperCase();
    if (modalPetAboutName) modalPetAboutName.textContent = name;
    if (modalBtnName) modalBtnName.textContent = name;

    if (modalChips) {
      modalChips.innerHTML = `
        <span style="background:#e0f2fe; color:#0369a1; padding:0.35rem 0.85rem; border-radius:999px; font-weight:700; font-size:0.9rem;">🐾 ${type === 'cat' ? 'Cat' : 'Dog'}</span>
        <span style="background:#fef3c7; color:#92400e; padding:0.35rem 0.85rem; border-radius:999px; font-weight:700; font-size:0.9rem;">🎂 ${age || 'Unknown age'}</span>
        <span style="background:#f3e8ff; color:#6b21a8; padding:0.35rem 0.85rem; border-radius:999px; font-weight:700; font-size:0.9rem;">⚧ ${gender ? gender.toUpperCase() : 'Unknown'}</span>
        <span style="background:#f1f5f9; color:#334155; padding:0.35rem 0.85rem; border-radius:999px; font-weight:700; font-size:0.9rem;">📍 ${location}</span>
      `;
    }

    if (modalPetBio) {
      modalPetBio.textContent = `${name} is currently staying at our shelter in the ${location}. ${name} is looking for a loving forever home in Monroe County. Visit during shelter hours or submit an online adoption application today!`;
    }

    if (modalShareBtn) {
      modalShareBtn.onclick = () => {
        const shareUrl = `${window.location.origin}/adopt?pet=${id}`;
        navigator.clipboard.writeText(shareUrl).then(() => {
          modalShareBtn.innerHTML = '<span>✓</span> Copied!';
          setTimeout(() => { modalShareBtn.innerHTML = '<span>🔗</span> Share'; }, 2000);
        }).catch(() => {});
      };
    }

    if (updateHistory && window.history.pushState) {
      const url = new URL(window.location.href);
      url.searchParams.set('pet', id);
      window.history.pushState({ petId: id }, '', url.href);
    }

    modal.showModal();
  }

  function closePetModal() {
    if (!modal) return;
    modal.close();
    const url = new URL(window.location.href);
    url.searchParams.delete('pet');
    window.history.replaceState({}, '', url.pathname + (url.search ? url.search : ''));
  }

  modalCloseBtn?.addEventListener('click', closePetModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closePetModal();
  });

  // Attach card click handlers
  function bindCardEvents() {
    getCards().forEach((card) => {
      card.onclick = () => openPetModal(card);
      card.onkeydown = (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openPetModal(card);
        }
      };
    });
  }
  bindCardEvents();

  // Check URL if a pet ID was requested directly (e.g. /adopt?pet=61220759)
  if (params.has('pet')) {
    const targetId = params.get('pet');
    const targetCard = getCards().find(c => c.dataset.adoptId === targetId);
    if (targetCard) {
      setTimeout(() => openPetModal(targetCard, false), 150);
    }
  }

  apply(false);

  // 3. Live SWR Sync against Directus API (silent revalidation)
  async function syncLiveDirectusPets() {
    try {
      const res = await fetch('https://mchs-directus.livelyfield-d0a70609.eastus.azurecontainerapps.io/items/pets?filter[archived_at][_null]=true&limit=-1', {
        signal: AbortSignal.timeout(4000),
      });
      if (res.ok) {
        const json = await res.json();
        if (json.data && json.data.length > 0) {
          const liveIds = new Set(json.data.map((p: any) => String(p.id)));
          getCards().forEach((card) => {
            const cardId = card.dataset.adoptId;
            if (cardId && !liveIds.has(cardId)) {
              card.remove(); // Pet adopted / archived
            }
          });
          apply(false);
        }
      }
    } catch (e) {
      // Offline/cold start safe fallback
    }
  }
  syncLiveDirectusPets();
</script>
