<script>
  import QRCodeStyling from 'qr-code-styling';

  function initPetSyncPortal() {
    const root = document.getElementById('petsync-portal-root');
    if (!root) return;
    if ((root as any).__petsync_initialized) return;
    (root as any).__petsync_initialized = true;

    // Image fallback listener for pets with failed thumbnails
    root.addEventListener('error', (e) => {
      const target = e.target as HTMLImageElement | null;
      if (target && target.tagName === 'IMG' && target.hasAttribute('data-fallback')) {
        const fallback = target.getAttribute('data-fallback');
        target.removeAttribute('data-fallback');
        if (fallback) target.src = fallback;
      }
    }, true);

    // Filter controls and DOM elements
    const statusPills = root.querySelectorAll<HTMLButtonElement>('.petsync-status-pill');
    const speciesPills = root.querySelectorAll<HTMLButtonElement>('.petsync-species-btn');
    const searchInput = root.querySelector<HTMLInputElement>('#petsync-search-input');
    const locationFilter = root.querySelector('#petsync-location-filter') as HTMLSelectElement | null;
    const durationFilter = root.querySelector('#petsync-duration-filter') as HTMLSelectElement | null;
    const resetBtn = root.querySelector('#petsync-reset-btn');
    const exportBtn = root.querySelector('#export-csv-btn');
    const counterEl = root.querySelector('#petsync-filtered-count');
    const emptyStateEl = root.querySelector('#petsync-empty-state');
    const tbody = root.querySelector('#petsync-tbody') as HTMLElement | null;
    const mobileContainer = root.querySelector('#petsync-mobile-container') as HTMLElement | null;

    // State
    let activeStatus = 'active'; // 'active' | 'archived' | 'all'
    let activeSpecies = '';
    let activeLocation = '';
    let activeDuration = '';
    let searchQuery = '';
    let archivedInflated = false;

    async function ensureArchivedInflated() {
      // Prevent duplicate inflation: if already marked inflated or if archived elements exist in DOM
      if (
        archivedInflated ||
        (tbody && tbody.querySelector('.petsync-row[data-is-archived="true"]')) ||
        (mobileContainer && mobileContainer.querySelector('.petsync-mobile-card[data-is-archived="true"]'))
      ) {
        archivedInflated = true;
        return;
      }
      archivedInflated = true;

      const scriptEl = document.getElementById('petsync-archive-data');
      if (!scriptEl) return;

      let archivedList: any[] = [];
      try {
        archivedList = JSON.parse(scriptEl.textContent || '[]');
      } catch (e) {
        archivedList = [];
      }

      // If embedded archive data was empty, dynamically fetch from Directus
      if (archivedList.length === 0) {
        try {
          const liveRes = await fetch(
            'https://mchs-directus.livelyfield-d0a70609.eastus.azurecontainerapps.io/items/pets?filter[archived_at][_nnull]=true&limit=-1&sort=-archived_at'
          );
          if (liveRes.ok) {
            const liveData = await liveRes.json();
            if (Array.isArray(liveData.data)) {
              archivedList = liveData.data.map((p: any) => ({
                id: p.id,
                name: p.name,
                type: p.type,
                species_label: p.species_label,
                breed: p.breed,
                color: p.color,
                gender: p.gender,
                age: p.age,
                age_display: p.age_display,
                size: p.size,
                location: p.location,
                intake_date: p.intake_date,
                archived_at: p.archived_at,
                stage: p.stage,
                image: p.image_url || p.image || '/assets/recovered/images/placeholder.svg',
                url: p.url,
                description: p.description,
              }));
            }
          }
        } catch (fetchErr) {
          console.warn('[PetSync] Live fetch for archived pets failed:', fetchErr);
        }
      }

      if (archivedList.length === 0) return;

      try {
        const tableFragment = document.createDocumentFragment();
        const mobileFragment = document.createDocumentFragment();

        // Track existing IDs so we never add duplicate records
        const existingTablePetIds = new Set<string>();
        if (tbody) {
          tbody.querySelectorAll<HTMLElement>('.petsync-row').forEach((r) => {
            const pid = r.getAttribute('data-pet-id');
            if (pid) existingTablePetIds.add(pid);
          });
        }

        const existingMobilePetIds = new Set<string>();
        if (mobileContainer) {
          mobileContainer.querySelectorAll<HTMLElement>('.petsync-mobile-card').forEach((c) => {
            const pid = c.getAttribute('data-pet-id');
            if (pid) existingMobilePetIds.add(pid);
          });
        }

        archivedList.forEach((pet) => {
          const petIdStr = String(pet.id);
          const daysAtShelter = pet.intake_date
            ? Math.floor((Date.now() - new Date(pet.intake_date).getTime()) / 86400000)
            : null;
          const photoUrl = pet.image || '/assets/recovered/images/placeholder.svg';
          const petPointUrl =
            (pet.url && !/authkey=/i.test(pet.url)) ? pet.url : `/adopt/${encodeURIComponent(pet.id)}`;
          const formattedIntake = pet.intake_date
            ? new Date(pet.intake_date).toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric',
              })
            : '—';

          const petInfoStr = JSON.stringify({
            id: pet.id,
            name: pet.name,
            type: pet.type,
            species_label: pet.species_label,
            breed: pet.breed,
            age: pet.age,
            age_display: pet.age_display,
            size: pet.size,
            color: pet.color,
            gender: pet.gender,
            location: pet.location,
            image: photoUrl,
            intake_date: pet.intake_date,
            days_at_shelter: daysAtShelter,
            description: pet.description,
          }).replace(/'/g, '&#39;');

          // 1. Desktop Table Row (strictly deduplicated)
          if (tbody && !existingTablePetIds.has(petIdStr)) {
            existingTablePetIds.add(petIdStr);
            const tr = document.createElement('tr');
            tr.className = 'hover:bg-slate-50/80 transition petsync-row';
            tr.setAttribute('data-is-archived', 'true');
            tr.setAttribute('data-species', pet.type || '');
            tr.setAttribute('data-location', pet.location || '');
            tr.setAttribute(
              'data-search',
              `${pet.id} ${pet.name} ${pet.breed} ${pet.color || ''} ${pet.location || ''} ${pet.gender}`.toLowerCase()
            );
            tr.setAttribute('data-pet-id', petIdStr);
            tr.setAttribute('data-pet-name', pet.name);
            tr.setAttribute('data-pet-breed', pet.breed);
            tr.setAttribute('data-pet-species', pet.species_label || pet.type);
            tr.setAttribute('data-intake-date', pet.intake_date || '');
            tr.setAttribute('data-days-at-shelter', daysAtShelter !== null ? String(daysAtShelter) : '');

            tr.innerHTML = `
              <td class="py-2 px-3">
                <div class="w-11 h-11 rounded-lg overflow-hidden bg-slate-100 border border-slate-200 flex-shrink-0 relative group">
                  <img
                    src="${photoUrl}"
                    alt="${pet.name}"
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-110 transition duration-200"
                    onerror="this.src='/assets/recovered/images/placeholder.svg'"
                  />
                </div>
              </td>
              <td class="py-2 px-3 whitespace-nowrap">
                <span class="font-mono font-bold text-slate-900 block">${pet.id}</span>
                <a
                  href="${petPointUrl}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-0.5 text-[10px] font-bold text-teal-700 hover:text-teal-900 hover:underline mt-0.5"
                  title="Open official PetPoint WebServices details popup"
                >
                  Open PetPoint ↗
                </a>
              </td>
              <td class="py-2 px-3">
                <div class="font-bold text-slate-900 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full ${pet.type === 'dog' ? 'bg-amber-500' : pet.type === 'cat' ? 'bg-teal-500' : 'bg-slate-400'} inline-block mr-1"></span>
                  <span class="text-sm">${pet.name}</span>
                </div>
                <span class="text-[10px] text-slate-400 block uppercase tracking-wider font-semibold">
                  ${pet.species_label || pet.type}
                </span>
              </td>
              <td class="py-2 px-3">
                <span class="text-slate-800 font-medium block truncate max-w-xs" title="${pet.breed}">
                  ${pet.breed}
                </span>
                ${pet.color ? `<span class="text-[11px] text-slate-500 block">Color: ${pet.color}</span>` : ''}
              </td>
              <td class="py-2 px-3 whitespace-nowrap">
                <span class="font-medium text-slate-800 block">
                  ${pet.gender === 'female' ? '♀ Female' : pet.gender === 'male' ? '♂ Male' : 'Unknown'}
                </span>
                <span class="text-[11px] text-slate-500 block">${pet.age_display || pet.age || 'Adult'}</span>
              </td>
              <td class="py-2 px-3 whitespace-nowrap">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-700 border border-slate-200">
                  ${pet.location || 'Shelter'}
                </span>
              </td>
              <td class="py-2 px-3 whitespace-nowrap">
                <span class="text-slate-800 font-medium block">${formattedIntake}</span>
                ${daysAtShelter !== null ? `<span class="text-[10px] font-semibold text-slate-500">${daysAtShelter} days in care</span>` : ''}
              </td>
              <td class="py-2 px-3 whitespace-nowrap">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-purple-100 text-purple-800 border border-purple-200">
                  Archived / Adopted
                </span>
              </td>
              <td class="py-2 px-3 text-right whitespace-nowrap">
                <div class="flex items-center justify-end gap-1.5">
                  <button
                    type="button"
                    class="petsync-print-card-btn inline-flex items-center gap-1 px-2 py-1 rounded text-[11px] font-semibold bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-300 transition cursor-pointer"
                    data-pet-info='${petInfoStr}'
                    title="Print official cage card for this animal"
                  >
                    Print Card
                  </button>
                  <a
                    href="${petPointUrl}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 px-2 py-1 rounded text-[11px] font-semibold bg-teal-50 hover:bg-teal-100 text-teal-800 border border-teal-200 transition"
                  >
                    PetPoint ↗
                  </a>
                </div>
              </td>
            `;
            tableFragment.appendChild(tr);
          }

          // 2. Mobile Card (strictly deduplicated)
          if (mobileContainer && !existingMobilePetIds.has(petIdStr)) {
            existingMobilePetIds.add(petIdStr);
            const card = document.createElement('div');
            card.className = 'petsync-mobile-card bg-white rounded-xl border border-slate-200 shadow-xs p-3.5 space-y-3 transition';
            card.setAttribute('data-is-archived', 'true');
            card.setAttribute('data-pet-id', petIdStr);
            card.setAttribute('data-species', pet.type || '');
            card.setAttribute('data-location', pet.location || '');
            card.setAttribute(
              'data-search',
              `${pet.id} ${pet.name} ${pet.breed} ${pet.color || ''} ${pet.location || ''} ${pet.gender}`.toLowerCase()
            );
            card.setAttribute('data-days-at-shelter', daysAtShelter !== null ? String(daysAtShelter) : '');

            const genderText = pet.gender === 'female' ? '♀ Female' : pet.gender === 'male' ? '♂ Male' : 'Unknown';
            const speciesIcon = pet.type === 'dog' ? '<span class="w-2 h-2 rounded-full bg-amber-500 inline-block mr-1"></span>' : pet.type === 'cat' ? '<span class="w-2 h-2 rounded-full bg-teal-500 inline-block mr-1"></span>' : '<span class="w-2 h-2 rounded-full bg-slate-400 inline-block mr-1"></span>';

            card.innerHTML = `
              <div class="flex items-start gap-3">
                <div class="w-16 h-16 rounded-xl overflow-hidden bg-slate-100 border border-slate-200 shrink-0 relative">
                  <img
                    src="${photoUrl}"
                    alt="${pet.name}"
                    loading="lazy"
                    class="w-full h-full object-cover"
                    onerror="this.src='/assets/recovered/images/placeholder.svg'"
                  />
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between gap-1">
                    <h3 class="text-base font-bold text-slate-900 truncate flex items-center gap-1.5">
                      <span>${speciesIcon}</span>
                      <span>${pet.name}</span>
                    </h3>
                    <span class="font-mono font-bold text-[11px] text-slate-600 bg-slate-100 px-1.5 py-0.5 rounded flex items-center gap-1 shrink-0 border border-slate-200">
                      #${pet.id}
                      <button
                        type="button"
                        class="copy-pet-id-btn text-slate-400 hover:text-teal-700 cursor-pointer"
                        title="Copy ID"
                        data-copy-id="${pet.id}"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                          <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
                        </svg>
                      </button>
                    </span>
                  </div>
                  <p class="text-xs text-slate-600 truncate mt-0.5">${pet.breed}</p>
                  <div class="flex flex-wrap items-center gap-1.5 mt-1.5 text-[11px]">
                    <span class="text-slate-500">${genderText}</span>
                    <span class="text-slate-300">·</span>
                    <span class="text-slate-500">${pet.age_display || pet.age || 'Adult'}</span>
                    <span class="text-slate-300">·</span>
                    <span class="text-slate-700 font-medium">${pet.location || 'Shelter'}</span>
                  </div>
                </div>
              </div>

              <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-slate-100 text-[11px]">
                <div>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-md font-semibold border text-[10px] bg-purple-100 text-purple-800 border-purple-200">
                    Archived / Adopted
                  </span>
                </div>
                <div class="flex items-center gap-1.5">
                  <button
                    type="button"
                    class="petsync-print-card-btn inline-flex items-center gap-1 px-2.5 py-1 rounded text-xs font-semibold bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-300 transition cursor-pointer"
                    data-pet-info='${petInfoStr}'
                  >
                    Print Card
                  </button>
                  <a
                    href="${petPointUrl}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 px-2.5 py-1 rounded text-xs font-semibold bg-teal-50 hover:bg-teal-100 text-teal-800 border border-teal-200 transition"
                  >
                    PetPoint ↗
                  </a>
                </div>
              </div>
            `;
            mobileFragment.appendChild(card);
          }
        });

        if (tbody) tbody.appendChild(tableFragment);
        if (mobileContainer) mobileContainer.appendChild(mobileFragment);
        applyFilters();
      } catch (e) {
        console.warn('Failed to inflate archived pet data:', e);
      }
    }

    const updateSpeciesCounts = () => {
      let totalForStatus = 0;
      let dogsForStatus = 0;
      let catsForStatus = 0;
      let othersForStatus = 0;
      let longStayForStatus = 0;

      const seenPetIds = new Set<string>();
      const currentRows = tbody ? tbody.querySelectorAll<HTMLElement>('.petsync-row') : root.querySelectorAll<HTMLElement>('tr.petsync-row');
      currentRows.forEach((row) => {
        const petId = row.getAttribute('data-pet-id');
        if (petId) {
          if (seenPetIds.has(petId)) return;
          seenPetIds.add(petId);
        }

        const isArchived = row.getAttribute('data-is-archived') === 'true';
        let matchesStatus = true;
        if (activeStatus === 'active') matchesStatus = !isArchived;
        else if (activeStatus === 'archived') matchesStatus = isArchived;

        if (matchesStatus) {
          totalForStatus++;
          const species = (row.getAttribute('data-species') || '').toLowerCase();
          const daysStr = row.getAttribute('data-days-at-shelter');
          const days = daysStr ? parseInt(daysStr, 10) : null;
          if (days !== null && days > 60) longStayForStatus++;

          if (species === 'dog') dogsForStatus++;
          else if (species === 'cat') catsForStatus++;
          else othersForStatus++;
        }
      });

      const countAll = root.querySelector('#species-count-all');
      const countDog = root.querySelector('#species-count-dog');
      const countCat = root.querySelector('#species-count-cat');
      const countOther = root.querySelector('#species-count-other');
      const countLongStay = root.querySelector('#species-count-longstay');

      if (countAll) countAll.textContent = String(totalForStatus);
      if (countDog) countDog.textContent = String(dogsForStatus);
      if (countCat) countCat.textContent = String(catsForStatus);
      if (countOther) countOther.textContent = String(othersForStatus);
      if (countLongStay) countLongStay.textContent = String(longStayForStatus);
    };

    const applyFilters = () => {
      let visibleDesktop = 0;
      let visibleMobile = 0;
      const currentItems = root.querySelectorAll<HTMLElement>('.petsync-row, .petsync-mobile-card');

      currentItems.forEach((item) => {
        const isArchived = item.getAttribute('data-is-archived') === 'true';
        const species = item.getAttribute('data-species') || '';
        const location = item.getAttribute('data-location') || '';
        const searchContent = item.getAttribute('data-search') || '';
        const daysStr = item.getAttribute('data-days-at-shelter');
        const days = daysStr ? parseInt(daysStr, 10) : null;

        // Status filter
        let matchesStatus = true;
        if (activeStatus === 'active') matchesStatus = !isArchived;
        else if (activeStatus === 'archived') matchesStatus = isArchived;

        // Species filter
        let matchesSpecies = true;
        if (activeSpecies === 'longstay') {
          matchesSpecies = days !== null && days > 60;
        } else if (activeSpecies) {
          matchesSpecies = species === activeSpecies;
        }

        // Placement filter ('shelter' vs 'foster')
        let matchesLocation = true;
        if (activeLocation === 'foster') {
          matchesLocation = location.toLowerCase().includes('foster');
        } else if (activeLocation === 'shelter') {
          matchesLocation = !location.toLowerCase().includes('foster');
        }

        // Duration filter
        let matchesDuration = true;
        if (activeDuration && days !== null) {
          if (activeDuration === 'new') matchesDuration = days <= 14;
          else if (activeDuration === 'standard') matchesDuration = days > 14 && days <= 60;
          else if (activeDuration === 'long') matchesDuration = days > 60 && days <= 180;
          else if (activeDuration === 'urgent') matchesDuration = days > 180;
        } else if (activeDuration && days === null) {
          matchesDuration = false;
        }

        // Search query
        let matchesSearch = true;
        if (searchQuery.trim()) {
          matchesSearch = searchContent.includes(searchQuery.toLowerCase().trim());
        }

        if (matchesStatus && matchesSpecies && matchesLocation && matchesDuration && matchesSearch) {
          item.style.display = '';
          if (item.classList.contains('petsync-row')) visibleDesktop++;
          else visibleMobile++;
        } else {
          item.style.display = 'none';
        }
      });

      const count = visibleDesktop > 0 ? visibleDesktop : visibleMobile;

      if (counterEl) counterEl.textContent = count.toString();
      if (emptyStateEl) {
        if (count === 0) emptyStateEl.classList.remove('hidden');
        else emptyStateEl.classList.add('hidden');
      }

      updateSpeciesCounts();
    };

    // Species 1-Tap Pills
    speciesPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const val = pill.getAttribute('data-species-pill') || '';
        activeSpecies = val;

        speciesPills.forEach((p) => {
          p.classList.remove('active', 'bg-[#173a39]', 'text-white');
          p.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
        });
        pill.classList.add('active', 'bg-[#173a39]', 'text-white');
        pill.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200');

        applyFilters();
      });
    });

    // Status Pills (Active, Archived, All)
    statusPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const val = pill.getAttribute('data-status-filter') || 'active';
        activeStatus = val;

        statusPills.forEach((p) => {
          p.classList.remove('active', 'bg-[#173a39]', 'text-white');
          p.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
        });
        pill.classList.add('active', 'bg-[#173a39]', 'text-white');
        pill.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200');

        if (val === 'archived' || val === 'all') {
          ensureArchivedInflated();
        }

        applyFilters();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value;
        if (searchQuery.trim().length > 1) {
          ensureArchivedInflated();
        }
        applyFilters();
      });
    }

    if (locationFilter) {
      locationFilter.addEventListener('change', (e) => {
        activeLocation = (e.target as HTMLSelectElement).value;
        applyFilters();
      });
    }

    if (durationFilter) {
      durationFilter.addEventListener('change', (e) => {
        activeDuration = (e.target as HTMLSelectElement).value;
        applyFilters();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        activeStatus = 'active';
        activeSpecies = '';
        activeLocation = '';
        activeDuration = '';
        searchQuery = '';
        if (searchInput) (searchInput as HTMLInputElement).value = '';
        if (locationFilter) locationFilter.value = '';
        if (durationFilter) durationFilter.value = '';

        speciesPills.forEach((p) => {
          const isAll = (p.getAttribute('data-species-pill') || '') === '';
          if (isAll) {
            p.classList.add('active', 'bg-[#173a39]', 'text-white');
            p.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200');
          } else {
            p.classList.remove('active', 'bg-[#173a39]', 'text-white');
            p.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
          }
        });

        statusPills.forEach((p) => {
          const isAct = p.getAttribute('data-status-filter') === 'active';
          if (isAct) {
            p.classList.add('active', 'bg-[#173a39]', 'text-white');
            p.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200');
          } else {
            p.classList.remove('active', 'bg-[#173a39]', 'text-white');
            p.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
          }
        });

        applyFilters();
      });
    }

    // Export CSV (ensures archive is inflated first so all matching records are exported)
    if (exportBtn) {
      exportBtn.addEventListener('click', () => {
        ensureArchivedInflated();
        applyFilters();

        const currentRows = root.querySelectorAll<HTMLTableRowElement>('.petsync-row');
        const visibleRows = Array.from(currentRows).filter((r) => r.style.display !== 'none');
        const headers = ['Pet ID', 'Name', 'Species', 'Breed', 'Location', 'Intake Date', 'Days in Care', 'Status'];
        const csvRows = [headers.join(',')];
        const seenCsvIds = new Set<string>();

        visibleRows.forEach((row) => {
          const rawId = row.getAttribute('data-pet-id') || '';
          if (rawId && seenCsvIds.has(rawId)) return;
          if (rawId) seenCsvIds.add(rawId);

          const id = `"${rawId}"`;
          const name = `"${row.getAttribute('data-pet-name') || ''}"`;
          const species = `"${row.getAttribute('data-pet-species') || ''}"`;
          const breed = `"${(row.getAttribute('data-pet-breed') || '').replace(/"/g, '""')}"`;
          const loc = `"${row.getAttribute('data-location') || ''}"`;
          const intake = `"${row.getAttribute('data-intake-date') || ''}"`;
          const days = `"${row.getAttribute('data-days-at-shelter') || ''}"`;
          const status = row.getAttribute('data-is-archived') === 'true' ? '"Archived"' : '"Active"';

          csvRows.push([id, name, species, breed, loc, intake, days, status].join(','));
        });

        const blob = new Blob([csvRows.join('\n')], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `monroe-petsync-roster-${new Date().toISOString().slice(0, 10)}.csv`;
        a.click();
        URL.revokeObjectURL(url);
      });
    }

    // Kennel Card Print Modal Handling
    const modal = document.getElementById('kennel-card-modal');
    const closeBtn = document.getElementById('close-card-modal-btn');
    const printBtn = document.getElementById('trigger-print-btn');

    if (closeBtn && modal) {
      closeBtn.addEventListener('click', () => modal.classList.add('hidden'));
      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.classList.add('hidden');
      });
    }

    if (printBtn) {
      printBtn.addEventListener('click', () => window.print());
    }

    // Delegated click handler on root for Print Card buttons (handles active + dynamic archived rows)
    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.petsync-print-card-btn');
      if (!btn) return;
      e.stopPropagation();

      const raw = btn.getAttribute('data-pet-info');
      if (!raw) return;

      try {
        const info = JSON.parse(raw);

        // Populate printable elements
        const photoEl = document.getElementById('card-pet-photo') as HTMLImageElement | null;
        if (photoEl) photoEl.src = info.image || '/assets/recovered/images/placeholder.svg';

        const idEl = document.getElementById('card-pet-id');
        if (idEl) idEl.textContent = info.id || '00000000';

        const nameEl = document.getElementById('card-pet-name');
        if (nameEl) nameEl.textContent = info.name || 'Friend';

        const genderAgeEl = document.getElementById('card-pet-gender-age');
        if (genderAgeEl) {
          const gender = info.gender === 'female' ? 'Female' : info.gender === 'male' ? 'Male' : 'Unknown';
          genderAgeEl.textContent = `${gender} · ${info.age_display || info.age || 'Adult'}`;
        }

        const breedEl = document.getElementById('card-pet-breed');
        if (breedEl) breedEl.textContent = `${info.breed || 'Mixed'} (${info.type || 'Animal'})`;

        const sizeEl = document.getElementById('card-pet-size');
        if (sizeEl) sizeEl.textContent = info.size ? info.size[0].toUpperCase() + info.size.slice(1) : 'Medium';

        const colorEl = document.getElementById('card-pet-color');
        if (colorEl) colorEl.textContent = info.color || 'Standard';

        const intakeEl = document.getElementById('card-pet-intake');
        if (intakeEl) {
          const days = info.days_at_shelter !== null && info.days_at_shelter !== undefined ? `${info.days_at_shelter}d` : '';
          intakeEl.textContent = `${info.intake_date ? new Date(info.intake_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Recent'} ${days ? `(${days})` : ''}`;
        }

        const locEl = document.getElementById('card-kennel-location');
        if (locEl) locEl.textContent = `Location: ${info.location || 'Main Kennel'}`;

        const notesEl = document.getElementById('card-pet-notes');
        if (notesEl) {
          notesEl.textContent = info.description || 'Sweet, friendly companion ready for a forever home. Sociable and walked daily by volunteers.';
        }

        const urlEl = document.getElementById('card-direct-url');
        const adoptUrl = `https://monroe-humane.org/adopt/${info.id}`;
        if (urlEl) urlEl.textContent = adoptUrl;

        // Render high-contrast QR code
        const qrContainer = document.getElementById('card-qr-container');
        if (qrContainer) {
          qrContainer.innerHTML = '';
          const qrCode = new QRCodeStyling({
            width: 120,
            height: 120,
            type: 'svg',
            data: adoptUrl,
            margin: 4,
            qrOptions: { errorCorrectionLevel: 'H' },
            dotsOptions: { type: 'rounded', color: '#0f766e' },
            cornersSquareOptions: { type: 'extra-rounded', color: '#0f766e' },
            backgroundOptions: { color: '#ffffff' },
          });
          qrCode.append(qrContainer);
        }

        if (modal) modal.classList.remove('hidden');
      } catch (err) {
        console.error('Failed to prepare kennel card:', err);
      }
    });

    // Copy animal ID to clipboard
    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement)?.closest('.copy-pet-id-btn') as HTMLButtonElement | null;
      if (!btn) return;
      const id = btn.getAttribute('data-copy-id');
      if (!id) return;
      navigator.clipboard.writeText(id).then(() => {
        const originalHtml = btn.innerHTML;
        btn.innerHTML = `<span class="text-emerald-700 font-bold text-[9px]">✓</span>`;
        setTimeout(() => {
          btn.innerHTML = originalHtml;
        }, 1200);
      });
    });

    applyFilters();

    // Background live revalidation against Directus API
    async function revalidateLivePetSync() {
      try {
        const DIRECTUS_URL = 'https://mchs-directus.livelyfield-d0a70609.eastus.azurecontainerapps.io';
        const [activeMetaRes, archivedMetaRes] = await Promise.all([
          fetch(`${DIRECTUS_URL}/items/pets?filter[archived_at][_null]=true&limit=1&meta=filter_count`),
          fetch(`${DIRECTUS_URL}/items/pets?filter[archived_at][_nnull]=true&limit=1&meta=filter_count`),
        ]);

        if (activeMetaRes.ok && archivedMetaRes.ok) {
          const activeJson = await activeMetaRes.json();
          const archivedJson = await archivedMetaRes.json();
          const liveActiveCount = typeof activeJson.meta?.filter_count === 'number' ? activeJson.meta.filter_count : null;
          const liveArchivedCount = typeof archivedJson.meta?.filter_count === 'number' ? archivedJson.meta.filter_count : null;

          if (liveActiveCount !== null && liveArchivedCount !== null) {
            const liveTotal = liveActiveCount + liveArchivedCount;

            const liveBadge = document.getElementById('petsync-live-badge');
            if (liveBadge) {
              liveBadge.textContent = 'Live Directus Feed: Synced';
              liveBadge.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-teal-100 text-teal-900 border border-teal-300';
            }
            const activeBadge = document.getElementById('petsync-active-count-badge');
            if (activeBadge) activeBadge.textContent = `${liveActiveCount} pets`;

            const archivedBadge = document.getElementById('petsync-archived-count-badge');
            if (archivedBadge) archivedBadge.textContent = `${liveArchivedCount} pets`;

            const totalBadge = document.getElementById('petsync-total-count-badge');
            if (totalBadge) totalBadge.textContent = `${liveTotal} pets`;

            const pillActive = document.getElementById('petsync-pill-active-count');
            if (pillActive) pillActive.textContent = String(liveActiveCount);

            const pillArchived = document.getElementById('petsync-pill-archived-count');
            if (pillArchived) pillArchived.textContent = String(liveArchivedCount);

            const pillAll = document.getElementById('petsync-pill-all-count');
            if (pillAll) pillAll.textContent = String(liveTotal);
          }
        }
      } catch (err) {
        console.debug('[PetSync] Background revalidation completed with build-time cache fallback.');
      }
    }

    revalidateLivePetSync();
  }

  if (document.readyState !== 'loading') {
    initPetSyncPortal();
  } else {
    document.addEventListener('DOMContentLoaded', initPetSyncPortal);
  }
  document.addEventListener('astro:page-load', initPetSyncPortal);
</script>
