---
import PrintableKennelCardModal from './PrintableKennelCardModal.astro';

const totalServed2026 = 527;
const ytdAdoptions = 440;
const dailyCareCost = '3.87';
---

<div class="space-y-6" id="petsync-portal-root">
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
    <div class="bg-white rounded-xl border border-slate-200 p-3">
      <div class="text-xs text-slate-500">Active</div>
      <div id="petsync-active-count-badge" class="mt-1 font-mono font-bold text-lg text-slate-900">--</div>
    </div>
    <div class="bg-white rounded-xl border border-slate-200 p-3">
      <div class="text-xs text-slate-500">Archived</div>
      <div id="petsync-archived-count-badge" class="mt-1 font-mono font-bold text-lg text-slate-900">--</div>
    </div>
    <div class="bg-white rounded-xl border border-slate-200 p-3">
      <div class="text-xs text-slate-500">Total</div>
      <div id="petsync-total-count-badge" class="mt-1 font-mono font-bold text-lg text-slate-900">--</div>
    </div>
    <div class="bg-white rounded-xl border border-slate-200 p-3">
      <div class="text-xs text-slate-500">Last sync</div>
      <div id="petsync-last-sync" class="mt-1 text-sm text-slate-900 truncate" title="">
        --
      </div>
      <span id="petsync-live-badge" class="hidden">RUNNING</span>
    </div>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
    <div class="bg-white rounded-xl border border-slate-200 p-3">
      <div class="text-xs text-slate-500">2026 served</div>
      <div class="mt-1 font-mono font-bold text-lg text-slate-900">{totalServed2026}</div>
      <div class="text-xs text-slate-500">{ytdAdoptions} adopted</div>
    </div>
    <div class="bg-white rounded-xl border border-slate-200 p-3">
      <div class="text-xs text-slate-500">Avg stay</div>
      <div id="petsync-avg-stay" class="mt-1 font-mono font-bold text-lg text-slate-900">--</div>
      <div id="petsync-avg-stay-detail" class="text-xs text-slate-500">Dogs -- · cats --</div>
    </div>
    <div class="bg-white rounded-xl border border-slate-200 p-3">
      <div class="text-xs text-slate-500">Care / day</div>
      <div class="mt-1 font-mono font-bold text-lg text-slate-900">${dailyCareCost}</div>
    </div>
    <div class="bg-white rounded-xl border border-slate-200 p-3">
      <div class="text-xs text-slate-500">&gt;60 days</div>
      <div id="petsync-longstay-count" class="mt-1 font-mono font-bold text-lg text-slate-900">--</div>
    </div>
  </div>

  <!-- Main Roster Explorer -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-xs p-5 space-y-4">
    <!-- Filter Bar & Search -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 bg-slate-50 p-3 rounded-lg border border-slate-200">
      <!-- Status Filter Tabs -->
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="sr-only">Roster</span>
        <button
          type="button"
          data-status-filter="active"
          id="petsync-pill-active"
          class="petsync-status-pill active px-3 py-1 rounded-md font-semibold bg-[#173a39] text-white transition shadow-xs"
        >
          Active (<span id="petsync-pill-active-count">--</span>)
        </button>
        <button
          type="button"
          data-status-filter="archived"
          id="petsync-pill-archived"
          class="petsync-status-pill px-3 py-1 rounded-md font-semibold bg-white border border-slate-200 text-purple-800 hover:bg-purple-50 transition"
        >
          Archived / Past (<span id="petsync-pill-archived-count">--</span>)
        </button>
        <button
          type="button"
          data-status-filter="all"
          id="petsync-pill-all"
          class="petsync-status-pill px-3 py-1 rounded-md font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 transition"
        >
          All Tracked (<span id="petsync-pill-all-count">--</span>)
        </button>
      </div>

      <!-- Quick Action Controls -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="export-csv-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold bg-white border border-slate-300 text-slate-700 hover:bg-slate-100 transition shadow-xs"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Export CSV
        </button>
      </div>
    </div>

    <!-- Quick 1-Tap Species Filter Pills -->
    <div class="flex flex-wrap items-center gap-1.5 text-xs pb-1">
      <span class="text-[11px] font-semibold text-slate-500 mr-1">Quick Species:</span>
      <button
        type="button"
        data-species-pill=""
        class="petsync-species-btn active px-3 py-1 rounded-md font-semibold bg-[#173a39] text-white transition shadow-xs"
      >
        All (<span id="species-count-all">--</span>)
      </button>
      <button
        type="button"
        data-species-pill="dog"
        class="petsync-species-btn px-3 py-1 rounded-md font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 inline-block mr-1"></span> Dogs (<span id="species-count-dog">--</span>)
      </button>
      <button
        type="button"
        data-species-pill="cat"
        class="petsync-species-btn px-3 py-1 rounded-md font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-teal-500 inline-block mr-1"></span> Cats (<span id="species-count-cat">--</span>)
      </button>
      <button
        type="button"
        data-species-pill="other"
        class="petsync-species-btn px-3 py-1 rounded-md font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-slate-400 inline-block mr-1"></span> Other (<span id="species-count-other">--</span>)
      </button>
      <span class="text-slate-300 mx-1">|</span>
      <button
        type="button"
        data-species-pill="longstay"
        id="petsync-longstay-btn"
        class="petsync-species-btn px-3 py-1 rounded-md font-semibold bg-amber-50 border border-amber-300 text-amber-900 hover:bg-amber-100 transition shadow-xs flex items-center gap-1.5"
      >
        <span class="inline-flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>Long Stay (&gt;60d)</span>
        </span>
        <span class="px-1.5 py-0.2 rounded-full bg-amber-200 text-amber-900 text-[10px] font-bold" id="species-count-longstay">
          --
        </span>
      </button>
    </div>

    <!-- Secondary Filters: Placement, Stay Duration & Search -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-2 text-xs">
      <!-- Search (2 cols on md) -->
      <div class="relative sm:col-span-2 md:col-span-2">
        <div class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none text-slate-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
        <input
          type="text"
          id="petsync-search-input"
          placeholder="Search name, ID, breed, color, foster..."
          class="w-full pl-8 pr-3 py-1.5 text-xs rounded-md border border-slate-300 bg-white text-slate-800 placeholder-slate-400 focus:outline-hidden focus:ring-1 focus:ring-[#173a39] focus:border-[#173a39]"
        />
      </div>

      <!-- Placement Filter (Shelter vs Foster) -->
      <div>
        <select
          id="petsync-location-filter"
          class="w-full py-1.5 px-2.5 text-xs rounded-md border border-slate-300 bg-white text-slate-800 focus:outline-hidden focus:ring-1 focus:ring-[#173a39]"
        >
          <option value="">All Placements</option>
          <option value="shelter">Shelter Facility (On-Site)</option>
          <option value="foster">In Foster Care</option>
        </select>
      </div>

      <!-- Stay Duration Filter -->
      <div>
        <select
          id="petsync-duration-filter"
          class="w-full py-1.5 px-2.5 text-xs rounded-md border border-slate-300 bg-white text-slate-800 focus:outline-hidden focus:ring-1 focus:ring-[#173a39]"
        >
          <option value="">All Stay Durations</option>
          <option value="new">New Intakes (&lt; 14 days)</option>
          <option value="standard">Standard Care (14 - 60 days)</option>
          <option value="long">Long-Stay (60 - 180 days)</option>
          <option value="urgent">Urgent Foster (&gt; 180 days)</option>
        </select>
      </div>

      <!-- Reset -->
      <div>
        <button
          type="button"
          id="petsync-reset-btn"
          class="w-full py-1.5 px-3 text-xs rounded-md border border-slate-200 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold transition"
        >
          Reset Filters
        </button>
      </div>
    </div>

    <!-- Live Counter -->
    <div class="flex items-center justify-between text-xs text-slate-500 px-1">
      <div>
        Showing <span id="petsync-filtered-count" class="font-bold text-slate-800">--</span> of <span id="petsync-showing-total">--</span> total animals
      </div>
      <div class="text-[11px] text-slate-400">
        Click PetPoint link to open PetPoint WebServices record
      </div>
    </div>

    <!-- Desktop Roster Table -->
    <div class="hidden md:block border border-slate-200 rounded-lg overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-slate-100/80 text-slate-700 font-semibold border-b border-slate-200">
            <th class="py-2.5 px-3 w-14">Photo</th>
            <th class="py-2.5 px-3">Pet ID & PetPoint</th>
            <th class="py-2.5 px-3">Name & Species</th>
            <th class="py-2.5 px-3">Breed & Color</th>
            <th class="py-2.5 px-3">Sex & Age</th>
            <th class="py-2.5 px-3">Location</th>
            <th class="py-2.5 px-3">Intake & Days</th>
            <th class="py-2.5 px-3">Status</th>
            <th class="py-2.5 px-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="petsync-tbody" class="divide-y divide-slate-100">
          <tr id="petsync-loading-row">
            <td colspan="9" class="py-10 text-center text-slate-500">Loading shelter census…</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Mobile Animal Roster (Card View) -->
    <div id="petsync-mobile-container" class="md:hidden space-y-3">
      <p id="petsync-mobile-loading" class="text-center text-slate-500 py-6">Loading shelter census…</p>
    </div>

    <!-- Empty State -->
    <div id="petsync-empty-state" class="hidden text-center py-10 text-slate-500 bg-slate-50 rounded-lg border border-dashed border-slate-300">
      <p class="font-semibold text-slate-700">No animals match your search or filter</p>
      <p class="text-xs text-slate-400 mt-1">Try resetting the filters or clearing the search query.</p>
    </div>
  </div>

  <!-- Printable Kennel Card Modal -->
  <PrintableKennelCardModal />
</div>

<script>
  import QRCodeStyling from 'qr-code-styling';
  import { loadStaffPetRoster } from '../../lib/petsync-roster';

  function initPetSyncPortal() {
    const root = document.getElementById('petsync-portal-root');
    if (!root) return;
    if ((root as any).__petsync_initialized) return;
    (root as any).__petsync_initialized = true;

    // Image fallback listener for pets with failed thumbnails
    root.addEventListener('error', (e) => {
      const target = e.target as HTMLImageElement | null;
      if (target && target.tagName === 'IMG' && target.hasAttribute('data-fallback')) {
        const fallback = target.getAttribute('data-fallback');
        target.removeAttribute('data-fallback');
        if (fallback) target.src = fallback;
      }
    }, true);

    // Filter controls and DOM elements
    const statusPills = root.querySelectorAll<HTMLButtonElement>('.petsync-status-pill');
    const speciesPills = root.querySelectorAll<HTMLButtonElement>('.petsync-species-btn');
    const searchInput = root.querySelector<HTMLInputElement>('#petsync-search-input');
    const locationFilter = root.querySelector('#petsync-location-filter') as HTMLSelectElement | null;
    const durationFilter = root.querySelector('#petsync-duration-filter') as HTMLSelectElement | null;
    const resetBtn = root.querySelector('#petsync-reset-btn');
    const exportBtn = root.querySelector('#export-csv-btn');
    const counterEl = root.querySelector('#petsync-filtered-count');
    const emptyStateEl = root.querySelector('#petsync-empty-state');
    const tbody = root.querySelector('#petsync-tbody') as HTMLElement | null;
    const mobileContainer = root.querySelector('#petsync-mobile-container') as HTMLElement | null;

    // State
    let activeStatus = 'active'; // 'active' | 'archived' | 'all'
    let activeSpecies = '';
    let activeLocation = '';
    let activeDuration = '';
    let searchQuery = '';
    let archivedInflated = false;

    async function ensureArchivedInflated() {
      if (archivedInflated) return;
      archivedInflated = true;
      const ok = await loadStaffPetRoster(tbody, mobileContainer);
      if (!ok) archivedInflated = false;
    }

    const updateSpeciesCounts = () => {
      let totalForStatus = 0;
      let dogsForStatus = 0;
      let catsForStatus = 0;
      let othersForStatus = 0;
      let longStayForStatus = 0;

      const seenPetIds = new Set<string>();
      const currentRows = tbody ? tbody.querySelectorAll<HTMLElement>('.petsync-row') : root.querySelectorAll<HTMLElement>('tr.petsync-row');
      currentRows.forEach((row) => {
        const petId = row.getAttribute('data-pet-id');
        if (petId) {
          if (seenPetIds.has(petId)) return;
          seenPetIds.add(petId);
        }

        const isArchived = row.getAttribute('data-is-archived') === 'true';
        let matchesStatus = true;
        if (activeStatus === 'active') matchesStatus = !isArchived;
        else if (activeStatus === 'archived') matchesStatus = isArchived;

        if (matchesStatus) {
          totalForStatus++;
          const species = (row.getAttribute('data-species') || '').toLowerCase();
          const daysStr = row.getAttribute('data-days-at-shelter');
          const days = daysStr ? parseInt(daysStr, 10) : null;
          if (days !== null && days > 60) longStayForStatus++;

          if (species === 'dog') dogsForStatus++;
          else if (species === 'cat') catsForStatus++;
          else othersForStatus++;
        }
      });

      const countAll = root.querySelector('#species-count-all');
      const countDog = root.querySelector('#species-count-dog');
      const countCat = root.querySelector('#species-count-cat');
      const countOther = root.querySelector('#species-count-other');
      const countLongStay = root.querySelector('#species-count-longstay');

      if (countAll) countAll.textContent = String(totalForStatus);
      if (countDog) countDog.textContent = String(dogsForStatus);
      if (countCat) countCat.textContent = String(catsForStatus);
      if (countOther) countOther.textContent = String(othersForStatus);
      if (countLongStay) countLongStay.textContent = String(longStayForStatus);
    };

    const applyFilters = () => {
      let visibleDesktop = 0;
      let visibleMobile = 0;
      const currentItems = root.querySelectorAll<HTMLElement>('.petsync-row, .petsync-mobile-card');

      currentItems.forEach((item) => {
        const isArchived = item.getAttribute('data-is-archived') === 'true';
        const species = item.getAttribute('data-species') || '';
        const location = item.getAttribute('data-location') || '';
        const searchContent = item.getAttribute('data-search') || '';
        const daysStr = item.getAttribute('data-days-at-shelter');
        const days = daysStr ? parseInt(daysStr, 10) : null;

        // Status filter
        let matchesStatus = true;
        if (activeStatus === 'active') matchesStatus = !isArchived;
        else if (activeStatus === 'archived') matchesStatus = isArchived;

        // Species filter
        let matchesSpecies = true;
        if (activeSpecies === 'longstay') {
          matchesSpecies = days !== null && days > 60;
        } else if (activeSpecies) {
          matchesSpecies = species === activeSpecies;
        }

        // Placement filter ('shelter' vs 'foster')
        let matchesLocation = true;
        if (activeLocation === 'foster') {
          matchesLocation = location.toLowerCase().includes('foster');
        } else if (activeLocation === 'shelter') {
          matchesLocation = !location.toLowerCase().includes('foster');
        }

        // Duration filter
        let matchesDuration = true;
        if (activeDuration && days !== null) {
          if (activeDuration === 'new') matchesDuration = days <= 14;
          else if (activeDuration === 'standard') matchesDuration = days > 14 && days <= 60;
          else if (activeDuration === 'long') matchesDuration = days > 60 && days <= 180;
          else if (activeDuration === 'urgent') matchesDuration = days > 180;
        } else if (activeDuration && days === null) {
          matchesDuration = false;
        }

        // Search query
        let matchesSearch = true;
        if (searchQuery.trim()) {
          matchesSearch = searchContent.includes(searchQuery.toLowerCase().trim());
        }

        if (matchesStatus && matchesSpecies && matchesLocation && matchesDuration && matchesSearch) {
          item.style.display = '';
          if (item.classList.contains('petsync-row')) visibleDesktop++;
          else visibleMobile++;
        } else {
          item.style.display = 'none';
        }
      });

      const count = visibleDesktop > 0 ? visibleDesktop : visibleMobile;

      if (counterEl) counterEl.textContent = count.toString();
      if (emptyStateEl) {
        if (count === 0) emptyStateEl.classList.remove('hidden');
        else emptyStateEl.classList.add('hidden');
      }

      updateSpeciesCounts();
    };

    // Species 1-Tap Pills
    speciesPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const val = pill.getAttribute('data-species-pill') || '';
        activeSpecies = val;

        speciesPills.forEach((p) => {
          p.classList.remove('active', 'bg-[#173a39]', 'text-white');
          p.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
        });
        pill.classList.add('active', 'bg-[#173a39]', 'text-white');
        pill.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200');

        applyFilters();
      });
    });

    // Status Pills (Active, Archived, All)
    statusPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const val = pill.getAttribute('data-status-filter') || 'active';
        activeStatus = val;

        statusPills.forEach((p) => {
          p.classList.remove('active', 'bg-[#173a39]', 'text-white');
          p.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
        });
        pill.classList.add('active', 'bg-[#173a39]', 'text-white');
        pill.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200');

        if (val === 'archived' || val === 'all') {
          ensureArchivedInflated();
        }

        applyFilters();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value;
        if (searchQuery.trim().length > 1) {
          ensureArchivedInflated();
        }
        applyFilters();
      });
    }

    if (locationFilter) {
      locationFilter.addEventListener('change', (e) => {
        activeLocation = (e.target as HTMLSelectElement).value;
        applyFilters();
      });
    }

    if (durationFilter) {
      durationFilter.addEventListener('change', (e) => {
        activeDuration = (e.target as HTMLSelectElement).value;
        applyFilters();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        activeStatus = 'active';
        activeSpecies = '';
        activeLocation = '';
        activeDuration = '';
        searchQuery = '';
        if (searchInput) (searchInput as HTMLInputElement).value = '';
        if (locationFilter) locationFilter.value = '';
        if (durationFilter) durationFilter.value = '';

        speciesPills.forEach((p) => {
          const isAll = (p.getAttribute('data-species-pill') || '') === '';
          if (isAll) {
            p.classList.add('active', 'bg-[#173a39]', 'text-white');
            p.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200');
          } else {
            p.classList.remove('active', 'bg-[#173a39]', 'text-white');
            p.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
          }
        });

        statusPills.forEach((p) => {
          const isAct = p.getAttribute('data-status-filter') === 'active';
          if (isAct) {
            p.classList.add('active', 'bg-[#173a39]', 'text-white');
            p.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200');
          } else {
            p.classList.remove('active', 'bg-[#173a39]', 'text-white');
            p.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
          }
        });

        applyFilters();
      });
    }

    // Export CSV (ensures archive is inflated first so all matching records are exported)
    if (exportBtn) {
      exportBtn.addEventListener('click', () => {
        ensureArchivedInflated();
        applyFilters();

        const currentRows = root.querySelectorAll<HTMLTableRowElement>('.petsync-row');
        const visibleRows = Array.from(currentRows).filter((r) => r.style.display !== 'none');
        const headers = ['Pet ID', 'Name', 'Species', 'Breed', 'Location', 'Intake Date', 'Days in Care', 'Status'];
        const csvRows = [headers.join(',')];
        const seenCsvIds = new Set<string>();

        visibleRows.forEach((row) => {
          const rawId = row.getAttribute('data-pet-id') || '';
          if (rawId && seenCsvIds.has(rawId)) return;
          if (rawId) seenCsvIds.add(rawId);

          const id = `"${rawId}"`;
          const name = `"${row.getAttribute('data-pet-name') || ''}"`;
          const species = `"${row.getAttribute('data-pet-species') || ''}"`;
          const breed = `"${(row.getAttribute('data-pet-breed') || '').replace(/"/g, '""')}"`;
          const loc = `"${row.getAttribute('data-location') || ''}"`;
          const intake = `"${row.getAttribute('data-intake-date') || ''}"`;
          const days = `"${row.getAttribute('data-days-at-shelter') || ''}"`;
          const status = row.getAttribute('data-is-archived') === 'true' ? '"Archived"' : '"Active"';

          csvRows.push([id, name, species, breed, loc, intake, days, status].join(','));
        });

        const blob = new Blob([csvRows.join('\n')], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `monroe-petsync-roster-${new Date().toISOString().slice(0, 10)}.csv`;
        a.click();
        URL.revokeObjectURL(url);
      });
    }

    // Kennel Card Print Modal Handling
    const modal = document.getElementById('kennel-card-modal');
    const closeBtn = document.getElementById('close-card-modal-btn');
    const printBtn = document.getElementById('trigger-print-btn');

    if (closeBtn && modal) {
      closeBtn.addEventListener('click', () => modal.classList.add('hidden'));
      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.classList.add('hidden');
      });
    }

    if (printBtn) {
      printBtn.addEventListener('click', () => window.print());
    }

    // Delegated click handler on root for Print Card buttons (handles active + dynamic archived rows)
    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.petsync-print-card-btn');
      if (!btn) return;
      e.stopPropagation();

      const raw = btn.getAttribute('data-pet-info');
      if (!raw) return;

      try {
        const info = JSON.parse(raw);

        // Populate printable elements
        const photoEl = document.getElementById('card-pet-photo') as HTMLImageElement | null;
        if (photoEl) photoEl.src = info.image || '/assets/recovered/images/placeholder.svg';

        const idEl = document.getElementById('card-pet-id');
        if (idEl) idEl.textContent = info.id || '00000000';

        const nameEl = document.getElementById('card-pet-name');
        if (nameEl) nameEl.textContent = info.name || 'Friend';

        const genderAgeEl = document.getElementById('card-pet-gender-age');
        if (genderAgeEl) {
          const gender = info.gender === 'female' ? 'Female' : info.gender === 'male' ? 'Male' : 'Unknown';
          genderAgeEl.textContent = `${gender} · ${info.age_display || info.age || 'Adult'}`;
        }

        const breedEl = document.getElementById('card-pet-breed');
        if (breedEl) breedEl.textContent = `${info.breed || 'Mixed'} (${info.type || 'Animal'})`;

        const sizeEl = document.getElementById('card-pet-size');
        if (sizeEl) sizeEl.textContent = info.size ? info.size[0].toUpperCase() + info.size.slice(1) : 'Medium';

        const colorEl = document.getElementById('card-pet-color');
        if (colorEl) colorEl.textContent = info.color || 'Standard';

        const intakeEl = document.getElementById('card-pet-intake');
        if (intakeEl) {
          const days = info.days_at_shelter !== null && info.days_at_shelter !== undefined ? `${info.days_at_shelter}d` : '';
          intakeEl.textContent = `${info.intake_date ? new Date(info.intake_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Recent'} ${days ? `(${days})` : ''}`;
        }

        const locEl = document.getElementById('card-kennel-location');
        if (locEl) locEl.textContent = `Location: ${info.location || 'Main Kennel'}`;

        const notesEl = document.getElementById('card-pet-notes');
        if (notesEl) {
          notesEl.textContent = info.description || 'Sweet, friendly companion ready for a forever home. Sociable and walked daily by volunteers.';
        }

        const urlEl = document.getElementById('card-direct-url');
        const adoptUrl = `https://monroe-humane.org/adopt/${info.id}`;
        if (urlEl) urlEl.textContent = adoptUrl;

        // Render high-contrast QR code
        const qrContainer = document.getElementById('card-qr-container');
        if (qrContainer) {
          qrContainer.innerHTML = '';
          const qrCode = new QRCodeStyling({
            width: 120,
            height: 120,
            type: 'svg',
            data: adoptUrl,
            margin: 4,
            qrOptions: { errorCorrectionLevel: 'H' },
            dotsOptions: { type: 'rounded', color: '#0f766e' },
            cornersSquareOptions: { type: 'extra-rounded', color: '#0f766e' },
            backgroundOptions: { color: '#ffffff' },
          });
          qrCode.append(qrContainer);
        }

        if (modal) modal.classList.remove('hidden');
      } catch (err) {
        console.error('Failed to prepare kennel card:', err);
      }
    });

    // Copy animal ID to clipboard
    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement)?.closest('.copy-pet-id-btn') as HTMLButtonElement | null;
      if (!btn) return;
      const id = btn.getAttribute('data-copy-id');
      if (!id) return;
      navigator.clipboard.writeText(id).then(() => {
        const originalHtml = btn.innerHTML;
        btn.innerHTML = `<span class="text-emerald-700 font-bold text-[9px]">✓</span>`;
        setTimeout(() => {
          btn.innerHTML = originalHtml;
        }, 1200);
      });
    });

    void (async () => {
      await ensureArchivedInflated();
      applyFilters();
    })();

  }

  document.addEventListener('astro:page-load', initPetSyncPortal);
</script>
