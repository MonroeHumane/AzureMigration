---
import { getStaffPetSyncData, type PetSyncSummary } from '../../lib/directus';
import PrintableKennelCardModal from './PrintableKennelCardModal.astro';

interface Props {
  syncData?: PetSyncSummary;
}

const { syncData } = Astro.props;
const data = syncData || (await getStaffPetSyncData());

const formatDate = (isoStr?: string | null) => {
  if (!isoStr) return '—';
  const d = new Date(isoStr);
  if (isNaN(d.getTime())) return isoStr;
  return d.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
};

const formatDateTime = (isoStr?: string | null) => {
  if (!isoStr) return '—';
  const d = new Date(isoStr);
  if (isNaN(d.getTime())) return isoStr;
  return d.toLocaleString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
  });
};

const calculateDaysAtShelter = (intakeStr?: string) => {
  if (!intakeStr) return null;
  const d = new Date(intakeStr);
  if (isNaN(d.getTime())) return null;
  return Math.floor((Date.now() - d.getTime()) / 86400000);
};

const activePets = data.pets.filter((p) => !p.archived_at);
const archivedPets = data.pets.filter((p) => !!p.archived_at);

const dogsCount = activePets.filter((p) => p.type === 'dog').length;
const catsCount = activePets.filter((p) => p.type === 'cat').length;
const othersCount = activePets.filter((p) => p.type !== 'dog' && p.type !== 'cat').length;

// Shelter Operational Pulse metrics
const activeWithDays = activePets.map((p) => ({
  ...p,
  daysInCare: calculateDaysAtShelter(p.intake_date || p.first_seen_at) || 0,
}));
const longStayPets = activeWithDays.filter((p) => p.daysInCare > 60);
const avgDaysInCare = Math.round(
  activeWithDays.reduce((s, p) => s + p.daysInCare, 0) / (activeWithDays.length || 1)
);
const dogsAvgDays = Math.round(
  activeWithDays.filter((p) => p.type === 'dog').reduce((s, p) => s + p.daysInCare, 0) / (dogsCount || 1)
);
const catsAvgDays = Math.round(
  activeWithDays.filter((p) => p.type === 'cat').reduce((s, p) => s + p.daysInCare, 0) / (catsCount || 1)
);

const totalServed2026 = 527;
const ytdAdoptions = 440;
const dailyCareCost = '3.87';

const getUrgencyBadge = (days: number | null) => {
  if (days === null) return null;
  if (days <= 14) return { label: 'New Intake (<14d)', color: 'bg-emerald-50 text-emerald-800 border-emerald-200' };
  if (days <= 60) return { label: 'Active Care (14-60d)', color: 'bg-sky-50 text-sky-800 border-sky-200' };
  if (days <= 180) return { label: 'Long Stay (60-180d)', color: 'bg-amber-50 text-amber-800 border-amber-200' };
  return { label: 'Urgent Foster (>180d)', color: 'bg-rose-50 text-rose-800 border-rose-200' };
};
---

<div class="space-y-6" id="petsync-portal-root">
  <!-- Top Operational Status Banner -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-xs p-5">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="inline-flex p-2 rounded-lg bg-[#173a39] text-amber-300 shadow-xs">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v4"></path>
              <path d="m4.93 4.93 2.83 2.83"></path>
              <path d="M2 12h4"></path>
              <path d="m4.93 19.07 2.83-2.83"></path>
              <path d="M12 18v4"></path>
              <path d="m19.07 19.07-2.83-2.83"></path>
              <path d="M18 12h4"></path>
              <path d="m19.07 4.93-2.83 2.83"></path>
            </svg>
          </span>
          <div>
            <div class="flex items-center gap-2">
              <h2 class="text-lg font-bold text-[#173a39] tracking-tight">
                PetSync Operations & Animal Inventory
              </h2>
              <span id="petsync-live-badge" class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300">
                Auto Sync: RUNNING
              </span>
            </div>
            <p class="text-xs text-slate-500 mt-0.5">
              Native Azure Container Job (<code class="bg-slate-100 px-1 py-0.5 rounded font-mono text-[11px]">mchs-petsync-job</code>) · Scrapes Petango every 30 minutes directly into Directus & Blob Storage.
            </p>
          </div>
        </div>
      </div>

      <!-- Quick Status Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
        <div class="p-2.5 rounded bg-slate-50 border border-slate-200">
          <span class="text-[10px] uppercase font-semibold text-slate-400 block">Active In Shelter</span>
          <span id="petsync-active-count-badge" class="font-mono font-bold text-emerald-700 text-sm">{data.activeCount} pets</span>
        </div>
        <div class="p-2.5 rounded bg-slate-50 border border-slate-200">
          <span class="text-[10px] uppercase font-semibold text-slate-400 block">Archived / Past</span>
          <span id="petsync-archived-count-badge" class="font-mono font-bold text-purple-700 text-sm">{data.archivedCount} pets</span>
        </div>
        <div class="p-2.5 rounded bg-slate-50 border border-slate-200">
          <span class="text-[10px] uppercase font-semibold text-slate-400 block">Total In Database</span>
          <span id="petsync-total-count-badge" class="font-mono font-bold text-slate-800 text-sm">{data.totalCount} pets</span>
        </div>
        <div class="p-2.5 rounded bg-slate-50 border border-slate-200">
          <span class="text-[10px] uppercase font-semibold text-slate-400 block">Last Full Sync</span>
          <span class="font-mono font-bold text-slate-900 text-[11px] block truncate" title={data.lastSyncTimestamp}>
            {formatDateTime(data.lastSyncTimestamp)}
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Shelter Operational Pulse & Care Cost Card -->
  <div class="bg-gradient-to-r from-teal-900 to-[#173a39] text-white rounded-xl shadow-xs p-5 border border-teal-800">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-teal-800/80 text-teal-200 border border-teal-700">
            Shelter Operational Pulse
          </span>
          <span class="text-xs text-teal-200/80">Money &amp; Mission Unified</span>
        </div>
        <h3 class="text-lg font-bold text-white tracking-tight">2026 Animal Care &amp; Life-Saving Impact</h3>
        <p class="text-xs text-teal-100/80 mt-0.5 max-w-2xl">
          Every operating dollar directly funds care, feeding, and medical treatment for Monroe County animals.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-xs shrink-0">
        <div class="bg-white/10 backdrop-blur-xs rounded-lg p-2.5 border border-white/10">
          <span class="text-[10px] uppercase font-bold text-teal-200 block">2026 Served YTD</span>
          <span class="font-mono font-black text-base text-white">{totalServed2026} pets</span>
          <span class="text-[10px] text-teal-200/70 block">{ytdAdoptions} adoptions YTD</span>
        </div>
        <div class="bg-white/10 backdrop-blur-xs rounded-lg p-2.5 border border-white/10">
          <span class="text-[10px] uppercase font-bold text-teal-200 block">Avg Length of Stay</span>
          <span class="font-mono font-black text-base text-white">{avgDaysInCare} days</span>
          <span class="text-[10px] text-teal-200/70 block">Dogs {dogsAvgDays}d · Cats {catsAvgDays}d</span>
        </div>
        <div class="bg-white/10 backdrop-blur-xs rounded-lg p-2.5 border border-white/10">
          <span class="text-[10px] uppercase font-bold text-teal-200 block">Daily Care Cost</span>
          <span class="font-mono font-black text-base text-amber-300">${dailyCareCost}/day</span>
          <span class="text-[10px] text-teal-200/70 block">Per animal in care</span>
        </div>
        <div class="bg-white/10 backdrop-blur-xs rounded-lg p-2.5 border border-white/10">
          <span class="text-[10px] uppercase font-bold text-teal-200 block">Long Stay Alert</span>
          <span class="font-mono font-black text-base text-amber-300">{longStayPets.length} pets</span>
          <span class="text-[10px] text-teal-200/70 block">&gt;60 days in care</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Roster Explorer -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-xs p-5 space-y-4">
    <!-- Filter Bar & Search -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 bg-slate-50 p-3 rounded-lg border border-slate-200">
      <!-- Status Filter Tabs -->
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="text-[11px] font-semibold text-slate-500 mr-1">Roster:</span>
        <button
          type="button"
          data-status-filter="active"
          id="petsync-pill-active"
          class="petsync-status-pill active px-3 py-1 rounded-md font-semibold bg-[#173a39] text-white transition shadow-xs"
        >
          Active (<span id="petsync-pill-active-count">{data.activeCount}</span>)
        </button>
        <button
          type="button"
          data-status-filter="archived"
          id="petsync-pill-archived"
          class="petsync-status-pill px-3 py-1 rounded-md font-semibold bg-white border border-slate-200 text-purple-800 hover:bg-purple-50 transition"
        >
          Archived / Past (<span id="petsync-pill-archived-count">{data.archivedCount}</span>)
        </button>
        <button
          type="button"
          data-status-filter="all"
          id="petsync-pill-all"
          class="petsync-status-pill px-3 py-1 rounded-md font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 transition"
        >
          All Tracked (<span id="petsync-pill-all-count">{data.totalCount}</span>)
        </button>
      </div>

      <!-- Quick Action Controls -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="export-csv-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold bg-white border border-slate-300 text-slate-700 hover:bg-slate-100 transition shadow-xs"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Export CSV
        </button>
      </div>
    </div>

    <!-- Quick 1-Tap Species Filter Pills -->
    <div class="flex flex-wrap items-center gap-1.5 text-xs pb-1">
      <span class="text-[11px] font-semibold text-slate-500 mr-1">Quick Species:</span>
      <button
        type="button"
        data-species-pill=""
        class="petsync-species-btn active px-3 py-1 rounded-md font-semibold bg-[#173a39] text-white transition shadow-xs"
      >
        All (<span id="species-count-all">{activePets.length}</span>)
      </button>
      <button
        type="button"
        data-species-pill="dog"
        class="petsync-species-btn px-3 py-1 rounded-md font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 inline-block mr-1"></span> Dogs (<span id="species-count-dog">{dogsCount}</span>)
      </button>
      <button
        type="button"
        data-species-pill="cat"
        class="petsync-species-btn px-3 py-1 rounded-md font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-teal-500 inline-block mr-1"></span> Cats (<span id="species-count-cat">{catsCount}</span>)
      </button>
      <button
        type="button"
        data-species-pill="other"
        class="petsync-species-btn px-3 py-1 rounded-md font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-slate-400 inline-block mr-1"></span> Other (<span id="species-count-other">{othersCount}</span>)
      </button>
      <span class="text-slate-300 mx-1">|</span>
      <button
        type="button"
        data-species-pill="longstay"
        id="petsync-longstay-btn"
        class="petsync-species-btn px-3 py-1 rounded-md font-semibold bg-amber-50 border border-amber-300 text-amber-900 hover:bg-amber-100 transition shadow-xs flex items-center gap-1.5"
      >
        <span class="inline-flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>Long Stay (&gt;60d)</span>
        </span>
        <span class="px-1.5 py-0.2 rounded-full bg-amber-200 text-amber-900 text-[10px] font-bold" id="species-count-longstay">
          {longStayPets.length}
        </span>
      </button>
    </div>

    <!-- Secondary Filters: Placement, Stay Duration & Search -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-2 text-xs">
      <!-- Search (2 cols on md) -->
      <div class="relative sm:col-span-2 md:col-span-2">
        <div class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none text-slate-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
        <input
          type="text"
          id="petsync-search-input"
          placeholder="Search name, ID, breed, color, foster..."
          class="w-full pl-8 pr-3 py-1.5 text-xs rounded-md border border-slate-300 bg-white text-slate-800 placeholder-slate-400 focus:outline-hidden focus:ring-1 focus:ring-[#173a39] focus:border-[#173a39]"
        />
      </div>

      <!-- Placement Filter (Shelter vs Foster) -->
      <div>
        <select
          id="petsync-location-filter"
          class="w-full py-1.5 px-2.5 text-xs rounded-md border border-slate-300 bg-white text-slate-800 focus:outline-hidden focus:ring-1 focus:ring-[#173a39]"
        >
          <option value="">All Placements</option>
          <option value="shelter">Shelter Facility (On-Site)</option>
          <option value="foster">In Foster Care</option>
        </select>
      </div>

      <!-- Stay Duration Filter -->
      <div>
        <select
          id="petsync-duration-filter"
          class="w-full py-1.5 px-2.5 text-xs rounded-md border border-slate-300 bg-white text-slate-800 focus:outline-hidden focus:ring-1 focus:ring-[#173a39]"
        >
          <option value="">All Stay Durations</option>
          <option value="new">New Intakes (&lt; 14 days)</option>
          <option value="standard">Standard Care (14 - 60 days)</option>
          <option value="long">Long-Stay (60 - 180 days)</option>
          <option value="urgent">Urgent Foster (&gt; 180 days)</option>
        </select>
      </div>

      <!-- Reset -->
      <div>
        <button
          type="button"
          id="petsync-reset-btn"
          class="w-full py-1.5 px-3 text-xs rounded-md border border-slate-200 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold transition"
        >
          Reset Filters
        </button>
      </div>
    </div>

    <!-- Live Counter -->
    <div class="flex items-center justify-between text-xs text-slate-500 px-1">
      <div>
        Showing <span id="petsync-filtered-count" class="font-bold text-slate-800">{data.activeCount}</span> of {data.totalCount} total animals
      </div>
      <div class="text-[11px] text-slate-400">
        Click PetPoint link to open PetPoint WebServices record
      </div>
    </div>

    <!-- Desktop Roster Table -->
    <div class="hidden md:block border border-slate-200 rounded-lg overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-slate-100/80 text-slate-700 font-semibold border-b border-slate-200">
            <th class="py-2.5 px-3 w-14">Photo</th>
            <th class="py-2.5 px-3">Pet ID & PetPoint</th>
            <th class="py-2.5 px-3">Name & Species</th>
            <th class="py-2.5 px-3">Breed & Color</th>
            <th class="py-2.5 px-3">Sex & Age</th>
            <th class="py-2.5 px-3">Location</th>
            <th class="py-2.5 px-3">Intake & Days</th>
            <th class="py-2.5 px-3">Status</th>
            <th class="py-2.5 px-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="petsync-tbody" class="divide-y divide-slate-100">
          {activePets.map((pet) => {
            const daysAtShelter = calculateDaysAtShelter(pet.intake_date);
            const publicUrl = `/adopt/${encodeURIComponent(pet.id)}`;
            const petPointUrl = (pet.url && !/authkey=/i.test(pet.url)) ? pet.url : publicUrl;
            const photoUrl = pet.image || '/assets/recovered/images/placeholder.svg';

            return (
              <tr
                class="hover:bg-slate-50/80 transition petsync-row"
                data-is-archived="false"
                data-species={pet.type}
                data-location={pet.location || ''}
                data-search={`${pet.id} ${pet.name} ${pet.breed} ${pet.color || ''} ${pet.location || ''} ${pet.gender}`.toLowerCase()}
                data-pet-id={pet.id}
                data-pet-name={pet.name}
                data-pet-breed={pet.breed}
                data-pet-species={pet.species_label || pet.type}
                data-intake-date={pet.intake_date || ''}
                data-days-at-shelter={daysAtShelter !== null ? daysAtShelter : ''}
              >
                <!-- Thumbnail -->
                <td class="py-2 px-3">
                  <div class="w-11 h-11 rounded-lg overflow-hidden bg-slate-100 border border-slate-200 flex-shrink-0 relative group">
                    <img
                      src={photoUrl}
                      alt={pet.name}
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-110 transition duration-200"
                      data-fallback="/assets/recovered/images/placeholder.svg"
                    />
                  </div>
                </td>

                <!-- ID & PetPoint Link -->
                <td class="py-2 px-3 whitespace-nowrap">
                  <div class="flex items-center gap-1">
                    <span class="font-mono font-bold text-slate-900">{pet.id}</span>
                    <button
                      type="button"
                      class="copy-pet-id-btn text-slate-400 hover:text-teal-700 p-0.5 rounded hover:bg-slate-100 transition cursor-pointer"
                      title="Copy Animal ID"
                      data-copy-id={pet.id}
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
                      </svg>
                    </button>
                  </div>
                  <a
                    href={petPointUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-0.5 text-[10px] font-bold text-teal-700 hover:text-teal-900 hover:underline mt-0.5"
                    title="Open official PetPoint WebServices details popup"
                  >
                    Open PetPoint ↗
                  </a>
                </td>

                <!-- Name & Species -->
                <td class="py-2 px-3">
                  <div class="font-bold text-slate-900 flex items-center gap-1">
                    <span class={`w-2 h-2 rounded-full ${pet.type === 'dog' ? 'bg-amber-500' : pet.type === 'cat' ? 'bg-teal-500' : 'bg-slate-400'} inline-block mr-1`}></span>
                    <span class="text-sm">{pet.name}</span>
                  </div>
                  <span class="text-[10px] text-slate-400 block uppercase tracking-wider font-semibold">
                    {pet.species_label || pet.type}
                  </span>
                </td>

                <!-- Breed & Color -->
                <td class="py-2 px-3">
                  <span class="text-slate-800 font-medium block truncate max-w-xs" title={pet.breed}>
                    {pet.breed}
                  </span>
                  {pet.color && (
                    <span class="text-[11px] text-slate-500 block">
                      Color: {pet.color}
                    </span>
                  )}
                </td>

                <!-- Sex & Age -->
                <td class="py-2 px-3 whitespace-nowrap">
                  <span class="font-medium text-slate-800 block">
                    {pet.gender === 'female' ? '♀ Female' : pet.gender === 'male' ? '♂ Male' : 'Unknown'}
                  </span>
                  <span class="text-[11px] text-slate-500 block">
                    {pet.age_display || pet.age}
                  </span>
                </td>

                <!-- Location -->
                <td class="py-2 px-3 whitespace-nowrap">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-700 border border-slate-200">
                    {pet.location || 'Shelter'}
                  </span>
                </td>

                <!-- Intake Date & Days -->
                <td class="py-2 px-3 whitespace-nowrap">
                  <span class="text-slate-800 font-medium block">
                    {formatDate(pet.intake_date)}
                  </span>
                  {daysAtShelter !== null && (
                    <span class={`text-[10px] font-semibold ${
                      daysAtShelter > 180
                        ? 'text-purple-700'
                        : daysAtShelter < 14
                        ? 'text-emerald-700'
                        : 'text-slate-500'
                    }`}>
                      {daysAtShelter} days in care
                    </span>
                  )}
                </td>

                <!-- Status / Stage -->
                <td class="py-2 px-3 whitespace-nowrap">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                    {pet.stage || 'Available'}
                  </span>
                </td>

                <!-- Actions -->
                <td class="py-2 px-3 text-right whitespace-nowrap">
                  <div class="flex items-center justify-end gap-1.5">
                    <button
                      type="button"
                      class="petsync-print-card-btn inline-flex items-center gap-1 px-2 py-1 rounded text-[11px] font-semibold bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-300 transition cursor-pointer"
                      data-pet-info={JSON.stringify({
                        id: pet.id,
