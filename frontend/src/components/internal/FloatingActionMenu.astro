---
const directusAdminUrl = 'https://mchs-directus.livelyfield-d0a70609.eastus.azurecontainerapps.io/admin';
---

<!-- Desktop Floating Action Menu (Hidden on Mobile) -->
<div class="fixed bottom-6 right-6 z-50 hidden lg:block group" id="fab-container">
  
  <!-- Secondary Action Menu Items -->
  <div class="flex flex-col-reverse items-end gap-3 mb-4 opacity-0 scale-95 translate-y-4 pointer-events-none group-hover:opacity-100 group-hover:scale-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 ease-out origin-bottom">
    
    <a href={directusAdminUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 pr-2 shadow-lg group/item">
      <span class="text-xs font-bold text-white bg-teal-950/90 backdrop-blur-sm px-3 py-1.5 rounded-lg border border-teal-800 shadow-sm opacity-0 -translate-x-2 group-hover/item:opacity-100 group-hover/item:translate-x-0 transition-all">New Animal Record (CMS)</span>
      <div class="w-10 h-10 rounded-full bg-amber-600 text-white flex items-center justify-center hover:bg-amber-500 transition shadow-md border border-amber-400/30">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 20h9"></path>
          <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
        </svg>
      </div>
    </a>

    <button type="button" id="fab-print-btn" class="flex items-center gap-3 pr-2 shadow-lg group/item cursor-pointer">
      <span class="text-xs font-bold text-white bg-teal-950/90 backdrop-blur-sm px-3 py-1.5 rounded-lg border border-teal-800 shadow-sm opacity-0 -translate-x-2 group-hover/item:opacity-100 group-hover/item:translate-x-0 transition-all">Print Board Packet</span>
      <div class="w-10 h-10 rounded-full bg-emerald-600 text-white flex items-center justify-center hover:bg-emerald-500 transition shadow-md border border-emerald-400/30">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="6 9 6 2 18 2 18 9"></polyline>
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
          <rect width="12" height="8" x="6" y="14"></rect>
        </svg>
      </div>
    </button>
    
    <button type="button" id="fab-search-btn" class="flex items-center gap-3 pr-2 shadow-lg group/item cursor-pointer">
      <span class="text-xs font-bold text-white bg-teal-950/90 backdrop-blur-sm px-3 py-1.5 rounded-lg border border-teal-800 shadow-sm opacity-0 -translate-x-2 group-hover/item:opacity-100 group-hover/item:translate-x-0 transition-all">Search (Cmd+K)</span>
      <div class="w-10 h-10 rounded-full bg-teal-600 text-white flex items-center justify-center hover:bg-teal-500 transition shadow-md border border-teal-400/30">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>
    </button>
  </div>

  <!-- Primary Action Button -->
  <button
    type="button"
    class="w-14 h-14 rounded-full bg-emerald-500 text-[#051311] hover:bg-emerald-400 transition-all shadow-xl shadow-teal-950/40 flex items-center justify-center relative cursor-pointer border border-emerald-300"
    aria-label="Quick Actions"
  >
    <!-- Plus Icon (Visible by default, rotates and fades out on hover) -->
    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 absolute group-hover:rotate-90 group-hover:opacity-0 transition-all duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="12" y1="5" x2="12" y2="19"></line>
      <line x1="5" y1="12" x2="19" y2="12"></line>
    </svg>
    <!-- Close/More Icon (Fades in on hover) -->
    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 absolute opacity-0 -rotate-90 group-hover:rotate-0 group-hover:opacity-100 transition-all duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 5v14M5 12h14"></path>
    </svg>
  </button>
</div>

<script>
  function initFAB() {
    const searchBtn = document.getElementById('fab-search-btn');
    const printBtn = document.getElementById('fab-print-btn');

    if (searchBtn && searchBtn.dataset.bound !== '1') {
      searchBtn.dataset.bound = '1';
      searchBtn.addEventListener('click', () => {
        const event = new KeyboardEvent('keydown', {
          key: 'k',
          metaKey: true, // macOS
          ctrlKey: true, // Windows/Linux
          bubbles: true
        });
        document.dispatchEvent(event);
      });
    }

    if (printBtn && printBtn.dataset.bound !== '1') {
      printBtn.dataset.bound = '1';
      printBtn.addEventListener('click', () => {
        window.open('/internal/board/print/', '_blank');
      });
    }
  }

  document.addEventListener('astro:page-load', initFAB);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFAB);
  } else {
    initFAB();
  }
</script>
