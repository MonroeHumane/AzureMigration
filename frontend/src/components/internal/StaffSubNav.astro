---
interface SubNavItem {
  id: string;
  label: string;
  icon?: string;
  count?: number | string;
}

interface Props {
  items: SubNavItem[];
  activeId?: string;
  ariaLabel?: string;
}

const { items, activeId = items[0]?.id, ariaLabel = 'Section navigation' } = Astro.props;
---

<div class="bg-[#061815]/95 backdrop-blur-md border-b border-teal-800/80 sticky top-[57px] z-30 shadow-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <nav class="flex items-center gap-1.5 sm:gap-2 overflow-x-auto py-2.5 scrollbar-none" aria-label={ariaLabel}>
      {items.map((it) => {
        const isActive = it.id === activeId;
        return (
          <button
            type="button"
            data-subnav-target={it.id}
            class={`subnav-pill inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition cursor-pointer shrink-0 ${
              isActive
                ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-xs font-bold'
                : 'bg-teal-950/60 text-teal-200/90 hover:bg-teal-900 hover:text-white border border-teal-800/70'
            }`}
          >
            {it.icon && <span class="text-sm leading-none">{it.icon}</span>}
            <span>{it.label}</span>
            {it.count !== undefined && (
              <span class={`ml-1 px-1.5 py-0.2 rounded-full text-[10px] font-bold ${
                isActive ? 'bg-emerald-500/30 text-emerald-200' : 'bg-teal-900 text-teal-300'
              }`}>
                {it.count}
              </span>
            )}
          </button>
        );
      })}
    </nav>
  </div>
</div>
