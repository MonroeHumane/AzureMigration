---
const directusAdminUrl = 'https://mchs-directus.livelyfield-d0a70609.eastus.azurecontainerapps.io/admin';
---

<!-- Mobile More Slide-Up Sheet Modal -->
<div
  id="mobile-more-sheet-backdrop"
  class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 hidden transition-opacity duration-300 opacity-0 md:hidden"
  aria-hidden="true"
>
  <div class="fixed inset-0 flex items-end justify-center p-0">
    <div
      id="mobile-more-sheet-panel"
      class="w-full max-w-lg bg-white rounded-t-2xl border-t border-slate-200 shadow-2xl transform translate-y-full transition-transform duration-300 ease-out max-h-[85vh] overflow-y-auto"
      role="dialog"
      aria-modal="true"
      aria-label="Staff Portal Secondary Menu"
    >
      <!-- Drag handle indicator -->
      <div class="pt-3 pb-1 flex justify-center cursor-pointer" id="mobile-more-sheet-handle">
        <span class="w-12 h-1 bg-slate-300 rounded-full"></span>
      </div>

      <!-- Header -->
      <div class="px-5 py-3 border-b border-slate-100 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="p-1.5 rounded-lg bg-teal-100 text-teal-800">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
          </span>
          <h3 class="text-sm font-bold text-slate-900">Portal Utilities & Tools</h3>
        </div>
        <button
          type="button"
          id="close-mobile-more-sheet-btn"
          class="p-1.5 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition cursor-pointer"
          aria-label="Close sheet"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Quick Actions List -->
      <div class="p-4 space-y-2 text-xs">
        <!-- PWA Install Action Card -->
        <div
          id="pwa-install-container"
          class="p-3 rounded-xl bg-gradient-to-r from-teal-900 via-[#173a39] to-teal-950 text-white border border-teal-700/80 shadow-md flex items-center justify-between"
        >
          <div class="flex items-center gap-2.5">
            <div class="w-9 h-9 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 flex items-center justify-center font-bold text-sm shadow-inner shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect>
                <path d="M12 18h.01"></path>
              </svg>
            </div>
            <div>
              <div class="font-bold text-white text-xs">
                Install HSMC Ops App
              </div>
              <div class="text-[11px] text-teal-200/80" id="pwa-install-desc">
                Fast home-screen access & offline census
              </div>
            </div>
          </div>
          <button
            type="button"
            id="pwa-install-btn"
            class="px-3 py-1.5 rounded-lg text-xs font-bold bg-emerald-500 hover:bg-emerald-400 text-slate-950 transition cursor-pointer shrink-0 shadow-xs"
          >
            Install
          </button>
        </div>

        <!-- Directus Admin link -->
        <a
          href={directusAdminUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between p-3 rounded-xl bg-slate-50 hover:bg-teal-50/60 border border-slate-200 transition group"
        >
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-lg bg-[#173a39] text-white flex items-center justify-center font-bold text-sm shadow-xs">
              CMS
            </div>
            <div>
              <div class="font-bold text-slate-900 group-hover:text-teal-900 text-xs">
                Directus Headless CMS Console
              </div>
              <div class="text-[11px] text-slate-500">
                Manage animal records, users, newsletters & assets
              </div>
            </div>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 group-hover:text-teal-700 transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>

        <!-- Website Content Manager -->
        <a
          href="/internal/content/"
          data-astro-prefetch="hover"
          class="flex items-center justify-between p-3 rounded-xl bg-slate-50 hover:bg-teal-50/60 border border-slate-200 transition group"
        >
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-lg bg-amber-800 text-amber-100 flex items-center justify-center shadow-xs">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 20h9"></path>
                <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
              </svg>
            </div>
            <div>
              <div class="font-bold text-slate-900 group-hover:text-teal-900 text-xs">
                Site Content Manager
              </div>
              <div class="text-[11px] text-slate-500">
                Memorial tributes, event flyers, newsletters & outcomes
              </div>
            </div>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 group-hover:text-teal-700 transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </a>

        <!-- Board Printable Packet -->
        <a
          href="/internal/board/print/"
          target="_blank"
          class="flex items-center justify-between p-3 rounded-xl bg-slate-50 hover:bg-teal-50/60 border border-slate-200 transition group"
        >
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-lg bg-teal-800 text-emerald-200 flex items-center justify-center shadow-xs">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                <rect width="12" height="8" x="6" y="14"></rect>
              </svg>
            </div>
            <div>
              <div class="font-bold text-slate-900 group-hover:text-teal-900 text-xs">
                Board Financials Print Packet
              </div>
              <div class="text-[11px] text-slate-500">
                Executive 8-month statement & bank reconciliation
              </div>
            </div>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 group-hover:text-teal-700 transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </a>

        <!-- Bank Statement Reconciliation Viewer -->
        <a
          href="/internal/board/#bank-statement-viewer"
          data-astro-prefetch="hover"
          class="flex items-center justify-between p-3 rounded-xl bg-slate-50 hover:bg-teal-50/60 border border-slate-200 transition group"
          id="mobile-sheet-bank-link"
        >
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-lg bg-emerald-800 text-emerald-100 flex items-center justify-center shadow-xs">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
            </div>
            <div>
              <div class="font-bold text-slate-900 group-hover:text-teal-900 text-xs">
                Bank Statement & Audit Scans
              </div>
              <div class="text-[11px] text-slate-500">
                First Merchants Aug 31 dual-PDF reconciliation
              </div>
            </div>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 group-hover:text-teal-700 transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </a>

        <!-- Donors & Giving Registry -->
        <a
          href="/internal/donors/"
          data-astro-prefetch="hover"
          class="flex items-center justify-between p-3 rounded-xl bg-slate-50 hover:bg-teal-50/60 border border-slate-200 transition group"
        >
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-lg bg-rose-900 text-rose-100 flex items-center justify-center shadow-xs">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
              </svg>
            </div>
            <div>
              <div class="font-bold text-slate-900 group-hover:text-teal-900 text-xs">
                Donor Registry &amp; Lifetime Giving
              </div>
              <div class="text-[11px] text-slate-500">
                Unified profiles, tax addresses &amp; itemized gifts
              </div>
            </div>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 group-hover:text-teal-700 transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </a>

        <!-- Public Website Link -->
        <a
          href="/"
          data-astro-reload
          class="flex items-center justify-between p-3 rounded-xl bg-slate-50 hover:bg-teal-50/60 border border-slate-200 transition group"
        >
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-lg bg-slate-700 text-white flex items-center justify-center shadow-xs">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
            </div>
            <div>
              <div class="font-bold text-slate-900 group-hover:text-teal-900 text-xs">
                Return to Public Website
              </div>
              <div class="text-[11px] text-slate-500">
                monroe-humane.org home page
              </div>
            </div>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 group-hover:text-teal-700 transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </a>
      </div>

      <!-- User Info & Sign Out Footer -->
      <div class="p-4 bg-slate-50 border-t border-slate-100 flex items-center justify-between">
        <div class="flex items-center gap-2.5 min-w-0">
          <div id="sheet-user-avatar" class="w-8 h-8 rounded-full bg-emerald-700 text-emerald-100 flex items-center justify-center font-bold text-xs shrink-0">
            SP
          </div>
          <div class="min-w-0">
            <div class="text-[11px] text-slate-400 font-medium">Signed In</div>
            <div id="sheet-user-email" class="text-xs font-bold text-slate-800 truncate">
              staff@monroe-humane.org
            </div>
          </div>
        </div>

        <button
          type="button"
          id="sheet-logout-btn"
          class="px-3 py-1.5 rounded-lg text-xs font-bold bg-rose-50 text-rose-700 hover:bg-rose-100 border border-rose-200 transition cursor-pointer shrink-0"
        >
          Sign Out
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function setupMobileMoreSheet() {
    const backdrop = document.getElementById('mobile-more-sheet-backdrop');
    const panel = document.getElementById('mobile-more-sheet-panel');
    const closeBtn = document.getElementById('close-mobile-more-sheet-btn');
    const sheetLogoutBtn = document.getElementById('sheet-logout-btn');
    const handle = document.getElementById('mobile-more-sheet-handle');

    function openSheet() {
      if (!backdrop || !panel) return;
      backdrop.classList.remove('hidden');
      requestAnimationFrame(() => {
        backdrop.classList.remove('opacity-0');
        backdrop.classList.add('opacity-100');
        panel.classList.remove('translate-y-full');
        panel.classList.add('translate-y-0');
      });
      // Sync user email
      const email = localStorage.getItem('mchs_staff_user') || 'staff@monroe-humane.org';
      const emailEl = document.getElementById('sheet-user-email');
      const avatarEl = document.getElementById('sheet-user-avatar');
      if (emailEl) emailEl.textContent = email;
      if (avatarEl && email) {
        const parts = email.split('@')[0].split(/[._-]/);
        const initials = (parts.length > 1 ? parts[0][0] + parts[1][0] : parts[0].slice(0, 2)).toUpperCase();
        avatarEl.textContent = initials;
      }
    }

    function closeSheet() {
      if (!backdrop || !panel) return;
      backdrop.classList.remove('opacity-100');
      backdrop.classList.add('opacity-0');
      panel.classList.remove('translate-y-0');
      panel.classList.add('translate-y-full');
      setTimeout(() => {
        backdrop.classList.add('hidden');
      }, 300);
    }

    // Expose open and close globally
    (window as any).openMobileMoreSheet = openSheet;
    (window as any).closeMobileMoreSheet = closeSheet;

    if (closeBtn) closeBtn.addEventListener('click', closeSheet);
    if (handle) handle.addEventListener('click', closeSheet);
    if (backdrop) {
      backdrop.addEventListener('click', (e) => {
        if (e.target === backdrop || (e.target as HTMLElement).closest('#mobile-more-sheet-panel') === null) {
          closeSheet();
        }
      });
    }

    // Connect logout
    if (sheetLogoutBtn) {
      sheetLogoutBtn.addEventListener('click', () => {
        const globalLogout = document.getElementById('global-staff-logout-btn');
        if (globalLogout) {
          globalLogout.click();
        } else {
          sessionStorage.clear();
          localStorage.removeItem('mchs_staff_auth');
          localStorage.removeItem('mchs_staff_user');
          localStorage.removeItem('mchs_staff_token');
          localStorage.removeItem('directus_auth');
          window.location.href = '/internal/';
        }
      });
    }

    // PWA Install prompt handling
    let deferredPrompt: any = (window as any).__pwaInstallPrompt || null;
    const installContainer = document.getElementById('pwa-install-container');
    const installBtn = document.getElementById('pwa-install-btn');
    const installDesc = document.getElementById('pwa-install-desc');

    const isStandalone = window.matchMedia('(display-mode: standalone)').matches || (window.navigator as any).standalone;
    if (isStandalone && installContainer) {
      installContainer.classList.add('hidden');
    }

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      (window as any).__pwaInstallPrompt = e;
      if (installContainer && !isStandalone) {
        installContainer.classList.remove('hidden');
      }
    });

    if (installBtn && installBtn.dataset.bound !== '1') {
      installBtn.dataset.bound = '1';
      installBtn.addEventListener('click', async () => {
        if (deferredPrompt) {
          deferredPrompt.prompt();
          const choice = await deferredPrompt.userChoice;
          if (choice.outcome === 'accepted') {
            installContainer?.classList.add('hidden');
          }
          deferredPrompt = null;
        } else {
          if (installDesc) {
            installDesc.textContent = 'Safari: Tap Share [↑] then "Add to Home Screen"';
          }
        }
      });
    }
  }

  document.addEventListener('astro:page-load', setupMobileMoreSheet);
  if (document.readyState !== 'loading') {
    setupMobileMoreSheet();
  } else {
    document.addEventListener('DOMContentLoaded', setupMobileMoreSheet);
  }
</script>
