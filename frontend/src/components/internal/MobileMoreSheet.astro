---
const directusAdminUrl = 'https://mchs-directus.livelyfield-d0a70609.eastus.azurecontainerapps.io/admin';
---

<!-- Mobile More Slide-Up Sheet Modal (Native HTML5 Dialog) -->
<dialog
  id="mobile-more-sheet"
  class="staff-more-sheet md:hidden"
  aria-label="Staff Portal Secondary Menu"
>
  <div class="fixed inset-0 flex items-end justify-center p-0" id="mobile-more-sheet-backdrop">
    <div
      id="mobile-more-sheet-panel"
      class="w-full max-w-lg bg-white dark:bg-[#071a17] text-slate-900 dark:text-white rounded-t-3xl border-t border-slate-200 dark:border-teal-700/80 shadow-2xl transform translate-y-full transition-transform duration-300 ease-out max-h-[88vh] overflow-y-auto"
      role="document"
    >
      <!-- Drag handle indicator -->
      <div class="pt-3.5 pb-1 flex justify-center cursor-pointer" id="mobile-more-sheet-handle">
        <span class="w-12 h-1.5 bg-slate-300 dark:bg-teal-800 rounded-full"></span>
      </div>

      <!-- Header -->
      <div class="px-5 py-3 border-b border-slate-200 dark:border-teal-900/80 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <span class="p-1.5 rounded-xl bg-teal-50 text-teal-800 border border-teal-200 dark:bg-teal-900/80 dark:text-emerald-300 dark:border-teal-700/80">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
          </span>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white tracking-tight">Portal Utilities &amp; Modules</h3>
        </div>
        <button
          type="button"
          id="close-mobile-more-sheet-btn"
          class="p-1.5 rounded-lg text-slate-500 hover:text-slate-900 hover:bg-slate-100 dark:text-teal-300 dark:hover:text-white dark:hover:bg-teal-900/60 transition cursor-pointer"
          aria-label="Close sheet"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Content Body -->
      <div class="p-4 space-y-3 text-xs">
        <!-- Navigation Style Switcher Segmented Control -->
        <div class="p-3 bg-slate-50 dark:bg-[#0b2420] rounded-2xl border border-slate-200 dark:border-teal-800/80 shadow-md">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold text-teal-800 dark:text-teal-200">Mobile Navigation Mode</span>
            <span id="sheet-nav-mode-indicator" class="sheet-mode-chip text-[10px] font-bold uppercase px-2 py-0.5 rounded">
              Bottom Dock
            </span>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <button
              type="button"
              id="sheet-set-bottom-bar-btn"
              data-nav-choice="bottom-bar"
              data-active="true"
              class="sheet-choice-btn py-2 px-3 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5 cursor-pointer"
            >
              <span>Bottom Bar</span>
            </button>
            <button
              type="button"
              id="sheet-set-hamburger-btn"
              data-nav-choice="hamburger"
              data-active="false"
              class="sheet-choice-btn py-2 px-3 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5 cursor-pointer"
            >
              <span>Hamburger</span>
            </button>
          </div>
        </div>

        <!-- Portal Theme Switcher (Light Monroe / Dark Ops) -->
        <div class="p-3 bg-slate-50 dark:bg-[#0b2420] rounded-2xl border border-slate-200 dark:border-teal-800/80 shadow-md">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold text-teal-800 dark:text-teal-200">Portal Theme</span>
            <span id="sheet-theme-indicator" class="sheet-mode-chip text-[10px] font-bold uppercase px-2 py-0.5 rounded">
              Light Monroe
            </span>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <button
              type="button"
              id="sheet-set-light-theme-btn"
              data-theme-choice="light"
              data-active="true"
              class="sheet-choice-btn py-2 px-3 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5 cursor-pointer"
            >
              <span>Light Monroe</span>
            </button>
            <button
              type="button"
              id="sheet-set-dark-theme-btn"
              data-theme-choice="dark"
              data-active="false"
              class="sheet-choice-btn py-2 px-3 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5 cursor-pointer"
            >
              <span>Dark Ops</span>
            </button>
          </div>
        </div>

        <!-- PWA Install Action Card -->
        <div
          id="pwa-install-container"
          class="pwa-install-card p-3 rounded-2xl flex items-center justify-between gap-3"
        >
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="pwa-install-icon w-9 h-9 rounded-xl flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect>
                <path d="M12 18h.01"></path>
              </svg>
            </div>
            <div class="min-w-0">
              <div class="pwa-install-title font-bold text-xs">
                Install HSMC Ops App
              </div>
              <div class="pwa-install-desc text-[11px] leading-snug" id="pwa-install-desc">
                Home screen icon &amp; offline census
              </div>
            </div>
          </div>
          <button
            type="button"
            id="pwa-install-btn"
            class="pwa-install-btn px-3 py-1.5 rounded-xl text-xs font-bold transition cursor-pointer shrink-0"
          >
            Install
          </button>
        </div>

        <!-- Directus Admin link -->
        <a
          href={directusAdminUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between p-3 rounded-2xl bg-slate-50 dark:bg-[#0b2420] hover:bg-teal-50 dark:hover:bg-teal-900/60 border border-slate-200 dark:border-teal-800/80 transition group"
        >
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-teal-50 text-teal-800 border border-teal-200 dark:bg-teal-900 dark:text-emerald-300 dark:border-teal-700 flex items-center justify-center font-bold text-sm shadow-xs">
              CMS
            </div>
            <div>
              <div class="font-bold text-slate-900 dark:text-white group-hover:text-teal-800 dark:group-hover:text-emerald-300 text-xs">
                Directus Headless CMS Console
              </div>
              <div class="text-[11px] text-slate-500 dark:text-teal-300/70">
                Manage animal records &amp; site assets
              </div>
            </div>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 dark:text-teal-400 group-hover:text-teal-800 dark:group-hover:text-white transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>

        <!-- Newsletter CMS -->
        <a
          href="/internal/newsletter/"
          data-astro-prefetch="hover"
          class="flex items-center justify-between p-3 rounded-2xl bg-slate-50 dark:bg-[#0b2420] hover:bg-teal-50 dark:hover:bg-teal-900/60 border border-slate-200 dark:border-teal-800/80 transition group"
        >
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-teal-50 text-teal-800 border border-teal-200 dark:bg-teal-950 dark:text-teal-300 dark:border-teal-800/80 flex items-center justify-center shadow-xs">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
            </div>
            <div>
              <div class="font-bold text-slate-900 dark:text-white group-hover:text-teal-800 dark:group-hover:text-teal-200 text-xs">
                Newsletter CMS
              </div>
              <div class="text-[11px] text-slate-500 dark:text-slate-300">
                Draft, schedule &amp; publish public issues
              </div>
            </div>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 dark:text-teal-400 group-hover:text-teal-800 dark:group-hover:text-white transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </a>

        <!-- Website Content Manager -->
        <a
          href="/internal/content/"
          data-astro-prefetch="hover"
          class="flex items-center justify-between p-3 rounded-2xl bg-slate-50 dark:bg-[#0b2420] hover:bg-teal-50 dark:hover:bg-teal-900/60 border border-slate-200 dark:border-teal-800/80 transition group"
        >
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-teal-50 text-teal-800 border border-teal-200 dark:bg-teal-950 dark:text-teal-300 dark:border-teal-800/80 flex items-center justify-center shadow-xs">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 20h9"></path>
                <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
              </svg>
            </div>
            <div>
              <div class="font-bold text-slate-900 dark:text-white group-hover:text-teal-800 dark:group-hover:text-teal-200 text-xs">
                Site Content Manager
              </div>
              <div class="text-[11px] text-slate-500 dark:text-slate-300">
                Memorial tributes, event flyers &amp; outcomes
              </div>
            </div>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 dark:text-teal-400 group-hover:text-teal-800 dark:group-hover:text-white transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </a>

        <!-- Donors & Giving Registry -->
        <a
          href="/internal/donors/"
          data-astro-prefetch="hover"
          class="flex items-center justify-between p-3 rounded-2xl bg-slate-50 dark:bg-[#0b2420] hover:bg-teal-50 dark:hover:bg-teal-900/60 border border-slate-200 dark:border-teal-800/80 transition group"
        >
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-teal-50 text-teal-800 border border-teal-200 dark:bg-teal-950 dark:text-teal-300 dark:border-teal-800/80 flex items-center justify-center shadow-xs">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
              </svg>
            </div>
            <div>
              <div class="font-bold text-slate-900 dark:text-white group-hover:text-teal-800 dark:group-hover:text-teal-200 text-xs">
                Donor Registry &amp; Lifetime Giving
              </div>
              <div class="text-[11px] text-slate-500 dark:text-slate-300">
                Profiles, giving records &amp; tax addresses
              </div>
            </div>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 dark:text-teal-400 group-hover:text-teal-800 dark:group-hover:text-white transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </a>

        <!-- Board Printable Packet -->
        <a
          href="/internal/board/print/"
          target="_blank"
          class="flex items-center justify-between p-3 rounded-2xl bg-slate-50 dark:bg-[#0b2420] hover:bg-teal-50 dark:hover:bg-teal-900/60 border border-slate-200 dark:border-teal-800/80 transition group"
        >
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-teal-50 text-teal-800 border border-teal-200 dark:bg-teal-950 dark:text-teal-300 dark:border-teal-800/80 flex items-center justify-center shadow-xs">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                <rect width="12" height="8" x="6" y="14"></rect>
              </svg>
            </div>
            <div>
              <div class="font-bold text-slate-900 dark:text-white group-hover:text-teal-800 dark:group-hover:text-teal-200 text-xs">
                Board Financials Print Packet
              </div>
              <div class="text-[11px] text-slate-500 dark:text-slate-300">
                Executive monthly statement &amp; bank reconciliation
              </div>
            </div>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 dark:text-teal-400 group-hover:text-teal-800 dark:group-hover:text-white transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </a>

        <!-- Bank Statement Reconciliation Viewer -->
        <a
          href="/internal/board/#bank-statement-viewer"
          data-astro-prefetch="hover"
          class="flex items-center justify-between p-3 rounded-2xl bg-slate-50 dark:bg-[#0b2420] hover:bg-teal-50 dark:hover:bg-teal-900/60 border border-slate-200 dark:border-teal-800/80 transition group"
        >
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-teal-50 text-teal-800 border border-teal-200 dark:bg-teal-900 dark:text-teal-200 dark:border-teal-700 flex items-center justify-center shadow-xs">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
            </div>
            <div>
              <div class="font-bold text-slate-900 dark:text-white group-hover:text-teal-800 dark:group-hover:text-teal-200 text-xs">
                Bank Statement &amp; Audit Scans
              </div>
              <div class="text-[11px] text-slate-500 dark:text-teal-300/70">
                First Merchants dual-PDF reconciliation
              </div>
            </div>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 dark:text-teal-400 group-hover:text-teal-800 dark:group-hover:text-white transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </a>

        <!-- Public Website Link -->
        <a
          href="/"
          data-astro-reload
          class="flex items-center justify-between p-3 rounded-2xl bg-slate-50 dark:bg-[#0b2420] hover:bg-teal-50 dark:hover:bg-teal-900/60 border border-slate-200 dark:border-teal-800/80 transition group"
        >
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-teal-50 text-teal-800 border border-teal-200 dark:bg-teal-950 dark:text-teal-300 dark:border-teal-800 flex items-center justify-center shadow-xs">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
            </div>
            <div>
              <div class="font-bold text-slate-900 dark:text-white group-hover:text-teal-800 dark:group-hover:text-teal-200 text-xs">
                Return to Public Website
              </div>
              <div class="text-[11px] text-slate-500 dark:text-teal-300/70">
                monroe-humane.org home page
              </div>
            </div>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 dark:text-teal-400 group-hover:text-teal-800 dark:group-hover:text-white transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </a>
      </div>

      <!-- User Info & Sign Out Footer -->
      <div class="sheet-user-footer p-4 bg-slate-50 dark:bg-[#051311] border-t border-slate-200 dark:border-teal-900/80 flex items-center justify-between">
        <div class="flex items-center gap-2.5 min-w-0">
          <div id="sheet-user-avatar" class="sheet-user-avatar w-8 h-8 rounded-full bg-teal-800 text-white flex items-center justify-center font-bold text-xs shrink-0 shadow-inner">
            SP
          </div>
          <div class="min-w-0">
            <div class="sheet-user-label text-[10px] text-slate-500 dark:text-teal-400/80 font-bold uppercase tracking-wider">Signed In</div>
            <div id="sheet-user-email" class="sheet-user-email text-xs font-bold text-slate-900 dark:text-white truncate">
              staff@monroe-humane.org
            </div>
          </div>
        </div>

        <button
          type="button"
          id="sheet-logout-btn"
          class="sheet-logout-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-rose-950/70 text-rose-600 dark:text-rose-300 hover:bg-rose-50 dark:hover:bg-rose-900 hover:text-rose-800 dark:hover:text-white border border-rose-200 dark:border-rose-800/80 transition cursor-pointer shrink-0 shadow-xs"
        >
          Sign Out
        </button>
      </div>
    </div>
  </div>
</dialog>

<script>
  import { getStaffTheme, setStaffTheme } from '../../lib/staff-theme';
  import { logoutStaff } from '../../lib/staff-auth';
  import {
    forgetPwaInstalled,
    isStandaloneDisplay,
    markPwaDisplay,
    rememberPwaInstalled,
    shouldHideInstallCard,
  } from '../../lib/staff-pwa';

  function setupMobileMoreSheet() {
    const sheetDialog = document.getElementById('mobile-more-sheet') as HTMLDialogElement | null;
    const panel = document.getElementById('mobile-more-sheet-panel');
    const closeBtn = document.getElementById('close-mobile-more-sheet-btn');
    const sheetLogoutBtn = document.getElementById('sheet-logout-btn');
    const handle = document.getElementById('mobile-more-sheet-handle');
    const backdrop = document.getElementById('mobile-more-sheet-backdrop');

    if (!sheetDialog || sheetDialog.dataset.sheetReady === '1') return;
    sheetDialog.dataset.sheetReady = '1';

    // Nav switch controls inside sheet
    const bottomBarBtn = document.getElementById('sheet-set-bottom-bar-btn');
    const hamburgerBtn = document.getElementById('sheet-set-hamburger-btn');
    const modeIndicator = document.getElementById('sheet-nav-mode-indicator');

    function syncNavModeUI() {
      const current = document.documentElement.getAttribute('data-nav-style') || localStorage.getItem('monroe-nav-pref') || 'bottom-bar';
      if (modeIndicator) {
        modeIndicator.textContent = current === 'bottom-bar' ? 'Bottom Dock' : 'Hamburger';
      }
      bottomBarBtn?.setAttribute('data-active', current === 'bottom-bar' ? 'true' : 'false');
      hamburgerBtn?.setAttribute('data-active', current === 'hamburger' ? 'true' : 'false');
    }

    // Theme switch controls inside sheet
    const lightThemeBtn = document.getElementById('sheet-set-light-theme-btn');
    const darkThemeBtn = document.getElementById('sheet-set-dark-theme-btn');
    const themeIndicator = document.getElementById('sheet-theme-indicator');

    function syncThemeModeUI() {
      const current = getStaffTheme();
      if (themeIndicator) {
        themeIndicator.textContent = current === 'light' ? 'Light Monroe' : 'Dark Ops';
      }
      lightThemeBtn?.setAttribute('data-active', current === 'light' ? 'true' : 'false');
      darkThemeBtn?.setAttribute('data-active', current === 'dark' ? 'true' : 'false');
    }

    if (lightThemeBtn && lightThemeBtn.dataset.bound !== '1') {
      lightThemeBtn.dataset.bound = '1';
      lightThemeBtn.addEventListener('click', () => {
        setStaffTheme('light');
        syncThemeModeUI();
      });
    }

    if (darkThemeBtn && darkThemeBtn.dataset.bound !== '1') {
      darkThemeBtn.dataset.bound = '1';
      darkThemeBtn.addEventListener('click', () => {
        setStaffTheme('dark');
        syncThemeModeUI();
      });
    }

    if (bottomBarBtn && bottomBarBtn.dataset.bound !== '1') {
      bottomBarBtn.dataset.bound = '1';
      bottomBarBtn.addEventListener('click', () => {
        localStorage.setItem('monroe-nav-pref', 'bottom-bar');
        document.documentElement.setAttribute('data-nav-style', 'bottom-bar');
        syncNavModeUI();
      });
    }

    if (hamburgerBtn && hamburgerBtn.dataset.bound !== '1') {
      hamburgerBtn.dataset.bound = '1';
      hamburgerBtn.addEventListener('click', () => {
        localStorage.setItem('monroe-nav-pref', 'hamburger');
        document.documentElement.setAttribute('data-nav-style', 'hamburger');
        syncNavModeUI();
      });
    }

    function openSheet() {
      if (!sheetDialog || !panel) return;
      syncNavModeUI();
      syncThemeModeUI();
      void syncInstallCard();
      sheetDialog.showModal();
      requestAnimationFrame(() => {
        panel.classList.remove('translate-y-full');
        panel.classList.add('translate-y-0');
      });

      // Sync user email
      const email = localStorage.getItem('mchs_staff_user') || sessionStorage.getItem('mchs_staff_user') || 'staff@monroe-humane.org';
      const emailEl = document.getElementById('sheet-user-email');
      const avatarEl = document.getElementById('sheet-user-avatar');
      if (emailEl) emailEl.textContent = email;
      if (avatarEl && email) {
        const parts = email.split('@')[0].split(/[._-]/);
        const initials = (parts.length > 1 ? parts[0][0] + parts[1][0] : parts[0].slice(0, 2)).toUpperCase();
        avatarEl.textContent = initials;
      }
    }

    function closeSheet() {
      if (!sheetDialog || !panel) return;
      panel.classList.remove('translate-y-0');
      panel.classList.add('translate-y-full');
      setTimeout(() => {
        if (sheetDialog.open) {
          sheetDialog.close();
        }
      }, 250);
    }

    // Expose open and close globally
    (window as any).openMobileMoreSheet = openSheet;
    (window as any).closeMobileMoreSheet = closeSheet;

    if (closeBtn && closeBtn.dataset.bound !== '1') {
      closeBtn.dataset.bound = '1';
      closeBtn.addEventListener('click', closeSheet);
    }
    if (handle && handle.dataset.bound !== '1') {
      handle.dataset.bound = '1';
      handle.addEventListener('click', closeSheet);
    }

    if (backdrop && backdrop.dataset.bound !== '1') {
      backdrop.dataset.bound = '1';
      backdrop.addEventListener('click', (e) => {
        if (e.target === backdrop) {
          closeSheet();
        }
      });
    }

    // Swipe-down touch dismiss for More Sheet
    if (panel && panel.dataset.swipeBound !== '1') {
      panel.dataset.swipeBound = '1';
      let touchStartY = 0;
      panel.addEventListener('touchstart', (e) => {
        touchStartY = e.touches[0].clientY;
      }, { passive: true });

      panel.addEventListener('touchend', (e) => {
        const deltaY = e.changedTouches[0].clientY - touchStartY;
        // If swiping down from top of sheet
        if (deltaY > 50 && panel.scrollTop <= 5) {
          closeSheet();
        }
      }, { passive: true });
    }

    // Connect logout
    if (sheetLogoutBtn && sheetLogoutBtn.dataset.bound !== '1') {
      sheetLogoutBtn.dataset.bound = '1';
      sheetLogoutBtn.addEventListener('click', async () => {
        closeSheet();
        await logoutStaff();
      });
    }

    function getDeferredPrompt(): any {
      return (window as any).__pwaInstallPrompt || null;
    }

    function setDeferredPrompt(value: any) {
      (window as any).__pwaInstallPrompt = value;
    }

    function isIos(): boolean {
      const ua = navigator.userAgent || '';
      return /iPad|iPhone|iPod/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    }

    async function syncInstallCard() {
      const installContainer = document.getElementById('pwa-install-container');
      const installBtn = document.getElementById('pwa-install-btn');
      const installDesc = document.getElementById('pwa-install-desc');
      if (!installContainer) return;
      markPwaDisplay();
      const hide = await shouldHideInstallCard();
      if (hide) {
        installContainer.classList.add('hidden');
        installContainer.setAttribute('data-pwa-state', isStandaloneDisplay() ? 'standalone' : 'installed');
        return;
      }
      installContainer.classList.remove('hidden');
      if (isIos()) {
        installContainer.setAttribute('data-pwa-state', 'ios');
        if (installDesc) installDesc.textContent = 'iPhone: Share → Add to Home Screen';
        if (installBtn) installBtn.textContent = 'How';
      } else if (getDeferredPrompt()) {
        installContainer.setAttribute('data-pwa-state', 'ready');
        if (installDesc) installDesc.textContent = 'Home screen icon & offline census';
        if (installBtn) installBtn.textContent = 'Install';
      } else {
        installContainer.setAttribute('data-pwa-state', 'hint');
        if (installDesc) installDesc.textContent = 'Home screen icon & offline census';
        if (installBtn) installBtn.textContent = 'Install';
      }
    }

    void syncInstallCard();

    const installBtn = document.getElementById('pwa-install-btn');

    if (!(window as any).__hsmcPwaListenersBound) {
      (window as any).__hsmcPwaListenersBound = true;
      ['standalone', 'fullscreen', 'minimal-ui', 'window-controls-overlay'].forEach((mode) => {
        const mq = window.matchMedia(`(display-mode: ${mode})`);
        const onChange = () => { void syncInstallCard(); };
        if (typeof mq.addEventListener === 'function') mq.addEventListener('change', onChange);
        else (mq as any).addListener?.(onChange);
      });

      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        forgetPwaInstalled();
        setDeferredPrompt(e);
        void syncInstallCard();
      });

      window.addEventListener('appinstalled', () => {
        rememberPwaInstalled();
        setDeferredPrompt(null);
        void syncInstallCard();
      });
    }

    if (installBtn && installBtn.dataset.bound !== '1') {
      installBtn.dataset.bound = '1';
      installBtn.addEventListener('click', async () => {
        const promptEvent = getDeferredPrompt();
        if (promptEvent) {
          promptEvent.prompt();
          const choice = await promptEvent.userChoice;
          if (choice.outcome === 'accepted') {
            rememberPwaInstalled();
            document.getElementById('pwa-install-container')?.classList.add('hidden');
          }
          setDeferredPrompt(null);
          return;
        }
        const installDesc = document.getElementById('pwa-install-desc');
        if (installDesc) {
          installDesc.textContent = isIos()
            ? 'Tap Share, then Add to Home Screen'
            : 'Browser menu → Install app (Chrome or Edge)';
        }
      });
    }
  }

  document.addEventListener('astro:page-load', setupMobileMoreSheet);
  if (document.readyState !== 'loading') {
    setupMobileMoreSheet();
  } else {
    document.addEventListener('DOMContentLoaded', setupMobileMoreSheet);
  }
</script>
