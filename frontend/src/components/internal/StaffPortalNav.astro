---
interface Props {
  activeTab?: 'petsync' | 'pets' | 'financials' | 'grants' | 'donors' | 'overview' | 'content';
}

const { activeTab = 'overview' } = Astro.props;

const directusAdminUrl = 'https://mchs-directus.livelyfield-d0a70609.eastus.azurecontainerapps.io/admin';
---

<header class="staff-portal-header bg-[#061815]/95 backdrop-blur-md text-white border-b border-teal-800/80 sticky top-0 z-40 shadow-lg shadow-teal-950/20 transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
    <div class="flex items-center justify-between gap-3">
      <!-- Brand & Title -->
      <a href="/internal/" class="flex items-center gap-2.5 group">
        <div class="p-2 rounded-xl bg-teal-900/60 text-emerald-300 border border-teal-700/80 shadow-md group-hover:border-emerald-500/50 group-hover:bg-teal-900 transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="text-sm sm:text-base font-bold text-white tracking-tight group-hover:text-emerald-300 transition">
              Monroe Humane
            </span>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
              Staff Portal
            </span>
          </div>
        </div>
      </a>

      <!-- Right Controls: Status, Nav Preference, User Menu & Mobile Hamburger -->
      <div class="flex items-center gap-2 sm:gap-2.5 text-xs">
        <!-- Live status (hidden on small mobile) -->
        <div class="hidden lg:flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-teal-950/80 border border-teal-800 text-teal-200">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>CMS: <strong class="text-white font-medium">Online</strong></span>
        </div>
        <div class="hidden xl:flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-teal-950/80 border border-teal-800 text-teal-200">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>PetSync: <strong class="text-white font-medium">Every 30m</strong></span>
        </div>

        <!-- Public site return -->
        <a
          href="/"
          data-astro-reload
          class="hidden md:inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-teal-950/60 hover:bg-teal-900 text-teal-200 hover:text-white transition border border-teal-800/80"
          title="Return to Public Website"
        >
          &larr; Public Site
        </a>

        <!-- Mobile/Tablet Navigation Style Toggle Cogwheel -->
        <button
          id="staff-nav-pref-toggle-btn"
          type="button"
          class="lg:hidden inline-flex items-center justify-center p-2 rounded-lg text-teal-200 hover:text-white bg-teal-950/60 hover:bg-teal-900 border border-teal-800/80 transition cursor-pointer"
          title="Change Mobile Navigation Style (Bottom Bar vs Hamburger)"
          aria-label="Change Mobile Navigation Style"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </button>

        <!-- User Profile Pill -->
        <div class="flex items-center gap-2 pl-2 border-l border-teal-800/80">
          <div
            id="nav-user-avatar"
            class="w-7 h-7 rounded-full bg-emerald-600 text-emerald-100 flex items-center justify-center font-bold text-xs shadow-inner flex-shrink-0"
            title="Authenticated Staff Member"
          >
            SP
          </div>
          <span
            id="nav-user-email"
            class="hidden lg:inline text-xs text-teal-200 max-w-[140px] truncate"
            title="Signed in user"
          >
            staff@monroe-humane.org
          </span>
          <button
            id="global-staff-logout-btn"
            type="button"
            class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-rose-950/60 hover:bg-rose-900 text-rose-300 hover:text-white transition border border-rose-800/70 shadow-xs cursor-pointer"
            title="Sign out of Staff Portal"
          >
            <span id="logout-btn-text" class="hidden sm:inline">Sign Out</span>
            <svg id="logout-btn-icon" xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <svg id="logout-btn-spinner" class="hidden animate-spin h-3.5 w-3.5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </button>
        </div>

        <!-- Mobile Drawer Toggle Button (Visible when data-nav-style="hamburger") -->
        <button
          id="mobile-nav-toggle-btn"
          type="button"
          class="md:hidden p-2 rounded-lg bg-teal-950/80 text-teal-200 hover:text-white border border-teal-800 focus:outline-none cursor-pointer"
          aria-label="Toggle Staff Navigation Menu"
          aria-expanded="false"
        >
          <svg id="hamburger-icon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Desktop Navigation Tabs -->
    <nav class="hidden md:flex flex-wrap items-center gap-1.5 mt-2.5 pt-2.5 border-t border-teal-800/80" aria-label="Staff Portal Modules">
      <a
        href="/internal/"
        data-astro-prefetch="hover"
        data-nav-tab="overview"
        class={`staff-nav-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition ${
          activeTab === 'overview'
            ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-xs font-bold'
            : 'bg-teal-950/60 text-teal-200/90 hover:bg-teal-900 hover:text-white border border-teal-800/70'
        }`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="7" height="9" x="3" y="3" rx="1"></rect>
          <rect width="7" height="5" x="14" y="3" rx="1"></rect>
          <rect width="7" height="9" x="14" y="12" rx="1"></rect>
          <rect width="7" height="5" x="3" y="16" rx="1"></rect>
        </svg>
        Overview
      </a>

      <a
        href="/internal/pets/"
        data-astro-prefetch="hover"
        data-nav-tab="petsync"
        class={`staff-nav-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition ${
          activeTab === 'petsync' || activeTab === 'pets'
            ? 'bg-amber-500/20 text-amber-300 border border-amber-500/40 shadow-xs font-bold'
            : 'bg-teal-950/60 text-teal-200/90 hover:bg-teal-900 hover:text-white border border-teal-800/70'
        }`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-amber-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="m10 15 5-3-5-3v6Z"></path>
        </svg>
        Shelter Animals & Census
      </a>

      <a
        href="/internal/board/"
        data-astro-prefetch="hover"
        data-nav-tab="financials"
        class={`staff-nav-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition ${
          activeTab === 'financials'
            ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-xs font-bold'
            : 'bg-teal-950/60 text-teal-200/90 hover:bg-teal-900 hover:text-white border border-teal-800/70'
        }`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="1" x2="12" y2="23"></line>
          <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
        </svg>
        Board Financials & Treasury
      </a>

      <a
        href="/internal/grants/"
        data-astro-prefetch="hover"
        data-nav-tab="grants"
        class={`staff-nav-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition ${
          activeTab === 'grants'
            ? 'bg-purple-500/20 text-purple-300 border border-purple-500/40 shadow-xs font-bold'
            : 'bg-teal-950/60 text-teal-200/90 hover:bg-teal-900 hover:text-white border border-teal-800/70'
        }`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-purple-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
        </svg>
        Grants Pipeline
      </a>

      <a
        href="/internal/donors/"
        data-astro-prefetch="hover"
        data-nav-tab="donors"
        class={`staff-nav-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition ${
          activeTab === 'donors'
            ? 'bg-rose-500/20 text-rose-300 border border-rose-500/40 shadow-xs font-bold'
            : 'bg-teal-950/60 text-teal-200/90 hover:bg-teal-900 hover:text-white border border-teal-800/70'
        }`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-rose-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
        </svg>
        Donors & Giving
      </a>

      <a
        href="/internal/content/"
        data-astro-prefetch="hover"
        data-nav-tab="content"
        class={`staff-nav-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition ${
          activeTab === 'content'
            ? 'bg-amber-500/20 text-amber-200 border border-amber-500/40 shadow-xs font-bold'
            : 'bg-teal-950/60 text-teal-200/90 hover:bg-teal-900 hover:text-white border border-teal-800/70'
        }`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-amber-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 20h9"></path>
          <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
        </svg>
        Site Content
      </a>

      <a
        href={directusAdminUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-teal-950/60 text-teal-200/90 hover:bg-teal-900 hover:text-white border border-teal-800/70 transition ml-auto"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
        <span>Directus Console</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-teal-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
      </a>
    </nav>

    <!-- Mobile Drawer Menu (Collapsible when in Hamburger mode) -->
    <nav
      id="mobile-nav-drawer"
      class="hidden md:hidden pt-3 pb-2 space-y-1.5 border-t border-teal-800/80 mt-2.5 transition-all duration-200"
      aria-label="Mobile Staff Modules"
    >
      <a
        href="/internal/"
        data-astro-prefetch="hover"
        class={`flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition ${
          activeTab === 'overview'
            ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold'
            : 'bg-teal-950/60 text-teal-200/90 hover:bg-teal-900 border border-teal-800/70'
        }`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect width="7" height="9" x="3" y="3" rx="1"></rect>
          <rect width="7" height="5" x="14" y="3" rx="1"></rect>
          <rect width="7" height="9" x="14" y="12" rx="1"></rect>
          <rect width="7" height="5" x="3" y="16" rx="1"></rect>
        </svg>
        Overview Hub
      </a>

      <a
        href="/internal/pets/"
        data-astro-prefetch="hover"
        class={`flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition ${
          activeTab === 'petsync' || activeTab === 'pets'
            ? 'bg-amber-500/20 text-amber-300 border border-amber-500/30 font-bold'
            : 'bg-teal-950/60 text-teal-200/90 hover:bg-teal-900 border border-teal-800/70'
        }`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="m10 15 5-3-5-3v6Z"></path>
        </svg>
        Shelter Animals & Census
      </a>

      <a
        href="/internal/board/"
        data-astro-prefetch="hover"
        class={`flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition ${
          activeTab === 'financials'
            ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold'
            : 'bg-teal-950/60 text-teal-200/90 hover:bg-teal-900 border border-teal-800/70'
        }`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="1" x2="12" y2="23"></line>
          <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
        </svg>
        Board Financials & Treasury
      </a>

      <a
        href="/internal/grants/"
        data-astro-prefetch="hover"
        class={`flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition ${
          activeTab === 'grants'
            ? 'bg-purple-500/20 text-purple-300 border border-purple-500/30 font-bold'
            : 'bg-teal-950/60 text-teal-200/90 hover:bg-teal-900 border border-teal-800/70'
        }`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-purple-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
        </svg>
        Grants Pipeline
      </a>

      <a
        href="/internal/donors/"
        data-astro-prefetch="hover"
        class={`flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition ${
          activeTab === 'donors'
            ? 'bg-rose-500/20 text-rose-300 border border-rose-500/30 font-bold'
            : 'bg-teal-950/60 text-teal-200/90 hover:bg-teal-900 border border-teal-800/70'
        }`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-rose-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
        </svg>
        Donors & Giving
      </a>

      <a
        href="/internal/content/"
        data-astro-prefetch="hover"
        class={`flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition ${
          activeTab === 'content'
            ? 'bg-amber-500/20 text-amber-200 border border-amber-500/30 font-bold'
            : 'bg-teal-950/60 text-teal-200/90 hover:bg-teal-900 border border-teal-800/70'
        }`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 20h9"></path>
          <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
        </svg>
        Site Content
      </a>

      <div class="pt-2.5 border-t border-teal-800/80 flex items-center justify-between text-xs text-teal-200 px-1">
        <a href="/" data-astro-reload class="hover:text-white transition">
          &larr; Public Site
        </a>
        <button
          type="button"
          id="drawer-nav-style-btn"
          class="text-emerald-300 hover:text-emerald-200 cursor-pointer font-medium"
        >
          ⚙️ Nav Style
        </button>
        <a href={directusAdminUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white transition">
          Directus CMS ↗
        </a>
      </div>
    </nav>
  </div>
</header>

<!-- Staff Navigation Style Preference Modal -->
<dialog id="staff-nav-settings-dialog" class="staff-settings-dialog backdrop:bg-black/70 backdrop:backdrop-blur-md border-none p-0 rounded-3xl bg-transparent">
  <div class="w-full max-w-sm sm:max-w-md bg-[#0b2420] text-white rounded-3xl border border-teal-700/80 shadow-2xl p-5 sm:p-6 space-y-4">
    <div class="flex items-center justify-between pb-3 border-b border-teal-800">
      <div class="flex items-center gap-2.5">
        <span class="w-8 h-8 rounded-xl bg-teal-900/80 text-emerald-300 border border-teal-700 flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
          </svg>
        </span>
        <h3 class="text-base font-bold text-white tracking-tight">Staff Navigation Style</h3>
      </div>
      <button
        type="button"
        id="staff-nav-settings-close-btn"
        class="w-8 h-8 rounded-full flex items-center justify-center text-teal-300 hover:text-white hover:bg-teal-900 transition cursor-pointer"
        aria-label="Close settings"
      >
        &times;
      </button>
    </div>

    <form method="dialog" class="space-y-3">
      <p class="text-xs text-teal-200/80 leading-relaxed">
        Choose how you want to navigate the Staff &amp; Board Portal on mobile and tablet screens. Changes apply instantly.
      </p>

      <div class="space-y-2.5">
        <!-- Option 1: App-Like Bottom Tab Bar -->
        <label class="staff-nav-choice flex items-start gap-3 p-3.5 rounded-2xl border border-teal-800/80 bg-teal-950/40 hover:bg-teal-900/60 hover:border-emerald-500/50 cursor-pointer transition">
          <input
            type="radio"
            name="staff-nav-type"
            value="bottom-bar"
            class="mt-1 text-emerald-500 focus:ring-emerald-400 h-4 w-4 bg-teal-900 border-teal-700"
          />
          <div class="flex-1 text-left">
            <div class="text-xs font-bold text-white flex items-center gap-1.5">
              <span>App-Like (Bottom Tab Bar)</span>
              <span class="px-1.5 py-0.5 rounded text-[9px] font-bold uppercase bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">Recommended</span>
            </div>
            <div class="text-[11px] text-teal-300/80 mt-1">
              Fixed thumb dock with Hub, Animals, Finance, Grants, and slide-up More sheet.
            </div>
          </div>
        </label>

        <!-- Option 2: Standard Hamburger Menu -->
        <label class="staff-nav-choice flex items-start gap-3 p-3.5 rounded-2xl border border-teal-800/80 bg-teal-950/40 hover:bg-teal-900/60 hover:border-emerald-500/50 cursor-pointer transition">
          <input
            type="radio"
            name="staff-nav-type"
            value="hamburger"
            class="mt-1 text-emerald-500 focus:ring-emerald-400 h-4 w-4 bg-teal-900 border-teal-700"
          />
          <div class="flex-1 text-left">
            <div class="text-xs font-bold text-white">Standard (Hamburger Menu)</div>
            <div class="text-[11px] text-teal-300/80 mt-1">
              Classic top drawer toggle without bottom dock.
            </div>
          </div>
        </label>
      </div>

      <div class="pt-3 border-t border-teal-800/80 flex justify-end">
        <button
          type="submit"
          class="px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-slate-950 font-bold text-xs uppercase tracking-wider transition cursor-pointer shadow-md"
        >
          Done
        </button>
      </div>
    </form>
  </div>
</dialog>

<script>
  import { logoutStaff, getStaffUserEmail } from '../../lib/staff-auth';

  function initStaffNav() {
    // 1. Hydrate User Info
    const email = getStaffUserEmail();
    const emailEl = document.getElementById('nav-user-email');
    const avatarEl = document.getElementById('nav-user-avatar');
    if (emailEl && email) {
      emailEl.textContent = email;
    }
    if (avatarEl && email) {
      const parts = email.split('@')[0].split(/[._-]/);
      let initials = 'SP';
      if (parts.length >= 2) {
        initials = (parts[0][0] + parts[1][0]).toUpperCase();
      } else if (parts.length === 1 && parts[0].length >= 2) {
        initials = parts[0].slice(0, 2).toUpperCase();
      }
      avatarEl.textContent = initials;
    }

    // 2. Mobile Drawer Toggle & Touch Swipe Dismissal
    const headerEl = document.querySelector('.staff-portal-header');
    const mobileBtn = document.getElementById('mobile-nav-toggle-btn');
    const drawer = document.getElementById('mobile-nav-drawer');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (mobileBtn && drawer && mobileBtn.dataset.bound !== '1') {
      mobileBtn.dataset.bound = '1';
      mobileBtn.addEventListener('click', () => {
        const isHidden = drawer.classList.toggle('hidden');
        mobileBtn.setAttribute('aria-expanded', String(!isHidden));
        hamburgerIcon?.classList.toggle('hidden', !isHidden);
        closeIcon?.classList.toggle('hidden', isHidden);
        headerEl?.classList.toggle('is-drawer-open', !isHidden);
      });

      // Swipe-up touch dismiss for drawer
      let touchStartY = 0;
      drawer.addEventListener('touchstart', (e) => {
        touchStartY = e.touches[0].clientY;
      }, { passive: true });
      drawer.addEventListener('touchend', (e) => {
        const deltaY = e.changedTouches[0].clientY - touchStartY;
        if (deltaY < -40) { // Swiped up
          drawer.classList.add('hidden');
          mobileBtn.setAttribute('aria-expanded', 'false');
          hamburgerIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
          headerEl?.classList.remove('is-drawer-open');
        }
      }, { passive: true });
    }

    // 3. Navigation Style Preference Dialog
    const prefBtn = document.getElementById('staff-nav-pref-toggle-btn');
    const drawerPrefBtn = document.getElementById('drawer-nav-style-btn');
    const dialog = document.getElementById('staff-nav-settings-dialog') as HTMLDialogElement | null;
    const dialogCloseBtn = document.getElementById('staff-nav-settings-close-btn');
    const radios = document.querySelectorAll<HTMLInputElement>('input[name="staff-nav-type"]');

    function syncRadioState() {
      const current = document.documentElement.getAttribute('data-nav-style') || localStorage.getItem('monroe-nav-pref') || 'bottom-bar';
      radios.forEach((r) => {
        r.checked = r.value === current;
      });
    }

    function openPrefDialog() {
      if (!dialog) return;
      syncRadioState();
      dialog.showModal();
    }

    if (prefBtn && prefBtn.dataset.bound !== '1') {
      prefBtn.dataset.bound = '1';
      prefBtn.addEventListener('click', openPrefDialog);
    }
    if (drawerPrefBtn && drawerPrefBtn.dataset.bound !== '1') {
      drawerPrefBtn.dataset.bound = '1';
      drawerPrefBtn.addEventListener('click', () => {
        drawer?.classList.add('hidden');
        mobileBtn?.setAttribute('aria-expanded', 'false');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
        headerEl?.classList.remove('is-drawer-open');
        openPrefDialog();
      });
    }
    if (dialogCloseBtn && dialog && dialogCloseBtn.dataset.bound !== '1') {
      dialogCloseBtn.dataset.bound = '1';
      dialogCloseBtn.addEventListener('click', () => dialog.close());
    }

    radios.forEach((radio) => {
      radio.addEventListener('change', () => {
        if (radio.checked) {
          const val = radio.value;
          localStorage.setItem('monroe-nav-pref', val);
          document.documentElement.setAttribute('data-nav-style', val);
        }
      });
    });

    // 4. Scroll-Aware Screen Maximizing (Hides nav on scroll down, reveals on scroll up)
    let lastScrollY = window.scrollY;
    window.addEventListener('scroll', () => {
      if (window.innerWidth > 1024) {
        document.documentElement.classList.remove('monroe-nav-hidden');
        return;
      }
      const isDrawerOpen = drawer && !drawer.classList.contains('hidden');
      const isAnyDialogOpen = Boolean(document.querySelector('dialog[open]'));
      if (isDrawerOpen || isAnyDialogOpen) return;

      const currentScrollY = window.scrollY;
      if (currentScrollY > 60 && currentScrollY > lastScrollY + 8) {
        document.documentElement.classList.add('monroe-nav-hidden');
      } else if (currentScrollY < lastScrollY - 8 || currentScrollY <= 60) {
        document.documentElement.classList.remove('monroe-nav-hidden');
      }
      lastScrollY = currentScrollY;
    }, { passive: true });

    // 5. Logout Debounce & Spinner
    const logoutBtn = document.getElementById('global-staff-logout-btn') as HTMLButtonElement | null;
    const logoutText = document.getElementById('logout-btn-text');
    const logoutIcon = document.getElementById('logout-btn-icon');
    const logoutSpinner = document.getElementById('logout-btn-spinner');

    if (logoutBtn && logoutBtn.dataset.bound !== '1') {
      logoutBtn.dataset.bound = '1';
      logoutBtn.addEventListener('click', async () => {
        logoutBtn.disabled = true;
        if (logoutText) logoutText.textContent = 'Signing out...';
        logoutIcon?.classList.add('hidden');
        logoutSpinner?.classList.remove('hidden');
        await logoutStaff();
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStaffNav);
  } else {
    initStaffNav();
  }
  document.addEventListener('astro:page-load', initStaffNav);
</script>
