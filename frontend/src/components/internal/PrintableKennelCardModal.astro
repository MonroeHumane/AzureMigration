---
// PrintableKennelCardModal.astro
// Clean, high-contrast, print-optimized kennel & cage card with dynamic QR code
---

<div
  id="kennel-card-modal"
  class="fixed inset-0 z-[100] bg-slate-900/80 backdrop-blur-xs flex items-center justify-center p-2 sm:p-4 overflow-y-auto hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="kennel-modal-title"
>
  <div class="bg-white rounded-2xl shadow-2xl border border-slate-300 max-w-4xl w-full my-8 overflow-hidden flex flex-col">
    <!-- Modal Control Bar (Hidden when printed) -->
    <div class="no-print bg-[#173a39] text-white px-6 py-4 flex flex-wrap items-center justify-between gap-3 border-b border-teal-800">
      <div class="flex items-center gap-2.5">
        <span class="p-1.5 rounded-lg bg-teal-800 text-amber-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
        </span>
        <div>
          <h3 id="kennel-modal-title" class="font-bold text-base text-white leading-tight">
            Printable Kennel / Cage Card
          </h3>
          <p class="text-xs text-teal-200">
            Thermal & laser printer ready · 8.5" × 11" or half-sheet bracket format
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="trigger-print-btn"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg font-bold text-xs bg-emerald-500 hover:bg-emerald-400 text-white shadow-sm transition cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
          Print Card (Ctrl+P)
        </button>

        <button
          type="button"
          id="close-card-modal-btn"
          class="inline-flex items-center px-3 py-2 rounded-lg font-semibold text-xs bg-teal-900/60 hover:bg-teal-900 text-teal-100 transition cursor-pointer"
        >
          ✕ Close
        </button>
      </div>
    </div>

    <!-- Printable Card Container -->
    <div class="p-6 sm:p-8 bg-slate-100 flex justify-center overflow-y-auto max-h-[calc(85vh-80px)]">
      <div
        id="kennel-card-printable-area"
        class="bg-white text-slate-900 border-2 border-slate-800 rounded-xl p-6 sm:p-8 w-full max-w-[800px] shadow-md flex flex-col justify-between"
      >
        <!-- Header: Shelter Identity -->
        <div class="border-b-2 border-slate-900 pb-4 mb-4 flex items-center justify-between">
          <div>
            <span class="text-xs font-black uppercase tracking-widest text-teal-800 block">
              Official Animal Intake & Kennel Card
            </span>
            <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 font-serif">
              HUMANE SOCIETY OF MONROE COUNTY
            </h1>
            <p class="text-xs font-semibold text-slate-600 mt-0.5">
              833 N Telegraph Rd, Monroe, MI 48162 · (734) 243-3669 · monroe-humane.org
            </p>
          </div>
          <div class="text-right">
            <span class="inline-block px-3 py-1 rounded bg-teal-900 text-white font-black text-xs uppercase tracking-wider">
              Ready for Adoption
            </span>
            <div id="card-kennel-location" class="text-xs font-bold text-slate-700 mt-1">
              Location: Main Shelter
            </div>
          </div>
        </div>

        <!-- Main Body: Photo & Primary Attributes -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 my-2 items-start">
          <!-- Pet Photo (5 cols) -->
          <div class="md:col-span-5">
            <div class="aspect-square w-full rounded-lg overflow-hidden border-2 border-slate-900 bg-slate-100 relative shadow-inner">
              <img
                id="card-pet-photo"
                src="/assets/recovered/images/placeholder.svg"
                alt="Shelter pet"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="mt-2 text-center">
              <span class="text-[11px] font-mono font-bold text-slate-500 uppercase tracking-wider block">
                PetPoint ID: #<span id="card-pet-id">00000000</span>
              </span>
            </div>
          </div>

          <!-- Pet Information Details (7 cols) -->
          <div class="md:col-span-7 flex flex-col justify-between h-full space-y-4">
            <div>
              <div class="flex items-baseline justify-between border-b border-slate-300 pb-2">
                <h2 id="card-pet-name" class="text-4xl font-black text-teal-950 font-serif tracking-tight">
                  Pet Name
                </h2>
                <span id="card-pet-gender-age" class="text-sm font-bold text-slate-700">
                  Female · 2 Years
                </span>
              </div>

              <!-- Key Specs Table -->
              <div class="grid grid-cols-2 gap-2 text-xs mt-3 bg-slate-50 p-3 rounded-lg border border-slate-200">
                <div>
                  <span class="text-slate-500 font-semibold block text-[10px] uppercase tracking-wider">Species & Breed</span>
                  <span id="card-pet-breed" class="font-bold text-slate-900 block leading-tight">Domestic Short Hair</span>
                </div>
                <div>
                  <span class="text-slate-500 font-semibold block text-[10px] uppercase tracking-wider">Size & Weight</span>
                  <span id="card-pet-size" class="font-bold text-slate-900 block leading-tight">Medium</span>
                </div>
                <div>
                  <span class="text-slate-500 font-semibold block text-[10px] uppercase tracking-wider">Color & Markings</span>
                  <span id="card-pet-color" class="font-bold text-slate-900 block leading-tight">Black & White</span>
                </div>
                <div>
                  <span class="text-slate-500 font-semibold block text-[10px] uppercase tracking-wider">Intake Date / Care</span>
                  <span id="card-pet-intake" class="font-bold text-slate-900 block leading-tight">Aug 1, 2026 (14d)</span>
                </div>
              </div>
            </div>

            <!-- Certified Shelter Medical & Care Checklist -->
            <div class="space-y-1.5">
              <span class="text-[10px] font-black uppercase tracking-wider text-slate-500 block">
                Veterinary & Care Protocol Completed:
              </span>
              <div class="grid grid-cols-2 gap-1.5 text-xs font-bold text-slate-800">
                <div class="flex items-center gap-1.5">
                  <span class="text-emerald-700 font-black">✓</span>
                  <span>Spayed / Neutered</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="text-emerald-700 font-black">✓</span>
                  <span>Core Vaccines / Rabies</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="text-emerald-700 font-black">✓</span>
                  <span>Microchipped</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="text-emerald-700 font-black">✓</span>
                  <span>Flea / Tick / Heartworm</span>
                </div>
              </div>
            </div>

            <!-- Floor & Behavior Notes Box -->
            <div class="p-2.5 rounded-lg border border-dashed border-slate-400 bg-amber-50/50 text-xs">
              <span class="text-[10px] font-bold uppercase tracking-wider text-amber-900 block mb-0.5">
                Kennel Notes & Personality:
              </span>
              <p id="card-pet-notes" class="text-slate-700 text-[11px] leading-relaxed line-clamp-3">
                Sweet, friendly companion ready for a forever home. Walked daily by volunteers.
              </p>
            </div>
          </div>
        </div>

        <!-- Footer: Scan to Adopt QR Code Section -->
        <div class="border-t-2 border-slate-900 pt-4 mt-4 flex items-center justify-between gap-4 bg-slate-50 p-4 rounded-lg border border-slate-300">
          <div class="flex-1">
            <span class="inline-block px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300 mb-1">
              Smartphone Scan
            </span>
            <h4 class="text-base sm:text-lg font-black text-slate-900 leading-tight">
              Interested in Adopting Me?
            </h4>
            <p class="text-xs text-slate-600 mt-1 leading-normal">
              Scan this QR code with your smartphone camera to read my full profile, view more photos, and submit an adoption application immediately!
            </p>
            <p class="text-[10px] font-mono text-slate-400 mt-1" id="card-direct-url">
              https://monroe-humane.org/adopt
            </p>
          </div>

          <!-- Dynamic High-Contrast QR Code Element -->
          <div class="w-28 h-28 sm:w-32 sm:h-32 bg-white p-1 rounded-lg border-2 border-slate-900 flex items-center justify-center shrink-0" id="card-qr-container">
            <!-- QR code rendered dynamically via QRCodeStyling -->
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  @media print {
    /* Hide everything on the page */
    body {
      background: white !important;
      color: black !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    body * {
      visibility: hidden;
    }

    /* Make printable card and its descendants visible */
    #kennel-card-modal,
    #kennel-card-printable-area,
    #kennel-card-printable-area * {
      visibility: visible;
    }

    #kennel-card-modal {
      position: static !important;
      background: transparent !important;
      padding: 0 !important;
      margin: 0 !important;
      display: block !important;
    }

    #kennel-card-printable-area {
      position: absolute !important;
      left: 0 !important;
      top: 0 !important;
      width: 100% !important;
      max-width: 100% !important;
      border: 2px solid #000 !important;
      box-shadow: none !important;
      margin: 0 !important;
      padding: 20px !important;
    }

    .no-print {
      display: none !important;
    }

    @page {
      size: letter portrait;
      margin: 0.4in;
    }
  }
</style>
