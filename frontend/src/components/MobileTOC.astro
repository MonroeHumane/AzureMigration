---
// src/components/MobileTOC.astro
// Pass your array of sections as a prop, shared with your desktop sidebar
interface Section {
  id: string;
  title: string;
}

interface Props {
  sections: Section[];
}

const { sections } = Astro.props; 
---
<!-- The Floating Pill Button -->
<button 
  id="toc-fab" 
  class="hidden max-[1200px]:flex items-center gap-2 fixed left-1/2 -translate-x-1/2 bg-white/95 backdrop-blur-md border border-slate-200 rounded-full px-5 py-2.5 shadow-lg shadow-black/5 z-40 font-semibold text-sm text-teal-700 whitespace-nowrap active:scale-95 transition-transform" 
  style="bottom: calc(80px + env(safe-area-inset-bottom));" 
  data-section-ids={JSON.stringify(sections.map(s => s.id))}
  data-section-titles={JSON.stringify(Object.fromEntries(sections.map(s => [s.id, s.title])))}
  aria-label="Table of Contents"
>
  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <line x1="8" y1="6" x2="21" y2="6"></line>
    <line x1="8" y1="12" x2="21" y2="12"></line>
    <line x1="8" y1="18" x2="21" y2="18"></line>
    <line x1="3" y1="6" x2="3.01" y2="6"></line>
    <line x1="3" y1="12" x2="3.01" y2="12"></line>
    <line x1="3" y1="18" x2="3.01" y2="18"></line>
  </svg>
  <span id="toc-current-section">Events & News</span>
  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="18 15 12 9 6 15"></polyline>
  </svg>
</button>

<!-- The Native Bottom Sheet -->
<dialog id="toc-bottom-sheet" class="toc-bottom-sheet mt-auto mb-0 w-full max-w-full max-h-[70dvh] rounded-t-3xl border-none shadow-[0_-10px_40px_rgba(0,0,0,0.15)] bg-white p-0">
  <div class="flex justify-between items-center px-6 py-5 border-b border-slate-100 sticky top-0 bg-white/95 backdrop-blur-md z-10">
    <h3 class="m-0 text-lg text-teal-900 font-bold">On This Page</h3>
    <button id="close-toc" class="bg-slate-100 border-none text-slate-700 font-semibold px-4 py-2 rounded-full text-sm cursor-pointer hover:bg-slate-200 transition-colors" aria-label="Close">Done</button>
  </div>
  <nav class="overflow-y-auto px-6 pb-8" style="max-height: calc(70dvh - 73px);">
    <ul class="m-0 p-0 list-none">
      {sections.map((section) => (
        <li>
          <a href={`#${section.id}`} data-target={section.id} class="block py-4 border-b border-slate-100 text-slate-600 no-underline text-base font-medium transition-colors hover:text-teal-700 toc-link">
            {section.title}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</dialog>

<script>
  // 1. Bottom Sheet Logic
  const fab = document.getElementById('toc-fab');
  const sheet = document.getElementById('toc-bottom-sheet') as HTMLDialogElement;
  const closeBtn = document.getElementById('close-toc');
  const links = document.querySelectorAll('.toc-link');

  fab?.addEventListener('click', () => sheet?.showModal());
  closeBtn?.addEventListener('click', () => sheet?.close());
  
  // Close sheet when a link is clicked
  links.forEach(link => {
    link.addEventListener('click', () => sheet?.close());
  });

  // Close sheet when clicking backdrop
  sheet?.addEventListener('click', (e) => {
    const dialogDimensions = sheet.getBoundingClientRect();
    if (
      e.clientX < dialogDimensions.left ||
      e.clientX > dialogDimensions.right ||
      e.clientY < dialogDimensions.top ||
      e.clientY > dialogDimensions.bottom
    ) {
      sheet.close();
    }
  });

  // 2. Precision Intersection Observer (ScrollSpy)
  // Only observe elements whose IDs are explicitly listed in sideNavSections.
  // This prevents the FAB label from flickering with random widget/card IDs.
  const currentSectionLabel = document.getElementById('toc-current-section');

  const knownIds: string[] = JSON.parse(fab?.dataset.sectionIds || '[]');
  const sectionTitles: Record<string, string> = JSON.parse(fab?.dataset.sectionTitles || '{}');

  const sectionsElements = knownIds
    .map(id => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  // Trigger when a section enters the top-center band of the viewport
  const observerOptions = { root: null, rootMargin: '-15% 0px -75% 0px', threshold: 0 };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        
        // Update the FAB text to the human-readable title
        if (currentSectionLabel && sectionTitles[id]) {
          currentSectionLabel.textContent = sectionTitles[id];
        }

        // Highlight active link in the bottom sheet list
        const activeLink = document.querySelector(`.toc-link[data-target="${id}"]`);
        links.forEach(l => {
          l.classList.remove('text-teal-700', 'font-bold');
          l.classList.add('text-slate-600', 'font-medium');
        });
        
        if (activeLink) {
          activeLink.classList.remove('text-slate-600', 'font-medium');
          activeLink.classList.add('text-teal-700', 'font-bold');
        }
      }
    });
  }, observerOptions);

  sectionsElements.forEach(sec => observer.observe(sec));
</script>

<style>
  /* Standard Bottom Sheet Styles for Native <dialog> animations */
  .toc-bottom-sheet {
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .toc-bottom-sheet[open] {
    transform: translateY(0);
  }
  .toc-bottom-sheet::backdrop {
    background: rgba(15, 23, 42, 0.4); /* slate-900/40 */
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .toc-bottom-sheet[open]::backdrop {
    opacity: 1;
  }
  
  /* Hide the desktop TOC on mobile if it isn't already */
  @media (max-width: 1200px) {
    :global(.home-side-dock) {
      display: none !important;
    }
  }
</style>
