---
// BottomTabBar.astro: Native app-like bottom navigation dock for mobile devices
import { SITE } from '../config/site';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const isHome = currentPath === '/' || currentPath === '';
const isAdopt = currentPath.startsWith('/adopt') || currentPath.startsWith('/adoptions');
const isEvents = currentPath.startsWith('/events');
const isDonate = currentPath.startsWith('/donate') || currentPath.startsWith('/memorials');
---

<!-- Fixed App-Like Bottom Navigation Dock -->
<nav
  class="monroe-bottom-tab-bar"
  id="monroe-bottom-tab-bar"
  aria-label="Mobile Navigation Dock"
>
  <div class="monroe-bottom-tab-bar__inner">
    <!-- Tab 1: Home (Statically rendered active state) -->
    <a
      href="/"
      class={`monroe-bottom-tab-bar__item ${isHome ? 'is-active' : ''}`}
      aria-current={isHome ? 'page' : undefined}
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      <span>Home</span>
    </a>

    <!-- Tab 2: Adopt (Statically rendered active state) -->
    <a
      href="/adopt"
      class={`monroe-bottom-tab-bar__item ${isAdopt ? 'is-active' : ''}`}
      aria-current={isAdopt ? 'page' : undefined}
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
        <circle cx="12" cy="12" r="3"/>
        <circle cx="6" cy="9" r="2.5"/>
        <circle cx="18" cy="9" r="2.5"/>
        <circle cx="8" cy="16" r="2.5"/>
        <circle cx="16" cy="16" r="2.5"/>
      </svg>
      <span>Adopt</span>
    </a>

    <!-- Tab 3: Events (Statically rendered active state) -->
    <a
      href="/events"
      class={`monroe-bottom-tab-bar__item ${isEvents ? 'is-active' : ''}`}
      aria-current={isEvents ? 'page' : undefined}
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
        <line x1="16" y1="2" x2="16" y2="6"/>
        <line x1="8" y1="2" x2="8" y2="6"/>
        <line x1="3" y1="10" x2="21" y2="10"/>
      </svg>
      <span>Events</span>
    </a>

    <!-- Tab 4: Donate (Statically rendered active state) -->
    <a
      href="/donate"
      class={`monroe-bottom-tab-bar__item ${isDonate ? 'is-active' : ''}`}
      aria-current={isDonate ? 'page' : undefined}
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
      </svg>
      <span>Donate</span>
    </a>

    <!-- Tab 5: Menu / More (Triggers Bottom Sheet) -->
    <button
      type="button"
      id="bottom-tab-menu-btn"
      class="monroe-bottom-tab-bar__item cursor-pointer"
      aria-label="Open site directory bottom sheet"
      aria-haspopup="dialog"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <line x1="4" y1="6" x2="20" y2="6" stroke-linecap="round"/>
        <line x1="4" y1="12" x2="20" y2="12" stroke-linecap="round"/>
        <line x1="4" y1="18" x2="20" y2="18" stroke-linecap="round"/>
      </svg>
      <span>Menu</span>
    </button>
  </div>
</nav>

<!-- Native Mobile Bottom Sheet Modal for Full Directory in Thumb Zone -->
<dialog id="monroe-bottom-sheet" class="monroe-bottom-sheet" aria-labelledby="bottom-sheet-title">
  <div class="monroe-bottom-sheet__container">
    <!-- Drag handle indicator -->
    <div class="monroe-bottom-sheet__handle" id="monroe-bottom-sheet-handle">
      <span class="monroe-bottom-sheet__handle-bar"></span>
    </div>

    <!-- Sheet Header -->
    <div class="monroe-bottom-sheet__header">
      <div class="flex items-center gap-2">
        <span class="w-8 h-8 rounded-lg bg-teal-100 text-teal-800 flex items-center justify-center font-bold text-xs">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <line x1="4" y1="6" x2="20" y2="6" stroke-linecap="round"/>
            <line x1="4" y1="12" x2="20" y2="12" stroke-linecap="round"/>
            <line x1="4" y1="18" x2="20" y2="18" stroke-linecap="round"/>
          </svg>
        </span>
        <div>
          <h2 id="bottom-sheet-title" class="text-sm font-bold text-teal-950 font-serif">Site Directory</h2>
          <p class="text-[11px] text-stone-500 font-sans">Monroe County Humane Society</p>
        </div>
      </div>
      <button
        type="button"
        id="monroe-bottom-sheet-close"
        class="w-8 h-8 rounded-full flex items-center justify-center text-stone-400 hover:text-stone-700 hover:bg-stone-100 transition cursor-pointer text-lg leading-none"
        aria-label="Close directory menu"
      >
        &times;
      </button>
    </div>

    <!-- Quick Thumb Action Pills -->
    <div class="monroe-bottom-sheet__quick-grid">
      <a href="/adopt" class="monroe-bottom-sheet__quick-pill">
        <span class="font-bold text-teal-950">🐾 Adopt</span>
        <span class="text-[10px] text-stone-500">Available pets</span>
      </a>
      <a href="/donate" class="monroe-bottom-sheet__quick-pill">
        <span class="font-bold text-teal-800">❤️ Donate</span>
        <span class="text-[10px] text-stone-500">Support care</span>
      </a>
      <a href="/events" class="monroe-bottom-sheet__quick-pill">
        <span class="font-bold text-teal-950">📅 Events</span>
        <span class="text-[10px] text-stone-500">Flyers & dates</span>
      </a>
      <a href={SITE.contact.phoneTel} class="monroe-bottom-sheet__quick-pill">
        <span class="font-bold text-amber-800">📞 Call Us</span>
        <span class="text-[10px] text-stone-500">734-243-3669</span>
      </a>
    </div>

    <!-- Full Directory Scrollable Content -->
    <div class="monroe-bottom-sheet__content" id="monroe-bottom-sheet-content">
      <!-- Section: Services -->
      <div class="monroe-bottom-sheet__group">
        <div class="monroe-bottom-sheet__group-title">Services & Shelter</div>
        <div class="monroe-bottom-sheet__links">
          <a href="/adopt" class="monroe-bottom-sheet__link">Adoptable Pets</a>
          <a href="/dog-and-cat-shelter" class="monroe-bottom-sheet__link">About Our Shelter</a>
          <a href="/#hs-hero-fence-widget" class="monroe-bottom-sheet__link">Hero Fence</a>
          <a href="/#Testimonials" class="monroe-bottom-sheet__link">Community Reviews</a>
          <a href="/games" class="monroe-bottom-sheet__link">Humane Games</a>
        </div>
      </div>

      <!-- Section: Adoptions -->
      <div class="monroe-bottom-sheet__group">
        <div class="monroe-bottom-sheet__group-title">Adoptions</div>
        <div class="monroe-bottom-sheet__links">
          <a href="/adopt" class="monroe-bottom-sheet__link">Available Dogs & Cats</a>
          <a href="/adoptions/#AdoptionPolicy" class="monroe-bottom-sheet__link">Adoption Policy & Fees</a>
          <a href="/adoptions/#Application" class="monroe-bottom-sheet__link">Adoption Application</a>
        </div>
      </div>

      <!-- Section: Resources & Community -->
      <div class="monroe-bottom-sheet__group">
        <div class="monroe-bottom-sheet__group-title">Resources & Community</div>
        <div class="monroe-bottom-sheet__links">
          <a href="/shop" class="monroe-bottom-sheet__link">Shelter Shop & Merch</a>
          <a href="/membership" class="monroe-bottom-sheet__link">Membership</a>
          <a href="/faq" class="monroe-bottom-sheet__link">Frequently Asked Questions</a>
          <a href="/newsletter" class="monroe-bottom-sheet__link">Newsletter Archive</a>
          <a href="/newsletter/issue/2025-in-review" class="monroe-bottom-sheet__link">2025 Year in Review</a>
          <a href="/volunteer-form" class="monroe-bottom-sheet__link">Volunteer Opportunities</a>
        </div>
      </div>

      <!-- Section: Events -->
      <div class="monroe-bottom-sheet__group">
        <div class="monroe-bottom-sheet__group-title">Events & Calendar</div>
        <div class="monroe-bottom-sheet__links">
          <a href="/events" class="monroe-bottom-sheet__link">Upcoming Events & Flyers</a>
          <a href="/events#Calendar" class="monroe-bottom-sheet__link">Community Calendar</a>
          <a href="/specialsponsors" class="monroe-bottom-sheet__link">Special Sponsors</a>
        </div>
      </div>

      <!-- Section: Memorials & Giving -->
      <div class="monroe-bottom-sheet__group">
        <div class="monroe-bottom-sheet__group-title">Memorials & Giving</div>
        <div class="monroe-bottom-sheet__links">
          <a href="/donate" class="monroe-bottom-sheet__link">Make a Donation</a>
          <a href="/memorials" class="monroe-bottom-sheet__link">Memorial Wall & Tribute Registry</a>
          <a href="/memorials/give" class="monroe-bottom-sheet__link">Planned Giving & Bequests</a>
        </div>
      </div>

      <!-- Section: Contact & Preferences -->
      <div class="monroe-bottom-sheet__group">
        <div class="monroe-bottom-sheet__group-title">Contact & Preferences</div>
        <div class="monroe-bottom-sheet__links">
          <a href="/contact" class="monroe-bottom-sheet__link">Contact Information & Shelter Hours</a>
          <button type="button" id="bottom-sheet-nav-pref-btn" class="monroe-bottom-sheet__link text-left w-full text-teal-800 font-semibold cursor-pointer">
            ⚙️ Navigation Preferences (Standard vs Bottom Bar)
          </button>
        </div>
      </div>
    </div>
  </div>
</dialog>

<script>
  function initBottomTabBar() {
    const menuBtn = document.getElementById('bottom-tab-menu-btn');
    const sheet = document.getElementById('monroe-bottom-sheet') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('monroe-bottom-sheet-close');
    const content = document.getElementById('monroe-bottom-sheet-content');
    const prefBtn = document.getElementById('bottom-sheet-nav-pref-btn');

    if (!menuBtn || !sheet) return;

    const openSheet = () => {
      menuBtn.classList.add('is-active');
      sheet.showModal();
    };

    const closeSheet = () => {
      if (sheet.open) {
        sheet.close();
      }
      menuBtn.classList.remove('is-active');
    };

    menuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (sheet.open) {
        closeSheet();
      } else {
        openSheet();
      }
    });

    closeBtn?.addEventListener('click', closeSheet);

    sheet.addEventListener('close', () => {
      menuBtn.classList.remove('is-active');
    });

    // Close when clicking outside the dialog content (on backdrop)
    sheet.addEventListener('click', (e) => {
      const rect = sheet.getBoundingClientRect();
      const inSheet = (
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width
      );
      if (!inSheet) {
        closeSheet();
      }
    });

    // Navigation preferences trigger
    prefBtn?.addEventListener('click', () => {
      closeSheet();
      const settingsBtn = document.getElementById('nav-settings-btn');
      if (settingsBtn) {
        settingsBtn.click();
      }
    });

    // Touch physics: swipe down to dismiss modal
    let touchStartY = 0;
    let touchStartX = 0;

    sheet.addEventListener('touchstart', (e) => {
      if (e.touches.length > 0) {
        touchStartY = e.touches[0].clientY;
        touchStartX = e.touches[0].clientX;
      }
    }, { passive: true });

    sheet.addEventListener('touchend', (e) => {
      if (e.changedTouches.length > 0) {
        const touchEndY = e.changedTouches[0].clientY;
        const touchEndX = e.changedTouches[0].clientX;
        const deltaY = touchEndY - touchStartY;
        const deltaX = Math.abs(touchEndX - touchStartX);

        // Allow dismissal if swiped down > 50px and either at the top of sheet scroll or dragged from handle
        const isAtTop = !content || content.scrollTop <= 5;
        if (deltaY > 50 && deltaY > deltaX && isAtTop) {
          closeSheet();
        }
      }
    }, { passive: true });
  }

  initBottomTabBar();
  document.addEventListener('astro:page-load', initBottomTabBar);
</script>

<style>
  /* By default (or in hamburger mode), hide bottom tab bar */
  .monroe-bottom-tab-bar {
    display: none;
  }

  /* Only shown when data-nav-style="bottom-bar" on screens <= 1200px */
  :root[data-nav-style="bottom-bar"] .monroe-bottom-tab-bar {
    display: block;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 4500;
    background: rgba(255, 250, 242, 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-top: 1px solid rgba(22, 52, 51, 0.12);
    box-shadow: 0 -4px 20px rgba(15, 30, 29, 0.08);
    padding-bottom: max(0.4rem, env(safe-area-inset-bottom, 0px));
  }

  /* Always hide on desktop (> 1200px) */
  @media (min-width: 1201px) {
    :root[data-nav-style="bottom-bar"] .monroe-bottom-tab-bar,
    .monroe-bottom-sheet {
      display: none !important;
    }
  }

  .monroe-bottom-tab-bar__inner {
    max-width: 540px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    align-items: center;
    padding: 0.35rem 0.25rem 0.2rem;
  }

  .monroe-bottom-tab-bar__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 0.2rem 0.25rem;
    border-radius: 12px;
    color: #4a6361;
    text-decoration: none;
    font-family: 'Jost', 'Segoe UI', sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    gap: 0.2rem;
    transition: all 0.16s ease;
    border: none;
    background: transparent;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .monroe-bottom-tab-bar__item:hover {
    color: #0f766e;
    background: rgba(15, 118, 110, 0.06);
  }

  .monroe-bottom-tab-bar__item.is-active {
    color: #0d5f58;
    font-weight: 700;
  }

  .monroe-bottom-tab-bar__item.is-active svg {
    color: #0d9488;
    transform: scale(1.1);
  }

  .monroe-bottom-tab-bar__item svg {
    transition: transform 0.16s ease, color 0.16s ease;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     Native Mobile Bottom Sheet Modal
     ══════════════════════════════════════════════════════════════════════════ */
  .monroe-bottom-sheet {
    padding: 0;
    border: none;
    border-radius: 24px 24px 0 0;
    box-shadow: 0 -10px 40px rgba(15, 30, 29, 0.25);
    background: #fffaf2;
    width: 100%;
    max-width: min(100vw, 640px);
    max-height: 85vh;
    margin: auto auto 0 auto;
    overflow: hidden;
  }

  .monroe-bottom-sheet[open] {
    animation: sheet-slide-up 0.26s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes sheet-slide-up {
    from {
      transform: translateY(100%);
      opacity: 0.8;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .monroe-bottom-sheet::backdrop {
    background: rgba(15, 30, 29, 0.55);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
  }

  .monroe-bottom-sheet__container {
    display: flex;
    flex-direction: column;
    max-height: 85vh;
    padding-bottom: max(1rem, env(safe-area-inset-bottom, 0px));
  }

  .monroe-bottom-sheet__handle {
    display: flex;
    justify-content: center;
    padding: 0.65rem 0 0.25rem;
    cursor: grab;
  }

  .monroe-bottom-sheet__handle-bar {
    width: 44px;
    height: 4px;
    background: rgba(22, 52, 51, 0.2);
    border-radius: 999px;
  }

  .monroe-bottom-sheet__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1.25rem 0.75rem;
    border-bottom: 1px solid rgba(22, 52, 51, 0.08);
  }

  .monroe-bottom-sheet__quick-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.4rem;
    padding: 0.75rem 1rem;
    background: rgba(15, 118, 110, 0.04);
    border-bottom: 1px solid rgba(22, 52, 51, 0.06);
  }

  .monroe-bottom-sheet__quick-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0.5rem 0.25rem;
    border-radius: 12px;
    background: #ffffff;
    border: 1px solid rgba(22, 52, 51, 0.08);
    text-decoration: none;
    font-size: 0.75rem;
    transition: transform 0.12s ease, border-color 0.12s ease;
  }

  .monroe-bottom-sheet__quick-pill:hover {
    transform: translateY(-1px);
    border-color: rgba(15, 118, 110, 0.4);
  }

  .monroe-bottom-sheet__content {
    flex: 1 1 auto;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 0.75rem 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .monroe-bottom-sheet__group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .monroe-bottom-sheet__group-title {
    font-family: 'Jost', 'Segoe UI', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #0f766e;
    padding: 0.2rem 0.5rem;
  }

  .monroe-bottom-sheet__links {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .monroe-bottom-sheet__link {
    display: block;
    padding: 0.5rem 0.65rem;
    border-radius: 10px;
    color: #173a39;
    text-decoration: none;
    font-size: 0.85rem;
    font-family: 'Questrial', 'Segoe UI', sans-serif;
    transition: background 0.12s ease, color 0.12s ease;
    border: none;
    background: transparent;
  }

  .monroe-bottom-sheet__link:hover {
    background: rgba(15, 118, 110, 0.08);
    color: #0f766e;
  }
</style>
