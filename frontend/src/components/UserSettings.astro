---
// UserSettings.astro: User-switchable mobile navigation preferences via native HTML5 <dialog>
---

<!-- Floating Navigation Preferences Cogwheel (Mobile / Tablet) -->
<button
  id="nav-settings-btn"
  class="monroe-settings-cog"
  type="button"
  aria-label="Navigation preferences"
  title="Navigation preferences"
>
  <svg class="w-5 h-5 text-teal-900" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
  </svg>
</button>

<!-- Native HTML5 Dialog Modal -->
<dialog id="nav-settings-dialog" class="monroe-settings-dialog">
  <div class="monroe-settings-dialog__box">
    <div class="flex items-center justify-between pb-3 border-b border-stone-200">
      <div class="flex items-center gap-2">
        <span class="w-7 h-7 rounded-lg bg-teal-100 text-teal-800 flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
          </svg>
        </span>
        <h3 class="text-base font-serif font-bold text-teal-950">Navigation Style</h3>
      </div>
      <button
        type="button"
        id="nav-settings-close-x"
        class="w-8 h-8 rounded-full flex items-center justify-center text-stone-400 hover:text-stone-700 hover:bg-stone-100 transition cursor-pointer"
        aria-label="Close settings"
      >
        &times;
      </button>
    </div>

    <form method="dialog" class="pt-4 space-y-3">
      <p class="text-xs text-stone-600 leading-relaxed">
        Choose your preferred mobile navigation layout. Changes apply instantly without reloading the page.
      </p>

      <fieldset class="space-y-2.5">
        <legend class="sr-only">Mobile Navigation Mode</legend>

        <!-- Option 1: Standard Hamburger Menu -->
        <label class="monroe-nav-choice flex items-start gap-3 p-3 rounded-xl border border-stone-200 hover:border-teal-600/50 hover:bg-teal-50/30 cursor-pointer transition">
          <input
            type="radio"
            name="nav-type"
            value="hamburger"
            class="mt-1 text-teal-800 focus:ring-teal-700 h-4 w-4"
          />
          <div class="flex-1 text-left">
            <div class="text-xs font-bold text-teal-950">Standard (Hamburger Menu)</div>
            <div class="text-[11px] text-stone-500 mt-0.5">Classic top dropdown menu with drawer &amp; accordions.</div>
          </div>
        </label>

        <!-- Option 2: App-Like Bottom Tab Bar -->
        <label class="monroe-nav-choice flex items-start gap-3 p-3 rounded-xl border border-stone-200 hover:border-teal-600/50 hover:bg-teal-50/30 cursor-pointer transition">
          <input
            type="radio"
            name="nav-type"
            value="bottom-bar"
            class="mt-1 text-teal-800 focus:ring-teal-700 h-4 w-4"
          />
          <div class="flex-1 text-left">
            <div class="text-xs font-bold text-teal-950">App-Like (Bottom Tab Bar)</div>
            <div class="text-[11px] text-stone-500 mt-0.5">Fixed thumb-zone dock with Home, Adopt, Events, &amp; Donate.</div>
          </div>
        </label>
      </fieldset>

      <div class="pt-3 border-t border-stone-100 flex justify-end">
        <button
          type="submit"
          class="px-5 py-2 rounded-full bg-teal-800 hover:bg-teal-900 text-white text-xs font-bold uppercase tracking-wider transition shadow-xs cursor-pointer"
        >
          Done
        </button>
      </div>
    </form>
  </div>
</dialog>

<script>
  function initUserSettings() {
    const btn = document.getElementById('nav-settings-btn') as HTMLButtonElement | null;
    const dialog = document.getElementById('nav-settings-dialog') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('nav-settings-close-x');
    const radios = document.querySelectorAll<HTMLInputElement>('input[name="nav-type"]');

    if (!btn || !dialog) return;

    // Open the native modal
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      // Sync radio selection with current preference before opening
      const currentPref = localStorage.getItem('monroe-nav-pref') || 'hamburger';
      const activeRadio = dialog.querySelector<HTMLInputElement>(`input[value="${currentPref}"]`);
      if (activeRadio) activeRadio.checked = true;
      dialog.showModal();
    });

    closeBtn?.addEventListener('click', () => {
      dialog.close();
    });

    // Close on click outside modal content
    dialog.addEventListener('click', (e) => {
      const rect = dialog.getBoundingClientRect();
      const isInDialog = (
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width
      );
      if (!isInDialog) {
        dialog.close();
      }
    });

    // Touch Physics: Swipe down to dismiss modal
    let touchStartY = 0;
    let touchStartX = 0;

    dialog.addEventListener('touchstart', (e) => {
      if (e.touches.length > 0) {
        touchStartY = e.touches[0].clientY;
        touchStartX = e.touches[0].clientX;
      }
    }, { passive: true });

    dialog.addEventListener('touchend', (e) => {
      if (e.changedTouches.length > 0) {
        const touchEndY = e.changedTouches[0].clientY;
        const touchEndX = e.changedTouches[0].clientX;
        const deltaY = touchEndY - touchStartY;
        const deltaX = Math.abs(touchEndX - touchStartX);

        // If swiped down by more than 50px and vertical movement dominates
        if (deltaY > 50 && deltaY > deltaX) {
          dialog.close();
        }
      }
    }, { passive: true });

    // Handle radio change
    radios.forEach((radio) => {
      radio.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        const val = target.value;
        document.documentElement.setAttribute('data-nav-style', val);
        try {
          localStorage.setItem('monroe-nav-pref', val);
        } catch (err) {}
      });
    });
  }

  // Initialize on page load and View Transitions
  initUserSettings();
  document.addEventListener('astro:page-load', initUserSettings);
</script>

<style>
  .monroe-settings-cog {
    position: fixed;
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    right: 1rem;
    z-index: 4900;
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(22, 52, 51, 0.16);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: transform 0.18s ease, background 0.18s ease, opacity 0.2s ease;
  }
  .monroe-settings-cog:focus {
    outline: none;
  }
  .monroe-settings-cog:focus-visible {
    outline: 2px solid #0f766e;
    outline-offset: 3px;
  }
  .monroe-settings-cog:hover {
    transform: rotate(30deg) scale(1.05);
    background: #ffffff;
  }
  .monroe-settings-cog:active {
    transform: scale(0.95);
  }

  /* When bottom tab bar is active on mobile, lift cogwheel above the bottom bar */
  :root[data-nav-style="bottom-bar"] .monroe-settings-cog {
    bottom: calc(4.75rem + env(safe-area-inset-bottom, 0px));
  }

  /* Hide cogwheel on wide desktop screens (desktop uses standard full header) */
  @media (min-width: 1201px) {
    .monroe-settings-cog {
      display: none;
    }
  }

  .monroe-settings-dialog {
    padding: 0;
    border: none;
    border-radius: 20px;
    box-shadow: 0 20px 40px -10px rgba(15, 30, 29, 0.35);
    background: #fffaf2;
    max-width: min(92vw, 420px);
    width: 100%;
    margin: auto;
  }
  .monroe-settings-dialog::backdrop {
    background: rgba(15, 30, 29, 0.55);
    backdrop-filter: blur(5px);
  }
  .monroe-settings-dialog__box {
    padding: 1.25rem 1.25rem 1rem;
  }

  .monroe-nav-choice input[type="radio"]:checked + div {
    color: #0f766e;
  }
  .monroe-nav-choice:has(input[type="radio"]:checked) {
    border-color: #0f766e;
    background-color: rgba(15, 118, 110, 0.08);
  }
</style>
