---
interface Gift {
  date: string;
  amount: number;
  platform: string;
  campaign: string;
  type: string;
  memo: string;
  description?: string;
  privateNote?: string;
  dedication: string;
  isTribute: boolean;
  reference: string;
  checkNumber?: string;
  paymentMethod?: string;
  qboClass?: string;
  qboType?: string;
  account?: string;
  glCategory?: string;
  source?: string;
}

export interface Donor {
  id: string;
  name: string;
  email: string;
  phone: string;
  address: string;
  lifetimeTotal: number;
  itemizedTotal?: number;
  isAggregate?: boolean;
  transactionsCount: number;
  firstGiftDate: string;
  latestGiftDate: string;
  givingTier: string;
  tierId: string;
  tierColor: string;
  platformsList: string[];
  campaignsList: string[];
  hasMailingAddress: boolean;
  tributesCount: number;
  gifts: Gift[];
}

interface Props {
  donors: Donor[];
}

const { donors = [] } = Astro.props;
---

<div class="space-y-4" id="donor-roster-container">
  <!-- Controls: Search, Filter, Sort, Pagination, Export -->
  <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-xs space-y-3.5 print:hidden">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3">
      <!-- Search Input -->
      <div class="relative flex-1 min-w-[240px]">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
        </div>
        <input
          type="text"
          id="donor-search-input"
          placeholder="Search by name, email, or city"
          class="w-full pl-9 pr-8 py-2 text-xs rounded-lg border border-slate-200 bg-slate-50 focus:bg-white focus:border-emerald-600 focus:ring-2 focus:ring-emerald-500/20 text-slate-900 transition outline-none"
        />
        <button
          id="donor-search-clear-btn"
          type="button"
          class="hidden absolute inset-y-0 right-0 pr-2.5 flex items-center text-slate-400 hover:text-slate-600"
          title="Clear search"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Quick Export CSV & Print Buttons -->
      <div class="flex items-center gap-2">
        <button
          id="print-roster-btn"
          type="button"
          onclick="window.print()"
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 transition shadow-xs cursor-pointer print:hidden dark:bg-[#071a17] dark:hover:bg-[#0b2420] dark:text-slate-200 dark:border-teal-800/80"
          title="Print official donor registry roster"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
          Print Roster
        </button>
        <button
          id="export-donors-csv-btn"
          type="button"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-bold bg-[#173a39] hover:bg-teal-900 text-white transition shadow-sm cursor-pointer print:hidden border border-teal-800"
          title="Export filtered donor list with mailing addresses"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Export CSV (<span id="export-count-label">{donors.length}</span>)</span>
        </button>
      </div>
    </div>

    <!-- Filters Row -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2.5 pt-2 border-t border-slate-100 text-xs">
      <!-- Tier Filter -->
      <div>
        <label for="filter-tier" class="block text-[10px] font-semibold uppercase tracking-wider text-slate-500 mb-1">Giving Tier</label>
        <select
          id="filter-tier"
          class="w-full py-1.5 px-2.5 rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-emerald-600 outline-none text-xs"
        >
          <option value="all">All Tiers</option>
          <option value="visionary">Visionary ($10k+)</option>
          <option value="benefactor">Benefactor ($5k–$10k)</option>
          <option value="patron">Patron ($1k–$5k)</option>
          <option value="sustainer">Sustainer ($500–$1k)</option>
          <option value="friend">Friend ($100–$500)</option>
          <option value="supporter">Supporter (&lt; $100)</option>
        </select>
      </div>

      <!-- Platform Filter -->
      <div>
        <label for="filter-platform" class="block text-[10px] font-semibold uppercase tracking-wider text-slate-500 mb-1">How they gave</label>
        <select
          id="filter-platform"
          class="w-full py-1.5 px-2.5 rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-emerald-600 outline-none text-xs"
        >
          <option value="all">All ways</option>
          <option value="BetterUnite">BetterUnite</option>
          <option value="PayPal">PayPal</option>
          <option value="Paper Check">Check</option>
          <option value="multi">More than one way</option>
        </select>
      </div>

      <!-- Address Status Filter -->
      <div>
        <label for="filter-address" class="block text-[10px] font-semibold uppercase tracking-wider text-slate-500 mb-1">Address</label>
        <select
          id="filter-address"
          class="w-full py-1.5 px-2.5 rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-emerald-600 outline-none text-xs"
        >
          <option value="all">Anyone</option>
          <option value="has_address">Has mailing address</option>
          <option value="no_address">Missing address</option>
        </select>
      </div>

      <!-- Recency Filter -->
      <div>
        <label for="filter-recency" class="block text-[10px] font-semibold uppercase tracking-wider text-slate-500 mb-1">When</label>
        <select
          id="filter-recency"
          class="w-full py-1.5 px-2.5 rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-emerald-600 outline-none text-xs"
        >
          <option value="all">Any year</option>
          <option value="2026">Gave in 2026</option>
          <option value="2025">Gave in 2025</option>
          <option value="earlier">Before 2025</option>
        </select>
      </div>

      <!-- Sort Filter -->
      <div>
        <label for="filter-sort" class="block text-[10px] font-semibold uppercase tracking-wider text-slate-500 mb-1">Sort By</label>
        <select
          id="filter-sort"
          class="w-full py-1.5 px-2.5 rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-emerald-600 outline-none text-xs font-medium"
        >
          <option value="lifetime_desc">Largest first</option>
          <option value="lifetime_asc">Smallest first</option>
          <option value="recent_desc">Most recent gift</option>
          <option value="gifts_desc">Most gifts</option>
          <option value="name_asc">Name A–Z</option>
        </select>
      </div>
    </div>
    <label class="inline-flex items-center gap-2 text-[11px] text-slate-600 pt-1 cursor-pointer select-none">
      <input id="filter-show-batches" type="checkbox" class="rounded border-slate-300 text-emerald-700 focus:ring-emerald-500/30">
      <span>Include event totals and unnamed bank deposits</span>
    </label>
  </div>

  <!-- Table Container -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-slate-50/90 text-slate-600 border-b border-slate-200 font-semibold uppercase tracking-wider text-[10px]">
            <th class="py-3 px-4 w-10 text-center"></th>
            <th class="py-3 px-4">Donor</th>
            <th class="py-3 px-4">Tier</th>
            <th class="py-3 px-4">How they gave</th>
            <th class="py-3 px-4 text-center">Gifts</th>
            <th class="py-3 px-4">Latest gift</th>
            <th class="py-3 px-4 text-right">Lifetime</th>
            <th class="py-3 px-4 text-center w-24"></th>
          </tr>
        </thead>
        <tbody id="donor-table-body" class="divide-y divide-slate-100">
          <!-- Populated client-side via JavaScript for fast sorting/filtering/pagination -->
        </tbody>
      </table>
    </div>

    <!-- Empty State -->
    <div id="donor-empty-state" class="hidden py-12 text-center text-slate-500 space-y-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 mx-auto text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <div class="text-sm font-semibold text-slate-700">No matching donors</div>
      <p class="text-xs text-slate-500">Clear the search box or reset the filters.</p>
    </div>

    <!-- Pagination & Stats Footer -->
    <div class="px-4 py-3 bg-slate-50 border-t border-slate-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2.5 text-xs text-slate-600 print:hidden">
      <div class="flex items-center gap-2">
        <span>Showing <strong id="page-start" class="text-slate-900 font-bold">1</strong> to <strong id="page-end" class="text-slate-900 font-bold">50</strong> of <strong id="total-filtered-count" class="text-slate-900 font-bold">0</strong> donors</span>
        <span class="text-slate-300">|</span>
        <label for="page-size" class="text-slate-500">Per page:</label>
        <select id="page-size" class="py-1 px-2 rounded border border-slate-200 bg-white text-xs text-slate-800 outline-none">
          <option value="25">25</option>
          <option value="50" selected>50</option>
          <option value="100">100</option>
          <option value="250">250</option>
        </select>
      </div>

      <div class="flex items-center gap-1.5 self-end sm:self-auto">
        <button
          id="pagination-prev-btn"
          type="button"
          class="px-2.5 py-1 rounded-md border border-slate-200 bg-white hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed font-medium transition"
        >
          Previous
        </button>
        <span id="page-indicator" class="px-2 font-medium text-slate-700">Page 1 of 1</span>
        <button
          id="pagination-next-btn"
          type="button"
          class="px-2.5 py-1 rounded-md border border-slate-200 bg-white hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed font-medium transition"
        >
          Next
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  @media print {
    :global(nav),
    :global(header),
    :global(footer),
    :global(aside),
    .print\:hidden {
      display: none !important;
    }

    #donor-roster-container {
      margin: 0 !important;
      padding: 0 !important;
      box-shadow: none !important;
      border: none !important;
      background: white !important;
    }

    table {
      width: 100% !important;
      border-collapse: collapse !important;
      font-size: 10px !important;
    }

    thead {
      display: table-header-group !important;
    }

    tr {
      break-inside: avoid !important;
      page-break-inside: avoid !important;
    }

    th, td {
      border: 1px solid #cbd5e1 !important;
      padding: 4px 6px !important;
    }
  }
</style>

<!-- Embedded Raw Data Script for High Performance Client Operations -->
<script is:inline define:vars={{ donors }}>
  window.__HSMC_DONORS__ = donors;
</script>

<script is:inline>
  // Client-side Reactive State
  let allDonors = Array.isArray(window.__HSMC_DONORS__) ? window.__HSMC_DONORS__ : [];
  let filteredDonors = [...allDonors];
  let currentPage = 1;
  let pageSize = 50;
  const openDrawers = new Set();

  function getElements() {
    return {
      searchInput: document.getElementById('donor-search-input'),
      clearSearchBtn: document.getElementById('donor-search-clear-btn'),
      filterTier: document.getElementById('filter-tier'),
      filterPlatform: document.getElementById('filter-platform'),
      filterAddress: document.getElementById('filter-address'),
      filterRecency: document.getElementById('filter-recency'),
      filterSort: document.getElementById('filter-sort'),
      filterShowBatches: document.getElementById('filter-show-batches'),
      pageSizeSelect: document.getElementById('page-size'),
      prevBtn: document.getElementById('pagination-prev-btn'),
      nextBtn: document.getElementById('pagination-next-btn'),
      tableBody: document.getElementById('donor-table-body'),
      emptyState: document.getElementById('donor-empty-state'),
      exportBtn: document.getElementById('export-donors-csv-btn'),
      exportCountLabel: document.getElementById('export-count-label'),
      totalFilteredCountEl: document.getElementById('total-filtered-count'),
      pageStartEl: document.getElementById('page-start'),
      pageEndEl: document.getElementById('page-end'),
      pageIndicatorEl: document.getElementById('page-indicator')
    };
  }

  // Security: HTML entity escaper to prevent XSS
  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // Precompute lowercase search index on each donor for sub-millisecond filtering
  function indexDonors(list) {
    if (!Array.isArray(list)) return;
    list.forEach(d => {
      if (!d._searchStr) {
        d._searchStr = [
          d.name,
          d.email,
          d.phone,
          d.address,
          d.givingTier,
          (d.platformsList || []).join(' '),
          (d.gifts || []).map(g => `${g.campaign || ''} ${g.memo || ''} ${g.description || ''} ${g.dedication || ''} ${g.reference || ''} ${g.checkNumber || ''} ${g.paymentMethod || ''} ${g.account || ''} ${g.qboType || ''} ${g.qboClass || ''}`).join(' ')
        ].join(' ').toLowerCase();
      }
    });
  }

  indexDonors(allDonors);

  function formatMoney(n) {
    return '$' + (n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function formatDate(d) {
    if (!d) return '—';
    const parts = d.split('-');
    if (parts.length === 3) {
      const date = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
      return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    }
    return d;
  }

  function giftDescription(g) {
    const parts = [g.description, g.memo, g.privateNote, g.dedication];
    for (const p of parts) {
      const t = String(p || '').trim();
      if (t && !/^DEPOSIT$/i.test(t)) return t;
    }
    return '';
  }

  function itemizedTotalOf(donor) {
    if (typeof donor.itemizedTotal === 'number') return donor.itemizedTotal;
    return (donor.gifts || []).reduce((sum, g) => sum + (g.amount || 0), 0);
  }

  function coverageCopy(donor) {
    if (donor.isAggregate) return '';
    const itemized = itemizedTotalOf(donor);
    const lifetime = donor.lifetimeTotal || 0;
    if (Math.abs(lifetime - itemized) < 0.005) return '';
    return 'Lifetime includes unlabeled bank deposits that QuickBooks did not name.';
  }

  function aggregateKind(donor) {
    if (!donor.isAggregate) return '';
    if (/trust fund|via bank of america/i.test(donor.name || '')) return 'bank';
    return 'event';
  }

  function shortChannel(p) {
    const raw = String(p || '');
    if (/check/i.test(raw)) return 'Check';
    if (/paypal/i.test(raw)) return 'PayPal';
    if (/better/i.test(raw)) return 'BetterUnite';
    if (/square/i.test(raw)) return 'Square';
    return raw;
  }

  function checkOrMethod(g) {
    const checkNo = String(g.checkNumber || '').trim();
    if (checkNo) return checkNo;
    const method = String(g.paymentMethod || '').trim();
    if (method) return method;
    return String(g.reference || '').trim();
  }

  function formatDisplayAddress(addr) {
    if (!addr) return '';
    const parts = String(addr).split(/[|,]/).map((p) => p.trim().replace(/\s+/g, ' ')).filter(Boolean);
    const out = [];
    for (const t of parts) {
      if (!out.length || out[out.length - 1].toLowerCase() !== t.toLowerCase()) out.push(t);
    }
    if (!out.length) return '';
    if (out.length === 1 && /^[A-Z]{2}$/i.test(out[0])) return '';
    const joined = out.join(', ').replace(/^[,\s]+/, '').replace(/[,\s]+$/, '');
    if (/^MI\s*$/i.test(joined) || /^,\s*MI\b/i.test(joined)) return '';
    return joined;
  }

  function emptyHistoryCopy(donor) {
    const kind = aggregateKind(donor);
    if (kind === 'bank') {
      return 'This is a trust or foundation check the bank deposited. QuickBooks does not name the trust, so this is not a gift from the bank.';
    }
    if (kind === 'event') {
      return 'This is an event total (auction, car show, or similar), not a person.';
    }
    if ((donor.lifetimeTotal || 0) > 0.01) {
      return 'No named checks on file. The lifetime total includes unlabeled deposits.';
    }
    return 'No gifts on file yet.';
  }

  function groupGiftsByYear(gifts) {
    const map = new Map();
    for (const g of gifts || []) {
      const year = String(g.date || '').slice(0, 4) || 'Unknown';
      if (!map.has(year)) map.set(year, []);
      map.get(year).push(g);
    }
    return Array.from(map.entries()).sort((a, b) => String(b[0]).localeCompare(String(a[0])));
  }

  function getTierBadge(tierId, label) {
    let dotColor = 'bg-slate-400';
    let badgeBg = 'bg-slate-50 border-slate-200 text-slate-700';

    if (tierId === 'visionary') {
      dotColor = 'bg-purple-500';
      badgeBg = 'bg-purple-50 border-purple-200 text-purple-800';
    } else if (tierId === 'benefactor') {
      dotColor = 'bg-emerald-500';
      badgeBg = 'bg-emerald-50 border-emerald-200 text-emerald-800';
    } else if (tierId === 'patron') {
      dotColor = 'bg-blue-500';
      badgeBg = 'bg-blue-50 border-blue-200 text-blue-800';
    } else if (tierId === 'sustainer') {
      dotColor = 'bg-teal-500';
      badgeBg = 'bg-teal-50 border-teal-200 text-teal-800';
    } else if (tierId === 'friend') {
      dotColor = 'bg-amber-500';
      badgeBg = 'bg-amber-50 border-amber-200 text-amber-800';
    }

    return `
      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-semibold border ${badgeBg}">
        <span class="w-1.5 h-1.5 rounded-full ${dotColor}"></span>
        <span title="${escapeHtml(label)}">${escapeHtml(String(label).split(' (')[0])}</span>
      </span>
    `;
  }

  function getPlatformPill(p) {
    const label = shortChannel(p);
    let color = 'bg-slate-100 text-slate-600 border-slate-200';
    if (label === 'BetterUnite') color = 'bg-teal-50 text-teal-700 border-teal-200';
    else if (label === 'PayPal') color = 'bg-indigo-50 text-indigo-700 border-indigo-200';
    else if (label === 'Check') color = 'bg-amber-50 text-amber-800 border-amber-200';

    return `<span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-medium border ${color}">${escapeHtml(label)}</span>`;
  }

  function applyFilters() {
    const els = getElements();
    const q = (els.searchInput?.value || '').trim().toLowerCase();
    const tier = els.filterTier?.value || 'all';
    const plat = els.filterPlatform?.value || 'all';
    const addr = els.filterAddress?.value || 'all';
    const rec = els.filterRecency?.value || 'all';
    const sort = els.filterSort?.value || 'lifetime_desc';
    const showBatches = Boolean(els.filterShowBatches?.checked);

    if (els.clearSearchBtn) {
      els.clearSearchBtn.classList.toggle('hidden', !q);
    }

    filteredDonors = allDonors.filter(d => {
      // Fast Search
      if (q && !d._searchStr.includes(q)) return false;
      if (!showBatches && d.isAggregate && !q) return false;

      // Tier
      if (tier !== 'all' && d.tierId !== tier) return false;

      // Platform
      if (plat !== 'all') {
        if (plat === 'multi') {
          if (!d.platformsList || d.platformsList.length < 2) return false;
        } else {
          if (!d.platformsList || !d.platformsList.some(p => p.toLowerCase().includes(plat.toLowerCase()))) return false;
        }
      }

      // Address
      if (addr === 'has_address' && !d.hasMailingAddress) return false;
      if (addr === 'no_address' && d.hasMailingAddress) return false;

      // Recency
      if (rec !== 'all') {
        const yr = (d.latestGiftDate || '').substring(0, 4);
        if (rec === '2026' && yr !== '2026') return false;
        if (rec === '2025' && yr !== '2025') return false;
        if (rec === 'earlier' && (yr === '2026' || yr === '2025')) return false;
      }

      return true;
    });

    // Sorting
    filteredDonors.sort((a, b) => {
      if (sort === 'lifetime_desc') return b.lifetimeTotal - a.lifetimeTotal;
      if (sort === 'lifetime_asc') return a.lifetimeTotal - b.lifetimeTotal;
      if (sort === 'recent_desc') return (b.latestGiftDate || '').localeCompare(a.latestGiftDate || '');
      if (sort === 'gifts_desc') return b.transactionsCount - a.transactionsCount;
      if (sort === 'name_asc') return a.name.localeCompare(b.name);
      return 0;
    });

    currentPage = 1;
    renderTable();
  }

  function renderTable() {
    const els = getElements();
    const tableBody = els.tableBody;
    if (!tableBody) return;

    const total = filteredDonors.length;
    if (els.exportCountLabel) els.exportCountLabel.textContent = total.toLocaleString();
    if (els.totalFilteredCountEl) els.totalFilteredCountEl.textContent = total.toLocaleString();

    if (total === 0) {
      tableBody.innerHTML = '';
      if (els.emptyState) els.emptyState.classList.remove('hidden');
      if (els.pageStartEl) els.pageStartEl.textContent = '0';
      if (els.pageEndEl) els.pageEndEl.textContent = '0';
      if (els.pageIndicatorEl) els.pageIndicatorEl.textContent = 'Page 0 of 0';
      if (els.prevBtn) els.prevBtn.disabled = true;
      if (els.nextBtn) els.nextBtn.disabled = true;
      return;
    }

    if (els.emptyState) els.emptyState.classList.add('hidden');

    const totalPages = Math.ceil(total / pageSize);
    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    const startIdx = (currentPage - 1) * pageSize;
    const endIdx = Math.min(startIdx + pageSize, total);

    if (els.pageStartEl) els.pageStartEl.textContent = (startIdx + 1).toLocaleString();
    if (els.pageEndEl) els.pageEndEl.textContent = endIdx.toLocaleString();
    if (els.pageIndicatorEl) els.pageIndicatorEl.textContent = `Page ${currentPage} of ${totalPages}`;

    if (els.prevBtn) els.prevBtn.disabled = currentPage <= 1;
    if (els.nextBtn) els.nextBtn.disabled = currentPage >= totalPages;

    const pageSlice = filteredDonors.slice(startIdx, endIdx);

    const rowsHtml = pageSlice.map((donor, idx) => {
      const isOpen = openDrawers.has(donor.id);
      const isEven = idx % 2 === 0;
      const displayAddr = formatDisplayAddress(donor.address);

      // Badges
      const tributeBadge = donor.tributesCount > 0
        ? `<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-semibold bg-amber-50 text-amber-800 border border-amber-200" title="${donor.tributesCount} tribute/memorial gifts">
             <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
             ${donor.tributesCount} Tribute${donor.tributesCount > 1 ? 's' : ''}
           </span>`
        : '';

      const kind = aggregateKind(donor);
      const kindBadge = kind === 'bank'
        ? `<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-700 border border-slate-200">Bank deposit</span>`
        : kind === 'event'
          ? `<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-amber-50 text-amber-800 border border-amber-200">Event total</span>`
          : '';

      // Main Row
      const mainRow = `
        <tr
          id="row-${donor.id}"
          class="hover:bg-slate-50/80 transition cursor-pointer ${isEven ? 'bg-white' : 'bg-slate-50/40'} ${isOpen ? 'bg-emerald-50/20' : ''}"
          data-donor-id="${donor.id}"
        >
          <td class="py-3 px-4 text-center">
            <button
              type="button"
              class="w-6 h-6 rounded flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-200/60 transition cursor-pointer"
              aria-expanded="${isOpen}"
              title="${isOpen ? 'Collapse Details' : 'Expand Details'}"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform duration-200 ${isOpen ? 'rotate-90 text-emerald-600' : ''}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </td>
          <td class="py-3 px-4">
            <div class="font-bold text-slate-900 text-xs flex items-center gap-2">
              <span>${escapeHtml(donor.name)}</span>
              ${tributeBadge}
              ${kindBadge}
            </div>
            <div class="text-[11px] text-slate-500 flex flex-wrap items-center gap-x-2.5 gap-y-0.5 mt-0.5">
              ${donor.email ? `<span class="text-slate-600 font-mono text-[10px]">${escapeHtml(donor.email)}</span>` : ''}
              ${donor.phone ? `<span>&bull; ${escapeHtml(donor.phone)}</span>` : ''}
              ${displayAddr ? `<span class="truncate max-w-[280px]" title="${escapeHtml(displayAddr)}">&bull; ${escapeHtml(displayAddr)}</span>` : ''}
            </div>
          </td>
          <td class="py-3 px-4 whitespace-nowrap">
            ${getTierBadge(donor.tierId, donor.givingTier)}
          </td>
          <td class="py-3 px-4">
            <div class="flex flex-wrap gap-1">
              ${(donor.platformsList || []).map(p => getPlatformPill(p)).join('')}
            </div>
          </td>
          <td class="py-3 px-4 text-center font-semibold text-slate-700">
            ${donor.transactionsCount}
          </td>
          <td class="py-3 px-4 text-slate-600 whitespace-nowrap text-[11px]">
            ${formatDate(donor.latestGiftDate)}
          </td>
          <td class="py-3 px-4 text-right whitespace-nowrap">
            <span class="font-bold font-mono text-slate-900 text-xs">${formatMoney(donor.lifetimeTotal)}</span>
          </td>
          <td class="py-3 px-4 text-center whitespace-nowrap">
            <button
              type="button"
              class="inspect-donor-btn px-2.5 py-1 rounded text-[11px] font-semibold transition border ${isOpen ? 'bg-emerald-600 text-white border-emerald-600' : 'bg-slate-100 hover:bg-slate-200 text-slate-700 border-slate-200'}"
            >
              ${isOpen ? 'Close' : 'View'}
            </button>
          </td>
        </tr>
      `;

      // Expandable Drawer Row
      if (!isOpen) return mainRow;

      const giftsList = donor.gifts || [];
      const coverage = coverageCopy(donor);
      const yearGroups = groupGiftsByYear(giftsList);
      const giftRowsForYear = (yearGifts) => yearGifts.map((g, gIdx) => {
        const desc = giftDescription(g);
        const checkLabel = checkOrMethod(g);
        const dedication = (g.dedication || '').trim();
        const descHtml = [];
        if (g.isTribute && dedication && dedication !== desc) {
          descHtml.push(`<div><span class="font-semibold text-amber-800 dark:text-amber-300">In memory / honor:</span> ${escapeHtml(dedication)}</div>`);
        }
        if (desc) {
          descHtml.push(`<div class="text-slate-700 dark:text-slate-200">${escapeHtml(desc)}</div>`);
        }
        return `
          <tr class="${gIdx % 2 === 0 ? 'bg-white dark:bg-[#0b2420]/40' : 'bg-slate-50/50 dark:bg-[#061815]/80'} text-slate-700 dark:text-slate-200 hover:bg-teal-50/40 dark:hover:bg-teal-950/40 transition align-top">
            <td class="py-2 px-3 font-mono text-[11px] text-slate-600 dark:text-slate-300 whitespace-nowrap">${formatDate(g.date)}</td>
            <td class="py-2 px-3">${getPlatformPill(g.platform)}</td>
            <td class="py-2 px-3 font-medium text-slate-800 dark:text-slate-100">${escapeHtml(g.campaign || 'Gift')}</td>
            <td class="py-2 px-3 font-mono font-bold text-slate-900 dark:text-white text-right whitespace-nowrap">${formatMoney(g.amount)}</td>
            <td class="py-2 px-3 text-[11px] text-slate-600 dark:text-slate-300 max-w-[280px]" title="${escapeHtml(desc || dedication || '')}">
              ${descHtml.join('') || '<span class="text-slate-400 dark:text-slate-500">—</span>'}
            </td>
            <td class="py-2 px-3 font-mono text-[11px] text-slate-700 dark:text-teal-200 text-right whitespace-nowrap">${escapeHtml(checkLabel || '—')}</td>
          </tr>
        `;
      }).join('');

      let historyHtml = '';
      if (donor.isAggregate && giftsList.length > 0) {
        historyHtml = `
          <div class="rounded-lg border border-amber-200 dark:border-amber-800/70 bg-amber-50/80 dark:bg-amber-950/40 px-3 py-2.5 text-xs text-amber-900 dark:text-amber-200">
            ${escapeHtml(emptyHistoryCopy(donor))}
          </div>
        `;
      }
      if (giftsList.length === 0) {
        historyHtml += `
          <div class="py-4 text-center text-xs text-slate-500 dark:text-slate-400">
            ${escapeHtml(emptyHistoryCopy(donor))}
          </div>
        `;
      } else {
        const showYearHeads = yearGroups.length > 1;
        historyHtml += yearGroups.map(([year, yearGifts]) => {
          const yearSum = yearGifts.reduce((s, g) => s + (g.amount || 0), 0);
          return `
            <div class="space-y-1.5">
              ${showYearHeads ? `<div class="flex items-center justify-between gap-2 px-0.5">
                <h5 class="text-[11px] font-bold text-teal-800 dark:text-teal-300">${escapeHtml(year)}</h5>
                <span class="text-[11px] text-slate-500 dark:text-slate-400">${yearGifts.length} gift${yearGifts.length === 1 ? '' : 's'} · ${formatMoney(yearSum)}</span>
              </div>` : ''}
              <div class="overflow-x-auto border border-slate-200 dark:border-teal-800/80 rounded-lg">
                <table class="w-full text-left text-xs">
                  <thead class="bg-slate-50/90 dark:bg-[#061815] text-slate-600 dark:text-teal-300 font-semibold text-[11px] border-b border-slate-200 dark:border-teal-900/60">
                    <tr>
                      <th class="py-2 px-3">Date</th>
                      <th class="py-2 px-3">How</th>
                      <th class="py-2 px-3">For</th>
                      <th class="py-2 px-3 text-right">Amount</th>
                      <th class="py-2 px-3">Note</th>
                      <th class="py-2 px-3 text-right">Check</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100 dark:divide-teal-900/50">
                    ${giftRowsForYear(yearGifts)}
                  </tbody>
                </table>
              </div>
            </div>
          `;
        }).join('');
      }

      const contactBits = [];
      if (donor.email) {
        contactBits.push(`<div><a href="mailto:${escapeHtml(donor.email)}" class="text-emerald-700 dark:text-emerald-300 hover:underline">${escapeHtml(donor.email)}</a></div>`);
      }
      if (donor.phone) {
        contactBits.push(`<div>${escapeHtml(donor.phone)}</div>`);
      }
      if (displayAddr) {
        contactBits.push(`<div class="leading-snug">${escapeHtml(displayAddr)}</div>`);
      }
      const contactPanel = contactBits.length
        ? `<div class="text-xs bg-slate-50/60 dark:bg-[#061815] p-3 rounded-lg border border-slate-100 dark:border-teal-900/60 text-slate-700 dark:text-slate-200 space-y-0.5">${contactBits.join('')}</div>`
        : '';

      const drawerRow = `
        ${mainRow}
        <tr id="drawer-${donor.id}" class="bg-slate-100/70 dark:bg-[#061815] border-b-2 border-emerald-600/30 dark:border-teal-800/80">
          <td colspan="8" class="p-4 sm:p-5">
            <div class="bg-white dark:bg-[#0b2420]/85 rounded-xl border border-slate-200 dark:border-teal-800/80 shadow-sm p-4 space-y-4">
              <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-slate-100 dark:border-teal-900/60">
                <div>
                  <div class="font-bold text-slate-900 dark:text-white text-sm flex items-center gap-2 flex-wrap">
                    <span title="${escapeHtml(donor.id)}">${escapeHtml(donor.name)}</span>
                    ${kindBadge}
                  </div>
                  <div class="text-xs text-slate-500 dark:text-slate-300 mt-0.5">
                    ${giftsList.length} gift${giftsList.length === 1 ? '' : 's'} · ${formatMoney(donor.lifetimeTotal)}
                    ${donor.firstGiftDate ? ` · first ${formatDate(donor.firstGiftDate)}` : ''}
                  </div>
                  ${coverage ? `<div class="text-[11px] text-slate-600 dark:text-slate-300 mt-1">${escapeHtml(coverage)}</div>` : ''}
                </div>
                <button
                  type="button"
                  class="export-single-donor-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-[#061815] dark:hover:bg-teal-950/80 dark:text-slate-200 transition border border-slate-200 dark:border-teal-800/80 cursor-pointer"
                  data-donor-id="${donor.id}"
                  title="Download this donor as CSV"
                >
                  <span>Download CSV</span>
                </button>
              </div>
              ${contactPanel}
              <div class="space-y-3">
                ${historyHtml}
              </div>
            </div>
          </td>
        </tr>
      `;


      return drawerRow;
    }).join('');

    tableBody.innerHTML = rowsHtml;
    attachTableBodyListener(tableBody);
  }

  // Blob CSV Downloader helper for guaranteed reliability with large datasets
  function triggerCsvDownload(filename, csvString) {
    const blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.setAttribute('href', url);
    link.setAttribute('download', filename);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  // Table click event delegation
  function attachTableBodyListener(tableBody) {
    if (!tableBody || tableBody.dataset.bound === '1') return;
    tableBody.dataset.bound = '1';

    tableBody.addEventListener('click', (e) => {
      const target = e.target;
      const selection = window.getSelection();
      if (selection && selection.toString().trim().length > 0) return;
      if (target.closest('tr[id^="drawer-"]')) return;

      const row = target.closest('tr[data-donor-id]');
      if (!row) return;

      const donorId = row.dataset.donorId;
      if (!donorId) return;

      if (openDrawers.has(donorId)) {
        openDrawers.delete(donorId);
      } else {
        openDrawers.add(donorId);
      }
      renderTable();
    });
  }

  // Export Full Filtered Roster CSV via Blob
  function handleExportCsv() {
    const headers = [
      'Donor ID',
      'Primary Name',
      'Email',
      'Phone',
      'Mailing Address',
      'Lifetime Total Given',
      'Total Transactions',
      'Giving Tier',
      'Platforms Used',
      'First Gift Date',
      'Latest Gift Date',
      'Has Mailing Address'
    ];

    const rows = filteredDonors.map(d => [
      d.id,
      `"${(d.name || '').replace(/"/g, '""')}"`,
      `"${(d.email || '').replace(/"/g, '""')}"`,
      `"${(d.phone || '').replace(/"/g, '""')}"`,
      `"${formatDisplayAddress(d.address).replace(/"/g, '""')}"`,
      d.lifetimeTotal.toFixed(2),
      d.transactionsCount,
      `"${d.givingTier}"`,
      `"${(d.platformsList || []).join('; ')}"`,
      d.firstGiftDate || '',
      d.latestGiftDate || '',
      d.hasMailingAddress ? 'YES' : 'NO'
    ]);

    const csvContent = [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
    triggerCsvDownload(`HSMC_Master_Donors_Export_${new Date().toISOString().slice(0, 10)}.csv`, csvContent);
  }

  // Export Single Donor Statement via Blob
  if (!window.__HSMC_SINGLE_DONOR_CLICK_BOUND__) {
    window.__HSMC_SINGLE_DONOR_CLICK_BOUND__ = true;
    document.addEventListener('click', (e) => {
      const target = e.target;
      const btn = target.closest('.export-single-donor-btn');
      if (!btn) return;
      const donorId = btn.dataset.donorId;
      const donor = allDonors.find(d => d.id === donorId);
      if (!donor) return;

      const csvRows = [
        ['Humane Society of Monroe County - Donor Giving Statement'],
        ['Donor Name', donor.name],
        ['Donor ID', donor.id],
        ['Email', donor.email],
        ['Phone', donor.phone],
        ['Mailing Address', `"${formatDisplayAddress(donor.address).replace(/"/g, '""')}"`],
        ['Lifetime Total', (donor.lifetimeTotal || 0).toFixed(2)],
        ['Itemized Total', (typeof donor.itemizedTotal === 'number' ? donor.itemizedTotal : (donor.gifts || []).reduce((s, g) => s + (g.amount || 0), 0)).toFixed(2)],
        ['Giving Tier', donor.givingTier],
        ['Total Gifts', donor.transactionsCount],
        [],
        ['Date', 'How', 'For', 'Amount', 'Note', 'Check']
      ];

      (donor.gifts || []).forEach(g => {
        const desc = [g.description, g.dedication, g.memo, g.privateNote]
          .map(s => String(s || '').trim())
          .find(s => s && !/^DEPOSIT$/i.test(s)) || '';
        const how = /check/i.test(g.platform || '') ? 'Check' : (g.platform || '');
        const checkLabel = String(g.checkNumber || g.paymentMethod || g.reference || '').trim();
        csvRows.push([
          g.date,
          how,
          `"${(g.campaign || '').replace(/"/g, '""')}"`,
          (g.amount || 0).toFixed(2),
          `"${desc.replace(/"/g, '""')}"`,
          `"${checkLabel.replace(/"/g, '""')}"`
        ]);
      });

      const csvContent = csvRows.map(r => r.join(',')).join('\n');
      triggerCsvDownload(`HSMC_Statement_${donor.name.replace(/[^a-zA-Z0-9]/g, '_')}.csv`, csvContent);
    });
  }

  // Main Idempotent Initialization for Initial Load & View Transitions
  function initDonorRosterTable() {
    const els = getElements();
    if (!els.tableBody) return;

    if (Array.isArray(window.__HSMC_DONORS__) && window.__HSMC_DONORS__.length) {
      allDonors = window.__HSMC_DONORS__;
      indexDonors(allDonors);
    }

    // Parse URL search parameters for seamless inter-portal deep linking
    try {
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.has('search') && els.searchInput) els.searchInput.value = urlParams.get('search') || '';
      if (urlParams.has('tier') && els.filterTier) els.filterTier.value = urlParams.get('tier') || 'all';
      if (urlParams.has('platform') && els.filterPlatform) els.filterPlatform.value = urlParams.get('platform') || 'all';
      if (urlParams.has('address') && els.filterAddress) els.filterAddress.value = urlParams.get('address') || 'all';
      if (urlParams.has('recency') && els.filterRecency) els.filterRecency.value = urlParams.get('recency') || 'all';
      if (urlParams.has('sort') && els.filterSort) els.filterSort.value = urlParams.get('sort') || 'lifetime_desc';
    } catch (e) {}

    // Search input with debounce
    if (els.searchInput && els.searchInput.dataset.bound !== '1') {
      els.searchInput.dataset.bound = '1';
      let debounceTimeout;
      els.searchInput.addEventListener('input', () => {
        clearTimeout(debounceTimeout);
        debounceTimeout = setTimeout(applyFilters, 150);
      });
    }

    if (els.clearSearchBtn && els.clearSearchBtn.dataset.bound !== '1') {
      els.clearSearchBtn.dataset.bound = '1';
      els.clearSearchBtn.addEventListener('click', () => {
        const s = document.getElementById('donor-search-input');
        if (s) s.value = '';
        applyFilters();
      });
    }

    // Filter change handlers
    [els.filterTier, els.filterPlatform, els.filterAddress, els.filterRecency, els.filterSort, els.filterShowBatches].forEach(flt => {
      if (flt && flt.dataset.bound !== '1') {
        flt.dataset.bound = '1';
        flt.addEventListener('change', applyFilters);
      }
    });

    // Pagination change handlers
    if (els.pageSizeSelect && els.pageSizeSelect.dataset.bound !== '1') {
      els.pageSizeSelect.dataset.bound = '1';
      els.pageSizeSelect.addEventListener('change', () => {
        const ps = document.getElementById('page-size');
        pageSize = parseInt(ps ? ps.value : '50') || 50;
        currentPage = 1;
        renderTable();
      });
    }

    if (els.prevBtn && els.prevBtn.dataset.bound !== '1') {
      els.prevBtn.dataset.bound = '1';
      els.prevBtn.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          renderTable();
          document.getElementById('donor-roster-container')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    }

    if (els.nextBtn && els.nextBtn.dataset.bound !== '1') {
      els.nextBtn.dataset.bound = '1';
      els.nextBtn.addEventListener('click', () => {
        const totalPages = Math.ceil(filteredDonors.length / pageSize);
        if (currentPage < totalPages) {
          currentPage++;
          renderTable();
          document.getElementById('donor-roster-container')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    }

    if (els.exportBtn && els.exportBtn.dataset.bound !== '1') {
      els.exportBtn.dataset.bound = '1';
      els.exportBtn.addEventListener('click', handleExportCsv);
    }

    applyFilters();
  }

  // Function to ingest live or cached donor payload
  function setDonors(newDonors) {
    if (!Array.isArray(newDonors) || !newDonors.length) return;
    allDonors = newDonors;
    indexDonors(allDonors);
    window.__HSMC_DONORS__ = newDonors;
    const roster = document.getElementById('donor-roster-section');
    if (roster) roster.classList.remove('hidden');
    initDonorRosterTable();
  }

  window.setHSMCDonors = setDonors;
  window.initMCHSDonorTable = initDonorRosterTable;

  if (!(window as any).__HSMC_DONORS_HYDRATED_BOUND__) {
    window.__HSMC_DONORS_HYDRATED_BOUND__ = true;
    window.addEventListener('donors-hydrated', (e) => {
      if (e?.detail?.donors) {
        setDonors(e.detail.donors);
      }
    });
  }

  document.addEventListener('astro:page-load', initDonorRosterTable);
</script>
