{
  "name": "Monroe County Humane Society — Staff Ops",
  "short_name": "HSMC Ops",
  "description": "Unified Operations & Governance Portal for the Humane Society of Monroe County",
  "id": "/internal/",
  "start_url": "/internal/?source=pwa",
  "scope": "/internal/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4f7f5",
  "theme_color": "#0f766e",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/manifest.webmanifest",
      "id": "/internal/"
    }
  ],
  "icons": [
    {
      "src": "/assets/staff/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/staff/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/staff/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/staff/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Operations Hub",
      "short_name": "Hub",
      "description": "Staff operations overview and census",
      "url": "/internal/?source=pwa",
      "icons": [{ "src": "/assets/staff/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Animal Census",
      "short_name": "Animals",
      "description": "Shelter census, kennel cards, PetPoint sync",
      "url": "/internal/pets/?source=pwa",
      "icons": [{ "src": "/assets/staff/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Board Financials",
      "short_name": "Finance",
      "description": "Checking, statements, and board packet",
      "url": "/internal/board/?source=pwa",
      "icons": [{ "src": "/assets/staff/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Grants Pipeline",
      "short_name": "Grants",
      "description": "Open and awarded grants",
      "url": "/internal/grants/?source=pwa",
      "icons": [{ "src": "/assets/staff/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
