{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "3928594821393639699"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Primary location for all Azure resources"
      }
    },
    "environmentName": {
      "type": "string",
      "defaultValue": "prod",
      "metadata": {
        "description": "Environment prefix (e.g. prod, staging)"
      }
    },
    "mysqlAdminUser": {
      "type": "string",
      "defaultValue": "monroeadmin",
      "metadata": {
        "description": "Administrator login name for MySQL Flexible Server"
      }
    },
    "mysqlAdminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Administrator password for MySQL Flexible Server"
      }
    },
    "directusAdminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Directus Admin Password"
      }
    },
    "directusKey": {
      "type": "securestring",
      "metadata": {
        "description": "Directus KEY (data encryption key). If applying to the live app, pass the KEY already running on mchs-directus — do not generate a new one. Rotating KEY can make existing encrypted fields unreadable. The live value is not in git."
      }
    },
    "directusSecret": {
      "type": "securestring",
      "metadata": {
        "description": "Directus SECRET (session/JWT signing secret). If applying to the live app, pass the SECRET already running on mchs-directus — rotating it invalidates staff sessions."
      }
    },
    "petsyncDirectusToken": {
      "type": "securestring",
      "metadata": {
        "description": "Static access token for the PetSync service account (Directus user, not the admin account)"
      }
    },
    "petangoAuthkey": {
      "type": "securestring",
      "metadata": {
        "description": "Petango authkey used by the PetSync job to query the shelter feed directly"
      }
    },
    "githubDispatchToken": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "GitHub PAT (repo scope) the PetSync job uses to trigger a frontend rebuild via repository_dispatch. Optional — leave empty to skip auto-rebuild."
      }
    },
    "arcadeCleanupSecret": {
      "type": "securestring",
      "metadata": {
        "description": "Shared secret for Arcade cleanup/cron endpoints"
      }
    },
    "extraMysqlFirewallRules": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Optional extra MySQL firewall rules. Each object: name, startIpAddress, endIpAddress. Empty keeps only AllowAzureServices (required for ACA without a VNet)."
      }
    }
  },
  "variables": {
    "suffix": "[uniqueString(resourceGroup().id)]",
    "storageAccountName": "[format('mchsstorage{0}', variables('suffix'))]",
    "containerAppEnvName": "[format('mchs-aca-env-{0}', parameters('environmentName'))]",
    "mysqlServerName": "[format('mchs-mysql-{0}', variables('suffix'))]",
    "swaName": "[format('mchs-frontend-{0}', parameters('environmentName'))]",
    "logAnalyticsName": "[format('mchs-logs-{0}-{1}', parameters('environmentName'), variables('suffix'))]",
    "directusCorsOrigin": "https://monroe-humane.org,https://delightful-dune-0d730f70f.7.azurestaticapps.net"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "accessTier": "Hot",
        "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": true
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/{1}', variables('storageAccountName'), 'default')]",
      "properties": {
        "cors": {
          "corsRules": [
            {
              "allowedOrigins": [
                "https://monroe-humane.org",
                "https://*.azurestaticapps.net",
                "http://localhost:*"
              ],
              "allowedMethods": [
                "GET",
                "HEAD",
                "OPTIONS"
              ],
              "allowedHeaders": [
                "*"
              ],
              "exposedHeaders": [
                "*"
              ],
              "maxAgeInSeconds": 3600
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/{1}/{2}', variables('storageAccountName'), 'default', 'directus-uploads')]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageAccountName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/{1}/{2}', variables('storageAccountName'), 'default', 'pet-photos')]",
      "properties": {
        "publicAccess": "Blob"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageAccountName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.DBforMySQL/flexibleServers",
      "apiVersion": "2023-12-30",
      "name": "[variables('mysqlServerName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_B1ms",
        "tier": "Burstable"
      },
      "properties": {
        "administratorLogin": "[parameters('mysqlAdminUser')]",
        "administratorLoginPassword": "[parameters('mysqlAdminPassword')]",
        "version": "8.0.21",
        "storage": {
          "storageSizeGB": 20,
          "iops": 360,
          "autoGrow": "Enabled"
        },
        "backup": {
          "backupRetentionDays": 7,
          "geoRedundantBackup": "Disabled"
        },
        "network": {
          "publicNetworkAccess": "Enabled"
        }
      }
    },
    {
      "type": "Microsoft.DBforMySQL/flexibleServers/firewallRules",
      "apiVersion": "2023-12-30",
      "name": "[format('{0}/{1}', variables('mysqlServerName'), 'AllowAzureServices')]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforMySQL/flexibleServers', variables('mysqlServerName'))]"
      ]
    },
    {
      "copy": {
        "name": "extraMysqlFirewall",
        "count": "[length(parameters('extraMysqlFirewallRules'))]"
      },
      "type": "Microsoft.DBforMySQL/flexibleServers/firewallRules",
      "apiVersion": "2023-12-30",
      "name": "[format('{0}/{1}', variables('mysqlServerName'), parameters('extraMysqlFirewallRules')[copyIndex()].name)]",
      "properties": {
        "startIpAddress": "[parameters('extraMysqlFirewallRules')[copyIndex()].startIpAddress]",
        "endIpAddress": "[parameters('extraMysqlFirewallRules')[copyIndex()].endIpAddress]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforMySQL/flexibleServers', variables('mysqlServerName'))]"
      ]
    },
    {
      "type": "Microsoft.DBforMySQL/flexibleServers/databases",
      "apiVersion": "2023-12-30",
      "name": "[format('{0}/{1}', variables('mysqlServerName'), 'directus_db')]",
      "properties": {
        "charset": "utf8mb4",
        "collation": "utf8mb4_unicode_ci"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforMySQL/flexibleServers', variables('mysqlServerName'))]"
      ]
    },
    {
      "type": "Microsoft.DBforMySQL/flexibleServers/databases",
      "apiVersion": "2023-12-30",
      "name": "[format('{0}/{1}', variables('mysqlServerName'), 'arcade_db')]",
      "properties": {
        "charset": "utf8mb4",
        "collation": "utf8mb4_unicode_ci"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforMySQL/flexibleServers', variables('mysqlServerName'))]"
      ]
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('logAnalyticsName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[variables('containerAppEnvName')]",
      "location": "[parameters('location')]",
      "properties": {
        "zoneRedundant": false,
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName')), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName')), '2023-09-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "mchs-directus",
      "location": "[parameters('location')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('containerAppEnvName'))]",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 8055,
            "transport": "auto"
          },
          "secrets": [
            {
              "name": "db-password",
              "value": "[parameters('mysqlAdminPassword')]"
            },
            {
              "name": "admin-password",
              "value": "[parameters('directusAdminPassword')]"
            },
            {
              "name": "directus-key",
              "value": "[parameters('directusKey')]"
            },
            {
              "name": "directus-secret",
              "value": "[parameters('directusSecret')]"
            },
            {
              "name": "storage-azure-account-key",
              "value": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2023-01-01').keys[0].value]"
            }
          ]
        },
        "template": {
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 2
          },
          "containers": [
            {
              "name": "directus",
              "image": "directus/directus:11.5.0",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1.0Gi"
              },
              "env": [
                {
                  "name": "DB_CLIENT",
                  "value": "mysql"
                },
                {
                  "name": "DB_HOST",
                  "value": "[reference(resourceId('Microsoft.DBforMySQL/flexibleServers', variables('mysqlServerName')), '2023-12-30').fullyQualifiedDomainName]"
                },
                {
                  "name": "DB_PORT",
                  "value": "3306"
                },
                {
                  "name": "DB_DATABASE",
                  "value": "directus_db"
                },
                {
                  "name": "DB_USER",
                  "value": "[parameters('mysqlAdminUser')]"
                },
                {
                  "name": "DB_PASSWORD",
                  "secretRef": "db-password"
                },
                {
                  "name": "DB_SSL",
                  "value": "true"
                },
                {
                  "name": "ADMIN_EMAIL",
                  "value": "admin@monroe-humane.org"
                },
                {
                  "name": "ADMIN_PASSWORD",
                  "secretRef": "admin-password"
                },
                {
                  "name": "CORS_ENABLED",
                  "value": "true"
                },
                {
                  "name": "CORS_ORIGIN",
                  "value": "[variables('directusCorsOrigin')]"
                },
                {
                  "name": "KEY",
                  "secretRef": "directus-key"
                },
                {
                  "name": "SECRET",
                  "secretRef": "directus-secret"
                },
                {
                  "name": "PUBLIC_URL",
                  "value": "[format('https://mchs-directus.{0}', reference(resourceId('Microsoft.App/managedEnvironments', variables('containerAppEnvName')), '2024-03-01').defaultDomain)]"
                },
                {
                  "name": "WEBSOCKETS_ENABLED",
                  "value": "true"
                },
                {
                  "name": "STORAGE_LOCATIONS",
                  "value": "azure"
                },
                {
                  "name": "STORAGE_AZURE_DRIVER",
                  "value": "azure"
                },
                {
                  "name": "STORAGE_AZURE_ACCOUNT_NAME",
                  "value": "[variables('storageAccountName')]"
                },
                {
                  "name": "STORAGE_AZURE_ACCOUNT_KEY",
                  "secretRef": "storage-azure-account-key"
                },
                {
                  "name": "STORAGE_AZURE_CONTAINER_NAME",
                  "value": "directus-uploads"
                },
                {
                  "name": "STORAGE_AZURE_PUBLIC_URL",
                  "value": "[format('{0}directus-uploads', reference(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2023-01-01').primaryEndpoints.blob)]"
                }
              ]
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('containerAppEnvName'))]",
        "[resourceId('Microsoft.DBforMySQL/flexibleServers', variables('mysqlServerName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "mchs-arcade-api",
      "location": "[parameters('location')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('containerAppEnvName'))]",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 80,
            "transport": "auto"
          },
          "secrets": [
            {
              "name": "db-pass",
              "value": "[parameters('mysqlAdminPassword')]"
            },
            {
              "name": "cleanup-secret",
              "value": "[parameters('arcadeCleanupSecret')]"
            }
          ]
        },
        "template": {
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 2
          },
          "containers": [
            {
              "name": "arcade-api",
              "image": "ghcr.io/monroehumane/monroe-humane-arcade:latest",
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              },
              "env": [
                {
                  "name": "DB_HOST",
                  "value": "[reference(resourceId('Microsoft.DBforMySQL/flexibleServers', variables('mysqlServerName')), '2023-12-30').fullyQualifiedDomainName]"
                },
                {
                  "name": "DB_NAME",
                  "value": "arcade_db"
                },
                {
                  "name": "DB_USER",
                  "value": "[parameters('mysqlAdminUser')]"
                },
                {
                  "name": "DB_PASS",
                  "secretRef": "db-pass"
                },
                {
                  "name": "DB_SSL",
                  "value": "true"
                },
                {
                  "name": "CORS_ALLOWED_ORIGINS",
                  "value": "[variables('directusCorsOrigin')]"
                },
                {
                  "name": "CLEANUP_SECRET",
                  "secretRef": "cleanup-secret"
                }
              ]
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('containerAppEnvName'))]",
        "[resourceId('Microsoft.DBforMySQL/flexibleServers', variables('mysqlServerName'))]"
      ]
    },
    {
      "type": "Microsoft.App/jobs",
      "apiVersion": "2024-03-01",
      "name": "mchs-petsync-job",
      "location": "[parameters('location')]",
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('containerAppEnvName'))]",
        "configuration": {
          "triggerType": "Schedule",
          "scheduleTriggerConfig": {
            "cronExpression": "*/30 * * * *",
            "parallelism": 1,
            "replicaCompletionCount": 1
          },
          "replicaTimeout": 600,
          "replicaRetryLimit": 1,
          "secrets": [
            {
              "name": "directus-static-token",
              "value": "[parameters('petsyncDirectusToken')]"
            },
            {
              "name": "petango-authkey",
              "value": "[parameters('petangoAuthkey')]"
            },
            {
              "name": "storage-connection-string",
              "value": "[format('DefaultEndpointsProtocol=https;AccountName={0};AccountKey={1};EndpointSuffix=core.windows.net', variables('storageAccountName'), listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2023-01-01').keys[0].value)]"
            },
            {
              "name": "github-dispatch-token",
              "value": "[parameters('githubDispatchToken')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "petsync",
              "image": "ghcr.io/monroehumane/monroe-humane-petsync:latest",
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              },
              "env": [
                {
                  "name": "DIRECTUS_URL",
                  "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', 'mchs-directus'), '2024-03-01').configuration.ingress.fqdn)]"
                },
                {
                  "name": "DIRECTUS_STATIC_TOKEN",
                  "secretRef": "directus-static-token"
                },
                {
                  "name": "PETANGO_AUTHKEY",
                  "secretRef": "petango-authkey"
                },
                {
                  "name": "AZURE_STORAGE_CONNECTION_STRING",
                  "secretRef": "storage-connection-string"
                },
                {
                  "name": "PET_PHOTO_CONTAINER",
                  "value": "pet-photos"
                },
                {
                  "name": "GITHUB_DISPATCH_TOKEN",
                  "secretRef": "github-dispatch-token"
                },
                {
                  "name": "GITHUB_REPO",
                  "value": "MonroeHumane/AzureMigration"
                },
                {
                  "name": "PUBLIC_SITE_URL",
                  "value": "https://monroe-humane.org"
                }
              ]
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('containerAppEnvName'))]",
        "[resourceId('Microsoft.App/containerApps', 'mchs-directus')]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/staticSites",
      "apiVersion": "2023-01-01",
      "name": "[variables('swaName')]",
      "location": "eastus2",
      "sku": {
        "name": "Standard",
        "tier": "Standard"
      },
      "properties": {
        "allowConfigFileUpdates": true,
        "stagingEnvironmentPolicy": "Enabled"
      }
    }
  ],
  "outputs": {
    "directusUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', 'mchs-directus'), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "arcadeApiUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', 'mchs-arcade-api'), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "staticWebAppsUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/staticSites', variables('swaName')), '2023-01-01').defaultHostname)]"
    }
  }
}