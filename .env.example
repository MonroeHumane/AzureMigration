# ==============================================================================
# Monroe County Humane Society - Environment Configuration
# ==============================================================================

# Database Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_DIRECTUS_NAME=directus_db
DB_ARCADE_NAME=arcade_db

# Directus CMS Settings
DIRECTUS_URL=http://localhost:8055
DIRECTUS_KEY=change-me-to-a-random-uuid
DIRECTUS_SECRET=change-me-to-a-random-secret
DIRECTUS_ADMIN_EMAIL=admin@monroe-humane.org
DIRECTUS_ADMIN_PASSWORD=ChangeThisPasswordInProd!
DIRECTUS_STATIC_TOKEN=admin-static-token

# Azure Blob Storage for Directus (Production)
AZURE_STORAGE_ACCOUNT=monroehumanestorage
AZURE_STORAGE_KEY=your-azure-storage-account-key
AZURE_STORAGE_CONTAINER=directus-uploads

# Humane Arcade API Settings
ARCADE_API_BASE=http://localhost:8081/v1
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:5173,http://localhost:8060,http://localhost:3000,https://monroe-humane.org
CLEANUP_SECRET=generate-a-strong-secret-for-cron

# PetSync Settings
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vQeJ5vC9u2A_example/pub?output=csv
