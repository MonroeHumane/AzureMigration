# ==============================================================================
# Monroe County Humane Society - Local environment (docker compose)
# Copy to .env in the repo root. Values here are local-only placeholders.
# Do not put production KEY, SECRET, passwords, or tokens in this file.
# ==============================================================================

# Database Settings (compose MySQL service; host "mysql" is set in docker-compose.yml)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_DIRECTUS_NAME=directus_db
DB_ARCADE_NAME=arcade_db

# Directus CMS Settings (local-only — rotating a production KEY bricks encrypted fields)
DIRECTUS_URL=http://localhost:8055
DIRECTUS_KEY=local-only-directus-key-not-for-prod
DIRECTUS_SECRET=local-only-directus-secret-not-for-prod
DIRECTUS_ADMIN_EMAIL=admin@monroe-humane.org
DIRECTUS_ADMIN_PASSWORD=local-only-AdminPass123!
DIRECTUS_STATIC_TOKEN=admin-static-token
DIRECTUS_CORS_ORIGIN=http://localhost:4321,http://localhost:5173,http://localhost:8060,http://localhost:3000

# Azure Blob Storage for Directus (Production placeholders only)
AZURE_STORAGE_ACCOUNT=monroehumanestorage
AZURE_STORAGE_KEY=your-azure-storage-account-key
AZURE_STORAGE_CONTAINER=directus-uploads

# Humane Arcade API Settings
ARCADE_API_BASE=http://localhost:8081/v1
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:5173,http://localhost:8060,http://localhost:3000,https://monroe-humane.org
CLEANUP_SECRET=local-only-cleanup-secret-not-for-prod

# PetSync Settings
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vQeJ5vC9u2A_example/pub?output=csv
PETANGO_AUTHKEY=
